extends RefCounted

## Every sound the game makes, and the synthesis that produces them.
##
## Reached by `preload` (`main.gd`'s `FactoryAudio`), not by a `class_name`,
## because that is how every other shared script in this project is reached
## (`game_session.gd`, `test_layouts.gd`) and because a `class_name` is only
## registered after an editor scan — a headless `--script` run against a cold
## `.godot/` would not find it.
##
## **UI_UX.md §8 listed "audio direction" as not decided. This file is the
## first half of that decision, and it is deliberately a narrow one:** sound
## here is *feedback*, not a score or an ambience bed. It fires on the
## moments the player is meant to feel — a contract paying out, a case
## landing on the dock — and is silent the rest of the time, which is what
## keeps a factory that runs for an hour from becoming an hour of noise.
##
## # Why the waveforms are code and not `.wav` files in the repo
##
## The same argument UI_UX.md §2a makes about voxels, applied to audio. That
## section's driving constraint was that "every asset must be creatable,
## editable and viewable by Claude, not only by a human in a GUI" — a
## recorded or GUI-authored `.wav` is an opaque binary blob that can only be
## regenerated by whoever made it, and the voxel pipeline exists precisely
## to avoid that. A few hundred samples of arithmetic is diffable, reviewable
## and tunable by changing a number, so the pitches, the decay and the
## envelope below ARE the asset. `AudioStreamWAV` takes raw PCM, so no file
## ever needs to exist.
##
## The obvious limit, stated rather than discovered later: this is a
## synthesis approach, so it buys arcade-style tones (chimes, clicks, blips)
## and not recorded material. That suits a chunky voxel factory and it is
## what the two cues below need. A future ambience/music layer is a
## different problem and would want real files; nothing here forecloses that.
##
## # Determinism
##
## The noise transients run off an explicit LCG rather than `randf()`, so
## the same call produces byte-identical PCM every run. That is not a
## simulation-determinism requirement (audio never feeds back into the sim,
## ARCHITECTURE.md §3.9) — it is so a test can assert the *shape* of a
## generated stream, and so two runs of `scripts/verify-core-loop.sh` differ
## in nothing at all.

const MIX_RATE := 44100

## Every cue this class knows how to make. `play()` takes one of these.
const PAYOUT := "payout"
const DELIVERY := "delivery"

## Master trim, in dB, applied to every player. Sound is feedback here, so
## it sits UNDER the level a music track would want: a coin chime that makes
## the player reach for the volume key has failed at being satisfying.
const VOLUME_DB := -7.0

## How many cues can overlap. Four rather than one because a contract board
## can settle several contracts on the same tick (sim_core's `Economy::tick`
## returns a *list* of paid contracts), and a cue cut off by the next one
## reads as a glitch rather than as a second payout.
const VOICES := 4

## Whether anything is actually audible. Toggled from the pause menu; the
## cues are still generated and `play()` still bookkeeps, so muting can never
## change timing or state — only whether a stream is started.
var enabled := true

var _players: Array[AudioStreamPlayer] = []
var _next_voice := 0
var _streams: Dictionary = {} # cue name -> AudioStreamWAV
## Cue name -> how many times `play` has been asked for it. The seam the
## headless test asserts on, since a dummy audio driver makes "was a sound
## heard" unanswerable.
var plays: Dictionary = {}


## Builds the cues and the voices that play them. `parent` owns the
## AudioStreamPlayer nodes, so freeing the scene frees them.
func setup(parent: Node) -> void:
	_streams[PAYOUT] = payout_stream()
	_streams[DELIVERY] = delivery_stream()
	for i in range(VOICES):
		var player := AudioStreamPlayer.new()
		player.name = "sfx_%d" % i
		player.volume_db = VOLUME_DB
		parent.add_child(player)
		_players.append(player)


## Fires one cue. Round-robins the voices so a second payout in the same
## frame is heard rather than cutting the first one off.
##
## Silently does nothing for an unknown cue name rather than erroring: this
## is feedback, and a missing sound must never be able to take the game down
## with it.
func play(cue: String) -> void:
	plays[cue] = int(plays.get(cue, 0)) + 1
	if not enabled or _players.is_empty():
		return
	var stream = _streams.get(cue)
	if stream == null:
		return
	var player: AudioStreamPlayer = _players[_next_voice]
	_next_voice = (_next_voice + 1) % _players.size()
	# A headless `--script` run never enters the scene tree — `root.add_child`
	# in `_initialize` only queues it — so a voice there would print an engine
	# error per cue and make a passing verify run read as a broken one. The
	# `plays` tally above is what the test asserts on either way.
	if not player.is_inside_tree():
		return
	player.stream = stream
	player.play()


# --------------------------------------------------------------------------
# The cues
# --------------------------------------------------------------------------

## A contract paid: the game's one genuinely celebratory sound.
##
## Two rising notes rather than one, because a single tone reads as a
## notification and an interval reads as an *event* — it is the oldest trick
## in arcade sound design and it is what a coin pickup has sounded like since
## 1985. B5 into E6 (a perfect fourth), the second held four times as long
## with a slow tail, over a short low thump that gives the chime something to
## land on so it reads as a till rather than as a doorbell.
##
## The tones carry a third harmonic at a quarter amplitude: a pure sine is
## noticeably duller than the bright, slightly metallic tone this wants, and
## a square wave is harsher than a voxel factory should be. One odd harmonic
## is the middle of those two.
static func payout_stream() -> AudioStreamWAV:
	var samples := _buffer(0.62)
	# The till: a short, low body hit, under the notes rather than before
	# them, so the two read as one sound.
	_thump(samples, 0.0, 132.0, 0.34, 26.0)
	_tone(samples, 0.0, 0.10, 987.77, 0.30, 22.0)  # B5
	_tone(samples, 0.09, 0.50, 1318.51, 0.34, 7.5) # E6
	return _encode(samples)


## A finished case reaching the dock. The factory's heartbeat: it fires far
## more often than a payout, so it is deliberately small — a wooden knock
## with a breath of noise on the front, well under half the payout's level
## and a fifth of its length. Loud, tuneful or long here would be unbearable
## within a minute of a line running properly, which is the whole reason it
## is a knock and not a chime.
static func delivery_stream() -> AudioStreamWAV:
	var samples := _buffer(0.12)
	_thump(samples, 0.0, 196.0, 0.15, 48.0)
	_noise(samples, 0.0, 0.02, 0.055, 220.0)
	return _encode(samples)


# --------------------------------------------------------------------------
# Synthesis primitives
# --------------------------------------------------------------------------

static func _buffer(seconds: float) -> PackedFloat32Array:
	var samples := PackedFloat32Array()
	samples.resize(int(seconds * MIX_RATE))
	return samples


## One decaying tone with a third harmonic, mixed into `samples`.
##
## The 2 ms attack ramp is not a refinement — a tone that starts at full
## amplitude begins with a step discontinuity, and a step is a click. Every
## primitive here ramps in for that reason.
static func _tone(samples: PackedFloat32Array, start: float, seconds: float,
		freq: float, amp: float, decay: float) -> void:
	var first := int(start * MIX_RATE)
	var count := int(seconds * MIX_RATE)
	for i in range(count):
		var index := first + i
		if index < 0 or index >= samples.size():
			continue
		var t := float(i) / MIX_RATE
		var envelope: float = exp(-t * decay) * _attack(t)
		var value: float = sin(TAU * freq * t) + 0.25 * sin(TAU * freq * 3.0 * t)
		samples[index] += value * envelope * amp


## The low body of a hit: a sine whose pitch falls away as it decays, which
## is what makes a knock read as something solid being struck rather than as
## a bass note.
static func _thump(samples: PackedFloat32Array, start: float, freq: float,
		amp: float, decay: float) -> void:
	var first := int(start * MIX_RATE)
	var count := int((4.0 / decay) * MIX_RATE)
	var phase := 0.0
	for i in range(count):
		var index := first + i
		if index < 0 or index >= samples.size():
			continue
		var t := float(i) / MIX_RATE
		var envelope: float = exp(-t * decay) * _attack(t)
		phase += TAU * (freq * (0.55 + 0.45 * exp(-t * decay))) / MIX_RATE
		samples[index] += sin(phase) * envelope * amp


## A filtered noise transient — the "chk" on the front of a knock. Its
## randomness comes from an explicit LCG, so the generated PCM is identical
## every run (see this class's determinism note).
static func _noise(samples: PackedFloat32Array, start: float, seconds: float,
		amp: float, decay: float) -> void:
	var first := int(start * MIX_RATE)
	var count := int(seconds * MIX_RATE)
	var state := 0x2545F491
	var smoothed := 0.0
	for i in range(count):
		var index := first + i
		if index < 0 or index >= samples.size():
			continue
		state = (state * 1103515245 + 12345) & 0x7FFFFFFF
		var white := float(state % 20001) / 10000.0 - 1.0
		# One-pole low pass: raw white noise is a hiss, and a dulled one is a
		# knock.
		smoothed = smoothed * 0.6 + white * 0.4
		var t := float(i) / MIX_RATE
		samples[index] += smoothed * exp(-t * decay) * _attack(t) * amp


## The shared 2 ms click-guard on the front of every primitive.
static func _attack(t: float) -> float:
	return minf(1.0, t / 0.002)


## Float samples to the 16-bit mono PCM `AudioStreamWAV` wants. Clamped, not
## normalised: the levels above are chosen relative to each other on purpose,
## and normalising each cue would throw that relationship away and make the
## delivery knock as loud as the payout chime.
static func _encode(samples: PackedFloat32Array) -> AudioStreamWAV:
	var data := PackedByteArray()
	data.resize(samples.size() * 2)
	for i in range(samples.size()):
		var value := int(clampf(samples[i], -1.0, 1.0) * 32767.0)
		data.encode_s16(i * 2, value)
	var stream := AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = MIX_RATE
	stream.stereo = false
	stream.data = data
	return stream
