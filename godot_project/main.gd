## Whether the staff pools are due a re-read: never read yet, or
## LOAD_POLL_TICKS of simulation since the last one. The machine load's
## rule (`_machine_load_poll_due`), on its own stamp so a HIRE's immediate
## re-read does not shift the load's cadence.
func _staff_poll_due() -> bool:
	return _staff_polled_tick < 0 or sim.current_tick() - _staff_polled_tick >= LOAD_POLL_TICKS


## Re-reads `staff_snapshot_json`. Cheap (four categories), so it is read
## on the cadence whether or not the panel is up — the same object carries
## the balance, and a panel opened between polls shows the last poll until
## `_set_staff_open` reads again.
func _poll_staff() -> void:
	_staff_polled_tick = sim.current_tick()
	var parsed = JSON.parse_string(sim.staff_snapshot_json())
	if parsed is Dictionary:
		_staff_snapshot = parsed
		_announce_staff_payday(_staff_snapshot)


## A row's own AFTER-payday indicator (the quality pass, ticket 4): heads
## idled by a payday that could not pay them, heads that left because a
## second payday in a row could not — both in words beside the amber/warn
## colour the row style already carries (UI_UX.md §7: never colour alone).
## "" when neither happened, so the row shows nothing extra most of the
## time.
func _staff_status_text(category: Dictionary) -> String:
	var unpaid := int(category.get("unpaid", 0))
	var left := int(category.get("left_last_payday", 0))
	var parts: Array[String] = []
	if unpaid > 0:
		parts.append("▲ %d unpaid, idle until payday" % unpaid)
	if left > 0:
		parts.append("▲ %d left last payday" % left)
	return "  ·  ".join(parts)


## The pure half of a row (a test drives it with a category dictionary):
## every string and number the row shows, from the wire's own figures.
##
##   hired_text     "hired 4"
##   wage_text      "wage 2 / head / period"
##   meter          {"fraction", "color"} — HIRED over REQUIRED, red when
##                  short; a required of 0 is an empty bar reading "0 / 0".
##                  A bar is honest here under UI_UX.md §5e because the sim
##                  defines the ceiling: `required` is the establishment the
##                  placed machinery needs, not a number Godot invented
##   meter_text     "4 / 4"
##   short_text     "▲ hire 2" when short > 0, else "" (the glyph is the
##                  staffing ticket's: a shortfall is read at a glance, and
##                  the warning colour is never the whole message)
##   state_text     the row's own verdict chip beside its name — "▲ SHORT",
##                  "✔ CREWED", or "" for a category nothing asks for
##   state_color    that chip's ink
##   short_row      true when this row is the reason the HUD is shouting
##   note           the idle sentence when the category has nothing hired
##                  and nothing asking for it, else "" (the meter shows)
##   fire_enabled   headcount > 0
##   hire_enabled   the wire's own `can_hire` (ticket 1's hire-refusal rule;
##                  Godot never re-derives it — it needs the whole-factory
##                  bill, not this row's own numbers)
##   hire_text      what the HIRE button's click does AND costs
##   fire_text      what FIRE's click does
##   fire_tooltip   the notice-pay rule, on the button that springs it
##   status_text    `_staff_status_text`'s AFTER-payday line
func _staff_row_state(category: Dictionary) -> Dictionary:
	var headcount := int(category.get("headcount", 0))
	var required := int(category.get("required", 0))
	var assigned := int(category.get("assigned", 0))
	var short := int(category.get("short", 0))
	var wage := int(category.get("wage", 0))
	var id := String(category.get("id", ""))
	var note := ""
	if headcount == 0 and required == 0 and STAFF_IDLE_NOTES.has(id):
		note = String(STAFF_IDLE_NOTES[id])
	var state_text := ""
	if short > 0:
		state_text = "▲ SHORT"
	elif required > 0:
		state_text = "✔ CREWED"
	return {
		"hired_text": "hired %d" % headcount,
		"wage_text": "wage %d / head / period" % wage,
		"meter": {
			"fraction": minf(float(headcount) / float(required), 1.0) if required > 0 else 0.0,
			"color": METER_FILL_WARN if short > 0 else METER_FILL_LEVEL,
		},
		"meter_text": "%d / %d" % [headcount, required],
		"short_text": ("▲ hire %d" % short) if short > 0 else "",
		"state_text": state_text,
		"state_color": METER_FILL_WARN if short > 0 else METER_FILL_LEVEL,
		"short_row": short > 0,
		"note": note,
		"working_text": _staff_working_text(assigned, headcount, required),
		# FIRE is gated on HEADS, never on the establishment. A category
		# nothing needs is exactly where a player is most likely to be
		# carrying heads they want to shed, and disabling the button there
		# would bill them every payday with no way out.
		"fire_enabled": headcount > 0,
		"hire_enabled": bool(category.get("can_hire", true)) and required > 0,
		"hire_text": _staff_hire_button_text(category),
		"fire_text": "FIRE −1",
		"fire_tooltip": STAFF_FIRE_NOTICE,
		"status_text": _staff_status_text(category),
	}


## The per-tick activity figure, kept but demoted to a sub-line.
##
## `assigned` is how many heads a machine actually took LAST TICK, and it
## rises and falls with production flow — a belt runs dry, a machine stands
## aside, and fewer heads are asked for. That is a true and interesting
## thing to show ("what is working right now") and it is NOT the hiring
## question, which is why the row's meter and its ▲ SHORT chip are drawn
## from `required` instead. Before 2026-09-16 this number WAS the headline,
## and the panel therefore told the player to hire a figure that had moved
## again by the time they clicked (docs/DECISIONS.md, the establishment
## record).
##
## "" for a category nothing needs, so an unused row stays quiet.
func _staff_working_text(assigned: int, headcount: int, required: int) -> String:
	if required <= 0:
		return ""
	if assigned <= 0:
		return "none working this moment"
	return "%d of %d working right now" % [assigned, headcount]


## Notice pay, on the button that springs it.
##
## `StaffPools::fire` drops `headcount` but leaves `owed` alone, and payday
## pays the heads who have already left FIRST (`staff.rs`, `pay_if_due`). So
## firing to escape a payday you cannot afford does not work — it is the one
## staffing rule whose consequence arrives after the decision, and the one a
## player is most likely to reach for in exactly the moment it will not help.
##
## It is in the `STAFF_RULES` legend at the foot of the panel, but a rule
## read once at the bottom of a panel is not a rule read at the moment of the
## click. A tooltip rather than a line on the row: this is a warning about a
## button, and it belongs on the button.
const STAFF_FIRE_NOTICE := "Notice pay: this period's wages are already owed, and heads who have left are paid FIRST. Firing saves money from the NEXT payday, not this one."


## What a click on HIRE does and what it costs, on the button itself: the
## staffing ticket's own complaint was that a bare "HIRE" says neither.
## "HIRE +1 · 2/period" — the head it adds and the wage it adds to every
## payday from now on, which is the recurring cost GAMEPLAY.md §5 makes the
## third spend axis. A category with no wage on the wire says only what the
## click does, rather than printing a cost of nothing.
func _staff_hire_button_text(category: Dictionary) -> String:
	var wage := int(category.get("wage", 0))
	if wage <= 0:
		return "HIRE +1"
	return "HIRE +1 · %d/period" % wage


## WHY a disabled HIRE is disabled, in words rather than in grey (ticket 1's
## hire-refusal rule: `money >= next_bill + wage`, so nobody is hired who
## cannot be paid). Every figure is the wire's — the balance, the bill it
## reports as `next_bill`, and the row's own wage — so this sentence can
## never quote a number the sim disagrees with. "" while `can_hire` is true,
## which is the common case, so the row shows nothing extra.
func _staff_hire_blocked_text(category: Dictionary, snapshot: Dictionary) -> String:
	if bool(category.get("can_hire", true)):
		return ""
	var wage := int(category.get("wage", 0))
	var bill := _staff_next_bill(snapshot)
	var money := int(floor(float(snapshot.get("money", 0.0))))
	return "✗ cannot hire — %d in hand, %d due, %d / period" % [money, bill, wage]


## What hiring this category's shortfall would actually unblock, named from
## the same `asked for by:` sources the WHY line uses (`_staff_demand_sources_for`).
## The sim's own rule makes this honest without inventing a fact: a machine
## that cannot get its WHOLE crew stalls, and a category whose `short` is 0
## has assigned == demand, so clearing the shortfall is exactly "every one of
## these gets its crew". "" when nothing is short — there is nothing to
## unblock — and a bare hire count when nothing placed names the category
## (a shortfall with no source is not a sentence this can complete).
func _staff_hire_unblocks_text(short: int, sources: Array) -> String:
	if short <= 0:
		return ""
	if sources.is_empty():
		return "hire %d and nothing goes short" % short
	var names: Array = []
	for source in sources:
		names.append(String(source["kind"]).replace("_", " "))
	if names.size() == 1:
		return "hire %d → the %s gets its crew again" % [short, names[0]]
	return "hire %d → %s all get their crew again" % [
		short, ", ".join(PackedStringArray(names)),
	]


## The sentence slot's ranking, worst news first. Also the order the hover
## lists them in, so the two readings agree.
const STAFF_SENTENCE_ORDER := [
	"status_label",
	"blocked_label",
	"unblock_label",
	"demand_label",
	"blurb_label",
]


## Leaves EXACTLY ONE of a row's five sentences visible, and hands the rest
## to the row's hover.
##
## All five used to be permanent lines, and a row was as tall as the worst
## case even in the common one: four categories at 147px did not fit the
## panel's 400px of scroll at 1600x900, which is issue #7. They are not
## redundant — each says something the others do not — but they are ranked,
## and a row that shows its worst news first loses nothing by making the
## reader hover for the rest.
##
## Worst-first: a head already idle after payday (`status`), then a hire that
## cannot happen and why (`blocked`), then what clearing the shortfall would
## unblock (`unblock`), then what asks for the category at all (`demand`),
## and last the blurb — which is what a row with no news of its own shows,
## and which is exactly the untouched category UI_UX.md §5 wants explained.
##
## Returns the key of the one left visible, "" if the row had nothing to say.
func _staff_row_sentence(row: Dictionary) -> String:
	var shown := ""
	for key in STAFF_SENTENCE_ORDER:
		var label: Label = row[key]
		# `_staff_prose_hidden`: at a window too narrow for the row to
		# carry both (`_fit_staff_width`), the slot is empty and all five
		# sentences are on the hover. The ranking still runs, so the one that
		# would have been shown is still the first one read there.
		var take_slot: bool = shown == "" and label.text != ""
		label.visible = take_slot and not _staff_prose_hidden
		if take_slot:
			shown = key
	# The hover carries every sentence the slot could not, in the same order,
	# so nothing that used to be on the row is actually gone from it — and
	# when the slot is gone as well, it carries all five.
	var rest: Array = []
	if _staff_prose_hidden:
		# Everything the narrow row could not keep, in the order it reads on a
		# wide one: why there is no bar, then what the bar's two numbers are.
		var note := row.get("note_label") as Label
		if note != null and bool(row.get("note_wanted", false)) and note.text != "":
			rest.append(note.text)
		var working := row.get("working_label") as Label
		if working != null and bool(row.get("working_wanted", false)) and working.text != "":
			rest.append(working.text)
		var caption := row.get("meter_caption") as Label
		if caption != null and not bool(row.get("note_wanted", false)):
			rest.append(caption.text)
	for key in STAFF_SENTENCE_ORDER:
		if key == shown and not _staff_prose_hidden:
			continue
		var text := String(row[key].text)
		if text != "":
			rest.append(text)
	row["panel"].tooltip_text = "\n".join(PackedStringArray(rest))
	return shown


## The panel's verdict, under the heading, before any row is read: is this
## factory staffed or not, in one sentence. The staffing ticket's lead —
## a player who opens H must not have to compare four meters to answer it.
## Returns `{"text", "short"}`; `short` is the total heads missing across
## every category (0 when nothing is short), which is also what the HUD
## alert outside the panel is keyed on.
##
## Three states, and each is a real one: something is short (name the
## categories and the heads to hire), nothing is short but something is
## asking (every machine has its crew), or nothing is asking at all — which
## is a new game, not a staffed one, and must not be congratulated as if it
## were. "Asking" means PLACED, not running: the establishment.
func _staff_summary_state(snapshot: Dictionary) -> Dictionary:
	var parts: Array = []
	var total_short := 0
	var total_required := 0
	for category in snapshot.get("categories", []):
		# `required` — the establishment — never `demand`. `demand` is what is
		# being worked THIS TICK, so a factory stalled for want of ingredients
		# (or of paid staff, which is exactly the state this verdict matters
		# in) reports zero and the panel used to greet a fully crewed line
		# with "nothing placed asks for staff yet".
		total_required += int(category.get("required", 0))
		var short := int(category.get("short", 0))
		if short <= 0:
			continue
		total_short += short
		parts.append("%d %s" % [short, _staff_category_word(category)])
	if total_short > 0:
		return {
			"text": "▲ %d short — hire %s" % [total_short, ", ".join(PackedStringArray(parts))],
			"short": total_short,
			"state": "short",
		}
	if total_required > 0:
		return {"text": "✔ every machine has its crew", "short": 0, "state": "crewed"}
	return {"text": "nothing placed asks for staff yet", "short": 0, "state": "idle"}


## A category's display name, lowercased, for prose ("hire 2 manufacturing").
## The wire's `name` when it has one, its id otherwise — never a table here.
func _staff_category_word(category: Dictionary) -> String:
	return String(category.get("name", category.get("id", ""))).to_lower()


## The always-visible SHORT-STAFFED alert (the staffing ticket's first
## requirement): the one thing outside the H panel that says the factory is
## understaffed, drawn on the clipboard beside the money and the wage bill —
## where the player is already looking — rather than as a second toast
## convention.
##
## `{}` when nothing is short, so the strip disappears entirely rather than
## reading "0 short"; `{"text", "short"}` otherwise, naming every short
## category, the heads to hire and the key that opens the panel. Glyph, words
## and colour together (UI_UX.md §7) — the colour is added by the caller.
## Every figure is the wire's own `short`; Godot never recomputes it.
func _staff_alert_state(snapshot: Dictionary) -> Dictionary:
	if snapshot.is_empty():
		return {}
	var parts: Array = []
	var total := 0
	for category in snapshot.get("categories", []):
		var short := int(category.get("short", 0))
		if short <= 0:
			continue
		total += short
		parts.append("%d %s" % [short, _staff_category_word(category)])
	if total == 0:
		return {}
	return {
		"text": "▲ SHORT-STAFFED — hire %s  ·  press H" % ", ".join(PackedStringArray(parts)),
		"short": total,
	}


## The rules of the staffing model, in the panel, in plain words (the
## staffing ticket's fourth requirement). Three sentences, each one a rule
## that is real in `sim_core` and was invisible in the UI until now — a
## player could only learn them by losing heads:
##
##   * a machine that cannot get its WHOLE crew stalls (GAMEPLAY.md §7:
##     it does not run degraded),
##   * notice pay — a head is billed for any period it worked any part of,
##     so firing just before payday saves nothing (the quality pass,
##     ticket 1),
##   * unpaid once is idle, unpaid twice is gone (same ticket).
##
## Kept to three lines of small print, not an essay: the panel is a control
## surface first.
func _staff_rules_text() -> String:
	var lines: Array[String] = ["how staffing works"]
	for rule in STAFF_RULES:
		lines.append("·  %s" % String(rule))
	return "\n".join(PackedStringArray(lines))


## The upcoming wage bill: every hired head at its category's wage — the
## payday rule (`docs/STAFF_POOLS_PLAN.md`, "The tick", step 5) applied to
## the snapshot's own numbers. Arithmetic on figures the wire carries, like
## the shop meter's price/money share; not a fact the sim reports
## separately (a `next_bill` on the wire would be the cleaner home if the
## payday rule ever stopped being "every head at its wage").
func _staff_bill(snapshot: Dictionary) -> int:
	var bill := 0
	for category in snapshot.get("categories", []):
		bill += int(category.get("headcount", 0)) * int(category.get("wage", 0))
	return bill


## What the NEXT payday will actually charge. The wire reports this as
## `next_bill` (`Σ owed × wage`), and since ticket 1's notice pay that is no
## longer the same sum as `_staff_bill`'s `Σ headcount × wage` — a head fired
## part-way through a period is still owed for it, so the two disagree exactly
## when someone has been let go. The wire's figure is the fact; `_staff_bill`
## survives as the fallback for a snapshot older than the field (and as the
## run-rate sum, which is what it honestly is).
func _staff_next_bill(snapshot: Dictionary) -> int:
	return int(snapshot.get("next_bill", _staff_bill(snapshot)))


## How far the balance falls short of that bill, 0 when it is covered. Also
## the sim's own figure (`StaffPools::shortfall`), for the same reason.
func _staff_shortfall(snapshot: Dictionary, money: float) -> int:
	# Floor the balance: a part unit cannot pay a whole head, so 13.9 against
	# a bill of 14 is short by 1, not by 0.1.
	return int(snapshot.get("shortfall", maxi(_staff_next_bill(snapshot) - int(floor(money)), 0)))


## Replays the payday cascade (`docs/CLAUDE.md`'s quality-pass-ticket-1
## rule, `staff.rs`'s own algorithm) against the snapshot's own numbers to
## answer "if payday ran right now, how many heads would go unpaid" — a
## figure the wire does not carry directly (only `unpaid_last_payday`, an
## AFTER-the-fact count, is on it). Pays `owed` heads one at a time per
## category in wire order (= `staff.ron` order = payday order); the first
## head the balance cannot cover, and every wage-earning head after it
## across every remaining category, goes unpaid. A zero-wage head is never
## unpaid, even mid-cascade — arithmetic on wire numbers against a
## documented, stable rule, the same standing as `_staff_bill`.
func _staff_unpaid_count_if_payday_now(snapshot: Dictionary) -> int:
	var balance := int(floor(float(snapshot.get("money", 0.0))))
	var unpaid := 0
	var short := false
	for category in snapshot.get("categories", []):
		var wage := int(category.get("wage", 0))
		var owed := int(category.get("owed", category.get("headcount", 0)))
		for i in range(owed):
			if wage == 0:
				continue
			if short:
				unpaid += 1
				continue
			if balance >= wage:
				balance -= wage
			else:
				short = true
				unpaid += 1
	return unpaid


## The BEFORE-payday warning (ticket 3): a glyph AND words, per UI_UX.md §7,
## wherever money is shown. The ticket's own example wording, singular when
## exactly one head would go unpaid.
func _staff_shortfall_text(shortfall: int, unpaid_count: int) -> String:
	var head_word := "head goes" if unpaid_count == 1 else "heads go"
	return "▲ next payday short by %d — %d %s unpaid" % [shortfall, unpaid_count, head_word]


## The footer's lines, pure given the snapshot and the tick: the bill per
## period, the countdown to payday in seconds (`_format_remaining`, so it is
## the same clock the dockets use), then either the BEFORE warning (money
## cannot cover the bill) or the balance the payday would leave behind, and
## finally — only when it happened — how many heads the last payday idled or
## lost (glyph + words, UI_UX.md §7).
func _staff_footer_text(snapshot: Dictionary, current_tick: int) -> String:
	var lines: Array[String] = []
	var remaining: int = int(snapshot.get("next_payday_tick", 0)) - current_tick
	var bill := _staff_next_bill(snapshot)
	# The wire's `next_bill`, so this and the clipboard's wages line can never
	# quote different numbers at the player for the same payday.
	lines.append("wages %d / period  ·  next payday in %s" % [
		bill, _format_remaining(remaining),
	])
	var money := float(snapshot.get("money", 0.0))
	var shortfall := _staff_shortfall(snapshot, money)
	if shortfall > 0:
		lines.append(_staff_shortfall_text(shortfall, _staff_unpaid_count_if_payday_now(snapshot)))
	else:
		lines.append("balance after payday: %d" % (int(floor(money)) - bill))
	var unpaid_last := int(snapshot.get("unpaid_last_payday", 0))
	if unpaid_last > 0:
		lines.append("✗ %d idled unpaid last payday" % unpaid_last)
	var walked_out := int(snapshot.get("walked_out_last_payday", 0))
	if walked_out > 0:
		lines.append("✗ %d left unpaid last payday" % walked_out)
	# "hiring is free" used to end this line and is gone: a hire is refused
	# unless the balance covers the next bill plus the new wage (the quality
	# pass, ticket 1), and the rules legend under this footer now says what
	# a head actually costs.
	# The rules legend lives at the end of the scrolled list (see
	# `_build_staff_panel`), so the one always-visible line says it is there.
	lines.append("HIRE and FIRE move one head    scroll for how staffing works    H/ESC: close")
	return "\n".join(PackedStringArray(lines))


## The AFTER-payday announcement (ticket 4): naming category and count, per
## the ticket's own wording, for a payday that just idled heads or lost
## them — the same words `_staff_status_text`'s row line uses, so a player
## who saw the notice and opens H reads the same sentence again. Pure given
## the snapshot the payday landed in; `""` when neither happened, so a
## covered payday announces nothing.
func _staff_payday_notice_text(snapshot: Dictionary) -> String:
	var lines: Array[String] = []
	for category in snapshot.get("categories", []):
		var name := String(category.get("name", category.get("id", ""))).to_lower()
		var unpaid := int(category.get("unpaid", 0))
		if unpaid > 0:
			lines.append("▲ PAYDAY: %d %s unpaid, idle until next payday" % [unpaid, name])
		var left := int(category.get("left_last_payday", 0))
		if left > 0:
			lines.append("✗ PAYDAY: %d %s left — unpaid two paydays running" % [left, name])
	return "\n".join(PackedStringArray(lines))


## Detects a payday by `next_payday_tick` moving forward since the last poll
## (the clock only ever advances, `staff.rs`'s payday step) and, when it has,
## shows `_staff_payday_notice_text` through the same fading notice a lost
## contract uses (`_show_contract_notice`) — one announcement mechanism for
## both, per the ticket. The first poll after a rebuild only PRIMES the
## clock (mirrors `_announce_contract_changes`'s `_known_active_primed`), so
## a loaded save is not read as a payday that just happened.
func _announce_staff_payday(snapshot: Dictionary) -> void:
	var next_tick := int(snapshot.get("next_payday_tick", 0))
	if _staff_known_payday_tick < 0:
		_staff_known_payday_tick = next_tick
		return
	if next_tick <= _staff_known_payday_tick:
		return
	_staff_known_payday_tick = next_tick
	var text := _staff_payday_notice_text(snapshot)
	if text != "":
		_show_contract_notice(text)


## The clipboard's wages WARNING, pure given the snapshot, the tick and the
## balance (the quality pass, ticket 4). GAMEPLAY.md §5 makes wages the third
## recurring cost axis, and until this line existed the bill appeared ONLY
## inside the H panel — a charge the player pays every period and could see
## only by going to look for it.
##
## It was the calm line too, until the CREW plate arrived (2026-09-16). The
## plate prints the bill and the countdown permanently, four inches below
## this one on the same edge, so keeping both meant the same sentence twice
## in one frame — against the one-fact-one-place rule this file opens with.
## What the clipboard keeps is the half the plate cannot do as well: the
## ALARM, next to the balance it is about. A player watching money sees the
## warning where the money is; a player asking "what does my crew cost" reads
## the plate. Calm state: nothing here at all.
##
## The warning names the shortfall in figures AND in words beside a glyph,
## since colour is never the whole message (UI_UX.md
## §7). The clock goes through `_format_remaining`, so it reads in seconds
## like every other player-facing clock and never in ticks (§5e).
##
## Returns `{}` when there is nothing honest to say — before the first
## `_poll_staff` has run, or with nobody on the books — rather than drawing
## "wages 0 / period", which would give a cost that does not exist.
func _contract_wages_state(snapshot: Dictionary, current_tick: int, money: float) -> Dictionary:
	if snapshot.is_empty():
		return {}
	var bill := _staff_next_bill(snapshot)
	if bill <= 0:
		return {}
	var due := _format_remaining(int(snapshot.get("next_payday_tick", 0)) - current_tick)
	var shortfall := _staff_shortfall(snapshot, money)
	if shortfall > 0:
		return {
			"text": "⚠ wages %d due in %s — short %d, unpaid heads leave" % [bill, due, shortfall],
			"short": true,
		}
	# Calm: silence. The CREW plate has the bill and the countdown, always up.
	return {}


## Drives every row and the footer from the last poll. Called each frame
## while the panel is open (the countdown moves), on opening, and after a
## HIRE or FIRE.
func _update_staff_panel() -> void:
	if _staff_panel == null:
		return
	var categories: Array = _staff_snapshot.get("categories", [])
	if not _staff_rows_match(categories):
		_rebuild_staff_rows(categories)
	_staff_money_label.text = "Money: %.0f" % float(_staff_snapshot.get("money", 0.0))

	# The verdict first, so the panel answers "am I short" before any row is
	# read (the staffing ticket's requirement 2).
	var summary := _staff_summary_state(_staff_snapshot)
	_staff_summary_label.text = String(summary["text"])
	# Three states, three inks: the warn red when short, the level green only
	# for an actual verdict of "crewed", and plain body ink when nothing has
	# asked for staff yet — a green tick over an idle line would read as a
	# pass mark the factory has not earned.
	match String(summary.get("state", "idle")):
		"short":
			_staff_summary_settings_obj.font_color = METER_FILL_WARN
		"crewed":
			_staff_summary_settings_obj.font_color = METER_FILL_LEVEL
		_:
			_staff_summary_settings_obj.font_color = _staff_summary_idle_color

	for i in range(min(categories.size(), _staff_rows.size())):
		var row: Dictionary = _staff_rows[i]
		var state := _staff_row_state(categories[i])
		row["hired_label"].text = state["hired_text"]
		row["wage_label"].text = state["wage_text"]
		# A category nothing has asked for has no ceiling, so it has no bar:
		# the whole meter line gives way to the idle note, which then stands
		# where the bar would have been rather than under an empty track.
		var idle: bool = state["note"] != ""
		row["note_label"].text = state["note"]
		# Remembered rather than read back off the label: at a narrow window
		# the note is on the row's hover instead (`_fit_staff_width`), and
		# this is what says where it belongs once the window is wide again.
		row["note_wanted"] = idle
		row["note_label"].visible = idle and not _staff_prose_hidden
		row["meter_row"].visible = not idle
		row["meter"].visible = not idle
		if not idle:
			var meter: Dictionary = state["meter"]
			_set_meter(row["meter"], float(meter["fraction"]), meter["color"])
			row["meter_label"].text = state["meter_text"]
		# The slot after the bar: the shortfall while there is one, and the
		# per-tick working count only when there is nothing to do about it.
		# Both at once would put a hiring instruction and a flow figure side
		# by side, which is the confusion the establishment fixed.
		var short_text: String = state["short_text"]
		var working: String = state["working_text"]
		row["short_label"].text = short_text
		row["short_label"].visible = short_text != ""
		row["working_label"].text = working
		# Wanted here, shown by `_apply_staff_prose`: the per-tick figure is the
		# widest sentence on the row ("none working this moment" is 262px) and
		# the first thing it gives up on a narrow window (issue #62).
		row["working_wanted"] = working != "" and short_text == ""
		row["working_label"].visible = bool(row["working_wanted"]) and not _staff_prose_hidden
		row["fire_button"].disabled = not bool(state["fire_enabled"])
		row["hire_button"].disabled = not bool(state["hire_enabled"])
		row["hire_button"].text = state["hire_text"]
		row["fire_button"].text = state["fire_text"]
		row["status_label"].text = state["status_text"]
		# The row's own verdict chip, and the warning border that goes with
		# it: a short row must be obvious without reading its meter.
		var state_label: Label = row["state_label"]
		state_label.text = state["state_text"]
		state_label.visible = state["state_text"] != ""
		state_label.label_settings.font_color = state["state_color"]
		row["panel"].add_theme_stylebox_override(
			"panel", _staff_row_style(bool(state["short_row"]))
		)
		var sources := _staff_demand_sources_for(
			String(categories[i].get("id", "")), _placements, _crews
		)
		row["demand_label"].text = _staff_demand_text(sources)
		row["unblock_label"].text = _staff_hire_unblocks_text(
			int(categories[i].get("short", 0)), sources
		)
		row["blocked_label"].text = _staff_hire_blocked_text(categories[i], _staff_snapshot)
		# One of those five is shown; the rest become the row's hover, so a
		# row says one thing at a time and still carries all of them.
		_staff_row_sentence(row)

	_staff_footer_label.text = _staff_footer_text(_staff_snapshot, sim.current_tick())
	_position_staff_panel()


## Hires one head of the row's category through the real command, then
## re-reads the wire at once so the row moves on the same frame.
func _staff_hire(index: int) -> void:
	_staff_move_head(index, "hire")


## Fires one head. At headcount 0 the button is disabled; the command is a
## silent no-op there anyway (the `Purchase` convention).
func _staff_fire(index: int) -> void:
	_staff_move_head(index, "fire")


func _staff_move_head(index: int, verb: String) -> void:
	if index < 0 or index >= _staff_rows.size():
		return
	var id := String(_staff_rows[index]["id"])
	var before := _headcount_of(id)
	sim.issue_command_json(JSON.stringify({
		"type": verb,
		"category": id,
	}))
	_poll_staff()
	_update_staff_panel()
	var after := _headcount_of(id)
	if after == before:
		_cue(FactoryAudio.REFUSED)
	else:
		_cue(FactoryAudio.HIRE if after > before else FactoryAudio.FIRE)


## A category's hired headcount from the last staff poll, or 0.
func _headcount_of(id: String) -> int:
	for category in _staff_snapshot.get("categories", []):
		if String(category.get("id", "")) == id:
			return int(category.get("headcount", 0))
	return 0


func _set_staff_open(open: bool) -> void:
	if _staff_panel == null or open == _staff_open:
		return
	if open:
		_close_config_panel() # see `_set_shop_menu_open`
	_staff_open = open
	_staff_panel.visible = open
	_cue(FactoryAudio.MENU_OPEN if open else FactoryAudio.MENU_CLOSE)
	if open:
		_poll_staff()
		_update_staff_panel()
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


func _toggle_staff_panel() -> void:
	_set_staff_open(not _staff_open)


# --------------------------------------------------------------------------
# The PRODUCTION panel (the production-stats epic — Factorio's P screen)
# --------------------------------------------------------------------------

## Builds the panel: a heading with the window selector, a scrolling list
## of one row per item the ledger has counted, and a footer that says what
## is counted. The same dark plate as the staff panel and the build menu
## (UI_UX.md §5: machine-side factory UI; the clipboard's paper is for
## orders), centred in the space above the hotbar for the same reason.
func _build_production_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = _ui_i(4)
	panel_style.border_width_left = _ui_i(2)
	panel_style.border_width_right = _ui_i(2)
	panel_style.border_width_bottom = _ui_i(2)
	panel_style.set_content_margin_all(_ui_px(16.0))

	# Cleared, never appended to: `_ready()` runs twice under the headless
	# harness (see `_build_ingredient_market`).
	_production_rows.clear()
	_production_window_buttons.clear()

	_production_panel = PanelContainer.new()
	_production_panel.name = "ProductionPanel"
	_production_panel.add_theme_stylebox_override("panel", panel_style)
	_production_panel.visible = false
	hud.add_child(_production_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(10))
	_production_panel.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(4)
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(16))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "PRODUCTION"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.add_child(title)

	# The window selector: one button per window the SIM keeps, in its
	# order, plus "all time". Built from the snapshot's `windows` rather
	# than typed here, so a retuned `STAT_WINDOWS` reads right without a
	# Godot edit — which is why the panel polls once before building.
	_poll_production()
	var selector := HBoxContainer.new()
	selector.name = "Windows"
	selector.add_theme_constant_override("separation", _ui_i(4))
	heading.add_child(selector)
	var windows: Array = _production_snapshot.get("windows", [])
	for index in range(windows.size()):
		_build_production_window_button(selector, base_settings, index, "last %s" % String(windows[index].get("id", "?")))
	_build_production_window_button(selector, base_settings, PRODUCTION_ALL_TIME, "all time")

	# The column captions, once, over the list — MADE and USED are the two
	# halves of every row and naming them per row would be noise.
	var captions := HBoxContainer.new()
	captions.add_theme_constant_override("separation", _ui_i(14))
	body.add_child(captions)
	var spacer := Control.new()
	spacer.custom_minimum_size = Vector2(PRODUCTION_ICON_SIZE.x + _ui_px(14.0) + _ui_px(150.0), 0.0)
	captions.add_child(spacer)
	for caption in ["MADE", "USED"]:
		var label := Label.new()
		label.label_settings = _staff_meta_settings()
		label.text = caption
		label.custom_minimum_size = Vector2(PRODUCTION_METER_WIDTH, 0.0)
		captions.add_child(label)

	_production_scroll = ScrollContainer.new()
	_production_scroll.name = "ProductionScroll"
	_production_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_production_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_production_scroll)

	_production_rows_box = VBoxContainer.new()
	_production_rows_box.name = "ProductionRows"
	_production_rows_box.add_theme_constant_override("separation", _ui_i(6))
	_production_rows_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_production_scroll.add_child(_production_rows_box)

	# What the list says when the window holds nothing: a sentence, not an
	# empty box (UI_UX.md §5c's rule for the save list).
	_production_empty_label = Label.new()
	_production_empty_label.name = "ProductionEmpty"
	_production_empty_label.label_settings = base_settings
	_production_empty_label.custom_minimum_size = Vector2(_ui_px(520.0), 0.0)
	body.add_child(_production_empty_label)

	_production_window_label = Label.new()
	_production_window_label.name = "ProductionWindow"
	_production_window_label.label_settings = _staff_meta_settings()
	body.add_child(_production_window_label)

	_production_footer_label = Label.new()
	_production_footer_label.name = "ProductionFooter"
	_production_footer_label.label_settings = base_settings
	_production_footer_label.text = "counted when a craft starts (used) and a batch lands (made); a paid order uses what it ships    ·    P/ESC: close"
	body.add_child(_production_footer_label)

	_update_production_panel()
	_position_production_panel()


## One window button. The selected one wears the hotbar's selected-socket
## style, the rest its stocked style — "the thing I have chosen" looks the
## same wherever the game asks (the configuration panel's picker made the
## same call).
func _build_production_window_button(parent: Node, base_settings: LabelSettings, index: int, caption: String) -> void:
	var button := Button.new()
	button.name = "Window_%s" % ("all" if index == PRODUCTION_ALL_TIME else str(index))
	button.text = caption
	button.focus_mode = Control.FOCUS_NONE
	button.custom_minimum_size = _ui_v(Vector2(74, 28))
	button.add_theme_font_size_override("font_size", base_settings.font_size)
	button.pressed.connect(_on_production_window_pressed.bind(index))
	parent.add_child(button)
	_production_window_buttons.append({"index": index, "button": button})


func _on_production_window_pressed(index: int) -> void:
	_set_production_window(index)


## Selects a window (an index into the snapshot's `windows`, or
## `PRODUCTION_ALL_TIME`) and redraws. A test drives it directly.
func _set_production_window(index: int) -> void:
	var count: int = _production_snapshot.get("windows", []).size()
	if index != PRODUCTION_ALL_TIME and (index < 0 or index >= count):
		return
	_production_window = index
	_update_production_panel()


## Centred in the space above the hotbar, by `_position_staff_panel`'s
## arithmetic and for its reason (the footer must stay on screen).
func _position_production_panel() -> void:
	if _production_panel == null:
		return
	_production_panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := _hotbar_reserved_height()
	var bounds := vp.get_visible_rect().size
	_fit_grid_scroll(_production_scroll, _production_rows_box, bounds.y - reserved - _ui_px(16.0), true)
	var panel_size := _production_panel.get_combined_minimum_size()
	_production_panel.position.x = maxf(0.0, (bounds.x - panel_size.x) * 0.5)
	_production_panel.position.y = max(8.0, (bounds.y - reserved - panel_size.y) * 0.5)


func _production_poll_due() -> bool:
	return _production_polled_tick < 0 or sim.current_tick() - _production_polled_tick >= LOAD_POLL_TICKS


## Re-reads `production_snapshot_json`. On opening, and on the load's cadence
## while the panel is up; a snapshot is the whole ledger's sums, so it is
## not read while nothing shows it.
func _poll_production() -> void:
	_production_polled_tick = sim.current_tick()
	var parsed = JSON.parse_string(sim.production_snapshot_json())
	if parsed is Dictionary:
		_production_snapshot = parsed


## A count over an observed span, as a per-minute rate in words:
## `12.0/min`. Divides by what was actually OBSERVED of the window, never
## by the window's nominal length (the wire's own rule), so a factory ten
## seconds old reads its true rate rather than a sixth of it. "" for a
## window nothing has been observed of, so a caller prints the count alone.
func _production_rate_text(count: int, observed_ticks: int) -> String:
	if observed_ticks <= 0:
		return ""
	var minutes: float = float(observed_ticks) / TICK_HZ / 60.0
	return "%.1f/min" % (float(count) / minutes)


## The window's caption for the line under the list: `last 5s`, `last 1m`,
## `all time`, with how much of a young window has been seen (`last 1m
## (32s so far)`), because a rate over a window the factory has not lived
## through yet is a rate over what it has.
func _production_window_text(snapshot: Dictionary, window: int) -> String:
	if window == PRODUCTION_ALL_TIME:
		return "all time"
	var windows: Array = snapshot.get("windows", [])
	if window < 0 or window >= windows.size():
		return ""
	var entry: Dictionary = windows[window]
	var text := "last %s" % String(entry.get("id", "?"))
	var observed := int(entry.get("observed", 0))
	var ticks := int(entry.get("ticks", 0))
	if observed < ticks:
		text += "  (%s so far)" % _format_remaining(observed)
	return text


## The rows for one window, SORTED and FORMATTED from the snapshot — the
## Godot half of the wire's contract ("the sim only counts"). One entry per
## id with anything made or used in the window, biggest first (made plus
## used, then id, so the order is stable between polls), each with the two
## counts, their rates, and each count as a share of the LARGEST count on
## the list so the bars compare across rows the way Factorio's do. Pure
## given the snapshot, so a test drives it with a literal.
func _production_rows_for(snapshot: Dictionary, window: int) -> Array:
	var windows: Array = snapshot.get("windows", [])
	var observed := 0
	if window != PRODUCTION_ALL_TIME:
		if window < 0 or window >= windows.size():
			return []
		observed = int(windows[window].get("observed", 0))
	var rows: Array = []
	for item in snapshot.get("items", []):
		if not (item is Dictionary):
			continue
		var made: int
		var used: int
		if window == PRODUCTION_ALL_TIME:
			made = int(item.get("produced_total", 0))
			used = int(item.get("consumed_total", 0))
		else:
			var produced: Array = item.get("produced", [])
			var consumed: Array = item.get("consumed", [])
			made = int(produced[window]) if window < produced.size() else 0
			used = int(consumed[window]) if window < consumed.size() else 0
		if made == 0 and used == 0:
			continue
		rows.append({
			"id": String(item.get("id", "")),
			"kind": String(item.get("kind", "item")),
			"name": _item_display_name(String(item.get("id", ""))),
			"made": made,
			"used": used,
			"made_rate": _production_rate_text(made, observed) if window != PRODUCTION_ALL_TIME else "",
			"used_rate": _production_rate_text(used, observed) if window != PRODUCTION_ALL_TIME else "",
		})
	rows.sort_custom(func(a, b):
		var ta: int = a["made"] + a["used"]
		var tb: int = b["made"] + b["used"]
		if ta != tb:
			return ta > tb
		return String(a["id"]) < String(b["id"]))
	var largest := 0
	for row in rows:
		largest = max(largest, max(int(row["made"]), int(row["used"])))
	for row in rows:
		row["made_fraction"] = float(row["made"]) / float(largest) if largest > 0 else 0.0
		row["used_fraction"] = float(row["used"]) / float(largest) if largest > 0 else 0.0
	return rows


## What a count prints ON its bar: the count, and the rate after it when
## there is one — `96  ·  32.0/min`, or `96` on the all-time view.
func _production_count_text(count: int, rate: String) -> String:
	if rate == "":
		return str(count)
	return "%d  ·  %s" % [count, rate]


## One item: its icon and name, then MADE and USED, each a bar with the
## count and rate printed on it. Returns `{"id", "panel", "name_label",
## "made_meter", "made_label", "used_meter", "used_label"}` for
## `_update_production_panel` to drive. Rows are rebuilt only when the SET
## of ids changes (a new intermediate appearing), and re-filled otherwise.
func _build_production_row(row_state: Dictionary) -> Dictionary:
	var id := String(row_state.get("id", "?"))
	var panel := PanelContainer.new()
	panel.name = "Production_%s" % id
	panel.add_theme_stylebox_override("panel", _staff_row_style())
	_production_rows_box.add_child(panel)

	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", _ui_i(14))
	panel.add_child(row)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.custom_minimum_size = PRODUCTION_ICON_SIZE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	icon.texture = _icon_for(id)
	row.add_child(icon)

	var text_col := VBoxContainer.new()
	text_col.add_theme_constant_override("separation", _ui_i(2))
	text_col.custom_minimum_size = Vector2(_ui_px(150.0), 0.0)
	text_col.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(text_col)

	var name_label := Label.new()
	name_label.name = "Name"
	name_label.label_settings = _contract_name_settings_dark()
	name_label.text = String(row_state.get("name", id))
	text_col.add_child(name_label)

	var kind_label := Label.new()
	kind_label.name = "Kind"
	kind_label.label_settings = _staff_meta_settings()
	kind_label.text = String(row_state.get("kind", "item"))
	text_col.add_child(kind_label)

	var made := _build_production_meter(row, "Made", METER_FILL_LEVEL)
	var used := _build_production_meter(row, "Used", METER_FILL_PROGRESS)

	return {
		"id": id, "panel": panel, "name_label": name_label,
		"made_meter": made["meter"], "made_label": made["label"],
		"used_meter": used["meter"], "used_label": used["label"],
	}


## A bar with its digits printed on it (position AND digits, UI_UX.md §7),
## the staff meter's arrangement.
func _build_production_meter(parent: Node, caption: String, fill_color: Color) -> Dictionary:
	var column := VBoxContainer.new()
	column.name = caption
	column.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	parent.add_child(column)
	var meter := _build_meter(column, PRODUCTION_METER_WIDTH, fill_color, METER_TRACK_COLOR, METER_BORDER_COLOR, STAFF_METER_HEIGHT)
	meter.name = "%sMeter" % caption
	var label := Label.new()
	label.name = "%sLabel" % caption
	label.label_settings = _staff_meter_settings()
	label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	meter.add_child(label)
	return {"meter": meter, "label": label}


func _production_rows_match(rows: Array) -> bool:
	if rows.size() != _production_rows.size():
		return false
	for i in range(rows.size()):
		if String(rows[i]["id"]) != String(_production_rows[i]["id"]):
			return false
	return true


func _rebuild_production_rows(rows: Array) -> void:
	for row in _production_rows:
		var panel: Node = row["panel"]
		if is_instance_valid(panel):
			if panel.get_parent() != null:
				panel.get_parent().remove_child(panel)
			panel.queue_free()
	_production_rows.clear()
	for row_state in rows:
		_production_rows.append(_build_production_row(row_state))


## Redraws the panel from the last poll: the selected window's rows, the
## selector's highlight, the window caption, the empty-list sentence. Runs
## every frame while open (a bar moves as a craft lands) and on opening.
func _update_production_panel() -> void:
	if _production_panel == null:
		return
	var rows := _production_rows_for(_production_snapshot, _production_window)
	if not _production_rows_match(rows):
		_rebuild_production_rows(rows)
	for i in range(min(rows.size(), _production_rows.size())):
		var state: Dictionary = rows[i]
		var row: Dictionary = _production_rows[i]
		_set_meter(row["made_meter"], float(state["made_fraction"]), METER_FILL_LEVEL)
		row["made_label"].text = _production_count_text(int(state["made"]), String(state["made_rate"]))
		_set_meter(row["used_meter"], float(state["used_fraction"]), METER_FILL_PROGRESS)
		row["used_label"].text = _production_count_text(int(state["used"]), String(state["used_rate"]))
	for entry in _production_window_buttons:
		var selected: bool = int(entry["index"]) == _production_window
		# Re-styled only when the selection moves, from the hotbar's cached
		# styleboxes: this ran on every update while the panel was open and
		# built five new StyleBoxFlats per button each time (the quality
		# pass, 2026-09-13).
		if entry.has("selected") and bool(entry["selected"]) == selected:
			continue
		entry["selected"] = selected
		var button: Button = entry["button"]
		var style_key := "selected" if selected else "stocked"
		var style: StyleBoxFlat = _hotbar_styles.get(style_key, _hotbar_slot_style(style_key))
		for state in ["normal", "hover", "pressed", "disabled", "focus"]:
			button.add_theme_stylebox_override(state, style)
	_production_window_label.text = _production_window_text(_production_snapshot, _production_window)
	var empty := rows.is_empty()
	_production_scroll.visible = not empty
	_production_empty_label.visible = empty
	if empty:
		_production_empty_label.text = "nothing made or used %s — a running machine will show here" % _production_window_text(_production_snapshot, _production_window)
	_position_production_panel()


func _set_production_open(open: bool) -> void:
	if _production_panel == null or open == _production_open:
		return
	if open:
		_close_config_panel() # see `_set_shop_menu_open`
	_production_open = open
	_production_panel.visible = open
	if open:
		_poll_production()
		_update_production_panel()
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


func _toggle_production_panel() -> void:
	_set_production_open(not _production_open)


## Reads the crew every placed machine and dock needs, from
## `query_tile_json`, once per rebuild — `_seed_machine_states`'s twin.
## A crew is content (the kind's `machines.ron` requirement) and never
## changes while the thing stands, so it is not on the chunk wire.
func _seed_crews() -> void:
	_crews.clear()
	for placement in _placements:
		var kind := String(placement.get("kind", ""))
		if placement.get("recipe") == null and kind != DOCK_KIND:
			continue
		var origin := _placement_origin(placement)
		var parsed = JSON.parse_string(sim.query_tile_json(origin.x, origin.y))
		if parsed is Dictionary and parsed.get("crew") is Array:
			_crews[_tile_key(origin)] = parsed["crew"]


## What asks for a category, by KIND: every placement's crew (from
## `_crews`, seeded per rebuild) that names `category_id`, totalled per kind
## across every placement of it — a second crusher doubles the crusher's own
## number rather than adding a second "crusher ×1" line. Order is first
## encountered in `_placements` (the simulation's own tile order), so the
## panel's WHY line is stable across a poll rather than reshuffling with a
## dictionary's own order. Returns `[{"kind", "count"}]`, empty when nothing
## placed asks for this category.
func _staff_demand_sources_for(category_id: String, placements: Array, crews: Dictionary) -> Array:
	var totals: Dictionary = {}
	var order: Array = []
	for placement in placements:
		var crew = crews.get(_tile_key(_placement_origin(placement)), [])
		if not (crew is Array):
			continue
		for entry in crew:
			if String(entry.get("category", "")) != category_id:
				continue
			var kind := String(placement.get("kind", ""))
			if not totals.has(kind):
				totals[kind] = 0
				order.append(kind)
			totals[kind] += int(entry.get("count", 0))
	var sources: Array = []
	for kind in order:
		sources.append({"kind": kind, "count": totals[kind]})
	return sources


## The WHY line under a category row: `_staff_demand_sources_for`'s result
## in words, kind names lowercase and space-separated (`cooking_vat` ->
## `cooking vat`) since this is prose, not `_kind_display_name`'s title-case
## card text. The exact sentence an empty factory reads
## (`'nothing placed asks for staff yet'`) is pinned by the quality pass.
func _staff_demand_text(sources: Array) -> String:
	if sources.is_empty():
		return "nothing placed asks for staff yet"
	var parts: Array = []
	for source in sources:
		parts.append("%s ×%d" % [String(source["kind"]).replace("_", " "), int(source["count"])])
	return "asked for by: %s" % ", ".join(PackedStringArray(parts))


## A crew in words: `crew: 2 manufacturing`, `crew: 1 manufacturing, 1
## packaging`; "" for no crew, so a caller can drop the line rather than
## print "crew: none" on every belt.
func _crew_text(crew) -> String:
	if not (crew is Array) or crew.is_empty():
		return ""
	var parts: Array = []
	for entry in crew:
		parts.append("%d %s" % [int(entry.get("count", 0)), String(entry.get("category", ""))])
	return "crew: %s" % ", ".join(PackedStringArray(parts))


## The categories a crew names, joined: "logistics", "manufacturing and
## packaging". For the dock's "held · short of logistics staff".
func _crew_categories_text(crew) -> String:
	if not (crew is Array) or crew.is_empty():
		return ""
	var names: Array = []
	for entry in crew:
		names.append(String(entry.get("category", "")))
	return " and ".join(PackedStringArray(names))


## `_crew_text` plus the running cost per period that crew costs at the
## last staff poll's wages — GAMEPLAY.md §5's third cost axis, made visible
## where a kind is bought rather than only after it is placed. Falls back to
## plain `_crew_text` if `wages_by_category` is missing an entry (a poll
## that has not happened yet, or a category the wire has not named): a
## missing number is honest, a guessed one is not.
##
## Two lines, not one joined by " · " (the quality pass, ticket 5): on the
## card's own width "crew: 2 manufacturing · 4 / period" ran past the edge
## on every kind with a crew, clipped by the next card's stylebox drawing
## over it (UI_UX.md §2b point 32 — the card was not given a line back after
## the cost joined it). A literal newline is a bounded two lines; leaving it
## to `AUTOWRAP_WORD_SMART` wrapped mid-phrase into three ("manufacturing ·
## 2 /" then "period") and still overran the card into the row below.
func _crew_cost_text(crew, wages_by_category: Dictionary) -> String:
	var text := _crew_text(crew)
	if text == "" or not (crew is Array):
		return text
	var cost := 0
	for entry in crew:
		var category := String(entry.get("category", ""))
		if not wages_by_category.has(category):
			return text
		cost += int(entry.get("count", 0)) * int(wages_by_category[category])
	return "%s\n%d / period" % [text, cost]


## The pure half of a docket's status (the contract-board epic): how far
## through its window a contract is, how many units it is short, and which
## of four states that puts it in —
##
##   "ready"        the pool holds the whole mix; the next check pays
##   "last_chance"  short, and the next miss loses the contract
##   "risk"         short, with CONTRACT_RISK_FRACTION of the window gone
##   "ok"           short, but early in the window
##
## `satisfied` is the simulation's own all-or-nothing verdict (the wire
## carries it so the two can never disagree); everything else is arithmetic
## on the same snapshot the docket draws from. Returns
## `{"level", "elapsed", "short", "satisfied"}`.
func _contract_risk_for(contract: Dictionary, current_tick: int) -> Dictionary:
	var cadence: int = max(1, int(contract.get("cadence_ticks", 1)))
	var next_tick: int = int(contract.get("next_delivery_tick", 0))
	var start: int = int(contract.get("window_start_tick", next_tick - cadence))
	var elapsed := clampf(float(current_tick - start) / float(cadence), 0.0, 1.0)
	var short := 0
	var mix: Array = contract.get("mix", [])
	var progress: Array = contract.get("progress", [])
	for i in range(mix.size()):
		var have: int = int(progress[i][1]) if i < progress.size() else 0
		short += max(0, int(mix[i][1]) - have)
	var satisfied: bool = bool(contract.get("satisfied", short == 0))
	var misses: int = int(contract.get("consecutive_misses", 0))
	var strikes: int = max(1, int(contract.get("strikes", 1)))
	var level := "ok"
	if satisfied:
		level = "ready"
	elif misses + 1 >= strikes:
		level = "last_chance"
	elif elapsed >= CONTRACT_RISK_FRACTION:
		level = "risk"
	return {"level": level, "elapsed": elapsed, "short": short, "satisfied": satisfied}


func _contract_state_color(level: String) -> Color:
	match level:
		"ready":
			return CONTRACT_READY_COLOR
		"risk":
			return CONTRACT_RISK_COLOR
		"last_chance":
			return CONTRACT_LAST_CHANCE_COLOR
	return Color(0.34, 0.29, 0.20, 1.0) # the clipboard's meta ink


func _contract_card_style_for(level: String) -> StyleBoxFlat:
	match level:
		"ready":
			return _contract_card_style_ready
		"risk":
			return _contract_card_style_risk
		"last_chance":
			return _contract_card_style_last_chance
	return _contract_card_style


func _set_strike_pip(pip: Panel, struck: bool) -> void:
	if bool(pip.get_meta("struck", false)) == struck:
		return
	pip.set_meta("struck", struck)
	pip.add_theme_stylebox_override("panel", _strike_style_struck if struck else _strike_style_empty)


## Diffs the active list against the last poll and announces what changed:
## a contract that vanished was LOST (the simulation drops it the tick its
## strikes run out), one that appeared was SIGNED. The first poll after a
## scene build only primes the list, so a loaded save is not read as a
## string of losses.
func _announce_contract_changes(contracts: Array, board: Array) -> void:
	var ids: Array = []
	for contract in contracts:
		ids.append(String(contract.get("id", "")))
	if _known_active_primed:
		# The first change this poll shows right away, as it always has;
		# a second (or third) in the same poll queues instead of silently
		# overwriting the one before it, since it will otherwise be
		# clobbered before a single frame renders it.
		var raised := false
		for id in _known_active_contract_ids:
			if not ids.has(id):
				var text := "✗ CONTRACT LOST: %s — sign it again on the board (C)" % _board_name_for(String(id), board)
				if raised:
					_contract_notice_queue.append(text)
				else:
					_show_contract_notice(text)
					raised = true
				_cue(FactoryAudio.CONTRACT_LOST)
		for id in ids:
			if not _known_active_contract_ids.has(id):
				var text := "✔ SIGNED: %s" % _board_name_for(String(id), board)
				if raised:
					_contract_notice_queue.append(text)
				else:
					_show_contract_notice(text)
					raised = true
	_known_active_contract_ids = ids
	_known_active_primed = true


## Diffs `unlocks` against the last poll and announces any gate that just
## opened — the one moment in the game where the shop and the board both
## grow, so it gets the same one-line notice a signature does rather than a
## widget of its own (UI_UX.md §5: one announcement mechanism).
##
## What it says is built from the snapshot, not written out here: `name` is
## the tier's player-facing name from `data/unlocks.ron`, and the counts say
## which halves of the game changed, so a later gate that only opens
## contracts does not claim to have stocked the shop as well.
##
## The first poll after a scene build only primes, exactly like
## `_announce_contract_changes`: loading a save that is already past the
## threshold must not re-announce a tier the player earned sessions ago.
func _announce_unlocks(unlocks: Array) -> void:
	var open_ids: Array = []
	for unlock in unlocks:
		if bool(unlock.get("open", false)):
			open_ids.append(String(unlock.get("id", "")))
	if _known_unlocks_primed:
		for unlock in unlocks:
			var id := String(unlock.get("id", ""))
			if not bool(unlock.get("open", false)) or _known_open_unlock_ids.has(id):
				continue
			var opened: Array[String] = []
			if int(unlock.get("ingredients", 0)) > 0:
				opened.append("new ingredients in the shop")
			if int(unlock.get("contracts", 0)) > 0:
				opened.append("new orders on the board")
			var tier_name := String(unlock.get("name", id))
			var text := "★ %s unlocked" % tier_name
			if not opened.is_empty():
				text += " — %s" % ", ".join(opened)
			# Queued behind whatever is showing rather than over it: an
			# unlock lands on a delivery, and a delivery is exactly when a
			# contract notice is most likely to be mid-fade.
			if Time.get_ticks_msec() < _contract_notice_until_msec:
				_contract_notice_queue.append(text)
			else:
				_show_contract_notice(text)
			# The payout cue, not a new one: this IS the celebration sound,
			# and an unlock arrives on the delivery that earned it.
			_cue(FactoryAudio.PAYOUT)
	_known_open_unlock_ids = open_ids
	_known_unlocks_primed = true


func _board_name_for(id: String, board: Array) -> String:
	for offer in board:
		if String(offer.get("id", "")) == id:
			return String(offer.get("name", id))
	return id


func _show_contract_notice(text: String) -> void:
	if _contract_notice == null:
		return
	_contract_notice.text = text
	_contract_notice_until_msec = Time.get_ticks_msec() + CONTRACT_NOTICE_HOLD_MSEC
	_contract_notice.modulate = Color(1, 1, 1, 1)
	_position_contract_notice()


## Just under the legend, flush with its left edge: the top strip is already
## the legend's (left) and the clipboard's (right), and a line centred along
## the top edge sat on both — found in a rendered frame, twice. Below the
## legend is the first clear band over the factory, where a player mid-build
## is looking, and hanging off the legend's own edge keeps it out of the
## clipboard however long the contract's name is.
func _position_contract_notice() -> void:
	if _contract_notice == null:
		return
	var left: float = _ui_px(18.0)
	var top: float = _ui_px(18.0)
	# The legend's CURRENT rect (`_legend_rect`), not the rect it has when
	# expanded: a folded legend that still pushed this line five lines down
	# the screen would leave the notice floating over nothing, which is most
	# of the reason the fold is worth having.
	var legend := _legend_rect()
	if legend.size.y > 0.0:
		left = legend.position.x
		top = legend.end.y + _ui_px(14.0)
	_contract_notice.set_anchors_preset(Control.PRESET_TOP_LEFT)
	_contract_notice.position = Vector2(left, top)
	_contract_notice.size = _contract_notice.get_combined_minimum_size()


func _update_contract_notice() -> void:
	if _contract_notice == null:
		return
	var now := Time.get_ticks_msec()
	var remaining := _contract_notice_until_msec - now
	# Fully faded and something is waiting: start it, rather than the next
	# `_show_contract_notice` call overwriting a label nobody finished
	# reading.
	if remaining <= -CONTRACT_NOTICE_FADE_MSEC and not _contract_notice_queue.is_empty():
		_show_contract_notice(_contract_notice_queue.pop_front())
		return
	if remaining >= 0:
		_contract_notice.modulate = Color(1, 1, 1, 1)
		_position_contract_notice() # the legend lays out after the first frame
	elif remaining > -CONTRACT_NOTICE_FADE_MSEC:
		_contract_notice.modulate = Color(1, 1, 1, 1.0 + float(remaining) / float(CONTRACT_NOTICE_FADE_MSEC))
	else:
		_contract_notice.modulate = Color(1, 1, 1, 0)


## The STOCK plate: one row per raw ingredient, on the right-hand edge under
## the contracts clipboard. Built from the same snapshot the market sells
## from, so it lists whatever `data/ingredients.ron` prices with no list of
## its own — a fourth raw ingredient appears here, in the market and in a
## hopper's picker from the data file alone.
##
## A SIBLING OF THE CLIPBOARD, not a child of the hotbar's column. The strip
## this replaces was built into `_hotbar_root`, which is why it was one line
## tall and centred over the sockets; a plate of its own can be as tall as
## its list and can sit where the ticket asks for it. Mouse filter IGNORE
## throughout, like the strip before it: it is a readout with no controls on
## it, and a plate that swallowed clicks would make the tiles behind it
## unbuildable on the one edge a factory usually grows towards.
func _build_stock_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var plate := StyleBoxFlat.new()
	plate.bg_color = Color(0.06, 0.06, 0.07, 0.93)
	plate.border_color = Color(0.85, 0.63, 0.11, 0.95)
	plate.border_width_top = _ui_i(3)
	plate.set_content_margin_all(_ui_px(10.0))

	# Cleared, never appended to: `_ready()` genuinely runs twice under the
	# headless `--script` harness — the same guard `_build_ingredient_market`
	# carries, and the reason this dictionary is rebuilt rather than added to.
	_larder_entries.clear()
	_stock_row_nodes.clear()
	_larder_ids.clear()

	_stock_panel = PanelContainer.new()
	_stock_panel.name = "StockPanel"
	_stock_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_stock_panel.add_theme_stylebox_override("panel", plate)
	_stock_panel.custom_minimum_size.x = STOCK_PANEL_MIN_WIDTH
	hud.add_child(_stock_panel)

	var body := VBoxContainer.new()
	body.name = "StockBody"
	body.mouse_filter = Control.MOUSE_FILTER_IGNORE
	body.add_theme_constant_override("separation", _ui_i(6))
	_stock_panel.add_child(body)

	var heading_settings := LabelSettings.new()
	heading_settings.font_size = _ui_font(-1)
	heading_settings.font_color = Color(0.98, 0.85, 0.42) # the plate's hazard accent
	heading_settings.outline_size = base_settings.outline_size
	heading_settings.outline_color = base_settings.outline_color

	# Heading and hint share one line. They are two words between them and the
	# plate's height is the scarce thing in this column (the clipboard above
	# it scrolls already), so a line spent on `M: market` alone is a row of
	# stock the player cannot see at 1280x720.
	var head_row := HBoxContainer.new()
	head_row.name = "StockHeadRow"
	head_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head_row.add_theme_constant_override("separation", _ui_i(12))
	body.add_child(head_row)

	var heading := Label.new()
	heading.name = "StockHeading"
	heading.mouse_filter = Control.MOUSE_FILTER_IGNORE
	heading.label_settings = heading_settings
	heading.text = "STOCK"
	heading.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	head_row.add_child(heading)

	# The list scrolls past `STOCK_PANEL_HEIGHT_SHARE` of the column rather
	# than growing into the clipboard — `_fit_grid_scroll`'s job everywhere
	# else in this HUD, and the same last resort it is there.
	_stock_scroll = ScrollContainer.new()
	_stock_scroll.name = "StockScroll"
	_stock_scroll.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_stock_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	body.add_child(_stock_scroll)

	_stock_rows = VBoxContainer.new()
	_stock_rows.name = "StockRows"
	_stock_rows.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_stock_rows.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_stock_rows.add_theme_constant_override("separation", _ui_i(5))
	_stock_scroll.add_child(_stock_rows)

	_stock_base_settings = base_settings
	_rebuild_stock_rows(_ingredients_snapshot().get("entries", []))

	var hint_settings := LabelSettings.new()
	hint_settings.font_size = _ui_font(-2)
	hint_settings.font_color = Color(0.66, 0.68, 0.72)
	hint_settings.outline_size = base_settings.outline_size
	hint_settings.outline_color = base_settings.outline_color

	# Kept from the strip: the plate says what it counts, and the key that
	# buys more of it. A readout that names its own verb's home.
	_stock_hint = Label.new()
	_stock_hint.name = "StockHint"
	_stock_hint.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_stock_hint.label_settings = hint_settings
	_stock_hint.text = "M: market"
	_stock_hint.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	head_row.add_child(_stock_hint)

	_position_stock_panel()


## The pure half of the CREW plate — every string it shows, from the wire's
## own figures and nothing else, so a test can drive it with a snapshot and
## no scene. Mirrors `_staff_row_state`'s split for the H panel.
##
## Returns `{"rows": [...], "payday_text", "afford_text", "afford_warn"}`.
## Each row is `{"id", "count_text", "chip_text", "assigned_text", "short"}`.
func _crew_plate_state(snapshot: Dictionary, current_tick: int) -> Dictionary:
	var rows: Array = []
	for category in snapshot.get("categories", []):
		var id := String(category.get("id", ""))
		var headcount := int(category.get("headcount", 0))
		var required := int(category.get("required", 0))
		var short := int(category.get("short", 0))
		var sources := _staff_demand_sources_for(id, _placements, _crews)
		rows.append({
			"id": id,
			"count_text": "%d / %d" % [headcount, required],
			"chip_text": ("▲ HIRE %d" % short) if short > 0 else "",
			"assigned_text": _crew_assigned_text(required, sources),
			"short": short > 0,
			# A category nothing has ever asked for and nobody has been hired
			# into takes no room at all. Today that is `maintenance`: no
			# machine in `machines.ron` requires it and the roster starts it
			# at zero, so a permanent "Maintenance 0 / 0 — nothing needs them
			# yet" row would cost a quarter of this plate to say nothing. It
			# is still in the H panel, with its own note, so hiring one is
			# still possible and still explained; and the moment a head IS
			# hired or a machine asks, the row appears here.
			"visible": required > 0 or headcount > 0,
		})

	var bill := _staff_next_bill(snapshot)
	var remaining: int = int(snapshot.get("next_payday_tick", 0)) - current_tick
	var money := float(snapshot.get("money", 0.0))
	var shortfall := _staff_shortfall(snapshot, money)
	var afford_text := ""
	if shortfall > 0:
		# The same sentence the H panel's footer uses, so a player who reads
		# it here and then opens the panel is not told it twice in two
		# different ways.
		afford_text = _staff_shortfall_text(
			shortfall, _staff_unpaid_count_if_payday_now(snapshot)
		)
	return {
		"rows": rows,
		# Named, not bare: "payday in 18s · 10" left the 10 to be guessed at,
		# and the two figures on this line are in different units.
		"payday_text": "payday in %s  ·  wages %d" % [_format_remaining(remaining), bill],
		"afford_text": afford_text,
		"afford_warn": shortfall > 0,
	}


## What a category is committed to, in the machines' own names. The
## establishment's sources, never what happens to be running — the whole
## point of the change this plate was built for.
##
## "nothing needs them yet" for a category with no establishment, which is
## the honest reading of a `required` of 0 and reads better in a corner
## plate than the H panel's longer idle note.
func _crew_assigned_text(required: int, sources: Array) -> String:
	if required <= 0 or sources.is_empty():
		# The state a new game opens in: a roster on the books and an empty
		# field. "idle" says whose fault that is — nothing is wrong, there is
		# simply nothing placed for them to be on yet.
		return "idle — nothing needs them yet"
	var parts: Array = []
	for source in sources:
		parts.append(String(source["kind"]).replace("_", " "))
	return ", ".join(PackedStringArray(parts))


## Draws `_crew_plate_state` onto the plate. Called on the same cadence as
## the larder, so the payday countdown ticks down whether or not any panel
## is open.
func _update_crew_panel() -> void:
	if _crew_panel == null:
		return
	var state := _crew_plate_state(_staff_snapshot, sim.current_tick())
	for row_state in state["rows"]:
		var nodes = _crew_row_nodes.get(String(row_state["id"]), null)
		if not (nodes is Dictionary):
			continue
		nodes["count_label"].text = row_state["count_text"]
		var chip: Label = nodes["chip_label"]
		chip.text = row_state["chip_text"]
		chip.visible = row_state["chip_text"] != ""
		nodes["assigned_label"].text = row_state["assigned_text"]
		# A short row fades UP rather than recolouring: the ▲ HIRE chip
		# beside it already carries the glyph and the word, so the alpha is
		# the third cue and never the only one (UI_UX.md §7).
		nodes["wrap"].modulate = Color(1, 1, 1, 1.0 if row_state["short"] else 0.86)
		nodes["wrap"].visible = row_state["visible"]
	_crew_payday_label.text = state["payday_text"]
	_crew_afford_label.text = state["afford_text"]
	_crew_afford_label.visible = state["afford_text"] != ""
	_position_crew_panel()


## Parks the plate against the right edge, its bottom a margin clear of the
## hotbar — the position the STOCK plate used to hold alone.
##
## CREW sits BELOW stock and stock is pushed up off it
## (`_position_stock_panel` reads this plate's top edge as its floor). The
## order is deliberate: this plate is the bounded one, so it can take its
## natural height and let the unbounded list above it do the scrolling. Put
## the other way round, every hire or newly priced ingredient would fight
## the same pixels.
func _position_crew_panel() -> void:
	if _crew_panel == null:
		return
	var vp := get_viewport()
	if vp == null:
		return
	var bounds := vp.get_visible_rect().size
	if bounds.x <= 0.0 or bounds.y <= 0.0:
		return
	var floor_y: float = bounds.y - _hotbar_reserved_height() - STOCK_PANEL_MARGIN
	if _hotbar_panel != null and _hotbar_panel.size.y > 0.0:
		floor_y = _hotbar_panel.get_global_rect().position.y - STOCK_PANEL_MARGIN
	# Fit before measuring, or the plate is placed at the height it wanted
	# and the plates above it were told to expect the height it settled at.
	var size := Vector2(_crew_panel.get_combined_minimum_size().x, _crew_fit_detail())
	_crew_panel.size = size
	_crew_panel.position = Vector2(
		maxf(0.0, bounds.x - size.x - STOCK_PANEL_MARGIN),
		maxf(0.0, floor_y - size.y)
	)


## How much of the column the CREW plate takes, for the STOCK plate above it
## to stay clear of. Its WANTED height, like `_stock_wanted_height`, so the
## two caps cannot chase each other: this plate never scrolls, so what it
## wants is what it gets.
func _crew_reserved_height() -> float:
	if _crew_panel == null or not _crew_panel.visible:
		return 0.0
	return _crew_fit_detail() + STOCK_PANEL_MARGIN


## Fits the plate into its share of the column by DROPPING DETAIL, not by
## scrolling, and returns the height it settled at.
##
## The other two tenants of this column scroll when they run out of room,
## because both of them are unbounded lists — any number of ingredients, any
## number of signed contracts. This one is bounded: there are four staff
## categories in `staff.ron` and there will not suddenly be forty. So it has
## a better move available than a scrollbar, which on an at-a-glance readout
## would be self-defeating — the whole point of the plate is that you do not
## have to interact with it.
##
## What it gives up first is the "what are they assigned to" line. Losing the
## machine names costs the player the least: the count, the `hired /
## required` and the ▲ HIRE chip are the parts you ACT on, and the names are
## still in the H panel in full. Every category stays on screen either way,
## which a scroll could not promise.
##
## The cap is measured off the viewport and the hotbar only — never off the
## clipboard or the stock plate, both of which are sized against THIS plate's
## reserved height. Reading either of them here would close the loop and the
## three would chase each other frame to frame, which is the bug
## `_stock_reserved_height` documents from the two-plate era.
func _crew_fit_detail() -> float:
	if _crew_panel == null:
		return 0.0
	var vp := get_viewport()
	if vp == null or vp.get_visible_rect().size.y <= 0.0:
		return _crew_panel.get_combined_minimum_size().y
	# Measured off the hotbar PLATE, the same floor this plate is hung from
	# (`_position_crew_panel`), not `_hotbar_reserved_height()`: that also
	# reserves the strip the item-name flyout pops into, which is centred over
	# the hotbar and cannot reach this far right. At 1600x900 the difference
	# is the whole assignment line.
	var floor_y: float = vp.get_visible_rect().size.y - _hotbar_reserved_height() - STOCK_PANEL_MARGIN
	if _hotbar_panel != null and _hotbar_panel.size.y > 0.0:
		floor_y = _hotbar_panel.get_global_rect().position.y - STOCK_PANEL_MARGIN
	var cap: float = (floor_y - STOCK_PANEL_MARGIN) * CREW_PANEL_HEIGHT_SHARE
	# Ask for everything first, then measure: the answer has to depend on the
	# window alone, not on whatever the previous frame happened to hide.
	_crew_set_detail_visible(true)
	if _crew_panel.get_combined_minimum_size().y <= cap:
		return _crew_panel.get_combined_minimum_size().y
	_crew_set_detail_visible(false)
	return _crew_panel.get_combined_minimum_size().y


## Shows or hides every row's assignment line in one go — the detail is all
## of it or none of it, never per row, so the rows keep a common height and
## the eye can still run down the numbers column.
func _crew_set_detail_visible(shown: bool) -> void:
	for id in _crew_row_nodes:
		var nodes = _crew_row_nodes[id]
		if nodes is Dictionary:
			nodes["assigned_label"].visible = shown


## The CREW plate: the staffing readout that needs no key pressed.
##
## The playtest's complaint was that staffing was only legible inside the H
## panel, so the player learned they were short by watching a machine stall.
## This plate answers the four questions that were behind that, permanently,
## in the corner the player is already using for STOCK:
##
##   * who you have and what they are committed to (`hired / required`, and
##     the machines asking, by name),
##   * whether you must hire (the ▲ HIRE chip and the amber border),
##   * what the next payday costs and when it lands,
##   * whether the balance covers it — the warning BEFORE the money is gone,
##     not the report afterwards.
##
## Every figure is the wire's. Godot does no staffing arithmetic here: the
## establishment, the shortfall and the bill are all `sim_core`'s, which is
## the point of the 2026-09-16 change (CLAUDE.md: gameplay logic lives in
## Rust, never in GDScript).
##
## Mouse filter IGNORE throughout, exactly as STOCK is and for the same
## reason: this is a readout, and the right-hand edge is the side a factory
## usually grows towards, so a plate that swallowed clicks would make those
## tiles unbuildable. HIRE and FIRE stay in the H panel, which this plate
## names on its own hint line.
func _build_crew_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var plate := StyleBoxFlat.new()
	plate.bg_color = Color(0.06, 0.06, 0.07, 0.93)
	plate.border_color = CREW_PANEL_ACCENT
	plate.border_width_top = _ui_i(3)
	plate.set_content_margin_all(CREW_PANEL_PADDING)
	_crew_plate_style = plate

	# Cleared, never appended to: `_ready()` genuinely runs twice under the
	# headless `--script` harness (the same guard `_build_stock_panel` has).
	_crew_row_nodes.clear()

	_crew_panel = PanelContainer.new()
	_crew_panel.name = "CrewPanel"
	_crew_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crew_panel.add_theme_stylebox_override("panel", plate)
	_crew_panel.custom_minimum_size.x = STOCK_PANEL_MIN_WIDTH
	hud.add_child(_crew_panel)

	var body := VBoxContainer.new()
	body.name = "CrewBody"
	body.mouse_filter = Control.MOUSE_FILTER_IGNORE
	body.add_theme_constant_override("separation", _ui_i(6))
	_crew_panel.add_child(body)

	var heading_settings := LabelSettings.new()
	heading_settings.font_size = _ui_font(-1)
	heading_settings.font_color = CREW_PANEL_ACCENT
	heading_settings.outline_size = base_settings.outline_size
	heading_settings.outline_color = base_settings.outline_color

	# Heading and the key that opens the controls share one line, the same
	# economy STOCK's head row makes: this column's scarce axis is height.
	var head_row := HBoxContainer.new()
	head_row.name = "CrewHeadRow"
	head_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	head_row.add_theme_constant_override("separation", _ui_i(12))
	body.add_child(head_row)

	var heading := Label.new()
	heading.name = "CrewHeading"
	heading.mouse_filter = Control.MOUSE_FILTER_IGNORE
	heading.label_settings = heading_settings
	heading.text = "CREW"
	heading.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	head_row.add_child(heading)

	var hint_settings := LabelSettings.new()
	hint_settings.font_size = _ui_font(-2)
	hint_settings.font_color = Color(0.66, 0.68, 0.72)
	hint_settings.outline_size = base_settings.outline_size
	hint_settings.outline_color = base_settings.outline_color

	# Two settings objects, swapped between, never one recoloured in place:
	# the calm hint and the alarm are different inks and this Label is the
	# one node both are drawn on (`_update_staff_alert`).
	_crew_hint_calm = hint_settings
	_crew_hint_warn = _staff_warn_settings()

	_crew_hint = Label.new()
	_crew_hint.name = "CrewHint"
	_crew_hint.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crew_hint.label_settings = _crew_hint_calm
	_crew_hint.text = "H: hire"
	_crew_hint.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	head_row.add_child(_crew_hint)

	_crew_rows = VBoxContainer.new()
	_crew_rows.name = "CrewRows"
	_crew_rows.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crew_rows.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_crew_rows.add_theme_constant_override("separation", _ui_i(5))
	body.add_child(_crew_rows)

	for category in _staff_snapshot.get("categories", []):
		_build_crew_row(base_settings, category)

	# The payday line, and the affordability verdict under it. Two labels,
	# not one: the cost is always true and the warning is conditional, and
	# folding them together would mean rebuilding the whole sentence to add
	# or drop a warning.
	_crew_payday_label = Label.new()
	_crew_payday_label.name = "CrewPayday"
	_crew_payday_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crew_payday_label.label_settings = hint_settings
	body.add_child(_crew_payday_label)

	_crew_afford_label = Label.new()
	_crew_afford_label.name = "CrewAfford"
	_crew_afford_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crew_afford_label.label_settings = _staff_warn_settings()
	_crew_afford_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_crew_afford_label.custom_minimum_size.x = CREW_TEXT_WIDTH
	_crew_afford_label.visible = false
	body.add_child(_crew_afford_label)

	_update_crew_panel()
	# STOCK was positioned at its own build time, when this plate did not
	# exist and so reserved nothing. Re-hang it now the floor has moved, or
	# the very first drawn frame shows the two overlapping.
	_position_stock_panel()


## One CREW row: icon, name, `hired / required`, and the ▲ HIRE chip.
##
## Two lines, not one. The top line is the numbers; the second is what the
## category is committed to, in the machines' own names ("crusher, mixer,
## cooking vat"). That second line is the playtest's "what are they assigned
## to" and it is drawn from the establishment, so it holds still — naming
## what is RUNNING this instant would flicker exactly the way the old
## headline number did.
func _build_crew_row(base_settings: LabelSettings, category: Dictionary) -> void:
	var id := String(category.get("id", ""))
	if id == "":
		return

	var wrap := VBoxContainer.new()
	wrap.name = "CrewRow_%s" % id
	wrap.mouse_filter = Control.MOUSE_FILTER_IGNORE
	wrap.add_theme_constant_override("separation", _ui_i(1))
	_crew_rows.add_child(wrap)

	var row := HBoxContainer.new()
	row.name = "CrewTop_%s" % id
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_theme_constant_override("separation", _ui_i(8))
	wrap.add_child(row)

	var icon := TextureRect.new()
	icon.name = "CrewIcon_%s" % id
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = CREW_ICON_SIZE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for_asset("%s%s" % [STAFF_ICON_PREFIX, id])
	row.add_child(icon)

	# EVERY LABEL GETS ITS OWN `LabelSettings` — a Resource assigned to two
	# Labels is one object with two references, and recolouring per row would
	# then repaint every row (the bug `_build_stock_row` documents).
	var name_settings := LabelSettings.new()
	name_settings.font_size = _ui_font(-1)
	name_settings.font_color = Color(0.92, 0.93, 0.94)
	name_settings.outline_size = base_settings.outline_size
	name_settings.outline_color = base_settings.outline_color

	var name_label := Label.new()
	name_label.name = "CrewName_%s" % id
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = name_settings
	name_label.text = String(category.get("name", id))
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	name_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	row.add_child(name_label)

	var count_settings := LabelSettings.new()
	count_settings.font_size = _ui_font(-1)
	count_settings.font_color = STOCK_COUNT_COLOR
	count_settings.outline_size = base_settings.outline_size
	count_settings.outline_color = base_settings.outline_color

	var count_label := Label.new()
	count_label.name = "CrewCount_%s" % id
	count_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	count_label.label_settings = count_settings
	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	count_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	row.add_child(count_label)

	var chip_label := Label.new()
	chip_label.name = "CrewChip_%s" % id
	chip_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	chip_label.label_settings = _staff_warn_settings()
	chip_label.visible = false
	row.add_child(chip_label)

	var assigned_settings := LabelSettings.new()
	assigned_settings.font_size = _ui_font(-2)
	assigned_settings.font_color = Color(0.66, 0.68, 0.72)
	assigned_settings.outline_size = base_settings.outline_size
	assigned_settings.outline_color = base_settings.outline_color

	var assigned_label := Label.new()
	assigned_label.name = "CrewAssigned_%s" % id
	assigned_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	assigned_label.label_settings = assigned_settings
	# ONE line, trimmed with an ellipsis — never wrapped. A wrapping line
	# makes the row's height depend on how many machines happen to be placed
	# and how long their names are, so a big factory would silently push the
	# plate past its cap and cost every row its detail (`_crew_fit_detail`).
	# A fixed row height also lets the eye run down the numbers column, which
	# is the reason this plate is a column of rows and not a paragraph. The
	# full list is in the H panel; this is the glance.
	assigned_label.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	assigned_label.custom_minimum_size.x = CREW_TEXT_WIDTH
	wrap.add_child(assigned_label)

	_crew_row_nodes[id] = {
		"wrap": wrap,
		"count_label": count_label,
		"chip_label": chip_label,
		"assigned_label": assigned_label,
	}


## One row: icon, display name, count. The count is right-aligned against the
## plate's edge so the three numbers form a column the eye can run down —
## the thing the strip of chips could not do.
##
## EVERY COUNT LABEL GETS ITS OWN `LabelSettings`. The strip shared one
## instance across all three chips and then recoloured it per chip in
## `_update_larder`, so all three took whichever colour the last ingredient
## wrote — an out-of-stock vinegar dimmed the tomato count beside it. A
## `LabelSettings` is a Resource: assigning it to three Labels is one object
## with three references, not three copies.
func _build_stock_row(base_settings: LabelSettings, item_id: String) -> void:
	if item_id == "":
		return
	var row := HBoxContainer.new()
	row.name = "StockRow_%s" % item_id
	row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	row.add_theme_constant_override("separation", _ui_i(9))
	_stock_rows.add_child(row)
	_stock_row_nodes[item_id] = row

	var icon := TextureRect.new()
	icon.name = "StockIcon_%s" % item_id
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = STOCK_ICON_SIZE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for_asset(_market_asset_for(item_id))
	row.add_child(icon)

	var name_settings := LabelSettings.new()
	name_settings.font_size = _ui_font(-1)
	name_settings.font_color = Color(0.92, 0.93, 0.94)
	name_settings.outline_size = base_settings.outline_size
	name_settings.outline_color = base_settings.outline_color

	var name_label := Label.new()
	name_label.name = "StockName_%s" % item_id
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = name_settings
	# The DISPLAY name, never the wire id (UI_UX.md §5e): "Tomato", not
	# `tomato`, and "Vinegar" for a fluid bought by the jug.
	name_label.text = _item_display_name(item_id)
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	name_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	row.add_child(name_label)

	var count_settings := LabelSettings.new()
	count_settings.font_size = _ui_font(-1)
	count_settings.font_color = STOCK_COUNT_COLOR
	count_settings.outline_size = base_settings.outline_size
	count_settings.outline_color = base_settings.outline_color

	var count := Label.new()
	count.name = "Stock_%s" % item_id
	count.mouse_filter = Control.MOUSE_FILTER_IGNORE
	count.label_settings = count_settings
	count.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	count.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	row.add_child(count)
	_larder_entries[item_id] = count


## Right edge, hard against the top of the hotbar's reserved band and clear
## of the window's edge by `STOCK_PANEL_MARGIN`.
##
## ANCHORED FROM THE BOTTOM, not hung under the clipboard. The clipboard's
## own height is a function of how many contracts are running and how far
## its docket stack has been allowed to grow, so a plate placed under it
## would move up and down the screen as orders were signed and lost. Fixing
## it above the hotbar instead gives the one permanently-visible readout a
## permanent home, and it is the CLIPBOARD that is capped against what is
## left (`_stock_reserved_height`, read by `_update_contract_panel`) — the
## docket stack already scrolls by design, so it is the right one to yield.
##
## The clipboard cannot yield indefinitely, though: `_fit_grid_scroll` floors
## its docket stack, and at 1280x720 that floor plus the clipboard's own
## heading, money, wage and footer lines is already more than half the
## column. So this plate reads the clipboard's ACTUAL bottom edge and takes
## what is left, scrolling its own list if that is less than the whole of it.
## The two caps do not chase each other: the clipboard's is against this
## plate's height, which stops shrinking the moment the clipboard stops
## growing, and at both reviewed resolutions it settles on the first frame.
func _position_stock_panel() -> void:
	if _stock_panel == null:
		return
	var vp := get_viewport()
	if vp == null:
		return
	var bounds := vp.get_visible_rect().size
	if bounds.x <= 0.0 or bounds.y <= 0.0:
		return
	# The band this plate may occupy: from under the clipboard (whatever
	# height it has settled at this frame) down to the top of the hotbar,
	# a margin clear of each.
	#
	# The hotbar PLATE's own top edge, not `_hotbar_reserved_height()`, which
	# also reserves the strip above the plate that the item-name flyout pops
	# into. That flyout is centred over the hotbar and this plate is hard
	# against the right edge, so the two cannot meet, and at 1280x720 the
	# difference is a whole row of stock. `_hotbar_reserved_height()` is
	# still the fallback for a hotbar that has not laid out yet (a headless
	# run never leaves that state).
	var floor_y: float = bounds.y - _hotbar_reserved_height() - STOCK_PANEL_MARGIN
	if _hotbar_panel != null and _hotbar_panel.size.y > 0.0:
		floor_y = _hotbar_panel.get_global_rect().position.y - STOCK_PANEL_MARGIN
	# The CREW plate holds the bottom of this column now, so this plate's
	# floor is its top edge. Its WANTED height (`_crew_reserved_height`), not
	# the height it has settled at: reserving a settled height is what made
	# the clipboard and this plate chase each other in circles at 1280x720,
	# and the fix there was the same one (`_stock_wanted_height`).
	floor_y -= _crew_reserved_height()
	var ceiling: float = STOCK_PANEL_MARGIN
	if _contract_panel != null and _contract_panel.visible and _contract_panel.size.y > 0.0:
		ceiling = maxf(ceiling, _contract_panel.get_global_rect().end.y + STOCK_PANEL_MARGIN)
	var available: float = maxf(0.0, floor_y - ceiling)
	# At most a share of the column even when there is more room than that:
	# this is a readout of three to five short rows, and a plate that grew to
	# half the screen the day a sixth ingredient was priced would be a bigger
	# surprise than a scrollbar.
	available = minf(available, (
		bounds.y
		- _hotbar_reserved_height()
		- _crew_reserved_height()
		- STOCK_PANEL_MARGIN * 2.0
	) * STOCK_PANEL_HEIGHT_SHARE)

	# NOT `_fit_grid_scroll`: its floor is `_ui_px(110)`, which is taller than
	# this whole list's natural height, so it could never cap anything here —
	# it would hand back the full list and the plate would run up into the
	# clipboard at 1280x720. Same shape, one row as the floor instead, so the
	# list scrolls (UI_UX.md §5c's deliberate last resort) rather than the
	# plate colliding with the two fixed things it is wedged between.
	#
	# And the cut lands BETWEEN two rows, the same rule the clipboard's docket
	# stack follows (`_whole_rows_height`, issue #8) — a count sliced through
	# the middle of its digits is unreadable in a way a count behind a
	# scrollbar is not.
	var natural: float = _stock_rows.get_combined_minimum_size().y
	_stock_scroll.custom_minimum_size.y = natural
	var chrome: float = _stock_panel.get_combined_minimum_size().y - natural
	var cap: float = _whole_rows_height(_stock_rows, maxf(_stock_row_height(), available - chrome))
	_stock_scroll.custom_minimum_size.y = minf(natural, cap)

	var size := _stock_panel.get_combined_minimum_size()
	_stock_panel.size = size
	# Hung from its floor, but never above the ceiling. The cap above keeps
	# the plate inside the band in every case it CAN — this clamp is for the
	# case it cannot, where chrome plus one row is taller than the band
	# itself. Without it the plate simply kept growing upwards and landed on
	# the clipboard (caught by test_hud_plates.gd at 1600x900 the day the
	# CREW plate raised this floor). Overflowing DOWNWARD, towards the
	# hotbar, is the lesser fault of the two: the hotbar is a fixed strip the
	# player already knows the shape of, whereas the clipboard is text.
	_stock_panel.position = Vector2(
		maxf(0.0, bounds.x - size.x - STOCK_PANEL_MARGIN),
		maxf(0.0, maxf(ceiling, floor_y - size.y))
	)


## One row's worth of height, the floor the list is never capped below: a
## plate showing nothing at all would be worse than a plate showing one row
## and a scrollbar. Measured off a real row rather than assumed, so it stays
## right if the icon size or the row font moves.
func _stock_row_height() -> float:
	if _stock_rows == null or _stock_rows.get_child_count() == 0:
		return STOCK_ICON_SIZE.y
	var row := _stock_rows.get_child(0) as Control
	return STOCK_ICON_SIZE.y if row == null else row.get_combined_minimum_size().y


## How much of the right-hand column the stock plate owns, margins included —
## `_hotbar_reserved_height()`'s twin, and asked for the same reason: the
## clipboard above must not be allowed to grow down across it.
##
## It reports the height the plate WANTS — its whole list, bounded by
## `STOCK_PANEL_HEIGHT_SHARE` — not the height it happens to have settled at.
## Reporting the settled height made the two caps chase each other the wrong
## way at 1280x720 (found by rendering the merged HUD): the plate is capped
## against what the clipboard leaves, so a frame where it had shrunk to one
## row reserved one row's worth, which let the clipboard grow, which left one
## row again. The stable point was a single ingredient on a plate whose whole
## job is showing every ingredient. Reserving the list's full height instead
## settles the other way round — the docket stack scrolls by design (UI_UX.md
## §5c's last resort), and this readout does not.
##
## Falls back to the plate's minimum size before it has laid itself out,
## which is the state a headless run never leaves.
func _stock_reserved_height() -> float:
	if _stock_panel == null or not _stock_panel.visible:
		return 0.0
	var height: float = _stock_wanted_height()
	if height <= 0.0:
		height = _stock_panel.get_combined_minimum_size().y
	return height + STOCK_PANEL_MARGIN * 2.0


## The lowest `y` anything hung above this plate may reach: where its top
## edge would be if it had shrunk to its floor of chrome plus one row.
## `_stock_reserved_height`'s twin at the other end — that one is what the
## plate WANTS and the clipboard is capped against, this is what it will take
## regardless, and so the line the clipboard may never grow across
## (`_update_contract_panel`). A plate drawn ON the clipboard is a worse
## fault than either of the two things the caps are there to avoid.
##
## An absolute `y` rather than a height, because the two numbers a height
## would have to be subtracted from are both approximations of this one:
## `_update_contract_panel`'s column reserves the hotbar's flyout strip that
## this plate is too far right to meet, and the margin between the two panels
## is one gap, not each of their margins. Measuring the same `floor_y` this
## plate is positioned against costs a second reading of the hotbar and gets
## the real answer — at 1280x720 the approximations were a whole docket out.
##
## `INF` when there is no plate to collide with: no plate, no limit.
func _stock_ceiling_y() -> float:
	if _stock_panel == null or not _stock_panel.visible:
		return INF
	var vp := get_viewport()
	if vp == null or vp.get_visible_rect().size.y <= 0.0:
		return INF
	var floor_y: float = vp.get_visible_rect().size.y - _hotbar_reserved_height() - STOCK_PANEL_MARGIN
	if _hotbar_panel != null and _hotbar_panel.size.y > 0.0:
		floor_y = _hotbar_panel.get_global_rect().position.y - STOCK_PANEL_MARGIN
	# The CREW plate stands between this one and the hotbar, so it lifts the
	# hard line by its whole height. Omitting it here is what let the docket
	# stack grow down onto a stock plate that had already been pushed up.
	floor_y -= _crew_reserved_height()
	var chrome: float = _stock_panel.get_combined_minimum_size().y - _stock_scroll.custom_minimum_size.y
	return floor_y - (chrome + _stock_row_height()) - STOCK_PANEL_MARGIN


## The plate at its full list height, capped by the share of the column it is
## allowed (`_position_stock_panel`'s own cap, read from the same two
## numbers), and floored at one row plus chrome so it is never zero.
func _stock_wanted_height() -> float:
	if _stock_panel == null or _stock_rows == null or _stock_scroll == null:
		return 0.0
	var chrome: float = _stock_panel.get_combined_minimum_size().y - _stock_scroll.custom_minimum_size.y
	var natural: float = _stock_rows.get_combined_minimum_size().y
	var wanted: float = chrome + natural
	var vp := get_viewport()
	if vp != null and vp.get_visible_rect().size.y > 0.0:
		var share: float = (
			vp.get_visible_rect().size.y
			- _hotbar_reserved_height()
			- _crew_reserved_height()
			- STOCK_PANEL_MARGIN * 2.0
		) * STOCK_PANEL_HEIGHT_SHARE
		wanted = minf(wanted, maxf(chrome + _stock_row_height(), share))
	return wanted


## The stock plate's rect on screen, for the panels that must not land on it
## (UI_UX.md §2b point 33). An empty `Rect2` when there is no plate; the
## minimum-size fallback is `_stock_reserved_height`'s, for its reason.
func _stock_rect() -> Rect2:
	return _plate_rect(_stock_panel)


## The CREW plate's rect, and the clipboard's — `_stock_rect`'s siblings, so
## the three tenants of the right-hand column can be handed to
## `_pushed_clear_of` as one list (`_position_market_panel`).
func _crew_rect() -> Rect2:
	return _plate_rect(_crew_panel)


func _contract_panel_rect() -> Rect2:
	return _plate_rect(_contract_panel)


## A fixed plate's rect on screen, or an empty `Rect2` when it is not up.
## `global_position`, not `position`: a plate inside a layout container has a
## local origin that is not the screen's (the config panel's own avoidance
## makes the same call).
func _plate_rect(plate: Control) -> Rect2:
	if plate == null or not plate.visible:
		return Rect2()
	var size := plate.size
	if size.y <= 0.0:
		size = plate.get_combined_minimum_size()
	return Rect2(plate.global_position, size)


## Repolled every frame, like the hotbar it used to sit on: a stock count
## that moved because a hopper was loaded has to move here in the same frame,
## or the one number that explains why FILL did nothing is stale exactly when
## it matters. Keeps its name through the move to the right-hand plate —
## `test_chain_rework.gd` drives it directly.
## `_rebuild_market_slots`'s counterpart for the always-on larder plate.
func _rebuild_stock_rows(entries: Array) -> void:
	for row in _stock_row_nodes.values():
		if is_instance_valid(row):
			if row.get_parent() != null:
				row.get_parent().remove_child(row)
			row.queue_free()
	_larder_entries.clear()
	_stock_row_nodes.clear()
	_larder_ids.clear()
	if _stock_rows == null or _stock_base_settings == null:
		return
	for entry in entries:
		var id := String(entry.get("id", ""))
		_build_stock_row(_stock_base_settings, id)
		_larder_ids.append(id)


func _larder_rows_match(entries: Array) -> bool:
	if entries.size() != _larder_ids.size():
		return false
	for i in range(entries.size()):
		if String(entries[i].get("id", "")) != String(_larder_ids[i]):
			return false
	return true


func _update_larder() -> void:
	_update_crew_panel()
	_position_stock_panel()
	var listed: Array = _ingredients_snapshot().get("entries", [])
	if not _larder_rows_match(listed):
		_rebuild_stock_rows(listed)
	if _larder_entries.is_empty():
		return
	for entry in listed:
		var item_id := String(entry.get("id", ""))
		if not _larder_entries.has(item_id):
			continue
		var owned := int(entry.get("owned", 0))
		var label: Label = _larder_entries[item_id]
		# Out of stock is a real state with a consequence (FILL will refuse),
		# so it is called out in WORDS rather than left as a zero — colour
		# alone would not carry it (UI_UX.md §7). Dimmed rather than alarmed:
		# every ingredient is listed now, including ones a new game has
		# simply never bought, and a plate of red on a factory that is
		# running perfectly well would cry wolf.
		label.text = "%d" % owned if owned > 0 else "none"
		label.label_settings.font_color = STOCK_COUNT_COLOR if owned > 0 else STOCK_NONE_COLOR
		# The whole row recedes with its number, so the eye lands on what
		# the player actually has (position and value, not colour — §7).
		var row: Control = _stock_row_nodes.get(item_id)
		if row != null:
			row.modulate = Color(1, 1, 1, 1.0 if owned > 0 else STOCK_NONE_ROW_ALPHA)


# --------------------------------------------------------------------------
# The building configuration panel (the click-to-configure ticket)
# --------------------------------------------------------------------------

## Clicking a placed hopper or fluid tank opens this panel; everything a
## player used to do to those buildings with the keyboard is done here now.
##
## WHY IT EXISTS. Three global keybinds used to configure buildings from
## anywhere on the map: **SPACE** filled EVERY hopper in the world, **V**
## every tank, and **Q** cycled the contents of the hopper under the cursor
## (or of the ghost in hand). All three are gone. Every one of them had the
## same two faults, and they get worse the moment a factory has more than one
## of anything: the key acts on a building the player is not looking at and
## cannot name, and the building itself advertises none of it — a hopper on
## the floor gave no hint that it could be loaded, told to keep itself
## loaded, or refilled with something else. The thing you configure is the
## thing you click, which is what every builder this game borrows from does
## with a machine that has settings.
##
## WHY THE DARK PLATE AND NOT THE CLIPBOARD'S PAPER. UI_UX.md §5 draws that
## line explicitly: paper-and-clip is the diegetic motif for ORDERS and
## checklists (a contract *is* a clipboard). This is machine-side factory UI
## — the same family as the build menu, the ingredient market, the hotbar and
## the hover tooltip — so it wears their near-black plate with a
## hazard-yellow rule rather than inventing a third visual language or
## borrowing the one that means "an order".
var _config_panel: PanelContainer
## The ORIGIN tile of the building being configured (any tile of a footprint
## opens it; the origin is what is remembered, so `_placement_at_tile` can
## re-resolve it every frame). Meaningful only while `_config_open`.
var _config_tile := Vector2i.ZERO
var _config_open := false
## `HOPPER_KIND` or `FLUID_TANK_KIND` — the two kinds that have anything to
## configure. A machine's settings are its recipe, which is content; a belt
## has none at all.
var _config_kind := ""
var _config_title: Label
var _config_title_icon: TextureRect
var _config_level_label: Label
var _config_level_track: Panel
var _config_level_fill: Panel
var _config_fill_button: Button
var _config_fill_reason: Label
var _config_stock_label: Label
var _config_auto_button: Button
var _config_auto_enabled := false
var _config_picker_box: VBoxContainer
var _config_picker_row: HBoxContainer
var _config_picker_slots: Array = [] # [{item, button, mark}]
## The panel's fixed content width. Fixed rather than derived so the level
## bar has a width to scale against on the frame the panel opens, and so the
## picker row does not resize the whole panel when a third ingredient ships.
const CONFIG_PANEL_WIDTH := 260.0 * UI_SCALE
## Where the panel sits relative to the building's projected centre — up and
## to the right, so it stands BESIDE the thing it configures rather than on
## top of it. `_position_config_panel` flips and clamps from here.
const CONFIG_PANEL_OFFSET := Vector2(30.0, -40.0) * UI_SCALE
const CONFIG_LEVEL_BAR_HEIGHT := 14.0 * UI_SCALE
const CONFIG_PICKER_SLOT_SIZE := Vector2(58.0, 62.0) * UI_SCALE
const CONFIG_PICKER_ICON_SIZE := Vector2(30.0, 30.0) * UI_SCALE


func _build_config_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	# `_ready` runs twice in a headless script (once from the engine, once
	# called directly), so the slot list is cleared rather than appended to —
	# the same guard `_build_ingredient_market` and `_build_stock_panel` carry.
	_config_picker_slots.clear()

	var plate := StyleBoxFlat.new()
	plate.bg_color = Color(0.06, 0.06, 0.07, 0.96)
	plate.border_color = Color(0.85, 0.63, 0.11, 0.95)
	plate.border_width_top = _ui_i(4)
	plate.border_width_left = _ui_i(2)
	plate.border_width_right = _ui_i(2)
	plate.border_width_bottom = _ui_i(2)
	plate.set_content_margin_all(_ui_px(12.0))

	_config_panel = PanelContainer.new()
	_config_panel.name = "ConfigPanel"
	_config_panel.add_theme_stylebox_override("panel", plate)
	_config_panel.custom_minimum_size.x = CONFIG_PANEL_WIDTH
	_config_panel.visible = false
	hud.add_child(_config_panel)

	var body := VBoxContainer.new()
	body.name = "ConfigBody"
	body.add_theme_constant_override("separation", _ui_i(7))
	_config_panel.add_child(body)

	# --- Title row: what this building is, and the X that closes it --------
	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(7))
	body.add_child(heading)

	_config_title_icon = TextureRect.new()
	_config_title_icon.name = "ConfigTitleIcon"
	_config_title_icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_config_title_icon.custom_minimum_size = _ui_v(Vector2(24, 24))
