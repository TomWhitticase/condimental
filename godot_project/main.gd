	# --- The contents picker (hoppers only) --------------------------------
	_config_picker_box = VBoxContainer.new()
	_config_picker_box.name = "ConfigPicker"
	_config_picker_box.add_theme_constant_override("separation", _ui_i(4))
	_config_picker_box.visible = false
	body.add_child(_config_picker_box)

	var picker_heading := Label.new()
	picker_heading.label_settings = stock_settings
	picker_heading.text = "CONTENTS"
	_config_picker_box.add_child(picker_heading)

	_config_picker_row = HBoxContainer.new()
	_config_picker_row.name = "ConfigPickerRow"
	_config_picker_row.add_theme_constant_override("separation", _ui_i(6))
	_config_picker_box.add_child(_config_picker_row)

	var picker_note := Label.new()
	picker_note.name = "ConfigPickerNote"
	picker_note.label_settings = note_settings
	picker_note.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	picker_note.custom_minimum_size.x = CONFIG_PANEL_WIDTH
	# The simulation's own rule, said out loud rather than discovered: a
	# hopper is single-item, so there is no "half tomato, half sugar" state
	# and `SetHopperItem` empties it (see `Hopper::retarget`).
	picker_note.text = "switching empties the hopper"
	_config_picker_box.add_child(picker_note)

	var footer := Label.new()
	footer.label_settings = note_settings
	footer.text = "ESC or ✕: close    ·    click the building again to close"
	body.add_child(footer)


## One picker slot per raw ingredient the SIMULATION allows in a hopper
## (`_hopper_items`, i.e. `World::raw_items` over the wire) — so a third
## ingredient in `data/ingredients.ron` appears here with no Godot edit, the
## same property the market and the larder already have. Rebuilt on open
## rather than once, because the list is content and a load can change it.
func _rebuild_config_picker() -> void:
	if _config_picker_row == null:
		return
	for child in _config_picker_row.get_children():
		_config_picker_row.remove_child(child)
		child.queue_free()
	_config_picker_slots.clear()
	for index in range(_hopper_items.size()):
		_build_config_picker_slot(index, String(_hopper_items[index]))


func _build_config_picker_slot(index: int, item_id: String) -> void:
	var button := Button.new()
	button.name = "ConfigPickerSlot_%s" % item_id
	button.focus_mode = Control.FOCUS_NONE
	button.custom_minimum_size = CONFIG_PICKER_SLOT_SIZE
	button.pressed.connect(_on_config_picker_pressed.bind(index))
	_config_picker_row.add_child(button)

	var column := VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	column.add_theme_constant_override("separation", _ui_i(1))
	column.set_anchors_preset(Control.PRESET_FULL_RECT)
	column.offset_left = _ui_px(4)
	column.offset_right = -_ui_px(4)
	column.offset_top = _ui_px(4)
	column.offset_bottom = -_ui_px(4)
	button.add_child(column)

	var icon := TextureRect.new()
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = CONFIG_PICKER_ICON_SIZE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	column.add_child(icon)

	var name_settings := LabelSettings.new()
	name_settings.font_size = _ui_font(-3)
	name_settings.font_color = Color(0.88, 0.89, 0.92)
	name_settings.outline_size = _ui_i(4)
	name_settings.outline_color = Color(0, 0, 0, 0.85)

	var name_label := Label.new()
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = name_settings
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.text = _item_display_name(item_id)
	column.add_child(name_label)

	# The non-colour half of the selected signal (UI_UX.md §7): the frame
	# turns hazard-yellow exactly as the hotbar's selected socket does, AND a
	# tick sits in the slot's corner. Either one alone answers "which one is
	# in this hopper".
	var mark_settings := LabelSettings.new()
	mark_settings.font_size = _ui_font(-1)
	mark_settings.font_color = Color(1.0, 0.83, 0.24)
	mark_settings.outline_size = _ui_i(4)
	mark_settings.outline_color = Color(0, 0, 0, 0.9)

	var mark := Label.new()
	mark.name = "Selected"
	mark.mouse_filter = Control.MOUSE_FILTER_IGNORE
	mark.label_settings = mark_settings
	mark.text = "✔"
	mark.position = _ui_v(Vector2(4, 1))
	mark.visible = false
	button.add_child(mark)

	_config_picker_slots.append({"item": item_id, "button": button, "mark": mark})


## Opens the panel for the building whose footprint ORIGIN is `origin`.
func _open_config_panel(origin: Vector2i, kind: String) -> void:
	if _config_panel == null:
		return
	_config_tile = origin
	_config_kind = kind
	_config_open = true
	_config_picker_box.visible = kind == HOPPER_KIND
	if kind == HOPPER_KIND:
		_refresh_hopper_items()
		_rebuild_config_picker()
	# The panel is driven from the polled snapshots, so make sure they are
	# current before the first frame it is drawn on rather than a frame late.
	_refresh_buffers()
	_update_config_panel()
	# In first-person the mouse is captured and there is nothing to click a
	# button with, so it is handed back exactly as either shop panel does.
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
	_update_crosshair_visibility()


func _close_config_panel() -> void:
	if not _config_open:
		return
	_config_open = false
	_config_kind = ""
	if _config_panel != null:
		_config_panel.visible = false
	if _view_mode == ViewMode.FIRST_PERSON and not _shop_open and not _market_open:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


## The screen point a configuration click asks about. In ISOMETRIC that is
## always the cursor; in FIRST_PERSON it is the crosshair at screen centre —
## EXCEPT while this panel is open, when the mouse has been handed back and
## is a real position again.
func _config_query_pos() -> Vector2:
	var vp := get_viewport()
	if vp == null:
		return Vector2.ZERO
	if _view_mode == ViewMode.FIRST_PERSON and not _config_open:
		return vp.get_visible_rect().size / 2.0
	return vp.get_mouse_position()


## The left click OUTSIDE build mode — the click that did nothing at all
## before this ticket. Reads the live cursor and hands to
## `_config_click_at_tile`, which is the pure half a test drives.
func _config_click() -> void:
	_config_click_at_tile(_tile_under_screen_pos(_config_query_pos()))


## What a configuration click on `tile` does. Four cases, and three of them
## close: the same building again closes (a click is a toggle, which is what
## makes the panel dismissable with the gesture that opened it), a different
## hopper or tank opens that one instead (only ever one panel), and empty
## floor or any other kind closes outright rather than leaving a panel
## describing something the player has stopped looking at.
func _config_click_at_tile(tile: Vector2i) -> void:
	if tile == HOVER_NO_TILE:
		_close_config_panel()
		return
	var placement := _placement_at_tile(tile)
	var kind := String(placement.get("kind", ""))
	if kind != HOPPER_KIND and kind != FLUID_TANK_KIND:
		_close_config_panel()
		return
	var origin := _placement_origin(placement)
	if _config_open and _config_tile == origin:
		_close_config_panel()
		return
	_open_config_panel(origin, kind)


## Repolled every frame while the panel is up, exactly like the build menu
## and the larder: a level that moved because the factory consumed a tomato
## has to move here in the same frame, and `auto_fill` is read back from the
## SNAPSHOT rather than remembered locally, so the toggle can never claim a
## state the simulation does not have.
##
## It is also where the panel closes itself for reasons that are not clicks:
## the building was removed (X mode), it stopped being the kind it was, or a
## modal panel opened over it. Checking the placement every frame means no
## caller has to remember to close it.
func _update_config_panel() -> void:
	if not _config_open or _config_panel == null:
		return
	if _shop_open or _market_open or _in_build_mode():
		_close_config_panel()
		return
	var placement := _placement_at_tile(_config_tile)
	if placement.is_empty() or String(placement.get("kind", "")) != _config_kind:
		_close_config_panel()
		return
	var key := _tile_key(_placement_origin(placement))
	if _config_kind == HOPPER_KIND:
		_update_config_hopper(key)
	else:
		_update_config_tank(key)
	_position_config_panel()
	_config_panel.visible = true


func _update_config_hopper(key: String) -> void:
	var snapshot: Dictionary = _hopper_states.get(key, {})
	var item := String(snapshot.get("item", ""))
	_config_title.text = "Hopper — %s" % _item_display_name(item)
	_config_title_icon.texture = _icon_for(item)
	_config_level_label.text = "%d / %d units" % [
		int(snapshot.get("quantity", 0)), int(snapshot.get("capacity", 0)),
	]
	_set_config_level(float(snapshot.get("fill", 0.0)))
	_config_stock_label.text = "in stock: %d" % int(_owned_ingredient_counts().get(item, 0))
	_apply_config_fill_state(_config_hopper_fill_blocker(snapshot))
	_apply_config_auto_state(bool(snapshot.get("auto_fill", false)))
	_update_config_picker(item)


func _update_config_tank(key: String) -> void:
	var snapshot: Dictionary = _fluid_tank_states.get(key, {})
	var fluid := _fluid_id_of(snapshot)
	_config_title.text = "Fluid Tank — %s" % (
		_item_display_name(fluid) if fluid != "" else "unconnected"
	)
	_config_title_icon.texture = _icon_for_asset(
		_market_asset_for(fluid) if fluid != "" else FLUID_TANK_ASSET
	)
	_config_level_label.text = "%.1f / %.0f units" % [
		float(snapshot.get("quantity", 0.0)), float(snapshot.get("capacity", 0.0)),
	]
	_set_config_level(float(snapshot.get("fill", 0.0)))
	_config_stock_label.text = (
		"in stock: %d" % int(_owned_ingredient_counts().get(fluid, 0)) if fluid != "" else ""
	)
	_apply_config_fill_state(_config_tank_fill_blocker(snapshot))
	_apply_config_auto_state(bool(snapshot.get("auto_fill", false)))


## Why FILL on a hopper's panel is off, or "" if it is not. The per-building
## descendant of the old global `_hopper_fill_blocker` that **SPACE** used —
## and strictly better than it was, because a panel is about ONE bin and can
## therefore name the one ingredient that is missing rather than every
## ingredient any hopper anywhere wants.
##
## Pure given the polled snapshot and the ingredient ledger, so a test drives
## it directly.
func _config_hopper_fill_blocker(snapshot: Dictionary) -> String:
	if snapshot.is_empty():
		return "This hopper is not reporting a level yet"
	if int(snapshot.get("quantity", 0)) >= int(snapshot.get("capacity", 0)):
		return "Full — nothing more will fit"
	var item := String(snapshot.get("item", ""))
	if int(_owned_ingredient_counts().get(item, 0)) <= 0:
		return "No %s in stock — buy some at the Ingredient Market (M)" % _item_display_name(item)
	return ""


## `_config_hopper_fill_blocker`'s fluid twin, with the one refusal a hopper
## cannot have: a tank holds no fluid id of its own, so a tank plumbed to
## nothing has nothing to be charged FOR and cannot be filled at all (see
## `PlayerCommand::FillFluidTank`). The old **V** message deliberately did
## not try to diagnose that case — from a panel about one tank it is the
## first thing worth saying.
func _config_tank_fill_blocker(snapshot: Dictionary) -> String:
	if snapshot.is_empty():
		return "This tank is not reporting a level yet"
	var fluid := _fluid_id_of(snapshot)
	if fluid == "":
		return "Not connected to a pipe run"
	if float(snapshot.get("quantity", 0.0)) >= float(snapshot.get("capacity", 0.0)):
		return "Full — nothing more will fit"
	if int(_owned_ingredient_counts().get(fluid, 0)) <= 0:
		return "No %s in stock — buy some at the Ingredient Market (M)" % _item_display_name(fluid)
	return ""


func _apply_config_fill_state(blocker: String) -> void:
	if _config_fill_button == null:
		return
	_config_fill_button.disabled = blocker != ""
	_config_fill_reason.text = blocker
	_config_fill_reason.visible = blocker != ""


## The toggle reads ON or OFF **in a word** as well as in its colour — the
## whole point of UI_UX.md §7's rule, and the reason this is a labelled
## switch rather than a coloured lamp.
func _apply_config_auto_state(enabled: bool) -> void:
	if _config_auto_button == null:
		return
	_config_auto_enabled = enabled
	_config_auto_button.text = "AUTO-FILL:  ON" if enabled else "AUTO-FILL:  OFF"
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		_config_auto_button.add_theme_stylebox_override(
			state, _config_toggle_style(state, enabled)
		)


## The switch's plate. Lit green when on, recessed steel when off — the same
## near-black/hazard palette the rest of the HUD uses, with green reserved
## for "this is running", exactly as the ghost's green means "this click
## builds".
func _config_toggle_style(state: String, enabled: bool) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.set_border_width_all(_ui_i(3))
	style.set_corner_radius_all(_ui_i(2))
	if enabled:
		style.bg_color = Color(0.11, 0.26, 0.14, 0.98)
		style.border_color = Color(0.42, 0.86, 0.50, 0.98)
	else:
		style.bg_color = Color(0.11, 0.11, 0.13, 0.96)
		style.border_color = Color(0.42, 0.44, 0.48, 0.95)
	if state == "hover" or state == "pressed" or state == "focus":
		style.bg_color = style.bg_color.lightened(0.10)
	return style


func _update_config_picker(current: String) -> void:
	for slot in _config_picker_slots:
		var selected: bool = String(slot["item"]) == current
		slot["mark"].visible = selected
		var button: Button = slot["button"]
		# Literally the hotbar's own selected/stocked socket styles, so "the
		# thing I have chosen" looks the same wherever the game asks.
		for state in ["normal", "hover", "pressed", "disabled", "focus"]:
			button.add_theme_stylebox_override(
				state, _hotbar_slot_style("selected" if selected else "stocked")
			)


func _set_config_level(fraction: float) -> void:
	if _config_level_track == null or _config_level_fill == null:
		return
	var width: float = _config_level_track.size.x
	if width <= 0.0:
		width = _config_level_track.custom_minimum_size.x
	var height: float = _config_level_track.size.y
	if height <= 0.0:
		height = _config_level_track.custom_minimum_size.y
	_config_level_fill.position = Vector2.ZERO
	_config_level_fill.size = Vector2(width * clampf(fraction, 0.0, 1.0), height)
	_config_level_fill.visible = fraction > 0.0


## Beside the building, never on it, and never under the hotbar. The anchor
## is the footprint's own centre projected to the screen — the inverse of the
## ray/plane pick that resolved the click — so the panel follows the camera
## as it pans and zooms rather than sitting at a fixed screen position that
## would stop being about anything.
func _position_config_panel() -> void:
	if _config_panel == null or _camera == null:
		return
	var vp := get_viewport()
	var bounds := vp.get_visible_rect().size if vp != null else Vector2(1600, 900)
	var size := _config_panel.get_combined_minimum_size()
	var anchor := bounds * 0.5
	var placement := _placement_at_tile(_config_tile)
	if not placement.is_empty():
		var direction := _placement_direction(placement)
		var footprint := _rotated_footprint(
			_footprint_size(placement.get("footprint")), direction
		)
		anchor = _camera.unproject_position(
			_footprint_centre(_placement_origin(placement), footprint, BELT_SURFACE_Y)
		)
	var pos := anchor + CONFIG_PANEL_OFFSET
	# The contract clipboard owns the top-right corner, and a panel drawn
	# over it hides the one readout that says whether the factory is paying
	# — so the clipboard's left edge is the right-hand bound wherever the
	# two would overlap vertically, not only the window's edge. Past either
	# bound the panel flips to the building's other side.
	var right_bound := bounds.x
	if _contract_panel != null and _contract_panel.visible:
		var clip := _contract_panel.get_global_rect()
		if pos.y < clip.end.y and pos.y + size.y > clip.position.y:
			right_bound = minf(right_bound, clip.position.x)
	if pos.x + size.x > right_bound:
		pos.x = anchor.x - CONFIG_PANEL_OFFSET.x - size.x
	pos.x = clampf(pos.x, 8.0, maxf(8.0, bounds.x - size.x - 8.0))
	pos.y = clampf(pos.y, 8.0, maxf(8.0, bounds.y - _hotbar_reserved_height() - size.y))
	_config_panel.position = pos
	_config_panel.size = size


## FILL: one deliberate load of this ONE building, which is what the two
## global keys used to do to every building at once.
##
## `amount` is deliberately NOT sent. Omitting it takes the simulation's own
## default (`HOPPER_FILL_AMOUNT` / `FLUID_TANK_FILL_AMOUNT` — a quarter of
## the respective capacity, so a full bin is four deliberate actions), and a
## number typed here instead would be a second copy of a constant that lives
## next to the capacity it is derived from and would silently drift from it.
func _on_config_fill_pressed() -> void:
	if not _config_open:
		return
	_issue_config_command({
		"type": "fill_hopper" if _config_kind == HOPPER_KIND else "fill_fluid_tank",
		"tile": [_config_tile.x, _config_tile.y],
	})


func _on_config_auto_pressed() -> void:
	if not _config_open:
		return
	_issue_config_command({
		"type": "set_hopper_auto_fill" if _config_kind == HOPPER_KIND else "set_tank_auto_fill",
		"tile": [_config_tile.x, _config_tile.y],
		"enabled": not _config_auto_enabled,
	})


## The item picker. `set_hopper_item` names the ingredient outright — the
## command that replaced `cycle_hopper_item` and the **Q** key with it: a
## picker that already shows the choices should not have to press "next"
## until it arrives at one.
func _on_config_picker_pressed(index: int) -> void:
	if not _config_open or _config_kind != HOPPER_KIND:
		return
	if index < 0 or index >= _config_picker_slots.size():
		return
	_issue_config_command({
		"type": "set_hopper_item",
		"tile": [_config_tile.x, _config_tile.y],
		"item": String(_config_picker_slots[index]["item"]),
	})


## Issues one of the panel's four commands and redraws what they touch.
## Deliberately NOT `_issue_world_command`: none of these places, removes or
## rotates anything, so the whole world subtree does not need rebuilding —
## only the polled buffers the panel and the buildings themselves draw from.
func _issue_config_command(command: Dictionary) -> void:
	sim.issue_command_json(JSON.stringify(command))
	_apply_dirty_chunks()
	_refresh_buffers()
	_update_config_panel()


# --------------------------------------------------------------------------
# The hotbar (UI_UX.md §5, the inventory-hotbar ticket)
# --------------------------------------------------------------------------

## Builds the always-visible quick-select strip. See `_hotbar_panel`'s doc
## for the three layout decisions; this is where they are made concrete.
##
## VISUAL LANGUAGE. The scene's DARK PLATE with a hazard-yellow rule — the
## same one the HUD strip, the hover tooltip and the build menu already use,
## and deliberately not the contract clipboard's paper. UI_UX.md §5 draws
## that line explicitly (paper is for orders and checklists); a hotbar is
## machine-side factory UI, and this is the third widget in that family
## rather than a third visual language.
##
## WHAT WAS TAKEN FROM WHERE, since the point was to bring in the patterns
## players actually praise rather than to draw a grid:
##
##   * **Minecraft** — fixed slots with a selector that is *bigger than the
##     slot*, so "what is in my hand" is answerable from peripheral vision;
##     a stack count in the corner; and the item name flying out above the
##     bar on every switch, then fading. All three are here.
##   * **Terraria** — hover gives an item a framed spec sheet, not a bare
##     name. `_hotbar_tooltip` is that, in this game's plate styling, and it
##     is where the price and the two verbs live.
##   * **Factorio's quickbar** — a slot you have none of stays exactly where
##     it was, visible and dimmed, rather than vanishing or renumbering the
##     bar. That is what makes the keys muscle memory.
func _build_hotbar(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	_hotbar_styles = {
		"empty": _hotbar_slot_style("empty"),
		"stocked": _hotbar_slot_style("stocked"),
		"selected": _hotbar_slot_style("selected"),
	}

	_hotbar_root = VBoxContainer.new()
	_hotbar_root.name = "HotbarRoot"
	# IGNORE, not STOP: the strip is a wide band across the bottom of the
	# screen, and a plate that swallowed clicks would make the floor tiles
	# behind it unbuildable. Only the slot buttons themselves take the mouse.
	_hotbar_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_root.alignment = BoxContainer.ALIGNMENT_CENTER
	_hotbar_root.add_theme_constant_override("separation", _ui_i(6))
	hud.add_child(_hotbar_root)

	# The larder sits at the TOP of the strip's column, above the name
	# flyout: the flyout has to stay directly over the slots it names, and
	# the larder is a standing readout rather than something that appears.
	_build_larder(_hotbar_root, base_settings)

	var flyout_settings := LabelSettings.new()
	flyout_settings.font_size = _ui_font(3)
	flyout_settings.font_color = Color(0.98, 0.85, 0.42) # the plate's hazard accent
	flyout_settings.outline_size = _ui_i(4 + 2)
	flyout_settings.outline_color = Color(0, 0, 0, 0.9)

	_hotbar_flyout = Label.new()
	_hotbar_flyout.name = "HotbarFlyout"
	_hotbar_flyout.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_flyout.label_settings = flyout_settings
	_hotbar_flyout.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_hotbar_flyout.modulate = Color(1, 1, 1, 0)
	_hotbar_root.add_child(_hotbar_flyout)

	# Nearly opaque, like the build menu's own plate rather than the help
	# strip's lighter one: at 0.80 the floor's diamond tiling showed through
	# the gaps between sockets and turned the strip into visual noise, which
	# a rendered frame made obvious and the code never would.
	var plate := StyleBoxFlat.new()
	plate.bg_color = Color(0.06, 0.06, 0.07, 0.93)
	plate.border_color = Color(0.85, 0.63, 0.11, 0.95)
	plate.border_width_top = _ui_i(3)
	plate.set_content_margin_all(_ui_px(10.0))

	_hotbar_panel = PanelContainer.new()
	_hotbar_panel.name = "Hotbar"
	_hotbar_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_panel.add_theme_stylebox_override("panel", plate)
	_hotbar_root.add_child(_hotbar_panel)

	var strip := HBoxContainer.new()
	strip.name = "HotbarSlots"
	strip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Wide enough that a selected slot at HOTBAR_SELECTED_SCALE never laps
	# its neighbours: 64 * 0.13 is ~8px of growth, ~4 to each side.
	strip.add_theme_constant_override("separation", _ui_i(9) * HOTBAR_STRIP_FIT)
	_hotbar_panel.add_child(strip)

	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", []) if snapshot is Dictionary else []
	for index in range(entries.size()):
		_build_hotbar_slot(strip, base_settings, index, String(entries[index]["kind"]))

	_build_hotbar_tooltip(hud, base_settings)
	_position_hotbar()
	_update_hotbar()


## One socket. A Button, like a build-menu slot, so pressing it is the whole
## interaction; its label children ignore the mouse so the whole square stays
## one target.
func _build_hotbar_slot(strip: HBoxContainer, base_settings: LabelSettings, index: int, kind: String) -> void:
	var button := Button.new()
	button.name = "HotbarSlot_%s" % kind
	button.custom_minimum_size = HOTBAR_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	# The pop scales about the slot's own centre; without this it would grow
	# from the top-left corner and shove itself off the strip.
	button.pivot_offset = HOTBAR_SLOT_SIZE / 2.0
	button.pressed.connect(_on_hotbar_slot_pressed.bind(index))
	button.mouse_entered.connect(_on_hotbar_slot_hovered.bind(index))
	button.mouse_exited.connect(_on_hotbar_slot_unhovered.bind(index))
	strip.add_child(button)

	# Anchored over the button rather than parented through a container, for
	# the reason `_build_shop_slot` gives: a Button is not a container.
	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.set_anchors_preset(Control.PRESET_FULL_RECT)
	icon.offset_left = HOTBAR_ICON_INSET
	icon.offset_right = -HOTBAR_ICON_INSET
	icon.offset_top = HOTBAR_ICON_INSET
	icon.offset_bottom = -HOTBAR_ICON_INSET
	icon.texture = _icon_for_asset(_shop_asset_for(kind))
	button.add_child(icon)

	# The key digit, top-left. Printed on the slot rather than left to the
	# legend: the whole claim of a hotbar is that the key is obvious.
	var key_settings := LabelSettings.new()
	key_settings.font_size = _ui_font(-4)
	key_settings.font_color = Color(0.62, 0.64, 0.68)
	key_settings.outline_size = base_settings.outline_size
	key_settings.outline_color = base_settings.outline_color

	var key_label := Label.new()
	key_label.name = "Key"
	key_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	key_label.label_settings = key_settings
	key_label.text = _hotbar_key_label(index)
	key_label.position = _ui_v(Vector2(5, 1))
	button.add_child(key_label)

	# The stack count, bottom-right, in Minecraft's own corner. Hazard-yellow
	# with a heavy outline so it reads over any icon behind it.
	var count_settings := LabelSettings.new()
	count_settings.font_size = _ui_font(-1)
	count_settings.font_color = Color(0.98, 0.85, 0.42)
	count_settings.outline_size = _ui_i(4 + 1)
	count_settings.outline_color = Color(0, 0, 0, 0.92)

	var count_label := Label.new()
	count_label.name = "Count"
	count_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	count_label.label_settings = count_settings
	count_label.set_anchors_preset(Control.PRESET_FULL_RECT)
	count_label.offset_right = -_ui_px(5)
	count_label.offset_bottom = -_ui_px(2)
	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	count_label.vertical_alignment = VERTICAL_ALIGNMENT_BOTTOM
	button.add_child(count_label)

	# The selection caret, top-centre. UI_UX.md §7: the selected state is
	# never colour alone — it is a bigger slot, a hazard-yellow frame, a
	# brightened key digit AND this glyph.
	var mark_settings := LabelSettings.new()
	mark_settings.font_size = _ui_font(-3)
	mark_settings.font_color = Color(1.0, 0.90, 0.50)
	mark_settings.outline_size = base_settings.outline_size
	mark_settings.outline_color = base_settings.outline_color

	var mark := Label.new()
	mark.name = "SelectMark"
	mark.mouse_filter = Control.MOUSE_FILTER_IGNORE
	mark.label_settings = mark_settings
	mark.text = "\u25bc"
	mark.visible = false
	mark.set_anchors_preset(Control.PRESET_FULL_RECT)
	mark.offset_top = -_ui_px(1)
	mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	mark.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	button.add_child(mark)

	_hotbar_slots.append({
		"kind": kind,
		"button": button,
		"icon": icon,
		"key_label": key_label,
		"count_label": count_label,
		"mark": mark,
		"state": "",
	})


## Chunky flat sockets (UI_UX.md §5's Minecraft adjacency) in the same
## near-black/hazard-yellow pair the rest of the HUD uses.
##
##   * `empty`    — recessed and dim: the player is carrying none of this.
##   * `stocked`  — a normal socket with something in it.
##   * `selected` — the hazard-yellow frame, thicker and brighter than any
##                  other border in the HUD, because this is the one piece of
##                  state the player checks most often.
func _hotbar_slot_style(state: String) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.set_border_width_all(_ui_i(3))
	style.set_corner_radius_all(_ui_i(2))
	match state:
		"selected":
			style.bg_color = Color(0.30, 0.24, 0.08, 0.98)
			style.border_color = Color(1.0, 0.83, 0.24, 1.0)
			style.set_border_width_all(_ui_i(4))
		"stocked":
			style.bg_color = Color(0.13, 0.14, 0.16, 0.96)
			style.border_color = Color(0.42, 0.44, 0.48, 0.95)
		_:
			style.bg_color = Color(0.08, 0.08, 0.09, 0.88)
			style.border_color = Color(0.21, 0.22, 0.24, 0.92)
	return style


## "1".."9", "0" for the first ten slots; "" past them (see
## SHOP_HOTKEY_SLOTS). The build menu prints the same string in its own
## slot corners, so the two views cannot disagree about which key is which.
func _hotbar_key_label(index: int) -> String:
	if index < 0 or index >= SHOP_HOTKEY_SLOTS:
		return ""
	return str((index + 1) % 10)


## Which slot a keycode selects, or -1 for a key that is not a hotbar key.
func _hotbar_index_for_keycode(keycode: int) -> int:
	var at := HOTBAR_KEYCODES.find(keycode)
	return at if at < _hotbar_slots.size() else -1


## THE ticket's behaviour change: a key (or a click) SELECTS a slot, and
## selecting is entering placement mode for that kind. Pressing the selected
## slot again puts it down, exactly as ESC already does — a hotbar key is a
## toggle in every game this borrows from.
##
## Buying is deliberately NOT here. Selecting what is in your hand and
## acquiring more of it are different verbs and stay on different actions:
## buying lives in the build menu (**E**), on a slot's left click, with
## SHIFT+number as its keyboard mirror. Collapsing them would mean a key that
## sometimes spends money, which is the one thing a player must never do by
## accident.
func _select_hotbar_slot(index: int) -> void:
	if index < 0 or index >= _hotbar_slots.size():
		return
	var kind: String = String(_hotbar_slots[index]["kind"])
	_pulse_hotbar_slot(index)
	_refresh_owned_counts()
	if _build_kind == kind:
		_exit_build_mode()
		_update_hotbar()
		return
	# `_enter_build_mode` refuses a kind the player owns none of — an empty
	# socket therefore does nothing, which is what the socket already looks
	# like. Say so in the flyout rather than leaving the keypress silent.
	_enter_build_mode(kind)
	if _build_kind != kind:
		_show_hotbar_flyout("%s — none carried" % _kind_display_name(kind))
	_update_hotbar()


func _on_hotbar_slot_pressed(index: int) -> void:
	_select_hotbar_slot(index)


## The click pulse: the slot dips and springs back. Purely visual, ~100ms,
## and it is what makes a click feel like it landed on something physical
## rather than toggling a boolean.
func _pulse_hotbar_slot(index: int) -> void:
	if index < 0 or index >= _hotbar_slots.size():
		return
	var button: Button = _hotbar_slots[index]["button"]
	if not button.is_inside_tree():
		return
	var target := Vector2.ONE * (HOTBAR_SELECTED_SCALE if _hotbar_selected_index() == index else 1.0)
	button.scale = Vector2.ONE * HOTBAR_PRESS_SCALE
	var tween := button.create_tween()
	tween.tween_property(button, "scale", target, HOTBAR_POP_SECONDS)\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


## Which slot is currently in the player's hand, or -1. Derived from
## `_build_kind` rather than stored, so the strip can never disagree with the
## ghost — ESC, E and running out of a kind all leave build mode without
## going through this file.
func _hotbar_selected_index() -> int:
	if _build_kind == "":
		return -1
	for index in range(_hotbar_slots.size()):
		if String(_hotbar_slots[index]["kind"]) == _build_kind:
			return index
	return -1


## Repolls `shop_snapshot_json` and redraws the strip. Called every frame:
## the strip is always on screen, so a count that moved because a belt was
## placed, removed or bought has to move here in the same frame. One parse of
## an eleven-entry object per frame is the same cost the contract clipboard
## already pays, and it is what keeps the hotbar honest with no push channel.
func _update_hotbar() -> void:
	if _hotbar_slots.is_empty():
		return
	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", []) if snapshot is Dictionary else []
	var selected := _hotbar_selected_index()

	for index in range(_hotbar_slots.size()):
		if index < entries.size():
			# The strip already parses the one snapshot `_refresh_owned_counts`
			# would, every frame — so it keeps that cache current rather than
			# making the next caller parse the same object again.
			_owned_counts[String(entries[index].get("kind", ""))] = int(entries[index].get("owned", 0))
	for index in range(_hotbar_slots.size()):
		var slot: Dictionary = _hotbar_slots[index]
		var owned := 0
		var price := 0.0
		if index < entries.size():
			owned = int(entries[index].get("owned", 0))
			price = float(entries[index].get("price", 0.0))
		var state := "selected" if index == selected else ("stocked" if owned > 0 else "empty")
		if String(slot["state"]) != state:
			slot["state"] = state
			_apply_hotbar_slot_state(slot, state, index == selected)

		# An empty socket shows no number at all — Minecraft shows an empty
		# slot as empty, not as a slot reading zero.
		slot["count_label"].text = str(owned) if owned > 0 else ""
		slot["icon"].modulate = Color.WHITE if owned > 0 else Color(1, 1, 1, 0.22)
		if _hotbar_tooltip_index == index:
			_fill_hotbar_tooltip(index, owned, price)

	_update_hotbar_flyout()
	_position_hotbar()


## Everything about a slot's appearance that is not per-frame data: the
## socket style, the caret, the key digit's brightness, and the pop.
func _apply_hotbar_slot_state(slot: Dictionary, state: String, selected: bool) -> void:
	var button: Button = slot["button"]
	var style: StyleBoxFlat = _hotbar_styles[state]
	for name in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(name, style)
	slot["mark"].visible = selected
	slot["key_label"].label_settings.font_color = (
		Color(1.0, 0.90, 0.50) if selected else Color(0.62, 0.64, 0.68)
	)
	# Selected slots draw over their neighbours, since they are bigger.
	button.z_index = 1 if selected else 0
	var target := Vector2.ONE * (HOTBAR_SELECTED_SCALE if selected else 1.0)
	if not button.is_inside_tree():
		button.scale = target
		return
	var tween := button.create_tween()
	tween.tween_property(button, "scale", target, HOTBAR_POP_SECONDS)\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


## The name flyout — shown for HOTBAR_FLYOUT_HOLD_MSEC then faded out over
## HOTBAR_FLYOUT_FADE_MSEC. Hand-timed off `Time.get_ticks_msec` rather than
## tweened, because a tween would have to be cancelled and rebuilt on every
## rapid slot switch, and because this way the fade is a pure function of the
## clock — which is also what makes it checkable headlessly.
func _show_hotbar_flyout(text: String) -> void:
	if _hotbar_flyout == null:
		return
	_hotbar_flyout.text = text
	_hotbar_flyout_until_msec = Time.get_ticks_msec() + HOTBAR_FLYOUT_HOLD_MSEC
	_hotbar_flyout.modulate = Color(1, 1, 1, 1)


func _update_hotbar_flyout() -> void:
	if _hotbar_flyout == null:
		return
	var remaining := _hotbar_flyout_until_msec - Time.get_ticks_msec()
	if remaining >= 0:
		_hotbar_flyout.modulate = Color(1, 1, 1, 1)
	elif remaining > -HOTBAR_FLYOUT_FADE_MSEC:
		_hotbar_flyout.modulate = Color(1, 1, 1, 1.0 + float(remaining) / float(HOTBAR_FLYOUT_FADE_MSEC))
	else:
		_hotbar_flyout.modulate = Color(1, 1, 1, 0)


## Re-anchors the strip to the bottom centre. Re-applied on every update for
## the same reason `_update_contract_panel` re-applies its own preset: a
## MINSIZE preset is computed from the content, and the content's size only
## settles once its labels have text in them.
func _position_hotbar() -> void:
	if _hotbar_root == null:
		return
	_hotbar_root.set_anchors_and_offsets_preset(
		Control.PRESET_CENTER_BOTTOM, Control.PRESET_MODE_MINSIZE, HOTBAR_BOTTOM_MARGIN
	)


## Terraria's framed hover panel, in this scene's plate styling: the kind's
## name, what the player is carrying, the unit price, and — the part this
## ticket actually needs — the two verbs, so "number selects, the build menu
## buys" is discoverable without reading source.
func _build_hotbar_tooltip(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.10, 0.09, 0.06, 0.96)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.set_border_width_all(_ui_i(2))
	style.set_content_margin_all(_ui_px(9.0))

	_hotbar_tooltip = PanelContainer.new()
	_hotbar_tooltip.name = "HotbarTooltip"
	_hotbar_tooltip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_tooltip.add_theme_stylebox_override("panel", style)
	_hotbar_tooltip.visible = false
	hud.add_child(_hotbar_tooltip)

	var rows := VBoxContainer.new()
	rows.mouse_filter = Control.MOUSE_FILTER_IGNORE
	rows.add_theme_constant_override("separation", _ui_i(3))
	_hotbar_tooltip.add_child(rows)

	var name_settings := LabelSettings.new()
	name_settings.font_size = _ui_font(2)
	name_settings.font_color = Color(0.98, 0.85, 0.42)
	name_settings.outline_size = base_settings.outline_size
	name_settings.outline_color = base_settings.outline_color

	_hotbar_tooltip_name = Label.new()
	_hotbar_tooltip_name.name = "TooltipName"
	_hotbar_tooltip_name.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_tooltip_name.label_settings = name_settings
	rows.add_child(_hotbar_tooltip_name)

	_hotbar_tooltip_body = Label.new()
	_hotbar_tooltip_body.name = "TooltipBody"
	_hotbar_tooltip_body.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_tooltip_body.label_settings = base_settings
	rows.add_child(_hotbar_tooltip_body)


func _on_hotbar_slot_hovered(index: int) -> void:
	_hotbar_tooltip_index = index
	var owned := _owned_of(String(_hotbar_slots[index]["kind"]))
	_fill_hotbar_tooltip(index, owned, _hotbar_price_of(index))
	if _hotbar_tooltip != null:
		_hotbar_tooltip.visible = true
		_position_hotbar_tooltip(index)


func _on_hotbar_slot_unhovered(index: int) -> void:
	if _hotbar_tooltip_index != index:
		return
	_hotbar_tooltip_index = -1
	if _hotbar_tooltip != null:
		_hotbar_tooltip.visible = false


func _hotbar_price_of(index: int) -> float:
	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	if not (snapshot is Dictionary):
		return 0.0
	var entries: Array = snapshot.get("entries", [])
	if index < 0 or index >= entries.size():
		return 0.0
	return float(entries[index].get("price", 0.0))


func _fill_hotbar_tooltip(index: int, owned: int, price: float) -> void:
	if _hotbar_tooltip_name == null or index < 0 or index >= _hotbar_slots.size():
		return
	var kind: String = String(_hotbar_slots[index]["kind"])
	_hotbar_tooltip_name.text = _kind_display_name(kind)
	var key := _hotbar_key_label(index)
	var select_line := ("press %s to select" % key) if key != "" else "click to select"
	_hotbar_tooltip_body.text = "%s    ·    %.0f each\n%s    ·    buy in the build menu (E)" % [
		("carrying %d" % owned) if owned > 0 else "carrying none",
		price,
		select_line,
	]


## Above the slot it belongs to, clamped on screen — the strip is at the
## bottom edge, so a tooltip has to grow upward or it would be off-screen.
func _position_hotbar_tooltip(index: int) -> void:
	if _hotbar_tooltip == null or index < 0 or index >= _hotbar_slots.size():
		return
	var button: Button = _hotbar_slots[index]["button"]
	var size := _hotbar_tooltip.get_combined_minimum_size()
	var anchor := button.global_position + Vector2(button.size.x / 2.0, 0.0)
	var pos := anchor - Vector2(size.x / 2.0, size.y + _ui_px(14.0))
	var vp := get_viewport()
	if vp != null:
		var bounds := vp.get_visible_rect().size
		pos.x = clamp(pos.x, 8.0, max(8.0, bounds.x - size.x - 8.0))
		pos.y = clamp(pos.y, 8.0, max(8.0, bounds.y - size.y - 8.0))
	_hotbar_tooltip.position = pos
	_hotbar_tooltip.size = size



# --------------------------------------------------------------------------
# Build mode: the ghost, and what the next click will do
# (the "Real Placement" epic's ticket 2)
# --------------------------------------------------------------------------

## How the ghost reads. Two independent signals per state, never colour
## alone (UI_UX.md §7): the translucent model is tinted, AND the prompt beside
## the cursor spells the state out with a glyph and a word. A player who
## cannot tell the green from the red still reads "✔ PLACE" or "✗ BLOCKED".
const GHOST_TINT_VALID := Color(0.55, 2.20, 0.75, 0.62)
const GHOST_TINT_INVALID := Color(2.40, 0.45, 0.35, 0.62)
## Remove mode tints the thing that would be picked up, in the same red as an
## invalid placement — red is "this click destroys or refuses", and the prompt
## says which. There is no green case: removing is either possible or there is
## nothing there, and "nothing there" shows no ghost at all.
const GHOST_TINT_REMOVE := Color(2.40, 0.45, 0.35, 0.68)


## The 3D node the ghost lives under, and the material it is drawn with.
## Separate from "World" so a rebuild of the world never disturbs the ghost
## the player is currently aiming.
func _build_ghost_layer() -> void:
	var existing := get_node_or_null("Ghost")
	if existing != null:
		remove_child(existing)
		existing.free()
	_ghost_root = Node3D.new()
	_ghost_root.name = "Ghost"
	_ghost_root.visible = false
	add_child(_ghost_root)
	_ghost_asset = ""


## A translucent, unshaded, TINTED copy of the asset. Three deliberate parts.
##
## Unshaded, because a ghost lit like the real building reads as a real
## building that has already been placed, and the whole job of this node is to
## say "not yet". Translucent for the same reason.
##
## And the tint MULTIPLIES over the model's own vertex colours rather than
## replacing them (`vertex_color_use_as_albedo`), which is what keeps the
## ghost a recognisable silhouette instead of a flat slab — the first cut
## replaced them and a rendered frame showed a belt ghost as a featureless
## green rectangle, telling the player a tile was involved but not which
## thing. The tint is deliberately pale so the model's dark voxels still come
## through as clearly tinted rather than as black.
func _ghost_material(tint: Color) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.albedo_color = tint
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	return mat


## Enters placement mode for `kind`. Refuses a kind the player owns none of
## rather than showing a ghost that could never be built — the build menu
## only offers this on an owned slot, and this is the second half of that
## rule so a hotkey cannot get round it.
func _enter_build_mode(kind: String) -> void:
	if _owned_of(kind) <= 0:
		return
	_remove_mode = false
	_build_kind = kind
	_build_direction = "east"
	# The next click builds now, so a panel that was waiting for a
	# configuration click has to go — see `_set_shop_menu_open`.
	_close_config_panel()
	_set_shop_menu_open(false)
	_set_market_open(false)
	# A hopper carries a choice as well as a facing, so the legal choices are
	# repolled on entry (the list is the simulation's, and content can change
	# it). The ghost takes the first of them; changing it is the placed
	# building's own panel, not a key held during placement.
	_refresh_hopper_items()
	# The name flyout fires here rather than in `_select_hotbar_slot`, so
	# every route into placement mode announces what is now in hand — the
	# hotbar key, a hotbar click, and the build menu's right-click alike.
	var held := "%s  ×%d" % [_kind_display_name(kind), _owned_of(kind)]
	if kind == HOPPER_KIND and _selected_hopper_item() != "":
		held = "Hopper — %s  ×%d" % [_item_display_name(_selected_hopper_item()), _owned_of(kind)]
	_show_hotbar_flyout(held)
	_rebuild_ghost_body()
	_update_ghost()
	_update_hotbar()


## Remove mode is a MODE, not a modifier-click, and that is deliberate: it is
## the one destructive action in the game (what a removed thing was holding is
## destroyed — see `PlayerCommand::Remove`), and a mode announces itself in
## the legend and in the on-screen prompt, where a held modifier cannot.
func _toggle_remove_mode() -> void:
	if _remove_mode:
		_exit_build_mode()
		return
	_build_kind = ""
	_remove_mode = true
	_close_config_panel()
	_set_shop_menu_open(false)
	_rebuild_ghost_body()
	_update_ghost()
	# Remove mode replaces placement mode, so the strip has nothing selected
	# any more — and the highlight has to go with it, or the hotbar would
	# claim the player is holding something while the ghost says they are
	# about to destroy something.
	_update_hotbar()


## Leaves whichever of the two modes is active, with no dangling state: the
## ghost's own body is freed, not just hidden, so the next entry starts clean.
func _exit_build_mode() -> void:
	_build_kind = ""
	_remove_mode = false
	_ghost_reason = ""
	_ghost_valid = false
	_clear_ghost_body()
	if _ghost_root != null:
		_ghost_root.visible = false
	if _placement_prompt != null:
		_placement_prompt.visible = false
	# The strip's selection is derived from `_build_kind`, so leaving build
	# mode by ANY route (ESC, E, X, running out of a kind) clears the
	# highlight without that route having to know the hotbar exists.
	_update_hotbar()


## ESC's universal "close whatever is open". The scene has four pieces of
## stateful UI a player can leave standing — the build menu (`_shop_open`),
## the ingredient market (`_market_open`), placement mode (`_build_kind`) and
## remove mode (`_remove_mode`) — and one press clears all of them from any
## combination, which is what every builder this game borrows from does.
##
## The building configuration panel is closed here too, but ESC does not
## REACH here while it is up: `_unhandled_input` closes that panel and
## returns first, so "close what I am looking at" means the panel by the
## building rather than also emptying the player's hand. The call is kept
## here for the other routes in (E, X, the hotbar) rather than being a
## second rule to remember.
##
## It is a separate function rather than a line added to `_exit_build_mode`
## on purpose: that function's other callers must NOT close the menu.
## `_select_hotbar_slot` calls it to put down the kind in hand, and the
## number keys are documented to work with the menu open or closed — a
## deselect that also swept the menu away would break that. Same for
## `_confirm_build`'s "you placed your last one" exit. So ESC gets the wider
## verb and everything else keeps the narrow one.
##
## Nothing else here is a mode: the hover tooltip and the hotbar tooltip are
## driven by where the cursor is, and the name flyout fades on its own timer.
func _close_all_overlays() -> void:
	_close_config_panel()
	_set_shop_menu_open(false)
	_set_market_open(false)
	_exit_build_mode()


## Is there anything for ESC to close? This is what decides whether the next
## ESC closes an overlay or opens the pause menu, and it deliberately counts
## build/remove mode as "open": a ghost following the cursor is a state the
## player is in, and putting it down should be the first press, not the
## second.
func _anything_open() -> bool:
	return _shop_open or _market_open or _in_build_mode()


func _in_build_mode() -> bool:
	return _build_kind != "" or _remove_mode


## Cycles the ghost's facing one quarter turn CLOCKWISE — the same single
## rotation the simulation offers (`Direction::rotate_cw`), so the ghost and
## `PlayerCommand::Rotate` can never disagree about which way "rotate" goes.
func _rotate_ghost() -> void:
	_build_direction = DIRECTIONS[(_direction_index(_build_direction) + 1) % DIRECTIONS.size()]
	_rebuild_ghost_body()
	_update_ghost()


## **R** outside placement mode: turns whatever is under the cursor where it
## stands. No pick-up-and-re-place round trip, which is what a player coming
## from any other builder expects, and it is free — `PlayerCommand::Rotate`
## resolves from any tile of a footprint and keeps the thing's contents.
func _rotate_under_cursor() -> void:
	var tile := _ghost_target_tile()
	if tile == HOVER_NO_TILE:
		return
	if _placement_at_tile(tile).is_empty():
		return
	_issue_world_command({"type": "rotate", "tile": [tile.x, tile.y]})


## The left click. Places in placement mode, removes in remove mode, and does
## nothing at all when the ghost says the click could not succeed — the
## simulation would refuse it silently anyway (every impossible command is a
## total no-op), so refusing here as well keeps the prompt honest rather than
## letting a click look like it did something.
func _confirm_build() -> void:
	# Acts on the tile the GHOST IS DRAWN ON (`_ghost_tile`, recomputed once
	# per frame by `_update_ghost`), not on a freshly re-picked one. What the
	# player is aiming at is what they can see; re-picking here would let a
	# cursor that moved between the frame and the button-down land the build
	# somewhere the ghost never was.
	var tile := _ghost_tile
	if tile == HOVER_NO_TILE:
		return
	if _remove_mode:
		if _placement_at_tile(tile).is_empty():
			return
		_issue_world_command({"type": "remove", "tile": [tile.x, tile.y]})
		return
	if _build_kind == "" or not _ghost_valid:
		return
	var command := {
		"type": "place",
		"kind": _build_kind,
		"tile": [tile.x, tile.y],
		"direction": _build_direction,
	}
	# **A hopper says what it will hold.** `PlayerCommand::Place`'s `item` is
	# optional only while the world has exactly one raw solid to infer from,
	# and the shipped chain has had two since the chain rework — so omitting
	# it (which this function did until then) is a silent refusal, and
	# placing a hopper did nothing at all. Sent for the hopper and no other
	# kind, because the field is ignored elsewhere and a command carrying a
	# field that means nothing invites the next reader to think it does.
	if _build_kind == HOPPER_KIND:
		var item := _selected_hopper_item()
		if item == "":
			return
		command["item"] = item
	_issue_world_command(command)
	# Placing spends one owned unit. Running out ends the mode rather than
	# leaving a ghost that can no longer be built — the prompt would read
	# "✗ NONE OWNED" forever, which is a dead end rather than feedback.
	_refresh_owned_counts()
	if _owned_of(_build_kind) <= 0:
		_exit_build_mode()


## Issues one of the three topology commands and redraws. A place, remove or
## rotate is exactly the event `World::recompute_topology` rebuilds its
## adjacency graph for, so it is exactly the event this scene rebuilds its
## own view for — see `_placements`'s doc.
func _issue_world_command(command: Dictionary) -> void:
	sim.issue_command_json(JSON.stringify(command))
	_rebuild_world()
	_refresh_owned_counts()
	_apply_dirty_chunks()
	if _shop_open:
		_update_shop_menu()


## How many of each kind the player owns and has not yet placed — repolled
## after every purchase and placement. `shop_snapshot_json` is the one call
## that reports it, and it is cheap (one parse of a ten-entry object).
func _refresh_owned_counts() -> void:
	_owned_counts.clear()
	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	if not (snapshot is Dictionary):
		return
	for entry in snapshot.get("entries", []):
		_owned_counts[String(entry.get("kind", ""))] = int(entry.get("owned", 0))


func _owned_of(kind: String) -> int:
	return int(_owned_counts.get(kind, 0))


## The tile the ghost sits on — the same ray/plane pick the hover tooltip
## uses, from the same screen point (the live cursor in ISOMETRIC, the screen
## centre where the crosshair is drawn in FIRST_PERSON). Deliberately the
## SAME function, not a second implementation: build mode and hover are two
## questions about one cursor.
func _ghost_target_tile() -> Vector2i:
	var vp := get_viewport()
	if vp == null:
		return HOVER_NO_TILE
	var query_pos: Vector2
	if _view_mode == ViewMode.FIRST_PERSON:
		query_pos = vp.get_visible_rect().size / 2.0
	else:
		query_pos = vp.get_mouse_position()
	return _tile_under_screen_pos(query_pos)


## Whether the rotated footprint of `kind` at `tile` would overlap anything
## already placed. A pure Godot-side check against `_occupancy` — the same map
## hover resolves through, which came from `world_layout_json`'s own
## `occupies` lists — so aiming the ghost costs no simulation round trip at
## all. The simulation still has the final say (`Place` refuses a collision
## silently); this is what stops the player finding that out by clicking.
func _ghost_blocked_tiles(kind: String, tile: Vector2i, direction: String) -> Array:
	var blocked: Array = []
	for covered in _placement_tiles(tile, _kind_footprint(kind), direction):
		if _occupancy.has(_tile_key(covered)):
			blocked.append(covered)
	return blocked


## Rebuilds the ghost's own body — one translucent copy of the kind's real
## voxel model, turned to the ghost's facing. Rebuilt (rather than retinted)
## only when the ASSET changes: in build mode that is a change of kind, in
## remove mode it is whichever placement the cursor is over (a corner belt's
## remove ghost is the corner).
func _rebuild_ghost_body(asset_override := "") -> void:
	if _ghost_root == null:
		return
	var asset := asset_override
	if asset == "" and _build_kind != "":
		asset = _shop_asset_for(_build_kind)
	if asset == _ghost_asset:
		return
	_clear_ghost_body()
	_ghost_asset = asset
	if asset == "":
		return
	var body := _asset_node(asset)
	body.name = "ghost_body"
	# A ghost casts no shadow: a shadow on the floor is the strongest cue
	# there IS something there, which is the opposite of what this node says.
	for child in body.get_children():
		if child is MeshInstance3D:
			child.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_ghost_root.add_child(body)
	# A hopper ghost also previews its CONTENTS — see `_update_ghost_fill`.
	_update_ghost_fill()


func _clear_ghost_body() -> void:
	if _ghost_root == null:
		return
	for child_name in ["ghost_body", "ghost_fill"]:
		var body := _ghost_root.get_node_or_null(child_name)
		if body != null:
			_ghost_root.remove_child(body)
			body.free()
	_ghost_asset = ""
	_ghost_fill = null


## The hopper ghost's product body: a `hopper_fill` slab, tinted with the
## chosen ingredient, sitting in the ghost the way a real hopper's does.
##
## This is what makes the Q choice VISIBLE rather than merely announced. The
## prompt names the item in words (which is the half UI_UX.md §7 requires on
## its own), and this is the half that answers "what am I about to build" at
## a glance — a hopper of tomatoes and a hopper of sugar are two different
## buildings, and looking identical until placed is how a player ends up with
## two of the wrong one.
##
## It is the same one-voxel-slab mechanism the live hopper, the tank, the
## pipe and the splitter arrow already share, at a fixed nearly-full level: a
## ghost has no fill fraction, and an empty one would draw nothing at all.
func _update_ghost_fill() -> void:
	if _ghost_root == null:
		return
	if _ghost_fill != null:
		_ghost_root.remove_child(_ghost_fill)
		_ghost_fill.free()
		_ghost_fill = null
	var item := _selected_hopper_item()
	if item == "":
		return
	var node := _asset_node(HOPPER_FILL_ASSET)
	node.name = "ghost_fill"
	node.position = Vector3(0.0, HOPPER_FILL_FLOOR_Y, 0.0)
	node.scale.y = 0.8 * float(HOPPER_FILL_HEIGHT_VOXELS)
	var tint: Color = HOPPER_FILL_TINTS.get(item, HOPPER_FILL_TINT_FALLBACK)
	for child in node.get_children():
		if child is MeshInstance3D:
			child.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			child.set_surface_override_material(0, _ghost_material(tint))
	_ghost_root.add_child(node)
	_ghost_fill = node


## Per-frame: where the ghost stands, whether the click would succeed, and
## what the prompt says. Cheap — one ray/plane intersection and one
## dictionary lookup per covered tile — and it does nothing at all when
## neither mode is active.
func _update_ghost() -> void:
	if _ghost_root == null:
		return
	if not _in_build_mode():
		if _ghost_root != null:
			_ghost_root.visible = false
		if _placement_prompt != null:
			_placement_prompt.visible = false
		return

	_refresh_owned_counts()
	var tile := _ghost_target_tile()
	_ghost_tile = tile
	var showing := false

	if _remove_mode:
		var placement := _placement_at_tile(tile) if tile != HOVER_NO_TILE else {}
		if placement.is_empty():
			_ghost_valid = false
			_ghost_reason = "nothing_here"
		else:
			_ghost_valid = true
			_ghost_reason = ""
			var origin := _placement_origin(placement)
			var direction := _placement_direction(placement)
			var size := _rotated_footprint(_footprint_size(placement.get("footprint")), direction)
			_rebuild_ghost_body(_asset_for_placement(placement))
			_ghost_root.position = _footprint_centre(origin, size, FLOOR_Y)
			_ghost_root.rotation.y = _direction_yaw(direction)
			_tint_ghost(GHOST_TINT_REMOVE)
			showing = true
	elif tile != HOVER_NO_TILE:
		var blocked := _ghost_blocked_tiles(_build_kind, tile, _build_direction)
		if _owned_of(_build_kind) <= 0:
			_ghost_valid = false
			_ghost_reason = "none_owned"
		elif not blocked.is_empty():
			_ghost_valid = false
			_ghost_reason = "blocked"
		else:
			_ghost_valid = true
			_ghost_reason = ""
		# **The belt ghost is always the straight tile**, even where the
		# placed tile will become a corner or a merge. A tile's shape is
		# derived from `links`, and `links` are what the simulation's
		# topology pass resolved for a tile that EXISTS; the would-be links
		# of a tile that does not are a fact the sim has not computed yet,
		# and computing them here would mean a Godot-side copy of
		# `resolve_sink` (which belts feed which, from which sides, with the
		# inlet-edge rule ticket 1 flagged) that drifts the moment the sim's
		# rule changes — the second adjacency scan the whole `links` field
		# exists to avoid. The right home for a would-be shape is
		# ARCHITECTURE.md §4's planned `preview_command`, a validation pass
		# the sim answers; when it lands the ghost reads its shape from it.
		# Until then the ghost's job is the tile, the facing (the arrow on
		# the straight tile) and whether the click will succeed; the corner
		# appears the instant the tile is placed, since placing rebuilds.
		# A pipe's ghost, by ticket 6's rule, shows the shape the placed pipes
		# around the tile would give it (see `_pipe_ghost_shape`), at that
		# shape's own turn; ticket 7 reconciles the two ghost rules.
		var ghost_asset := _shop_asset_for(_build_kind)
		var ghost_yaw := _direction_yaw(_build_direction)
		if _build_kind == PIPE_KIND:
			var ghost_shape := _pipe_ghost_shape(tile, _build_direction)
			ghost_asset = String(ghost_shape["asset"])
			ghost_yaw = float(ghost_shape["yaw"])
		_rebuild_ghost_body(ghost_asset)
		var ghost_size := _rotated_footprint(_kind_footprint(_build_kind), _build_direction)
		_ghost_root.position = _footprint_centre(tile, ghost_size, FLOOR_Y)
		_ghost_root.rotation.y = ghost_yaw
		_tint_ghost(GHOST_TINT_VALID if _ghost_valid else GHOST_TINT_INVALID)
		showing = true
	else:
		_ghost_valid = false
		_ghost_reason = "blocked"

	_ghost_root.visible = showing
	if _placement_prompt != null:
		_placement_label.text = _placement_prompt_text()
		_placement_prompt.add_theme_stylebox_override(
			"panel", _placement_prompt_style(_ghost_valid, _remove_mode)
		)
		var vp := get_viewport()
		if vp != null:
			var anchor: Vector2
			if _view_mode == ViewMode.FIRST_PERSON:
				anchor = vp.get_visible_rect().size / 2.0
			else:
				anchor = vp.get_mouse_position()
			_placement_prompt.position = _panel_position_near(_placement_prompt, anchor)
		_placement_prompt.visible = true


func _tint_ghost(tint: Color) -> void:
	var body := _ghost_root.get_node_or_null("ghost_body")
	if body == null:
		return
	var mat := _ghost_material(tint)
	for child in body.get_children():
		if child is MeshInstance3D:
			child.set_surface_override_material(0, mat)


## The shape a pipe placed on `tile` would take, judged from the PIPE tiles
## already standing on its four sides — every orthogonally adjacent pipe
## joins the same network (`sim::world`'s pipe-links doc), so that much of
## the answer is certain before the simulation is asked. Which machine or
## tank it would tap is not (a machine taps one tile of a run, and the
## simulation picks which), so the ghost previews no fitting and no
## machine-side connection; the placed tile draws them from the real
## `links` a moment later. With no pipe beside it the ghost lies along the
## chosen facing, exactly as the placed lonely tile will.
func _pipe_ghost_shape(tile: Vector2i, direction: String) -> Dictionary:
	var faces: Array = []
	for side in DIRECTIONS:
		var neighbour := _placement_at_tile(tile + _direction_offset(side))
		if not neighbour.is_empty() and String(neighbour.get("kind", "")) == PIPE_KIND:
			faces.append(side)
	return _pipe_shape_for(faces, direction)


## What the prompt beside the cursor says. The glyph and the word are the
## non-colour half of UI_UX.md §7's rule — this text alone is enough to know
## whether the click will do anything, with the tint as reinforcement rather
## than as the signal. Pure, so a test can drive every state directly.
func _placement_prompt_text() -> String:
	if _remove_mode:
		if _ghost_reason == "nothing_here":
			return "✗ REMOVE\nnothing here\nX or ESC: stop removing"
		var placement := _placement_at_tile(_ghost_tile)
		return "✔ REMOVE  %s\nclick to pick it up (what it holds is lost)\nX or ESC: stop removing" % \
			_kind_display_name(String(placement.get("kind", "")))
	if _build_kind == "":
		return ""
	var kind_name := _kind_display_name(_build_kind)
	var owned := _owned_of(_build_kind)
	# A hopper's contents are part of what is about to be built, so they are
	# in the NAME rather than tucked into the hint line: "✔ PLACE Hopper" and
	# "✔ PLACE Hopper — Sugar" are two different claims about the click.
	var contents := _selected_hopper_item()
	if contents != "":
		kind_name = "%s — %s" % [kind_name, _item_display_name(contents)]
	# Where the contents are changed is only advertised when there is more
	# than one thing to change them to. In a world with a single raw
	# ingredient the choice does not exist and a hint about it would be noise.
	var contents_hint := ""
	if _build_kind == HOPPER_KIND and _hopper_items.size() > 1:
		contents_hint = "\nclick it once placed to change its contents"
	match _ghost_reason:
		"none_owned":
			return "✗ NONE OWNED  %s\nbuy one in the build menu (E)\nESC: cancel" % kind_name
		"blocked":
			return "✗ BLOCKED  %s  ·  facing %s\nsomething is already there\nR: rotate    ESC: cancel%s" % [
				kind_name, _build_direction, contents_hint
			]
	return "✔ PLACE  %s  ·  facing %s\nclick to build    %d left to place\nR: rotate    ESC: cancel%s" % [
		kind_name, _build_direction, owned, contents_hint
	]


## The prompt's plate: the scene's near-black HUD panel with its rule
## recoloured to the ghost's state, so the panel edge carries the same signal
## the glyph does.
##
## `destructive` (remove mode) overrides `valid`, and that came off a rendered
## frame: a valid REMOVE is still a red-ghosted building about to be destroyed,
## and framing it in the same green a valid PLACE gets read as two different
## claims about one action. Green means "this click builds"; red means "this
## click destroys, or refuses".
func _placement_prompt_style(valid: bool, destructive := false) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.92)
	var ok := valid and not destructive
	style.border_color = Color(0.35, 0.85, 0.45, 0.95) if ok else Color(0.92, 0.35, 0.30, 0.95)
	style.set_border_width_all(_ui_i(3))
	style.set_content_margin_all(_ui_px(10.0))
	return style


## The on-screen prompt, built beside the hover tooltip and deliberately the
## same shape as it: a small dark plate that follows the cursor. Build mode
## and hover never show at once (see `_update_hover_tooltip`), so what the
## player sees is one panel by the cursor that changes what it is about.
func _build_placement_prompt(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	_placement_prompt = PanelContainer.new()
	_placement_prompt.name = "PlacementPrompt"
	_placement_prompt.add_theme_stylebox_override("panel", _placement_prompt_style(true))
	_placement_prompt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_placement_prompt.visible = false
	hud.add_child(_placement_prompt)

	_placement_label = Label.new()
	_placement_label.label_settings = base_settings
	_placement_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_placement_prompt.add_child(_placement_label)


func _build_hover_tooltip(hud: CanvasLayer) -> void:
	# The hover tooltip (docs/UI_UX.md §5): a small, separately-positioned
	# panel that follows the cursor and shows one stage's recipe/progress/
	# input/output — the info the always-on panel used to show for every
	# stage at once, now on-demand only. A simple readable panel, not this
	# section's clipboard/checklist diegetic styling — that visual pass is
	# separate work; this just needs to be legible near the cursor.
	var hover_style := StyleBoxFlat.new()
	hover_style.bg_color = Color(0.10, 0.09, 0.06, 0.92)
	hover_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	hover_style.set_border_width_all(_ui_i(2))
	hover_style.set_content_margin_all(_ui_px(8.0))

	_hover_tooltip = PanelContainer.new()
	_hover_tooltip.add_theme_stylebox_override("panel", hover_style)
	_hover_tooltip.visible = false
	# Ignore mouse events itself, or the panel following the cursor would
	# constantly steal hover from whatever's under it (including, absurdly,
	# itself — every frame's "am I hovering a machine" check reads the raw
	# viewport mouse position, not anything mouse-event-driven, so this only
	# matters for a hypothetical future clickable HUD element underneath).
	_hover_tooltip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hud.add_child(_hover_tooltip)

	var hover_settings := LabelSettings.new()
	hover_settings.font_size = _ui_font(-1)
	hover_settings.font_color = Color(0.95, 0.95, 0.90)
	hover_settings.outline_size = _ui_i(3)
	hover_settings.outline_color = Color(0, 0, 0, 0.85)

	_hover_label = Label.new()
	_hover_label.label_settings = hover_settings
	_hover_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hover_tooltip.add_child(_hover_label)


## A small screen-centre crosshair, shown only in FIRST_PERSON (toggled in
## _set_view_mode) — the mouse is captured/hidden there, so it's the only
## way to see what "looking at" a machine even means, and it's what
## _update_hover_tooltip queries against instead of a live cursor position.
## Two thin bars rather than a Label glyph, so it stays crisp at any size
## without depending on a font having a suitable character.
func _build_crosshair(hud: CanvasLayer) -> void:
	_crosshair = Control.new()
	_crosshair.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crosshair.visible = false
	_crosshair.set_anchors_preset(Control.PRESET_FULL_RECT)
	hud.add_child(_crosshair)

	var bar_color := Color(0.95, 0.95, 0.90, 0.85)
	var h_bar := ColorRect.new()
	h_bar.color = bar_color
	h_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	h_bar.size = Vector2(CROSSHAIR_SIZE, CROSSHAIR_THICKNESS)
	h_bar.set_anchors_preset(Control.PRESET_CENTER)
	h_bar.position = -h_bar.size / 2.0
	_crosshair.add_child(h_bar)

	var v_bar := ColorRect.new()
	v_bar.color = bar_color
	v_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v_bar.size = Vector2(CROSSHAIR_THICKNESS, CROSSHAIR_SIZE)
	v_bar.set_anchors_preset(Control.PRESET_CENTER)
	v_bar.position = -v_bar.size / 2.0
	_crosshair.add_child(v_bar)


# --------------------------------------------------------------------------
# The pause menu (the "Save/load + a real main menu" epic, ticket 2)
# --------------------------------------------------------------------------

## The in-game menu: Resume, Save (into a named slot), Save & Quit to Menu,
## Quit to Menu, Quit Game.
##
## It is the SAME plate the build menu and the market are drawn on, one step
## more opaque, so it reads as another screen of this game rather than an
## engine dialog — and it is centred in the whole viewport rather than in the
## space above the hotbar, unlike those two: the game is stopped, so nothing
## underneath it is worth keeping clear.
##
## A `LineEdit` for the slot name, not a fixed list of numbered slots. This
## game has no concept of a save "profile" and no screen that would show
## three empty boxes usefully; a name is what the player will recognise the
## save by in the menu's list, and the list is sorted by time anyway. The
## field prefills with `_save_slot` (whatever this session was loaded from,
## or `DEFAULT_SLOT`), so the common case — save again over the same
## file — is one click.
func _build_pause_menu(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.97)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.border_width_top = _ui_i(4)
	style.border_width_left = _ui_i(2)
	style.border_width_right = _ui_i(2)
	style.border_width_bottom = _ui_i(2)
	style.set_content_margin_all(_ui_px(20.0))

	_pause_menu = PanelContainer.new()
	_pause_menu.name = "PauseMenu"
	_pause_menu.add_theme_stylebox_override("panel", style)
	_pause_menu.visible = false
	hud.add_child(_pause_menu)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(12))
	_pause_menu.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(8)
	title_settings.font_color = Color(0.98, 0.85, 0.42)
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "PAUSED"
	title.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	body.add_child(title)

	# The one line that says the factory has actually stopped. Without it a
	# player has to infer it from belts not moving, which is exactly the
	# never-encode-state-invisibly problem UI_UX.md §7 is about.
	var note := Label.new()
	note.label_settings = base_settings
	note.text = "the factory is stopped while this is open"
	note.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	body.add_child(note)

	_pause_buttons_box = VBoxContainer.new()
	_pause_buttons_box.name = "PauseButtons"
	_pause_buttons_box.add_theme_constant_override("separation", _ui_i(8))
	body.add_child(_pause_buttons_box)

	var resume := _pause_button("ResumeButton", "RESUME")
	resume.pressed.connect(_on_pause_resume_pressed)
	_pause_buttons_box.add_child(resume)

	# The game's first sound arrived with the payout celebration, so the first
	# way to switch it off arrives with it too — on the one screen a player
	# already opens to change how the session behaves, rather than as a
	# keybind nobody would find. Its caption says ON or OFF in words rather
	# than looking pressed, per UI_UX.md §7.
	_pause_sound_button = _pause_button("SoundButton", "SOUND: ON")
	_pause_sound_button.pressed.connect(_on_pause_sound_pressed)
	_pause_buttons_box.add_child(_pause_sound_button)

	var save_row := HBoxContainer.new()
	save_row.add_theme_constant_override("separation", _ui_i(8))
	_pause_buttons_box.add_child(save_row)

	_pause_slot_field = LineEdit.new()
	_pause_slot_field.name = "SaveSlotField"
	_pause_slot_field.placeholder_text = "save name"
	_pause_slot_field.custom_minimum_size = Vector2(
		PAUSE_BUTTON_MIN_SIZE.x - _ui_px(110.0), PAUSE_BUTTON_MIN_SIZE.y
	)
	_pause_slot_field.add_theme_font_size_override("font_size", _ui_font(1))
	save_row.add_child(_pause_slot_field)

	var save_button := _pause_button("SaveButton", "SAVE")
	save_button.custom_minimum_size = Vector2(_ui_px(102.0), PAUSE_BUTTON_MIN_SIZE.y)
	save_button.pressed.connect(_on_pause_save_pressed)
	save_row.add_child(save_button)

	var save_quit := _pause_button("SaveQuitButton", "SAVE & QUIT TO MENU")
	save_quit.pressed.connect(_on_pause_save_and_quit_pressed)
	_pause_buttons_box.add_child(save_quit)

	var quit_menu := _pause_button("QuitToMenuButton", "QUIT TO MENU")
	quit_menu.pressed.connect(_on_pause_quit_to_menu_pressed)
	_pause_buttons_box.add_child(quit_menu)

	var quit_game := _pause_button("QuitGameButton", "QUIT GAME")
	quit_game.pressed.connect(_on_pause_quit_game_pressed)
	_pause_buttons_box.add_child(quit_game)

	# The confirm step for Quit to Menu, in place of the buttons rather than
	# in a dialog over them: a second modal on top of a modal is two things to
	# dismiss, and the question is short enough to be the panel's whole
	# content for the moment it is being asked.
	_pause_confirm_box = VBoxContainer.new()
	_pause_confirm_box.name = "PauseConfirm"
	_pause_confirm_box.add_theme_constant_override("separation", _ui_i(8))
	_pause_confirm_box.visible = false
	body.add_child(_pause_confirm_box)

	var confirm_text := Label.new()
	confirm_text.label_settings = base_settings
	confirm_text.text = "Quit to the menu? Everything built since the last save is lost."
	confirm_text.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	confirm_text.custom_minimum_size = Vector2(PAUSE_BUTTON_MIN_SIZE.x, 0.0)
	_pause_confirm_box.add_child(confirm_text)

	var confirm := _pause_button("ConfirmQuitButton", "YES, QUIT TO MENU")
	confirm.pressed.connect(_on_pause_confirm_quit_pressed)
	_pause_confirm_box.add_child(confirm)

	var cancel := _pause_button("CancelQuitButton", "CANCEL")
	cancel.pressed.connect(_on_pause_cancel_quit_pressed)
	_pause_confirm_box.add_child(cancel)

	# What the last action did — a save's file name, or why one was refused.
	# Its own line inside this panel rather than the hotbar flyout, because
	# the flyout sits at the bottom of the screen behind this plate.
	_pause_status = Label.new()
	_pause_status.name = "PauseStatus"
	_pause_status.label_settings = base_settings
	_pause_status.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	_pause_status.custom_minimum_size = Vector2(PAUSE_BUTTON_MIN_SIZE.x, 0.0)
	_pause_status.text = ""
	body.add_child(_pause_status)

	_position_pause_menu()


func _pause_button(node_name: String, text: String) -> Button:
	var button := Button.new()
	button.name = node_name
	button.text = text
	button.custom_minimum_size = PAUSE_BUTTON_MIN_SIZE
	button.focus_mode = Control.FOCUS_NONE
	# A Button falls back to the theme's default size, not `base_settings` —
	# a rendered frame at the 2026-09-09 scale showed these captions a clear
	# step smaller than the body text beside them. The menu scene's buttons
	# sit at the same offset (`menu.gd`'s BUTTON_FONT_SIZE).
	button.add_theme_font_size_override("font_size", _ui_font(5))
	for state in ["normal", "hover", "pressed", "focus", "disabled"]:
		button.add_theme_stylebox_override(state, _shop_slot_style(state))
	return button


func _position_pause_menu() -> void:
	if _pause_menu == null:
		return
	_pause_menu.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)


## Opens or closes the pause menu, and with it the simulation's pause.
##
## Handing the mouse back in first-person is the same thing the build menu
## and the market already do, and for the same reason: this panel has buttons
## and a text field on it, and a captured mouse cannot press either.
func _set_pause_open(open: bool) -> void:
	if _pause_menu == null or open == _pause_open:
		return
	_pause_open = open
	_pause_menu.visible = open
	if open:
		_pause_confirm_quit = false
		_set_pause_confirm(false)
		_pause_status.text = ""
		_pause_slot_field.text = _save_slot
		_position_pause_menu()
	else:
		# Whatever real time passed while the panel was up must not become
		# simulation ticks the moment it closes — see `_process`. The clamp
		# would cap the burst at MAX_TICKS_PER_FRAME per frame, but a long
		# pause would still be paid back over the following frames.
		_tick_accum = 0.0
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


func _set_pause_confirm(confirming: bool) -> void:
	_pause_confirm_quit = confirming
	if _pause_buttons_box != null:
		_pause_buttons_box.visible = not confirming
	if _pause_confirm_box != null:
		_pause_confirm_box.visible = confirming
	_position_pause_menu()


func _on_pause_resume_pressed() -> void:
	_set_pause_open(false)


## Writes the live world to the named slot. Returns "" on success or the
## reason it was refused, so the two callers (Save, and Save & Quit) share
## one rule about what a legal slot name is — including the reserved
## `autosave` one, which is refused out loud rather than quietly renamed.
func _save_to_slot(name: String) -> String:
	var slot: String = GameSaves.sanitize_slot(name)
	if slot == "":
		return "That save needs a name."
	if GameSaves.is_reserved_slot(slot):
		return "'%s' is the autosave's own slot — pick another name." % GameSaves.AUTOSAVE_SLOT
	var error: String = GameSaves.write_slot(slot, String(sim.save_ron()))
	if error != "":
		return error
	_save_slot = slot
	var session := _session()
	if session != null:
		session.current_slot = slot
	return ""


func _on_pause_save_pressed() -> void:
	var typed := _pause_slot_field.text if _pause_slot_field != null else _save_slot
	var error := _save_to_slot(typed)
	if error != "":
		_pause_status.text = error
		return
	_pause_status.text = "Saved to %s" % _save_slot
	_pause_slot_field.text = _save_slot
	# The hotbar flyout too, so the confirmation is also there after the
	# panel closes — the same label every other "that worked" message uses.
	_show_hotbar_flyout("Saved to %s" % _save_slot)


func _on_pause_save_and_quit_pressed() -> void:
	var typed := _pause_slot_field.text if _pause_slot_field != null else _save_slot
	var error := _save_to_slot(typed)
	if error != "":
		_pause_status.text = error
		return
	# No confirm step on this one, deliberately: it cannot lose anything.
	_quit_to_menu()


## Quit to Menu ASKS first — it is the one button here that throws work away.
func _on_pause_quit_to_menu_pressed() -> void:
	_set_pause_confirm(true)


func _on_pause_cancel_quit_pressed() -> void:
	_set_pause_confirm(false)


func _on_pause_confirm_quit_pressed() -> void:
	_quit_to_menu()


func _on_pause_quit_game_pressed() -> void:
	_quit_game()


## Back to `menu.tscn`, autosaving first. Arms the session for a NEW game so
## that the menu's own New Game button cannot inherit this session's pending
## `load` — the menu re-arms it on every choice anyway, but leaving a stale
## action behind is the kind of thing that only shows up as "New Game loaded
## my old factory" much later.
func _quit_to_menu() -> void:
	_autosave("quit to menu")
	var session := _session()
	if session != null:
		session.arm_new_game()
	_set_pause_open(false)
	if is_inside_tree():
		get_tree().change_scene_to_file("res://menu.tscn")


func _quit_game() -> void:
	_autosave("quit")
	if is_inside_tree():
		get_tree().quit()


## Writes `user://saves/autosave.ron`. It NEVER touches a named slot, which
## is the other half of the reservation `GameSaves.is_reserved_slot`
## enforces: a timer that could overwrite the save a player deliberately made
## is a timer that destroys work, and the whole point of an autosave is that
## the player does not have to think about when it runs.
##
## `reason` is only for the flyout, and only when the player is still there
## to read it (the timer case); a quit does not flash a message at a window
## that is closing.
func _autosave(reason := "") -> void:
	var error: String = GameSaves.write_slot(
		GameSaves.AUTOSAVE_SLOT, String(sim.save_ron()), true
	)
	if error != "":
		printerr("Sauce Factory: autosave failed — %s" % error)
		return
	if reason == "timer":
		_show_hotbar_flyout("Autosaved")


## The window's close button. `auto_accept_quit` was turned off in `_ready`
## precisely so this runs BEFORE the process goes away — the default handling
## quits immediately and would take the last few minutes of building with it.
func _notification(what: int) -> void:
	if what == NOTIFICATION_WM_CLOSE_REQUEST:
		_quit_game()


# --------------------------------------------------------------------------
# Simulation driving / rendering
# --------------------------------------------------------------------------

func _process(delta: float) -> void:
	_advance_simulation(delta)

	_update_contract_panel()
	if _shop_open:
		# Only while it's up: money the running factory earns should make a
		# slot go from unaffordable to affordable while the player watches.
		_update_shop_menu()
	_update_fluid_network()
	_refresh_buffers()
	_update_machine_gauges()
	_update_hotbar()
	_update_larder()
	if _market_open:
		_update_ingredient_market()
	# The ghost cannot be up while paused at all — build mode counts as
	# "open", so ESC puts it down before it opens the panel — but the hover
	# tooltip would otherwise keep answering questions about whatever tile
	# happens to be behind the plate. `_update_hover_tooltip` hides itself
	# when `_pause_open`.
	_update_config_panel()
	# After `_update_contract_panel`, which is what DETECTS a payout: this
	# only advances what that started, so a burst is visible on the same
	# frame it fires rather than one frame later.
	_update_payout_feedback()
	if not _pause_open:
		_update_ghost()
	_update_hover_tooltip()
	if _view_mode == ViewMode.ISOMETRIC:
		_pan_camera(delta)
	else:
		_fp_camera_move(delta)


## One frame's worth of simulation, and the autosave clock that runs beside
## it. Split out of `_process` so a headless test can drive exactly this
## without a viewport — everything else `_process` does needs one.
##
## **PAUSED means no ticks and no accumulation.** Clearing `_tick_accum`
## while the panel is up (and again on the way out, in `_set_pause_open`) is
## what makes a resume cost the factory nothing: MAX_TICKS_PER_FRAME caps how
## much a single frame can catch up, but an accumulator that kept filling for
## a five-minute pause would still be paid back over the frames after it.
func _advance_simulation(delta: float) -> void:
	if _pause_open:
		_tick_accum = 0.0
		return
	_tick_accum += delta
	_advance_autosave(delta)
	var tick_interval := 1.0 / TICK_HZ
	var budget := MAX_TICKS_PER_FRAME
	while _tick_accum >= tick_interval and budget > 0:
		_tick_accum -= tick_interval
		budget -= 1
		sim.tick()
		_apply_dirty_chunks()
	if _tick_accum >= tick_interval:
		# Backlog beyond the budget is discarded, not carried (see
		# MAX_TICKS_PER_FRAME): carrying it would only move the burst to the
		# next frame.
		_tick_accum = 0.0
	# The belt surface follows the tick, so it is advanced here and nowhere
	# else: the paused early-return above never reaches this line, which is
	# what freezes the rubber with the pause menu up.
	_update_belt_frame()


## Real seconds since the last autosave, and the write when it comes due.
## Only called while unpaused, so a game left sitting on the pause menu
## overnight does not autosave a state nothing has changed.
func _advance_autosave(delta: float) -> void:
	_autosave_accum += delta
	if _autosave_accum < AUTOSAVE_INTERVAL_SECONDS:
		return
	_autosave_accum = 0.0
	_autosave("timer")


func _unhandled_input(event: InputEvent) -> void:
	# WITH THE PAUSE MENU UP, ESC is the only key the world still listens to.
	# The game is stopped, so every other control — placing, rotating,
	# removing, filling, panning, even TAB — would be acting on a factory the
	# player cannot see running. The panel's own buttons are Control nodes and
	# get their input before this handler ever sees it.
	if _pause_open:
		if event is InputEventKey and event.pressed and not event.echo \
				and event.keycode == KEY_ESCAPE:
			_set_pause_open(false)
		return

	# TAB always toggles view mode, in either mode.
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_TAB:
		_set_view_mode(ViewMode.FIRST_PERSON if _view_mode == ViewMode.ISOMETRIC else ViewMode.ISOMETRIC)
		return

	if event is InputEventMouseButton:
		# The left button is the build click (the "Real Placement" epic's
		# ticket 2) — the button this handler had deliberately left unbound
		# "so a future click-to-build has nothing to fight with". It does
		# nothing outside build mode, so nothing that used to work changed.
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed \
				and not _shop_open and not _market_open:
			if _in_build_mode():
				_confirm_build()
			else:
				# ...and OUTSIDE build mode the same button now configures
				# a building (the click-to-configure ticket). The build click
				# wins where both could apply, because a ghost following the
				# cursor is an unmistakable statement about what a click is
				# for; a click that placed a belt AND opened a panel would be
				# two answers to one gesture.
				_config_click()
			return
		# Right-drag panning (isometric only) — right button, not left, which
		# is what left that button free for the click above.
		if event.button_index == MOUSE_BUTTON_RIGHT and _view_mode == ViewMode.ISOMETRIC:
			_iso_dragging = event.pressed
			return
		if event.pressed and _view_mode == ViewMode.ISOMETRIC:
			if event.button_index == MOUSE_BUTTON_WHEEL_UP:
				_zoom_camera(1.0 - ZOOM_STEP)
			elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				_zoom_camera(1.0 + ZOOM_STEP)
		return

	# A real mouse's wheel arrives as InputEventMouseButton (above). A macOS
	# trackpad's two-finger scroll does NOT — it arrives as a continuous
	# InputEventPanGesture instead, which is why scroll-to-zoom didn't work
	# on trackpads until this was added. Scale by the gesture's own delta
	# magnitude (it's continuous, not discrete notches like a wheel click),
	# not a fixed step, so a fast swipe zooms faster than a slow one.
	if event is InputEventPanGesture:
		if _view_mode == ViewMode.ISOMETRIC and event.delta.y != 0.0:
			_zoom_camera(1.0 + event.delta.y * TRACKPAD_ZOOM_SENSITIVITY)
		return

	if event is InputEventMouseMotion:
		if _view_mode == ViewMode.ISOMETRIC:
			if _iso_dragging:
				_apply_drag_pan(event.relative)
		elif not _shop_open and not _market_open:
			# With either shop panel up in first-person the mouse is visible
			# and is being used to click slots — swinging the camera with it
			# too would make the panel unusable.
			_apply_look(event.relative)
		return

	if not (event is InputEventKey and event.pressed and not event.echo):
		return

	# E opens and closes the build menu — Factorio's own inventory key, which
	# is what a player arriving from that genre will reach for first. It used
	# to be **B**, and B is deliberately NOT kept as an alias: two keys for
	# one panel means the legend can only print one of them, and the one it
	# does not print becomes an undiscoverable duplicate that the next rebind
	# has to remember about. One key, printed in ISO_HELP_TEXT/FP_HELP_TEXT.
	#
	# Handled in BOTH view modes, like V and unlike SPACE: it collides with
	# nothing in either, and buying equipment is not something the player
	# should have to leave first-person to do.
	if event.keycode == KEY_E:
		# Opening the menu leaves build mode: the menu is where you pick what
		# to place, so arriving there with a ghost still following the cursor
		# would leave two answers to "what does a click do".
		if not _shop_open:
			_exit_build_mode()
			# And the two shop panels are mutually exclusive, for the same
			# reason: one modal screen at a time, so ESC and a second press
			# of either key always leave the player somewhere definite.
			_set_market_open(false)
		_toggle_shop_menu()
		return

	# M opens the INGREDIENT MARKET — the stock half of the shop, where raw
	# tomatoes, sugar and vinegar are bought. Its own key rather than a
	# section of the build menu because that menu is already as tall as the
	# space above the hotbar allows; see `_market_panel`'s doc. Handled in
	# both view modes, like E, and for E's reason.
	if event.keycode == KEY_M:
		if not _market_open:
			_exit_build_mode()
			_set_shop_menu_open(false)
		_toggle_market()
		return

	# **Q IS GONE** (the click-to-configure ticket). It cycled a hopper's
	# contents — the ghost's while placing, and the hopper under the cursor
	# otherwise — and both halves are now the configuration panel's item
	# picker: a hopper is placed holding the first raw ingredient and is
	# retargeted by clicking it. The keycode is deliberately left unbound
	# rather than repurposed, so a player still pressing it gets nothing
	# rather than something surprising.

	# ESC closes whatever is open — and when nothing IS open, opens the pause
	# menu (the save/main-menu epic's ticket 2). One rule, escalating:
	# ESC backs out of the thing you are in, and when you are in nothing, it
	# backs out of the game. That is Minecraft's convention and it needed no
	# new key, which matters on a legend that already runs the window's
	# width.
	#
	# The configuration panel is checked FIRST and returns on its own: it is
	# the innermost thing on screen, and "close what I am looking at" has to
	# mean the panel by the building rather than also putting down whatever
	# is in the player's hand or falling through all the way to the pause
	# menu. Nothing else can be open at the same time as it (see
	# `_update_config_panel`), so this is one branch rather than an ordering
	# to remember.
	if event.keycode == KEY_ESCAPE:
		if _config_open:
			_close_config_panel()
			return
		if _anything_open():
			_close_all_overlays()
		else:
			_set_pause_open(true)
		return

	# R turns things: the ghost's facing while placing, and — outside
	# placement mode — whatever is under the cursor, in place. Both are the
	# same quarter turn clockwise the simulation offers.
	if event.keycode == KEY_R:
		if _build_kind != "":
			_rotate_ghost()
		else:
			_rotate_under_cursor()
		return

	# X toggles remove mode — see `_toggle_remove_mode` for why a mode rather
	# than a modifier-click.
	if event.keycode == KEY_X:
		_toggle_remove_mode()
		return

	# THE NUMBER KEYS ARE THE HOTBAR (the inventory-hotbar ticket). 1..9 then
	# 0 select the slot they label — always, with the build menu open or
	# closed, in either view mode. That is the behaviour change this ticket
	# makes: until now they only acted while the menu was up, and this
	# handler's own comment reserved them "for whatever a later epic wants a
	# hotbar to do".
	#
	# Selecting enters placement mode for that kind, and pressing the
	# selected slot's key again leaves it, mirroring ESC. SHIFT+number is
	# BUYING, and — deliberately — only while the build menu is open, because
	# that is the only screen where the price and the balance the purchase
	# spends are both in front of the player. A key that spends money with no
	# prices on screen is exactly the accident this split exists to prevent.
	var hotbar_index := _hotbar_index_for_keycode(event.keycode)
	if hotbar_index >= 0:
		if event.shift_pressed:
			if _shop_open:
				_buy_slot(hotbar_index)
			return
		_select_hotbar_slot(hotbar_index)
		return

	if _view_mode == ViewMode.ISOMETRIC:
		if event.keycode == KEY_EQUAL or event.keycode == KEY_KP_ADD:
			_zoom_camera(1.0 - ZOOM_STEP)
			return
		if event.keycode == KEY_MINUS or event.keycode == KEY_KP_SUBTRACT:
			_zoom_camera(1.0 + ZOOM_STEP)
			return

	# **SPACE AND V ARE GONE TOO** (the click-to-configure ticket). SPACE
	# filled every hopper in the world and V every tank, from anywhere, with
	# no building selected — the two keys this whole panel replaces. FILL is
	# a button on the building's own panel now, aimed at the one bin the
	# player is looking at, and "keep it full" is the toggle beside it.
	#
	# SPACE keeps its OTHER meaning untouched: in FIRST_PERSON it is "fly up"
	# (`_fp_input_direction` reads it directly through `Input`, not through
	# this handler), which is exactly why the fill binding was isometric-only
	# in the first place.


func _apply_dirty_chunks() -> void:
	var dirty: PackedInt64Array = sim.dirty_chunk_ids()
	for chunk_id in dirty:
		var parsed = JSON.parse_string(sim.chunk_snapshot_json(chunk_id))
		if parsed != null:
			_render_snapshot(parsed)


func _render_snapshot(snapshot: Dictionary) -> void:
	var belts: Array = snapshot.get("belts", [])
	for belt in belts:
		_render_carried_items(belt, "belt")

	# A splitter carries its contents in an ordinary one-tile belt segment
	# (`sim_core/src/sim/splitter.rs`), and `SplitterSnapshot` is
	# `BeltSnapshot` plus the two facts only a splitter has — so the items on
	# one are drawn by the same function, from the same `items` field, at the
	# same running height. That is not a shortcut: an item takes exactly as
	# long to cross a splitter as to cross the belt tile it replaced, and it
	# should look like it.
	var splitters: Array = snapshot.get("splitters", [])
	for splitter in splitters:
		var tile := _pair_to_tile(splitter.get("tile"))
		_render_carried_items(splitter, "splitter")
		_apply_splitter_state(_tile_key(tile), splitter)

	var machines: Array = snapshot.get("machines", [])
	for machine in machines:
		# Keyed by ORIGIN TILE, not by recipe: the player may place several
		# machines running the same recipe, and a recipe-keyed entry would
		# collapse them into one that flickered between them.
		var key := _tile_key(_pair_to_tile(machine.get("tile")))
		_machine_states[key] = machine
		_set_machine_running(key, machine.get("process") != null)


## Stands one item on every slot of a conveyor tile — a belt or a
## splitter, whose `tile`/`direction`/`items` fields are identical on the
## wire. `prefix` keeps the two kinds' slot keys apart so a splitter
## replacing a belt on the same tile cannot inherit its items.
##
## Each item is an instance in the pool for its asset (see
## `_show_carried_item`), positioned by `_carried_item_transform` — the one
## function that knows where an item at `distance` along a tile stands.
##
## **Emptied slots are hidden per TILE, not per pass, and that is a fix
## rather than a style.** This used to collect every key it had drawn into
## one `seen` set and then hide every pooled node missing from it — but
## `_render_snapshot` runs once per DIRTY CHUNK, so with two chunks dirty the
## second pass hid everything the first had just drawn. It went unnoticed
## while every factory fitted in one chunk and was caught the moment a
## splitter branched a line across a chunk boundary: the branch belt held
## eight tomatoes in the simulation and rendered empty. A tile knows exactly
## how many items it has, so the slots past that are the ones to hide, and no
## other tile's slots are any of this tile's business.
func _render_carried_items(carrier: Dictionary, prefix: String) -> void:
	var tile := _pair_to_tile(carrier.get("tile"))
	var direction := String(carrier.get("direction", "east"))
	var items: Array = carrier.get("items", [])
	for i in range(items.size()):
		var pair: Array = items[i]
		var key := "%s_%d_%d_%d" % [prefix, tile.x, tile.y, i]
		var asset: String = ITEM_MODELS.get(String(pair[0]), ITEM_MODEL_FALLBACK)
		_show_carried_item(key, asset, _carried_item_transform(tile, direction, float(pair[1])))
	# Slots this tile used to fill and no longer does. Slot keys are handed
	# out from 0 upward and a hidden one is forgotten, so the first gap is
	# the end.
	var spare := items.size()
	while _hide_carried_item("%s_%d_%d_%d" % [prefix, tile.x, tile.y, spare]):
		spare += 1


## Where an item `distance` (0..1, the simulation's own figure) of the way
## across `tile` stands, travelling toward `direction`.
##
## `distance` is measured from the tile's START — its input edge — to its
## END, its output edge (`sim::world::BeltSnapshot`), so an item at 0 is
## drawn on the midpoint of the face it entered through and an item at 1 on
## the midpoint of the face it leaves through. **Until this ticket the
## straight run was drawn from the tile's CENTRE to the next tile's centre**,
## half a tile downstream of where the simulation had it: an item metered
## by a hopper appeared mid-belt rather than at the hopper's mouth, and one
## handed to a machine vanished at the machine's centre rather than at its
## face. It was self-consistent (every tile shared the offset) and invisible
## on a straight line, and it cannot coexist with a corner, whose arc has to
## start and end on the tile's faces to meet its neighbours' runs.
##
## A CORNER's items follow a quarter circle about the pivot corner — the
## tile corner shared by the input face and the output face — with radius
## half a tile, from the input face's midpoint to the output face's (the
## plan's "Corner conventions"). That is the same curve the corner model's
## lane is built on (`assets.rs`'s `belt_corner`), so items stay on the
## rubber; the arc is parameterised by the same `distance`, so nothing in
## the simulation knows or cares that the tile bends. Which flank the input
## face is on comes from the tile's recorded shape (`_belt_shapes`): a
## left corner is fed from the anticlockwise side of its facing, a right
## corner from the clockwise side. A splitter, or a belt whose shape is not
## a corner, is a straight run. The basis is identity — items are never
## spun with the belt.
func _carried_item_transform(tile: Vector2i, direction: String, distance: float) -> Transform3D:
	var centre := Vector3(float(tile.x) * TILE, BELT_SURFACE_Y, float(tile.y) * TILE)
	var out := _direction_world(direction)
	var shape := String(_belt_shapes.get(_tile_key(tile), BELT_SHAPE_STRAIGHT))
	if shape == BELT_SHAPE_CORNER_LEFT or shape == BELT_SHAPE_CORNER_RIGHT:
		var in_from := _direction_world(
			_direction_ccw(direction) if shape == BELT_SHAPE_CORNER_LEFT else _direction_cw(direction)
		)
		var radius := TILE * 0.5
		var pivot := centre + (out + in_from) * radius
		var angle := clampf(distance, 0.0, 1.0) * PI * 0.5
		return Transform3D(Basis(), pivot - out * (radius * cos(angle)) - in_from * (radius * sin(angle)))
	return Transform3D(Basis(), centre + out * ((distance - 0.5) * TILE))


## A simulation direction as a unit vector on the world's ground plane:
## sim +X is world +X and sim +Y is world +Z (`_footprint_centre`'s
## mapping), so this is `DIRECTION_OFFSETS` lifted into 3D.
func _direction_world(direction: String) -> Vector3:
	var offset := _direction_offset(direction)
	return Vector3(float(offset.x), 0.0, float(offset.y))


## Sentinel returned by `_tile_under_screen_pos` when the camera ray never
## crosses the belt-surface plane in front of the camera — either it's
## (degenerately) parallel to it (not reachable in practice for the fixed
## isometric CAMERA_DIRECTION, but a real case once FIRST_PERSON's free-look
## camera can point the ray dead level), or it points away from the plane
## entirely (FIRST_PERSON looking up at the sky — the plane is still
## "behind" the ray in that case, so the naive intersection point would be
## a phantom tile no player could see). Callers get an explicit "no tile"
## value rather than a Vector2i(0, 0) that could also be a real tile.
const HOVER_NO_TILE := Vector2i(-999999, -999999)
## Screen-space offset from the raw cursor position to the tooltip panel's
## top-left corner, so the panel doesn't sit directly under (and get
## re-hidden by chasing) the cursor itself.
const HOVER_TOOLTIP_OFFSET := Vector2(18.0, 18.0) * UI_SCALE


## Resolves a screen-space position to the world tile beneath it: casts the
## camera's ray for that screen position (per its CURRENT transform/
## projection — `project_ray_origin`/`project_ray_normal` are pure and
## deterministic given that, not physics-engine-dependent) and intersects it
## with the horizontal plane at belt-surface height (BELT_SURFACE_Y).
## Machines sit directly on that plane at a known tile position (see
## _machine_tiles), so plane intersection alone is enough to pick one out —
## no physics engine involved, matching this project's zero physics
## dependency elsewhere (ARCHITECTURE.md's headless-testability philosophy).
##
## Pure and deterministic given the camera's current state — no Input/mouse
## reads happen here, so test_hover.gd can call it directly with an explicit
## screen position. This mirrors _apply_pan/_apply_look's split (see their
## doc comments): _update_hover_tooltip below is the thin, untested part that
## actually reads the live mouse position (ISOMETRIC) or the screen centre
## (FIRST_PERSON, where the crosshair sits — see _build_crosshair).
##
## Works for either camera projection — orthogonal (ISOMETRIC) or
## perspective (FIRST_PERSON) — since project_ray_origin/project_ray_normal
## already account for that. FIRST_PERSON's free-look does introduce a case
## ISOMETRIC's fixed downward angle never hits: the ray pointing away from
## the plane entirely (looking up at the sky), where a naive intersection
## would land "behind" the camera. `t < 0` catches that.
func _tile_under_screen_pos(screen_pos: Vector2) -> Vector2i:
	if _camera == null:
		return HOVER_NO_TILE
	var origin := _camera.project_ray_origin(screen_pos)
	var dir := _camera.project_ray_normal(screen_pos)
	if is_zero_approx(dir.y):
		return HOVER_NO_TILE
	var t := (BELT_SURFACE_Y - origin.y) / dir.y
	if t < 0.0:
		return HOVER_NO_TILE
	var point := origin + dir * t
	return Vector2i(roundi(point.x / TILE), roundi(point.z / TILE))


## What the tooltip should say about whatever occupies `tile` — a machine, a
## belt, a pipe, a hopper, a tank, a dock, or nothing ("", the sentinel
## `_update_hover_tooltip` checks to decide whether to show the tooltip at
## all).
##
## This used to be a chain of "is it the machine? is it THE hopper? is it THE
## tank?" tests against one remembered building each. It is now one lookup in
## `_occupancy` followed by a branch on the placement's own `kind`, which is
## what makes hover work unchanged when the player builds a second hopper, a
## third dock, or a machine facing south: which placement the cursor is over
## is answered by the same footprint-aware map the ghost's validity check
## uses, and disambiguating two hoppers falls straight out of it.
##
## Pure given the polled snapshots, so a test can drive it with a tile.
func _hover_text_at_tile(tile: Vector2i) -> String:
	var placement := _placement_at_tile(tile)
	if placement.is_empty():
		return ""
	var kind := String(placement.get("kind", ""))
	var key := _tile_key(_placement_origin(placement))
	var direction := _placement_direction(placement)
	match kind:
		BELT_KIND:
			return _belt_hover_text(placement, direction)
		SPLITTER_KIND:
			return _splitter_hover_text(key, direction)
		PIPE_KIND:
			return _pipe_hover_text(tile, direction)
		HOPPER_KIND:
			return _hopper_hover_text(key, direction)
		FLUID_TANK_KIND:
			return _fluid_tank_hover_text(key, direction)
		DOCK_KIND:
			return _dock_hover_text(key, direction)
	return _machine_hover_text(key, kind, direction)


## What one belt's tooltip says, from its `links`: which way it carries and
## whether it turns, what feeds it and from which side, and what it hands to
## — in words, because "a belt that draws as a corner but whose arrow says
## north" is a question the player should be able to put to the tile itself.
## `not connected` is spelled out where the simulation reports `null`, and a
## feed from nothing is said rather than left blank: an unfed line start is
## the single most common reason nothing is moving.
func _belt_hover_text(placement: Dictionary, direction: String) -> String:
	var tile := _placement_origin(placement)
	var links: Dictionary = placement.get("links", {})
	var shape := _belt_shape_for(links, direction)
	var heading := "belt  ·  carries %s" % direction
	match shape:
		BELT_SHAPE_CORNER_LEFT:
			heading += "  ·  turns left"
		BELT_SHAPE_CORNER_RIGHT:
			heading += "  ·  turns right"
		BELT_SHAPE_MERGE:
			heading += "  ·  merge"
	var inputs: Array = links.get("inputs", [])
	var fed := "fed by nothing"
	if not inputs.is_empty():
		var sides: Array = []
		for input in inputs:
			var from := String(input.get("from", ""))
			var kind := String(input.get("kind", ""))
			var side := "the %s" % from
			if kind != BELT_KIND and kind != SPLITTER_KIND:
				side += " (%s)" % _link_neighbour_name(tile, from, kind)
			sides.append(side)
		fed = "fed from %s" % " and ".join(PackedStringArray(sides))
	var output = links.get("output")
	var hands := "not connected"
	if output != null:
		var to := String(output.get("to", ""))
		var kind := String(output.get("kind", ""))
		if kind == BELT_KIND:
			hands = "hands %s to the next belt" % to
		elif kind == SPLITTER_KIND:
			hands = "hands %s to a splitter" % to
		else:
			hands = "hands to %s" % _link_neighbour_name(tile, to, kind)
	return "%s\n%s\n%s" % [heading, fed, hands]


## The display name of whatever stands on the far side of `tile`'s `side`
## — "Crusher", "Hopper", "Dock" — from the placement actually there, since
## a link only says `machine`; falls back to the link's own kind word if the
## layout and the links ever disagree.
func _link_neighbour_name(tile: Vector2i, side: String, link_kind: String) -> String:
	var neighbour := _placement_at_tile(tile + _direction_offset(side))
	if neighbour.is_empty():
		return _kind_display_name(link_kind)
	return _kind_display_name(String(neighbour.get("kind", link_kind)))


## What one splitter's tooltip says. Three lines, because a splitter has
## exactly three facts and one of them is the reason it exists: where each
## output goes, and which one takes the next item.
##
## Both outputs are named even when one is `null`, and an unbuilt one is
## called out in words rather than left off — "branch: not connected" is the
## answer to "why is everything going straight", which is the single most
## likely question a player has about a splitter they just placed. The NEXT
## line reports the side the item will actually reach (see
## `_apply_splitter_state` for why that is not always `next_output`) and says
## so when the due side is being passed over.
func _splitter_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _splitter_states.get(origin_key, {})
	if snapshot.is_empty():
		return "splitter\nfacing %s" % direction
	var outputs: Array = snapshot.get("outputs", [null, null])
	var side := _splitter_effective_side(snapshot)
	var due := SPLITTER_BRANCH if String(snapshot.get("next_output", "straight")) == "branch" else SPLITTER_STRAIGHT
	var next_line := "next: nowhere — neither output is connected"
	if side >= 0:
		next_line = "next: %s" % ("branch" if side == SPLITTER_BRANCH else "straight")
		if side != due:
			next_line += " (%s not connected)" % ("branch" if due == SPLITTER_BRANCH else "straight")
	return "splitter  ·  facing %s\n%s\nstraight: %s\nbranch: %s" % [
		direction,
		next_line,
		_splitter_output_text(outputs, SPLITTER_STRAIGHT),
		_splitter_output_text(outputs, SPLITTER_BRANCH),
	]


## One output's tile, or "not connected" — the state `outputs[i] == null`
## means, which is "nothing that can accept an item stands there".
func _splitter_output_text(outputs: Array, side: int) -> String:
	if side >= outputs.size() or outputs[side] == null:
		return "not connected"
	var tile := _pair_to_tile(outputs[side])
	return "%d, %d" % [tile.x, tile.y]


## The recipe/progress/input/output text for one machine, keyed by its origin
## tile. Now also prints which way it faces, because that is a decision the
## player made and can change (**R**) and it decides which side takes product
## and which side gives it back — the one fact about a machine that used to be
## the same for every machine in the world and now is not.
## Pure given `_machine_states`/`sim.current_tick()` — no Input reads.
func _machine_hover_text(origin_key: String, kind: String, direction: String) -> String:
	if not _machine_states.has(origin_key):
		return "%s\nfacing %s" % [_kind_display_name(kind), direction]
	var machine: Dictionary = _machine_states[origin_key]
	var process = machine.get("process")
	var progress_text := "idle"
	if process != null:
		var required: int = int(process[1])
		var elapsed: int = clampi(sim.current_tick() - int(process[0]), 0, required)
		var pct: float = (float(elapsed) / float(required)) * 100.0 if required > 0 else 100.0
		# The percentage ALONE is not enough once a process runs longer than
		# a glance. A 60-tick crush is over before a player finishes reading
		# it, so "40%" is all it can usefully say; the vat's 240-tick cook is
		# four real seconds, and "40%" of a number the player has never been
		# told is not an answer to the question they are actually asking,
		# which is "how long until this is done". So the remaining time is
		# spelled out beside it, in seconds — the unit the player
		# experiences — rather than in ticks, which are an implementation
		# detail of ARCHITECTURE.md §3.9's fixed timestep.
		progress_text = "%.0f%%  ·  %s left" % [pct, _format_remaining(required - elapsed)]
	return "%s  ·  facing %s\n%s\nin: %s\nout: %s" % [
		String(machine.get("recipe", kind)),
		direction,
		progress_text,
		_format_counts(machine.get("input", [])),
		_format_counts(machine.get("output", [])),
	]


## A tick count as the wall-clock time it will take, at the rate this scene
## actually advances the simulation (`TICK_HZ`) — deliberately not at
## ARCHITECTURE.md §3.9's nominal 60/sec, because what the player is asking
## is "how long do I wait", and they wait at the rate the game runs. If
## TICK_HZ ever changes, every number this prints follows it, which is the
## point of reading the constant rather than typing a rate in twice.
## Minutes appear only once there is a minute to show, so the chain's short
## stages still read as plain seconds. Pure, so a test can drive it directly.
func _format_remaining(ticks: int) -> String:
	var seconds: int = int(ceil(float(maxi(ticks, 0)) / TICK_HZ))
	if seconds < 60:
		return "%ds" % seconds
	return "%dm %02ds" % [seconds / 60, seconds % 60]


## Which (network, segment) pair sits on `tile`, or `Vector2i(-1, -1)`.
## Populated in `_rebuild_world` from the fluid snapshots, since which network
## a pipe tile belongs to is a property of the whole connected run.
func _pipe_indices_at_tile(tile: Vector2i) -> Vector2i:
	return _pipe_tiles.get(_tile_key(tile), Vector2i(-1, -1))


## What a pipe tile's tooltip says: what it is joined to, in words, then
## the live level. Reads the placement's own `links` for the connections
## and the live snapshot array for the level: a world has one network per
## connected run of pipe, and the player can split or join them by placing
## and removing a single tile.
##
## The connections line names the pipe sides ("connects west and north"),
## then every machine or tank by its kind, as "fed by" or "feeds": a tank
## always feeds the pipe, and a machine feeds it when this segment is one
## the machine DEPOSITS into (`producers`) and is fed by it when the
## machine draws from it (`taps`). Which machine is a neighbour lookup on
## the side the link names — the wire says "machine, north", the placement
## standing north says which machine.
func _pipe_hover_text(tile: Vector2i, direction: String) -> String:
	var placement := _placement_at_tile(tile)
	var indices := _pipe_indices_at_tile(tile)
	var network: Dictionary = {}
	var segment: Dictionary = {}
	if indices.x >= 0 and indices.x < _last_fluid.size():
		network = _last_fluid[indices.x]
		var segments: Array = network.get("segments", [])
		if indices.y >= 0 and indices.y < segments.size():
			segment = segments[indices.y]
	var lines: Array = ["pipe"]
	lines.append(_pipe_connections_text(tile, _pipe_connections_of(placement), network, indices.y, direction))
	if not segment.is_empty():
		lines.append("%s  ·  %.1f / %.1f units  ·  pressure %.0f%%" % [
			_fluid_id_of(network) if _fluid_id_of(network) != "" else "empty run",
			float(segment.get("volume", 0.0)),
			float(segment.get("capacity", 0.0)),
			clampf(float(segment.get("pressure", 0.0)), 0.0, 1.0) * 100.0,
		])
	return "\n".join(PackedStringArray(lines))


## The connections sentence of `_pipe_hover_text`, split out so a test can
## read it against a known layout. Parts are joined with " · ".
func _pipe_connections_text(tile: Vector2i, connections: Array, network: Dictionary,
		segment_index: int, direction: String) -> String:
	var pipe_sides: Array = []
	var parts: Array = []
	for connection in connections:
		if not (connection is Dictionary):
			continue
		var kind := String(connection.get("kind", ""))
		var to := String(connection.get("to", ""))
		if kind == PIPE_LINK_PIPE:
			pipe_sides.append(to)
			continue
		var neighbour := _placement_at_tile(tile + _direction_offset(to))
		var name := _kind_display_name(String(neighbour.get("kind", kind)))
		if kind == PIPE_LINK_TANK:
			parts.append("fed by %s" % name)
		elif kind == PIPE_LINK_MACHINE:
			var produced := false
			for producer in network.get("producers", []):
				if int(producer.get("segment_index", -1)) == segment_index:
					produced = true
			parts.append(("fed by %s" if produced else "feeds %s") % name)
	if pipe_sides.is_empty():
		parts.push_front("no pipe joined  ·  lies %s" % ("north-south" if direction == "north" or direction == "south" else "east-west"))
	elif pipe_sides.size() == 1:
		parts.push_front("connects %s" % pipe_sides[0])
	else:
		parts.push_front("connects %s and %s" % [
			", ".join(PackedStringArray(pipe_sides.slice(0, pipe_sides.size() - 1))),
			pipe_sides[pipe_sides.size() - 1],
		])
	return "  ·  ".join(PackedStringArray(parts))


## What one hopper's tooltip says: what it holds, how full it is, and — new
## since placement — whether it is actually discharging onto anything. A
## hopper facing bare ground reports `belt_tile: null`, which is an ordinary
## state now and exactly the mistake a player wants told about.
##
## Two lines changed with the click-to-configure ticket, and both are about
## the same thing. The old "Q: change contents" hint is gone with the key,
## replaced by **click to configure** — which is not merely the new name for
## the old key: the panel it opens carries loading, keeping-loaded and
## retargeting, so one line advertises all three where three keybinds
## advertised none of them on the building itself. And `auto_fill` is
## reported here as well as in the panel, because whether a bin looks after
## itself is exactly the thing a player wants to check by pointing at it
## rather than by opening something.
func _hopper_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _hopper_states.get(origin_key, {})
	if snapshot.is_empty():
		return "hopper\nfacing %s" % direction
	return "hopper  ·  facing %s\n%s\n%d / %d units\n%s\nauto-fill: %s\nclick to configure" % [
		direction,
		String(snapshot.get("item", "raw ingredient")),
		int(snapshot.get("quantity", 0)),
		int(snapshot.get("capacity", 0)),
		"unloading onto a belt" if snapshot.get("belt_tile") != null else "no belt in front of it",
		"on" if bool(snapshot.get("auto_fill", false)) else "off",
	]


## The tank's tooltip — the hopper's shape, with the one difference the wire
## format already has (a fluid volume is fractional, an item count is not).
func _fluid_tank_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _fluid_tank_states.get(origin_key, {})
	if snapshot.is_empty():
		return "fluid tank\nfacing %s" % direction
	return "fluid tank  ·  facing %s\n%s\n%.1f / %.0f units\n%s\nauto-fill: %s\nclick to configure" % [
		direction,
		_fluid_id_of(snapshot) if _fluid_id_of(snapshot) != "" else "empty",
		float(snapshot.get("quantity", 0.0)),
		float(snapshot.get("capacity", 0.0)),
		"feeding a pipe run" if snapshot.get("pipe_tile") != null else "no pipe in front of it",
		"on" if bool(snapshot.get("auto_fill", false)) else "off",
	]


## The dock's tooltip. The one building on the line with no recipe and no
## process, so the machine tooltip's shape has nothing to put in three of its
## four lines — and the obvious substitute, its own buffer level, is always
## zero by design (see DOCK_ASSET's doc). So it answers the two questions a
## dock can actually answer: what THIS dock has shipped over its life, and
## what is standing on the shared pool waiting for a contract to claim it —
## the same figure the clipboard prints as ON THE DOCK, deliberately, rather
## than a second number the player would have to reconcile with it.
func _dock_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _dock_states.get(origin_key, {})
	if snapshot.is_empty():
		return "delivery dock\nfacing %s" % direction
	return "delivery dock  ·  facing %s\nships to contracts every tick\n%d shipped by this dock\nwaiting: %s" % [
		direction,
		int(snapshot.get("shipped_total", 0)),
		_format_counts(_last_dock_stock),
	]


## The thin, live-state-reading half (deliberately not unit tested, same
## reasoning as _pan_input_direction/_fp_input_direction's doc comments —
## headless SceneTree tests can't reliably simulate live viewport mouse
## state): picks which screen point to query — the live cursor in ISOMETRIC,
## the screen centre (where _crosshair is drawn) in FIRST_PERSON, since the
## mouse is captured there and has no meaningful on-screen position — and
## drives the pure functions above to decide what the tooltip should show.
func _update_hover_tooltip() -> void:
	if _hover_tooltip == null:
		return
	if _shop_open or _market_open or _pause_open or _config_open or _in_build_mode():
		# The build menu sits over the middle of the screen; a world tooltip
		# chasing the cursor across it would just be two panels fighting. And
		# in build mode the placement prompt is already the panel by the
		# cursor, saying the more useful of the two things. The pause menu is
		# the same case as the build menu, one plate further forward. The
		# configuration panel is the same case again: it is the panel BY THE
		# BUILDING, and it says everything the hover line points at.
		_hover_tooltip.visible = false
		return
	var vp := get_viewport()
	if vp == null:
		_hover_tooltip.visible = false
		return
	var query_pos: Vector2
	if _view_mode == ViewMode.FIRST_PERSON:
		query_pos = vp.get_visible_rect().size / 2.0
	else:
		query_pos = vp.get_mouse_position()
	var tile := _tile_under_screen_pos(query_pos)
	var text := _hover_text_at_tile(tile)
	if text == "":
		_hover_tooltip.visible = false
		return
	_hover_label.text = text
	_hover_tooltip.position = _panel_position_near(_hover_tooltip, query_pos)
	_hover_tooltip.visible = true


## Where a cursor-following panel goes: offset from the cursor, then kept
## inside the viewport.
##
## The clamp is new with build mode and is not cosmetic — the placement prompt
## is three lines wide and the cursor spends most of its time near the right
## of the screen while a factory is being extended eastward, so without it the
## panel telling the player whether the click will work runs off the edge.
## (Found the only way it could be: in a rendered frame — UI_UX.md §2b
## point 12.) It flips to the other side of the cursor rather than sliding, so
## the panel never sits on top of the tile it is describing.
func _panel_position_near(panel: Control, anchor: Vector2) -> Vector2:
	var size := panel.get_combined_minimum_size()
	var vp := get_viewport()
	var bounds := vp.get_visible_rect().size if vp != null else Vector2(1600, 900)
	var pos := anchor + HOVER_TOOLTIP_OFFSET
	if pos.x + size.x > bounds.x:
		pos.x = anchor.x - HOVER_TOOLTIP_OFFSET.x - size.x
	if pos.y + size.y > bounds.y:
		pos.y = anchor.y - HOVER_TOOLTIP_OFFSET.y - size.y
	return Vector2(maxf(pos.x, 0.0), maxf(pos.y, 0.0))


## Drives the contract clipboard (UI_UX.md §5) from `economy_snapshot_json`:
## the one shared money figure, the one shared dock pool, and then EVERY
## active contract's own docket — its checklist boxes, its numeric progress
## and its own countdown to its own next delivery check.
func _update_contract_panel() -> void:
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_contract_money_label.text = "Money: %.0f" % float(econ["money"])
	_update_contract_dock(econ.get("delivery_stock", []))

	var contracts: Array = econ.get("contracts", [])
	if not _contract_cards_match(contracts):
		_rebuild_contract_cards(contracts)

	var current_tick: int = sim.current_tick()
	for i in range(min(contracts.size(), _contract_cards.size())):
		_update_contract_card(_contract_cards[i], contracts[i], current_tick)

	# The two moments money is involved in, detected from the snapshot this
	# function already had to parse (see the payout-feedback section's header
	# for why a `deliveries_made` delta is the right signal and a `money`
	# delta is not). Both are detected HERE rather than inside
	# `_update_dock_stock`, which stays a pure function of its arguments so a
	# test can keep driving it directly.
	_detect_dock_arrivals(econ.get("delivery_stock", []), current_tick)
	_detect_payouts(contracts, current_tick)

	# Cap the docket stack's height rather than letting it grow off the
	# bottom of the screen: past the cap it scrolls. `data/contracts.ron`
	# ships three and at a normal window size this never engages, which is
	# the intent — a handful of concurrent orders is the realistic board
	# (GAMEPLAY.md §6 names no count), so it is a safety valve for a content
	# change rather than a compact/summary mode nobody needs yet.
	#
	# What it is capped AGAINST changed with the 2026-09-09 UI scale. It was
	# a fixed fraction of the window height, and at half again the type size
	# that let the board's bottom edge reach down across the larder strip. It
	# is now the space actually left above the hotbar, measured the same way
	# the build menu measures its own (`_fit_grid_scroll`), so the two panels
	# can never disagree about where the usable screen ends.
	#
	# A headless SceneTree run has no viewport at all, and a window that has
	# not laid out yet reports a zero rect — neither must collapse the stack
	# to nothing, so "no viewport" means "no cap", not "a cap of zero".
	var viewport := get_viewport()
	if viewport != null and viewport.get_visible_rect().size.y > 0.0:
		_fit_grid_scroll(
			_contract_cards_scroll,
			_contract_cards_box,
			viewport.get_visible_rect().size.y - _hotbar_reserved_height() - _ui_px(24.0)
		)
	else:
		_contract_cards_scroll.custom_minimum_size.y = _contract_cards_box.get_combined_minimum_size().y

	# Re-anchor every update, not just once at build time: the panel's
	# minimum size grows once real text ("Money: 1234", "Next check in 1000
	# ticks") replaces the empty labels it was built with, and PRESET_MINSIZE
	# only computes offsets once, at the moment it's called — without this,
	# the panel stays sized/positioned for its build-time (near-empty) text
	# and later, wider text spills past its right edge.
	_contract_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE, 16)


## True when the built dockets already correspond, in order, to the reported
## contracts — the cheap guard that keeps _update_contract_panel from
## rebuilding nodes every frame for a list that never changes.
func _contract_cards_match(contracts: Array) -> bool:
	if contracts.size() != _contract_card_ids.size():
		return false
	for i in range(contracts.size()):
		if String(contracts[i].get("id", "")) != String(_contract_card_ids[i]):
			return false
	return true


## The shared delivery pool, shown once above the dockets.
##
## This line is the player-visible face of sim_core's allocation rule: there
## is ONE pile of collected stock and a settling contract CONSUMES its mix
## from it, so a box is never credited to two orders. Without it, three
## dockets whose checklists all read "2/2" look like three imminent payouts
## when the dock may hold only two boxes total — the checklists are each
## clamped to their own ask (that clamping is sim_core's, deliberately), and
## this unclamped number is what reconciles them. It is one line of text
## rather than a new widget: surfacing the rule is worth it, inventing a
## second progress language for it is not.
func _update_contract_dock(stock: Array) -> void:
	var seen: Dictionary = {}
	for pair in stock:
		var item_id: String = String(pair[0])
		var qty: int = int(pair[1])
		seen[item_id] = true
		var entry: Dictionary = _contract_dock_entries.get(item_id, {})
		if entry.is_empty():
			entry = _build_contract_dock_entry(item_id)
			_contract_dock_entries[item_id] = entry
		entry["label"].text = "%d" % qty
		entry["row"].visible = true
	for item_id in _contract_dock_entries:
		if not seen.has(item_id):
			_contract_dock_entries[item_id]["row"].visible = false
	# `delivery_stock` reports non-zero entries only, so an empty array is
	# genuinely "nothing on the dock" — say so rather than showing a bare label.
	_contract_dock_empty_label.visible = stock.is_empty()


func _build_contract_dock_entry(item_id: String) -> Dictionary:
	var row := HBoxContainer.new()
	row.name = "dock_%s" % item_id
	row.add_theme_constant_override("separation", _ui_i(3))
	_contract_dock_row.add_child(row)

	var icon := TextureRect.new()
	icon.custom_minimum_size = _ui_v(Vector2(14, 14))
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	row.add_child(icon)

	var label := Label.new()
	label.label_settings = _contract_meta_settings
	row.add_child(label)
	return {"row": row, "label": label, "icon": icon}


## One docket's live state. `progress` is sim_core's per-contract, clamped
## coverage of this contract's own mix (a checklist reads 2/2, never 7/2);
## the unclamped pool it is drawn from is the dock line above.
func _update_contract_card(card: Dictionary, contract: Dictionary, current_tick: int) -> void:
	var mix: Array = contract.get("mix", [])
	var progress: Array = contract.get("progress", [])
	var rows: Dictionary = card["rows"]
	for i in range(mix.size()):
		var item_id: String = String(mix[i][0])
		var required: int = int(mix[i][1])
		var have: int = int(progress[i][1]) if i < progress.size() else 0

		var row: Dictionary = rows.get(item_id, {})
		if row.is_empty():
			continue
		row["label"].text = "%s  %d/%d" % [item_id, have, required]

		var boxes: Array = row["boxes"]
		if boxes.size() == 1 and required > CONTRACT_CHECKLIST_MAX_BOXES:
			# The single-box fallback (see _build_contract_checklist_row):
			# checked only once the whole quantity is in.
			_set_checkbox_checked(boxes[0], have >= required)
		else:
			for u in range(boxes.size()):
				_set_checkbox_checked(boxes[u], u < have)

	# Each contract clocks independently in sim_core, so this countdown is
	# this docket's, never a shared one. The tally beside it is the only
	# feedback a player gets that an order is being under-served: a missed
	# window costs that window's payout and nothing else today (GAMEPLAY.md
	# §11 has not decided what else it should cost), so the count is the
	# whole consequence and it should be visible.
	var ticks_left: int = max(0, int(contract.get("next_delivery_tick", 0)) - current_tick)
	card["meta_label"].text = "next check in %d ticks  ·  every %d  ·  %d done, %d missed" % [
		ticks_left,
		int(contract.get("cadence_ticks", 0)),
		int(contract.get("deliveries_made", 0)),
		int(contract.get("deliveries_missed", 0)),
	]


## Swaps a checklist box's style (and its tick-mark visibility) between the
## checked/unchecked StyleBoxFlat pair — same pattern as the machine status
## lamps' idle/running material swap above, applied to a UI checkbox instead
## of a 3D emissive mesh.
func _set_checkbox_checked(box: Panel, checked: bool) -> void:
	if bool(box.get_meta("checked", false)) == checked:
		return
	box.set_meta("checked", checked)
	box.add_theme_stylebox_override("panel", _checkbox_style_checked if checked else _checkbox_style_unchecked)
	var mark: Label = box.get_node_or_null("Mark")
	if mark != null:
		mark.visible = checked


## Returns a small isometric icon texture for an item id, generated offline
## from the same real voxel model the item renders as in the world
## (UI_UX.md §5 — "icons ... rendered from the real assets ... not
## separately-drawn 2D icon art"; see assets/voxels/generators/icons.rs and
## assets/voxels/README.md for how the PNG itself is produced). Resolves the
## item id to an asset name via ITEM_MODELS, same mapping `_render_carried_items`
## already uses for the item's in-world mesh, so an icon and its in-world
## model can never silently drift apart.
##
## Cached per asset name — never re-loads or re-renders on repeat calls
## (icons are static build output, not something that changes at runtime).
## An id with no icon, or one whose PNG isn't present on disk (e.g. `cargo
## xtask` was never run, or vengi wasn't installed when icons/ was last
## regenerated), still returns a real, non-null Texture2D: a plain
## placeholder swatch, never null and never a silently-broken texture.
func _icon_for(item_id: String) -> Texture2D:
	return _icon_for_asset(ITEM_MODELS.get(item_id, ITEM_MODEL_FALLBACK))


## The loading/caching/fallback half of `_icon_for`, keyed by ASSET name
## rather than item id — extracted (behaviour unchanged) when the build menu
## needed icons for *buildable kinds*, which resolve through SHOP_MODELS/
## MACHINE_MODELS instead of ITEM_MODELS. Both callers share this one cache
## and this one documented fallback; there is deliberately not a second icon
## system.
func _icon_for_asset(asset: String) -> Texture2D:
	if _icon_cache.has(asset):
		return _icon_cache[asset]

	var texture: Texture2D = null
	var path := ICON_DIR + asset + ".png"
	if ResourceLoader.exists(path):
		var loaded = load(path)
		if loaded is Texture2D:
			texture = loaded

	if texture == null:
		texture = _fallback_icon_texture()

	_icon_cache[asset] = texture
	return texture


## The documented fallback `_icon_for` returns when no real icon PNG could
## be loaded. Built once and reused — a flat, muted swatch, deliberately
## plain enough that it reads as "no icon" rather than as a broken asset.
func _fallback_icon_texture() -> Texture2D:
	if _icon_fallback_texture == null:
		var img := Image.create(8, 8, false, Image.FORMAT_RGBA8)
		img.fill(Color(0.5, 0.5, 0.5, 0.6))
		_icon_fallback_texture = ImageTexture.create_from_image(img)
	return _icon_fallback_texture


func _format_counts(pairs: Array) -> String:
	if pairs.is_empty():
		return "-"
	var parts: Array[String] = []
	for pair in pairs:
		parts.append("%s x%d" % [pair[0], int(pair[1])])
	return ", ".join(parts)


# --------------------------------------------------------------------------
# Payout feedback: what earning money looks and sounds like
# --------------------------------------------------------------------------

## Money arrives in this game through exactly ONE channel — a contract
## settling at its cadence boundary and paying out (`sim/economy.rs`) — and
## until now it arrived silently: a number on the clipboard went up between
## two frames. This section is the celebration of that moment, plus a much
## smaller cue for the frequent moment that leads to it (a finished case
## reaching the dock).
##
## # How the moment is detected, and why no sim change was needed
##
## `economy_snapshot_json` already carries per-contract `deliveries_made`
## alongside `payout`, so a payout is a RISE in that counter between two
## polls of a snapshot this scene reads every frame anyway. That is strictly
## better than watching `money` go up, for three reasons: money also moves
## when the player buys something, the delta alone cannot say WHICH docket to
## stamp, and a rise of two means two windows settled and should be
## celebrated as `2 x payout` rather than as one event. So nothing crosses
## the `gdext` boundary that did not already (ARCHITECTURE.md §4 is
## untouched), and the detection is a Godot-side poll.
##
## The counters are SEEDED on the first poll and fire nothing (`_payout_seen`
## starts empty). That is what keeps loading a save — which arrives with
## `deliveries_made` already at 40 — from opening with forty coin bursts.
##
## # Why the animation clock is the simulation tick, not the wall clock
##
## Every timed thing in here reads `sim.current_tick()`, not
## `Time.get_ticks_msec()`. Three things fall out of that and all three are
## wanted:
##
## 1. **It pauses with the game.** UI_UX.md §5d's pause menu says "the
##    factory is stopped while this is open"; a coin still arcing over a
##    stopped factory would contradict the sentence.
## 2. **A screenshot is reproducible.** `MAX_TICKS_PER_FRAME` already clamps
##    catch-up so two `scripts/screenshot-scene.sh` runs are byte-identical
##    (the visual-overhaul-r2 decision); anchoring to the tick puts this
##    effect inside that guarantee instead of outside it, so `--payout` can
##    photograph the same frame of the same burst twice.
## 3. **A headless test can assert it.** The whole effect is a pure function
##    of `current_tick - start_tick`, so a test drives it by ticking rather
##    than by sleeping.
##
## The cost is that motion updates at TICK_HZ (30) rather than at the frame
## rate. That is not a compromise here — UI_UX.md §6 asks for "chunky, snappy
## animation ... no smooth organic motion", and the belts already march at
## four frames per fifty ticks.
##
## # What fires, and where each piece is anchored
##
## | Where | What | Why there |
## |---|---|---|
## | World, every dock | a burst of spinning coins | the goods left from there |
## | Clipboard, money line | a scale punch, and a rising "+N" | the number that changed |
## | Clipboard, paying docket | its payout reads PAID | which order paid |
## | Speakers | the payout chime (`audio.gd`) | — |
##
## The "+N" is deliberately NOT anchored to the dock. One payout is one
## number, and with two docks a per-dock flyout would read as two payouts of
## N; the coins can be per-dock (they are goods, and every dock ships the
## same shared pool — `_update_dock_stock`'s own rule) but the figure cannot.
## Anchoring it to the money label also means it can never be off screen, and
## that it works in first-person view where a dock may be behind the player.

## The asset a burst throws. Modelled midline-symmetric on purpose so this
## can spin it about world Y without stepping (UI_UX.md §2b point 20), and
## carrying an emissive face because both faces this camera can see are the
## shadow side (point 13).
const COIN_ASSET := "coin"

## How many coin nodes exist at once, ever. A hard pool rather than a
## spawn-per-payout, so a factory running for an hour allocates nothing after
## its first payout, and so UI_UX.md §6's "readable with dozens at once" is a
## property of the code rather than a hope.
const COIN_POOL := 24

## One coin per this much money, so a 90 pays out visibly bigger than a 24
## without either becoming a screenful.
const COIN_PER_MONEY := 9.0
const COIN_MIN := 3
const COIN_MAX_PER_DOCK := 10

## A burst's whole life, in ticks. ~1.1s at TICK_HZ: long enough to read as
## an arc, short enough that a second payout never lands on the first.
const COIN_FLIGHT_TICKS := 34

## The ballistic constants, **in tiles** over the flight. Launch beats gravity
## early and loses to it at the end, so a coin is falling, and already
## shrinking away, when it goes: it peaks at `LAUNCH^2 / (4 * GRAVITY)` = 1.06
## tiles up, 46% of the way through, and passes back down through 0.4 tiles
## below the deck as it vanishes.
##
## Measured in TILE and not in bare world units, which is the mistake the
## first render of this caught: at 3.0 and 3.4 raw the peak was a fifth of a
## tile and the whole burst read as one gold lump sitting on the deck. Every
## distance a player compares against the factory has to be in the factory's
## own unit.
const COIN_LAUNCH := 4.6 * TILE
const COIN_GRAVITY := 5.0 * TILE
## Outward drift over the flight, again in tiles, so the burst opens out
## instead of stacking. This has a floor set by arithmetic, not by taste: a
## coin is COIN_SCALE wide, so N coins on a circle of radius r only stay
## separate while `TAU * r / N` exceeds it. At 10 a dock and 0.25 tiles each,
## anything under about 0.4 tiles of final radius is a solid ring.
const COIN_SPREAD := 1.15 * TILE
## How much the launch varies coin to coin, as a fraction either side of 1.
## A fan thrown at one speed is a ring; a fountain has coins at different
## heights. Derived from the coin's index, never from `randf()`, so a
## screenshot of a burst is reproducible.
const COIN_LIFT_VARY := 0.28
## Turns about world Y over the flight. Not a whole number: the point of the
## spin is that a coin catches the light edge-on and face-on alternately, and
## an integer count would have every coin land showing the same face.
const COIN_SPINS := 2.5
## The coin model is a third of a tile; this shrinks it a little further so a
## burst of ten does not hide the dock it came from (§6 again — juice stays
## legible over spectacle).
const COIN_SCALE := 0.8
## Fractions of the flight spent growing in and shrinking out.
const COIN_GROW := 0.12
const COIN_SHRINK := 0.30

## The money line's punch: how long, and how much bigger it gets at the peak.
## A scale rather than a position, because the clipboard's container owns
## positions — the same rule the hotbar's selected slot follows.
const MONEY_PUNCH_TICKS := 14
const MONEY_PUNCH_SCALE := 0.34
## What it flashes to on the way. Signage amber, and paired with the punch,
## the "+N" and the PAID stamp rather than carrying the meaning alone (§7).
const MONEY_PUNCH_COLOR := Color(1.0, 0.78, 0.22)

## The "+N" flyout: how long it lives, and how far it rises over that.
const PAYOUT_FLYOUT_TICKS := 40
const PAYOUT_FLYOUT_RISE := 26.0

## How long a paid docket's payout figure reads PAID instead of "+90".
const PAYOUT_STAMP_TICKS := 45

## The dock case pop: a new case scales up from nothing over this many ticks.
## Much shorter than a payout's anything — this fires every few seconds on a
## running line, so it has to be over before it is noticed as an animation.
const DOCK_POP_TICKS := 7
const DOCK_POP_OVERSHOOT := 0.35

## Sound, and the cues it knows. Preloaded (not a `class_name`) for the same
## reason `GameSaves` is.
const FactoryAudio = preload("res://audio.gd")

var _audio # FactoryAudio, built in _ready

## Contract id -> the `deliveries_made` this scene last saw. Empty means
## "not seeded yet", which is what makes the first poll silent.
var _payout_seen: Dictionary = {}

## The pool. Each entry is `{"node": Node3D, "start_tick": int,
## "origin": Vector3, "dir": Vector3}`; `start_tick` < 0 means free.
var _coins: Array = []
var _coin_root: Node3D
var _coin_next := 0

var _payout_flyout: Label
var _payout_flyout_tick := -1
var _money_punch_tick := -1
## Contract id -> the tick it last paid, for the PAID stamp.
var _payout_stamp_ticks: Dictionary = {}

## The total on the dock last seen, and the pop that a rise in it started.
## -1 means not seeded (so a loaded save's full dock is silent).
var _dock_stock_seen := -1
var _dock_pop_tick := -1
var _dock_pop_slot := -1

## The pause menu's sound switch (built in `_build_pause_menu`).
var _pause_sound_button: Button

## Test seams. A dummy audio driver makes "was a sound heard" unanswerable
## and a headless run has no eyes, so what a test asserts on is how many
## payouts were celebrated and for how much in total.
var payout_events := 0
var payout_total := 0


## Builds the coin pool and the "+N" label. Called once from `_build_ui`.
##
## The coins hang off a node of the SCENE, not off `_world_root`: that
## subtree is thrown away and rebuilt on every place/remove/rotate
## (`_rebuild_world`), and a player who builds a belt while a payout is in
## the air should not see the burst blink out. Both roots sit at the scene
## origin, so world coordinates mean the same thing in either.
func _build_payout_feedback(hud: CanvasLayer) -> void:
	var existing := get_node_or_null("Feedback")
	if existing != null:
		# `_ready` genuinely runs twice under the headless `--script` harness
		# (see `_rebuild_world`'s note), and a second pool would leave the
		# first one's nodes orphaned in the tree.
		remove_child(existing)
		existing.free()
	_coin_root = Node3D.new()
	_coin_root.name = "Feedback"
	add_child(_coin_root)

	_coins.clear()
	_coin_next = 0
	for i in range(COIN_POOL):
		var node := _asset_node(COIN_ASSET)
		node.name = "coin_%d" % i
		node.visible = false
		_coin_root.add_child(node)
		_coins.append({"node": node, "start_tick": -1, "origin": Vector3.ZERO,
			"dir": Vector3.ZERO, "lift": 1.0})

	var flyout_settings := LabelSettings.new()
	flyout_settings.font_size = _ui_font(9)
	flyout_settings.font_color = MONEY_PUNCH_COLOR
	flyout_settings.outline_size = _ui_i(6)
	flyout_settings.outline_color = Color(0, 0, 0, 0.92)

	_payout_flyout = Label.new()
	_payout_flyout.name = "PayoutFlyout"
	_payout_flyout.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_payout_flyout.label_settings = flyout_settings
	_payout_flyout.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_payout_flyout.modulate = Color(1, 1, 1, 0)
	hud.add_child(_payout_flyout)


## Compares this frame's contract snapshots against the last frame's and
## fires the celebration for any window that settled in between.
##
## Several contracts can settle on the same tick (`Economy::tick` returns a
## LIST of paid contracts) and several ticks can run in one frame
## (MAX_TICKS_PER_FRAME is 8), so this must handle both a rise of more than
## one on a single contract and rises on more than one contract — which it
## does by summing, and celebrating once. Two chimes and two flyouts for
## what the player experiences as one payment would read as a bug.
func _detect_payouts(contracts: Array, current_tick: int) -> void:
	var seeding: bool = _payout_seen.is_empty()
	var earned := 0
	var paid_ids: Array[String] = []
	var live: Dictionary = {}

	for entry in contracts:
		if not (entry is Dictionary):
			continue
		var id := String(entry.get("id", ""))
		var made := int(entry.get("deliveries_made", 0))
		live[id] = made
		if seeding:
			continue
		# A contract this scene has not seen before (a save from a different
		# board is refused by `load_ron`, so in practice this is a new
		# `contracts.ron`) is seeded rather than treated as having just paid
		# `made` times.
		if not _payout_seen.has(id):
			continue
		var windows: int = made - int(_payout_seen[id])
		if windows <= 0:
			continue
		earned += int(round(float(entry.get("payout", 0)))) * windows
		paid_ids.append(id)

	_payout_seen = live
	if seeding or earned <= 0:
		return
	_fire_payout(earned, paid_ids, current_tick)


## One payment, celebrated. Split from detection so a test can call it
## directly with a known figure.
func _fire_payout(amount: int, paid_ids: Array, current_tick: int) -> void:
	payout_events += 1
	payout_total += amount

	_money_punch_tick = current_tick
	_payout_flyout_tick = current_tick
	if _payout_flyout != null:
		_payout_flyout.text = "+%d" % amount
	for id in paid_ids:
		_payout_stamp_ticks[String(id)] = current_tick
	_burst_coins(amount, current_tick)
	if _audio != null:
		_audio.play(FactoryAudio.PAYOUT)


## Throws coins off every dock.
##
## Every dock, because every dock displays the same shared pool the payment
## consumed (`_update_dock_stock`'s doc states that rule once) — showing the
## money leave one arbitrarily-chosen door would be the scene disagreeing
## with itself. The budget is SPLIT across them rather than repeated, so a
## player with four docks gets a payout that reads as one payment from a
## bigger factory and not as four payments.
func _burst_coins(amount: int, current_tick: int) -> void:
	var docks: Array = _dock_nodes.keys()
	if docks.is_empty() or _coins.is_empty():
		return

	var budget: int = clampi(int(round(float(amount) / COIN_PER_MONEY)), COIN_MIN, COIN_POOL)
	var per_dock: int = clampi(int(floor(float(budget) / float(docks.size()))), 1, COIN_MAX_PER_DOCK)
	# Deterministic, evenly spaced directions rather than `randf()`: an even
	# fan looks more like a fountain than a random one does, and it keeps a
	# screenshot reproducible. The whole fan is rotated by a figure derived
	# from the tick, so two payouts in a row are not the identical picture.
	var base: float = TAU * (float(current_tick % 16) / 16.0)

	for key in docks:
		var nodes: Dictionary = _dock_nodes[key]
		var anchor: Vector3 = nodes.get("anchor", Vector3.ZERO)
		for i in range(per_dock):
			var angle: float = base + TAU * float(i) / float(per_dock)
			# The lift walks a coprime step around a small cycle, so adjacent
			# coins in the fan never get adjacent heights and the pattern does
			# not repeat within one dock's worth.
			var lift: float = 1.0 + COIN_LIFT_VARY * (float((i * 3) % 7) / 3.0 - 1.0)
			_launch_coin(anchor, Vector3(cos(angle), 0.0, sin(angle)), lift, current_tick)


func _launch_coin(origin: Vector3, dir: Vector3, lift: float, current_tick: int) -> void:
	# Round-robin, so an overflowing burst steals the OLDEST coin in flight
	# rather than refusing to draw. A stolen coin at the end of a fade is
	# invisible; a burst that silently shrinks under load is not.
	var coin: Dictionary = _coins[_coin_next]
	_coin_next = (_coin_next + 1) % _coins.size()
	coin["start_tick"] = current_tick
	coin["origin"] = origin
	coin["dir"] = dir
	coin["lift"] = lift


## Advances every live piece of feedback. Called once per frame from
## `_process`, after the simulation has been advanced, so `current_tick` is
## this frame's.
func _update_payout_feedback() -> void:
	var current_tick: int = sim.current_tick()
	_update_coins(current_tick)
	_update_money_punch(current_tick)
	_update_payout_flyout(current_tick)
	_update_payout_stamps(current_tick)
	_update_dock_pop(current_tick)


func _update_coins(current_tick: int) -> void:
	for coin in _coins:
		var start: int = int(coin["start_tick"])
		var node: Node3D = coin["node"]
		if start < 0:
			continue
		var phase: float = float(current_tick - start) / float(COIN_FLIGHT_TICKS)
		if phase < 0.0 or phase >= 1.0:
			coin["start_tick"] = -1
			node.visible = false
			continue
		var origin: Vector3 = coin["origin"]
		var dir: Vector3 = coin["dir"]
		var lift: float = float(coin.get("lift", 1.0))
		var height: float = COIN_LAUNCH * lift * phase - COIN_GRAVITY * phase * phase
		node.position = origin + dir * (COIN_SPREAD * phase) + Vector3(0.0, height, 0.0)
		node.rotation.y = phase * TAU * COIN_SPINS
		var grow: float = clampf(phase / COIN_GROW, 0.0, 1.0)
		var shrink: float = clampf((1.0 - phase) / COIN_SHRINK, 0.0, 1.0)
		node.scale = Vector3.ONE * (COIN_SCALE * grow * shrink)
		node.visible = true


## How many coins are in the air. The headless test's one window onto the
## world half of this effect.
func _active_coin_count() -> int:
	var count := 0
	for coin in _coins:
		if int(coin["start_tick"]) >= 0:
			count += 1
	return count


## The money line's punch, and the amber it flashes through on the way back.
## The pivot is its RIGHT edge, so the number grows leftward into the
## clipboard instead of pushing out past the panel's border.
func _update_money_punch(current_tick: int) -> void:
	if _contract_money_label == null:
		return
	var age: int = current_tick - _money_punch_tick
	if _money_punch_tick < 0 or age < 0 or age >= MONEY_PUNCH_TICKS:
		if _money_punch_tick >= 0:
			_money_punch_tick = -1
			_contract_money_label.scale = Vector2.ONE
			_contract_money_label.modulate = Color(1, 1, 1, 1)
		return
	var t: float = float(age) / float(MONEY_PUNCH_TICKS)
	var fall: float = (1.0 - t) * (1.0 - t)
	_contract_money_label.pivot_offset = Vector2(
		_contract_money_label.size.x, _contract_money_label.size.y * 0.5
	)
	_contract_money_label.scale = Vector2.ONE * (1.0 + MONEY_PUNCH_SCALE * fall)
	_contract_money_label.modulate = Color(1, 1, 1, 1).lerp(MONEY_PUNCH_COLOR, fall)


## The rising "+N", parked over the money line it belongs to. Positioned
## every frame rather than once, because the clipboard re-anchors itself
## every frame too (its minimum size grows with its own text).
func _update_payout_flyout(current_tick: int) -> void:
	if _payout_flyout == null:
		return
	var age: int = current_tick - _payout_flyout_tick
	if _payout_flyout_tick < 0 or age < 0 or age >= PAYOUT_FLYOUT_TICKS:
		_payout_flyout.modulate = Color(1, 1, 1, 0)
		return
	var t: float = float(age) / float(PAYOUT_FLYOUT_TICKS)
	if _contract_money_label != null and _contract_money_label.is_inside_tree():
		# Size it from its own text FIRST. This Label is parented straight to
		# the CanvasLayer rather than to a container, so nothing else ever sets
		# its size: it stays at Control's default and the right-alignment below
		# lines the flyout's left edge up with the money figure's right edge,
		# which puts "+90" off the side of the screen. The first render of this
		# is what found it.
		_payout_flyout.size = _payout_flyout.get_minimum_size()
		var anchor := _contract_money_label.get_global_rect()
		_payout_flyout.position = Vector2(
			anchor.position.x + anchor.size.x - _payout_flyout.size.x,
			# It rises OUT OF the money line, not from above it. The clipboard
			# is anchored to the top-right corner, so the money figure sits
			# about fifty pixels from the top edge and there is simply not
			# PAYOUT_FLYOUT_RISE of room above it — the first render of this
			# had "+90" half off the top of the screen. Starting level with the
			# counter's bottom edge and rising through it spends the same
			# travel entirely inside the viewport, and by the time the figure
			# crosses the number it announces it is down to a fifth alpha.
			anchor.position.y + anchor.size.y * 0.9 - _ui_px(PAYOUT_FLYOUT_RISE) * t
		)
	# Full strength for the first third, then out — a figure that starts
	# fading immediately is a figure that is never quite readable.
	_payout_flyout.modulate = Color(1, 1, 1, clampf((1.0 - t) / 0.66, 0.0, 1.0))


## The paying docket's payout figure, which reads PAID for a beat instead of
## "+90". A word, not a colour wash (UI_UX.md §7), and on the one number that
## just became true rather than on a new widget the docket has no room for.
func _update_payout_stamps(current_tick: int) -> void:
	for i in range(min(_contract_cards.size(), _contract_card_ids.size())):
		var card: Dictionary = _contract_cards[i]
		var label: Label = card.get("payout_label")
		if label == null:
			continue
		var id := String(_contract_card_ids[i])
		var stamped: bool = _payout_stamp_ticks.has(id)
		if stamped:
			var age: int = current_tick - int(_payout_stamp_ticks[id])
			if age < 0 or age >= PAYOUT_STAMP_TICKS:
				_payout_stamp_ticks.erase(id)
				stamped = false
		if stamped:
			if label.text != "PAID":
				label.text = "PAID"
				label.modulate = MONEY_PUNCH_COLOR
		elif label.text == "PAID":
			label.text = "+%d" % int(label.get_meta("payout", 0))
			label.modulate = Color(1, 1, 1, 1)


## Notices a case landing on the dock and pops it in.
##
## The pool's total rising IS a case arriving: `delivery_stock` only goes up
## when a dock ships into it, and only goes down when a contract consumes a
## mix. This is far more frequent than a payout, so what it gets is a
## seven-tick scale pop and a wooden knock, not a burst — see `audio.gd`'s
## note on why the delivery cue is deliberately small.
func _detect_dock_arrivals(stock: Array, current_tick: int) -> void:
	var total := 0
	for pair in stock:
		if pair is Array and pair.size() >= 2:
			total += int(pair[1])
	var previous: int = _dock_stock_seen
	_dock_stock_seen = total
	if previous < 0 or total <= previous:
		return
	# The case that appeared is the last visible one; past the deck's slot
	# count nothing new is drawn, so nothing should pop either.
	_dock_pop_slot = mini(total, DOCK_STOCK_SLOTS) - 1
	_dock_pop_tick = current_tick
	if _audio != null:
		_audio.play(FactoryAudio.DELIVERY)


func _update_dock_pop(current_tick: int) -> void:
	if _dock_pop_tick < 0 or _dock_pop_slot < 0:
		return
	var age: int = current_tick - _dock_pop_tick
	var done: bool = age < 0 or age >= DOCK_POP_TICKS
	var pop := Vector3.ONE
	if not done:
		# Overshoot and settle: a case that grows straight to its size reads
		# as appearing, and one that overshoots reads as landing.
		var t: float = float(age) / float(DOCK_POP_TICKS)
		pop = Vector3.ONE * (1.0 + DOCK_POP_OVERSHOOT * sin(PI * t))
	for key in _dock_nodes.keys():
		var slots: Array = _dock_nodes[key].get("slots", [])
		if _dock_pop_slot < slots.size():
			(slots[_dock_pop_slot] as Node3D).scale = pop
	if done:
		_dock_pop_tick = -1
		_dock_pop_slot = -1


## Whether anything is audible, and the pause-menu caption that says so.
## Session-scoped on purpose: this is the game's FIRST sound, and a persisted
## audio setting belongs with the rest of a settings screen this project does
## not have yet, not smuggled into the save format.
func _toggle_sound() -> void:
	if _audio == null:
		return
	_audio.enabled = not _audio.enabled
	_update_sound_button()


## The switch says ON or OFF in words, not by looking pressed (UI_UX.md §7).
func _update_sound_button() -> void:
	if _pause_sound_button == null:
		return
	var on: bool = _audio != null and _audio.enabled
	_pause_sound_button.text = "SOUND: ON" if on else "SOUND: OFF"


func _on_pause_sound_pressed() -> void:
	_toggle_sound()
