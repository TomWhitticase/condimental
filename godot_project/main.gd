func _ready() -> void:
	sim = SimBridge.new()
	# What world this is — a fresh one, or the save the main menu picked.
	# Everything after this point is identical either way, which is the whole
	# reason `SimBridge` has both `new_game()` and `load_ron()` behind one
	# long-lived bridge.
	_apply_pending_session()
	# The labels content names itself by (`_display_names`). Read once, here,
	# because it is `data/*.ron` read back and cannot change while a game runs
	# — and read after `_apply_pending_session` only so there is a bridge to
	# ask; a load does not change the answer.
	_load_display_names()
	_load_voxel_materials()
	_build_environment()
	# The world the player has built — NOTHING, in a new game. This is a real
	# starting state now, not a degenerate one: `World::new` places nothing at
	# all, so the first thing the scene draws is bare floor with a build menu
	# over it, and everything else appears as the player puts it there.
	_rebuild_world()
	_build_camera()
	# The game's first sound (`audio.gd`), built before the UI because the
	# pause menu's SOUND switch reads its state to caption itself. Synthesised
	# here rather than loaded: the waveforms are code, not committed `.wav`
	# blobs — see that file's header for why.
	_audio = FactoryAudio.new()
	_audio.setup(self)
	# The score (music.gd). Idempotent: the menu already started it, and a
	# game entered from the menu must not restart the loop at the cut.
	var music := _music()
	if music != null:
		music.start()
	_build_ui()
	_build_ghost_layer()
	_refresh_owned_counts()
	_update_contract_panel() # fill in real text/sizing before the first frame draws
	_update_fluid_network() # show tick 0's fluid levels, not an empty pipe run
	_apply_dirty_chunks() # render tick 0's (empty) state immediately
	# A loaded world arrives with product mid-belt, hoppers part full and
	# contracts part way through their windows, so every per-frame updater is
	# run once here rather than left to the first `_process`. Two of them —
	# the larder and the hotbar — would otherwise draw a NEW GAME's counts
	# over a loaded game's inventory for one frame.
	_refresh_buffers()
	_update_hotbar()
	_update_larder()
	# The window's close button is the other way a session ends, and it has
	# to autosave before the process goes away — which means intercepting it
	# rather than letting the default close handling quit underneath us. See
	# `_notification`.
	if is_inside_tree():
		get_tree().auto_accept_quit = false


## Applies whatever `menu.tscn` armed on the `GameSession` autoload: a fresh
## world, or the save file it already proved loads.
##
## Reading the pending action does NOT clear it — see `game_session.gd` for
## why sticky rather than consumed. The `session == null` branch is what
## keeps every headless test that instantiates `main.tscn` directly working
## exactly as it did before this ticket: no singleton, no pending action, new
## game.
##
## The load is defensive even though the menu validated the file first: the
## file could have been deleted or truncated in the seconds between, and the
## honest response to that is a fresh world plus a printed reason, not a
## crash. It cannot be a silent fresh world — that is the failure this whole
## ticket exists to avoid — so it prints, and the menu (which is where a
## player can actually act on it) is the screen that shows the message in the
## normal case.
func _apply_pending_session() -> void:
	# Print once per launch, so a developer hunting for save files does not
	# have to know Godot's per-platform `user://` layout. Static, because
	# every headless test calls `_ready()` a second time by hand and one line
	# is a note where two are noise.
	if not _printed_saves_dir:
		_printed_saves_dir = true
		print("CONDIMENTAL saves: %s" % GameSaves.resolved_saves_dir())
	var session := _session()
	if session == null or String(session.pending_action) != "load":
		sim.new_game()
		_save_slot = DEFAULT_SLOT
		return
	var path := String(session.pending_path)
	var text: String = GameSaves.read_save(path)
	var refusal: String = sim.load_ron(text) if text != "" else "could not read %s" % path
	if refusal != "":
		printerr("CONDIMENTAL: could not load %s — %s" % [path, refusal])
		sim.new_game()
		_save_slot = DEFAULT_SLOT
		return
	_save_slot = String(session.current_slot)
	if _save_slot == "" or GameSaves.is_reserved_slot(_save_slot):
		# A game resumed from the autosave saves to a real slot by default,
		# not back over the autosave — the reserved-name rule applies to the
		# prefilled suggestion too, or the very first press of Save would be
		# refused for a name the player never typed.
		_save_slot = DEFAULT_SLOT


## The `GameSession` autoload, or null.
##
## Reached through the main loop's own root rather than through
## `get_node("/root/GameSession")`, because this scene is instantiated
## OUTSIDE the active scene tree by every headless test script (they
## `add_child` it to the root window and call `_ready()` themselves), and an
## absolute node path resolved from there is an engine error rather than a
## null. Null is the answer this wants: no singleton, no pending action, new
## game.
func _session() -> Node:
	var loop := Engine.get_main_loop()
	if not (loop is SceneTree):
		return null
	var tree_root: Node = (loop as SceneTree).root
	return tree_root.get_node_or_null("GameSession") if tree_root != null else null


## The `Music` autoload, or null — found the same way, for the same reason.
func _music() -> Node:
	var loop := Engine.get_main_loop()
	if not (loop is SceneTree):
		return null
	var tree_root: Node = (loop as SceneTree).root
	return tree_root.get_node_or_null("Music") if tree_root != null else null


## One cue, through `audio.gd`. Null-safe because `_audio` is built in
## `_ready` and a few paths (a test driving a handler directly) can reach a
## cue before it.
func _cue(name: String) -> void:
	if _audio != null:
		_audio.play(name)


## The balance, from the cheapest snapshot that carries it. Used to tell a
## purchase that went through from one the simulation refused: every
## command is a silent no-op on failure (the `Purchase` convention), so the
## only way to know is to look at what it would have changed.
func _current_money() -> float:
	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	if snapshot is Dictionary:
		return float(snapshot.get("money", 0.0))
	return 0.0


# --------------------------------------------------------------------------
# Assets
# --------------------------------------------------------------------------

## Every voxel model in the scene comes through here (`voxel_assets.gd`).
## It used to be this file's own code and moved out wholesale when the title
## screen began standing real machines behind the main menu: the menu builds
## its models with the same loader, so the two scenes cannot end up lit by
## different readings of `palette.ron`. The wrappers below stay because
## `_asset_node` is called from thirteen places in this file and reads better
## than `_assets.asset_node`.
func _load_voxel_materials() -> void:
	_assets.load_materials()
	_class_materials = _assets.class_materials
	_lamp_idle = _assets.lamp_idle
	_lamp_running = _assets.lamp_running
	_asset_classes = _assets.asset_classes


func _make_material(metallic: float, roughness: float) -> StandardMaterial3D:
	return VoxelAssets.make_material(metallic, roughness)


## Builds one asset as a `Node3D` holding a `MeshInstance3D` per material
## class it uses; an empty node with a warning if the models were never
## staged by `cargo xtask`.
func _asset_node(asset: String) -> Node3D:
	return _assets.asset_node(asset)


func _mesh_for(asset: String) -> Mesh:
	return _assets.mesh_for(asset)


func _asset_class_names(asset: String) -> Array:
	return _assets.asset_class_names(asset)


func _class_mesh_for(asset: String, class_name_: String) -> Mesh:
	return _assets.class_mesh_for(asset, class_name_)


# --------------------------------------------------------------------------
# World
# --------------------------------------------------------------------------

## Tile (x, y) in simulation space -> the centre of that tile in world space.
## The sim's chain runs along +X at y = 0; the importer centres each model on
## its own footprint, so a tile centre is exactly where an asset node goes.
func _tile_origin(tx: int, ty: int, height: float) -> Vector3:
	return Vector3(float(tx) * TILE, height, float(ty) * TILE)


## Where a node goes for a building that occupies a whole FOOTPRINT rather
## than a single tile (the "Machines improvement" milestone's ticket 1).
##
## `origin` is the footprint's minimum-X/minimum-Y corner — the tile the
## belt feeds into — and the building covers `size.x` x `size.y` tiles
## growing east/north from it (`sim::machines`'s module doc states that
## convention once; nothing here re-derives it). The voxel encoder puts a
## model's origin at its own footprint CENTRE at ground level, so the node
## belongs at the centre of that rectangle, which for a 1x1 building is
## exactly `_tile_origin` — i.e. this generalizes the old placement rather
## than replacing it, and every existing 1x1 kind stays on the tile it was
## on before.
func _footprint_centre(origin: Vector2i, size: Vector2i, height: float) -> Vector3:
	return Vector3(
		(float(origin.x) + float(size.x - 1) * 0.5) * TILE,
		height,
		(float(origin.y) + float(size.y - 1) * 0.5) * TILE
	)


## `{"width_tiles": w, "height_tiles": h}` (as every snapshot spells a
## footprint) -> Vector2i, defaulting to 1x1 so a snapshot from an older
## SimBridge without the field still renders.
func _footprint_size(footprint) -> Vector2i:
	if not (footprint is Dictionary):
		return Vector2i.ONE
	return Vector2i(
		maxi(1, int(footprint.get("width_tiles", 1))),
		maxi(1, int(footprint.get("height_tiles", 1)))
	)


## A tile as the string key `_occupancy`/`_by_origin`/every per-placement
## dictionary in this file are keyed by. One helper rather than the "%d,%d"
## literal repeated a dozen times, because a mismatched key is silent.
func _tile_key(tile: Vector2i) -> String:
	return "%d,%d" % [tile.x, tile.y]


## --- Facing (the "Real Placement" epic's ticket 2) -------------------------
##
## `sim::types::Direction` is four-way and every belt, pipe, machine and
## building on the wire now carries one. This array is in the simulation's
## own CLOCKWISE order (`Direction::rotate_cw`: east -> south -> west ->
## north), so rotating the ghost is one step along it and the yaw below is
## simply `index * 90 degrees` — which is why the two are one table rather
## than two that have to agree.
const DIRECTIONS := ["east", "south", "west", "north"]

## Tile-space unit offset per direction, matching `Direction::offset`:
## **east is +X and north is +Y** (see that type's own doc — the axis
## convention is the simulation's, not this file's, and is never re-derived
## here).
const DIRECTION_OFFSETS := {
	"east": Vector2i(1, 0),
	"south": Vector2i(0, -1),
	"west": Vector2i(-1, 0),
	"north": Vector2i(0, 1),
}


func _direction_index(direction: String) -> int:
	var i: int = DIRECTIONS.find(direction)
	return i if i >= 0 else 0


func _direction_offset(direction: String) -> Vector2i:
	return DIRECTION_OFFSETS.get(direction, Vector2i(1, 0))


## The Y-axis rotation that turns a model authored facing EAST into one
## facing `direction`.
##
## Every voxel asset in this project is modelled with its product path
## running along +X, because until this epic that was the only direction
## anything could face. Tile (x, y) maps to world (x, ., y) — sim +Y is world
## +Z — and a Godot rotation of `t` about +Y sends local +X to world
## `(cos t, 0, -sin t)`. So east is 0, south (sim -Y, world -Z) is +90,
## west is 180 and north is -90 — i.e. exactly `index * 90` along DIRECTIONS,
## which is the whole reason that array is in clockwise order.
##
## **This is all the rotation any asset needs.** The encoder puts a model's
## origin at its own footprint centre at ground level (UI_UX.md §2b), so a
## rotated placement is the same mesh spun about that origin and re-centred
## on the rotated rectangle — no new geometry. That includes a belt corner
## (`_belt_shape_for`): the corner models are authored with their output on
## +X like every straight, so the same yaw turns them. Since the pipes &
## conveyors overhaul finished, no asset in the project is authored for one
## facing — `pipe_source`/`pipe_inlet` were the last two and ticket 6 deleted
## them — so this yaw is the whole story for every tile the scene draws.
func _direction_yaw(direction: String) -> float:
	return deg_to_rad(float(_direction_index(direction)) * 90.0)


## The rectangle a kind actually claims once turned: a quarter turn SWAPS the
## extents, anchored at the same origin corner (`sim::machines`'s module doc
## owns that rule; this is its one presentation-side restatement).
func _rotated_footprint(size: Vector2i, direction: String) -> Vector2i:
	if direction == "north" or direction == "south":
		return Vector2i(size.y, size.x)
	return size


## Every tile a placement of `size` at `origin` facing `direction` covers.
func _placement_tiles(origin: Vector2i, size: Vector2i, direction: String) -> Array:
	var rotated := _rotated_footprint(size, direction)
	var tiles: Array = []
	for dy in range(rotated.y):
		for dx in range(rotated.x):
			tiles.append(Vector2i(origin.x + dx, origin.y + dy))
	return tiles


## Re-reads `world_layout_json` into the three indexes the rest of this file
## asks questions of: the placements themselves, a lookup by origin tile, and
## an occupancy map from *every* covered tile back to the placement's origin.
##
## The occupancy map is what makes "point at a machine, not at its corner"
## work here the way it already does in the simulation (`World::query_tile`,
## `Remove`, `Rotate` all resolve from any tile of a footprint), and it is
## also the whole of the ghost's validity check — see `_ghost_blocked`.
##
## `occupies` comes straight off the wire rather than being re-derived from
## `footprint` + `direction`: the simulation reports both precisely so a
## consumer can take whichever it needs (see `sim::PlacementSnapshot`).
func _read_world_layout() -> void:
	_placements.clear()
	_by_origin.clear()
	_occupancy.clear()
	var parsed = JSON.parse_string(sim.world_layout_json())
	if not (parsed is Array):
		return
	for placement in parsed:
		if not (placement is Dictionary):
			continue
		_placements.append(placement)
		var origin := _placement_origin(placement)
		var key := _tile_key(origin)
		_by_origin[key] = placement
		# A kind's declared footprint is content (data/machines.ron) and the
		# only place it reaches this scene is on a placement — so every
		# placement teaches it, for the ghost of a kind nothing has placed
		# yet to fall back on. See `_kind_footprint`.
		_kind_footprints[String(placement.get("kind", ""))] = _footprint_size(placement.get("footprint"))
		for pair in placement.get("occupies", []):
			if pair is Array and pair.size() >= 2:
				_occupancy[_tile_key(Vector2i(int(pair[0]), int(pair[1])))] = key


func _placement_origin(placement: Dictionary) -> Vector2i:
	var pair: Array = placement.get("tile", [0, 0])
	return Vector2i(int(pair[0]), int(pair[1]))


func _placement_direction(placement: Dictionary) -> String:
	return String(placement.get("direction", "east"))


## Whichever placement covers `tile`, or `{}`. Any tile of a multi-tile
## footprint answers, via `_occupancy`.
func _placement_at_tile(tile: Vector2i) -> Dictionary:
	var origin_key: String = _occupancy.get(_tile_key(tile), "")
	if origin_key == "":
		return {}
	return _by_origin.get(origin_key, {})


## The declared (unrotated) footprint of a buildable kind, for a GHOST of
## something not yet placed.
##
## Nothing on the wire reports a kind's footprint before one exists — every
## snapshot describes a *placement* — so this learns it two ways, in order.
## (1) From any placement of that kind in the world, which is the
## simulation's own number and therefore authoritative. (2) Failing that,
## from the kind's own voxel model: UI_UX.md's asset scale fixes one tile at
## 32 voxels and the "Machines improvement" epic's ticket 4 made a kind's
## model size and its `machines.ron` footprint *deliberately coupled* — the
## 2x2 cooking vat is modelled at 64x64 — so the mesh's own extent in tiles
## IS the footprint, rounded. It is derived rather than typed into a table
## here on purpose: a hand-written kind -> size table is exactly the kind of
## presentation-side lookup keyed by a content id that UI_UX.md §2b point 12
## records going silently stale.
func _kind_footprint(kind: String) -> Vector2i:
	if _kind_footprints.has(kind):
		return _kind_footprints[kind]
	var size := Vector2i.ONE
	var mesh := _mesh_for(_shop_asset_for(kind))
	if mesh != null:
		var aabb := mesh.get_aabb()
		size = Vector2i(
			maxi(1, roundi(aabb.size.x / TILE)),
			maxi(1, roundi(aabb.size.z / TILE))
		)
	_kind_footprints[kind] = size
	return size


## The tile bounding box of everything currently placed — `position` is the
## minimum tile and `size` the inclusive span, so the covered range is
## `position .. position + size`. An EMPTY world (the new starting state)
## reports a degenerate box at the origin, which is what the floor and the
## camera then pad out.
func _world_tile_bounds() -> Rect2i:
	var seen := false
	var min_tile := Vector2i.ZERO
	var max_tile := Vector2i.ZERO
	for key in _occupancy.keys():
		var parts: PackedStringArray = String(key).split(",")
		var tile := Vector2i(int(parts[0]), int(parts[1]))
		if not seen:
			min_tile = tile
			max_tile = tile
			seen = true
			continue
		min_tile = Vector2i(mini(min_tile.x, tile.x), mini(min_tile.y, tile.y))
		max_tile = Vector2i(maxi(max_tile.x, tile.x), maxi(max_tile.y, tile.y))
	return Rect2i(min_tile, max_tile - min_tile)


## Which of `assets.rs`'s four floor slabs paves the tile at (`tx`, `tz`).
##
## A pure function of the coordinates and nothing else — see the
## FLOOR_ASSET_* constants for why that matters. Drains are decided first and
## win outright: they are a continuous line across the world, and a worn tile
## punched out of the middle of one would break the trench.
static func _floor_variant_for(tx: int, tz: int) -> String:
	if posmod(tz + FLOOR_DRAIN_ROW_PHASE, FLOOR_DRAIN_ROW_PITCH) == 0:
		return FLOOR_ASSET_DRAIN
	# The same XOR hash the generators use, and for the same reason: a
	# modulo of a linear combination of tx and tz lays its results out in
	# diagonal stripes, which the isometric camera looks straight down.
	var h: int = _floor_hash(tx, tz)
	if h % FLOOR_PATCH_IN == 0:
		return FLOOR_ASSET_PATCH
	if h % FLOOR_WORN_IN == 0:
		return FLOOR_ASSET_WORN
	return FLOOR_ASSET_PLAIN


## The same XOR hash `assets.rs`'s `floor_hash` uses, and for the same
## reason: a modulo of a linear combination of tx and tz lays its results out
## in diagonal stripes, and the isometric camera looks straight down a
## diagonal.
static func _floor_hash(tx: int, tz: int) -> int:
	return absi((tx * 73856093) ^ (tz * 19349663))


## The quarter turn a floor slab is laid at, in `DIRECTIONS` index steps.
##
## Four models over several thousand tiles is still only four stamps, and a
## magnified render showed them plainly: every worn tile's scuff ran the same
## way across the screen and every plain tile carried its blotches in the
## same places, which is a repeating texture however good one tile of it
## looks. Turning the model costs a `Basis` and nothing else, and it is the
## reason `assets.rs`'s `floor_joint` cuts all four edges rather than two.
##
## The DRAIN is the exception and is always laid square: its channel has to
## stay on one axis or a row of them stops being a trench and becomes a row
## of holes.
static func _floor_yaw_steps_for(tx: int, tz: int, variant: String) -> int:
	if variant == FLOOR_ASSET_DRAIN:
		return 0
	return (_floor_hash(tx, tz) / 3) % 4


## The poured-concrete factory floor. Drawn as one `MultiMeshInstance3D` per
## slab variant under a `Floor` parent, rather than one node per tile: the
## floor is the only asset whose instance count scales with the size of the
## world, so it is the one worth batching. Four multimeshes is four draw
## calls for the whole ground plane, which is still nothing.
##
## The tile's saw-cut joint is what keeps the grid legible (UI_UX.md §1); the
## variants are what keep several thousand tiles of it from reading as
## squared paper. Which tile gets which is `_floor_variant_for`.
##
## Its extent follows the placed world rather than a fixed chain length, and
## it is rebuilt only when those bounds actually change — which for an empty
## world (nothing placed, the state the game now starts in) is a square of
## bare floor centred on the origin, i.e. somewhere to build.
func _build_floor() -> void:
	var bounds := _world_tile_bounds()
	if _floor_node != null and bounds == _floor_bounds:
		return
	_floor_bounds = bounds

	var x_from := bounds.position.x - FLOOR_GROUND_MARGIN_X
	var x_to := bounds.position.x + bounds.size.x + FLOOR_GROUND_MARGIN_X
	var z_from := bounds.position.y - FLOOR_GROUND_MARGIN_Z
	var z_to := bounds.position.y + bounds.size.y + FLOOR_GROUND_MARGIN_Z

	# Bucket the tiles by variant first: a MultiMesh's instance count has to
	# be set before its transforms are written, so the tiles have to be
	# counted before any of them can be placed.
	var by_variant := {}
	for tz in range(z_from, z_to + 1):
		for tx in range(x_from, x_to + 1):
			var variant := _floor_variant_for(tx, tz)
			if not by_variant.has(variant):
				by_variant[variant] = []
			var basis := Basis(Vector3.UP, deg_to_rad(90.0 * _floor_yaw_steps_for(tx, tz, variant)))
			by_variant[variant].append(Transform3D(basis, _tile_origin(tx, tz, 0.0)))

	if _floor_node != null:
		remove_child(_floor_node)
		_release_render_resources(_floor_node)
		_floor_node.free()
	_floor_node = Node3D.new()
	_floor_node.name = "Floor"
	add_child(_floor_node)

	var floor_material = _class_materials.get("matte", null)
	for variant in by_variant:
		var mesh := _mesh_for(variant)
		if mesh == null:
			push_warning("%s mesh missing — skipping those floor tiles" % variant)
			continue
		var placements: Array = by_variant[variant]
		var multimesh := MultiMesh.new()
		multimesh.transform_format = MultiMesh.TRANSFORM_3D
		multimesh.mesh = mesh
		multimesh.instance_count = placements.size()
		for i in placements.size():
			multimesh.set_instance_transform(i, placements[i])
		var node := MultiMeshInstance3D.new()
		node.name = variant
		node.multimesh = multimesh
		# The floor takes shadows from the machinery but casts none of its own.
		node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		if floor_material != null:
			node.material_override = floor_material
		_floor_node.add_child(node)


## The opposite side to `direction` — where a straight belt's feed comes
## from.
func _direction_opposite(direction: String) -> String:
	return DIRECTIONS[(_direction_index(direction) + 2) % 4]


## One quarter turn clockwise from `direction` (`Direction::rotate_cw`).
func _direction_cw(direction: String) -> String:
	return DIRECTIONS[(_direction_index(direction) + 1) % 4]


## One quarter turn anticlockwise from `direction`.
func _direction_ccw(direction: String) -> String:
	return DIRECTIONS[(_direction_index(direction) + 3) % 4]


## Which BELT_SHAPE_* a belt tile carrying toward `direction` takes, given
## the `links` the simulation reports for it (the plan's "Shape rules").
##
## The rule, in order:
##   * an input from BEHIND (the side opposite `direction`) makes the tile
##     straight whatever else feeds it — a flank feed on top of it is a
##     MERGE, which is a straight tile with two feeds, not a corner;
##   * otherwise exactly one input from a FLANK is a corner: fed from the
##     side one quarter turn anticlockwise from its facing it turns LEFT (a
##     belt running east fed from the north), fed from the clockwise side it
##     turns RIGHT. That is how ticket 2 authored the models, and it is also
##     what "turn left" means to the product: heading south with east on
##     your left, you turn left to go east;
##   * two flank inputs with nothing behind is a merge (straight);
##   * anything else with no inputs is a line START (a lone tile counts as
##     one — it is the start of the line being laid), with inputs but no
##     output a line END, and the rest is plain straight.
##
## An input from the tile the belt points AT (a hopper facing a belt that
## faces it back) is neither behind nor a flank: it is reported in hover and
## drawn straight, since no model describes it. Pure — `links` in, a word
## out — so a test can hand it any shape it likes.
func _belt_shape_for(links: Dictionary, direction: String) -> String:
	var inputs: Array = links.get("inputs", [])
	var behind := _direction_opposite(direction)
	var left := _direction_ccw(direction)
	var right := _direction_cw(direction)
	var from_behind := false
	var flanks: Array = []
	for input in inputs:
		var from := String(input.get("from", ""))
		if from == behind:
			from_behind = true
		elif from == left or from == right:
			flanks.append(from)
	if not from_behind and flanks.size() == 1:
		return BELT_SHAPE_CORNER_LEFT if flanks[0] == left else BELT_SHAPE_CORNER_RIGHT
	if inputs.size() >= 2:
		return BELT_SHAPE_MERGE
	if inputs.is_empty():
		return BELT_SHAPE_START
	if links.get("output") == null:
		return BELT_SHAPE_END
	return BELT_SHAPE_STRAIGHT


## The frame set a belt of `shape` draws with: `BELT_FRAMES` asset names in
## frame order, all in the same family.
func _belt_frames_for_shape(shape: String) -> Array:
	var family := String(BELT_SHAPE_FAMILIES.get(shape, "belt"))
	var frames: Array = []
	for k in range(BELT_FRAMES):
		frames.append("%s_f%d" % [family, k])
	return frames


## Which animation frame every belt shows at simulation tick `tick`: the
## plan's `floor(tick * BELT_FRAMES / BELT_TICKS_PER_TILE) mod BELT_FRAMES`.
## The pattern therefore crosses a tile in exactly the ticks an item does,
## and because it is a function of the TICK and nothing else it stands
## still whenever the simulation does — the pause menu, or a headless test
## that never ticks.
func _belt_frame_for_tick(tick: int) -> int:
	return posmod((tick * BELT_FRAMES) / BELT_TICKS_PER_TILE, BELT_FRAMES)


## Shows the frame the current tick calls for, if it changed. Called once
## per simulation step from `_advance_simulation`; a change is a handful of
## visibility flips (`_set_tile_frame`), so this is cheap to call every
## frame and free when nothing moved.
func _update_belt_frame() -> void:
	var frame := _belt_frame_for_tick(sim.current_tick())
	if frame != _tile_frame:
		_set_tile_frame(frame)


## Whether `tile` is covered by something a belt hands product to or takes it
## from — a machine, a hopper, a fluid tank or a dock, i.e. anything that is
## not itself a length of conveyor or pipe.
##
## A SPLITTER counts as conveyor here, not as a building: it is a belt tile
## with a choice at the end (`sim_core/src/sim/splitter.rs`). Since the belt
## family stopped having junction variants this is read only by the pipe
## role pass (`_rebuild_world`), which ticket 6 replaces with `links`.
func _is_building_tile(tile: Vector2i) -> bool:
	var placement := _placement_at_tile(tile)
	if placement.is_empty():
		return false
	var kind := String(placement.get("kind", ""))
	return kind != BELT_KIND and kind != PIPE_KIND and kind != SPLITTER_KIND


## The shape one pipe tile draws, from the sides it is joined on.
##
## `faces` is the list of absolute directions in `links.connections`
## (`"north"|"east"|"south"|"west"`, any order); `direction` is the
## placement's own facing, consulted ONLY when nothing is joined. Returns
## `{"asset", "fluid_asset", "turns", "yaw"}`: the shape model, its liquid
## body, and the number of clockwise quarter turns (and the yaw that is)
## that puts the authored openings on `faces`.
##
## The authored openings, in `DIRECTIONS` index terms (east 0, south 1,
## west 2, north 3), are the pipe section header's: a corner on {0, 3}, a
## tee on {0, 2, 3} (everything but south), an end on {2}, a straight on
## {0, 2}. One clockwise turn adds one to every index — the same turn
## `Direction::rotate_cw` and `VoxModel::rotated_cw` make, so what the
## voxgen tests prove about a turned model is what this draws.
func _pipe_shape_for(faces: Array, direction: String) -> Dictionary:
	var joined: Array = []
	for face in faces:
		var index := DIRECTIONS.find(String(face))
		if index >= 0 and not joined.has(index):
			joined.append(index)
	joined.sort()
	var asset := PIPE_ASSET
	var turns := 0
	match joined.size():
		0:
			# Joined to nothing: a bare length along the axis it was placed
			# on. The only case the placement's `direction` decides.
			turns = 1 if direction == "north" or direction == "south" else 0
		1:
			# An end is authored open on west (2); turn it until west lands
			# on the one joined side.
			asset = PIPE_END_ASSET
			turns = posmod(int(joined[0]) - 2, 4)
		2:
			var a := int(joined[0])
			var b := int(joined[1])
			if (a + 2) % 4 == b:
				# Opposite sides: a straight, and always the SAME turn for
				# an axis (see the constants' doc for the flange rule).
				turns = 0 if a == 0 else 1
			else:
				# Adjacent sides: the corner is authored on (0, 3) — a side
				# and the side one step anticlockwise of it — so the turn
				# count is whichever joined side has the other as its
				# anticlockwise neighbour.
				asset = PIPE_CORNER_ASSET
				turns = a if posmod(a - 1, 4) == b else b
		3:
			# A tee is authored closed on south (1); turn it until south
			# lands on the one side that is NOT joined.
			asset = PIPE_TEE_ASSET
			var missing := 0
			for index in range(4):
				if not joined.has(index):
					missing = index
			turns = posmod(missing - 1, 4)
		_:
			asset = PIPE_CROSS_ASSET
	return {
		"asset": asset,
		"fluid_asset": String(PIPE_FLUID_ASSETS.get(asset, PIPE_FLUID_ASSET)),
		"turns": turns,
		"yaw": deg_to_rad(float(turns) * 90.0),
	}


## The fitting record for one non-pipe connection: which asset stands on
## which side, and the yaw that turns the fitting's authored +X face onto
## that side (`DIRECTIONS` index × 90°, exactly `_direction_yaw`). `{}` for
## a pipe-to-pipe connection, which takes no fitting.
func _pipe_fitting_for(connection: Dictionary) -> Dictionary:
	var kind := String(connection.get("kind", ""))
	var to := String(connection.get("to", ""))
	var asset := ""
	if kind == PIPE_LINK_MACHINE:
		asset = PIPE_FITTING_MACHINE_ASSET
	elif kind == PIPE_LINK_TANK:
		asset = PIPE_FITTING_TANK_ASSET
	if asset == "" or DIRECTIONS.find(to) < 0:
		return {}
	return {"asset": asset, "to": to, "kind": kind, "yaw": _direction_yaw(to)}


## The sides a pipe placement's `links` say it is joined on, as the raw
## connection dictionaries (`{"to", "kind"}`), in the wire's own
## north/east/south/west order. Empty for a lonely tile or a non-pipe.
func _pipe_connections_of(placement: Dictionary) -> Array:
	var links = placement.get("links")
	if not (links is Dictionary):
		return []
	var connections = links.get("connections", [])
	return connections if connections is Array else []


## The shape record (`_pipe_shape_for`) of the pipe on `tile`, or `{}`.
## Filled by `_rebuild_world` from every pipe placement's `links`.
func _pipe_shape_at(tile: Vector2i) -> Dictionary:
	return _pipe_shapes.get(_tile_key(tile), {})


## The fittings (`_pipe_fitting_for`) drawn on the pipe at `tile`, in
## north/east/south/west order; `[]` if none, or if it is not a pipe.
func _pipe_fittings_at(tile: Vector2i) -> Array:
	return _pipe_fittings.get(_tile_key(tile), [])


## Which shape model draws the pipe tile at `tile`. The plain straight for
## a tile `_rebuild_world` has not seen (there is none: every pipe placement
## carries `links`).
func _pipe_asset_for(tile: Vector2i) -> String:
	return String(_pipe_shape_at(tile).get("asset", PIPE_ASSET))


## The instance key of a fitting, distinct from the tile's own key so both
## can live in `_tile_instances` (a tile draws one shape and up to four
## fittings).
func _pipe_fitting_key(tile: Vector2i, to: String) -> String:
	return "fitting:%s:%s" % [_tile_key(tile), to]


## Which voxel asset draws one placement — for a belt, frame 0 of the shape
## its `links` give it (the frame set itself is `_tile_frames_for`); pipes
## have context-dependent variants (above); everything else goes through the
## same `_shop_asset_for` the build menu's icons use, so a kind added to
## `data/shop.ron` draws in the world and in the menu from one mapping.
func _asset_for_placement(placement: Dictionary) -> String:
	var kind := String(placement.get("kind", ""))
	var origin := _placement_origin(placement)
	if kind == BELT_KIND:
		return _tile_frames_for(placement)[0]
	if kind == PIPE_KIND:
		return _pipe_asset_for(origin)
	return _shop_asset_for(kind)


## The buildable-kind ids that are infrastructure rather than buildings —
## spelled here for the same reason `sim::world` spells them in Rust: they
## are the two kinds that are priced and placed but are not in
## `data/machines.ron` at all.
const BELT_KIND := "belt"
const PIPE_KIND := "pipe"

## The three buildable kinds that are buffers rather than processes — no
## recipe, but a footprint and a live level. Spelled here so the `match` in
## `_build_placement` reads as kind ids rather than string literals; they are
## `data/machines.ron` ids, and their Rust twins are `sim::hopper::HOPPER_KIND`
## and friends.
const HOPPER_KIND := "hopper"
const FLUID_TANK_KIND := "fluid_tank"
const DOCK_KIND := "dock"
## Epic B's splitter. A `data/machines.ron` kind like the three above, but
## belt-LIKE rather than a buffer: it carries product at belt speed and hands
## it on, so `_is_building_tile` deliberately groups it with the conveyor.
const SPLITTER_KIND := "splitter"


## Rebuilds the entire rendered world from `world_layout_json` plus the
## buffer/fluid snapshots — the one function every place, remove and rotate
## goes through, and the one `_ready` calls to draw the (empty) starting
## state. See `_placements`'s doc for why this is a full rebuild.
func _rebuild_world() -> void:
	_read_world_layout()

	# Pipe shapes first: which shape a tile draws, at what turn, and which
	# fittings stand on it come straight off each placement's `links`
	# (ticket 1 of the overhaul recorded them in the topology pass), so
	# they are known before the tiles themselves are staged. The fluid
	# snapshots are read alongside for `_pipe_tiles`, which hover uses to
	# find a tile's live level in the network array.
	_pipe_shapes.clear()
	_pipe_fittings.clear()
	for placement in _placements:
		if String(placement.get("kind", "")) != PIPE_KIND:
			continue
		var origin := _placement_origin(placement)
		var key := _tile_key(origin)
		var connections := _pipe_connections_of(placement)
		var faces: Array = []
		var fittings: Array = []
		for connection in connections:
			if not (connection is Dictionary):
				continue
			faces.append(String(connection.get("to", "")))
			var fitting := _pipe_fitting_for(connection)
			if not fitting.is_empty():
				fittings.append(fitting)
		_pipe_shapes[key] = _pipe_shape_for(faces, _placement_direction(placement))
		if not fittings.is_empty():
			_pipe_fittings[key] = fittings
	_last_fluid = _read_fluid_snapshots()
	_pipe_tiles.clear()
	for n in range(_last_fluid.size()):
		var segments: Array = _last_fluid[n].get("segments", [])
		for i in range(segments.size()):
			_pipe_tiles[_tile_key(_pair_to_tile(segments[i].get("tile", [0, 0])))] = Vector2i(n, i)

	# Cleared and rebuilt together, never appended to: `_ready()` genuinely
	# runs twice under the headless `--script` SceneTree harness (see
	# test_hover.gd's header), and a place/remove/rotate re-enters this.
	var existing := get_node_or_null("World")
	if existing != null:
		remove_child(existing)
		_release_render_resources(existing)
		existing.free()
	_machine_lamps.clear()
	_machine_gauges.clear()
	_machine_running.clear()
	_machine_motion.clear()
	_crush_anchors.clear()
	_crush_beats.clear()
	_machine_load.clear()
	_splitter_nodes.clear()
	_splitter_states.clear()
	_belt_shapes.clear()
	_hopper_nodes.clear()
	_fluid_tank_nodes.clear()
	_dock_nodes.clear()
	_pipe_fluid_nodes.clear()
	_pipe_fault_nodes.clear()
	# The instanced tiles and item pools are children of "World" and went
	# with it; their bookkeeping goes too, so a stale slot index can never
	# point into a MultiMesh that no longer exists.
	_tile_sets.clear()
	_tile_pending.clear()
	_tile_instances.clear()
	_item_pools.clear()
	_item_slots.clear()

	_world_root = Node3D.new()
	_world_root.name = "World"
	add_child(_world_root)
	_tiles_root = Node3D.new()
	_tiles_root.name = "Tiles"
	_world_root.add_child(_tiles_root)
	_items_root = Node3D.new()
	_items_root.name = "Items"
	_world_root.add_child(_items_root)

	for placement in _placements:
		_build_placement(placement)
	# Every conveyor and pipe tile has now been STAGED; this is what draws
	# them, one MultiMesh per (asset, material class) rather than one node
	# per tile.
	_build_tile_instances()

	_build_floor()
	_seed_machine_states()
	_seed_splitter_states()
	_seed_crews()
	# Polled here as well as on the tick, so a loaded save's panel and a
	# fresh world's both read right on their first frame. The clipboard's
	# SHORT-STAFFED strip re-primes with it: a rebuilt or loaded factory
	# that is already short is a state, not an event, and must not sound
	# like one (see `_update_staff_alert`).
	_staff_alert_known_short = -1
	_poll_staff()
	# The load records, once, right now — not on the next poll tick. A
	# rebuild is also what a LOADED game goes through in `_ready`, and a
	# loaded factory's windows arrive full (`SavedMachine.load`), so a hover
	# on the first frame drawn reads the right status rather than nothing.
	_poll_machine_load()
	_refresh_buffers()
	_reread_every_chunk()
	# Everything above was rebuilt; the next frame must read every snapshot
	# again whatever the revision says (a new game's world starts at 0).
	_polled_revision = -1


## Draws every chunk's FULL snapshot — carried items, machine states,
## splitter arrows — after a rebuild has emptied the item pools. A rebuild
## is followed by `_apply_dirty_chunks`, but that reads only the chunks the
## simulation reports dirty, which after a place/remove/rotate is the chunk
## that changed: on a factory spanning two chunks, every item on a belt in
## the OTHER chunk vanished from the scene until it next moved, and on a
## backed-up belt that is never (the quality pass, 2026-09-13; found by
## reading, proved in test_splitters.gd on its cross-chunk branch). The
## chunks are computed from the placements the layout just gave, the same
## 32-tile grid the sim packs into its chunk ids (`sim::encode_chunk_id`).
func _reread_every_chunk() -> void:
	var seen := {}
	for placement in _placements:
		for pair in placement.get("occupies", []):
			if not (pair is Array) or pair.size() < 2:
				continue
			var chunk := Vector2i(_chunk_coord(int(pair[0])), _chunk_coord(int(pair[1])))
			if seen.has(chunk):
				continue
			seen[chunk] = true
			var packed: int = (chunk.x << 32) | (chunk.y & 0xFFFFFFFF)
			var parsed = JSON.parse_string(sim.chunk_snapshot_json(packed))
			if parsed != null:
				_render_snapshot(parsed)


## Which 32-tile chunk a tile coordinate falls in, on one axis — floored
## division, so -1 is in chunk -1 (`sim::chunk_of`).
func _chunk_coord(t: int) -> int:
	return (t - posmod(t, CHUNK_TILES)) / CHUNK_TILES


## Builds the node (or nodes) for one placement: its body at the centre of
## its ROTATED footprint, turned to face the way the simulation says it
## faces, plus whatever live parts that kind carries — a status lamp, a fill
## body, a progress gauge, a deck for waiting goods.
func _build_placement(placement: Dictionary) -> void:
	var kind := String(placement.get("kind", ""))
	var origin := _placement_origin(placement)
	var direction := _placement_direction(placement)
	var key := _tile_key(origin)
	var size := _rotated_footprint(_footprint_size(placement.get("footprint")), direction)
	var yaw := _direction_yaw(direction)
	var centre := _footprint_centre(origin, size, FLOOR_Y)

	if _is_instanced_kind(kind):
		# A conveyor or pipe tile is one MultiMesh instance, not a node (see
		# the "Instanced tiles and items" section). The yaw is passed
		# separately from the placement's direction on purpose: a pipe's
		# turn is decided by its connections, not its facing (see the pipe
		# constants' doc), a belt corner's (ticket 5) likewise, and this is
		# the one place that decides.
		if kind == PIPE_KIND:
			yaw = float(_pipe_shape_at(origin).get("yaw", yaw))
			# The fittings are instances too — a fitting has no live state —
			# each under its own key, turned to the side it stands on.
			for fitting in _pipe_fittings_at(origin):
				_stage_tile_instance(
					[String(fitting["asset"])], _pipe_fitting_key(origin, String(fitting["to"])),
					centre, float(fitting["yaw"])
				)
		elif kind == BELT_KIND:
			_belt_shapes[key] = _belt_shape_for(placement.get("links", {}), direction)
		_stage_tile_instance(_tile_frames_for(placement), key, centre, yaw)
		if kind == SPLITTER_KIND:
			# The splitter's body is instanced like a belt's, but its lit
			# next-output arrow stays a node: it turns and hides per tile
			# from a live snapshot, which is exactly what an instance in a
			# shared MultiMesh cannot do cheaply.
			var arrow := _asset_node(SPLITTER_ARROW_ASSET)
			arrow.name = "splitter_arrow_%s" % key
			arrow.position = _footprint_centre(origin, size, SPLITTER_ARROW_FLOOR_Y)
			arrow.rotation.y = yaw
			arrow.visible = false
			_world_root.add_child(arrow)
			_splitter_nodes[key] = {"arrow": arrow, "yaw": yaw}
		return

	var body := _asset_node(_asset_for_placement(placement))
	body.name = "%s_%s" % [kind, key]
	body.position = centre
	body.rotation.y = yaw
	_world_root.add_child(body)

	var lamp := body.get_node_or_null("emissive")

	match kind:
		HOPPER_KIND:
			_hopper_nodes[key] = {
				"fill": _build_level_body(HOPPER_FILL_ASSET, origin, size, HOPPER_FILL_FLOOR_Y, yaw, null),
				"lamp": lamp,
				"stocked": true, # forces the first refresh to apply
			}
		FLUID_TANK_KIND:
			_fluid_tank_nodes[key] = {
				"fill": _build_level_body(FLUID_TANK_FILL_ASSET, origin, size, FLUID_TANK_FILL_FLOOR_Y, yaw, null),
				"lamp": lamp,
				"stocked": true,
			}
		DOCK_KIND:
			_dock_nodes[key] = {
				"slots": _build_dock_slots(origin, size, yaw),
				"lamp": lamp,
				"stocked": true,
				# Where a payout's coins are thrown from — the deck's centre,
				# recorded once here rather than re-derived from the slot
				# positions, which are laid out for four cases and are not
				# obliged to stay symmetric about it.
				"anchor": _footprint_centre(origin, size, DOCK_DECK_Y),
			}
		_:
			# A machine: a recipe-running kind. Its status lamp and (for the
			# kinds that declare one) its progress gauge.
			_machine_lamps[key] = lamp
			_machine_running[key] = true
			_set_machine_running(key, false)
			if MACHINE_PROGRESS_GAUGES.has(kind):
				# A SIBLING of the body rather than a child, so
				# `body.get_node_or_null("emissive")` above keeps finding the
				# machine's own lamps and not the gauge's emissive bar, whose
				# material `_set_machine_running` would otherwise swap.
				var gauge := _asset_node(String(MACHINE_PROGRESS_GAUGES[kind]))
				gauge.name = "gauge_%s" % key
				gauge.position = _footprint_centre(origin, size, MACHINE_GAUGE_FLOOR_Y)
				gauge.rotation.y = yaw
				gauge.visible = false
				_world_root.add_child(gauge)
				_machine_gauges[key] = gauge
			_build_machine_motion(key, kind, centre, yaw)
			if kind == CRUSH_KIND:
				# Where the pulp comes out. Recorded with the placement rather
				# than looked up per frame, and taken from the footprint centre
				# (not the body node) so a turned crusher sprays from the same
				# mouth: the feed pocket is carved on the tile's own midline.
				_crush_anchors[key] = _footprint_centre(origin, size, CRUSH_MOUTH_Y)


## One of the one-voxel-tall bodies this scene scales every frame to show a
## live level — the pipe's liquid, the hopper's product, the tank's column
## (UI_UX.md §2b point 5). Shared because all three are the same mechanism,
## differing only in asset, height and tint.
func _build_level_body(
	asset: String, origin: Vector2i, size: Vector2i, height: float, yaw: float,
	material: StandardMaterial3D
) -> Node3D:
	var node := _asset_node(asset)
	node.name = "%s_%s" % [asset, _tile_key(origin)]
	node.position = _footprint_centre(origin, size, height)
	node.rotation.y = yaw
	if material != null:
		for child in node.get_children():
			if child is MeshInstance3D:
				child.set_surface_override_material(0, material)
	_world_root.add_child(node)
	return node


## The pooled nodes the goods waiting on one dock's deck stand in — created
## hidden, revealed by `_update_dock_stock`. Pooled rather than spawned per
## frame for the same reason the item pools are pooled: this is the same "a case standing
## somewhere" node, just standing on a deck instead of on a belt.
func _build_dock_slots(origin: Vector2i, size: Vector2i, yaw: float) -> Array:
	var deck := _footprint_centre(origin, size, DOCK_DECK_Y)
	var slots: Array = []
	for i in range(DOCK_STOCK_SLOTS):
		var offset: Vector2 = DOCK_STOCK_OFFSETS[i]
		var slot := Node3D.new()
		slot.name = "dock_stock_%s_%d" % [_tile_key(origin), i]
		# The vox importer maps low local Y to high world Z, so a slot's
		# model-space Y offset runs the other way in the world (the same
		# mapping `_footprint_centre`'s doc relies on). Rotated with the
		# building, so a turned dock stages its goods on its own near edge.
		var local := Vector3(offset.x * VOXEL_UNIT, 0.0, -offset.y * VOXEL_UNIT)
		slot.position = deck + local.rotated(Vector3.UP, yaw)
		slot.visible = false
		_world_root.add_child(slot)
		slots.append(slot)
	return slots


func _pair_to_tile(pair) -> Vector2i:
	if pair is Array and pair.size() >= 2:
		return Vector2i(int(pair[0]), int(pair[1]))
	return Vector2i.ZERO


## Fills `_machine_states` (what the hover tooltip and the progress gauges
## read) for every placed machine, before any item has moved.
##
## `dirty_chunk_ids` only reports chunks something *changed* in, so an idle
## factory produces no snapshots at all and hovering a machine would show
## nothing until the player pressed a key. This asks the simulation directly,
## via `query_tile_json`, rather than inventing a default state Godot has no
## business knowing.
func _seed_machine_states() -> void:
	_machine_states.clear()
	for placement in _placements:
		if placement.get("recipe") == null:
			continue
		var origin := _placement_origin(placement)
		var parsed = JSON.parse_string(sim.query_tile_json(origin.x, origin.y))
		if parsed == null or parsed.get("kind") != "machine":
			continue
		_machine_states[_tile_key(origin)] = {
			"recipe": parsed["recipe"],
			"process": parsed.get("process"),
			# query_tile deliberately doesn't report buffer contents; the
			# first chunk snapshot fills these in.
			"input": [],
			"output": [],
		}


## Fills `_splitter_states` (and points every arrow) for every placed
## splitter, before any item has moved — `_seed_machine_states`'s twin, and
## it exists for the same reason: `dirty_chunk_ids` only reports chunks
## something CHANGED in, so a splitter that has not yet passed an item
## produces no snapshot and its arrow would stay dark until it did. Which
## way a freshly placed splitter will deal its first item is knowable (it is
## `Side::default()`, straight), so it is asked for rather than guessed at.
func _seed_splitter_states() -> void:
	for placement in _placements:
		if String(placement.get("kind", "")) != SPLITTER_KIND:
			continue
		var origin := _placement_origin(placement)
		var parsed = JSON.parse_string(sim.query_tile_json(origin.x, origin.y))
		if parsed == null or parsed.get("kind") != SPLITTER_KIND:
			continue
		_apply_splitter_state(_tile_key(origin), parsed)


## Points one splitter's arrow at the output its next item will actually
## reach, and remembers the snapshot for the hover tooltip.
##
## **Why this is not simply `next_output`.** The raw field is which side gets
## FIRST REFUSAL, and `sim_core/src/sim/splitter.rs`'s fallback rule is that
## a side which cannot take the item passes it to the other one in the same
## tick — so a splitter whose branch was never built reports `"branch"`
## forever while every item goes straight through it. An arrow drawn from
## that field alone would point at bare floor while product sailed past it in
## the other direction: a readout lying about its own mechanism, which is the
## thing this codebase already refused to build for the fluid tank's head and
## the dock's fill level. So the ONE case the wire can settle is settled
## here — a due side with no output tile (`outputs[i] == null`) hands to the
## other — and it is settled from the `outputs` pair the simulation reports
## precisely so a renderer need not re-derive where they point.
##
## What this deliberately cannot show is a side that is built but momentarily
## FULL, which also falls back. That is transient and invisible on the wire;
## an unbuilt branch is durable and is the mistake a player wants told about.
##
## With neither output connected nothing can leave at all, and the arrow is
## hidden outright — a shape difference (no lit groove anywhere) for a
## splitter that is a dead end.
func _apply_splitter_state(key: String, snapshot: Dictionary) -> void:
	_splitter_states[key] = snapshot
	var nodes: Dictionary = _splitter_nodes.get(key, {})
	if nodes.is_empty():
		return
	var arrow: Node3D = nodes["arrow"]
	var side := _splitter_effective_side(snapshot)
	arrow.visible = side >= 0
	if side >= 0:
		arrow.rotation.y = float(nodes["yaw"]) + (PI * 0.5 if side == SPLITTER_BRANCH else 0.0)


## Which output the next item off `snapshot` will reach — SPLITTER_STRAIGHT,
## SPLITTER_BRANCH, or -1 when neither side is connected to anything. Pure,
## so a test can drive it with a hand-built snapshot.
func _splitter_effective_side(snapshot: Dictionary) -> int:
	var outputs: Array = snapshot.get("outputs", [])
	var due := SPLITTER_BRANCH if String(snapshot.get("next_output", "straight")) == "branch" else SPLITTER_STRAIGHT
	var other := SPLITTER_STRAIGHT if due == SPLITTER_BRANCH else SPLITTER_BRANCH
	if outputs.size() < 2:
		return -1
	if outputs[due] != null:
		return due
	if outputs[other] != null:
		return other
	return -1


# --------------------------------------------------------------------------
# Instanced tiles and items (the pipes & conveyors overhaul, ticket 4)
# --------------------------------------------------------------------------
##
## **A belt, a splitter or a pipe is not a node.** Every tile drawing the same
## asset is one instance in one `MultiMesh` per material class — the same
## shape `_build_floor` already draws the floor with — and every item riding
## a conveyor is one instance in a pool per item asset. Before this, a
## placement was a `Node3D` with a `MeshInstance3D` per class and each
## carried item a pooled `Node3D` moved every tick; at a thousand tiles the
## rebuild a single place/remove/rotate pays, and the per-tick transform
## traffic, were both dominated by node count. A `MultiMesh` is one draw call
## per (asset, class) and a transform write per instance, and the numbers in
## docs/DEVLOG.md's ticket-4 entry are what that bought.
##
## **What stays a node, and why:** anything with LIVE PER-INSTANCE state —
## a machine's swappable status lamp and progress gauge, a hopper's, tank's
## or pipe segment's scaled and retinted level body, a splitter's turning
## arrow, a dock's stock cases, and the ghost. A `MultiMesh` instance has a
## transform and nothing else; giving one of those a material swap means a
## pool per material, and that is a node with extra steps. Machines and
## buildings are also few (tens, not thousands) and multi-tile, so nothing is
## gained. A pipe's FITTINGS (ticket 6) are instances like the shape they
## stand on — a fitting has no live state — while its fluid body stays a
## node: the per-instance scale would fit in a transform, but the tint is
## per network, and a pool per fluid is a node with extra steps.
##
## **Three seams the later tickets build on** (the plan's ticket 5 and 6):
##
## (a) A tile's asset is a FRAME SET — `_tile_frames_for` returns a list of
##     asset names, one per animation frame, and each frame is its own set
##     of per-class `MultiMeshInstance3D`s carrying the SAME transforms.
##     `_set_tile_frame(k)` flips which frame's nodes are visible, so
##     animating a thousand belts costs a handful of visibility flips per
##     frame change, not a thousand transform writes. Belts are four-frame
##     sets since ticket 5 (`_belt_frames_for_shape`); splitters and pipes
##     are one-frame sets.
## (b) A tile's transform is a position plus a YAW handed in by the caller
##     (`_stage_tile_instance`), not derived here from the placement's
##     direction — so a corner tile can be spun independently of the facing
##     the simulation reports.
## (c) An item's transform comes from one function of (tile, direction,
##     distance), `_carried_item_transform`, which reads the tile's recorded
##     shape to bend a corner's items around the arc.
##
## Tests read the result through `_tile_instance_at`, `_carried_item` and
## `_carried_item_count` rather than by node name, since there is no node.

## The kinds drawn as instances. Everything else is a node (see above).
func _is_instanced_kind(kind: String) -> bool:
	return kind == BELT_KIND or kind == PIPE_KIND or kind == SPLITTER_KIND


## The frame set one tile draws with: a list of asset names, one per
## animation frame, all sharing the tile's transform. A belt gets the four
## frames of the shape its `links` give it (the plan's "Belt animation");
## a splitter or pipe is a one-frame set of whatever `_asset_for_placement`
## picks.
func _tile_frames_for(placement: Dictionary) -> Array:
	if String(placement.get("kind", "")) == BELT_KIND:
		return _belt_frames_for_shape(
			_belt_shape_for(placement.get("links", {}), _placement_direction(placement))
		)
	return [_asset_for_placement(placement)]


## One key per distinct frame set, so every tile drawing the same frames
## shares one group of MultiMeshes.
func _tile_set_key(frames: Array) -> String:
	return "|".join(PackedStringArray(frames))


## A tile's instance transform. Yaw about +Y, exactly the rotation a node
## got from `rotation.y = yaw`, so a rotated instance is the same mesh spun
## about its footprint-centre origin (UI_UX.md §2b point 18).
func _tile_transform(position: Vector3, yaw: float) -> Transform3D:
	return Transform3D(Basis(Vector3.UP, yaw), position)


## Records one tile to draw. A `MultiMesh` needs its instance count up front,
## so tiles are staged during a rebuild and built together by
## `_build_tile_instances` once every placement has been seen.
func _stage_tile_instance(frames: Array, key: String, position: Vector3, yaw: float) -> void:
	var set_key := _tile_set_key(frames)
	if not _tile_pending.has(set_key):
		_tile_pending[set_key] = {"frames": frames, "staged": []}
	_tile_pending[set_key]["staged"].append({"key": key, "position": position, "yaw": yaw})


## Turns everything `_stage_tile_instance` collected into MultiMeshes: per
## frame set, per frame, one `MultiMeshInstance3D` per material class, all
## carrying the same transforms in the same instance order. The staged order
## is placement order, which is the simulation's own tile order, so two
## rebuilds of one world are identical.
func _build_tile_instances() -> void:
	_tile_sets.clear()
	_tile_instances.clear()
	for set_key in _tile_pending.keys():
		var pending: Dictionary = _tile_pending[set_key]
		var frames: Array = pending["frames"]
		var staged: Array = pending["staged"]
		var transforms: Array = []
		for entry in staged:
			transforms.append(_tile_transform(entry["position"], entry["yaw"]))
		var frame_nodes: Array = []
		for f in range(frames.size()):
			frame_nodes.append(_build_multimesh_group(
				String(frames[f]), transforms, transforms.size(),
				"tiles_%s_f%d" % [String(frames[f]), f], _tiles_root
			))
		_tile_sets[set_key] = {"frames": frames, "nodes": frame_nodes, "count": staged.size()}
		for i in range(staged.size()):
			var entry: Dictionary = staged[i]
			_tile_instances[entry["key"]] = {
				"set": set_key, "index": i, "asset": String(frames[0]), "frames": frames,
				"position": entry["position"], "yaw": entry["yaw"],
			}
	_tile_pending.clear()
	_set_tile_frame(_belt_frame_for_tick(sim.current_tick()))


## Shows frame `frame` of every multi-frame tile set and hides the rest —
## the whole cost of a belt animation step under instancing. A one-frame set
## is left alone (always visible). Wraps, so a caller can hand in a running
## counter.
func _set_tile_frame(frame: int) -> void:
	_tile_frame = frame
	for set_key in _tile_sets.keys():
		var frame_nodes: Array = _tile_sets[set_key]["nodes"]
		if frame_nodes.size() <= 1:
			continue
		var shown := posmod(frame, frame_nodes.size())
		for f in range(frame_nodes.size()):
			for mmi in frame_nodes[f].values():
				mmi.visible = f == shown


## What is drawn on `tile`, if it is an instanced tile: the record
## `_build_tile_instances` made (`asset`, `frames`, `position`, `yaw`,
## `index`) plus `nodes`, the frame-0 `MultiMeshInstance3D`s it is an
## instance of (empty if no class of the asset imported). `{}` for anything
## that is not a belt, splitter or pipe origin. This is the test seam that
## replaced looking a belt up by node name.
func _tile_instance_at(tile: Vector2i) -> Dictionary:
	var key := _tile_key(tile)
	if not _tile_instances.has(key):
		return {}
	var record: Dictionary = _tile_instances[key].duplicate()
	var set: Dictionary = _tile_sets.get(record["set"], {})
	var frame_nodes: Array = set.get("nodes", [])
	record["nodes"] = frame_nodes[0].values() if not frame_nodes.is_empty() else []
	return record


## Builds one `MultiMeshInstance3D` per material class of `asset` under
## `parent`, each with `capacity` instances of which the first `count`
## (taken from `transforms`) are visible. Returns them keyed by class. Shares
## `_asset_node`'s mesh lookup and per-class materials, so an instanced
## belt is lit and shaded exactly as a node-built one was.
func _build_multimesh_group(
	asset: String, transforms: Array, count: int, name_prefix: String, parent: Node3D,
	capacity := -1
) -> Dictionary:
	if capacity < count:
		capacity = count
	var out := {}
	for class_name_ in _asset_class_names(asset):
		var mesh := _class_mesh_for(asset, class_name_)
		if mesh == null:
			continue
		var multimesh := MultiMesh.new()
		multimesh.transform_format = MultiMesh.TRANSFORM_3D
		multimesh.mesh = mesh
		multimesh.instance_count = capacity
		multimesh.visible_instance_count = count
		for i in range(count):
			multimesh.set_instance_transform(i, transforms[i])
		var mmi := MultiMeshInstance3D.new()
		mmi.name = "%s_%s" % [name_prefix, String(class_name_)]
		mmi.multimesh = multimesh
		mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		var class_material = _class_materials.get(class_name_, null)
		if class_material != null:
			mmi.material_override = class_material
		parent.add_child(mmi)
		out[class_name_] = mmi
	if out.is_empty():
		push_warning("no voxel meshes for '%s' under %s — run `cargo xtask`" % [asset, VOX_DIR])
	return out


## Drops the mesh and material references off every visual instance under
## `node`, to be called just before the subtree is freed. Covers both ways
## this scene draws a tile: the `MultiMeshInstance3D`s `_build_multimesh_group`
## makes, and the plain `MeshInstance3D`s `_asset_node` makes for anything with
## live per-instance state.
##
## Freeing an instance that still held a `material_override` made Godot's
## HEADLESS dummy renderer print `Parameter "material" is null` from
## `material_get_instance_shader_parameters` — the dummy backend has no storage
## entry for the override and looks it up while tearing the instance down. It
## was harmless (a real rendering run never printed it, and every mesh in the
## scene is asserted to have a material by test_machines.gd) but it appeared in
## the middle of the headless suite's output, where the one thing a proof's
## reader must be able to trust is that a line saying ERROR means something IS
## wrong. Dropping the references first leaves the dummy backend nothing to
## resolve.
##
## Note the free is what emits the line, but not synchronously: the message
## surfaces when the rendering server flushes, so instrumenting the `free()`
## calls points at whatever ran next, not at the culprit. Clearing on the way
## out of BOTH instance kinds is what actually silenced it — and it has to run
## at EVERY free, not only the two subtree frees: the ghost body is a lone
## `MeshInstance3D` carrying the tint as a `material_override`, so
## `test_pipe_shapes.gd` still printed the line until `_clear_ghost_body` and
## `_build_ghost_layer` called this too. Anything this scene frees that could
## be holding a mesh goes through here.
func _release_render_resources(node: Node) -> void:
	if node is MultiMeshInstance3D:
		node.material_override = null
		node.multimesh = null
	elif node is MeshInstance3D:
		node.material_override = null
		node.mesh = null
	for child in node.get_children():
		_release_render_resources(child)


## --- The item pools ---------------------------------------------------------
##
## One pool per item asset: a group of per-class MultiMeshes with `capacity`
## instances, of which the first `count` are visible. A slot key (one per
## conveyor slot, see `_render_carried_items`) owns one instance index. Hiding
## an item swap-removes it — the LAST visible instance moves into its index
## — so the visible instances are always a dense prefix and hiding is one
## transform write plus a count, never a rebuild. Growth doubles the
## capacity and replays the live transforms (setting `instance_count` clears
## a MultiMesh's buffer, so a mirror of the transforms is kept in the pool).

## Instances a pool starts with. Growing is cheap and rare, so this is only
## about not doubling six times on the first busy tick.
const ITEM_POOL_INITIAL := 64


func _item_pool_for(asset: String) -> Dictionary:
	if _item_pools.has(asset):
		return _item_pools[asset]
	var pool := {
		"asset": asset, "capacity": ITEM_POOL_INITIAL, "count": 0,
		"keys": [], "transforms": [], "nodes": {},
	}
	pool["nodes"] = _build_multimesh_group(asset, [], 0, "items_%s" % asset, _items_root, ITEM_POOL_INITIAL)
	_item_pools[asset] = pool
	return pool


func _item_pool_grow(pool: Dictionary) -> void:
	var capacity: int = int(pool["capacity"]) * 2
	pool["capacity"] = capacity
	var count: int = pool["count"]
	for mmi in pool["nodes"].values():
		var multimesh: MultiMesh = mmi.multimesh
		multimesh.instance_count = capacity
		for i in range(count):
			multimesh.set_instance_transform(i, pool["transforms"][i])
		multimesh.visible_instance_count = count


## Draws the item for slot `key` as `asset` at `transform`, taking a fresh
## instance if the slot is new (or if its item type changed — the old
## instance is released rather than silently drawing the wrong product).
func _show_carried_item(key: String, asset: String, transform: Transform3D) -> void:
	if _items_root == null:
		return
	if _item_slots.has(key):
		var slot: Dictionary = _item_slots[key]
		if String(slot["asset"]) == asset:
			var pool: Dictionary = _item_pools[asset]
			var index: int = slot["index"]
			pool["transforms"][index] = transform
			for mmi in pool["nodes"].values():
				mmi.multimesh.set_instance_transform(index, transform)
			return
		_hide_carried_item(key)
	var pool := _item_pool_for(asset)
	if int(pool["count"]) >= int(pool["capacity"]):
		_item_pool_grow(pool)
	var index: int = pool["count"]
	pool["count"] = index + 1
	pool["keys"].append(key)
	pool["transforms"].append(transform)
	for mmi in pool["nodes"].values():
		mmi.multimesh.set_instance_transform(index, transform)
		mmi.multimesh.visible_instance_count = index + 1
	_item_slots[key] = {"asset": asset, "index": index}


## Releases slot `key`'s instance. Returns false if the slot was not drawn,
## which `_render_carried_items` uses to find the end of a tile's slots.
func _hide_carried_item(key: String) -> bool:
	if not _item_slots.has(key):
		return false
	var slot: Dictionary = _item_slots[key]
	_item_slots.erase(key)
	var pool: Dictionary = _item_pools[slot["asset"]]
	var index: int = slot["index"]
	var last: int = int(pool["count"]) - 1
	if index != last:
		var moved_key: String = pool["keys"][last]
		var moved: Transform3D = pool["transforms"][last]
		pool["keys"][index] = moved_key
		pool["transforms"][index] = moved
		_item_slots[moved_key]["index"] = index
		for mmi in pool["nodes"].values():
			mmi.multimesh.set_instance_transform(index, moved)
	pool["keys"].resize(last)
	pool["transforms"].resize(last)
	pool["count"] = last
	for mmi in pool["nodes"].values():
		mmi.multimesh.visible_instance_count = last
	return true


## How many conveyor items are drawn right now, across every pool.
func _carried_item_count() -> int:
	return _item_slots.size()


## The item drawn for slot `key` (`"belt_x_y_i"` / `"splitter_x_y_i"`): its
## `asset` and world `position`, or `{}` if that slot is not drawn. The test
## seam that replaced reading a pooled node's `visible` and `position`.
func _carried_item(key: String) -> Dictionary:
	if not _item_slots.has(key):
		return {}
	var slot: Dictionary = _item_slots[key]
	var pool: Dictionary = _item_pools[slot["asset"]]
	var transform: Transform3D = pool["transforms"][slot["index"]]
	return {"asset": String(slot["asset"]), "position": transform.origin}


# --------------------------------------------------------------------------
# Live levels: hoppers, tanks, docks and the liquid in the pipes
# --------------------------------------------------------------------------

## Re-reads every buffer building's own snapshot array and updates the nodes
## built for it. Called every frame, and once at build time so tick 0's
## levels are drawn rather than an empty factory.
##
## Polling rather than waiting on `dirty_chunk_ids` is not a shortcut: a
## tank is drained by the same equalization pass the pipes are and that pass
## deliberately dirties no chunk, so a chunk-driven renderer would sit
## waiting on an event that never comes (see `SimBridge`'s own docs). The
## hopper and dock could be chunk-driven and are polled with them for one
## code path rather than two.
func _refresh_buffers(econ: Dictionary = {}) -> void:
	_hopper_states.clear()
	for snapshot in _read_snapshot_array(sim.hopper_snapshots_json()):
		var key := _tile_key(_pair_to_tile(snapshot.get("tile")))
		_hopper_states[key] = snapshot
		var nodes: Dictionary = _hopper_nodes.get(key, {})
		if nodes.is_empty():
			continue
		var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
		_apply_level(nodes["fill"], fill, HOPPER_MIN_VISIBLE_FILL, HOPPER_FILL_HEIGHT_VOXELS)
		# Retinted only when the item id actually changes: this runs every
		# frame, and a fresh StandardMaterial3D per frame per building is a
		# real cost for a colour that almost never moves.
		var item := String(snapshot.get("item", ""))
		if String(nodes.get("tint", "")) != item:
			nodes["tint"] = item
			_tint_level_body(nodes["fill"], _hopper_fill_material(item))
		_set_lamp_stocked(nodes, fill > HOPPER_MIN_VISIBLE_FILL)

	_fluid_tank_states.clear()
	for snapshot in _read_snapshot_array(sim.fluid_tank_snapshots_json()):
		var key := _tile_key(_pair_to_tile(snapshot.get("tile")))
		_fluid_tank_states[key] = snapshot
		var nodes: Dictionary = _fluid_tank_nodes.get(key, {})
		if nodes.is_empty():
			continue
		var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
		_apply_level(nodes["fill"], fill, FLUID_TANK_MIN_VISIBLE_FILL, FLUID_TANK_FILL_HEIGHT_VOXELS)
		var fluid := _fluid_id_of(snapshot)
		if String(nodes.get("tint", "")) != fluid:
			nodes["tint"] = fluid
			_tint_level_body(nodes["fill"], _fluid_material_for(fluid))
		_set_lamp_stocked(nodes, fill > FLUID_TANK_MIN_VISIBLE_FILL)

	_dock_states.clear()
	for snapshot in _read_snapshot_array(sim.dock_snapshots_json()):
		_dock_states[_tile_key(_pair_to_tile(snapshot.get("tile")))] = snapshot

	# The economy is parsed by the caller when it already has it (a frame's
	# poll reads it once for the clipboard, the deck and the board).
	if econ.is_empty():
		econ = _read_economy()
	_last_dock_stock = econ.get("delivery_stock", [])
	# The pool's ceiling and whether it is at it (the dock-capacity change).
	# Both are facts about the ONE shared pool, so they are read here, once,
	# rather than off each dock's own snapshot — which carries `full` too, for
	# a chunk-driven reader with no economy in hand.
	_delivery_capacity = int(econ.get("delivery_capacity", 0))
	_delivery_full = bool(econ.get("delivery_full", false))
	_update_dock_stock(_last_dock_stock, _delivery_full, sim.current_tick())


## Parses one of the SimBridge calls that returns an ARRAY of snapshots —
## hoppers, tanks, docks, fluid networks. All four became arrays in ticket 1
## (a world may hold none or several of each), so they get one reader.
func _read_snapshot_array(json: String) -> Array:
	if json.is_empty():
		return []
	var parsed = JSON.parse_string(json)
	return parsed if parsed is Array else []


func _read_fluid_snapshots() -> Array:
	return _read_snapshot_array(sim.fluid_snapshots_json())


## Scales one of the one-voxel-tall level bodies to a live fraction, hiding
## it outright below a minimum rather than drawing a sub-voxel sliver that
## would z-fight whatever it stands on.
func _apply_level(node: Node3D, fraction: float, minimum: float, height_voxels: int) -> void:
	if node == null:
		return
	node.visible = fraction > minimum
	if node.visible:
		node.scale.y = fraction * float(height_voxels)


func _tint_level_body(node: Node3D, material: StandardMaterial3D) -> void:
	if node == null or material == null:
		return
	for child in node.get_children():
		if child is MeshInstance3D:
			child.set_surface_override_material(0, material)


## A hopper's product body is near-white so a per-item tint multiplies
## cleanly over it — *which* item a hopper holds is simulation data.
func _hopper_fill_material(item_id: String) -> StandardMaterial3D:
	var base: StandardMaterial3D = _class_materials.get("matte", null)
	var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.95)
	mat.albedo_color = HOPPER_FILL_TINTS.get(item_id, HOPPER_FILL_TINT_FALLBACK)
	return mat


## Swaps a building's status lamp between the same idle/running materials a
## machine's lamp uses (UI_UX.md §4/§7: saturated colour reserved for
## meaning). One helper for all three buffer kinds, since "holds stock" is
## the one state a buffer has.
func _set_lamp_stocked(nodes: Dictionary, stocked: bool) -> void:
	if bool(nodes.get("stocked", false)) == stocked:
		return
	nodes["stocked"] = stocked
	var lamp = nodes.get("lamp")
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if stocked else _lamp_idle)


## Stands one case per unit of stock waiting to be sold on EVERY dock's deck,
## up to DOCK_STOCK_SLOTS each, drawn with that item's own model.
##
## Every dock shows the same pool, deliberately: `EconomySnapshot`'s
## `delivery_stock` is one shared number however many docks the player
## builds (a second dock is another door out of the factory, not a second
## ledger), and the dock's own `contents` empties every tick, so a per-dock
## figure would be zero forever — see DOCK_ASSET's doc.
##
## `full` says the pool has hit `DELIVERY_STOCK_CAPACITY` for something and
## the docks are refusing the belt (the dock-capacity change, 2026-09-16).
## A full deck already looks like a full deck — the cases cap out at
## DOCK_STOCK_SLOTS long before the pool does — so the state gets the one
## channel a stack of crates does not have: the lamp PULSES instead of
## holding, off `current_tick`.
##
## Pure given `stock`, `full`, `current_tick` and the built nodes, so a test
## can drive it directly.
func _update_dock_stock(stock: Array, full := false, current_tick := 0) -> void:
	# Flatten the pool's (item, quantity) pairs into one case per unit, in
	# snapshot order, so a multi-item pool shows a mixed stack rather than
	# only its first product.
	var waiting: Array[String] = []
	for pair in stock:
		if not (pair is Array) or pair.size() < 2:
			continue
		for _i in range(int(pair[1])):
			if waiting.size() >= DOCK_STOCK_SLOTS:
				break
			waiting.append(String(pair[0]))

	for key in _dock_nodes.keys():
		var nodes: Dictionary = _dock_nodes[key]
		var slots: Array = nodes.get("slots", [])
		for i in range(slots.size()):
			var slot: Node3D = slots[i]
			if i >= waiting.size():
				slot.visible = false
				continue
			var asset: String = ITEM_MODELS.get(waiting[i], ITEM_MODEL_FALLBACK)
			var current := slot.get_node_or_null("case")
			if current == null or String(current.get_meta("asset", "")) != asset:
				if current != null:
					slot.remove_child(current)
					_release_render_resources(current)
					current.queue_free()
				var node := _asset_node(asset)
				node.name = "case"
				node.set_meta("asset", asset)
				slot.add_child(node)
			slot.visible = true
		_set_lamp_stocked(nodes, _dock_lamp_lit(not waiting.is_empty(), full, current_tick))


## Whether a dock's lamp is lit this tick: steady while it merely holds
## stock, blinking once the pool is full. Split out and pure so
## `test_presentation.gd` can assert the blink without a rendered frame, and
## so the one place the rule lives is readable: a full dock is the only thing
## in the scene whose lamp is not a straight reading of "has something".
func _dock_lamp_lit(stocked: bool, full: bool, current_tick: int) -> bool:
	if not full:
		return stocked
	@warning_ignore("integer_division")
	var phase := int(current_tick / DOCK_FULL_PULSE_TICKS)
	return phase % 2 == 0


## A network's or tank's fluid id, or "" — `fluid` is NULLABLE on the wire
## (a run no machine taps has not been told what it carries), and `String(null)`
## is a hard error in GDScript rather than an empty string.
func _fluid_id_of(snapshot: Dictionary) -> String:
	var value = snapshot.get("fluid")
	return String(value) if value != null else ""


## The liquid's material: palette.ron's own `liquid` class numbers (glossy
## dielectric — UI_UX.md §4's "visible liquid surfaces ... with subtle
## shading/reflection"), tinted per fluid id. Only the tint is decided here;
## the shading numbers stay in palette.ron like every other material.
func _fluid_material_for(fluid_id: String) -> StandardMaterial3D:
	var base: StandardMaterial3D = _class_materials.get("liquid", null)
	var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.14)
	mat.albedo_color = FLUID_TINTS.get(fluid_id, FLUID_TINT_FALLBACK)
	return mat


## Re-reads every fluid network and resizes each segment's liquid body to its
## live fill fraction. Cheap by design, and polled for the reason
## `sim::FluidSnapshot`'s own doc gives: fluid moves on nearly every tick and
## deliberately does not dirty its chunk.
##
## The liquid bodies are created here rather than in `_build_placement`,
## because which network a pipe tile belongs to is decided by the whole run,
## and a network's fluid — which decides the tint — is decided by whichever
## machine taps it, so both are only known once the snapshots are read.
func _update_fluid_network() -> void:
	_last_fluid = _read_fluid_snapshots()
	for n in range(_last_fluid.size()):
		var network: Dictionary = _last_fluid[n]
		var material := _fluid_material_for(_fluid_id_of(network))
		var segments: Array = network.get("segments", [])
		for s in range(segments.size()):
			var segment: Dictionary = segments[s]
			var node := _fluid_body_for(n, s, segment, material)
			if node == null:
				continue
			var pressure: float = clampf(float(segment.get("pressure", 0.0)), 0.0, 1.0)
			_apply_level(node, pressure, FLUID_MIN_VISIBLE_PRESSURE, PIPE_BORE_HEIGHT_VOXELS)
	_update_pipe_fault_markers()


## Stands a hazard clamp (`PIPE_FAULT_ASSET`) on every tile of every run the
## simulation says it cannot name, and takes it off again the moment the
## player fixes the run — issue #54.
##
## **Why it exists at all.** An unnamed run is empty and a working run
## waiting for its first fill is empty, and until this they rendered
## identically: a bare pipe with an invisible liquid body. One of them means
## "any moment now" and the other means "this will never work", which is how
## a whole branch of the factory was built stalled without a word.
##
## **The verdict comes from the wire, never from here** (`CLAUDE.md`'s first
## rule). `FluidSnapshot.naming` is the sim's own, one of `carries` /
## `unplumbed` / `unnameable` / `ambiguous`, and only the last two are
## faults: a run joined to nothing is `unplumbed`, which is what every run
## looks like while the player is still laying it, and marking that would be
## noise on ordinary building. Nothing in this function looks at whether
## `fluid` is null.
##
## Keyed by TILE rather than by `(network, segment)` like the liquid bodies
## beside it: the topology renumbers networks on every placement, and the
## clamps have to survive a run being split or joined without a full rebuild
## — so the desired set is recomputed from the snapshot each poll and
## reconciled against what stands.
func _update_pipe_fault_markers() -> void:
	if _world_root == null:
		return
	var faulted: Dictionary = {}
	for network in _last_fluid:
		if not PIPE_FAULT_NAMINGS.has(String(network.get("naming", ""))):
			continue
		for segment in network.get("segments", []):
			var tile := _pair_to_tile(segment.get("tile", [0, 0]))
			faulted[_tile_key(tile)] = tile
	for key in _pipe_fault_nodes.keys():
		if faulted.has(key):
			continue
		var stale: Node3D = _pipe_fault_nodes[key]
		_pipe_fault_nodes.erase(key)
		if stale != null and is_instance_valid(stale):
			stale.get_parent().remove_child(stale)
			_release_render_resources(stale)
			stale.free()
	for key in faulted:
		if _pipe_fault_nodes.has(key):
			continue
		var tile: Vector2i = faulted[key]
		var node := _asset_node(PIPE_FAULT_ASSET)
		node.name = "%s_%s" % [PIPE_FAULT_ASSET, key]
		node.position = _tile_origin(tile.x, tile.y, FLOOR_Y)
		# No yaw: the clamp is square about the tile's midline and unchanged
		# by a quarter turn (`a_pipe_fault_clamp_is_unchanged_by_a_quarter_turn`),
		# so it covers a straight, a corner and a tee alike without ever
		# being turned to its host's facing.
		_world_root.add_child(node)
		_pipe_fault_nodes[key] = node


## The liquid body sitting in one pipe segment's bore, created on first
## sight. Keyed by (network, segment) rather than pooled in an array, because
## a placement can add or remove a whole network between frames.
func _fluid_body_for(network_index: int, segment_index: int, segment: Dictionary,
		material: StandardMaterial3D) -> Node3D:
	if _world_root == null:
		return null
	var key := "%d:%d" % [network_index, segment_index]
	if _pipe_fluid_nodes.has(key):
		# Deliberately NOT retinted here: this runs every frame, and a
		# network's fluid is decided by whichever machine taps it, which only
		# changes when something is placed — and a placement rebuilds these.
		return _pipe_fluid_nodes[key]
	var tile := _pair_to_tile(segment.get("tile", [0, 0]))
	# The body matching the tile's SHAPE, at the shape's own turn, so a
	# corner's liquid turns with its bore, a tee's fills its branch and an
	# end's stops where its cap starts (each body is authored to reach only
	# its shape's open faces — the voxgen tests pin that).
	var shape := _pipe_shape_at(tile)
	var fluid_asset := String(shape.get("fluid_asset", PIPE_FLUID_ASSET))
	var node := _asset_node(fluid_asset)
	node.name = "%s_%s" % [fluid_asset, _tile_key(tile)]
	node.position = _tile_origin(tile.x, tile.y, PIPE_BORE_FLOOR_Y)
	node.rotation.y = float(shape.get("yaw", _direction_yaw(String(segment.get("direction", "east")))))
	_tint_level_body(node, material)
	_world_root.add_child(node)
	_pipe_fluid_nodes[key] = node
	return node


## How far through its current process the machine at `origin_key` is, as
## 0..1, or -1.0 when it is idle. Derived from `_machine_states`'s own
## `process` = `[start_tick, required_ticks]` pair plus the simulation's
## current tick — NOT from a per-tick snapshot, and that distinction matters
## here more than anywhere else in this file: a machine only dirties its
## chunk when its state actually changes, so through the whole of a process
## no snapshot arrives at all. Recomputing from `current_tick()` every frame
## is what makes a long process animate smoothly rather than jump when it
## ends. Pure, so it is directly testable.
func _machine_progress(origin_key: String) -> float:
	if not _machine_states.has(origin_key):
		return -1.0
	var process = _machine_states[origin_key].get("process")
	if process == null:
		return -1.0
	var required: int = int(process[1])
	if required <= 0:
		return -1.0
	var elapsed: int = sim.current_tick() - int(process[0])
	return clampf(float(elapsed) / float(required), 0.0, 1.0)


## Rescales every declared progress gauge to its machine's live process
## fraction — the same one-poll/one-scaled-body pattern the pipe's liquid and
## the hopper's and tank's levels use, deliberately reused rather than
## invented again.
func _update_machine_gauges() -> void:
	for origin_key in _machine_gauges.keys():
		var gauge: Node3D = _machine_gauges[origin_key]
		if gauge == null:
			continue
		var fraction := _machine_progress(origin_key)
		gauge.visible = fraction > MACHINE_GAUGE_MIN_VISIBLE
		if gauge.visible:
			gauge.scale.y = fraction * float(MACHINE_GAUGE_HEIGHT_VOXELS)


## Stands this machine's motion overlay on its tiles: `MACHINE_FRAMES`
## sibling nodes at the body's own position and facing, all but frame 0
## hidden. Siblings rather than children of the body for the reason the
## progress gauge is one — `body.get_node_or_null("emissive")` must keep
## finding the machine's own status lamp, not a lamp inside an overlay.
##
## Built once per placement and never rebuilt: a frame swap is two visibility
## flips, which is what makes `_update_machine_motion` cheap enough to run
## every simulation step for every machine on the map.
func _build_machine_motion(key: String, kind: String, centre: Vector3, yaw: float) -> void:
	var family := String(MACHINE_MOTION_MODELS.get(kind, MACHINE_MOTION_FALLBACK))
	var frames: Array = []
	for k in range(MACHINE_FRAMES):
		var frame := _asset_node("%s_f%d" % [family, k])
		frame.name = "motion_%s_f%d" % [key, k]
		# The same position as the body, not a computed offset: `voxgen`
		# gives every overlay the body's own footprint and puts both models'
		# origins at footprint centre, ground level (UI_UX.md §2b point 1),
		# so anything else here would be undoing that agreement.
		frame.position = centre
		frame.rotation.y = yaw
		frame.visible = k == 0
		_world_root.add_child(frame)
		frames.append(frame)
	# The family is kept beside the nodes rather than recomputed: it is what
	# a test (and a future hover readout) asks to find out WHICH overlay a
	# kind fell through to, and the fallback is the whole point of asking.
	_machine_motion[key] = {"frames": frames, "frame": 0, "family": family}


## How many ticks of WORK the machine at `origin_key` has done on its current
## batch, or -1 when it is not working.
##
## "Working" is deliberately narrower than "has a process", and this is the
## one piece of sim knowledge this whole feature turns on. `Machine::tick`
## (`sim_core/src/sim/machine.rs`) clears `process` only once it can actually
## put the finished goods somewhere: a machine that has finished its batch
## and is blocked on a full output buffer or a full pipe KEEPS its process
## and retries every tick. So `process != null` means "has a batch", which is
## what the status lamp already says, and `elapsed < required` means "is
## turning". Reading the first as the second would leave a jammed factory
## full of machines cheerfully running with nowhere to put anything — the
## exact opposite of what the player needs to see.
##
## Derived from `current_tick()` rather than from a snapshot, like
## `_machine_progress` above and for that section's reason: a machine dirties
## its chunk when its state CHANGES, so nothing arrives during a process.
func _machine_work_elapsed(origin_key: String) -> int:
	if not _machine_states.has(origin_key):
		return -1
	var process = _machine_states[origin_key].get("process")
	if process == null:
		return -1
	var required: int = int(process[1])
	var elapsed: int = sim.current_tick() - int(process[0])
	if elapsed < 0 or elapsed >= required:
		return -1
	return elapsed


## Which frame a mechanism `elapsed` ticks into its batch shows. Driven by
## the machine's OWN elapsed ticks rather than by the global tick (which is
## what drives the belt), so every mechanism starts its cycle from frame 0 at
## the moment work starts, instead of joining a factory-wide beat part way
## through. Pure, so it is directly testable.
func _motion_frame_for_elapsed(elapsed: int) -> int:
	if elapsed < 0:
		return 0
	return posmod((elapsed * MACHINE_FRAMES) / MACHINE_TICKS_PER_CYCLE, MACHINE_FRAMES)


## Shows the frame each machine's mechanism currently calls for. Called from
## `_advance_simulation` and nowhere else, exactly like `_update_belt_frame`:
## the paused early-return never reaches it, so the pause menu stops the
## machinery for free, and a headless test that never ticks sees frame 0.
##
## An idle or blocked machine is put back to frame 0 — its parts stay on the
## machine (they are the same solid the body had before this pass), they
## simply stop. Paired with the status lamp that is a two-part readout the
## player can act on: lamp on and nothing turning means the thing downstream
## is full.
func _update_machine_motion() -> void:
	for origin_key in _machine_motion.keys():
		var motion: Dictionary = _machine_motion[origin_key]
		var frame := _motion_frame_for_elapsed(_machine_work_elapsed(origin_key))
		if frame == int(motion.get("frame", 0)):
			continue
		var frames: Array = motion["frames"]
		var previous: Node3D = frames[int(motion["frame"])]
		if previous != null:
			previous.visible = false
		var current: Node3D = frames[frame]
		if current != null:
			current.visible = true
		motion["frame"] = frame


## Whether the load is due a re-read: never read yet, or LOAD_POLL_TICKS
## of simulation since the last one. Against the sim's clock, not a frame
## count, so a burst of catch-up ticks in one frame still polls on schedule
## and a paused game (no ticks) never polls at all.
func _machine_load_poll_due() -> bool:
	return _load_polled_tick < 0 or sim.current_tick() - _load_polled_tick >= LOAD_POLL_TICKS


## Re-reads every machine's load and stall from the simulation into the
## records the hover panel draws from. The record keeps the LAST reason the sim
## gave while the status holds: a stall is a per-tick fact and is `null` on
## most ticks of a blocked machine (it is mid-craft on most of them; the
## reason appears only on the ticks a finished batch is held), so a hover
## that showed exactly this tick's field would flicker between "output
## full" and nothing. A status change forgets the old reason, because it was
## the reason for the old status.
func _poll_machine_load() -> void:
	_load_polled_tick = sim.current_tick()
	var parsed = JSON.parse_string(sim.machine_load_snapshots_json())
	if not (parsed is Array):
		return
	for entry in parsed:
		if not (entry is Dictionary):
			continue
		var key := _tile_key(_pair_to_tile(entry.get("tile", [0, 0])))
		var load = entry.get("load", {})
		if not (load is Dictionary):
			continue
		var status := String(load.get("status", ""))
		var stall = entry.get("stall")
		var record: Dictionary = _machine_load.get(key, {"reason": null, "status": ""})
		if String(record.get("status", "")) != status:
			record["reason"] = null
		if stall is Dictionary:
			record["reason"] = stall
		record["load"] = load
		record["stall"] = stall
		record["status"] = status
		_machine_load[key] = record


## The stall reason in words. Item ids go through `_item_display_name` like
## every other id the player reads; an unknown kind says nothing rather than
## guessing, and a `null` stall is no reason at all.
func _stall_reason_text(stall) -> String:
	if not (stall is Dictionary):
		return ""
	# A staff refusal names the CATEGORY in `item` (the staff pools MVP);
	# it is a plain word, not an item id, so it does not go through
	# `_item_display_name`.
	if String(stall.get("kind", "")) == "staff":
		return "short of %s staff" % String(stall.get("item", ""))
	var item := _item_display_name(String(stall.get("item", "")))
	match String(stall.get("kind", "")):
		"input":
			return "waiting for %s" % item
		"fluid_input":
			return "waiting for %s in the pipe" % item
		"no_supply_pipe":
			return "no supply pipe for %s" % item
		# The two kinds a run that cannot be named produces (issue #54).
		# They REPLACE what this machine used to say — "no supply pipe" about
		# a pipe the player had laid, or "outlet pipe full" about an empty
		# one — so the sentence has to name the run as the thing at fault and
		# point at the fix, which differs between them: nothing can name this
		# run (a source facing the wrong way) versus this run could be
		# several things (two sources merged into it).
		"unnameable_pipe":
			return "its pipe run carries nothing — check what feeds it"
		"ambiguous_pipe":
			return "its pipe run could carry more than one fluid"
		"output":
			return "output full"
		"fluid_output":
			return "outlet pipe full"
		"no_outlet_pipe":
			return "no outlet pipe"
	return ""


## The load line of a machine's hover text — a status glyph and word, the
## share of the window spent working, and (for a machine that is waiting)
## why:
##   `● flat out · 100% of the last 10s`
##   `▲ starved · 38% busy · waiting for Sugar`
##   `■ blocked · 61% busy · output full`
## The glyph is the indicator's SHAPE (a lit lens, a warning triangle, a
## stop block) so the status is never carried by the bar's colour alone
## (UI_UX.md §7). The "10s" is the sim's own window over TICK_HZ, never
## typed here, so a retuned `LOAD_BUCKETS` reads right without a Godot
## edit. Empty when the machine has not been polled (a kind the sim does
## not measure). Pure given `_machine_load`, so a test drives it with a
## record.
func _machine_load_text(origin_key: String) -> String:
	if not _machine_load.has(origin_key):
		return ""
	var record: Dictionary = _machine_load[origin_key]
	var load: Dictionary = record.get("load", {})
	var status := String(record.get("status", ""))
	var percent := int(load.get("percent", 0))
	var glyph := String(LOAD_STATUS_GLYPHS.get(status, ""))
	var lead := "%s " % glyph if glyph != "" else ""
	if status == "working":
		var window_seconds := int(round(float(load.get("window", 0)) / TICK_HZ))
		return "%sflat out  ·  %d%% of the last %ds" % [lead, percent, window_seconds]
	var line := "%s%s  ·  %d%% busy" % [lead, status, percent]
	var reason := _stall_reason_text(record.get("reason"))
	if reason != "":
		line += "  ·  %s" % reason
	return line


func _set_machine_running(origin_key: String, running: bool) -> void:
	if _machine_running.get(origin_key, null) == running:
		return
	_machine_running[origin_key] = running
	var lamp: MeshInstance3D = _machine_lamps.get(origin_key, null)
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if running else _lamp_idle)


# --------------------------------------------------------------------------
# Camera & lighting
# --------------------------------------------------------------------------

## UI_UX.md §1: a FIXED orthographic isometric camera. No orbit, no free
## rotation — the voxel assets are modelled to read from fixed angles, and a
## free camera would expose silhouettes nothing was art-directed for. Pan
## (WASD/arrows) and zoom (scroll wheel) are explicitly allowed by that same
## section and don't touch the angle: pan moves `_camera_focus`, zoom moves
## `_camera_size`, orientation is always recomputed the same way.
##
## The angle used is true isometric (an equal-parts (1, 1, 1) view direction,
## ~35.26 degrees of elevation), not a 2:1 dimetric. UI_UX.md §9 explicitly
## leaves the final choice open pending a side-by-side prototype; this picks
## the one that keeps voxel cubes perfectly regular on screen, and changing
## it later is one constant here, not an asset change.
const CAMERA_DIRECTION := Vector3(1, 1, 1)
## Orthographic, so this only sets the near/far window, not apparent size.
const CAMERA_DISTANCE := 160.0

# --- Navigation (zoom + pan) -----------------------------------------------
# UI_UX.md §1 explicitly allows smooth zoom and only forbids free rotation —
# the fixed isometric angle itself never changes here, only `size` (zoom) and
# `_camera_focus` (pan) do.
const ZOOM_STEP := 0.1 # fraction of current size per scroll notch, mouse wheel or +/-
const ZOOM_MIN_FACTOR := 0.3 # most zoomed in, relative to the auto-framed size
const ZOOM_MAX_FACTOR := 3.0 # most zoomed out
const PAN_SPEED := 0.9 # fraction of the visible size crossed per second at held-key pan
# InputEventPanGesture.delta is in gesture-magnitude units, not wheel notches,
# and arrives many times per swipe — this converts one unit of that delta
# into a fraction of ZOOM_STEP's effect, tuned so a normal swipe feels
# similar in speed to a few wheel notches, not a single giant jump.
const TRACKPAD_ZOOM_SENSITIVITY := 0.01
const ISO_NEAR := 0.5

# --- First-person mode -----------------------------------------------------
# Not a UI_UX.md concept — a free-look "fly" camera for looking around the
# factory up close. No gravity, no collision: this project has no player
# entity or collision shapes on the voxel meshes, so it deliberately doesn't
# pretend to be one.
const FP_MOVE_SPEED := 15.0 # world units/second (~4.7 tiles/second)
const FP_MOUSE_SENSITIVITY := 0.0025 # radians per pixel of relative mouse motion
const FP_PITCH_LIMIT := deg_to_rad(89.0) # stop just short of looking straight up/down
const FP_FOV := 75.0
const FP_NEAR := 0.05 # much closer than ISO_NEAR — this mode gets right up next to machines
const CROSSHAIR_SIZE := 14.0 * UI_SCALE # px, each bar's length
const CROSSHAIR_THICKNESS := 2.0 * UI_SCALE # px, each bar's width

# The **C: collect product** hint these two used to carry is gone, with the
# key that drove it: the delivery-dock ticket deleted
# `PlayerCommand::CollectOutput` outright, because the chain now ends in a
# real dock that ships into the delivery pool every tick by itself. A key
# that quietly did nothing would be worse than no key — `issue_command_json`
# treats an unknown command as a silent no-op, so the legend would have been
# advertising a control the simulation no longer has.
## Three keys are new in the "Real Placement" epic's ticket 2, and they are
## what a build mode is made of. **R** turns things: it cycles the ghost's
## facing while placing, and — outside placement mode — rotates whatever is
## under the cursor in place, so turning a belt you already laid needs no
## pick-up-and-re-place round trip. **X** toggles remove mode, a mode rather
## than a modifier-click precisely because it is destructive and a mode is
## visible in this legend and in the on-screen prompt, where a held key is
## not. **ESC** leaves either. All three are free in both view modes (R, X
## and ESC collided with nothing), and the left mouse button — which
## `_unhandled_input` had deliberately left unbound "so a future
## click-to-build has nothing to fight with" — is now that click.
## Two LINES, not one. Build mode added three keys and a mouse button to a
## legend that already ran the width of the window, and a single line was
## being clipped behind the contract clipboard in the top-right corner — the
## kind of thing only a rendered frame shows (UI_UX.md §2b point 12). The
## build controls lead, because they are what the player does most.
## FOUR lines, not two, and that is a consequence of the 2026-09-09 UI-scale
## pass rather than of new controls: at half again the font size the old
## two-line legend ran clean off a 1280-wide window and under the contract
## clipboard. It is grouped by what each key is FOR — build-mode verbs, the
## panels, then the camera — which is a better reading order than the flat
## run-on it was anyway. ESC's entry names both of its meanings (close what
## is open, else the pause menu — see `_anything_open`).
##
## **Three keys came OFF it with the click-to-configure ticket** (Q, SPACE
## and V), and one line replaced all three: "click a hopper or tank:
## configure". That is the legend doing what it is for — a keybind has to be
## listed here or it is undiscoverable, whereas a building you can click
## announces itself on hover, so the line is a pointer rather than the only
## way to find out.
##
## FIVE lines, not four (the quality pass, ticket 5): H and P joined the
## panels line after it already carried E/M/C, and at that length the panel
## group plus the configure hint ran back under the contract clipboard at
## 1600x900 — the exact clipping this comment already describes happening
## once, recurring because the panels line keeps growing and nothing caps
## its width. The configure hint is its own line now, so the panels line
## stays five short entries and neither line reaches the clipboard's left
## edge at this window size.
const ISO_HELP_TEXT := "1-9/0: pick from hotbar    click: place    R: rotate\nX: remove mode    ESC: close / pause menu\nE: build menu    M: market    C: contracts    H: staff    P: production\nclick a hopper or tank: configure\nWASD/drag/arrows: pan    scroll/+-: zoom    TAB: first-person"
const FP_HELP_TEXT := "1-9/0: pick from hotbar    click: place    R: rotate\nX: remove mode    ESC: close / pause menu\nE: build menu    M: market    C: contracts    H: staff    P: production\nclick a hopper or tank: configure\nWASD: move    mouse: look    SPACE/SHIFT: up/down    TAB: isometric"


## The tile box the isometric camera frames at startup: whatever is placed,
## widened to at least EMPTY_WORLD_FRAME_TILES in each axis about its own
## centre. The widening is what makes an EMPTY world (the new starting state)
## open on a usable expanse of floor instead of on one tile — there is no
## chain to frame any more, and "frame nothing" has to mean something.
func _framing_bounds() -> Rect2i:
	var bounds := _world_tile_bounds()
	var span_x: int = maxi(bounds.size.x, EMPTY_WORLD_FRAME_TILES)
	var span_y: int = maxi(bounds.size.y, EMPTY_WORLD_FRAME_TILES)
	var centre_x: float = float(bounds.position.x) + float(bounds.size.x) * 0.5
	var centre_y: float = float(bounds.position.y) + float(bounds.size.y) * 0.5
	return Rect2i(
		Vector2i(int(round(centre_x - float(span_x) * 0.5)), int(round(centre_y - float(span_y) * 0.5))),
		Vector2i(span_x, span_y)
	)


func _build_camera() -> void:
	# Framed on whatever is placed, padded out to at least a workable square
	# of floor — which for a NEW GAME (nothing placed at all) means the view
	# opens on empty ground around the origin rather than zoomed into a
	# single tile. Framing happens once, at build time: re-framing on every
	# placement would yank the view around while the player is building.
	_frame_bounds = _framing_bounds()
	_camera_focus = Vector3(
		(float(_frame_bounds.position.x) + float(_frame_bounds.size.x) * 0.5) * TILE,
		TILE * 0.35,
		(float(_frame_bounds.position.y) + float(_frame_bounds.size.y) * 0.5) * TILE
	)

	var camera := Camera3D.new()
	camera.name = "IsometricCamera"
	camera.projection = Camera3D.PROJECTION_ORTHOGONAL
	# KEEP_WIDTH so `size` means the horizontal extent: the factory is a long
	# horizontal line, and it must stay framed regardless of window aspect.
	camera.keep_aspect = Camera3D.KEEP_WIDTH
	camera.near = ISO_NEAR
	camera.far = 600.0
	add_child(camera)
	_camera = camera

	# Position/orient first (size doesn't affect orientation) so the camera's
	# own basis exists to read the ground-plane screen axes from — right is
	# already horizontal (up hint is world Y and the view direction isn't
	# vertical); "screen forward" is the view direction (-basis.z) projected
	# onto the ground. WASD/arrows pan along these, not raw world X/Z, so
	# panning still feels like up/down/left/right on screen regardless of the
	# fixed isometric angle.
	_camera_size = 1.0
	_update_camera_transform()
	_pan_right = _camera.transform.basis.x
	var forward := -_camera.transform.basis.z
	_pan_forward = Vector3(forward.x, 0.0, forward.z).normalized()

	_camera_base_size = _framing_size(_camera.transform.basis)
	_camera_size = _camera_base_size
	_update_camera_transform()
	camera.call_deferred("make_current")


## Repositions/reorients the camera from `_camera_focus`/`_camera_size` —
## called once at build time and again whenever pan or zoom changes. Cheap
## enough to call every time rather than tracking a dirty flag.
func _update_camera_transform() -> void:
	if _camera == null:
		return
	# `look_at_from_position` rather than position-then-`look_at`: the latter
	# requires the node to already be inside the tree, which isn't guaranteed
	# for a scene instantiated and driven manually (as the headless tests do).
	_camera.look_at_from_position(
		_camera_focus + CAMERA_DIRECTION.normalized() * CAMERA_DISTANCE,
		_camera_focus,
		Vector3.UP
	)
	_camera.size = _camera_size


func _zoom_camera(factor: float) -> void:
	var min_size := _camera_base_size * ZOOM_MIN_FACTOR
	var max_size := _camera_base_size * ZOOM_MAX_FACTOR
	_camera_size = clampf(_camera_size * factor, min_size, max_size)
	_update_camera_transform()


func _pan_camera(delta: float) -> void:
	_apply_pan(_pan_input_direction(), delta)


## Reads held keys only — no movement math, so this is the one part of
## panning that can't be exercised without a live Input singleton.
func _pan_input_direction() -> Vector3:
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += _pan_forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= _pan_forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += _pan_right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= _pan_right
	return move


## The actual movement, deliberately Input-free so it's directly testable
## (test_camera_nav.gd calls this with an explicit direction).
func _apply_pan(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	# Scaled by current `_camera_size`, not a flat world-unit speed, so pan
	# covers the same fraction of the visible view per second whether zoomed
	# in or out — a flat speed would feel sluggish when zoomed out and
	# twitchy when zoomed in.
	_camera_focus += direction.normalized() * PAN_SPEED * _camera_size * delta
	_update_camera_transform()


## World units per screen pixel at the current zoom — the conversion factor
## that makes click-and-drag panning track the cursor 1:1 (the point under
## the cursor when the drag started stays under it), rather than an arbitrary
## fixed speed that would feel wrong at every zoom level except one.
func _iso_drag_sensitivity() -> float:
	var width := 0.0
	var vp := get_viewport()
	if vp != null:
		width = vp.get_visible_rect().size.x
	if width <= 0.0:
		# A script-mode SceneTree (this project's own headless tests included)
		# never sizes a real window, so `get_viewport()` reports a zero-size
		# rect — fall back to the project's configured window width so drag
		# panning still does something reasonable instead of silently no-op'ing.
		width = float(ProjectSettings.get_setting("display/window/size/viewport_width", 1280))
	if width <= 0.0:
		return 0.0
	return _camera_size / width


## Right-mouse-drag panning (UI_UX.md §1 allows pan; this is just a second
## way to do it alongside WASD). Right button, not left, so a future
## click-to-build/select interaction on the left button has nothing to fight
## with.
func _apply_drag_pan(relative: Vector2) -> void:
	var sensitivity := _iso_drag_sensitivity()
	if sensitivity <= 0.0:
		return
	# "Grab the world and drag it": the point under the cursor follows the
	# cursor, which means the focus point moves opposite the drag on the
	# right axis and along the forward axis on the (screen-down-is-positive) Y.
	_camera_focus += (-_pan_right * relative.x + _pan_forward * relative.y) * sensitivity
	_update_camera_transform()


# --------------------------------------------------------------------------
# First-person mode
# --------------------------------------------------------------------------

## Rotation around world Y only, no pitch — used both to build the full
## look basis (below) and, on its own, as the horizontal movement basis so
## WASD moves along the ground regardless of where you're looking up/down,
## the same way Minecraft's own flight controls work.
func _fp_heading_basis() -> Basis:
	return Basis(Vector3.UP, _fp_yaw)


## Heading, then tilted by pitch around the resulting local right axis —
## composed in this order specifically so pitch never affects heading.
func _fp_look_basis() -> Basis:
	return _fp_heading_basis() * Basis(Vector3.RIGHT, _fp_pitch)


func _update_fp_camera_transform() -> void:
	if _camera == null:
		return
	_camera.transform = Transform3D(_fp_look_basis(), _fp_position)


## Mouse-look, deliberately Input-free (see _apply_pan's equivalent note) so
## test_camera_nav.gd can call it directly with a synthetic delta.
func _apply_look(relative: Vector2) -> void:
	_fp_yaw -= relative.x * FP_MOUSE_SENSITIVITY
	_fp_pitch = clampf(_fp_pitch - relative.y * FP_MOUSE_SENSITIVITY, -FP_PITCH_LIMIT, FP_PITCH_LIMIT)
	_update_fp_camera_transform()


## Reads held keys only, same split as _pan_input_direction for the same
## reason (untestable headlessly without a live Input singleton). SPACE/SHIFT
## for up/down, Minecraft-style — SPACE only spawns a tomato in ISOMETRIC mode
## (_unhandled_input gates that), so there's no conflict with flying up here.
func _fp_input_direction() -> Vector3:
	var heading := _fp_heading_basis()
	var forward := -heading.z
	var right := heading.x
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= right
	if Input.is_key_pressed(KEY_SPACE):
		move += Vector3.UP
	if Input.is_key_pressed(KEY_SHIFT):
		move -= Vector3.UP
	return move


## The actual movement, Input-free and directly testable — mirrors _apply_pan.
func _apply_fp_move(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	_fp_position += direction.normalized() * FP_MOVE_SPEED * delta
	_update_fp_camera_transform()


func _fp_camera_move(delta: float) -> void:
	_apply_fp_move(_fp_input_direction(), delta)


## TAB toggles between ISOMETRIC and FIRST_PERSON. Both share the one
## Camera3D node — this reconfigures it (projection, near plane, aspect
## policy) rather than creating a second one.
##
## Each branch places the camera itself and nothing may place it again
## afterwards: this used to end with an unconditional
## `_update_camera_transform()`, which the isometric branch had already made
## and which the first-person branch had no business making — so entering
## first person put the camera back at the isometric angle and distance
## until the first mouse-look or WASD input called
## `_update_fp_camera_transform()` and snapped it into place (fixed
## 2026-09-16).
func _set_view_mode(mode: int) -> void:
	if mode == _view_mode:
		return
	_view_mode = mode
	_update_crosshair_visibility()
	_apply_backdrop_mode()

	if mode == ViewMode.FIRST_PERSON:
		_iso_dragging = false
		# Start hovering above wherever the isometric view was focused, so
		# the switch feels continuous instead of teleporting to the origin.
		_fp_position = _camera_focus + Vector3(0.0, TILE * 1.5, 0.0)
		# Best-effort continuity, not an exact guarantee: face roughly the
		# same way the isometric camera was looking. Mouse-look overrides it
		# immediately, so an imperfect starting angle here doesn't matter.
		_fp_yaw = atan2(-_pan_forward.x, -_pan_forward.z)
		_fp_pitch = deg_to_rad(-15.0)
		_camera.projection = Camera3D.PROJECTION_PERSPECTIVE
		_camera.fov = FP_FOV
		_camera.near = FP_NEAR
		_camera.keep_aspect = Camera3D.KEEP_HEIGHT
		# ...unless a panel is up and needs the cursor. This used to check
		# the build menu alone, so TAB with the market, board, staff or
		# production panel (or a configuration panel) open captured the
		# mouse under a panel full of buttons (the quality pass, 2026-09-13).
		_apply_fp_mouse_mode()
		_update_fp_camera_transform()
		if _help_label != null:
			_help_label.text = FP_HELP_TEXT
	else:
		# Keep the isometric view's height (its focus point's Y never moved
		# on its own), just recentre X/Z on wherever first-person ended up.
		_camera_focus = Vector3(_fp_position.x, _camera_focus.y, _fp_position.z)
		_camera.projection = Camera3D.PROJECTION_ORTHOGONAL
		_camera.near = ISO_NEAR
		_camera.keep_aspect = Camera3D.KEEP_WIDTH
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		_update_camera_transform()
		if _help_label != null:
			_help_label.text = ISO_HELP_TEXT


## Fits the orthographic frustum to the factory floor's bounding box by
## projecting its eight corners onto the camera's own right/up axes.
##
## Worth doing properly rather than eyeballing a constant: the chain's length
## is whatever data/recipes.ron currently defines, so the framing has to be
## derived, and an isometric view rotates the world box 45 degrees relative to
## the screen — a naive "width = chain length" estimate is wrong in both
## directions at once.
func _framing_size(basis: Basis) -> float:
	var x_from := float(_frame_bounds.position.x - FLOOR_MARGIN_X) - 0.5
	var x_to := float(_frame_bounds.position.x + _frame_bounds.size.x + FLOOR_MARGIN_X) + 0.5
	var z_from := float(_frame_bounds.position.y - FLOOR_MARGIN_Z) - 0.5
	var z_to := float(_frame_bounds.position.y + _frame_bounds.size.y + FLOOR_MARGIN_Z) + 0.5

	var min_right := INF
	var max_right := -INF
	var min_up := INF
	var max_up := -INF
	for cx in [x_from, x_to]:
		for cz in [z_from, z_to]:
			# 0 .. one tile tall covers the floor slab through the machines'
			# vessels; the exhaust stacks poking above are not worth zooming
			# the whole factory out for.
			for cy in [0.0, TILE]:
				var corner := Vector3(cx * TILE, cy, cz * TILE)
				min_right = min(min_right, basis.x.dot(corner))
				max_right = max(max_right, basis.x.dot(corner))
				min_up = min(min_up, basis.y.dot(corner))
				max_up = max(max_up, basis.y.dot(corner))

	var aspect := 16.0 / 9.0
	var viewport := get_viewport()
	if viewport != null:
		var rect := viewport.get_visible_rect().size
		if rect.x > 0.0 and rect.y > 0.0:
			aspect = rect.x / rect.y

	var needed_width := max_right - min_right
	var needed_height := max_up - min_up
	return max(needed_width, needed_height * aspect) * 1.06


## The scene's light, air and backdrop — the inside of a factory hall far
## bigger than anything the player can build. It lives in
## `factory_environment.gd` because the title screen stands its machines in
## the same hall, and a menu lit differently from the game would be the one
## screen that does not look like the game.
func _build_environment() -> void:
	_world_environment = FactoryEnvironment.build_into(self)
	_apply_backdrop_mode()


## The hall is drawn behind the world in first person and stood in for by its
## own haze in the isometric view — a sky cannot be photographed with a
## parallel projection. `factory_environment.gd`'s `set_backdrop_for` carries
## the reasoning; this is only the call site, which is every place the view
## mode is decided (build, and TAB).
func _apply_backdrop_mode() -> void:
	if _world_environment == null:
		return
	FactoryEnvironment.set_backdrop_for(
		_world_environment.environment, _view_mode == ViewMode.FIRST_PERSON
	)


# --------------------------------------------------------------------------
# HUD
# --------------------------------------------------------------------------

## `n` design pixels at the current UI scale, as a float — for content
## margins, offsets and sizes.
func _ui_px(n: float) -> float:
	return round(n * UI_SCALE)


## [`_ui_px`] for the properties Godot types as `int`: border widths, theme
## separation constants, text outline sizes.
func _ui_i(n: float) -> int:
	return int(round(n * UI_SCALE))


## [`_ui_px`] applied to both axes of a `Vector2` — icon squares, fixed slot
## sizes, a label's offset inside its button.
func _ui_v(v: Vector2) -> Vector2:
	return Vector2(_ui_px(v.x), _ui_px(v.y))


## A font size `delta` steps off the body size, at the current UI scale.
## Every `LabelSettings` in this file goes through here, so the type
## hierarchy (money biggest, a docket's footnote smallest) is stated once as
## a set of offsets from [`UI_FONT_BASE`] and re-derived at whatever scale is
## in force. The floor is a guard against a future scale small enough to
## round a footnote out of existence, not something today's numbers reach.
func _ui_font(delta: int = 0) -> int:
	return maxi(8, int(round(float(UI_FONT_BASE + delta) * UI_SCALE)))


# --- Meters: the one bar language ------------------------------------------
#
# **A quantity with a CEILING is drawn as a bar, everywhere, and it is always
# the same bar.** The hopper/tank configuration panel got the first one and it
# is the readout on this HUD that works best — a level is a POSITION, and a
# position is read at a glance where "37 / 64" has to be divided first. This
# section is that widget lifted out of the config panel so the rest of the UI
# speaks it too: a machine's craft progress, a pipe's level, a contract's
# countdown to its next check, what a purchase costs against the balance.
#
# Two rules keep it one language rather than a pile of bars:
#
#   * **A bar needs a real denominator.** Fill against capacity, elapsed
#     against required, cost against balance — all genuine ceilings the
#     simulation reports. Raw ingredient stock is deliberately NOT metered:
#     it has no ceiling, and inventing one (a "full larder" nobody defined)
#     would be a gauge reading a number the game does not have. Those stay
#     figures.
#   * **The fill colour is a MEANING, not decoration** (UI_UX.md §7), and it
#     is never the only signal — every meter in this file is captioned with
#     the same fact in words beside it, so the colour is the second reading
#     rather than the first.
const METER_HEIGHT := 14.0 * UI_SCALE
## The dark-plate skin: what a meter looks like on the near-black factory-side
## panels (the config panel, the hover tooltip, the build menu). The clipboard
## passes its own paper tones instead — one mechanism, two skins, each staying
## where its panel's palette already lives.
const METER_TRACK_COLOR := Color(0.10, 0.10, 0.12, 0.98)
const METER_BORDER_COLOR := Color(0.36, 0.38, 0.42, 0.95)
## A LEVEL: how full a container is. The config panel's own green, kept so the
## bar the rest of this borrows from did not change colour when it was shared.
const METER_FILL_LEVEL := Color(0.55, 0.78, 0.42, 0.98)
## WORK IN PROGRESS: a process running toward completion. The HUD's own hazard
## amber, which already means "machinery" everywhere else on screen.
const METER_FILL_PROGRESS := Color(0.90, 0.68, 0.16, 0.98)
## A COST or a countdown that has nearly run out — the one meter state that is
## a warning. Paired with a word every time it is used.
const METER_FILL_WARN := Color(0.86, 0.38, 0.30, 0.98)


## Builds a meter and returns its TRACK; the moving bar is the track's `Fill`
## child, so a caller holds one node and `_set_meter` finds the other.
##
## `width` of 0 means "as wide as the container gives it" — the track expands
## and `_set_meter` reads its live width, which is what lets a docket's
## countdown and a tooltip's progress bar sit in panels whose width is decided
## by their text.
func _build_meter(
	parent: Node,
	width: float = 0.0,
	fill_color: Color = METER_FILL_LEVEL,
	track_color: Color = METER_TRACK_COLOR,
	border_color: Color = METER_BORDER_COLOR,
	height: float = METER_HEIGHT
) -> Panel:
	var track_style := StyleBoxFlat.new()
	track_style.bg_color = track_color
	track_style.border_color = border_color
	track_style.set_border_width_all(_ui_i(2))

	var track := Panel.new()
	track.name = "Meter"
	track.mouse_filter = Control.MOUSE_FILTER_IGNORE
	track.custom_minimum_size = Vector2(width, height)
	if width <= 0.0:
		track.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	track.add_theme_stylebox_override("panel", track_style)
	parent.add_child(track)

	var fill_style := StyleBoxFlat.new()
	fill_style.bg_color = fill_color

	var fill := Panel.new()
	fill.name = "Fill"
	fill.mouse_filter = Control.MOUSE_FILTER_IGNORE
	fill.add_theme_stylebox_override("panel", fill_style)
	track.add_child(fill)
	return track


## Drives one meter to `fraction`, optionally recolouring it (a countdown
## turns to METER_FILL_WARN in its last stretch, a build-menu slot to it when
## the balance will not cover the price).
##
## The bar is SIZED EXPLICITLY rather than anchored, the way the config panel's
## always was: a headless run never lays a Control out, so an anchored fill
## would report zero width in exactly the tests that check a meter moved. It
## falls back to the track's minimum width for the same reason — the frame a
## panel opens on, its track has a minimum size and no size yet.
func _set_meter(track: Panel, fraction: float, fill_color: Color = Color(0, 0, 0, 0)) -> void:
	if track == null:
		return
	var fill: Panel = track.get_node_or_null("Fill")
	if fill == null:
		return
	var width: float = track.size.x
	if width <= 0.0:
		width = track.custom_minimum_size.x
	var height: float = track.size.y
	if height <= 0.0:
		height = track.custom_minimum_size.y
	var clamped := clampf(fraction, 0.0, 1.0)
	fill.position = Vector2.ZERO
	fill.size = Vector2(width * clamped, height)
	fill.visible = clamped > 0.0
	# The fraction is recorded on the track as well as drawn, because a
	# headless test can prove a meter MOVED without a viewport: a Control that
	# was never laid out has no width to scale, so `fill.size.x` alone can only
	# be checked on the meters given an explicit width. This is the one number
	# the panel was asked to show, so it is the one a test should read.
	track.set_meta("fraction", clamped)
	if fill_color.a > 0.0:
		var style: StyleBoxFlat = fill.get_theme_stylebox("panel")
		if style != null and style.bg_color != fill_color:
			var recoloured := style.duplicate()
			recoloured.bg_color = fill_color
			fill.add_theme_stylebox_override("panel", recoloured)


func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.name = "HUD"
	add_child(hud)

	# A dark plate with a single hazard-yellow rule along the top. UI_UX.md
	# §5's real UI pass (clipboard/checklist widgets, voxel-rendered icon
	# slots) is its own piece of work; this is the minimum that keeps text
	# legible over a lit 3D scene, rather than pretending to be that pass.
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.74)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.border_width_top = _ui_i(3)
	style.set_content_margin_all(_ui_px(12.0))

	var panel := PanelContainer.new()
	panel.name = "Legend"
	panel.add_theme_stylebox_override("panel", style)
	panel.position = _ui_v(Vector2(16, 16))
	hud.add_child(panel)
	_legend_panel = panel

	var rows := VBoxContainer.new()
	rows.name = "LegendRows"
	rows.add_theme_constant_override("separation", _ui_i(4))
	panel.add_child(rows)

	var settings := LabelSettings.new()
	settings.font_size = _ui_font()
	settings.font_color = Color(0.92, 0.93, 0.94)
	settings.outline_size = _ui_i(4)
	settings.outline_color = Color(0, 0, 0, 0.85)

	# The heading row is what survives the fold — the plate's name plus the
	# button, so a collapsed legend is a labelled stub that names the key
	# rather than a corner of the screen that has gone quiet. It is built
	# before the keybind text so it stays the top line either way.
	var header := HBoxContainer.new()
	header.name = "LegendHeader"
	header.add_theme_constant_override("separation", _ui_i(16))
	rows.add_child(header)

	var heading_settings := LabelSettings.new()
	heading_settings.font_size = _ui_font(-1)
	heading_settings.font_color = Color(0.98, 0.85, 0.42) # the plate's hazard accent
	heading_settings.outline_size = settings.outline_size
	heading_settings.outline_color = settings.outline_color

	var heading := Label.new()
	heading.name = "LegendHeading"
	heading.mouse_filter = Control.MOUSE_FILTER_IGNORE
	heading.label_settings = heading_settings
	heading.text = "CONTROLS"
	# NOT expanded to fill: the button sits next to the heading rather than
	# out at the plate's far edge. The legend is as wide as its widest keybind
	# line, and at 1280x720 that runs under the contracts clipboard (which is
	# drawn over it) — an affordance whose right half is buried is worse than
	# a buried word, so the one control on this plate is kept where the plate
	# is always visible, beside the word it belongs to.
	heading.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	header.add_child(heading)

	_legend_toggle = Button.new()
	_legend_toggle.name = "LegendToggle"
	_legend_toggle.focus_mode = Control.FOCUS_NONE
	_legend_toggle.custom_minimum_size = LEGEND_TOGGLE_MIN_SIZE
	_legend_toggle.add_theme_font_size_override("font_size", _ui_font(-1))
	_legend_toggle.pressed.connect(_toggle_legend)
	header.add_child(_legend_toggle)

	_help_label = Label.new()
	_help_label.name = "LegendText"
	_help_label.label_settings = settings
	_help_label.text = ISO_HELP_TEXT
	rows.add_child(_help_label)
	_apply_legend_collapsed()

	# UI_UX.md §5: "a contract IS a clipboard." The money/contract readout
	# used to be a plain Label folded into the panel above (milestone 5); it
	# now gets its own diegetic clipboard panel — paper background, a steel
	# clip bar, checkbox-style tick marks for delivery progress.
	_build_contract_panel(hud, settings)

	# The STOCK plate, directly under the clipboard on the same edge (the HUD
	# ticket) — see `_stock_panel`'s doc for why it is a right-hand column
	# rather than the strip of chips it replaces.
	_build_stock_panel(hud, settings)
	_build_crew_panel(hud, settings)

	# UI_UX.md §5's other named widget: "build/recipe menus as grids of
	# voxel-rendered icon slots." Hidden until E is pressed.
	_build_shop_menu(hud, settings)
	_build_ingredient_market(hud, settings)
	_build_contract_board(hud, settings)
	_build_staff_panel(hud, settings)
	_build_production_panel(hud, settings)

	# UI_UX.md §5's LAST unbuilt named widget: "a Minecraft-style hotbar/
	# quick-access strip along one screen edge." Always visible, unlike the
	# menu above — it is how a kind gets picked up now, and the menu is where
	# more of one gets bought.
	_build_hotbar(hud, settings)

	# The panel a placed hopper or fluid tank opens when it is CLICKED — the
	# replacement for the SPACE/V/Q keybinds. See `_config_panel`'s doc.
	_build_config_panel(hud, settings)

	# The hover tooltip (docs/UI_UX.md §5): replaces the always-on per-machine
	# text this panel used to show — see _build_hover_tooltip/
	# _update_hover_tooltip below.
	_build_hover_tooltip(hud)
	# The build-mode prompt (the "Real Placement" epic's ticket 2) — the same
	# dark plate by the cursor, saying what the next click will do.
	_build_placement_prompt(hud, settings)
	_build_crosshair(hud)
	# The way out (the save/main-menu epic's ticket 2). Last, so it draws over
	# every other panel — it is the one modal that means the game has stopped.
	_build_pause_menu(hud, settings)
	# The payout celebration (the "make earning money feel like something"
	# ticket). Last of all, and its "+N" is the last child of the HUD, so the
	# one thing that only appears for a second draws over every panel that is
	# permanently there.
	_build_payout_feedback(hud)
	_update_sound_button()


## Folds the keybind legend away, or brings it back. Reached two ways, on
## purpose: the button on the plate (discoverable, and the only way a player
## who never reads a legend would find it) and **F1** (the conventional key
## for a help overlay in every game that has one, and — checked against
## `_unhandled_input` — the first function key this project binds at all, so
## it collides with nothing).
func _toggle_legend() -> void:
	_set_legend_collapsed(not _legend_collapsed)


## The one place the state is written, so the button, the label and every
## panel that measures the plate can never disagree about it. Session-only:
## the HUD is built once in `_ready` and this is a view preference, not
## something a save should carry back.
func _set_legend_collapsed(collapsed: bool) -> void:
	if _legend_collapsed == collapsed:
		return
	_legend_collapsed = collapsed
	_apply_legend_collapsed()
	# The two notes a panel already opens and closes on. The legend is not a
	# modal (see `_legend_panel`'s doc), but what the player just did is make
	# a panel appear or disappear, and that is exactly what those two cues
	# say — a third convention for one button would be a new sound language
	# for no new fact (UI_UX.md §8).
	_cue(FactoryAudio.MENU_CLOSE if collapsed else FactoryAudio.MENU_OPEN)


func _apply_legend_collapsed() -> void:
	if _help_label != null:
		_help_label.visible = not _legend_collapsed
	if _legend_toggle != null:
		# The stub. Collapsed, this line IS the legend, so it says both ways
		# back — click here, or press F1 (UI_UX.md §7: a panel that has
		# hidden itself must not hide how to return it).
		_legend_toggle.text = "+ SHOW  F1" if _legend_collapsed else "−  HIDE  F1"
	if _legend_panel != null:
		# A Control parented to a CanvasLayer is not in a container, so Godot
		# grows it to its minimum size and never shrinks it back — without
		# this the plate would keep the five lines' worth of height it was
		# built at, and the fold would be invisible.
		_legend_panel.size = _legend_panel.get_combined_minimum_size()
	_position_contract_notice()


## The legend plate's CURRENT rect on screen — collapsed or expanded,
## whichever it is now. Everything that has to stay off the legend asks here
## rather than measuring `_help_label`'s own parent, which is the rect of the
## text INSIDE the plate and is the wrong answer twice over: it misses the
## plate's own margins, and while the text is hidden it reports the empty
## strip where the text used to be rather than the stub that is really there.
##
## Falls back to the plate's minimum size before layout has run, the state a
## headless run never leaves — the old `size.y > 0` guard silently dropped
## the legend out of the avoid list entirely in exactly that case.
func _legend_rect() -> Rect2:
	if _legend_panel == null or not _legend_panel.visible:
		return Rect2()
	var size := _legend_panel.size
	if size.y <= 0.0:
		size = _legend_panel.get_combined_minimum_size()
	return Rect2(_legend_panel.global_position, size)


## The diegetic clipboard/checklist widget (UI_UX.md §5) — the money/contract
## readout as "a paper texture on a metal clipboard clip" rather than a plain
## Label. Deliberately its own PanelContainer, sibling to (not nested inside)
## the generic HUD panel above, so this stays intact regardless of what other
## panels come and go there.
##
## LAYOUT DECISION (contracts-as-data, ticket 2). `economy_snapshot_json`
## reports an ARRAY of contracts, so this is a board of dockets, not a
## clipboard per contract: one sheet of paper under one steel clip, carrying
## the SHARED money figure and the SHARED dock stock once at the top, then one
## printed docket card per contract stacked below. Both alternatives were
## considered and rejected — a separate PanelContainer per contract repeats
## the 12px clip bar and the paper frame three times over for no new
## information, and a single flat list of checklist rows loses which rows
## belong to which order the moment two contracts want the same item (all
## three shipped contracts want `boxed_ketchup`). A docket is a slightly
## darker paper tone with a steel hairline — the same two colours the panel
## and its checkboxes already use, so this adds separation without adding a
## visual language.
func _build_contract_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	# Paper cream background + a thick steel-toned top border standing in for
	# "the clip" — the same technique the panel above already uses for its
	# hazard-yellow accent rule, just recoloured and thickened. UI_UX.md §5
	# only asks for "even just a contrasting-coloured strip along one edge,"
	# so nothing fancier (a drawn clasp, a texture) is warranted yet.
	var paper_style := StyleBoxFlat.new()
	paper_style.bg_color = Color(0.87, 0.81, 0.64, 0.98) # warm off-white paper
	paper_style.border_color = Color(0.27, 0.29, 0.32, 1.0) # steel-grey frame/clip
	paper_style.border_width_left = _ui_i(3)
	paper_style.border_width_right = _ui_i(3)
	paper_style.border_width_bottom = _ui_i(3)
	paper_style.border_width_top = _ui_i(12) # the clip bar
	paper_style.set_content_margin_all(_ui_px(10.0))
	paper_style.content_margin_top = _ui_px(15.0) # clearance under the thicker clip bar

	_contract_panel = PanelContainer.new()
	_contract_panel.name = "ContractPanel"
	_contract_panel.add_theme_stylebox_override("panel", paper_style)
	hud.add_child(_contract_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(6))
	_contract_panel.add_child(body)

	# Dark ink on paper, not the pale-text-with-black-outline style the panel
	# above uses — that styling exists specifically to stay legible over a
	# lit 3D scene, which doesn't apply once text sits on an opaque paper
	# panel. Font family and size are still the ones already established in
	# _build_ui() (UI_UX.md §5's own "sturdy, slightly blocky" typography
	# call), only colour/outline change for the paper background.
	_contract_ink_settings = LabelSettings.new()
	_contract_ink_settings.font_size = _ui_font()
	_contract_ink_settings.font_color = Color(0.16, 0.13, 0.08)
	_contract_ink_settings.outline_size = 0

	# A small type-scale hierarchy on the clipboard, added during the visual-
	# overhaul pass: the title and the money figure used to share the exact
	# body text size, so nothing on the panel told the eye what mattered most
	# — a real UI_UX.md §5 polish gap ("typography/readability issues"), not
	# just an aesthetic nicety. Same ink colour and family throughout, only
	# size steps up, so it still reads as one consistent clipboard rather
	# than mixed styles. With several dockets on the board the hierarchy has
	# one more rung: a contract's NAME is the heading of its own docket, and
	# its cadence/tally line is deliberately the smallest thing on the panel.
	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(2)
	title_settings.font_color = _contract_ink_settings.font_color
	title_settings.outline_size = 0

	var money_settings := LabelSettings.new()
	money_settings.font_size = _ui_font(6)
	money_settings.font_color = _contract_ink_settings.font_color
	money_settings.outline_size = 0

	_contract_name_settings = LabelSettings.new()
	_contract_name_settings.font_size = _ui_font(1)
	_contract_name_settings.font_color = _contract_ink_settings.font_color
	_contract_name_settings.outline_size = 0

	# The tick mark gets its own settings, not the body ink's. At body size a
	# "✓" overflows a 14px checkbox and renders as a clipped diagonal in the
	# corner (visible only in a real screenshot — the headless test happily
	# reports a visible Mark node either way), and dark ink on the checked
	# green is the panel's weakest contrast anywhere. Small and paper-pale
	# fixes both.
	_checkbox_mark_settings = LabelSettings.new()
	_checkbox_mark_settings.font_size = _ui_font(-4)
	_checkbox_mark_settings.font_color = Color(0.91, 0.88, 0.78)
	_checkbox_mark_settings.outline_size = 0

	_contract_meta_settings = LabelSettings.new()
	_contract_meta_settings.font_size = _ui_font(-3)
	# A touch lighter than body ink — still well clear of the paper, but the
	# cadence/tally line should read as a footnote on the docket, not as
	# another checklist item.
	_contract_meta_settings.font_color = Color(0.34, 0.29, 0.20)
	_contract_meta_settings.outline_size = 0

	_contract_missed_settings = LabelSettings.new()
	_contract_missed_settings.font_size = _contract_meta_settings.font_size
	_contract_missed_settings.font_color = CONTRACT_METER_DUE
	_contract_missed_settings.outline_size = 0

	# The flyout's two inks: the checkbox's own "done" green for money coming
	# in, the docket's warning red for money going out. The sign in front of
	# the figure says which either way (UI_UX.md §7).
	_contract_gain_settings = LabelSettings.new()
	_contract_gain_settings.font_size = _ui_font(1)
	_contract_gain_settings.font_color = Color(0.20, 0.40, 0.20)
	_contract_gain_settings.outline_size = 0

	_contract_spend_settings = LabelSettings.new()
	_contract_spend_settings.font_size = _ui_font(1)
	_contract_spend_settings.font_color = CONTRACT_METER_DUE
	_contract_spend_settings.outline_size = 0

	# Heading and balance share one row (the same tightening the build menu
	# and the market got in the 2026-09-09 UI-scale pass, so all three panels
	# read the same way). At half again the type size, two short strings on
	# two lines was a whole docket's worth of the board's height.
	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(12))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "CONTRACTS"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	heading.add_child(title)

	# Money is shown ONCE, here, and never per docket: GAMEPLAY.md §1 allows
	# exactly one currency, and sim_core keeps exactly one counter for it.
	_contract_money_label = Label.new()
	_contract_money_label.label_settings = money_settings
	_contract_money_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	heading.add_child(_contract_money_label)

	# What the balance just did, under the balance itself. A contract settles
	# on its own clock while the player is looking at their factory, so the
	# only evidence a payout happened was a number that had quietly changed by
	# the next time they looked at it. This is that event, drawn where the
	# figure it changed lives.
	#
	# It is a CHILD of the money label rather than another row of the heading,
	# positioned in `_update_contract_panel` once the label has a size: a row
	# reserved for something that is blank most of the time would cost the
	# board a docket's worth of height at the 1600x900 window UI_UX.md §5c
	# measures against.
	_contract_money_change = Label.new()
	_contract_money_change.name = "MoneyChange"
	_contract_money_change.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_contract_money_change.label_settings = _contract_gain_settings
	_contract_money_change.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	_contract_money_change.modulate = Color(1, 1, 1, 0)
	_contract_money_label.add_child(_contract_money_change)

	# The shared delivery pool, also once. See _update_contract_dock for why
	# this line exists at all.
	_contract_dock_row = HBoxContainer.new()
	_contract_dock_row.name = "DockRow"
	_contract_dock_row.add_theme_constant_override("separation", _ui_i(6))
	body.add_child(_contract_dock_row)

	var dock_title := Label.new()
	dock_title.label_settings = _contract_meta_settings
	dock_title.text = "ON THE DOCK"
	_contract_dock_row.add_child(dock_title)

	_contract_dock_empty_label = Label.new()
	_contract_dock_empty_label.label_settings = _contract_meta_settings
	_contract_dock_empty_label.text = "empty"
	_contract_dock_row.add_child(_contract_dock_empty_label)

	# ...and its opposite. The bar beside each item already says how close
	# the pool is to its ceiling; this says what being AT it means, in words,
	# because a bar reading full is a fact and "the line behind it has
	# stopped" is the consequence (UI_UX.md §7, §5e). Its own settings
	# object, duplicated rather than shared, for the wage line's reason: it
	# carries the docket's warning red and every other meta line must not.
	var full_settings: LabelSettings = _contract_meta_settings.duplicate()
	full_settings.font_color = CONTRACT_METER_DUE
	_contract_dock_full_label = Label.new()
	_contract_dock_full_label.label_settings = full_settings
	_contract_dock_full_label.text = "⚠ FULL — the belt is backing up"
	_contract_dock_full_label.visible = false
	_contract_dock_row.add_child(_contract_dock_full_label)

	# Wages, on the always-visible clipboard rather than only inside the H
	# panel (the quality pass, ticket 4 — GAMEPLAY.md §5's third cost axis
	# has to be as visible as the money it draws from). Ink by default,
	# switched to the docket's own warning red when short of the next bill.
	# Its OWN settings object, duplicated from the meta ink rather than shared:
	# the line recolours when wages cannot be met, and every docket's footnote
	# reads from `_contract_meta_settings`, so recolouring the shared one would
	# turn the whole board red.
	_contract_wages_label = Label.new()
	_contract_wages_label.name = "WagesLabel"
	_contract_wages_settings = LabelSettings.new()
	_contract_wages_settings.font_size = _contract_meta_settings.font_size
	_contract_wages_settings.outline_size = 0
	_contract_wages_label.label_settings = _contract_wages_settings
	body.add_child(_contract_wages_label)

	# SHORT-STAFFED used to be a two-line strip HERE, under the wage bill.
	# The CREW plate took both jobs on 2026-09-16: it names the short
	# categories and the heads to hire permanently, in warning red, on this
	# same edge — so the strip was saying a second time what the plate says
	# always, and its two lines were the difference between the right-hand
	# column fitting at 1280x720 and the plate below it overlapping the one
	# below that. The alarm did not go away; it moved to the plate that is
	# about crew (`_update_staff_alert`), and the clipboard went back to
	# being about contracts and money.

	_checkbox_style_unchecked = StyleBoxFlat.new()
	_checkbox_style_unchecked.bg_color = Color(0.80, 0.74, 0.57, 1.0) # a shade darker than the paper
	_checkbox_style_unchecked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_unchecked.set_border_width_all(_ui_i(2))

	_checkbox_style_checked = StyleBoxFlat.new()
	_checkbox_style_checked.bg_color = Color(0.24, 0.42, 0.24, 1.0) # a muted, saturated "done" green —
	# UI_UX.md §7: saturated colour reserved for meaning, and a completed
	# checklist item is exactly that meaning, not decoration.
	_checkbox_style_checked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_checked.set_border_width_all(_ui_i(2))

	# Strike pips: the checkbox's geometry at half size, and the checkbox's
	# paper when empty; struck ones fill with the clipboard's one red. A
	# strike is the OPPOSITE of a tick, drawn in the same language.
	_strike_style_empty = StyleBoxFlat.new()
	_strike_style_empty.bg_color = Color(0.80, 0.74, 0.57, 1.0)
	_strike_style_empty.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_strike_style_empty.set_border_width_all(_ui_i(2))
	_strike_style_struck = StyleBoxFlat.new()
	_strike_style_struck.bg_color = CONTRACT_LAST_CHANCE_COLOR
	_strike_style_struck.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_strike_style_struck.set_border_width_all(_ui_i(2))

	# The two inks a docket's status line can switch to. Same size as the
	# body ink, only the colour changes — and only ever beside a glyph.
	_contract_warn_settings = LabelSettings.new()
	_contract_warn_settings.font_size = _ui_font()
	_contract_warn_settings.font_color = CONTRACT_LAST_CHANCE_COLOR
	_contract_warn_settings.outline_size = 0
	_contract_ready_settings = LabelSettings.new()
	_contract_ready_settings.font_size = _ui_font()
	_contract_ready_settings.font_color = CONTRACT_READY_COLOR
	_contract_ready_settings.outline_size = 0

	# One docket = the checkbox's own paper tone plus a steel hairline. Reusing
	# those two existing colours is the point (see this function's header):
	# separation without a third palette.
	_contract_card_style = StyleBoxFlat.new()
	_contract_card_style.bg_color = Color(0.83, 0.77, 0.60, 1.0)
	_contract_card_style.border_color = Color(0.47, 0.44, 0.38, 1.0)
	_contract_card_style.set_border_width_all(_ui_i(1))
	_contract_card_style.set_content_margin_all(_ui_px(6.0))
	# The docket's border thickens and takes the state colour when there is
	# something to say (the contract-board epic): ready, at risk, or one miss
	# from lost. The paper itself never changes — a red card would read as a
	# different kind of card; a red RULE around the same card reads as the
	# same order in trouble.
	_contract_card_style_ready = _contract_card_style.duplicate()
	_contract_card_style_ready.border_color = CONTRACT_READY_COLOR
	_contract_card_style_ready.set_border_width_all(_ui_i(2))
	_contract_card_style_risk = _contract_card_style.duplicate()
	_contract_card_style_risk.border_color = CONTRACT_RISK_COLOR
	_contract_card_style_risk.set_border_width_all(_ui_i(2))
	_contract_card_style_last_chance = _contract_card_style.duplicate()
	_contract_card_style_last_chance.border_color = CONTRACT_LAST_CHANCE_COLOR
	_contract_card_style_last_chance.set_border_width_all(_ui_i(3))

	# The dockets live in a ScrollContainer whose height is capped in
	# _update_contract_panel — a safety valve for a future contracts.ron with
	# more orders than fit, not a UI the player is expected to drive today.
	_contract_cards_scroll = ScrollContainer.new()
	_contract_cards_scroll.name = "ContractList"
	_contract_cards_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_contract_cards_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_contract_cards_scroll)

	_contract_cards_box = VBoxContainer.new()
	_contract_cards_box.name = "ContractCards"
	_contract_cards_box.add_theme_constant_override("separation", _ui_i(5))
	_contract_cards_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_contract_cards_scroll.add_child(_contract_cards_box)

	# A board with nothing running says so in a sentence, and says what to do
	# about it. Since the contract-board epic that is a reachable state — a
	# player who loses their only contract has no income and no docket, and
	# an empty paper with a money figure on it would not tell them why.
	_contract_empty_label = Label.new()
	_contract_empty_label.name = "NoContracts"
	_contract_empty_label.label_settings = _contract_ink_settings
	_contract_empty_label.text = "no contracts — nothing to deliver against\npress C to sign one from the board"
	_contract_empty_label.visible = false
	body.add_child(_contract_empty_label)

	# And the way to the board is printed on the clipboard itself, because the
	# clipboard is where a player looks when they want more orders.
	_contract_hint_label = Label.new()
	_contract_hint_label.name = "BoardHint"
	_contract_hint_label.label_settings = _contract_meta_settings
	_contract_hint_label.text = "C: contracts board — sign more orders"
	body.add_child(_contract_hint_label)

	# One docket per active contract, read live from economy_snapshot_json
	# rather than assumed — nothing here hardcodes how many contracts exist,
	# what they ask for, or what they pay.
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_rebuild_contract_cards(econ.get("contracts", []))
	_known_active_contract_ids.clear()
	_known_active_primed = false
	_known_open_unlock_ids.clear()
	_known_unlocks_primed = false

	# The announcement line: a lone outlined label along the top edge, in the
	# HUD's own hazard accent, that the clipboard's poll fills when a contract
	# is signed or lost. In the HUD layer, not the panel, so it can sit over
	# the middle of the screen where a player mid-build is looking.
	var notice_settings := LabelSettings.new()
	notice_settings.font_size = _ui_font(3)
	notice_settings.font_color = Color(0.98, 0.85, 0.42)
	notice_settings.outline_size = _ui_i(6)
	notice_settings.outline_color = Color(0, 0, 0, 0.9)
	_contract_notice = Label.new()
	_contract_notice.name = "ContractNotice"
	_contract_notice.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_contract_notice.label_settings = notice_settings
	_contract_notice.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_contract_notice.modulate = Color(1, 1, 1, 0)
	hud.add_child(_contract_notice)

	# Anchored to the top-right corner with a fixed margin, sized to its own
	# content — independent of however tall the machine-line panel ends up
	# being.
	_contract_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE, CONTRACT_PANEL_MARGIN)


## Rebuilds the docket stack from a `contracts` array. Called once at build
## time and again only if the SET of contract ids changes — the shipped world
## loads its contracts once and never adds or drops one, but a future
## "contract accepted / contract lost" mechanic (GAMEPLAY.md §11's open
## question about what a missed window costs) would, and the guard costs a
## string compare per frame.
func _rebuild_contract_cards(contracts: Array) -> void:
	for card in _contract_cards:
		# Detach FIRST, then queue_free: queue_free is deferred to the end of
		# the frame, so freeing alone would leave the old dockets in the
		# container alongside the new ones for a frame. Detach from whatever
		# the panel's parent actually IS rather than from the current card
		# box — a scene re-entering the tree runs _ready (and so
		# _build_contract_panel) a second time, at which point these records
		# still point at the previous build's container.
		var panel: Node = card["panel"]
		if is_instance_valid(panel):
			if panel.get_parent() != null:
				panel.get_parent().remove_child(panel)
			panel.queue_free()
	_contract_cards.clear()
	_contract_card_ids.clear()
	for contract in contracts:
		_contract_cards.append(_build_contract_card(contract))
		_contract_card_ids.append(String(contract.get("id", "")))


## One contract's docket: its name and payout on a header row, a checklist row
## per line of its mix, and its OWN cadence/tally footnote. Every contract
## clocks independently in sim_core, so this countdown is per docket and is
## never shared the way money is.
##
## Returns the record `_update_contract_panel` drives it through:
##   {"id", "panel", "name_label", "payout_label", "meta_label",
##    "countdown_meter", "countdown_label", "done_label", "missed_label",
##    "rows": {item id -> {"icon", "label", "boxes"}}}
func _build_contract_card(contract: Dictionary) -> Dictionary:
	var panel := PanelContainer.new()
	panel.name = "ContractCard_%s" % String(contract.get("id", "?"))
	panel.add_theme_stylebox_override("panel", _contract_card_style)
	_contract_cards_box.add_child(panel)

	var card_body := VBoxContainer.new()
	card_body.add_theme_constant_override("separation", _ui_i(4))
	panel.add_child(card_body)

	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", _ui_i(10))
	card_body.add_child(header)

	var name_label := Label.new()
	name_label.label_settings = _contract_name_settings
	name_label.text = String(contract.get("name", contract.get("id", "?")))
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(name_label)

	# What this order is worth per delivery. It is the whole reason a player
	# chooses which docket to feed when the line can't serve them all
	# (GAMEPLAY.md §6), so it belongs on the docket, not in a tooltip.
	var payout_label := Label.new()
	payout_label.label_settings = _contract_name_settings
	payout_label.text = "+%d" % int(contract.get("payout", 0))
	# The figure kept beside the text, because the PAID stamp overwrites the
	# text for a beat when this contract settles and has to put it back
	# afterwards without re-reading a snapshot.
	payout_label.set_meta("payout", int(contract.get("payout", 0)))
	payout_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	header.add_child(payout_label)

	var rows: Dictionary = {}
	for pair in contract.get("mix", []):
		var item_id: String = String(pair[0])
		var required: int = int(pair[1])
		rows[item_id] = _build_contract_checklist_row(card_body, item_id, required)

	# How well the window is being filled, in words (the contract-board epic):
	# the checklist above says what is in, this says what is short and whether
	# the order is in danger; the countdown bar below says how long is left.
	var status_label := Label.new()
	status_label.name = "Status"
	status_label.label_settings = _contract_ink_settings
	card_body.add_child(status_label)

	# Strikes: one pip per miss the contract forgives, filled as misses run,
	# with the rule in words beside them. A contract's strikes are content, so
	# the row is as long as `contracts.ron` says.
	var strike_row := HBoxContainer.new()
	strike_row.name = "Strikes"
	strike_row.add_theme_constant_override("separation", _ui_i(4))
	card_body.add_child(strike_row)
	var strike_pips: Array = []
	for i in range(max(1, int(contract.get("strikes", 1)))):
		var pip := Panel.new()
		pip.name = "strike_%d" % i
		pip.custom_minimum_size = _ui_v(Vector2(10, 10))
		pip.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		pip.add_theme_stylebox_override("panel", _strike_style_empty)
		pip.set_meta("struck", false)
		strike_row.add_child(pip)
		strike_pips.append(pip)
	var strike_label := Label.new()
	strike_label.name = "StrikeLabel"
	strike_label.label_settings = _contract_meta_settings
	strike_row.add_child(strike_label)

	# The countdown, as a bar that DRAINS toward the next delivery window plus
	# the time itself. It used to be "next check in 235 ticks", which asked the
	# player to convert an implementation detail (ARCHITECTURE.md §3.9's fixed
	# timestep) into a wait, and gave them no way to compare two dockets at a
	# glance. The bar is that comparison; the words are the exact figure.
	var countdown_row := HBoxContainer.new()
	countdown_row.name = "Countdown"
	countdown_row.add_theme_constant_override("separation", _ui_i(6))
	card_body.add_child(countdown_row)

	var countdown_meter := _build_meter(
		countdown_row, CONTRACT_METER_MIN_WIDTH, CONTRACT_METER_INK,
		CONTRACT_METER_TRACK, CONTRACT_METER_BORDER, CONTRACT_METER_HEIGHT
	)
	countdown_meter.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	countdown_meter.size_flags_vertical = Control.SIZE_SHRINK_CENTER

	var countdown_label := Label.new()
	countdown_label.label_settings = _contract_meta_settings
	countdown_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	countdown_row.add_child(countdown_label)

	# The cadence and the two tallies ride the SAME row as the countdown, and
	# that is a height decision, not a taste one: a docket that grew a row made
	# the third one scroll off a 1600x900 board, which UI_UX.md §5c says
	# nothing should. They are three labels rather than one string so the
	# missed count can carry the docket's warning colour on its own — with its
	# glyph and its word, never colour alone.
	var meta_label := Label.new()
	meta_label.label_settings = _contract_meta_settings
	countdown_row.add_child(meta_label)

	var done_label := Label.new()
	done_label.name = "DoneTally"
	done_label.label_settings = _contract_meta_settings
	countdown_row.add_child(done_label)

	var missed_label := Label.new()
	missed_label.name = "MissedTally"
	missed_label.label_settings = _contract_meta_settings
	countdown_row.add_child(missed_label)

	return {
		"id": String(contract.get("id", "")),
		"panel": panel,
		"name_label": name_label,
		"payout_label": payout_label,
		"meta_label": meta_label,
		"countdown_meter": countdown_meter,
		"countdown_label": countdown_label,
		"done_label": done_label,
		"missed_label": missed_label,
		"status_label": status_label,
		"strike_pips": strike_pips,
		"strike_label": strike_label,
		"state": "",
		"rows": rows,
	}


## One checklist row: the item's numeric progress text, plus a row of small
## checkbox squares — one per required unit, per UI_UX.md §5's "checkbox-
## style tick marks for completed items." A contract asking for a very large
## quantity would make a per-unit row unreadably wide, so past
## CONTRACT_CHECKLIST_MAX_BOXES this falls back to a single box standing for
## "fully delivered" — the minimum the original ticket calls acceptable.
##
## Returns `{"icon", "label", "boxes"}` for its docket's record: the nodes are
## no longer stashed in a panel-wide dictionary keyed by item id, because
## several contracts legitimately ask for the SAME item (every contract in the
## shipped `data/contracts.ron` wants `boxed_ketchup`) and one such dictionary
## would have them silently overwrite each other's rows.
func _build_contract_checklist_row(body: VBoxContainer, item_id: String, required: int) -> Dictionary:
	# Icon + text share a row: UI_UX.md §5's "icons are rendered from the
	# real assets" (_icon_for) applied to the one place this panel names a
	# specific item.
	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", _ui_i(6))
	body.add_child(header)

	var icon := TextureRect.new()
	icon.custom_minimum_size = _ui_v(Vector2(16, 16))
	# Without this, TextureRect's own minimum size defaults to the source
	# texture's actual size (64x64) and wins over custom_minimum_size above —
	# EXPAND_IGNORE_SIZE is what makes the 16x16 slot actually stick.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	header.add_child(icon)

	var progress_label := Label.new()
	progress_label.label_settings = _contract_ink_settings
	header.add_child(progress_label)

	var checklist := HBoxContainer.new()
	checklist.add_theme_constant_override("separation", _ui_i(4))
	body.add_child(checklist)

	var box_count: int = required if required <= CONTRACT_CHECKLIST_MAX_BOXES else 1
	var boxes: Array = []
	for i in range(box_count):
		var box := Panel.new()
		box.name = "checkbox_%s_%d" % [item_id, i]
		box.custom_minimum_size = _ui_v(Vector2(14, 14))
		box.add_theme_stylebox_override("panel", _checkbox_style_unchecked)
		box.set_meta("checked", false)

		var mark := Label.new()
		mark.name = "Mark"
		mark.text = "✓"
		mark.label_settings = _checkbox_mark_settings
		mark.visible = false
		mark.set_anchors_preset(Control.PRESET_FULL_RECT)
		mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		mark.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		box.add_child(mark)

		checklist.add_child(box)
		boxes.append(box)
	return {"icon": icon, "label": progress_label, "boxes": boxes}


# --------------------------------------------------------------------------
# The build menu (UI_UX.md §5, the "Shop & Inventory" epic's ticket 2)
# --------------------------------------------------------------------------

## The player's first real agency: a grid of voxel-rendered icon slots, one
## per `data/shop.ron` entry, that spends contract money on equipment.
##
## Everything on it comes from `shop_snapshot_json` — kinds, order, unit
## prices, owned counts and affordability — so adding a kind to
## `data/shop.ron` puts a slot here with no Godot edit, exactly the way
## adding a recipe already extends the chain. Ticket 1's snapshot is polled
## rather than pushed, per its own doc: a purchase changes money and a count,
## never a tile, so `dirty_chunk_ids()` will never report one.
##
## Visual language is the scene's DARK PLATE, not the contract clipboard's
## paper — the same near-black panel with a hazard-yellow rule the HUD strip
## and the hover tooltip already use. The clipboard motif is for orders and
## checklists (UI_UX.md §5 says so explicitly); a build menu is machine-side
## factory UI, and it also has to stay legible while floating over a lit 3D
## scene, which is exactly what that dark plate exists for.
func _build_shop_menu(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = _ui_i(4)
	panel_style.border_width_left = _ui_i(2)
	panel_style.border_width_right = _ui_i(2)
	panel_style.border_width_bottom = _ui_i(2)
	panel_style.set_content_margin_all(_ui_px(16.0))

	_shop_menu = PanelContainer.new()
	_shop_menu.name = "ShopMenu"
	_shop_menu.add_theme_stylebox_override("panel", panel_style)
	_shop_menu.visible = false
	hud.add_child(_shop_menu)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(10))
	_shop_menu.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(4)
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	# Heading and balance share ONE row. They were stacked, which at the
	# 2026-09-09 UI scale spent a whole extra line of the panel's height on
	# two short strings — height the catalog grid below needs more.
	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(16))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "BUILD MENU"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.add_child(title)

	# Money is repeated here rather than left to the contract clipboard in
	# the opposite screen corner. The decision a player makes in this menu is
	# "can I afford that", and making them look across the screen to answer it
	# is exactly the readability problem UI_UX.md §5 is about. It is the same
	# number from the same snapshot — `shop_snapshot_json` carries `money`
	# precisely so a build menu is one call — not a second counter.
	var money_settings := LabelSettings.new()
	money_settings.font_size = _ui_font(6)
	money_settings.font_color = Color(0.98, 0.85, 0.42) # the panel's own hazard accent
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_shop_money_label = Label.new()
	_shop_money_label.label_settings = money_settings
	_shop_money_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	heading.add_child(_shop_money_label)

	# The grid lives in a ScrollContainer whose height `_position_shop_menu`
	# fits to whatever is left above the hotbar. **This is a last resort and
	# is meant never to engage at a normal window size**: at 1600x900 (the
	# resolution `scripts/screenshot-scene.sh` reviews at) the whole
	# twelve-kind catalog fits with room to spare and the scrollbar never
	# appears. It exists because at `project.godot`'s own 1280x720 the
	# 2026-09-09 UI scale genuinely does not leave room for two rows of cards
	# plus a title, a balance and a footer — and of the two ways to lose that
	# fight, a grid that scrolls a little is much better than a menu whose
	# footer disappears under the hotbar, which is the exact failure
	# `_position_shop_menu` was written to prevent in the first place. The
	# same shape (and the same reasoning) as the contract clipboard's docket
	# stack.
	_shop_grid_scroll = ScrollContainer.new()
	_shop_grid_scroll.name = "ShopGridScroll"
	_shop_grid_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_shop_grid_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_shop_grid_scroll)

	var grid := GridContainer.new()
	grid.name = "ShopGrid"
	grid.columns = SHOP_SLOT_COLUMNS
	grid.add_theme_constant_override("h_separation", _ui_i(8))
	grid.add_theme_constant_override("v_separation", _ui_i(8))
	_shop_grid = grid
	_shop_grid_scroll.add_child(grid)

	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	for index in range(entries.size()):
		_build_shop_slot(grid, base_settings, index, String(entries[index]["kind"]))

	var footer := Label.new()
	footer.label_settings = base_settings
	# Two lines since the 2026-09-09 UI scale: a Label does not wrap unless
	# told to, so at this font size one long line would set the panel's
	# minimum width wider than the window it has to sit in.
	footer.text = "left-click (or SHIFT+its number) buys one\nright-click (or just its number) puts one in your hand    E/ESC: close"
	body.add_child(footer)

	_position_shop_menu()


# --- Width: what a modal panel gives up when the window is too narrow ------
#
# Height has yielded since the 2026-09-09 scale change — `_fit_grid_scroll`
# caps a list and it scrolls (UI_UX.md §5c's deliberate last resort). Nothing
# made a panel yield WIDTH, so at 1280x720 the staff panel (minimum 1350px),
# the build menu (1412px) and the contracts board all simply overran the
# window and were clipped on BOTH edges — with the FIRE and SIGN buttons off
# the screen entirely (issues #62, #69). A control the player cannot reach
# outranks every other layout rule, so this is where width stops.
#
# Three ways to give width back, in the order the panels use them:
#
#   1. **A sentence moves to the hover** (`_staff_prose_hidden`). The staff
#      row already ranks five sentences and shows one, with the rest on the
#      row's tooltip; at a window this narrow the fifth goes there too. It is
#      the row's widest part and the only part of it that is already readable
#      somewhere else.
#   2. **A grid of cards takes fewer columns** (`_fit_grid_columns`). The build
#      menu and the market are icon slots of a fixed size, so there is nothing
#      in them to move to a hover; six across becomes five or three, which is
#      the same thing `SHOP_SLOT_COLUMNS` has been re-tuned by hand three times
#      for, now measured from the window instead.
#   3. **The list scrolls**, which it already did.
#
# What never yields: the panel is never cut off at the window's edge, and
# nothing on it is drawn where the player cannot click it.
#
# What is NOT used: `autowrap_mode`. A wrapping Label reports a minimum width
# of one pixel and a minimum height shaped at whatever width it last had, and
# it is only ever reshaped when it is drawn — so under `--headless`, where
# nothing draws, a wrapped sentence reports 1x1609 and every panel measured
# around it is nonsense. The layout here is measurement-driven end to end
# (`_fit_grid_scroll`, `_whole_rows_height`) and its proof is a headless test,
# so a control whose size cannot be measured without drawing it cannot be part
# of it. Prose that does not fit moves; it does not reflow.

## The gap a modal keeps from the left and right edges of the window. In
## WINDOW pixels rather than `_ui_px`: this is the last few pixels before a
## control would be off the screen, not a design margin that should grow with
## the UI scale.
const MODAL_EDGE_MARGIN := 8.0


## How wide a modal panel may be at this window size. `INF` before there is a
## viewport to measure (a headless `--script` run reaches this), which reads
## as "no limit" everywhere below and leaves the panel at its natural width.
func _modal_available_width() -> float:
	var vp := get_viewport()
	if vp == null:
		return INF
	var bounds := vp.get_visible_rect().size
	if bounds.x <= 0.0:
		return INF
	return maxf(0.0, bounds.x - MODAL_EDGE_MARGIN * 2.0)


## Gives `grid` the most columns its `panel` can wear at this window size,
## and returns the number it settled on.
##
## Measured by ASKING, one column at a time, rather than by dividing the
## window by a card: the panel's real width is the grid plus its margins,
## its scrollbar and whichever of its heading and footer is longest, and
## every one of those has moved at least once (`SHOP_SLOT_COLUMNS` has been
## re-tuned by hand three times as the catalog grew). Six tries at most, each
## one a cached minimum-size read.
##
## Then BALANCED: five columns for six crates is a row of five and a lonely
## sixth, where three and three is two even rows. Fewer columns than the
## width allows is always still narrow enough, so the balance cannot undo the
## fit.
func _fit_grid_columns(panel: Control, grid: GridContainer, count: int, max_columns: int) -> int:
	if panel == null or grid == null or count <= 0:
		return 1
	var limit: int = max(1, min(max_columns, count))
	var available: float = _modal_available_width()
	var columns: int = limit
	while columns > 1:
		grid.columns = columns
		if panel.get_combined_minimum_size().x <= available:
			break
		columns -= 1
	var rows: int = int(ceilf(float(count) / float(max(1, columns))))
	grid.columns = clampi(int(ceilf(float(count) / float(max(1, rows)))), 1, limit)
	return grid.columns


## Centres the menu in the space ABOVE the hotbar rather than in the whole
## viewport. The strip is always on screen now, and a plain centred menu tall
## enough to reach it buries its own FOOTER under the plate — which is exactly
## where the two mouse buttons' meanings are written down, so the one line
## that explains buying was the one line the hotbar hid. Found in a rendered
## frame; nothing in the code could have shown it.
##
## The grid takes as many columns as the window has room for (issue #62): at
## 1280x720 six cards across measured 1412px in a 1280px window and the menu
## was clipped on both edges, heading, money line and the last card's crew
## line with it. `SHOP_SLOT_COLUMNS` is the most it ever takes, not the number
## it always takes.
func _position_shop_menu() -> void:
	if _shop_menu == null:
		return
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := _hotbar_reserved_height()
	var bounds := vp.get_visible_rect().size
	_fit_grid_columns(_shop_menu, _shop_grid, _shop_slots.size(), SHOP_SLOT_COLUMNS)
	_fit_grid_scroll(_shop_grid_scroll, _shop_grid, bounds.y - reserved - _ui_px(16.0))
	_shop_menu.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var menu_size := _shop_menu.get_combined_minimum_size()
	_shop_menu.position.x = maxf(0.0, (bounds.x - menu_size.x) * 0.5)
	_shop_menu.position.y = max(8.0, (bounds.y - reserved - menu_size.y) * 0.5)


## Gives `grid` as much of `available` as its panel's own chrome leaves it,
## and no more than it actually needs.
##
## The chrome is MEASURED rather than assumed: ask the panel for its full
## height with the grid at full height, subtract the grid, and what is left
## is the title, the balance, the footer and every margin between them. That
## is what makes this survive a reworded footer or a fifth line of heading
## without someone remembering to re-tune a constant — the failure mode this
## menu has hit twice already (see `SHOP_SLOT_COLUMNS`).
## How much of the bottom of the screen the hotbar strip owns. Every panel
## that has to stay clear of it asks here rather than repeating the sum, so
## none of them can drift apart. Falls back to a computed estimate before the
## strip has laid itself out, which is the state a headless run stays in.
func _hotbar_reserved_height() -> float:
	if _hotbar_root != null and _hotbar_root.size.y > 0.0:
		return _hotbar_root.size.y + HOTBAR_BOTTOM_MARGIN * 2.0
	return HOTBAR_SLOT_SIZE.y * HOTBAR_SELECTED_SCALE + HOTBAR_BOTTOM_MARGIN * 3.0


## Returns the height it gave the scroll, so a caller that has something left
## to trade can see what its trade bought (`_update_contract_panel`).
func _fit_grid_scroll(scroll: ScrollContainer, grid: Control, available: float, snap_rows := false, hard_available := INF) -> float:
	if scroll == null or grid == null:
		return 0.0
	var natural: float = grid.get_combined_minimum_size().y
	scroll.custom_minimum_size.y = natural
	var panel := scroll.get_parent()
	while panel != null and not (panel is PanelContainer):
		panel = panel.get_parent()
	var chrome: float = 0.0
	if panel != null:
		chrome = (panel as Control).get_combined_minimum_size().y - natural
	# A floor, so a viewport too small for even one row leaves a scrollable
	# stub rather than a panel with no grid in it at all.
	var cap: float = maxf(_ui_px(110.0), available - chrome)
	# `snap_rows` moves the cut down to the last whole row, for a stack whose
	# rows are cards the player reads (see `_whole_rows_height`). The build
	# menu does NOT ask for it: its grid wraps six icon slots to a line, so a
	# "row" there is a line of cards that are all the same height anyway, and
	# the half-row it shows past the cap is the thing that says "scroll".
	if snap_rows:
		cap = _whole_rows_height(grid, cap)
	# Both floors above — `_ui_px(110)` and a whole row — may exceed what the
	# caller said was available, which is how the panel takes a little of the
	# column back from whatever is under it. `hard_available` is where that
	# stops: the height past which the thing under it would have nowhere left
	# to go at all. Past that the list is cut wherever it falls, ragged, and
	# that is the right answer — a panel drawn ON another panel is a worse
	# fault than a card cut through a line (issue #13).
	var hard_cap: float = maxf(0.0, hard_available - chrome)
	if snap_rows and hard_cap < cap:
		# The hard limit has cut BELOW the last whole row, so `snap_rows`
		# above has already been overruled and the list would be cut wherever
		# the column ran out — through the middle of a checklist line, which
		# reads as a rendering fault (issue #17). The panel cannot grow and it
		# cannot overlap what is under it, so the cut stays where the column
		# put it and moves UP to the nearest line boundary inside the card it
		# falls in: still "as much as fits", now ending on an edge a reader
		# can see was meant.
		cap = _line_boundary_height(grid, hard_cap)
	else:
		cap = minf(cap, hard_cap)
	scroll.custom_minimum_size.y = minf(natural, cap)
	return scroll.custom_minimum_size.y


## The tallest height not greater than `cap` that ends on a boundary between
## two of `box`'s rows — so a capped list is cut between rows rather than
## through the middle of a line of text, which reads as a rendering fault
## rather than as "there is more below" (issue #8).
##
## Rows are MEASURED, not divided out of a constant: a docket's height varies
## with its checklist, its status line and its strike pips, so there is no one
## row height for the clipboard to divide by the way the stock plate has one
## (`_stock_row_height`).
##
## One whole row is the floor, for the same reason `_fit_grid_scroll` has one:
## a list showing nothing at all is worse than a list showing its first row
## and a scrollbar. That can exceed `cap` — the clipboard's floor is a whole
## docket now rather than `_ui_px(110)`, and at 1600x900 with the
## SHORT-STAFFED strip up it costs the stock plate below it a row. That is the
## column's documented order of yielding (`_position_stock_panel`): the
## clipboard cannot yield past its own floor, and the plate takes what is
## left and scrolls.
func _whole_rows_height(box: Control, cap: float) -> float:
	if box == null:
		return cap
	if box is GridContainer:
		return _whole_grid_rows_height(box as GridContainer, cap)
	var separation: float = 0.0
	if box is BoxContainer:
		separation = float(box.get_theme_constant("separation"))
	var used: float = 0.0
	var fitted: float = 0.0
	var rows: int = 0
	for child in box.get_children():
		var row := child as Control
		if row == null or not row.visible:
			continue
		if rows > 0:
			used += separation
		used += row.get_combined_minimum_size().y
		if rows > 0 and used > cap:
			break
		fitted = used
		rows += 1
	return cap if rows == 0 else fitted


## `_whole_rows_height` for a GRID, where a "row" is `columns` cards side by
## side rather than one child. The market's crates wrap into one (issue #69),
## and a crate cut in half loses the price and the stock line printed down
## its lower half — the same fault a docket cut through a sentence is.
##
## The tallest cell in each line decides that line's height, the way
## GridContainer itself lays them out; with cards of one fixed size that is
## the card, and it stays right if one ever grows.
func _whole_grid_rows_height(grid: GridContainer, cap: float) -> float:
	var separation: float = float(grid.get_theme_constant("v_separation"))
	var columns: int = max(1, grid.columns)
	var used: float = 0.0
	var fitted: float = 0.0
	var rows: int = 0
	var column: int = 0
	var line_height: float = 0.0
	for child in grid.get_children():
		var cell := child as Control
		if cell == null or not cell.visible:
			continue
		line_height = maxf(line_height, cell.get_combined_minimum_size().y)
		column += 1
		if column < columns:
			continue
		if rows > 0:
			used += separation
		used += line_height
		if rows > 0 and used > cap:
			return fitted
		fitted = used
		rows += 1
		column = 0
		line_height = 0.0
	# A last, short line (six crates in four columns) counts as a whole one.
	if column > 0:
		if rows > 0:
			used += separation
		used += line_height
		if rows == 0 or used <= cap:
			fitted = used
			rows += 1
	return cap if rows == 0 else fitted


## The tallest height not greater than `cap` that ends on a line boundary —
## between two rows of `box` where it can, and otherwise between two LINES
## of the row the cut falls inside. `_whole_rows_height`'s finer-grained
## sibling, for the case where the column is too short for even that: it has
## no floor and it never grows the cut, because the only reason it is called
## is that a hard limit (another panel's top edge) already refused one.
##
## "Lines" are the row's own top-level children — a docket's header, each
## checklist line, its status, its strikes, its countdown — measured through
## the card's content margin the way `_whole_rows_height` measures through
## the box's separation. Nothing here knows what a docket IS; a card that
## grows a line gets the new boundary for free.
##
## Returns `cap` unchanged when not one whole line fits: a clipboard with no
## docket at all in it has lost the "there is more below" cue as well as the
## docket, which is worse than the ragged edge. That is the half of issue #17
## a 1280x720 column cannot pay for.
func _line_boundary_height(box: Control, cap: float) -> float:
	if box == null or cap <= 0.0:
		return maxf(cap, 0.0)
	var separation: float = 0.0
	if box is BoxContainer:
		separation = float(box.get_theme_constant("separation"))
	var used: float = 0.0
	var boundary: float = 0.0
	var rows: int = 0
	for child in box.get_children():
		var row := child as Control
		if row == null or not row.visible:
			continue
		if rows > 0:
			used += separation
		var row_top: float = used
		used += row.get_combined_minimum_size().y
		if used > cap:
			var inner: float = _row_line_boundary(row, cap - row_top)
			if inner > 0.0:
				return row_top + inner
			return boundary if boundary > 0.0 else cap
		boundary = used
		rows += 1
	return cap if rows == 0 else boundary


## The tallest height not greater than `cap`, measured from `row`'s top, that
## ends under a whole one of its lines. 0.0 when not one line fits.
##
## The row's content margin counts: a cut at the top line's baseline with the
## card's padding left out would end a pixel above the text it is keeping.
func _row_line_boundary(row: Control, cap: float, first_only := false) -> float:
	if row == null or cap <= 0.0:
		return 0.0
	var body: Control = null
	for child in row.get_children():
		var control := child as Control
		if control != null and control.visible:
			body = control
			break
	if body == null:
		return 0.0
	var used: float = 0.0
	if row is PanelContainer:
		var style: StyleBox = (row as PanelContainer).get_theme_stylebox("panel")
		if style != null:
			used = style.get_margin(SIDE_TOP)
	var separation: float = 0.0
	if body is BoxContainer:
		separation = float(body.get_theme_constant("separation"))
	var boundary: float = 0.0
	var lines: int = 0
	for child in body.get_children():
		var line := child as Control
		if line == null or not line.visible:
			continue
		if lines > 0:
			used += separation
		used += line.get_combined_minimum_size().y
		if used > cap:
			break
		boundary = used
		lines += 1
		if first_only:
			break
	return boundary


## The FIRST line boundary in `box` — the top card's top line, margin
## included. The least a cut list can show and still end on an edge a reader
## can see was meant: below this, `_line_boundary_height` has no boundary to
## snap to and hands back the ragged cut it was given (issue #17).
func _first_line_boundary(box: Control) -> float:
	if box == null:
		return 0.0
	for child in box.get_children():
		var row := child as Control
		if row == null or not row.visible:
			continue
		var line: float = _row_line_boundary(row, INF, true)
		# A row with no lines of its own — a bare meter, a spacer — is its
		# own first boundary.
		return line if line > 0.0 else row.get_combined_minimum_size().y
	return 0.0


## One icon slot. A Button rather than a Panel so pressing it is the whole
## interaction — no selection cursor, no confirm step, no second mode to
## explain; this is the project's first interactive menu and the simplest
## thing that works is the right thing. Its label children ignore the mouse
## so the entire square stays one click target.
func _build_shop_slot(grid: GridContainer, base_settings: LabelSettings, index: int, kind: String) -> void:
	var button := Button.new()
	button.name = "ShopSlot_%s" % kind
	button.custom_minimum_size = SHOP_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(state, _shop_slot_style(state))
	button.pressed.connect(_on_shop_slot_pressed.bind(index))
	# Right-click is the PLACE half of a slot (see `_on_shop_slot_gui_input`).
	# A Button only reports the left button through `pressed`, so the second
	# action has to come off the raw event.
	button.gui_input.connect(_on_shop_slot_gui_input.bind(index))
	grid.add_child(button)

	# Anchored over the button rather than parented through a container: a
	# Button lays its own (text) content out and is not a container, so its
	# children have to place themselves.
	var column := VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# No separation and two of top/bottom inset (they were two and eight):
	# the crew line (the staff pools MVP) had to come out of the card's own
	# slack, because a taller card makes the two-row grid scroll at
	# 1600x900 and a taller grid buries the footer (UI_UX.md §5c). Each
	# label carries its own line height, so the lines still breathe.
	column.add_theme_constant_override("separation", 0)
	column.set_anchors_preset(Control.PRESET_FULL_RECT)
	column.offset_left = _ui_px(8)
	column.offset_right = -_ui_px(8)
	column.offset_top = _ui_px(2)
	column.offset_bottom = -_ui_px(2)
	button.add_child(column)

	# The hotkey corner. Slots past SHOP_HOTKEY_SLOTS simply show nothing
	# here and stay click-only, rather than inventing a second key scheme.
	var hotkey_settings := LabelSettings.new()
	hotkey_settings.font_size = _ui_font(-3)
	hotkey_settings.font_color = Color(0.62, 0.64, 0.68)
	hotkey_settings.outline_size = base_settings.outline_size
	hotkey_settings.outline_color = base_settings.outline_color

	var hotkey := Label.new()
	hotkey.name = "Hotkey"
	hotkey.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hotkey.label_settings = hotkey_settings
	# The SAME digit the hotbar prints on the same slot — menu slot N and
	# hotbar slot N are one kind, so one label serves both. Since the
	# inventory-hotbar ticket that digit no longer means "buy": it means
	# "select", here as well as down on the strip, and SHIFT+it buys.
	#
	# Parented to the BUTTON and positioned in its corner rather than added
	# to the column, exactly as the hotbar socket's own digit is. In the
	# column it was a whole row of the card's height for one character, and
	# at the 2026-09-09 UI scale that row was the difference between the grid
	# fitting above the hotbar and not.
	hotkey.text = _hotbar_key_label(index)
	hotkey.position = _ui_v(Vector2(7, 3))
	button.add_child(hotkey)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = SHOP_CARD_ICON_SIZE
	# Same reason _build_contract_checklist_row gives: without
	# EXPAND_IGNORE_SIZE a TextureRect's minimum size is the source PNG's own
	# 64x64, which would win over custom_minimum_size above.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for_asset(_shop_asset_for(kind))
	column.add_child(icon)

	var name_label := Label.new()
	name_label.name = "KindName"
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = base_settings
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.text = _kind_display_name(kind)
	column.add_child(name_label)

	var price_settings := LabelSettings.new()
	price_settings.font_size = _ui_font()
	price_settings.font_color = base_settings.font_color
	price_settings.outline_size = base_settings.outline_size
	price_settings.outline_color = base_settings.outline_color

	var price_label := Label.new()
	price_label.name = "Price"
	price_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	price_label.label_settings = price_settings
	price_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	column.add_child(price_label)

	# The crew this kind needs while running (the staff pools MVP), under
	# the price: a machine costs money once and people every period, and
	# the card is where the first cost is read. Hidden for a kind with no
	# crew (a belt) rather than saying "none" — the label stays, empty, so
	# every card in a row is the same height.
	var crew_settings := LabelSettings.new()
	# The smallest step the UI scale allows (test_ui_scale.gd's floor); the
	# card was widened for it — at -3 on the old card it CLIPPED at
	# "manufacturi" (UI_UX.md §2b point 32).
	crew_settings.font_size = _ui_font(-4)
	crew_settings.font_color = Color(0.66, 0.68, 0.72)
	crew_settings.outline_size = base_settings.outline_size
	crew_settings.outline_color = base_settings.outline_color

	var crew_label := Label.new()
	crew_label.name = "Crew"
	crew_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	crew_label.label_settings = crew_settings
	crew_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	crew_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(crew_label)

	# What this slot would cost measured against what the player HAS. "Cost 70"
	# and "Money: 1747" are two figures in two corners of the screen, and the
	# question the player is actually asking — can I afford this, and what will
	# it leave me — is the relation between them. The bar is that relation:
	# how much of the balance this one purchase takes.
	var cost_meter := _build_meter(column, 0.0, METER_FILL_LEVEL,
		METER_TRACK_COLOR, METER_BORDER_COLOR, SHOP_METER_HEIGHT)
	cost_meter.name = "CostMeter"

	var owned_settings := LabelSettings.new()
	owned_settings.font_size = _ui_font(-2)
	owned_settings.font_color = Color(0.66, 0.68, 0.72)
	owned_settings.outline_size = base_settings.outline_size
	owned_settings.outline_color = base_settings.outline_color

	var owned_label := Label.new()
	owned_label.name = "Owned"
	owned_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	owned_label.label_settings = owned_settings
	owned_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	owned_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(owned_label)

	_shop_slots.append({
		"kind": kind,
		"button": button,
		"icon": icon,
		"price_label": price_label,
		"crew_label": crew_label,
		"cost_meter": cost_meter,
		"owned_label": owned_label,
	})


## Flat-shaded slot squares with chunky borders — UI_UX.md §5's Minecraft
## adjacency, and deliberately the same near-black/hazard-yellow pair the
## rest of the HUD already uses rather than a third palette.
func _shop_slot_style(state: String) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.set_border_width_all(_ui_i(3))
	style.set_content_margin_all(_ui_px(6.0))
	match state:
		"hover", "focus":
			style.bg_color = Color(0.19, 0.19, 0.21, 0.98)
			style.border_color = Color(0.85, 0.63, 0.11, 0.95)
		"pressed":
			style.bg_color = Color(0.30, 0.24, 0.08, 0.98)
			style.border_color = Color(0.98, 0.80, 0.22, 1.0)
		"disabled":
			# Visibly recessed and dim: an unaffordable slot reads as "off"
			# from its border and background as well as its greyed icon and
			# its price glyph, never from colour alone (UI_UX.md §7).
			style.bg_color = Color(0.08, 0.08, 0.09, 0.92)
			style.border_color = Color(0.20, 0.21, 0.23, 0.95)
		_:
			style.bg_color = Color(0.13, 0.14, 0.16, 0.96)
			style.border_color = Color(0.36, 0.38, 0.42, 0.95)
	return style


## Which asset's icon stands for a buildable kind — see SHOP_MODELS.
func _shop_asset_for(kind: String) -> String:
	if SHOP_MODELS.has(kind):
		return SHOP_MODELS[kind]
	return MACHINE_MODELS.get(kind, MACHINE_MODEL_FALLBACK)


## The ids that carry a name of their own, from `display_names_json` —
## `{"bbq": "BBQ", ...}`. Filled once by `_load_display_names` and read by
## `_kind_display_name`; empty until then, which is the title-case fallback.
var _display_names: Dictionary = {}


## Reads the one map of content-supplied labels. Not polled: it is
## `data/*.ron` read back, so it cannot change while a game is running.
func _load_display_names() -> void:
	var parsed = JSON.parse_string(sim.display_names_json())
	_display_names = parsed if parsed is Dictionary else {}


## "cooking_vat" -> "Cooking Vat". Kind ids are content, so the menu titles
## itself from them rather than carrying a hand-written label per kind that
## a new `data/shop.ron` entry would silently miss.
##
## Title-casing is the FALLBACK, not the rule: content that title-cases
## wrong names itself in `data/*.ron` and arrives here through
## `_display_names` (issue #60 — the second sauce read as "Boxed Bbq"). The
## table is deliberately tiny, so an id missing from it is the normal case
## rather than a stale lookup.
func _kind_display_name(kind: String) -> String:
	if _display_names.has(kind):
		return String(_display_names[kind])
	var words: PackedStringArray = kind.split("_", false)
	var out: Array[String] = []
	for word in words:
		out.append(word.capitalize())
	return " ".join(out)


## Repolls `shop_snapshot_json` and redraws every slot. Called each frame
## while the menu is open and once on opening — cheap (one JSON parse of a
## nine-entry object) and it means money earned by the running factory makes
## a slot become affordable under the player's eyes.
func _update_shop_menu() -> void:
	if _shop_menu == null:
		return
	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	_shop_money_label.text = "Money: %.0f" % float(snapshot.get("money", 0.0))
	_position_shop_menu()

	# Built once per redraw, not per slot: the last staff poll's wage per
	# category, so a card's crew line can price its own cost (ticket 4).
	var wages_by_category: Dictionary = {}
	for category in _staff_snapshot.get("categories", []):
		wages_by_category[String(category.get("id", ""))] = int(category.get("wage", 0))

	for index in range(_shop_slots.size()):
		if index >= entries.size():
			break
		var slot: Dictionary = _shop_slots[index]
		var entry: Dictionary = entries[index]
		var affordable: bool = bool(entry.get("affordable", false))
		var price: float = float(entry.get("price", 0.0))

		# Three independent signals for "you can't afford this", per
		# UI_UX.md §7's never-colour-alone rule: the price gains a "✗" mark,
		# the icon dims, and the whole slot is disabled (which also recolours
		# its border/background via the disabled stylebox).
		slot["price_label"].text = ("Cost %.0f" % price) if affordable else ("Cost %.0f  ✗" % price)
		slot["crew_label"].text = _crew_cost_text(entry.get("crew", []), wages_by_category)
		slot["price_label"].label_settings.font_color = (
			Color(0.92, 0.93, 0.94) if affordable else Color(0.55, 0.50, 0.48)
		)
		slot["icon"].modulate = Color.WHITE if affordable else Color(0.42, 0.42, 0.45, 0.75)
		slot["button"].disabled = not affordable
		# ...and a fourth reading of the same fact, which is the only one that
		# says HOW unaffordable: the share of the balance this price takes,
		# pinned full and red once it takes more than all of it. A price the
		# balance barely notices still draws a sliver rather than nothing —
		# an empty track next to a real price reads as a broken gauge, and
		# "this costs almost nothing" is what the sliver means.
		var money: float = float(snapshot.get("money", 0.0))
		var share: float = price / money if money > 0.0 else 1.0
		if affordable and price > 0.0:
			share = maxf(share, SHOP_METER_MIN_SHARE)
		_set_meter(
			slot["cost_meter"], 1.0 if not affordable else share,
			METER_FILL_WARN if not affordable else METER_FILL_LEVEL
		)
		# Just the count. The owned line used to carry the PLACE affordance
		# ("right-click to hold") as well, and at the 2026-09-09 UI scale that
		# sentence wraps onto a second row in every card, which costs the
		# whole grid an extra row — more than the menu has to give above the
		# hotbar. It is not lost: the footer one line below says it, the
		# hotbar tooltip says it, and the number itself (which is what
		# actually decides whether placing is possible) is still here and
		# still recoloured.
		var owned: int = int(entry.get("owned", 0))
		slot["owned_label"].text = "Owned %d" % owned
		slot["owned_label"].label_settings.font_color = (
			Color(0.98, 0.85, 0.42) if owned > 0 else Color(0.66, 0.68, 0.72)
		)


func _on_shop_slot_pressed(index: int) -> void:
	_buy_slot(index)


## A slot has two actions, and they are on the two mouse buttons.
##
## **Left-click buys one; right-click places one you already own.** Both were
## weighed against the alternative of one button that changes meaning with
## the owned count — "click buys when you have none, places when you have
## some" — which is shorter to explain and worse to use: it makes buying a
## second of anything impossible without first placing the first, and it
## makes the same gesture do two different things depending on state the
## player has to remember. Two buttons, two meanings, both spelled out on the
## slot itself (the owned line says "right-click to place") and in the menu's
## footer. The keyboard mirrors it: number buys, SHIFT+number places.
func _on_shop_slot_gui_input(event: InputEvent, index: int) -> void:
	if not (event is InputEventMouseButton):
		return
	if event.button_index != MOUSE_BUTTON_RIGHT or not event.pressed:
		return
	# Consumed here so the isometric camera's right-drag pan never starts
	# under the menu.
	get_viewport().set_input_as_handled()
	_place_from_slot(index)


## Enters placement mode for a slot's kind, if the player owns one. A slot
## with nothing owned simply does nothing — the ghost would be unbuildable,
## and the slot already says "Owned 0".
func _place_from_slot(index: int) -> void:
	if index < 0 or index >= _shop_slots.size():
		return
	_refresh_owned_counts()
	_enter_build_mode(String(_shop_slots[index]["kind"]))


## Buys exactly one of the slot's kind. Quantity is deliberately fixed at
## one — `PlayerCommand::Purchase`'s own wire default — so a click means one
## thing and the menu needs no quantity widget. An unaffordable or unknown
## purchase is a silent no-op in the simulation, so the only thing this has
## to do afterwards is re-read the snapshot either way.
func _buy_slot(index: int) -> void:
	if index < 0 or index >= _shop_slots.size():
		return
	var kind: String = _shop_slots[index]["kind"]
	var owned_before := _owned_of(kind)
	sim.issue_command_json(JSON.stringify({"type": "purchase", "kind": kind}))
	_refresh_owned_counts()
	_update_shop_menu()
	_cue(FactoryAudio.BUY if _owned_of(kind) > owned_before else FactoryAudio.REFUSED)


func _set_shop_menu_open(open: bool) -> void:
	if _shop_menu == null or open == _shop_open:
		return
	# One panel at a time: a building's configuration panel is anchored to a
	# building, and leaving it up under a modal grid would leave two panels
	# both claiming the next click.
	if open:
		_close_config_panel()
	_shop_open = open
	_shop_menu.visible = open
	_cue(FactoryAudio.MENU_OPEN if open else FactoryAudio.MENU_CLOSE)
	if open:
		_update_shop_menu()
	# The menu is clickable in first-person too, which means handing the
	# mouse back while it is up and recapturing it on close — otherwise the
	# only way to buy in that mode would be the number keys.
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


## The crosshair stands in for the cursor in first-person — so it belongs on
## screen in exactly the case where there is no real cursor. With either shop
## panel up the mouse is handed back (above), and leaving the crosshair drawn
## would park a stray mark on top of a slot.
## Whether something on screen wants the cursor: any of the five modal
## panels, the configuration panel or the pause menu — or the fact that this
## scene is being torn down for the main menu. The one answer the
## first-person mouse capture and the crosshair both read.
func _fp_mouse_free() -> bool:
	return _leaving_to_menu or _modal_open() or _config_open or _pause_open


## Any of the five modal panels (E, M, C, H, P) is up. Build mode is not a
## modal — see `_anything_open` for the version that counts it.
func _modal_open() -> bool:
	return _shop_open or _market_open or _board_open or _staff_open or _production_open


## In first-person the mouse is captured for looking around unless a panel
## wants it (`_fp_mouse_free`); in isometric it is always visible.
func _apply_fp_mouse_mode() -> void:
	if _view_mode != ViewMode.FIRST_PERSON:
		return
	Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if _fp_mouse_free() else Input.MOUSE_MODE_CAPTURED


func _update_crosshair_visibility() -> void:
	if _crosshair == null:
		return
	_crosshair.visible = _view_mode == ViewMode.FIRST_PERSON and not _fp_mouse_free()


func _toggle_shop_menu() -> void:
	_set_shop_menu_open(not _shop_open)


# --------------------------------------------------------------------------
# The ingredient market and the larder (the chain-rework epic)
# --------------------------------------------------------------------------

## Repolls `ingredients_snapshot_json`. Two things come off it: the stock
## counts the larder prints, and `hopper_items` — the list of ids a hopper
## may legally be placed holding, which is the simulation's own
## `World::raw_items` rather than anything decided here. A third raw
## ingredient therefore needs no Godot edit at all: it appears in the market,
## in the larder and in a placed hopper's contents picker from the data
## file alone.
func _ingredients_snapshot() -> Dictionary:
	var parsed = JSON.parse_string(sim.ingredients_snapshot_json())
	return parsed if parsed is Dictionary else {}


## id -> owned count, from `_ingredients_snapshot`'s `entries` — the one
## lookup the configuration panel's two fill checks need, so it exists once.
func _owned_ingredient_counts() -> Dictionary:
	var owned := {}
	for entry in _ingredients_snapshot().get("entries", []):
		owned[String(entry.get("id", ""))] = int(entry.get("owned", 0))
	return owned


func _refresh_hopper_items() -> void:
	var snapshot := _ingredients_snapshot()
	var items: Array = snapshot.get("hopper_items", [])
	_hopper_items = items.duplicate()


## What the hopper currently being placed will hold — always the FIRST raw
## ingredient, since the contents choice moved onto the placed building (see
## `_hopper_items`). "" when the kind in hand is not a hopper, or when the
## world has no raw solids at all, which is a world with no recipes and
## cannot happen with shipped content.
func _selected_hopper_item() -> String:
	if _build_kind != HOPPER_KIND or _hopper_items.is_empty():
		return ""
	return String(_hopper_items[0])


## "tomato_paste" -> "Tomato Paste". Item ids are content, exactly as kind ids
## are, so this is `_kind_display_name`'s twin rather than a hand-written
## label table a new ingredient would silently miss.
func _item_display_name(item_id: String) -> String:
	return _kind_display_name(item_id)


## Builds the market panel. Same shape as `_build_shop_menu`, one row of
## slots instead of a grid — there are three ingredients and a row of three
## is shorter and no less readable than a grid of three would be.
func _build_ingredient_market(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = _ui_i(4)
	panel_style.border_width_left = _ui_i(2)
	panel_style.border_width_right = _ui_i(2)
	panel_style.border_width_bottom = _ui_i(2)
	panel_style.set_content_margin_all(_ui_px(16.0))

	# Cleared, never appended to: `_ready()` genuinely runs twice under the
	# headless `--script` harness (see `_rebuild_world`'s note and
	# test_hover.gd's header), and a second pass would otherwise leave the
	# array holding two slots per ingredient — half of them pointing at
	# buttons in an orphaned HUD layer.
	_market_slots.clear()
	_market_slot_ids.clear()

	_market_panel = PanelContainer.new()
	_market_panel.name = "IngredientMarket"
	_market_panel.add_theme_stylebox_override("panel", panel_style)
	_market_panel.visible = false
	hud.add_child(_market_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(10))
	_market_panel.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(4)
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	# Heading and balance on one row, for `_build_shop_menu`'s reason — this
	# panel is deliberately the other half of the same shop.
	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(16))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "INGREDIENT MARKET"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.add_child(title)

	var money_settings := LabelSettings.new()
	money_settings.font_size = _ui_font(6)
	money_settings.font_color = Color(0.98, 0.85, 0.42)
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_market_money_label = Label.new()
	_market_money_label.label_settings = money_settings
	_market_money_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	heading.add_child(_market_money_label)

	# A GRID, NOT A ROW, and inside a scroll (issue #69). One HBox of
	# fixed-size crates has no width bound at all: three ingredients measured
	# 648px and looked like a design, and the BBQ gate's six measured 1260px
	# in a 1280px window — the crates filled the screen, the panel lay over
	# the right-hand plates, and a seventh ingredient would simply have been
	# off the edge with no way to reach it. Wrapping is the build menu's own
	# answer to the same problem (`SHOP_SLOT_COLUMNS`) and the right one here
	# too: a sideways scroll hides half the stock on sale behind a gesture,
	# where a second row shows it. `_position_market_panel` picks the column
	# count from the window, and the scroll is the same last resort the build
	# menu's grid has (§5c) for when the rows are taller than the space above
	# the hotbar.
	_market_scroll = ScrollContainer.new()
	_market_scroll.name = "MarketScroll"
	_market_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_market_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_market_scroll)

	var row := GridContainer.new()
	row.name = "MarketRow"
	row.columns = MARKET_SLOT_COLUMNS
	row.add_theme_constant_override("h_separation", _ui_i(8))
	row.add_theme_constant_override("v_separation", _ui_i(8))
	_market_scroll.add_child(row)
	_market_row = row
	_market_base_settings = base_settings

	_rebuild_market_slots(_ingredients_snapshot().get("entries", []))

	var footer := Label.new()
	footer.label_settings = base_settings
	# BOTH VERBS, NAMED. A market crate is the build slot's two-actions-one-
	# square shape (UI_UX.md §5b) with the modifier standing in for the second
	# mouse button, so the footer spells out both the way the build menu's
	# does — a gesture nobody is told about is a gesture nobody uses. The
	# shift line gets its own line rather than a "·" join so the footer stays
	# no wider than the slot row it sits under.
	footer.text = "click a crate to buy %d\nshift+click: buy all you can afford\nthen click a hopper or tank to load it    M/ESC: close" % MARKET_CRATE
	body.add_child(footer)

	_position_market_panel()


## Centred in the space above the hotbar, for `_position_shop_menu`'s reason
## and by the same arithmetic: a panel tall enough to reach the strip buries
## its own footer under it.
##
## And clamped on BOTH axes since issue #69, not only on `y`. The crates wrap
## to as many columns as the window has room for (`_fit_grid_columns`), which
## is what keeps the panel inside the window at all; the clamp below is the
## backstop for a panel that is still wider or taller than the space it has,
## and it is what stops a crate ever being drawn off an edge where no click
## can reach it.
##
## Then PUSHED CLEAR of the right-hand column of fixed plates where there is
## room to be — the clipboard, the stock plate and the CREW plate — the way
## `_panel_position_near` already pushes a cursor-following panel (§2b point
## 33). This panel carries its own `Money:` line, and centred over the
## clipboard's it printed the same figure twice a few pixels apart. The
## legend is deliberately NOT on that list: it is a keybind reference, top
## left, that a shopping player is not reading, and dodging it as well leaves
## a six-crate market nowhere to stand. `_pushed_clear_of` returns the panel
## where it was when no direction clears, so a wide market stays centred
## rather than jumping to an edge.
func _position_market_panel() -> void:
	if _market_panel == null:
		return
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := _hotbar_reserved_height()
	var bounds := vp.get_visible_rect().size
	_fit_grid_columns(_market_panel, _market_row, _market_slots.size(), MARKET_SLOT_COLUMNS)
	# The cut lands between two ROWS of crates, never through one: a crate cut
	# in half loses its price and its stock line, which is text sliced through
	# a line (issue #8's rule, in the one panel it had not reached).
	_fit_grid_scroll(
		_market_scroll, _market_row, bounds.y - reserved - _ui_px(16.0), true
	)
	_market_panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var panel_size := _market_panel.get_combined_minimum_size()
	var lower_bound: float = bounds.y - reserved
	var rect := Rect2(
		clampf((bounds.x - panel_size.x) * 0.5, 0.0, maxf(0.0, bounds.x - panel_size.x)),
		clampf(
			(lower_bound - panel_size.y) * 0.5, 8.0, maxf(8.0, lower_bound - panel_size.y)
		),
		panel_size.x,
		panel_size.y
	)
	for plate in [_contract_panel_rect(), _stock_rect(), _crew_rect()]:
		if plate.size.x > 0.0 and plate.size.y > 0.0:
			rect = _pushed_clear_of(rect, plate, bounds.x, lower_bound)
	_market_panel.position = rect.position


func _build_market_slot(row: GridContainer, base_settings: LabelSettings, index: int, item_id: String) -> void:
	var button := Button.new()
	button.name = "MarketSlot_%s" % item_id
	button.custom_minimum_size = MARKET_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(state, _shop_slot_style(state))
	button.pressed.connect(_buy_ingredient_slot.bind(index))
	# SHIFT+left-click is the second half of the slot (see
	# `_on_market_slot_gui_input`). A Button reports a plain left click
	# through `pressed` with no modifier state attached, so the second action
	# has to come off the raw event — the build slot's right-click place does
	# the same thing for the same reason.
	button.gui_input.connect(_on_market_slot_gui_input.bind(index))
	row.add_child(button)

	var column := VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	column.add_theme_constant_override("separation", _ui_i(2))
	column.set_anchors_preset(Control.PRESET_FULL_RECT)
	column.offset_left = _ui_px(8)
	column.offset_right = -_ui_px(8)
	column.offset_top = _ui_px(8)
	column.offset_bottom = -_ui_px(8)
	button.add_child(column)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = SHOP_ICON_SIZE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	# The item's OWN model, through the same ITEM_MODELS table the belt draws
	# with — so a crate of tomatoes in the market is the tomato that runs
	# down the line, which is UI_UX.md §5's "icons are rendered from the real
	# assets" rule doing its job. A fluid goes through FLUID_MODELS instead —
	# the jug it is bought in — and one with no jug still falls through to the
	# pipe it travels in.
	icon.texture = _icon_for_asset(_market_asset_for(item_id))
	column.add_child(icon)

	var name_label := Label.new()
	name_label.name = "ItemName"
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = base_settings
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.text = _item_display_name(item_id)
	column.add_child(name_label)

	var price_settings := LabelSettings.new()
	price_settings.font_size = _ui_font()
	price_settings.font_color = base_settings.font_color
	price_settings.outline_size = base_settings.outline_size
	price_settings.outline_color = base_settings.outline_color

	var price_label := Label.new()
	price_label.name = "Price"
	price_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	price_label.label_settings = price_settings
	price_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	price_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(price_label)

	# THE SECOND VERB, AND WHAT IT WOULD ACTUALLY FETCH. "shift+click buys
	# all you can afford" is a promise about a number the player cannot work
	# out at a glance — it is the balance divided by a unit price printed two
	# lines below — so the slot prints the answer instead of asking them to
	# do the division. It sits directly under the crate price because the two
	# lines are the slot's two verbs and they should be read together
	# (UI_UX.md §5b). Its own settings object, not the price's: the two lines
	# dim on different conditions (a crate may be out of reach while a
	# handful of units is not).
	var shift_settings := LabelSettings.new()
	shift_settings.font_size = _ui_font(-2)
	shift_settings.font_color = Color(0.98, 0.85, 0.42)
	shift_settings.outline_size = base_settings.outline_size
	shift_settings.outline_color = base_settings.outline_color

	var shift_label := Label.new()
	shift_label.name = "ShiftBuy"
	shift_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	shift_label.label_settings = shift_settings
	shift_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	shift_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(shift_label)

	# The same cost-against-balance bar the build menu's slots carry, on the
	# same mechanism — a crate of ingredients and a machine are both money
	# leaving the one counter, and the player should not have to read two
	# different pictures of it.
	var cost_meter := _build_meter(column, 0.0, METER_FILL_LEVEL,
		METER_TRACK_COLOR, METER_BORDER_COLOR, SHOP_METER_HEIGHT)
	cost_meter.name = "CostMeter"

	var owned_settings := LabelSettings.new()
	owned_settings.font_size = _ui_font(-2)
	owned_settings.font_color = Color(0.66, 0.68, 0.72)
	owned_settings.outline_size = base_settings.outline_size
	owned_settings.outline_color = base_settings.outline_color

	var owned_label := Label.new()
	owned_label.name = "Stock"
	owned_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	owned_label.label_settings = owned_settings
	owned_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	owned_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(owned_label)

	_market_slots.append({
		"id": item_id,
		"button": button,
		"icon": icon,
		"price_label": price_label,
		"shift_label": shift_label,
		"cost_meter": cost_meter,
		"owned_label": owned_label,
	})


## Which voxel model's icon stands for an ingredient. `ITEM_MODELS` for a
## solid, then FLUID_MODELS for a fluid the player buys by the jug; a fluid
## with neither still borrows the pipe it travels in, which is where all of
## them stood before vinegar was drawn.
func _market_asset_for(item_id: String) -> String:
	if ITEM_MODELS.has(item_id):
		return ITEM_MODELS[item_id]
	if FLUID_MODELS.has(item_id):
		return FLUID_MODELS[item_id]
	return PIPE_ASSET


## Rebuilds the crates from an `entries` array, `_rebuild_board_rows`'s
## counterpart and for the same reason: the market is a list the simulation
## decides the length of, and a panel built once at `_ready()` would still be
## showing three crates after a gate put six on sale.
func _rebuild_market_slots(entries: Array) -> void:
	for slot in _market_slots:
		var button: Node = slot["button"]
		if is_instance_valid(button):
			if button.get_parent() != null:
				button.get_parent().remove_child(button)
			button.queue_free()
	_market_slots.clear()
	_market_slot_ids.clear()
	if _market_row == null or _market_base_settings == null:
		return
	for entry in entries:
		var id := String(entry.get("id", ""))
		_build_market_slot(_market_row, _market_base_settings, _market_slots.size(), id)
		_market_slot_ids.append(id)


func _market_slots_match(entries: Array) -> bool:
	if entries.size() != _market_slot_ids.size():
		return false
	for i in range(entries.size()):
		if String(entries[i].get("id", "")) != String(_market_slot_ids[i]):
			return false
	return true


func _update_ingredient_market() -> void:
	if _market_panel == null:
		return
	var snapshot := _ingredients_snapshot()
	var entries: Array = snapshot.get("entries", [])
	if not _market_slots_match(entries):
		_rebuild_market_slots(entries)
	_market_money_label.text = "Money: %.0f" % float(snapshot.get("money", 0.0))
	_position_market_panel()

	for index in range(_market_slots.size()):
		if index >= entries.size():
			break
		var slot: Dictionary = _market_slots[index]
		var entry: Dictionary = entries[index]
		var unit_price: float = float(entry.get("price", 0.0))
		var crate_price := unit_price * float(MARKET_CRATE)
		var affordable: bool = float(snapshot.get("money", 0.0)) >= crate_price
		# The three never-colour-alone signals the build menu already uses:
		# a "✗" on the price, a dimmed icon, and a disabled (recessed) slot.
		slot["price_label"].text = "Buy %d  ·  %.0f" % [MARKET_CRATE, crate_price]
		if not affordable:
			slot["price_label"].text += "  ✗"
		slot["price_label"].label_settings.font_color = (
			Color(0.92, 0.93, 0.94) if affordable else Color(0.55, 0.50, 0.48)
		)
		slot["icon"].modulate = Color.WHITE if affordable else Color(0.42, 0.42, 0.45, 0.75)
		# WHAT SHIFT+CLICK WOULD FETCH RIGHT NOW, recomputed every poll from
		# the wire's own unit price (never a Godot-side idea of one), so the
		# second verb is a number on the card rather than a promise the
		# player has to do arithmetic to check.
		var units := _units_affordable(float(snapshot.get("money", 0.0)), unit_price)
		slot["shift_label"].text = (
			"shift: buy %d" % units if units > 0 else "shift: buy 0  ✗"
		)
		slot["shift_label"].label_settings.font_color = (
			Color(0.98, 0.85, 0.42) if units > 0 else Color(0.55, 0.50, 0.48)
		)
		# A SLOT IS RECESSED ONLY WHEN NEITHER VERB CAN DO ANYTHING. It went
		# disabled the moment a whole crate was out of reach, which was right
		# while a crate was the only thing a click could buy; with shift on
		# the same square, a balance that covers four tomatoes but not ten
		# still has a real action on it, and a disabled Button is exactly the
		# wrong picture of that. The crate itself being unaffordable is still
		# said three other ways (the "✗", the dimmed icon and the meter
		# below), so the recess is the one signal that changes meaning here.
		slot["button"].disabled = not affordable and units <= 0
		# ...and a fourth reading of the same fact, which is the only one that
		# says HOW unaffordable: the share of the balance this price takes,
		# pinned full and red once it takes more than all of it. A price the
		# balance barely notices still draws a sliver rather than nothing —
		# an empty track next to a real price reads as a broken gauge, and
		# "this costs almost nothing" is what the sliver means.
		var money: float = float(snapshot.get("money", 0.0))
		var share: float = crate_price / money if money > 0.0 else 1.0
		if affordable and crate_price > 0.0:
			share = maxf(share, SHOP_METER_MIN_SHARE)
		_set_meter(
			slot["cost_meter"], 1.0 if not affordable else share,
			METER_FILL_WARN if not affordable else METER_FILL_LEVEL
		)
		# Two lines, written out rather than left to autowrap: the wrap point
		# is then the same on every crate whatever the numbers are, which a
		# rendered frame showed matters — a ragged one-word overflow reads as
		# a bug, a deliberate second line reads as a spec.
		slot["owned_label"].text = "In stock %d\n%.0f each" % [int(entry.get("owned", 0)), unit_price]


## Buys one crate, or `quantity` units when a caller has worked out a better
## number (`_buy_all_from_slot`). An unaffordable or unknown purchase is a
## silent no-op in the simulation (`BuyIngredient`, like `Purchase`), so the
## only thing to do afterwards is re-read either way — and the balance moving
## is what says the simulation took it, at any quantity.
func _buy_ingredient_slot(index: int, quantity: int = MARKET_CRATE) -> void:
	if index < 0 or index >= _market_slots.size():
		return
	var money_before := _current_money()
	sim.issue_command_json(JSON.stringify({
		"type": "buy_ingredient",
		"item": String(_market_slots[index]["id"]),
		"quantity": quantity,
	}))
	_update_ingredient_market()
	_cue(FactoryAudio.BUY if _current_money() < money_before else FactoryAudio.REFUSED)


## How many units of `unit_price` a balance of `money` covers. Pure, and the
## one place the "buy all you can afford" arithmetic lives — the slot's
## printed promise and the click that keeps it must never be able to
## disagree.
##
## The division is only a first guess. Money crosses the wire as a JSON
## double and an exact multiple can come back a hair either side of itself,
## so the answer is settled by MULTIPLYING back within `MARKET_PRICE_EPSILON`
## — the operation the simulation itself will do (`IngredientCatalog::
## cost_of`) when it prices the command. A free or unpriced ingredient
## (`price <= 0`) has no "as many as you can afford" and buys nothing, rather
## than dividing by zero into an infinity that becomes a nonsense quantity.
func _units_affordable(money: float, unit_price: float) -> int:
	if unit_price <= 0.0 or money <= 0.0:
		return 0
	var units := int(floor(money / unit_price))
	while units > 0 and float(units) * unit_price > money + MARKET_PRICE_EPSILON:
		units -= 1
	while float(units + 1) * unit_price <= money + MARKET_PRICE_EPSILON:
		units += 1
	return units


## [`_units_affordable`] for one ingredient id, against the live balance and
## the live price — the number the slot prints on its shift line.
func _affordable_units(item_id: String) -> int:
	var snapshot := _ingredients_snapshot()
	var money := float(snapshot.get("money", 0.0))
	for entry in snapshot.get("entries", []):
		if String(entry.get("id", "")) == item_id:
			return _units_affordable(money, float(entry.get("price", 0.0)))
	return 0


## SHIFT+click's half of a market slot: buy as many units as the balance
## covers, in ONE command.
##
## One command, not a loop of crates: `BuyIngredient` takes an arbitrary
## `quantity` and prices it in one go (`IngredientCatalog::cost_of`, then a
## single all-or-nothing `Economy::try_spend`), so a loop would only be a
## slower way to reach the same balance — and a partially-completed loop
## would be a new failure mode the simulation does not have.
##
## Nothing affordable means nothing is sent. The simulation would refuse a
## zero quantity anyway (`cost_of` returns `None` for it), but a command
## issued to be refused is a command that could be taken, and the player is
## owed the same "no" they get everywhere else: the one shared refusal cue
## (UI_UX.md §8), matching the "✗" the slot is already showing.
func _buy_all_from_slot(index: int) -> void:
	if index < 0 or index >= _market_slots.size():
		return
	var units := _affordable_units(String(_market_slots[index]["id"]))
	if units <= 0:
		_cue(FactoryAudio.REFUSED)
		return
	_buy_ingredient_slot(index, units)


## A market slot has two actions on one square, the way a build slot does
## (UI_UX.md §5b) — but with a modifier rather than the second mouse button,
## because both of these actions are BUYING and they differ only in how much.
## Left-click buys a crate; SHIFT+left-click buys everything the balance
## covers, which is the one quantity worth a gesture of its own: it is the
## quantity a player stocking up before a long run actually wants, and it is
## the only one that cannot be reached by clicking (the crate is ten, and the
## balance is rarely a multiple of ten unit prices).
##
## Taken off the raw event and consumed here, because a `Button`'s `pressed`
## signal carries no modifier state and would otherwise ALSO fire the crate
## buy on the same click. `Control` emits `gui_input` before the button's own
## handling for exactly this reason, so marking the event handled is what
## keeps one gesture to one purchase.
func _on_market_slot_gui_input(event: InputEvent, index: int) -> void:
	if not (event is InputEventMouseButton):
		return
	if event.button_index != MOUSE_BUTTON_LEFT or not event.pressed or not event.shift_pressed:
		return
	get_viewport().set_input_as_handled()
	_buy_all_from_slot(index)


func _set_market_open(open: bool) -> void:
	if _market_panel == null or open == _market_open:
		return
	if open:
		_close_config_panel() # see `_set_shop_menu_open`
	_market_open = open
	_market_panel.visible = open
	_cue(FactoryAudio.MENU_OPEN if open else FactoryAudio.MENU_CLOSE)
	if open:
		_update_ingredient_market()
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


func _toggle_market() -> void:
	_set_market_open(not _market_open)


# --------------------------------------------------------------------------
# The contracts board (the contract-board epic) — see `_board_panel`'s doc
# --------------------------------------------------------------------------

## Builds the board menu. The market's shape (dark plate, heading and balance
## on one row, a footer naming the verbs) with a scrolling column of paper
## offer dockets between them. Rows come from `economy_snapshot_json`'s
## `board`, in file order.
func _build_contract_board(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = _ui_i(4)
	panel_style.border_width_left = _ui_i(2)
	panel_style.border_width_right = _ui_i(2)
	panel_style.border_width_bottom = _ui_i(2)
	panel_style.set_content_margin_all(_ui_px(16.0))

	# Cleared, never appended to — `_ready()` runs twice under the headless
	# harness (see `_build_ingredient_market`).
	_board_rows.clear()
	_board_row_ids.clear()

	_board_panel = PanelContainer.new()
	_board_panel.name = "ContractBoard"
	_board_panel.add_theme_stylebox_override("panel", panel_style)
	_board_panel.visible = false
	hud.add_child(_board_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(10))
	_board_panel.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(4)
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(16))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "CONTRACTS BOARD"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.add_child(title)

	# Money on the menu where the decision is made, for `_build_shop_menu`'s
	# reason: "can I afford this signature" should not need a glance across
	# the screen.
	var money_settings := LabelSettings.new()
	money_settings.font_size = _ui_font(6)
	money_settings.font_color = Color(0.98, 0.85, 0.42)
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_board_money_label = Label.new()
	_board_money_label.label_settings = money_settings
	_board_money_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	heading.add_child(_board_money_label)

	_board_scroll = ScrollContainer.new()
	_board_scroll.name = "BoardScroll"
	_board_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_board_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_board_scroll)

	_board_box = VBoxContainer.new()
	_board_box.name = "BoardRows"
	_board_box.add_theme_constant_override("separation", _ui_i(6))
	_board_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_board_scroll.add_child(_board_box)

	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_rebuild_board_rows(econ.get("board", []))

	var footer := Label.new()
	footer.label_settings = base_settings
	footer.text = "click SIGN to take an order — one of each, never two\nmiss its strikes in a row and it is lost: it comes back here to be signed again    C/ESC: close"
	body.add_child(footer)

	_position_contract_board()


## Centred in the space above the hotbar, by `_position_shop_menu`'s
## arithmetic and for its reason (the footer must stay on screen).
func _position_contract_board() -> void:
	if _board_panel == null:
		return
	_board_panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := _hotbar_reserved_height()
	var bounds := vp.get_visible_rect().size
	# `snap_rows`: an offer is a card the player reads before agreeing to it,
	# and the SIGN button is on the same line as the terms — half a card is
	# half a decision (issue #62's rule, one down from an unreachable button).
	_fit_grid_scroll(_board_scroll, _board_box, bounds.y - reserved - _ui_px(16.0), true)
	var panel_size := _board_panel.get_combined_minimum_size()
	_board_panel.position.x = maxf(0.0, (bounds.x - panel_size.x) * 0.5)
	_board_panel.position.y = max(8.0, (bounds.y - reserved - panel_size.y) * 0.5)


## Rebuilds the offer rows from a `board` array. The board is content and
## never changes length at runtime, but it is rebuilt through the same guard
## the clipboard uses so a content change cannot leave stale rows behind.
func _rebuild_board_rows(board: Array) -> void:
	for row in _board_rows:
		var panel: Node = row["panel"]
		if is_instance_valid(panel):
			if panel.get_parent() != null:
				panel.get_parent().remove_child(panel)
			panel.queue_free()
	_board_rows.clear()
	_board_row_ids.clear()
	for index in range(board.size()):
		_board_rows.append(_build_contract_board_row(board[index], index))
		_board_row_ids.append(String(board[index].get("id", "")))


func _board_rows_match(board: Array) -> bool:
	if board.size() != _board_row_ids.size():
		return false
	for i in range(board.size()):
		if String(board[i].get("id", "")) != String(_board_row_ids[i]):
			return false
	return true


## One offer: a paper docket (the clipboard's card style — an offer is an
## order that is not yet yours) with the terms in words and one SIGN button.
## Returns `{"id", "panel", "name_label", "terms_label", "status_label",
## "sign_button"}` for `_update_contract_board` to drive.
func _build_contract_board_row(offer: Dictionary, index: int) -> Dictionary:
	var panel := PanelContainer.new()
	panel.name = "Offer_%s" % String(offer.get("id", "?"))
	panel.add_theme_stylebox_override("panel", _contract_card_style)
	_board_box.add_child(panel)

	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", _ui_i(12))
	panel.add_child(row)

	var text_col := VBoxContainer.new()
	text_col.add_theme_constant_override("separation", _ui_i(3))
	text_col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(text_col)

	var name_label := Label.new()
	name_label.name = "OfferName"
	name_label.label_settings = _contract_name_settings
	name_label.text = String(offer.get("name", offer.get("id", "?")))
	text_col.add_child(name_label)

	# The mix, with the item's real icon (UI_UX.md §5) and its display name,
	# then the cadence, the payout and the strike rule — every term a player
	# is agreeing to, on the offer, before they click.
	#
	# On TWO lines, because that sentence is really two: what you deliver, and
	# on what terms. Held on one line, a two-item mix ("3 × Boxed Ketchup, 2 ×
	# Boxed BBQ Sauce every 3000 ticks · pays +210 · lost after 2 missed in a
	# row") made the card 1324px wide and the board 1380px — wider than a
	# 1280x720 window, clipped on both edges, with SIGN off the right of the
	# screen (issue #62). Broken at the join the sentence already had, the
	# column is as wide as its LONGER half instead of as wide as both, which is
	# what puts it back inside the window. It is a break at a fixed point, not
	# a reflow — see `autowrap_mode` under MODAL_EDGE_MARGIN for why the
	# difference matters here.
	var mix_row := HBoxContainer.new()
	mix_row.add_theme_constant_override("separation", _ui_i(6))
	text_col.add_child(mix_row)
	var parts: Array = []
	for pair in offer.get("mix", []):
		var item_id: String = String(pair[0])
		var icon := TextureRect.new()
		icon.custom_minimum_size = _ui_v(Vector2(16, 16))
		icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		icon.texture = _icon_for(item_id)
		mix_row.add_child(icon)
		parts.append("%d × %s" % [int(pair[1]), _item_display_name(item_id)])
	var mix_label := Label.new()
	mix_label.name = "OfferMix"
	mix_label.label_settings = _contract_ink_settings
	mix_label.text = ", ".join(PackedStringArray(parts))
	mix_row.add_child(mix_label)
	var terms_label := Label.new()
	terms_label.name = "OfferTerms"
	terms_label.label_settings = _contract_ink_settings
	terms_label.text = "every %d ticks  ·  pays +%d  ·  lost after %d missed in a row" % [
		int(offer.get("cadence_ticks", 0)),
		int(offer.get("payout", 0)),
		int(offer.get("strikes", 1)),
	]
	text_col.add_child(terms_label)

	var status_label := Label.new()
	status_label.name = "OfferStatus"
	status_label.label_settings = _contract_meta_settings
	text_col.add_child(status_label)

	var sign_button := Button.new()
	sign_button.name = "Sign_%s" % String(offer.get("id", "?"))
	sign_button.focus_mode = Control.FOCUS_NONE
	sign_button.custom_minimum_size = _ui_v(Vector2(128, 44))
	sign_button.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	sign_button.add_theme_font_size_override("font_size", _ui_font(1))
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		sign_button.add_theme_stylebox_override(state, _shop_slot_style(state))
	sign_button.pressed.connect(_sign_contract_offer.bind(index))
	row.add_child(sign_button)

	return {
		"id": String(offer.get("id", "")),
		"panel": panel,
		"name_label": name_label,
		"mix_label": mix_label,
		"terms_label": terms_label,
		"status_label": status_label,
		"sign_button": sign_button,
	}


## Reads the board off the economy snapshot and drives every row: the button
## says what a click will do (SIGN · price), or why it will do nothing
## (SIGNED — one of each; ✗ — the fee is more than the balance), with the
## same three never-colour-alone signals the build menu uses.
func _update_contract_board(econ: Dictionary = {}) -> void:
	if _board_panel == null:
		return
	if econ.is_empty():
		econ = _read_economy()
	var board: Array = econ.get("board", [])
	if not _board_rows_match(board):
		_rebuild_board_rows(board)
	_board_money_label.text = "Money: %.0f" % float(econ.get("money", 0.0))

	for i in range(min(board.size(), _board_rows.size())):
		var offer: Dictionary = board[i]
		var row: Dictionary = _board_rows[i]
		var price: int = int(offer.get("price", 0))
		var active: bool = bool(offer.get("active", false))
		var affordable: bool = bool(offer.get("affordable", false))
		var lost: int = int(offer.get("times_lost", 0))
		var button: Button = row["sign_button"]
		var status: Label = row["status_label"]
		var lost_note := ""
		if lost > 0:
			lost_note = "  ·  lost %d time%s before" % [lost, "" if lost == 1 else "s"]
		if active:
			button.text = "SIGNED"
			button.disabled = true
			status.text = "✔ signed and running — it is on your clipboard" + lost_note
			row["panel"].add_theme_stylebox_override("panel", _contract_card_style_ready)
		elif not affordable:
			button.text = "✗ SIGN · %d" % price
			button.disabled = true
			status.text = "✗ can't afford — the signature costs %d" % price + lost_note
			row["panel"].add_theme_stylebox_override("panel", _contract_card_style)
		else:
			button.text = "SIGN · %d" % price
			button.disabled = false
			if lost > 0:
				status.text = "✗ LOST — sign it again for %d" % price + lost_note
				row["panel"].add_theme_stylebox_override("panel", _contract_card_style_last_chance)
			else:
				status.text = "available — %d to sign" % price
				row["panel"].add_theme_stylebox_override("panel", _contract_card_style)
	_position_contract_board()


## Signs one offer. A refused signature (already held, unaffordable) is a
## silent no-op in the simulation, so the only thing to do afterwards is
## re-read — the clipboard too, so the new docket appears on the same frame.
func _sign_contract_offer(index: int) -> void:
	if index < 0 or index >= _board_rows.size():
		return
	var money_before := _current_money()
	sim.issue_command_json(JSON.stringify({
		"type": "sign_contract",
		"id": String(_board_rows[index]["id"]),
	}))
	_update_contract_board()
	_update_contract_panel()
	# A signature costs its fee; a refusal (already signed, unaffordable,
	# unknown) costs nothing — so the balance is what tells the two apart.
	_cue(FactoryAudio.SIGN if _current_money() < money_before else FactoryAudio.REFUSED)


func _set_contract_board_open(open: bool) -> void:
	if _board_panel == null or open == _board_open:
		return
	if open:
		_close_config_panel() # see `_set_shop_menu_open`
	_board_open = open
	_board_panel.visible = open
	_cue(FactoryAudio.MENU_OPEN if open else FactoryAudio.MENU_CLOSE)
	if open:
		_update_contract_board()
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


func _toggle_contract_board() -> void:
	_set_contract_board_open(not _board_open)


# --------------------------------------------------------------------------
# The staff panel (the staff pools MVP, ticket 3) — see `_staff_panel`'s doc
# --------------------------------------------------------------------------

## Builds the staff panel. The contracts board's shape (dark plate, heading
## and balance on one row, a footer naming the verbs) with one row per
## category between them, in wire order. Hidden until H is pressed.
func _build_staff_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = _ui_i(4)
	panel_style.border_width_left = _ui_i(2)
	panel_style.border_width_right = _ui_i(2)
	panel_style.border_width_bottom = _ui_i(2)
	panel_style.set_content_margin_all(_ui_px(16.0))

	# Cleared, never appended to — `_ready()` runs twice under the headless
	# harness (see `_build_ingredient_market`).
	_staff_rows.clear()
	_staff_row_ids.clear()
	# Reset before the poll below primes it, so the very first poll after a
	# rebuild never reads as "a payday just happened".
	_staff_known_payday_tick = -1

	_staff_panel = PanelContainer.new()
	_staff_panel.name = "StaffPanel"
	_staff_panel.add_theme_stylebox_override("panel", panel_style)
	_staff_panel.visible = false
	hud.add_child(_staff_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(10))
	_staff_panel.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(4)
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(16))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "STAFF"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.add_child(title)

	# Money on the panel, for `_build_shop_menu`'s reason: wages come out of
	# this figure every period, and "can I carry another head" is read
	# against it.
	var money_settings := LabelSettings.new()
	money_settings.font_size = _ui_font(6)
	money_settings.font_color = Color(0.98, 0.85, 0.42)
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_staff_money_label = Label.new()
	_staff_money_label.name = "StaffMoney"
	_staff_money_label.label_settings = money_settings
	_staff_money_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	heading.add_child(_staff_money_label)

	# The verdict, before any row: "is this factory staffed" answered in one
	# sentence at the top of the panel (the staffing ticket's requirement 2).
	# Its own settings object, recoloured per state by `_update_staff_panel`.
	_staff_summary_settings_obj = _staff_summary_settings()
	# The idle verdict's ink is the panel's own body colour, not a new one:
	# no new colours beyond the established palette.
	_staff_summary_idle_color = base_settings.font_color
	_staff_summary_label = Label.new()
	_staff_summary_label.name = "StaffSummary"
	_staff_summary_label.label_settings = _staff_summary_settings_obj
	body.add_child(_staff_summary_label)

	_staff_scroll = ScrollContainer.new()
	_staff_scroll.name = "StaffScroll"
	_staff_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_staff_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_staff_scroll)

	# Everything that scrolls lives in one box: the rows, then the rules.
	# The legend is IN the scroll, not under the footer, for UI_UX.md §2b
	# point 32's reason — `_fit_grid_scroll` takes the scroll's cap from the
	# PANEL's available height, so every line added as panel chrome is a line
	# clipped off the rows. Four lines of small print outside the scroll cost
	# a whole category row; inside it they cost nothing and are still one
	# flick away, which is the right price for text read once.
	#
	# ONE box, not a box of rows nested in a box of everything: the snapping in
	# `_whole_rows_height` cuts between the CHILDREN of the node it is given,
	# and with the rows nested those children were "all four rows" and "the
	# explainer" — so the only cut that was not the whole list was one through
	# the explainer's own lines (issue #63). Flat, every boundary the player
	# can see is a boundary the cut can land on, and the explainer is shown
	# whole or not at all.
	_staff_rows_box = VBoxContainer.new()
	_staff_rows_box.name = "StaffRows"
	_staff_rows_box.add_theme_constant_override("separation", _ui_i(6))
	_staff_rows_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_staff_scroll.add_child(_staff_rows_box)

	_poll_staff()
	_rebuild_staff_rows(_staff_snapshot.get("categories", []))

	# The rules of the model, in small print at the end of the scrolled
	# list (requirement 4). Static — they are the simulation's rules, not
	# this factory's state — so they are set once here and never touched by
	# a poll.
	_staff_rules_label = Label.new()
	_staff_rules_label.name = "StaffRules"
	_staff_rules_label.label_settings = _staff_meta_settings()
	_staff_rules_label.text = _staff_rules_text()
	_staff_rows_box.add_child(_staff_rules_label)

	_staff_footer_label = Label.new()
	_staff_footer_label.name = "StaffFooter"
	_staff_footer_label.label_settings = base_settings
	body.add_child(_staff_footer_label)

	_update_staff_panel()
	_position_staff_panel()


## Centred in the space above the hotbar, by `_position_contract_board`'s
## arithmetic and for its reason (the footer must stay on screen).
func _position_staff_panel() -> void:
	if _staff_panel == null:
		return
	_staff_panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := _hotbar_reserved_height()
	var bounds := vp.get_visible_rect().size
	_fit_staff_width()
	_fit_grid_scroll(_staff_scroll, _staff_rows_box, bounds.y - reserved - _ui_px(16.0), true)
	var panel_size := _staff_panel.get_combined_minimum_size()
	_staff_panel.position.x = maxf(0.0, (bounds.x - panel_size.x) * 0.5)
	_staff_panel.position.y = max(8.0, (bounds.y - reserved - panel_size.y) * 0.5)


## Makes the panel fit the window by moving each row's PROSE to the row's
## hover when it does not (issue #62).
##
## At 1280x720 the panel's minimum width was 1350px against 1264px of window:
## it was clipped on BOTH edges, and FIRE −1 — the only way to undo a hire —
## was off the right-hand one entirely. A control the player cannot reach
## outranks every other layout rule, so something on that row had to go.
##
## What goes is the things on the row that are sentences ABOUT the row rather
## than the row itself: the ranked sentence under the bar, the per-tick
## "3 of 4 working right now" beside it, and the bar's "hired / asked for"
## caption. Both are already readable elsewhere —
## `_staff_row_sentence` puts the sentences it cannot show on the row's
## tooltip and this puts the rest there with them, and the caption says what
## the two numbers printed ON the bar mean, which the panel's own explainer
## says as well. What stays is the icons, the meter, the numbers, the state
## chip and the two buttons: what the panel is FOR (issue #7), and the only
## parts of it that can be clicked.
##
## Measured, not assumed: the panel is asked whether it fits at its natural
## width every time, so a wider window shows the prose again and a future row
## that grows past the window gives its prose up without anyone re-tuning a
## breakpoint.
func _fit_staff_width() -> void:
	if _staff_panel == null:
		return
	var available: float = _modal_available_width()
	if not is_finite(available):
		return
	_staff_prose_hidden = false
	_apply_staff_prose()
	if _staff_panel.get_combined_minimum_size().x <= available:
		return
	_staff_prose_hidden = true
	_apply_staff_prose()


## Re-runs the prose rule on every row that is already built —
## `_update_staff_panel` fills the five sentence labels' TEXT from the wire and
## this decides which of them is on the row rather than on its hover, so the
## width rule above can change its mind without waiting for the next poll.
func _apply_staff_prose() -> void:
	for row in _staff_rows:
		var caption := row.get("meter_caption") as Label
		if caption != null:
			caption.visible = not _staff_prose_hidden
		var note := row.get("note_label") as Label
		if note != null:
			note.visible = bool(row.get("note_wanted", false)) and not _staff_prose_hidden
		var working := row.get("working_label") as Label
		if working != null:
			working.visible = bool(row.get("working_wanted", false)) and not _staff_prose_hidden
		_staff_row_sentence(row)


## Rebuilds the category rows from the snapshot's `categories`. Content, so
## it never changes length at runtime, but it goes through the same guard the
## contracts board uses so a content change cannot leave stale rows behind.
func _rebuild_staff_rows(categories: Array) -> void:
	for row in _staff_rows:
		var panel: Node = row["panel"]
		if is_instance_valid(panel):
			if panel.get_parent() != null:
				panel.get_parent().remove_child(panel)
			panel.queue_free()
	_staff_rows.clear()
	_staff_row_ids.clear()
	for index in range(categories.size()):
		_staff_rows.append(_build_staff_row(categories[index], index))
		_staff_row_ids.append(String(categories[index].get("id", "")))
	# The explainer shares the scrolled box with the rows and stays after
	# them: a content change rebuilds the rows into the same box and would
	# otherwise strand the small print in the middle of the list.
	if is_instance_valid(_staff_rules_label) and _staff_rules_label.get_parent() == _staff_rows_box:
		_staff_rows_box.move_child(_staff_rules_label, -1)


func _staff_rows_match(categories: Array) -> bool:
	if categories.size() != _staff_row_ids.size():
		return false
	for i in range(categories.size()):
		if String(categories[i].get("id", "")) != String(_staff_row_ids[i]):
			return false
	return true


## The dark row a category sits on: a step lighter than the plate so four
## rows read as four rows, with the plate's own hairline. A SHORT row takes
## the warning colour as a heavier border (the docket's own idiom for "this
## one is in trouble", UI_UX.md §5) — never a red fill, which would read as
## a different kind of row rather than the same row in trouble.
##
## The two styles are built ONCE and handed out, not rebuilt per update: the
## panel re-reads every row on every frame it is open, and the quality pass
## (ticket 3) already had to undo one readout that allocated a stylebox per
## element per frame.
func _staff_row_style(short: bool = false) -> StyleBoxFlat:
	if _staff_row_styles.is_empty():
		for is_short in [false, true]:
			var style := StyleBoxFlat.new()
			style.bg_color = Color(0.11, 0.11, 0.13, 0.92)
			style.border_color = METER_FILL_WARN if is_short else Color(0.30, 0.31, 0.34, 0.95)
			style.set_border_width_all(_ui_i(3) if is_short else _ui_i(1))
			style.set_content_margin_all(_ui_px(6.0))
			_staff_row_styles[is_short] = style
	return _staff_row_styles[short]


## One category, TWO LINES TALL and no more (issue #7): ticket 2's icon, the
## name and its verdict chip, `hired N` and the wage under it, the
## hired/asked-for meter with both numbers printed ON it, what the row is
## doing or what to do about it beside the bar, HIRE / FIRE, and — under the
## bar — the row's ONE sentence (`_staff_row_sentence`).
##
## The row used to stack seven things: the four above plus the category blurb,
## the `asked for by:` WHY line, the working count, and — when the money ran
## out — the hire-refusal reason, each on a full-width line of its own. At
## 147px a row, two and a half of the four categories fitted the panel at
## 1600x900, and the panel's whole job is comparing categories (issue #7). The
## height is spent where the comparison happens; everything else earns its
## place by sharing a line or by taking its turn in the one sentence slot.
##
## Returns `{"id", "panel", "name_label", "hired_label",
## "wage_label", "meter", "meter_caption", "meter_row", "meter_label",
## "short_label", "note_label", "status_label", "blurb_label", "demand_label",
## "working_label", "hire_button", "fire_button"}` for `_update_staff_panel`
## to drive.
func _build_staff_row(category: Dictionary, index: int) -> Dictionary:
	var id := String(category.get("id", "?"))
	var panel := PanelContainer.new()
	panel.name = "Staff_%s" % id
	panel.add_theme_stylebox_override("panel", _staff_row_style())
	_staff_rows_box.add_child(panel)

	var row := HBoxContainer.new()
	row.name = "Row"
	row.add_theme_constant_override("separation", _ui_i(14))
	panel.add_child(row)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.custom_minimum_size = STAFF_ICON_SIZE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	icon.texture = _icon_for_asset(STAFF_ICON_PREFIX + id)
	row.add_child(icon)

	# Name, then hired and wage: what the category is, then what it costs.
	var text_col := VBoxContainer.new()
	text_col.add_theme_constant_override("separation", _ui_i(2))
	text_col.custom_minimum_size = Vector2(_ui_px(150.0), 0.0)
	text_col.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(text_col)

	# The name and, beside it, the row's own verdict chip: "▲ SHORT" or
	# "✔ CREWED" (the staffing ticket's requirement 2). A meter is a shape
	# and this is the word for the same fact, at the place the eye lands
	# first on a row — UI_UX.md §7 again: glyph, word AND colour.
	var name_row := HBoxContainer.new()
	name_row.add_theme_constant_override("separation", _ui_i(8))
	text_col.add_child(name_row)

	var name_label := Label.new()
	name_label.name = "Name"
	name_label.label_settings = _contract_name_settings_dark()
	name_label.text = String(category.get("name", id))
	name_row.add_child(name_label)

	var state_label := Label.new()
	state_label.name = "State"
	state_label.label_settings = _staff_state_settings()
	state_label.visible = false
	name_row.add_child(state_label)

	# `hired 4  ·  wage 2 / head / period` on ONE line: with each on its own
	# the row stood three lines tall and the fourth category scrolled off
	# the plate at 1600x900 (UI_UX.md §5c: layout is what a scale costs).
	var meta_row := HBoxContainer.new()
	meta_row.add_theme_constant_override("separation", _ui_i(6))
	text_col.add_child(meta_row)

	var hired_label := Label.new()
	hired_label.name = "Hired"
	hired_label.label_settings = _staff_meta_settings()
	meta_row.add_child(hired_label)

	var meta_dot := Label.new()
	meta_dot.label_settings = _staff_meta_settings()
	meta_dot.text = "·"
	meta_row.add_child(meta_dot)

	var wage_label := Label.new()
	wage_label.name = "Wage"
	wage_label.label_settings = _staff_meta_settings()
	meta_row.add_child(wage_label)

	# The meter column: the bar with hired over asked-for printed ON it
	# (position AND digits, UI_UX.md §7), its caption beside it the way the
	# clipboard's ON THE DOCK line captions its own bar, what the row is doing
	# or what to do about it in the slot after it, and — under all of that —
	# the row's one sentence. A category with nothing hired and nothing asking
	# shows a sentence in the bar's place instead.
	var meter_col := VBoxContainer.new()
	meter_col.name = "MeterColumn"
	meter_col.add_theme_constant_override("separation", _ui_i(3))
	meter_col.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	meter_col.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(meter_col)

	# The bar, its caption and the slot after it, all on ONE line. The caption
	# was a line of its own above the bar and cost four lines across the four
	# rows to say the same four words; beside the bar it costs none and reads
	# as its label (issue #7).
	var meter_row := HBoxContainer.new()
	meter_row.name = "MeterRow"
	meter_row.add_theme_constant_override("separation", _ui_i(10))
	meter_col.add_child(meter_row)

	var meter_caption := Label.new()
	meter_caption.name = "MeterCaption"
	meter_caption.label_settings = _staff_meta_settings()
	# What the two numbers on the bar ARE: the wire's headcount over the
	# establishment the placed machinery asks for, which is what `meter_text`
	# prints.
	meter_caption.text = "hired / asked for"
	meter_caption.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	meter_row.add_child(meter_caption)

	var meter := _build_meter(meter_row, STAFF_METER_WIDTH, METER_FILL_LEVEL,
		METER_TRACK_COLOR, METER_BORDER_COLOR, STAFF_METER_HEIGHT)
	meter.name = "CrewMeter"
	meter.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN

	var meter_label := Label.new()
	meter_label.name = "MeterLabel"
	meter_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	meter_label.label_settings = _staff_meter_settings()
	meter_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	meter_label.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	meter_label.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	meter.add_child(meter_label)

	# The slot after the bar carries ONE of two facts, never both: the
	# shortfall in words while the row is short, and — when there is nothing
	# to do about it — the per-tick working count that used to have a line of
	# its own. "What to do" outranks "what it is doing".
	var short_label := Label.new()
	short_label.name = "Short"
	short_label.label_settings = _staff_warn_settings()
	short_label.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	meter_row.add_child(short_label)

	# "3 of 4 working right now" — the per-tick activity figure, kept as a
	# quiet sub-line. It is deliberately NOT the row's headline: it moves
	# with production flow, and reading a hiring decision off it was the bug
	# the establishment fixed (`_staff_working_text`).
	var working_label := Label.new()
	working_label.name = "Working"
	working_label.label_settings = _staff_meta_settings()
	working_label.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	working_label.visible = false
	meter_row.add_child(working_label)

	var note_label := Label.new()
	note_label.name = "Note"
	note_label.label_settings = _staff_meta_settings()
	note_label.visible = false
	meter_col.add_child(note_label)

	# HIRE beside FIRE, the build menu's own button skin. Each moves ONE
	# head through the real command; the panel re-reads the wire at once.
	var buttons := HBoxContainer.new()
	buttons.add_theme_constant_override("separation", _ui_i(6))
	buttons.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	row.add_child(buttons)

	# Wide enough for "HIRE +1 · 2/period" at the button's own type size: a
	# button that says what the click does and what it costs is the staffing
	# ticket's requirement 3, and a clipped one would say neither.
	var hire_button := Button.new()
	hire_button.name = "Hire_%s" % id
	hire_button.text = "HIRE +1"
	hire_button.focus_mode = Control.FOCUS_NONE
	hire_button.custom_minimum_size = _ui_v(Vector2(132, 32))
	hire_button.add_theme_font_size_override("font_size", _ui_font(-2))
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		hire_button.add_theme_stylebox_override(state, _shop_slot_style(state))
	hire_button.pressed.connect(_staff_hire.bind(index))
	buttons.add_child(hire_button)

	var fire_button := Button.new()
	fire_button.name = "Fire_%s" % id
	fire_button.text = "FIRE −1"
	fire_button.tooltip_text = STAFF_FIRE_NOTICE
	fire_button.focus_mode = Control.FOCUS_NONE
	fire_button.custom_minimum_size = _ui_v(Vector2(84, 32))
	fire_button.add_theme_font_size_override("font_size", _ui_font(-2))
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		fire_button.add_theme_stylebox_override(state, _shop_slot_style(state))
	fire_button.pressed.connect(_staff_fire.bind(index))
	buttons.add_child(fire_button)

	# THE ROW'S ONE SENTENCE, under the bar: five labels in one slot, of which
	# `_staff_row_sentence` leaves exactly one visible. Each was a permanent
	# line of its own and four of the five say nothing most of the time, so
	# between them they cost every row four lines to show one fact (issue #7).
	# They are separate labels rather than one, because two of them are the
	# row's warning ink and three are its small print, and a colour is never
	# the whole message (UI_UX.md §7) — the words differ too.

	# The AFTER-payday indicator (ticket 4): unpaid/left, in the same warning
	# colour the shortfall label uses. It outranks the rest: a head that is
	# already idle is worse news than one that was never hired.
	var status_label := Label.new()
	status_label.name = "Status"
	status_label.label_settings = _staff_warn_settings()
	status_label.visible = false
	meter_col.add_child(status_label)

	# WHY a disabled HIRE is disabled (requirement 3): grey alone says only
	# "not now", never "and here is what would change it".
	var blocked_label := Label.new()
	blocked_label.name = "HireBlocked"
	blocked_label.label_settings = _staff_warn_settings()
	blocked_label.visible = false
	meter_col.add_child(blocked_label)

	# What hiring this shortfall would put back to work, in the machines'
	# own names — the staffing ticket's requirement 5, built out of the
	# demand sources rather than out of any new sim fact. It names the same
	# machines the WHY line does, which is why the two never both show.
	var unblock_label := Label.new()
	unblock_label.name = "Unblock"
	unblock_label.label_settings = _staff_warn_settings()
	unblock_label.visible = false
	meter_col.add_child(unblock_label)

	# The WHY line: what asks for this category, from `_crews`. Dynamic
	# (placing or removing a machine changes it), so `_update_staff_panel`
	# fills it on every poll.
	var demand_label := Label.new()
	demand_label.name = "Demand"
	demand_label.label_settings = _staff_meta_settings()
	demand_label.visible = false
	meter_col.add_child(demand_label)

	# What the category does — static content from `STAFF_CATEGORY_BLURBS`,
	# set once here rather than on every `_update_staff_panel` poll, since it
	# never changes while the row stands. It is the sentence a row shows when
	# nothing asks for the category, which is the case UI_UX.md §5 put it
	# there for: a category nobody has needed yet is still explained. On a row
	# that has something more urgent to say it is the row's hover instead.
	var blurb_label := Label.new()
	blurb_label.name = "Blurb"
	blurb_label.label_settings = _staff_meta_settings()
	blurb_label.text = String(STAFF_CATEGORY_BLURBS.get(id, ""))
	blurb_label.visible = false
	meter_col.add_child(blurb_label)

	return {
		"id": id,
		"panel": panel,
		"name_label": name_label,
		"state_label": state_label,
		"unblock_label": unblock_label,
		"blocked_label": blocked_label,
		"hired_label": hired_label,
		"wage_label": wage_label,
		"meter": meter,
		"meter_row": meter_row,
		"meter_caption": meter_caption,
		"meter_label": meter_label,
		"short_label": short_label,
		"note_label": note_label,
		"status_label": status_label,
		"blurb_label": blurb_label,
		"demand_label": demand_label,
		"working_label": working_label,
		"hire_button": hire_button,
		"fire_button": fire_button,
	}


