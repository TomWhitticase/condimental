## Tile (x, y) in simulation space -> the centre of that tile in world space.
## The sim's chain runs along +X at y = 0; the importer centres each model on
## its own footprint, so a tile centre is exactly where an asset node goes.
func _tile_origin(tx: int, ty: int, height: float) -> Vector3:
	return Vector3(float(tx) * TILE, height, float(ty) * TILE)


## Where a node goes for a building that occupies a whole FOOTPRINT rather
## than a single tile (the "Machines improvement" milestone's ticket 1).
##
## `origin` is the footprint's minimum-X/minimum-Y corner — the tile the
## belt feeds into — and the building covers `size.x` x `size.y` tiles
## growing east/north from it (`sim::machines`'s module doc states that
## convention once; nothing here re-derives it). The voxel encoder puts a
## model's origin at its own footprint CENTRE at ground level, so the node
## belongs at the centre of that rectangle, which for a 1x1 building is
## exactly `_tile_origin` — i.e. this generalizes the old placement rather
## than replacing it, and every existing 1x1 kind stays on the tile it was
## on before.
func _footprint_centre(origin: Vector2i, size: Vector2i, height: float) -> Vector3:
	return Vector3(
		(float(origin.x) + float(size.x - 1) * 0.5) * TILE,
		height,
		(float(origin.y) + float(size.y - 1) * 0.5) * TILE
	)


## `{"width_tiles": w, "height_tiles": h}` (as every snapshot spells a
## footprint) -> Vector2i, defaulting to 1x1 so a snapshot from an older
## SimBridge without the field still renders.
func _footprint_size(footprint) -> Vector2i:
	if not (footprint is Dictionary):
		return Vector2i.ONE
	return Vector2i(
		maxi(1, int(footprint.get("width_tiles", 1))),
		maxi(1, int(footprint.get("height_tiles", 1)))
	)


## A tile as the string key `_occupancy`/`_by_origin`/every per-placement
## dictionary in this file are keyed by. One helper rather than the "%d,%d"
## literal repeated a dozen times, because a mismatched key is silent.
func _tile_key(tile: Vector2i) -> String:
	return "%d,%d" % [tile.x, tile.y]


## --- Facing (the "Real Placement" epic's ticket 2) -------------------------
##
## `sim::types::Direction` is four-way and every belt, pipe, machine and
## building on the wire now carries one. This array is in the simulation's
## own CLOCKWISE order (`Direction::rotate_cw`: east -> south -> west ->
## north), so rotating the ghost is one step along it and the yaw below is
## simply `index * 90 degrees` — which is why the two are one table rather
## than two that have to agree.
const DIRECTIONS := ["east", "south", "west", "north"]

## Tile-space unit offset per direction, matching `Direction::offset`:
## **east is +X and north is +Y** (see that type's own doc — the axis
## convention is the simulation's, not this file's, and is never re-derived
## here).
const DIRECTION_OFFSETS := {
	"east": Vector2i(1, 0),
	"south": Vector2i(0, -1),
	"west": Vector2i(-1, 0),
	"north": Vector2i(0, 1),
}


func _direction_index(direction: String) -> int:
	var i: int = DIRECTIONS.find(direction)
	return i if i >= 0 else 0


func _direction_offset(direction: String) -> Vector2i:
	return DIRECTION_OFFSETS.get(direction, Vector2i(1, 0))


## The Y-axis rotation that turns a model authored facing EAST into one
## facing `direction`.
##
## Every voxel asset in this project is modelled with its product path
## running along +X, because until this epic that was the only direction
## anything could face. Tile (x, y) maps to world (x, ., y) — sim +Y is world
## +Z — and a Godot rotation of `t` about +Y sends local +X to world
## `(cos t, 0, -sin t)`. So east is 0, south (sim -Y, world -Z) is +90,
## west is 180 and north is -90 — i.e. exactly `index * 90` along DIRECTIONS,
## which is the whole reason that array is in clockwise order.
##
## **This is all the base rotation needs.** The encoder puts a model's origin
## at its own footprint centre at ground level (UI_UX.md §2b), so a rotated
## placement is the same mesh spun about that origin and re-centred on the
## rotated rectangle — no new geometry. What rotation does NOT fix is the
## junction art, which is authored for a camera that can only see two faces;
## see `_belt_asset_for`.
func _direction_yaw(direction: String) -> float:
	return deg_to_rad(float(_direction_index(direction)) * 90.0)


## The rectangle a kind actually claims once turned: a quarter turn SWAPS the
## extents, anchored at the same origin corner (`sim::machines`'s module doc
## owns that rule; this is its one presentation-side restatement).
func _rotated_footprint(size: Vector2i, direction: String) -> Vector2i:
	if direction == "north" or direction == "south":
		return Vector2i(size.y, size.x)
	return size


## Every tile a placement of `size` at `origin` facing `direction` covers.
func _placement_tiles(origin: Vector2i, size: Vector2i, direction: String) -> Array:
	var rotated := _rotated_footprint(size, direction)
	var tiles: Array = []
	for dy in range(rotated.y):
		for dx in range(rotated.x):
			tiles.append(Vector2i(origin.x + dx, origin.y + dy))
	return tiles


## Re-reads `world_layout_json` into the three indexes the rest of this file
## asks questions of: the placements themselves, a lookup by origin tile, and
## an occupancy map from *every* covered tile back to the placement's origin.
##
## The occupancy map is what makes "point at a machine, not at its corner"
## work here the way it already does in the simulation (`World::query_tile`,
## `Remove`, `Rotate` all resolve from any tile of a footprint), and it is
## also the whole of the ghost's validity check — see `_ghost_blocked`.
##
## `occupies` comes straight off the wire rather than being re-derived from
## `footprint` + `direction`: the simulation reports both precisely so a
## consumer can take whichever it needs (see `sim::PlacementSnapshot`).
func _read_world_layout() -> void:
	_placements.clear()
	_by_origin.clear()
	_occupancy.clear()
	var parsed = JSON.parse_string(sim.world_layout_json())
	if not (parsed is Array):
		return
	for placement in parsed:
		if not (placement is Dictionary):
			continue
		_placements.append(placement)
		var origin := _placement_origin(placement)
		var key := _tile_key(origin)
		_by_origin[key] = placement
		# A kind's declared footprint is content (data/machines.ron) and the
		# only place it reaches this scene is on a placement — so every
		# placement teaches it, for the ghost of a kind nothing has placed
		# yet to fall back on. See `_kind_footprint`.
		_kind_footprints[String(placement.get("kind", ""))] = _footprint_size(placement.get("footprint"))
		for pair in placement.get("occupies", []):
			if pair is Array and pair.size() >= 2:
				_occupancy[_tile_key(Vector2i(int(pair[0]), int(pair[1])))] = key


func _placement_origin(placement: Dictionary) -> Vector2i:
	var pair: Array = placement.get("tile", [0, 0])
	return Vector2i(int(pair[0]), int(pair[1]))


func _placement_direction(placement: Dictionary) -> String:
	return String(placement.get("direction", "east"))


## Whichever placement covers `tile`, or `{}`. Any tile of a multi-tile
## footprint answers, via `_occupancy`.
func _placement_at_tile(tile: Vector2i) -> Dictionary:
	var origin_key: String = _occupancy.get(_tile_key(tile), "")
	if origin_key == "":
		return {}
	return _by_origin.get(origin_key, {})


## The declared (unrotated) footprint of a buildable kind, for a GHOST of
## something not yet placed.
##
## Nothing on the wire reports a kind's footprint before one exists — every
## snapshot describes a *placement* — so this learns it two ways, in order.
## (1) From any placement of that kind in the world, which is the
## simulation's own number and therefore authoritative. (2) Failing that,
## from the kind's own voxel model: UI_UX.md's asset scale fixes one tile at
## 32 voxels and the "Machines improvement" epic's ticket 4 made a kind's
## model size and its `machines.ron` footprint *deliberately coupled* — the
## 2x2 cooking vat is modelled at 64x64 — so the mesh's own extent in tiles
## IS the footprint, rounded. It is derived rather than typed into a table
## here on purpose: a hand-written kind -> size table is exactly the kind of
## presentation-side lookup keyed by a content id that UI_UX.md §2b point 12
## records going silently stale.
func _kind_footprint(kind: String) -> Vector2i:
	if _kind_footprints.has(kind):
		return _kind_footprints[kind]
	var size := Vector2i.ONE
	var mesh := _mesh_for(_shop_asset_for(kind))
	if mesh != null:
		var aabb := mesh.get_aabb()
		size = Vector2i(
			maxi(1, roundi(aabb.size.x / TILE)),
			maxi(1, roundi(aabb.size.z / TILE))
		)
	_kind_footprints[kind] = size
	return size


## The tile bounding box of everything currently placed — `position` is the
## minimum tile and `size` the inclusive span, so the covered range is
## `position .. position + size`. An EMPTY world (the new starting state)
## reports a degenerate box at the origin, which is what the floor and the
## camera then pad out.
func _world_tile_bounds() -> Rect2i:
	var seen := false
	var min_tile := Vector2i.ZERO
	var max_tile := Vector2i.ZERO
	for key in _occupancy.keys():
		var parts: PackedStringArray = String(key).split(",")
		var tile := Vector2i(int(parts[0]), int(parts[1]))
		if not seen:
			min_tile = tile
			max_tile = tile
			seen = true
			continue
		min_tile = Vector2i(mini(min_tile.x, tile.x), mini(min_tile.y, tile.y))
		max_tile = Vector2i(maxi(max_tile.x, tile.x), maxi(max_tile.y, tile.y))
	return Rect2i(min_tile, max_tile - min_tile)


## The poured-concrete factory floor. Drawn as one `MultiMeshInstance3D`
## rather than one node per tile: the floor is the only asset whose instance
## count scales with the size of the world, so it is the one worth batching.
## The tile's darker perimeter is what keeps the grid legible (UI_UX.md §1).
##
## Its extent follows the placed world rather than a fixed chain length, and
## it is rebuilt only when those bounds actually change — which for an empty
## world (nothing placed, the state the game now starts in) is a square of
## bare floor centred on the origin, i.e. somewhere to build.
func _build_floor() -> void:
	var bounds := _world_tile_bounds()
	if _floor_node != null and bounds == _floor_bounds:
		return
	_floor_bounds = bounds

	var mesh := _mesh_for("floor_tile")
	if mesh == null:
		push_warning("floor_tile mesh missing — skipping floor")
		return

	var x_from := bounds.position.x - FLOOR_GROUND_MARGIN_X
	var x_to := bounds.position.x + bounds.size.x + FLOOR_GROUND_MARGIN_X
	var z_from := bounds.position.y - FLOOR_GROUND_MARGIN_Z
	var z_to := bounds.position.y + bounds.size.y + FLOOR_GROUND_MARGIN_Z

	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.mesh = mesh
	multimesh.instance_count = (x_to - x_from + 1) * (z_to - z_from + 1)

	var i := 0
	for tz in range(z_from, z_to + 1):
		for tx in range(x_from, x_to + 1):
			multimesh.set_instance_transform(i, Transform3D(Basis(), _tile_origin(tx, tz, 0.0)))
			i += 1

	if _floor_node != null:
		remove_child(_floor_node)
		_floor_node.free()
	_floor_node = MultiMeshInstance3D.new()
	_floor_node.name = "Floor"
	_floor_node.multimesh = multimesh
	# The floor takes shadows from the machinery but casts none of its own.
	_floor_node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(_floor_node)
	var floor_material = _class_materials.get("matte", null)
	if floor_material != null:
		_floor_node.material_override = floor_material


## Which of the three belt models this tile draws with.
##
## The rule is the one the "Visual overhaul round 2" epic's ticket 3 built,
## now fed a REAL per-tile direction instead of one derived from a fixed
## chain: a belt whose next tile along its own facing is covered by a
## machine or a building hands over into it and draws `belt_inlet`; one whose
## previous tile is a machine or building catches a discharge and draws
## `belt_outlet`; everything else is the plain `belt`.
##
## **The variants stay east-only, and three quarters of placements
## deliberately fall through to the plain model.** That is the known,
## accepted gap this ticket does not close, and it is not laziness: UI_UX.md
## §2b point 11 derives the junction art from the fact that this camera can
## only ever see the +X and +Z-world faces, so an outlet is a doorway carved
## into the camera-facing wall and an inlet is a hood cut open on that same
## side. Spinning those models 180 degrees puts the carved side where nobody
## can see it and a blank wall where the product path is — visibly worse than
## the plain tile, which is symmetric and reads correctly at any angle. A
## full four-directional junction pass is an art ticket, not this one; until
## then the fallback is what keeps every non-east placement honest.
func _belt_asset_for(tile: Vector2i, direction: String) -> String:
	if direction != "east":
		return BELT_ASSET
	var offset := _direction_offset(direction)
	if _is_building_tile(tile + offset):
		return BELT_INLET_ASSET
	if _is_building_tile(tile - offset):
		return BELT_OUTLET_ASSET
	return BELT_ASSET


## Whether `tile` is covered by something a belt hands product to or takes it
## from — a machine, a hopper, a fluid tank or a dock, i.e. anything that is
## not itself a length of conveyor or pipe.
##
## A SPLITTER counts as conveyor here, not as a building, and that is the
## point of it: it is a belt tile with a choice at the end (`sim_core/src/sim/
## splitter.rs`), so a belt running into one hands over to another length of
## conveyor and must NOT draw the hand-over-to-a-machine variant. Drawing
## `belt_inlet` there would put a machine's dead-plate and guide kerbs in
## front of what is just more belt.
func _is_building_tile(tile: Vector2i) -> bool:
	var placement := _placement_at_tile(tile)
	if placement.is_empty():
		return false
	var kind := String(placement.get("kind", ""))
	return kind != BELT_KIND and kind != PIPE_KIND and kind != SPLITTER_KIND


## Which model draws a pipe tile — the plain bore, the supply fitting where a
## tank discharges, or the branch fitting where a machine taps the run.
## `_pipe_roles` is filled from the fluid snapshots in `_rebuild_world`,
## since which tile is which is a property of the network, not of the tile.
func _pipe_asset_for(tile: Vector2i) -> String:
	return String(_pipe_roles.get(_tile_key(tile), PIPE_ASSET))


## Which voxel asset draws one placement. Belts and pipes have context-
## dependent variants (above); everything else goes through the same
## `_shop_asset_for` the build menu's icons use, so a kind added to
## `data/shop.ron` draws in the world and in the menu from one mapping.
func _asset_for_placement(placement: Dictionary) -> String:
	var kind := String(placement.get("kind", ""))
	var origin := _placement_origin(placement)
	if kind == BELT_KIND:
		return _belt_asset_for(origin, _placement_direction(placement))
	if kind == PIPE_KIND:
		return _pipe_asset_for(origin)
	return _shop_asset_for(kind)


## The buildable-kind ids that are infrastructure rather than buildings —
## spelled here for the same reason `sim::world` spells them in Rust: they
## are the two kinds that are priced and placed but are not in
## `data/machines.ron` at all.
const BELT_KIND := "belt"
const PIPE_KIND := "pipe"

## The three buildable kinds that are buffers rather than processes — no
## recipe, but a footprint and a live level. Spelled here so the `match` in
## `_build_placement` reads as kind ids rather than string literals; they are
## `data/machines.ron` ids, and their Rust twins are `sim::hopper::HOPPER_KIND`
## and friends.
const HOPPER_KIND := "hopper"
const FLUID_TANK_KIND := "fluid_tank"
const DOCK_KIND := "dock"
## Epic B's splitter. A `data/machines.ron` kind like the three above, but
## belt-LIKE rather than a buffer: it carries product at belt speed and hands
## it on, so `_is_building_tile` deliberately groups it with the conveyor.
const SPLITTER_KIND := "splitter"


## Rebuilds the entire rendered world from `world_layout_json` plus the
## buffer/fluid snapshots — the one function every place, remove and rotate
## goes through, and the one `_ready` calls to draw the (empty) starting
## state. See `_placements`'s doc for why this is a full rebuild.
func _rebuild_world() -> void:
	_read_world_layout()

	# Pipe roles first: which tile draws a supply fitting and which a branch
	# is a property of the NETWORK (who taps it, which tank feeds it), so it
	# has to be known before the pipe tiles themselves are built.
	_last_fluid = _read_fluid_snapshots()
	_pipe_roles.clear()
	_pipe_tiles.clear()
	for n in range(_last_fluid.size()):
		var network: Dictionary = _last_fluid[n]
		var segments: Array = network.get("segments", [])
		for s in range(segments.size()):
			var seg: Dictionary = segments[s]
			var tile := _pair_to_tile(seg.get("tile", [0, 0]))
			_pipe_tiles[_tile_key(tile)] = Vector2i(n, s)
			_pipe_roles[_tile_key(tile)] = PIPE_SOURCE_ASSET if bool(seg.get("is_source", false)) else PIPE_ASSET
		for tap in network.get("taps", []):
			var index := int(tap.get("segment_index", -1))
			if index < 0 or index >= segments.size():
				continue
			var tap_tile := _pair_to_tile(segments[index].get("tile", [0, 0]))
			# A tapped tile that a tank also feeds keeps the supply fitting:
			# the tank connection is the more distinctive silhouette, and the
			# same tile being both is only reachable on a one-tile run.
			if _pipe_roles.get(_tile_key(tap_tile), PIPE_ASSET) != PIPE_ASSET:
				continue
			# **And only when the branch would actually point at the machine.**
			# `pipe_inlet`'s T-off reaches out of this tile's SOUTH edge (see
			# its own doc for the vox-Y derivation) and caps the run's +X end
			# with a blind flange, so it is authored for exactly one
			# arrangement: the run lying on the row north of the machine it
			# feeds, which is how a tank supplies the mixer.
			#
			# The chain rework created the other arrangement — machine-to-
			# machine runs lying WEST-to-EAST between two machines — and there
			# the branch would stick out at bare floor while the blind flange
			# capped the very end the machine draws through. So those tiles
			# fall back to the plain `pipe`, which is not a compromise: a
			# plain tile's bore is already open at both X faces at exactly
			# `PIPE_AXIS_Z`, and the machine's own `machine_fluid_port`
			# nozzle meets it there. This is the same known, tested fallback
			# the belt's east-only junction variants take (UI_UX.md §2b point
			# 18), and a four-directional pipe-fitting pass is the same art
			# ticket.
			if _is_building_tile(tap_tile + Vector2i(0, -1)):
				_pipe_roles[_tile_key(tap_tile)] = PIPE_INLET_ASSET

	# Cleared and rebuilt together, never appended to: `_ready()` genuinely
	# runs twice under the headless `--script` SceneTree harness (see
	# test_hover.gd's header), and a place/remove/rotate re-enters this.
	var existing := get_node_or_null("World")
	if existing != null:
		remove_child(existing)
		existing.free()
	_machine_lamps.clear()
	_machine_gauges.clear()
	_machine_running.clear()
	_splitter_nodes.clear()
	_splitter_states.clear()
	_hopper_nodes.clear()
	_fluid_tank_nodes.clear()
	_dock_nodes.clear()
	_pipe_fluid_nodes.clear()
	for key in _item_nodes.keys():
		_item_nodes[key]["node"].queue_free()
	_item_nodes.clear()

	_world_root = Node3D.new()
	_world_root.name = "World"
	add_child(_world_root)

	for placement in _placements:
		_build_placement(placement)

	_build_floor()
	_seed_machine_states()
	_seed_splitter_states()
	_refresh_buffers()


## Builds the node (or nodes) for one placement: its body at the centre of
## its ROTATED footprint, turned to face the way the simulation says it
## faces, plus whatever live parts that kind carries — a status lamp, a fill
## body, a progress gauge, a deck for waiting goods.
func _build_placement(placement: Dictionary) -> void:
	var kind := String(placement.get("kind", ""))
	var origin := _placement_origin(placement)
	var direction := _placement_direction(placement)
	var key := _tile_key(origin)
	var size := _rotated_footprint(_footprint_size(placement.get("footprint")), direction)
	var yaw := _direction_yaw(direction)

	var body := _asset_node(_asset_for_placement(placement))
	body.name = "%s_%s" % [kind, key]
	body.position = _footprint_centre(origin, size, FLOOR_Y)
	body.rotation.y = yaw
	_world_root.add_child(body)

	var lamp := body.get_node_or_null("emissive")

	match kind:
		BELT_KIND, PIPE_KIND:
			pass
		HOPPER_KIND:
			_hopper_nodes[key] = {
				"fill": _build_level_body(HOPPER_FILL_ASSET, origin, size, HOPPER_FILL_FLOOR_Y, yaw, null),
				"lamp": lamp,
				"stocked": true, # forces the first refresh to apply
			}
		FLUID_TANK_KIND:
			_fluid_tank_nodes[key] = {
				"fill": _build_level_body(FLUID_TANK_FILL_ASSET, origin, size, FLUID_TANK_FILL_FLOOR_Y, yaw, null),
				"lamp": lamp,
				"stocked": true,
			}
		DOCK_KIND:
			_dock_nodes[key] = {
				"slots": _build_dock_slots(origin, size, yaw),
				"lamp": lamp,
				"stocked": true,
			}
		SPLITTER_KIND:
			# Its own branch rather than falling through to the machine arm
			# below: a splitter runs no recipe, so it has no idle/running
			# state for a status lamp to swap and nothing for
			# `_seed_machine_states` to find. What it has instead is one lit
			# arrow, hidden until a snapshot says which way it points.
			var arrow := _asset_node(SPLITTER_ARROW_ASSET)
			arrow.name = "splitter_arrow_%s" % key
			arrow.position = _footprint_centre(origin, size, SPLITTER_ARROW_FLOOR_Y)
			arrow.rotation.y = yaw
			arrow.visible = false
			_world_root.add_child(arrow)
			_splitter_nodes[key] = {"arrow": arrow, "yaw": yaw}
		_:
			# A machine: a recipe-running kind. Its status lamp and (for the
			# kinds that declare one) its progress gauge.
			_machine_lamps[key] = lamp
			_machine_running[key] = true
			_set_machine_running(key, false)
			if MACHINE_PROGRESS_GAUGES.has(kind):
				# A SIBLING of the body rather than a child, so
				# `body.get_node_or_null("emissive")` above keeps finding the
				# machine's own lamps and not the gauge's emissive bar, whose
				# material `_set_machine_running` would otherwise swap.
				var gauge := _asset_node(String(MACHINE_PROGRESS_GAUGES[kind]))
				gauge.name = "gauge_%s" % key
				gauge.position = _footprint_centre(origin, size, MACHINE_GAUGE_FLOOR_Y)
				gauge.rotation.y = yaw
				gauge.visible = false
				_world_root.add_child(gauge)
				_machine_gauges[key] = gauge


## One of the one-voxel-tall bodies this scene scales every frame to show a
## live level — the pipe's liquid, the hopper's product, the tank's column
## (UI_UX.md §2b point 5). Shared because all three are the same mechanism,
## differing only in asset, height and tint.
func _build_level_body(
	asset: String, origin: Vector2i, size: Vector2i, height: float, yaw: float,
	material: StandardMaterial3D
) -> Node3D:
	var node := _asset_node(asset)
	node.name = "%s_%s" % [asset, _tile_key(origin)]
	node.position = _footprint_centre(origin, size, height)
	node.rotation.y = yaw
	if material != null:
		for child in node.get_children():
			if child is MeshInstance3D:
				child.set_surface_override_material(0, material)
	_world_root.add_child(node)
	return node


## The pooled nodes the goods waiting on one dock's deck stand in — created
## hidden, revealed by `_update_dock_stock`. Pooled rather than spawned per
## frame for `_item_node_for`'s reason: this is the same "a case standing
## somewhere" node, just standing on a deck instead of on a belt.
func _build_dock_slots(origin: Vector2i, size: Vector2i, yaw: float) -> Array:
	var deck := _footprint_centre(origin, size, DOCK_DECK_Y)
	var slots: Array = []
	for i in range(DOCK_STOCK_SLOTS):
		var offset: Vector2 = DOCK_STOCK_OFFSETS[i]
		var slot := Node3D.new()
		slot.name = "dock_stock_%s_%d" % [_tile_key(origin), i]
		# The vox importer maps low local Y to high world Z, so a slot's
		# model-space Y offset runs the other way in the world (the same
		# mapping `_footprint_centre`'s doc relies on). Rotated with the
		# building, so a turned dock stages its goods on its own near edge.
		var local := Vector3(offset.x * VOXEL_UNIT, 0.0, -offset.y * VOXEL_UNIT)
		slot.position = deck + local.rotated(Vector3.UP, yaw)
		slot.visible = false
		_world_root.add_child(slot)
		slots.append(slot)
	return slots


func _pair_to_tile(pair) -> Vector2i:
	if pair is Array and pair.size() >= 2:
		return Vector2i(int(pair[0]), int(pair[1]))
	return Vector2i.ZERO


## Fills `_machine_states` (what the hover tooltip and the progress gauges
## read) for every placed machine, before any item has moved.
##
## `dirty_chunk_ids` only reports chunks something *changed* in, so an idle
## factory produces no snapshots at all and hovering a machine would show
## nothing until the player pressed a key. This asks the simulation directly,
## via `query_tile_json`, rather than inventing a default state Godot has no
## business knowing.
func _seed_machine_states() -> void:
	_machine_states.clear()
	for placement in _placements:
		if placement.get("recipe") == null:
			continue
		var origin := _placement_origin(placement)
		var parsed = JSON.parse_string(sim.query_tile_json(origin.x, origin.y))
		if parsed == null or parsed.get("kind") != "machine":
			continue
		_machine_states[_tile_key(origin)] = {
			"recipe": parsed["recipe"],
			"process": parsed.get("process"),
			# query_tile deliberately doesn't report buffer contents; the
			# first chunk snapshot fills these in.
			"input": [],
			"output": [],
		}


## Fills `_splitter_states` (and points every arrow) for every placed
## splitter, before any item has moved — `_seed_machine_states`'s twin, and
## it exists for the same reason: `dirty_chunk_ids` only reports chunks
## something CHANGED in, so a splitter that has not yet passed an item
## produces no snapshot and its arrow would stay dark until it did. Which
## way a freshly placed splitter will deal its first item is knowable (it is
## `Side::default()`, straight), so it is asked for rather than guessed at.
func _seed_splitter_states() -> void:
	for placement in _placements:
		if String(placement.get("kind", "")) != SPLITTER_KIND:
			continue
		var origin := _placement_origin(placement)
		var parsed = JSON.parse_string(sim.query_tile_json(origin.x, origin.y))
		if parsed == null or parsed.get("kind") != SPLITTER_KIND:
			continue
		_apply_splitter_state(_tile_key(origin), parsed)


## Points one splitter's arrow at the output its next item will actually
## reach, and remembers the snapshot for the hover tooltip.
##
## **Why this is not simply `next_output`.** The raw field is which side gets
## FIRST REFUSAL, and `sim_core/src/sim/splitter.rs`'s fallback rule is that
## a side which cannot take the item passes it to the other one in the same
## tick — so a splitter whose branch was never built reports `"branch"`
## forever while every item goes straight through it. An arrow drawn from
## that field alone would point at bare floor while product sailed past it in
## the other direction: a readout lying about its own mechanism, which is the
## thing this codebase already refused to build for the fluid tank's head and
## the dock's fill level. So the ONE case the wire can settle is settled
## here — a due side with no output tile (`outputs[i] == null`) hands to the
## other — and it is settled from the `outputs` pair the simulation reports
## precisely so a renderer need not re-derive where they point.
##
## What this deliberately cannot show is a side that is built but momentarily
## FULL, which also falls back. That is transient and invisible on the wire;
## an unbuilt branch is durable and is the mistake a player wants told about.
##
## With neither output connected nothing can leave at all, and the arrow is
## hidden outright — a shape difference (no lit groove anywhere) for a
## splitter that is a dead end.
func _apply_splitter_state(key: String, snapshot: Dictionary) -> void:
	_splitter_states[key] = snapshot
	var nodes: Dictionary = _splitter_nodes.get(key, {})
	if nodes.is_empty():
		return
	var arrow: Node3D = nodes["arrow"]
	var side := _splitter_effective_side(snapshot)
	arrow.visible = side >= 0
	if side >= 0:
		arrow.rotation.y = float(nodes["yaw"]) + (PI * 0.5 if side == SPLITTER_BRANCH else 0.0)


## Which output the next item off `snapshot` will reach — SPLITTER_STRAIGHT,
## SPLITTER_BRANCH, or -1 when neither side is connected to anything. Pure,
## so a test can drive it with a hand-built snapshot.
func _splitter_effective_side(snapshot: Dictionary) -> int:
	var outputs: Array = snapshot.get("outputs", [])
	var due := SPLITTER_BRANCH if String(snapshot.get("next_output", "straight")) == "branch" else SPLITTER_STRAIGHT
	var other := SPLITTER_STRAIGHT if due == SPLITTER_BRANCH else SPLITTER_BRANCH
	if outputs.size() < 2:
		return -1
	if outputs[due] != null:
		return due
	if outputs[other] != null:
		return other
	return -1


# --------------------------------------------------------------------------
# Live levels: hoppers, tanks, docks and the liquid in the pipes
# --------------------------------------------------------------------------

## Re-reads every buffer building's own snapshot array and updates the nodes
## built for it. Called every frame, and once at build time so tick 0's
## levels are drawn rather than an empty factory.
##
## Polling rather than waiting on `dirty_chunk_ids` is not a shortcut: a
## tank is drained by the same equalization pass the pipes are and that pass
## deliberately dirties no chunk, so a chunk-driven renderer would sit
## waiting on an event that never comes (see `SimBridge`'s own docs). The
## hopper and dock could be chunk-driven and are polled with them for one
## code path rather than two.
func _refresh_buffers() -> void:
	_hopper_states.clear()
	for snapshot in _read_snapshot_array(sim.hopper_snapshots_json()):
		var key := _tile_key(_pair_to_tile(snapshot.get("tile")))
		_hopper_states[key] = snapshot
		var nodes: Dictionary = _hopper_nodes.get(key, {})
		if nodes.is_empty():
			continue
		var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
		_apply_level(nodes["fill"], fill, HOPPER_MIN_VISIBLE_FILL, HOPPER_FILL_HEIGHT_VOXELS)
		# Retinted only when the item id actually changes: this runs every
		# frame, and a fresh StandardMaterial3D per frame per building is a
		# real cost for a colour that almost never moves.
		var item := String(snapshot.get("item", ""))
		if String(nodes.get("tint", "")) != item:
			nodes["tint"] = item
			_tint_level_body(nodes["fill"], _hopper_fill_material(item))
		_set_lamp_stocked(nodes, fill > HOPPER_MIN_VISIBLE_FILL)

	_fluid_tank_states.clear()
	for snapshot in _read_snapshot_array(sim.fluid_tank_snapshots_json()):
		var key := _tile_key(_pair_to_tile(snapshot.get("tile")))
		_fluid_tank_states[key] = snapshot
		var nodes: Dictionary = _fluid_tank_nodes.get(key, {})
		if nodes.is_empty():
			continue
		var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
		_apply_level(nodes["fill"], fill, FLUID_TANK_MIN_VISIBLE_FILL, FLUID_TANK_FILL_HEIGHT_VOXELS)
		var fluid := _fluid_id_of(snapshot)
		if String(nodes.get("tint", "")) != fluid:
			nodes["tint"] = fluid
			_tint_level_body(nodes["fill"], _fluid_material_for(fluid))
		_set_lamp_stocked(nodes, fill > FLUID_TANK_MIN_VISIBLE_FILL)

	_dock_states.clear()
	for snapshot in _read_snapshot_array(sim.dock_snapshots_json()):
		_dock_states[_tile_key(_pair_to_tile(snapshot.get("tile")))] = snapshot

	var econ = JSON.parse_string(sim.economy_snapshot_json())
	_last_dock_stock = econ.get("delivery_stock", []) if econ is Dictionary else []
	_update_dock_stock(_last_dock_stock)


## Parses one of the SimBridge calls that returns an ARRAY of snapshots —
## hoppers, tanks, docks, fluid networks. All four became arrays in ticket 1
## (a world may hold none or several of each), so they get one reader.
func _read_snapshot_array(json: String) -> Array:
	if json.is_empty():
		return []
	var parsed = JSON.parse_string(json)
	return parsed if parsed is Array else []


func _read_fluid_snapshots() -> Array:
	return _read_snapshot_array(sim.fluid_snapshots_json())


## Scales one of the one-voxel-tall level bodies to a live fraction, hiding
## it outright below a minimum rather than drawing a sub-voxel sliver that
## would z-fight whatever it stands on.
func _apply_level(node: Node3D, fraction: float, minimum: float, height_voxels: int) -> void:
	if node == null:
		return
	node.visible = fraction > minimum
	if node.visible:
		node.scale.y = fraction * float(height_voxels)


func _tint_level_body(node: Node3D, material: StandardMaterial3D) -> void:
	if node == null or material == null:
		return
	for child in node.get_children():
		if child is MeshInstance3D:
			child.set_surface_override_material(0, material)


## A hopper's product body is near-white so a per-item tint multiplies
## cleanly over it — *which* item a hopper holds is simulation data.
func _hopper_fill_material(item_id: String) -> StandardMaterial3D:
	var base: StandardMaterial3D = _class_materials.get("matte", null)
	var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.95, 0.0)
	mat.albedo_color = HOPPER_FILL_TINTS.get(item_id, HOPPER_FILL_TINT_FALLBACK)
	return mat


## Swaps a building's status lamp between the same idle/running materials a
## machine's lamp uses (UI_UX.md §4/§7: saturated colour reserved for
## meaning). One helper for all three buffer kinds, since "holds stock" is
## the one state a buffer has.
func _set_lamp_stocked(nodes: Dictionary, stocked: bool) -> void:
	if bool(nodes.get("stocked", false)) == stocked:
		return
	nodes["stocked"] = stocked
	var lamp = nodes.get("lamp")
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if stocked else _lamp_idle)


## Stands one case per unit of stock waiting to be sold on EVERY dock's deck,
## up to DOCK_STOCK_SLOTS each, drawn with that item's own model.
##
## Every dock shows the same pool, deliberately: `EconomySnapshot`'s
## `delivery_stock` is one shared number however many docks the player
## builds (a second dock is another door out of the factory, not a second
## ledger), and the dock's own `contents` empties every tick, so a per-dock
## figure would be zero forever — see DOCK_ASSET's doc.
##
## Pure given `stock` and the built nodes, so a test can drive it directly.
func _update_dock_stock(stock: Array) -> void:
	# Flatten the pool's (item, quantity) pairs into one case per unit, in
	# snapshot order, so a multi-item pool shows a mixed stack rather than
	# only its first product.
	var waiting: Array[String] = []
	for pair in stock:
		if not (pair is Array) or pair.size() < 2:
			continue
		for _i in range(int(pair[1])):
			if waiting.size() >= DOCK_STOCK_SLOTS:
				break
			waiting.append(String(pair[0]))

	for key in _dock_nodes.keys():
		var nodes: Dictionary = _dock_nodes[key]
		var slots: Array = nodes.get("slots", [])
		for i in range(slots.size()):
			var slot: Node3D = slots[i]
			if i >= waiting.size():
				slot.visible = false
				continue
			var asset: String = ITEM_MODELS.get(waiting[i], ITEM_MODEL_FALLBACK)
			var current := slot.get_node_or_null("case")
			if current == null or String(current.get_meta("asset", "")) != asset:
				if current != null:
					slot.remove_child(current)
					current.queue_free()
				var node := _asset_node(asset)
				node.name = "case"
				node.set_meta("asset", asset)
				slot.add_child(node)
			slot.visible = true
		_set_lamp_stocked(nodes, not waiting.is_empty())


## A network's or tank's fluid id, or "" — `fluid` is NULLABLE on the wire
## (a run no machine taps has not been told what it carries), and `String(null)`
## is a hard error in GDScript rather than an empty string.
func _fluid_id_of(snapshot: Dictionary) -> String:
	var value = snapshot.get("fluid")
	return String(value) if value != null else ""


## The liquid's material: palette.ron's own `liquid` class numbers (glossy
## dielectric — UI_UX.md §4's "visible liquid surfaces ... with subtle
## shading/reflection"), tinted per fluid id. Only the tint is decided here;
## the shading numbers stay in palette.ron like every other material.
func _fluid_material_for(fluid_id: String) -> StandardMaterial3D:
	var base: StandardMaterial3D = _class_materials.get("liquid", null)
	var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.14, 0.0)
	mat.albedo_color = FLUID_TINTS.get(fluid_id, FLUID_TINT_FALLBACK)
	return mat


## Re-reads every fluid network and resizes each segment's liquid body to its
## live fill fraction. Cheap by design, and polled for the reason
## `sim::FluidSnapshot`'s own doc gives: fluid moves on nearly every tick and
## deliberately does not dirty its chunk.
##
## The liquid bodies are created here rather than in `_build_placement`,
## because which network a pipe tile belongs to is decided by the whole run,
## and a network's fluid — which decides the tint — is decided by whichever
## machine taps it, so both are only known once the snapshots are read.
func _update_fluid_network() -> void:
	_last_fluid = _read_fluid_snapshots()
	for n in range(_last_fluid.size()):
		var network: Dictionary = _last_fluid[n]
		var material := _fluid_material_for(_fluid_id_of(network))
		var segments: Array = network.get("segments", [])
		for s in range(segments.size()):
			var segment: Dictionary = segments[s]
			var node := _fluid_body_for(n, s, segment, material)
			if node == null:
				continue
			var pressure: float = clampf(float(segment.get("pressure", 0.0)), 0.0, 1.0)
			_apply_level(node, pressure, FLUID_MIN_VISIBLE_PRESSURE, PIPE_BORE_HEIGHT_VOXELS)


## The liquid body sitting in one pipe segment's bore, created on first
## sight. Keyed by (network, segment) rather than pooled in an array, because
## a placement can add or remove a whole network between frames.
func _fluid_body_for(network_index: int, segment_index: int, segment: Dictionary,
		material: StandardMaterial3D) -> Node3D:
	if _world_root == null:
		return null
	var key := "%d:%d" % [network_index, segment_index]
	if _pipe_fluid_nodes.has(key):
		# Deliberately NOT retinted here: this runs every frame, and a
		# network's fluid is decided by whichever machine taps it, which only
		# changes when something is placed — and a placement rebuilds these.
		return _pipe_fluid_nodes[key]
	var tile := _pair_to_tile(segment.get("tile", [0, 0]))
	var direction := String(segment.get("direction", "east"))
	var node := _asset_node(PIPE_FLUID_ASSET)
	node.name = "fluid_%s" % _tile_key(tile)
	node.position = _tile_origin(tile.x, tile.y, PIPE_BORE_FLOOR_Y)
	node.rotation.y = _direction_yaw(direction)
	if _pipe_asset_for(tile) == PIPE_INLET_ASSET:
		# `pipe_inlet` closes its downstream end with a blind flange (see its
		# generator doc). Left full length the liquid pushes straight through
		# it and the run reads as an open, liquid-filled cut pipe. Trimmed
		# along the tile's OWN facing, so a turned inlet trims its own end.
		var offset := _direction_offset(direction)
		node.scale.x = 1.0 - FLUID_END_CAP_TRIM
		node.position -= Vector3(float(offset.x), 0.0, float(offset.y)) * (0.5 * FLUID_END_CAP_TRIM * TILE)
	_tint_level_body(node, material)
	_world_root.add_child(node)
	_pipe_fluid_nodes[key] = node
	return node


## How far through its current process the machine at `origin_key` is, as
## 0..1, or -1.0 when it is idle. Derived from `_machine_states`'s own
## `process` = `[start_tick, required_ticks]` pair plus the simulation's
## current tick — NOT from a per-tick snapshot, and that distinction matters
## here more than anywhere else in this file: a machine only dirties its
## chunk when its state actually changes, so through the whole of a process
## no snapshot arrives at all. Recomputing from `current_tick()` every frame
## is what makes a long process animate smoothly rather than jump when it
## ends. Pure, so it is directly testable.
func _machine_progress(origin_key: String) -> float:
	if not _machine_states.has(origin_key):
		return -1.0
	var process = _machine_states[origin_key].get("process")
	if process == null:
		return -1.0
	var required: int = int(process[1])
	if required <= 0:
		return -1.0
	var elapsed: int = sim.current_tick() - int(process[0])
	return clampf(float(elapsed) / float(required), 0.0, 1.0)


## Rescales every declared progress gauge to its machine's live process
## fraction — the same one-poll/one-scaled-body pattern the pipe's liquid and
## the hopper's and tank's levels use, deliberately reused rather than
## invented again.
func _update_machine_gauges() -> void:
	for origin_key in _machine_gauges.keys():
		var gauge: Node3D = _machine_gauges[origin_key]
		if gauge == null:
			continue
		var fraction := _machine_progress(origin_key)
		gauge.visible = fraction > MACHINE_GAUGE_MIN_VISIBLE
		if gauge.visible:
			gauge.scale.y = fraction * float(MACHINE_GAUGE_HEIGHT_VOXELS)


func _set_machine_running(origin_key: String, running: bool) -> void:
	if _machine_running.get(origin_key, null) == running:
		return
	_machine_running[origin_key] = running
	var lamp: MeshInstance3D = _machine_lamps.get(origin_key, null)
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if running else _lamp_idle)


# --------------------------------------------------------------------------
# Camera & lighting
# --------------------------------------------------------------------------

## UI_UX.md §1: a FIXED orthographic isometric camera. No orbit, no free
## rotation — the voxel assets are modelled to read from fixed angles, and a
## free camera would expose silhouettes nothing was art-directed for. Pan
## (WASD/arrows) and zoom (scroll wheel) are explicitly allowed by that same
## section and don't touch the angle: pan moves `_camera_focus`, zoom moves
## `_camera_size`, orientation is always recomputed the same way.
##
## The angle used is true isometric (an equal-parts (1, 1, 1) view direction,
## ~35.26 degrees of elevation), not a 2:1 dimetric. UI_UX.md §9 explicitly
## leaves the final choice open pending a side-by-side prototype; this picks
## the one that keeps voxel cubes perfectly regular on screen, and changing
## it later is one constant here, not an asset change.
const CAMERA_DIRECTION := Vector3(1, 1, 1)
## Orthographic, so this only sets the near/far window, not apparent size.
const CAMERA_DISTANCE := 160.0

# --- Navigation (zoom + pan) -----------------------------------------------
# UI_UX.md §1 explicitly allows smooth zoom and only forbids free rotation —
# the fixed isometric angle itself never changes here, only `size` (zoom) and
# `_camera_focus` (pan) do.
const ZOOM_STEP := 0.1 # fraction of current size per scroll notch, mouse wheel or +/-
const ZOOM_MIN_FACTOR := 0.3 # most zoomed in, relative to the auto-framed size
const ZOOM_MAX_FACTOR := 3.0 # most zoomed out
const PAN_SPEED := 0.9 # fraction of the visible size crossed per second at held-key pan
# InputEventPanGesture.delta is in gesture-magnitude units, not wheel notches,
# and arrives many times per swipe — this converts one unit of that delta
# into a fraction of ZOOM_STEP's effect, tuned so a normal swipe feels
# similar in speed to a few wheel notches, not a single giant jump.
const TRACKPAD_ZOOM_SENSITIVITY := 0.01
const ISO_NEAR := 0.5

# --- First-person mode -----------------------------------------------------
# Not a UI_UX.md concept — a free-look "fly" camera for looking around the
# factory up close. No gravity, no collision: this project has no player
# entity or collision shapes on the voxel meshes, so it deliberately doesn't
# pretend to be one.
const FP_MOVE_SPEED := 6.0 # world units/second (~2 tiles/second)
const FP_MOUSE_SENSITIVITY := 0.0025 # radians per pixel of relative mouse motion
const FP_PITCH_LIMIT := deg_to_rad(89.0) # stop just short of looking straight up/down
const FP_FOV := 75.0
const FP_NEAR := 0.05 # much closer than ISO_NEAR — this mode gets right up next to machines
const CROSSHAIR_SIZE := 14.0 # px, each bar's length
const CROSSHAIR_THICKNESS := 2.0 # px, each bar's width

# The **C: collect product** hint these two used to carry is gone, with the
# key that drove it: the delivery-dock ticket deleted
# `PlayerCommand::CollectOutput` outright, because the chain now ends in a
# real dock that ships into the delivery pool every tick by itself. A key
# that quietly did nothing would be worse than no key — `issue_command_json`
# treats an unknown command as a silent no-op, so the legend would have been
# advertising a control the simulation no longer has.
## Three keys are new in the "Real Placement" epic's ticket 2, and they are
## what a build mode is made of. **R** turns things: it cycles the ghost's
## facing while placing, and — outside placement mode — rotates whatever is
## under the cursor in place, so turning a belt you already laid needs no
## pick-up-and-re-place round trip. **X** toggles remove mode, a mode rather
## than a modifier-click precisely because it is destructive and a mode is
## visible in this legend and in the on-screen prompt, where a held key is
## not. **ESC** leaves either. All three are free in both view modes (R, X
## and ESC collided with nothing), and the left mouse button — which
## `_unhandled_input` had deliberately left unbound "so a future
## click-to-build has nothing to fight with" — is now that click.
## Two LINES, not one. Build mode added three keys and a mouse button to a
## legend that already ran the width of the window, and a single line was
## being clipped behind the contract clipboard in the top-right corner — the
## kind of thing only a rendered frame shows (UI_UX.md §2b point 12). The
## build controls lead, because they are what the player does most.
const ISO_HELP_TEXT := "1-9/0: pick from hotbar    click: place    R: rotate    Q: hopper contents    X: remove mode    ESC: close\nE: build menu    M: ingredient market    SPACE: load hoppers    V: load tanks    WASD/drag/arrows: pan    scroll/+-: zoom    TAB: first-person"
const FP_HELP_TEXT := "1-9/0: pick from hotbar    click: place    R: rotate    Q: hopper contents    X: remove mode    ESC: close\nE: build menu    M: ingredient market    V: load tanks    WASD: move    mouse: look    SPACE/SHIFT: up/down    TAB: isometric"


## The tile box the isometric camera frames at startup: whatever is placed,
## widened to at least EMPTY_WORLD_FRAME_TILES in each axis about its own
## centre. The widening is what makes an EMPTY world (the new starting state)
## open on a usable expanse of floor instead of on one tile — there is no
## chain to frame any more, and "frame nothing" has to mean something.
func _framing_bounds() -> Rect2i:
	var bounds := _world_tile_bounds()
	var span_x: int = maxi(bounds.size.x, EMPTY_WORLD_FRAME_TILES)
	var span_y: int = maxi(bounds.size.y, EMPTY_WORLD_FRAME_TILES)
	var centre_x: float = float(bounds.position.x) + float(bounds.size.x) * 0.5
	var centre_y: float = float(bounds.position.y) + float(bounds.size.y) * 0.5
	return Rect2i(
		Vector2i(int(round(centre_x - float(span_x) * 0.5)), int(round(centre_y - float(span_y) * 0.5))),
		Vector2i(span_x, span_y)
	)


func _build_camera() -> void:
	# Framed on whatever is placed, padded out to at least a workable square
	# of floor — which for a NEW GAME (nothing placed at all) means the view
	# opens on empty ground around the origin rather than zoomed into a
	# single tile. Framing happens once, at build time: re-framing on every
	# placement would yank the view around while the player is building.
	_frame_bounds = _framing_bounds()
	_camera_focus = Vector3(
		(float(_frame_bounds.position.x) + float(_frame_bounds.size.x) * 0.5) * TILE,
		TILE * 0.35,
		(float(_frame_bounds.position.y) + float(_frame_bounds.size.y) * 0.5) * TILE
	)

	var camera := Camera3D.new()
	camera.name = "IsometricCamera"
	camera.projection = Camera3D.PROJECTION_ORTHOGONAL
	# KEEP_WIDTH so `size` means the horizontal extent: the factory is a long
	# horizontal line, and it must stay framed regardless of window aspect.
	camera.keep_aspect = Camera3D.KEEP_WIDTH
	camera.near = ISO_NEAR
	camera.far = 600.0
	add_child(camera)
	_camera = camera

	# Position/orient first (size doesn't affect orientation) so the camera's
	# own basis exists to read the ground-plane screen axes from — right is
	# already horizontal (up hint is world Y and the view direction isn't
	# vertical); "screen forward" is the view direction (-basis.z) projected
	# onto the ground. WASD/arrows pan along these, not raw world X/Z, so
	# panning still feels like up/down/left/right on screen regardless of the
	# fixed isometric angle.
	_camera_size = 1.0
	_update_camera_transform()
	_pan_right = _camera.transform.basis.x
	var forward := -_camera.transform.basis.z
	_pan_forward = Vector3(forward.x, 0.0, forward.z).normalized()

	_camera_base_size = _framing_size(_camera.transform.basis)
	_camera_size = _camera_base_size
	_update_camera_transform()
	camera.call_deferred("make_current")


## Repositions/reorients the camera from `_camera_focus`/`_camera_size` —
## called once at build time and again whenever pan or zoom changes. Cheap
## enough to call every time rather than tracking a dirty flag.
func _update_camera_transform() -> void:
	if _camera == null:
		return
	# `look_at_from_position` rather than position-then-`look_at`: the latter
	# requires the node to already be inside the tree, which isn't guaranteed
	# for a scene instantiated and driven manually (as the headless tests do).
	_camera.look_at_from_position(
		_camera_focus + CAMERA_DIRECTION.normalized() * CAMERA_DISTANCE,
		_camera_focus,
		Vector3.UP
	)
	_camera.size = _camera_size


func _zoom_camera(factor: float) -> void:
	var min_size := _camera_base_size * ZOOM_MIN_FACTOR
	var max_size := _camera_base_size * ZOOM_MAX_FACTOR
	_camera_size = clampf(_camera_size * factor, min_size, max_size)
	_update_camera_transform()


func _pan_camera(delta: float) -> void:
	_apply_pan(_pan_input_direction(), delta)


## Reads held keys only — no movement math, so this is the one part of
## panning that can't be exercised without a live Input singleton.
func _pan_input_direction() -> Vector3:
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += _pan_forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= _pan_forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += _pan_right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= _pan_right
	return move


## The actual movement, deliberately Input-free so it's directly testable
## (test_camera_nav.gd calls this with an explicit direction).
func _apply_pan(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	# Scaled by current `_camera_size`, not a flat world-unit speed, so pan
	# covers the same fraction of the visible view per second whether zoomed
	# in or out — a flat speed would feel sluggish when zoomed out and
	# twitchy when zoomed in.
	_camera_focus += direction.normalized() * PAN_SPEED * _camera_size * delta
	_update_camera_transform()


## World units per screen pixel at the current zoom — the conversion factor
## that makes click-and-drag panning track the cursor 1:1 (the point under
## the cursor when the drag started stays under it), rather than an arbitrary
## fixed speed that would feel wrong at every zoom level except one.
func _iso_drag_sensitivity() -> float:
	var width := 0.0
	var vp := get_viewport()
	if vp != null:
		width = vp.get_visible_rect().size.x
	if width <= 0.0:
		# A script-mode SceneTree (this project's own headless tests included)
		# never sizes a real window, so `get_viewport()` reports a zero-size
		# rect — fall back to the project's configured window width so drag
		# panning still does something reasonable instead of silently no-op'ing.
		width = float(ProjectSettings.get_setting("display/window/size/viewport_width", 1280))
	if width <= 0.0:
		return 0.0
	return _camera_size / width


## Right-mouse-drag panning (UI_UX.md §1 allows pan; this is just a second
## way to do it alongside WASD). Right button, not left, so a future
## click-to-build/select interaction on the left button has nothing to fight
## with.
func _apply_drag_pan(relative: Vector2) -> void:
	var sensitivity := _iso_drag_sensitivity()
	if sensitivity <= 0.0:
		return
	# "Grab the world and drag it": the point under the cursor follows the
	# cursor, which means the focus point moves opposite the drag on the
	# right axis and along the forward axis on the (screen-down-is-positive) Y.
	_camera_focus += (-_pan_right * relative.x + _pan_forward * relative.y) * sensitivity
	_update_camera_transform()


# --------------------------------------------------------------------------
# First-person mode
# --------------------------------------------------------------------------

## Rotation around world Y only, no pitch — used both to build the full
## look basis (below) and, on its own, as the horizontal movement basis so
## WASD moves along the ground regardless of where you're looking up/down,
## the same way Minecraft's own flight controls work.
func _fp_heading_basis() -> Basis:
	return Basis(Vector3.UP, _fp_yaw)


## Heading, then tilted by pitch around the resulting local right axis —
## composed in this order specifically so pitch never affects heading.
func _fp_look_basis() -> Basis:
	return _fp_heading_basis() * Basis(Vector3.RIGHT, _fp_pitch)


func _update_fp_camera_transform() -> void:
	if _camera == null:
		return
	_camera.transform = Transform3D(_fp_look_basis(), _fp_position)


## Mouse-look, deliberately Input-free (see _apply_pan's equivalent note) so
## test_camera_nav.gd can call it directly with a synthetic delta.
func _apply_look(relative: Vector2) -> void:
	_fp_yaw -= relative.x * FP_MOUSE_SENSITIVITY
	_fp_pitch = clampf(_fp_pitch - relative.y * FP_MOUSE_SENSITIVITY, -FP_PITCH_LIMIT, FP_PITCH_LIMIT)
	_update_fp_camera_transform()


## Reads held keys only, same split as _pan_input_direction for the same
## reason (untestable headlessly without a live Input singleton). SPACE/SHIFT
## for up/down, Minecraft-style — SPACE only spawns a tomato in ISOMETRIC mode
## (_unhandled_input gates that), so there's no conflict with flying up here.
func _fp_input_direction() -> Vector3:
	var heading := _fp_heading_basis()
	var forward := -heading.z
	var right := heading.x
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= right
	if Input.is_key_pressed(KEY_SPACE):
		move += Vector3.UP
	if Input.is_key_pressed(KEY_SHIFT):
		move -= Vector3.UP
	return move


## The actual movement, Input-free and directly testable — mirrors _apply_pan.
func _apply_fp_move(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	_fp_position += direction.normalized() * FP_MOVE_SPEED * delta
	_update_fp_camera_transform()


func _fp_camera_move(delta: float) -> void:
	_apply_fp_move(_fp_input_direction(), delta)


## TAB toggles between ISOMETRIC and FIRST_PERSON. Both share the one
## Camera3D node — this reconfigures it (projection, near plane, aspect
## policy) rather than creating a second one.
func _set_view_mode(mode: int) -> void:
	if mode == _view_mode:
		return
	_view_mode = mode
	_update_crosshair_visibility()

	if mode == ViewMode.FIRST_PERSON:
		_iso_dragging = false
		# Start hovering above wherever the isometric view was focused, so
		# the switch feels continuous instead of teleporting to the origin.
		_fp_position = _camera_focus + Vector3(0.0, TILE * 1.5, 0.0)
		# Best-effort continuity, not an exact guarantee: face roughly the
		# same way the isometric camera was looking. Mouse-look overrides it
		# immediately, so an imperfect starting angle here doesn't matter.
		_fp_yaw = atan2(-_pan_forward.x, -_pan_forward.z)
		_fp_pitch = deg_to_rad(-15.0)
		_camera.projection = Camera3D.PROJECTION_PERSPECTIVE
		_camera.fov = FP_FOV
		_camera.near = FP_NEAR
		_camera.keep_aspect = Camera3D.KEEP_HEIGHT
		# ...unless the build menu is up, which needs the cursor (see
		# _set_shop_menu_open); closing it recaptures.
		if not _shop_open:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		_update_fp_camera_transform()
		if _help_label != null:
			_help_label.text = FP_HELP_TEXT
	else:
		# Keep the isometric view's height (its focus point's Y never moved
		# on its own), just recentre X/Z on wherever first-person ended up.
		_camera_focus = Vector3(_fp_position.x, _camera_focus.y, _fp_position.z)
		_camera.projection = Camera3D.PROJECTION_ORTHOGONAL
		_camera.near = ISO_NEAR
		_camera.keep_aspect = Camera3D.KEEP_WIDTH
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		_update_camera_transform()
		if _help_label != null:
			_help_label.text = ISO_HELP_TEXT
	_update_camera_transform()


## Fits the orthographic frustum to the factory floor's bounding box by
## projecting its eight corners onto the camera's own right/up axes.
##
## Worth doing properly rather than eyeballing a constant: the chain's length
## is whatever data/recipes.ron currently defines, so the framing has to be
## derived, and an isometric view rotates the world box 45 degrees relative to
## the screen — a naive "width = chain length" estimate is wrong in both
## directions at once.
func _framing_size(basis: Basis) -> float:
	var x_from := float(_frame_bounds.position.x - FLOOR_MARGIN_X) - 0.5
	var x_to := float(_frame_bounds.position.x + _frame_bounds.size.x + FLOOR_MARGIN_X) + 0.5
	var z_from := float(_frame_bounds.position.y - FLOOR_MARGIN_Z) - 0.5
	var z_to := float(_frame_bounds.position.y + _frame_bounds.size.y + FLOOR_MARGIN_Z) + 0.5

	var min_right := INF
	var max_right := -INF
	var min_up := INF
	var max_up := -INF
	for cx in [x_from, x_to]:
		for cz in [z_from, z_to]:
			# 0 .. one tile tall covers the floor slab through the machines'
			# vessels; the exhaust stacks poking above are not worth zooming
			# the whole factory out for.
			for cy in [0.0, TILE]:
				var corner := Vector3(cx * TILE, cy, cz * TILE)
				min_right = min(min_right, basis.x.dot(corner))
				max_right = max(max_right, basis.x.dot(corner))
				min_up = min(min_up, basis.y.dot(corner))
				max_up = max(max_up, basis.y.dot(corner))

	var aspect := 16.0 / 9.0
	var viewport := get_viewport()
	if viewport != null:
		var rect := viewport.get_visible_rect().size
		if rect.x > 0.0 and rect.y > 0.0:
			aspect = rect.x / rect.y

	var needed_width := max_right - min_right
	var needed_height := max_up - min_up
	return max(needed_width, needed_height * aspect) * 1.06


## UI_UX.md §4: real-time dynamic lighting with soft shadows, light ambient
## occlusion in voxel crevices, and mild bloom on emissives — the
## "modded Minecraft with a shader pack" reference point, not photorealism.
## All of it is stock Forward+ environment configuration; no custom shaders.
##
## The sky IS the visible backdrop (BG_SKY), not just a light source — a
## flat near-black BG_COLOR was tried first specifically to avoid a hard
## horizon line/sun streak behind the tightly-framed isometric view, but it
## reads as an empty void the moment first-person mode lets you look around
## freely, which fights UI_UX.md §3's "a real factory you could walk into,"
## not a factory floating in nothing. A soft, bright, sun-disk-free sky (see
## sun_angle_max below) keeps the "no distracting streak" property that
## motivated the original choice, while actually looking like somewhere.
func _build_environment() -> void:
	var sky_material := ProceduralSkyMaterial.new()
	# A brighter, friendlier daytime sky than the original — still a
	# believable overcast-ish industrial-zone sky (UI_UX.md §3's "grounded,
	# not cartoonish"), just not dim enough to read as night or a void.
	sky_material.sky_top_color = Color(0.42, 0.55, 0.72)
	sky_material.sky_horizon_color = Color(0.78, 0.81, 0.83)
	sky_material.ground_horizon_color = Color(0.42, 0.40, 0.37)
	sky_material.ground_bottom_color = Color(0.24, 0.23, 0.21)
	# Still no sun disk: the default draws a wide soft halo that the glow pass
	# smears into a distracting beam. Brightness now comes from the sky
	# colours and the key light below, not a visible sun.
	sky_material.sun_angle_max = 0.0
	var sky := Sky.new()
	sky.sky_material = sky_material

	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	# Sky-derived ambient is what fills the shadowed sides of a voxel model;
	# without it, unlit faces read as flat black and the medium looks cheap.
	# Raised from the original 0.55 alongside the brighter sky above.
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.8

	env.ssao_enabled = true
	env.ssao_radius = 0.9
	env.ssao_intensity = 2.4
	env.ssao_power = 1.6

	env.glow_enabled = true
	env.glow_intensity = 0.7
	env.glow_bloom = 0.15
	env.glow_hdr_threshold = 0.85
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT

	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_white = 6.0
	# Raised from 0.92 to match the brighter sky/ambient — ACES still rolls
	# off highlights safely, so this doesn't blow out the metal specular.
	env.tonemap_exposure = 1.05
	# Deliberately no depth fog: it was tried, and at this camera distance it
	# flattened the whole factory into one haze-grey value and cost more
	# contrast than the atmosphere was worth.

	var world_env := WorldEnvironment.new()
	world_env.name = "Environment"
	world_env.environment = env
	add_child(world_env)

	# Key light: warm, shadow-casting, angled so machinery casts shadows
	# across the belt line rather than straight down it.
	var sun := DirectionalLight3D.new()
	sun.name = "KeyLight"
	sun.rotation_degrees = Vector3(-52.0, -130.0, 0.0)
	sun.light_color = Color(1.0, 0.95, 0.88)
	sun.light_energy = 1.6
	sun.shadow_enabled = true
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	sun.directional_shadow_max_distance = 160.0
	sun.shadow_blur = 1.4
	# A non-zero angular size is what actually softens the shadow edge with
	# distance, rather than just blurring the whole map uniformly.
	sun.light_angular_distance = 0.6
	add_child(sun)

	# Cool fill from the opposite side, no shadows — keeps the shadowed faces
	# of stainless steel from going dead grey.
	var fill := DirectionalLight3D.new()
	fill.name = "FillLight"
	fill.rotation_degrees = Vector3(-28.0, 55.0, 0.0)
	fill.light_color = Color(0.72, 0.80, 1.0)
	fill.light_energy = 0.4
	fill.shadow_enabled = false
	add_child(fill)


# --------------------------------------------------------------------------
# HUD
# --------------------------------------------------------------------------

func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.name = "HUD"
	add_child(hud)

	# A dark plate with a single hazard-yellow rule along the top. UI_UX.md
	# §5's real UI pass (clipboard/checklist widgets, voxel-rendered icon
	# slots) is its own piece of work; this is the minimum that keeps text
	# legible over a lit 3D scene, rather than pretending to be that pass.
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.74)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.border_width_top = 3
	style.set_content_margin_all(12.0)

	var panel := PanelContainer.new()
	panel.add_theme_stylebox_override("panel", style)
	panel.position = Vector2(16, 16)
	hud.add_child(panel)

	var rows := VBoxContainer.new()
	rows.add_theme_constant_override("separation", 4)
	panel.add_child(rows)

	var settings := LabelSettings.new()
	settings.font_size = 15
	settings.font_color = Color(0.92, 0.93, 0.94)
	settings.outline_size = 4
	settings.outline_color = Color(0, 0, 0, 0.85)

	_help_label = Label.new()
	_help_label.label_settings = settings
	_help_label.text = ISO_HELP_TEXT
	rows.add_child(_help_label)

	# UI_UX.md §5: "a contract IS a clipboard." The money/contract readout
	# used to be a plain Label folded into the panel above (milestone 5); it
	# now gets its own diegetic clipboard panel — paper background, a steel
	# clip bar, checkbox-style tick marks for delivery progress.
	_build_contract_panel(hud, settings)

	# UI_UX.md §5's other named widget: "build/recipe menus as grids of
	# voxel-rendered icon slots." Hidden until E is pressed.
	_build_shop_menu(hud, settings)
	_build_ingredient_market(hud, settings)

	# UI_UX.md §5's LAST unbuilt named widget: "a Minecraft-style hotbar/
	# quick-access strip along one screen edge." Always visible, unlike the
	# menu above — it is how a kind gets picked up now, and the menu is where
	# more of one gets bought.
	_build_hotbar(hud, settings)

	# The hover tooltip (docs/UI_UX.md §5): replaces the always-on per-machine
	# text this panel used to show — see _build_hover_tooltip/
	# _update_hover_tooltip below.
	_build_hover_tooltip(hud)
	# The build-mode prompt (the "Real Placement" epic's ticket 2) — the same
	# dark plate by the cursor, saying what the next click will do.
	_build_placement_prompt(hud, settings)
	_build_crosshair(hud)


## The diegetic clipboard/checklist widget (UI_UX.md §5) — the money/contract
## readout as "a paper texture on a metal clipboard clip" rather than a plain
## Label. Deliberately its own PanelContainer, sibling to (not nested inside)
## the generic HUD panel above, so this stays intact regardless of what other
## panels come and go there.
##
## LAYOUT DECISION (contracts-as-data, ticket 2). `economy_snapshot_json`
## reports an ARRAY of contracts, so this is a board of dockets, not a
## clipboard per contract: one sheet of paper under one steel clip, carrying
## the SHARED money figure and the SHARED dock stock once at the top, then one
## printed docket card per contract stacked below. Both alternatives were
## considered and rejected — a separate PanelContainer per contract repeats
## the 12px clip bar and the paper frame three times over for no new
## information, and a single flat list of checklist rows loses which rows
## belong to which order the moment two contracts want the same item (all
## three shipped contracts want `boxed_ketchup`). A docket is a slightly
## darker paper tone with a steel hairline — the same two colours the panel
## and its checkboxes already use, so this adds separation without adding a
## visual language.
func _build_contract_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	# Paper cream background + a thick steel-toned top border standing in for
	# "the clip" — the same technique the panel above already uses for its
	# hazard-yellow accent rule, just recoloured and thickened. UI_UX.md §5
	# only asks for "even just a contrasting-coloured strip along one edge,"
	# so nothing fancier (a drawn clasp, a texture) is warranted yet.
	var paper_style := StyleBoxFlat.new()
	paper_style.bg_color = Color(0.87, 0.81, 0.64, 0.98) # warm off-white paper
	paper_style.border_color = Color(0.27, 0.29, 0.32, 1.0) # steel-grey frame/clip
	paper_style.border_width_left = 3
	paper_style.border_width_right = 3
	paper_style.border_width_bottom = 3
	paper_style.border_width_top = 12 # the clip bar
	paper_style.set_content_margin_all(12.0)
	paper_style.content_margin_top = 18.0 # clearance under the thicker clip bar

	_contract_panel = PanelContainer.new()
	_contract_panel.name = "ContractPanel"
	_contract_panel.add_theme_stylebox_override("panel", paper_style)
	hud.add_child(_contract_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", 6)
	_contract_panel.add_child(body)

	# Dark ink on paper, not the pale-text-with-black-outline style the panel
	# above uses — that styling exists specifically to stay legible over a
	# lit 3D scene, which doesn't apply once text sits on an opaque paper
	# panel. Font family and size are still the ones already established in
	# _build_ui() (UI_UX.md §5's own "sturdy, slightly blocky" typography
	# call), only colour/outline change for the paper background.
	_contract_ink_settings = LabelSettings.new()
	_contract_ink_settings.font_size = base_settings.font_size
	_contract_ink_settings.font_color = Color(0.16, 0.13, 0.08)
	_contract_ink_settings.outline_size = 0

	# A small type-scale hierarchy on the clipboard, added during the visual-
	# overhaul pass: the title and the money figure used to share the exact
	# body text size, so nothing on the panel told the eye what mattered most
	# — a real UI_UX.md §5 polish gap ("typography/readability issues"), not
	# just an aesthetic nicety. Same ink colour and family throughout, only
	# size steps up, so it still reads as one consistent clipboard rather
	# than mixed styles. With several dockets on the board the hierarchy has
	# one more rung: a contract's NAME is the heading of its own docket, and
	# its cadence/tally line is deliberately the smallest thing on the panel.
	var title_settings := LabelSettings.new()
	title_settings.font_size = base_settings.font_size + 2
	title_settings.font_color = _contract_ink_settings.font_color
	title_settings.outline_size = 0

	var money_settings := LabelSettings.new()
	money_settings.font_size = base_settings.font_size + 6
	money_settings.font_color = _contract_ink_settings.font_color
	money_settings.outline_size = 0

	_contract_name_settings = LabelSettings.new()
	_contract_name_settings.font_size = base_settings.font_size + 1
	_contract_name_settings.font_color = _contract_ink_settings.font_color
	_contract_name_settings.outline_size = 0

	# The tick mark gets its own settings, not the body ink's. At body size a
	# "✓" overflows a 14px checkbox and renders as a clipped diagonal in the
	# corner (visible only in a real screenshot — the headless test happily
	# reports a visible Mark node either way), and dark ink on the checked
	# green is the panel's weakest contrast anywhere. Small and paper-pale
	# fixes both.
	_checkbox_mark_settings = LabelSettings.new()
	_checkbox_mark_settings.font_size = max(8, base_settings.font_size - 4)
	_checkbox_mark_settings.font_color = Color(0.91, 0.88, 0.78)
	_checkbox_mark_settings.outline_size = 0

	_contract_meta_settings = LabelSettings.new()
	_contract_meta_settings.font_size = max(9, base_settings.font_size - 2)
	# A touch lighter than body ink — still well clear of the paper, but the
	# cadence/tally line should read as a footnote on the docket, not as
	# another checklist item.
	_contract_meta_settings.font_color = Color(0.34, 0.29, 0.20)
	_contract_meta_settings.outline_size = 0

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "CONTRACTS"
	body.add_child(title)

	# Money is shown ONCE, here, and never per docket: GAMEPLAY.md §1 allows
	# exactly one currency, and sim_core keeps exactly one counter for it.
	_contract_money_label = Label.new()
	_contract_money_label.label_settings = money_settings
	body.add_child(_contract_money_label)

	# The shared delivery pool, also once. See _update_contract_dock for why
	# this line exists at all.
	_contract_dock_row = HBoxContainer.new()
	_contract_dock_row.name = "DockRow"
	_contract_dock_row.add_theme_constant_override("separation", 6)
	body.add_child(_contract_dock_row)

	var dock_title := Label.new()
	dock_title.label_settings = _contract_meta_settings
	dock_title.text = "ON THE DOCK"
	_contract_dock_row.add_child(dock_title)

	_contract_dock_empty_label = Label.new()
	_contract_dock_empty_label.label_settings = _contract_meta_settings
	_contract_dock_empty_label.text = "empty"
	_contract_dock_row.add_child(_contract_dock_empty_label)

	_checkbox_style_unchecked = StyleBoxFlat.new()
	_checkbox_style_unchecked.bg_color = Color(0.80, 0.74, 0.57, 1.0) # a shade darker than the paper
	_checkbox_style_unchecked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_unchecked.set_border_width_all(2)

	_checkbox_style_checked = StyleBoxFlat.new()
	_checkbox_style_checked.bg_color = Color(0.24, 0.42, 0.24, 1.0) # a muted, saturated "done" green —
	# UI_UX.md §7: saturated colour reserved for meaning, and a completed
	# checklist item is exactly that meaning, not decoration.
	_checkbox_style_checked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_checked.set_border_width_all(2)

	# One docket = the checkbox's own paper tone plus a steel hairline. Reusing
	# those two existing colours is the point (see this function's header):
	# separation without a third palette.
	_contract_card_style = StyleBoxFlat.new()
	_contract_card_style.bg_color = Color(0.83, 0.77, 0.60, 1.0)
	_contract_card_style.border_color = Color(0.47, 0.44, 0.38, 1.0)
	_contract_card_style.set_border_width_all(1)
	_contract_card_style.set_content_margin_all(8.0)

	# The dockets live in a ScrollContainer whose height is capped in
	# _update_contract_panel — a safety valve for a future contracts.ron with
	# more orders than fit, not a UI the player is expected to drive today.
	_contract_cards_scroll = ScrollContainer.new()
	_contract_cards_scroll.name = "ContractList"
	_contract_cards_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_contract_cards_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_contract_cards_scroll)

	_contract_cards_box = VBoxContainer.new()
	_contract_cards_box.name = "ContractCards"
	_contract_cards_box.add_theme_constant_override("separation", 8)
	_contract_cards_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_contract_cards_scroll.add_child(_contract_cards_box)

	# One docket per active contract, read live from economy_snapshot_json
	# rather than assumed — nothing here hardcodes how many contracts exist,
	# what they ask for, or what they pay.
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_rebuild_contract_cards(econ.get("contracts", []))

	# Anchored to the top-right corner with a fixed margin, sized to its own
	# content — independent of however tall the machine-line panel ends up
	# being.
	_contract_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE, 16)


## Rebuilds the docket stack from a `contracts` array. Called once at build
## time and again only if the SET of contract ids changes — the shipped world
## loads its contracts once and never adds or drops one, but a future
## "contract accepted / contract lost" mechanic (GAMEPLAY.md §11's open
## question about what a missed window costs) would, and the guard costs a
## string compare per frame.
func _rebuild_contract_cards(contracts: Array) -> void:
	for card in _contract_cards:
		# Detach FIRST, then queue_free: queue_free is deferred to the end of
		# the frame, so freeing alone would leave the old dockets in the
		# container alongside the new ones for a frame. Detach from whatever
		# the panel's parent actually IS rather than from the current card
		# box — a scene re-entering the tree runs _ready (and so
		# _build_contract_panel) a second time, at which point these records
		# still point at the previous build's container.
		var panel: Node = card["panel"]
		if is_instance_valid(panel):
			if panel.get_parent() != null:
				panel.get_parent().remove_child(panel)
			panel.queue_free()
	_contract_cards.clear()
	_contract_card_ids.clear()
	for contract in contracts:
		_contract_cards.append(_build_contract_card(contract))
		_contract_card_ids.append(String(contract.get("id", "")))


## One contract's docket: its name and payout on a header row, a checklist row
## per line of its mix, and its OWN cadence/tally footnote. Every contract
## clocks independently in sim_core, so this countdown is per docket and is
## never shared the way money is.
##
## Returns the record `_update_contract_panel` drives it through:
##   {"id", "panel", "name_label", "payout_label", "meta_label",
##    "rows": {item id -> {"icon", "label", "boxes"}}}
func _build_contract_card(contract: Dictionary) -> Dictionary:
	var panel := PanelContainer.new()
	panel.name = "ContractCard_%s" % String(contract.get("id", "?"))
	panel.add_theme_stylebox_override("panel", _contract_card_style)
	_contract_cards_box.add_child(panel)

	var card_body := VBoxContainer.new()
	card_body.add_theme_constant_override("separation", 4)
	panel.add_child(card_body)

	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", 10)
	card_body.add_child(header)

	var name_label := Label.new()
	name_label.label_settings = _contract_name_settings
	name_label.text = String(contract.get("name", contract.get("id", "?")))
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(name_label)

	# What this order is worth per delivery. It is the whole reason a player
	# chooses which docket to feed when the line can't serve them all
	# (GAMEPLAY.md §6), so it belongs on the docket, not in a tooltip.
	var payout_label := Label.new()
	payout_label.label_settings = _contract_name_settings
	payout_label.text = "+%d" % int(contract.get("payout", 0))
	payout_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	header.add_child(payout_label)

	var rows: Dictionary = {}
	for pair in contract.get("mix", []):
		var item_id: String = String(pair[0])
		var required: int = int(pair[1])
		rows[item_id] = _build_contract_checklist_row(card_body, item_id, required)

	var meta_label := Label.new()
	meta_label.label_settings = _contract_meta_settings
	card_body.add_child(meta_label)

	return {
		"id": String(contract.get("id", "")),
		"panel": panel,
		"name_label": name_label,
		"payout_label": payout_label,
		"meta_label": meta_label,
		"rows": rows,
	}


## One checklist row: the item's numeric progress text, plus a row of small
## checkbox squares — one per required unit, per UI_UX.md §5's "checkbox-
## style tick marks for completed items." A contract asking for a very large
## quantity would make a per-unit row unreadably wide, so past
## CONTRACT_CHECKLIST_MAX_BOXES this falls back to a single box standing for
## "fully delivered" — the minimum the original ticket calls acceptable.
##
## Returns `{"icon", "label", "boxes"}` for its docket's record: the nodes are
## no longer stashed in a panel-wide dictionary keyed by item id, because
## several contracts legitimately ask for the SAME item (every contract in the
## shipped `data/contracts.ron` wants `boxed_ketchup`) and one such dictionary
## would have them silently overwrite each other's rows.
func _build_contract_checklist_row(body: VBoxContainer, item_id: String, required: int) -> Dictionary:
	# Icon + text share a row: UI_UX.md §5's "icons are rendered from the
	# real assets" (_icon_for) applied to the one place this panel names a
	# specific item.
	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", 6)
	body.add_child(header)

	var icon := TextureRect.new()
	icon.custom_minimum_size = Vector2(16, 16)
	# Without this, TextureRect's own minimum size defaults to the source
	# texture's actual size (64x64) and wins over custom_minimum_size above —
	# EXPAND_IGNORE_SIZE is what makes the 16x16 slot actually stick.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	header.add_child(icon)

	var progress_label := Label.new()
	progress_label.label_settings = _contract_ink_settings
	header.add_child(progress_label)

	var checklist := HBoxContainer.new()
	checklist.add_theme_constant_override("separation", 4)
	body.add_child(checklist)

	var box_count: int = required if required <= CONTRACT_CHECKLIST_MAX_BOXES else 1
	var boxes: Array = []
	for i in range(box_count):
		var box := Panel.new()
		box.name = "checkbox_%s_%d" % [item_id, i]
		box.custom_minimum_size = Vector2(14, 14)
		box.add_theme_stylebox_override("panel", _checkbox_style_unchecked)
		box.set_meta("checked", false)

		var mark := Label.new()
		mark.name = "Mark"
		mark.text = "✓"
		mark.label_settings = _checkbox_mark_settings
		mark.visible = false
		mark.set_anchors_preset(Control.PRESET_FULL_RECT)
		mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		mark.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		box.add_child(mark)

		checklist.add_child(box)
		boxes.append(box)
	return {"icon": icon, "label": progress_label, "boxes": boxes}


# --------------------------------------------------------------------------
# The build menu (UI_UX.md §5, the "Shop & Inventory" epic's ticket 2)
# --------------------------------------------------------------------------

## The player's first real agency: a grid of voxel-rendered icon slots, one
## per `data/shop.ron` entry, that spends contract money on equipment.
##
## Everything on it comes from `shop_snapshot_json` — kinds, order, unit
## prices, owned counts and affordability — so adding a kind to
## `data/shop.ron` puts a slot here with no Godot edit, exactly the way
## adding a recipe already extends the chain. Ticket 1's snapshot is polled
## rather than pushed, per its own doc: a purchase changes money and a count,
## never a tile, so `dirty_chunk_ids()` will never report one.
##
## Visual language is the scene's DARK PLATE, not the contract clipboard's
## paper — the same near-black panel with a hazard-yellow rule the HUD strip
## and the hover tooltip already use. The clipboard motif is for orders and
## checklists (UI_UX.md §5 says so explicitly); a build menu is machine-side
## factory UI, and it also has to stay legible while floating over a lit 3D
## scene, which is exactly what that dark plate exists for.
func _build_shop_menu(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = 4
	panel_style.border_width_left = 2
	panel_style.border_width_right = 2
	panel_style.border_width_bottom = 2
	panel_style.set_content_margin_all(16.0)

	_shop_menu = PanelContainer.new()
	_shop_menu.name = "ShopMenu"
	_shop_menu.add_theme_stylebox_override("panel", panel_style)
	_shop_menu.visible = false
	hud.add_child(_shop_menu)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", 10)
	_shop_menu.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = base_settings.font_size + 4
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "BUILD MENU"
	body.add_child(title)

	# Money is repeated here rather than left to the contract clipboard in
	# the opposite screen corner. The decision a player makes in this menu is
	# "can I afford that", and making them look across the screen to answer it
	# is exactly the readability problem UI_UX.md §5 is about. It is the same
	# number from the same snapshot — `shop_snapshot_json` carries `money`
	# precisely so a build menu is one call — not a second counter.
	var money_settings := LabelSettings.new()
	money_settings.font_size = base_settings.font_size + 6
	money_settings.font_color = Color(0.98, 0.85, 0.42) # the panel's own hazard accent
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_shop_money_label = Label.new()
	_shop_money_label.label_settings = money_settings
	body.add_child(_shop_money_label)

	var grid := GridContainer.new()
	grid.name = "ShopGrid"
	grid.columns = SHOP_SLOT_COLUMNS
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	body.add_child(grid)

	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	for index in range(entries.size()):
		_build_shop_slot(grid, base_settings, index, String(entries[index]["kind"]))

	var footer := Label.new()
	footer.label_settings = base_settings
	footer.text = "left-click (or SHIFT+its number) buys one    right-click (or just its number) puts one in your hand    E/ESC: close"
	body.add_child(footer)

	_position_shop_menu()


## Centres the menu in the space ABOVE the hotbar rather than in the whole
## viewport. The strip is always on screen now, and a plain centred menu tall
## enough to reach it buries its own FOOTER under the plate — which is exactly
## where the two mouse buttons' meanings are written down, so the one line
## that explains buying was the one line the hotbar hid. Found in a rendered
## frame; nothing in the code could have shown it.
func _position_shop_menu() -> void:
	if _shop_menu == null:
		return
	_shop_menu.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := HOTBAR_SLOT_SIZE.y * HOTBAR_SELECTED_SCALE + HOTBAR_BOTTOM_MARGIN * 3.0
	if _hotbar_root != null and _hotbar_root.size.y > 0.0:
		reserved = _hotbar_root.size.y + HOTBAR_BOTTOM_MARGIN * 2.0
	var bounds := vp.get_visible_rect().size
	var menu_size := _shop_menu.get_combined_minimum_size()
	_shop_menu.position.y = max(8.0, (bounds.y - reserved - menu_size.y) * 0.5)


## One icon slot. A Button rather than a Panel so pressing it is the whole
## interaction — no selection cursor, no confirm step, no second mode to
## explain; this is the project's first interactive menu and the simplest
## thing that works is the right thing. Its label children ignore the mouse
## so the entire square stays one click target.
func _build_shop_slot(grid: GridContainer, base_settings: LabelSettings, index: int, kind: String) -> void:
	var button := Button.new()
	button.name = "ShopSlot_%s" % kind
	button.custom_minimum_size = SHOP_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(state, _shop_slot_style(state))
	button.pressed.connect(_on_shop_slot_pressed.bind(index))
	# Right-click is the PLACE half of a slot (see `_on_shop_slot_gui_input`).
	# A Button only reports the left button through `pressed`, so the second
	# action has to come off the raw event.
	button.gui_input.connect(_on_shop_slot_gui_input.bind(index))
	grid.add_child(button)

	# Anchored over the button rather than parented through a container: a
	# Button lays its own (text) content out and is not a container, so its
	# children have to place themselves.
	var column := VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	column.add_theme_constant_override("separation", 2)
	column.set_anchors_preset(Control.PRESET_FULL_RECT)
	column.offset_left = 8
	column.offset_right = -8
	column.offset_top = 8
	column.offset_bottom = -8
	button.add_child(column)

	# The hotkey corner. Slots past SHOP_HOTKEY_SLOTS simply show nothing
	# here and stay click-only, rather than inventing a second key scheme.
	var hotkey_settings := LabelSettings.new()
	hotkey_settings.font_size = base_settings.font_size - 3
	hotkey_settings.font_color = Color(0.62, 0.64, 0.68)
	hotkey_settings.outline_size = base_settings.outline_size
	hotkey_settings.outline_color = base_settings.outline_color

	var hotkey := Label.new()
	hotkey.name = "Hotkey"
	hotkey.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hotkey.label_settings = hotkey_settings
	# The SAME digit the hotbar prints on the same slot — menu slot N and
	# hotbar slot N are one kind, so one label serves both. Since the
	# inventory-hotbar ticket that digit no longer means "buy": it means
	# "select", here as well as down on the strip, and SHIFT+it buys.
	hotkey.text = _hotbar_key_label(index)
	column.add_child(hotkey)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = SHOP_ICON_SIZE
	# Same reason _build_contract_checklist_row gives: without
	# EXPAND_IGNORE_SIZE a TextureRect's minimum size is the source PNG's own
	# 64x64, which would win over custom_minimum_size above.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for_asset(_shop_asset_for(kind))
	column.add_child(icon)

	var name_label := Label.new()
	name_label.name = "KindName"
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = base_settings
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.text = _kind_display_name(kind)
	column.add_child(name_label)

	var price_settings := LabelSettings.new()
	price_settings.font_size = base_settings.font_size
	price_settings.font_color = base_settings.font_color
	price_settings.outline_size = base_settings.outline_size
	price_settings.outline_color = base_settings.outline_color

	var price_label := Label.new()
	price_label.name = "Price"
	price_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	price_label.label_settings = price_settings
	price_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	column.add_child(price_label)

	var owned_settings := LabelSettings.new()
	owned_settings.font_size = base_settings.font_size - 2
	owned_settings.font_color = Color(0.66, 0.68, 0.72)
	owned_settings.outline_size = base_settings.outline_size
	owned_settings.outline_color = base_settings.outline_color

	var owned_label := Label.new()
	owned_label.name = "Owned"
	owned_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	owned_label.label_settings = owned_settings
	owned_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	owned_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(owned_label)

	_shop_slots.append({
		"kind": kind,
		"button": button,
		"icon": icon,
		"price_label": price_label,
		"owned_label": owned_label,
	})


## Flat-shaded slot squares with chunky borders — UI_UX.md §5's Minecraft
## adjacency, and deliberately the same near-black/hazard-yellow pair the
## rest of the HUD already uses rather than a third palette.
func _shop_slot_style(state: String) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.set_border_width_all(3)
	style.set_content_margin_all(6.0)
	match state:
		"hover", "focus":
			style.bg_color = Color(0.19, 0.19, 0.21, 0.98)
			style.border_color = Color(0.85, 0.63, 0.11, 0.95)
		"pressed":
			style.bg_color = Color(0.30, 0.24, 0.08, 0.98)
			style.border_color = Color(0.98, 0.80, 0.22, 1.0)
		"disabled":
			# Visibly recessed and dim: an unaffordable slot reads as "off"
			# from its border and background as well as its greyed icon and
			# its price glyph, never from colour alone (UI_UX.md §7).
			style.bg_color = Color(0.08, 0.08, 0.09, 0.92)
			style.border_color = Color(0.20, 0.21, 0.23, 0.95)
		_:
			style.bg_color = Color(0.13, 0.14, 0.16, 0.96)
			style.border_color = Color(0.36, 0.38, 0.42, 0.95)
	return style


## Which asset's icon stands for a buildable kind — see SHOP_MODELS.
func _shop_asset_for(kind: String) -> String:
	if SHOP_MODELS.has(kind):
		return SHOP_MODELS[kind]
	return MACHINE_MODELS.get(kind, MACHINE_MODEL_FALLBACK)


## "cooking_vat" -> "Cooking Vat". Kind ids are content, so the menu titles
## itself from them rather than carrying a hand-written label per kind that
## a new `data/shop.ron` entry would silently miss.
func _kind_display_name(kind: String) -> String:
	var words: PackedStringArray = kind.split("_", false)
	var out: Array[String] = []
	for word in words:
		out.append(word.capitalize())
	return " ".join(out)


## Repolls `shop_snapshot_json` and redraws every slot. Called each frame
## while the menu is open and once on opening — cheap (one JSON parse of a
## nine-entry object) and it means money earned by the running factory makes
## a slot become affordable under the player's eyes.
func _update_shop_menu() -> void:
	if _shop_menu == null:
		return
	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	_shop_money_label.text = "Money: %.0f" % float(snapshot.get("money", 0.0))
	_position_shop_menu()

	for index in range(_shop_slots.size()):
		if index >= entries.size():
			break
		var slot: Dictionary = _shop_slots[index]
		var entry: Dictionary = entries[index]
		var affordable: bool = bool(entry.get("affordable", false))
		var price: float = float(entry.get("price", 0.0))

		# Three independent signals for "you can't afford this", per
		# UI_UX.md §7's never-colour-alone rule: the price gains a "✗" mark,
		# the icon dims, and the whole slot is disabled (which also recolours
		# its border/background via the disabled stylebox).
		slot["price_label"].text = ("Cost %.0f" % price) if affordable else ("Cost %.0f  ✗" % price)
		slot["price_label"].label_settings.font_color = (
			Color(0.92, 0.93, 0.94) if affordable else Color(0.55, 0.50, 0.48)
		)
		slot["icon"].modulate = Color.WHITE if affordable else Color(0.42, 0.42, 0.45, 0.75)
		slot["button"].disabled = not affordable
		# The owned line carries the PLACE affordance, because that is the
		# line whose number decides whether placing is possible at all.
		var owned: int = int(entry.get("owned", 0))
		slot["owned_label"].text = ("Owned %d  ·  right-click to hold" % owned) if owned > 0 else "Owned 0"
		slot["owned_label"].label_settings.font_color = (
			Color(0.98, 0.85, 0.42) if owned > 0 else Color(0.66, 0.68, 0.72)
		)


func _on_shop_slot_pressed(index: int) -> void:
	_buy_slot(index)


## A slot has two actions, and they are on the two mouse buttons.
##
## **Left-click buys one; right-click places one you already own.** Both were
## weighed against the alternative of one button that changes meaning with
## the owned count — "click buys when you have none, places when you have
## some" — which is shorter to explain and worse to use: it makes buying a
## second of anything impossible without first placing the first, and it
## makes the same gesture do two different things depending on state the
## player has to remember. Two buttons, two meanings, both spelled out on the
## slot itself (the owned line says "right-click to place") and in the menu's
## footer. The keyboard mirrors it: number buys, SHIFT+number places.
func _on_shop_slot_gui_input(event: InputEvent, index: int) -> void:
	if not (event is InputEventMouseButton):
		return
	if event.button_index != MOUSE_BUTTON_RIGHT or not event.pressed:
		return
	# Consumed here so the isometric camera's right-drag pan never starts
	# under the menu.
	get_viewport().set_input_as_handled()
	_place_from_slot(index)


## Enters placement mode for a slot's kind, if the player owns one. A slot
## with nothing owned simply does nothing — the ghost would be unbuildable,
## and the slot already says "Owned 0".
func _place_from_slot(index: int) -> void:
	if index < 0 or index >= _shop_slots.size():
		return
	_refresh_owned_counts()
	_enter_build_mode(String(_shop_slots[index]["kind"]))


## Buys exactly one of the slot's kind. Quantity is deliberately fixed at
## one — `PlayerCommand::Purchase`'s own wire default — so a click means one
## thing and the menu needs no quantity widget. An unaffordable or unknown
## purchase is a silent no-op in the simulation, so the only thing this has
## to do afterwards is re-read the snapshot either way.
func _buy_slot(index: int) -> void:
	if index < 0 or index >= _shop_slots.size():
		return
	var kind: String = _shop_slots[index]["kind"]
	sim.issue_command_json(JSON.stringify({"type": "purchase", "kind": kind}))
	_refresh_owned_counts()
	_update_shop_menu()


func _set_shop_menu_open(open: bool) -> void:
	if _shop_menu == null or open == _shop_open:
		return
	_shop_open = open
	_shop_menu.visible = open
	if open:
		_update_shop_menu()
	# The menu is clickable in first-person too, which means handing the
	# mouse back while it is up and recapturing it on close — otherwise the
	# only way to buy in that mode would be the number keys.
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


## The crosshair stands in for the cursor in first-person — so it belongs on
## screen in exactly the case where there is no real cursor. With either shop
## panel up the mouse is handed back (above), and leaving the crosshair drawn
## would park a stray mark on top of a slot.
func _update_crosshair_visibility() -> void:
	if _crosshair == null:
		return
	_crosshair.visible = _view_mode == ViewMode.FIRST_PERSON and not _shop_open and not _market_open


func _toggle_shop_menu() -> void:
	_set_shop_menu_open(not _shop_open)


# --------------------------------------------------------------------------
# The ingredient market and the larder (the chain-rework epic)
# --------------------------------------------------------------------------

## Repolls `ingredients_snapshot_json`. Two things come off it: the stock
## counts the larder prints, and `hopper_items` — the list of ids a hopper
## may legally be placed holding, which is the simulation's own
## `World::raw_items` rather than anything decided here. A third raw
## ingredient therefore needs no Godot edit at all: it appears in the market,
## in the larder and in the hopper's Q cycle from the data file alone.
func _ingredients_snapshot() -> Dictionary:
	var parsed = JSON.parse_string(sim.ingredients_snapshot_json())
	return parsed if parsed is Dictionary else {}


## id -> owned count, from `_ingredients_snapshot`'s `entries` — the one
## lookup both fill-feedback checks below need, so it exists once.
func _owned_ingredient_counts() -> Dictionary:
	var owned := {}
	for entry in _ingredients_snapshot().get("entries", []):
		owned[String(entry.get("id", ""))] = int(entry.get("owned", 0))
	return owned


## Why pressing SPACE would do nothing, or "" if it would not. Checked
## BEFORE the command reaches the sim, so a doomed fill never fires at all
## and the player is told the actual missing thing rather than watching
## nothing happen — `issue_command`'s silent-no-op contract is correct for
## the SIMULATION (an impossible command changes nothing), but a game still
## owes the player a reason, the same way Factorio's own "not enough X"
## toasts do for exactly this kind of dead keypress.
func _hopper_fill_blocker() -> String:
	if _hopper_states.is_empty():
		return "No hopper placed — buy one in the build menu (E)"
	var owned := _owned_ingredient_counts()
	var needed := {}
	for snapshot in _hopper_states.values():
		needed[String(snapshot.get("item", ""))] = true
	for item in needed.keys():
		if owned.get(item, 0) > 0:
			return "" # at least one hopper can draw stock; let the sim sort out which
	var names: Array = []
	for item in needed.keys():
		names.append(_item_display_name(String(item)))
	return "No %s in stock — buy some at the Ingredient Market (M)" % ", ".join(names)


## `_hopper_fill_blocker`'s fluid twin for V. A tank not yet feeding any pipe
## run has no fluid id to check stock for at all (`_fluid_id_of` returns
## "") — that is a placement/plumbing problem the message above already
## covers ("no tank" is the closest true statement short of "not connected
## to anything," which is real but a separate, rarer failure this does not
## try to diagnose), so it is treated as nothing to block on here.
func _tank_fill_blocker() -> String:
	if _fluid_tank_states.is_empty():
		return "No fluid tank placed — buy one in the build menu (E)"
	var owned := _owned_ingredient_counts()
	var needed := {}
	for snapshot in _fluid_tank_states.values():
		var fluid := _fluid_id_of(snapshot)
		if fluid != "":
			needed[fluid] = true
	if needed.is_empty():
		return ""
	for item in needed.keys():
		if owned.get(item, 0) > 0:
			return ""
	var names: Array = []
	for item in needed.keys():
		names.append(_item_display_name(String(item)))
	return "No %s in stock — buy some at the Ingredient Market (M)" % ", ".join(names)


func _refresh_hopper_items() -> void:
	var snapshot := _ingredients_snapshot()
	var items: Array = snapshot.get("hopper_items", [])
	_hopper_items = items.duplicate()
	if _hopper_items.is_empty():
		_hopper_item_index = 0
	else:
		_hopper_item_index = clampi(_hopper_item_index, 0, _hopper_items.size() - 1)


## What the hopper currently being placed will hold, or "" when the kind in
## hand is not a hopper (or the world has no raw solids at all, which is a
## world with no recipes and cannot happen with shipped content).
func _selected_hopper_item() -> String:
	if _build_kind != HOPPER_KIND or _hopper_items.is_empty():
		return ""
	return String(_hopper_items[_hopper_item_index])


## **Q** while a hopper is in hand: the next raw ingredient in the cycle.
## Deliberately a cycle rather than a submenu — there are two ids today and
## a handful ever, and a modal list to pick between two things is more UI
## than the decision deserves. The name flyout announces the new choice, so
## the key is discoverable by pressing it.
func _cycle_hopper_item() -> void:
	if _build_kind != HOPPER_KIND or _hopper_items.size() < 2:
		return
	_hopper_item_index = (_hopper_item_index + 1) % _hopper_items.size()
	_update_ghost_fill()
	_show_hotbar_flyout("Hopper — %s" % _item_display_name(_selected_hopper_item()))


## `_cycle_hopper_item`'s twin for a hopper that is already on the floor,
## the same way `_rotate_under_cursor` is `_rotate_ghost`'s: without this, a
## hopper placed as tomato (or defaulted to it before a second raw item
## existed) had NO way to become a sugar hopper short of picking it up and
## placing a new one — and remembering to press Q *during* that brief
## placement window is not something a player who already has a hopper down
## has any reason to expect. `_issue_world_command` reruns `_refresh_buffers`
## as part of its normal per-command redraw, so the hopper's own hover
## tooltip already reads the new item on the next frame — no flyout needed,
## mirroring how a rotate-in-place gives no separate confirmation either.
func _cycle_hopper_under_cursor() -> void:
	var tile := _ghost_target_tile()
	if tile == HOVER_NO_TILE:
		return
	var placement := _placement_at_tile(tile)
	if placement.is_empty() or String(placement.get("kind", "")) != HOPPER_KIND:
		return
	# The sim already no-ops a cycle with fewer than two raw items, but
	# checking here too avoids a pointless round trip and world rebuild for
	# a keypress that can only ever do nothing — `_refresh_hopper_items` is
	# cheap (one JSON parse) and keeps `_hopper_items` current the same way
	# `_hopper_hover_text` already relies on it being.
	_refresh_hopper_items()
	if _hopper_items.size() < 2:
		return
	_issue_world_command({"type": "cycle_hopper_item", "tile": [tile.x, tile.y]})


## "tomato_paste" -> "Tomato Paste". Item ids are content, exactly as kind ids
## are, so this is `_kind_display_name`'s twin rather than a hand-written
## label table a new ingredient would silently miss.
func _item_display_name(item_id: String) -> String:
	return _kind_display_name(item_id)


## Builds the market panel. Same shape as `_build_shop_menu`, one row of
## slots instead of a grid — there are three ingredients and a row of three
## is shorter and no less readable than a grid of three would be.
func _build_ingredient_market(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = 4
	panel_style.border_width_left = 2
	panel_style.border_width_right = 2
	panel_style.border_width_bottom = 2
	panel_style.set_content_margin_all(16.0)

	# Cleared, never appended to: `_ready()` genuinely runs twice under the
	# headless `--script` harness (see `_rebuild_world`'s note and
	# test_hover.gd's header), and a second pass would otherwise leave the
	# array holding two slots per ingredient — half of them pointing at
	# buttons in an orphaned HUD layer.
	_market_slots.clear()

	_market_panel = PanelContainer.new()
	_market_panel.name = "IngredientMarket"
	_market_panel.add_theme_stylebox_override("panel", panel_style)
	_market_panel.visible = false
	hud.add_child(_market_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", 10)
	_market_panel.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = base_settings.font_size + 4
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "INGREDIENT MARKET"
	body.add_child(title)

	var money_settings := LabelSettings.new()
	money_settings.font_size = base_settings.font_size + 6
	money_settings.font_color = Color(0.98, 0.85, 0.42)
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_market_money_label = Label.new()
	_market_money_label.label_settings = money_settings
	body.add_child(_market_money_label)

	var row := HBoxContainer.new()
	row.name = "MarketRow"
	row.add_theme_constant_override("separation", 8)
	body.add_child(row)

	for entry in _ingredients_snapshot().get("entries", []):
		_build_market_slot(row, base_settings, _market_slots.size(), String(entry.get("id", "")))

	var footer := Label.new()
	footer.label_settings = base_settings
	footer.text = "click a crate to buy %d    then SPACE loads a hopper and V loads a tank    M/ESC: close" % MARKET_CRATE
	body.add_child(footer)

	_position_market_panel()


## Centred in the space above the hotbar, for `_position_shop_menu`'s reason
## and by the same arithmetic: a panel tall enough to reach the strip buries
## its own footer under it.
func _position_market_panel() -> void:
	if _market_panel == null:
		return
	_market_panel.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := HOTBAR_SLOT_SIZE.y * HOTBAR_SELECTED_SCALE + HOTBAR_BOTTOM_MARGIN * 3.0
	if _hotbar_root != null and _hotbar_root.size.y > 0.0:
		reserved = _hotbar_root.size.y + HOTBAR_BOTTOM_MARGIN * 2.0
	var bounds := vp.get_visible_rect().size
	var panel_size := _market_panel.get_combined_minimum_size()
	_market_panel.position.y = max(8.0, (bounds.y - reserved - panel_size.y) * 0.5)


func _build_market_slot(row: HBoxContainer, base_settings: LabelSettings, index: int, item_id: String) -> void:
	var button := Button.new()
	button.name = "MarketSlot_%s" % item_id
	button.custom_minimum_size = SHOP_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(state, _shop_slot_style(state))
	button.pressed.connect(_buy_ingredient_slot.bind(index))
	row.add_child(button)

	var column := VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	column.add_theme_constant_override("separation", 2)
	column.set_anchors_preset(Control.PRESET_FULL_RECT)
	column.offset_left = 8
	column.offset_right = -8
	column.offset_top = 8
	column.offset_bottom = -8
	button.add_child(column)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = SHOP_ICON_SIZE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	# The item's OWN model, through the same ITEM_MODELS table the belt draws
	# with — so a crate of tomatoes in the market is the tomato that runs
	# down the line, which is UI_UX.md §5's "icons are rendered from the real
	# assets" rule doing its job. A fluid has no item model and falls through
	# to the pipe, which is what it arrives in.
	icon.texture = _icon_for_asset(_market_asset_for(item_id))
	column.add_child(icon)

	var name_label := Label.new()
	name_label.name = "ItemName"
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = base_settings
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.text = _item_display_name(item_id)
	column.add_child(name_label)

	var price_settings := LabelSettings.new()
	price_settings.font_size = base_settings.font_size
	price_settings.font_color = base_settings.font_color
	price_settings.outline_size = base_settings.outline_size
	price_settings.outline_color = base_settings.outline_color

	var price_label := Label.new()
	price_label.name = "Price"
	price_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	price_label.label_settings = price_settings
	price_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	price_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(price_label)

	var owned_settings := LabelSettings.new()
	owned_settings.font_size = base_settings.font_size - 2
	owned_settings.font_color = Color(0.66, 0.68, 0.72)
	owned_settings.outline_size = base_settings.outline_size
	owned_settings.outline_color = base_settings.outline_color

	var owned_label := Label.new()
	owned_label.name = "Stock"
	owned_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	owned_label.label_settings = owned_settings
	owned_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	owned_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(owned_label)

	_market_slots.append({
		"id": item_id,
		"button": button,
		"icon": icon,
		"price_label": price_label,
		"owned_label": owned_label,
	})


## Which voxel model's icon stands for an ingredient. `ITEM_MODELS` for a
## solid; a fluid has no item model at all, so it borrows the pipe it
## travels in — which is also how the player will actually handle it.
func _market_asset_for(item_id: String) -> String:
	if ITEM_MODELS.has(item_id):
		return ITEM_MODELS[item_id]
	return PIPE_ASSET


func _update_ingredient_market() -> void:
	if _market_panel == null:
		return
	var snapshot := _ingredients_snapshot()
	var entries: Array = snapshot.get("entries", [])
	_market_money_label.text = "Money: %.0f" % float(snapshot.get("money", 0.0))
	_position_market_panel()

	for index in range(_market_slots.size()):
		if index >= entries.size():
			break
		var slot: Dictionary = _market_slots[index]
		var entry: Dictionary = entries[index]
		var unit_price: float = float(entry.get("price", 0.0))
		var crate_price := unit_price * float(MARKET_CRATE)
		var affordable: bool = float(snapshot.get("money", 0.0)) >= crate_price
		# The three never-colour-alone signals the build menu already uses:
		# a "✗" on the price, a dimmed icon, and a disabled (recessed) slot.
		slot["price_label"].text = "Buy %d  ·  %.0f" % [MARKET_CRATE, crate_price]
		if not affordable:
			slot["price_label"].text += "  ✗"
		slot["price_label"].label_settings.font_color = (
			Color(0.92, 0.93, 0.94) if affordable else Color(0.55, 0.50, 0.48)
		)
		slot["icon"].modulate = Color.WHITE if affordable else Color(0.42, 0.42, 0.45, 0.75)
		slot["button"].disabled = not affordable
		slot["owned_label"].text = "In stock %d  ·  %.0f each" % [int(entry.get("owned", 0)), unit_price]


## Buys one crate. An unaffordable or unknown purchase is a silent no-op in
## the simulation (`BuyIngredient`, like `Purchase`), so the only thing to do
## afterwards is re-read either way.
func _buy_ingredient_slot(index: int) -> void:
	if index < 0 or index >= _market_slots.size():
		return
	sim.issue_command_json(JSON.stringify({
		"type": "buy_ingredient",
		"item": String(_market_slots[index]["id"]),
		"quantity": MARKET_CRATE,
	}))
	_update_ingredient_market()


func _set_market_open(open: bool) -> void:
	if _market_panel == null or open == _market_open:
		return
	_market_open = open
	_market_panel.visible = open
	if open:
		_update_ingredient_market()
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


func _toggle_market() -> void:
	_set_market_open(not _market_open)


## The larder strip: one chip per raw ingredient, above the hotbar. Built
## from the same snapshot the market sells from, so it lists whatever
## `data/ingredients.ron` prices with no list of its own.
func _build_larder(parent: VBoxContainer, base_settings: LabelSettings) -> void:
	var plate := StyleBoxFlat.new()
	plate.bg_color = Color(0.06, 0.06, 0.07, 0.93)
	plate.border_color = Color(0.85, 0.63, 0.11, 0.95)
	plate.border_width_top = 2
	plate.set_content_margin_all(6.0)

	_larder_entries.clear() # `_ready` runs twice headlessly — see `_build_ingredient_market`

	_larder_panel = PanelContainer.new()
	_larder_panel.name = "Larder"
	_larder_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_larder_panel.add_theme_stylebox_override("panel", plate)
	parent.add_child(_larder_panel)

	_larder_row = HBoxContainer.new()
	_larder_row.name = "LarderRow"
	_larder_row.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_larder_row.add_theme_constant_override("separation", 14)
	_larder_panel.add_child(_larder_row)

	var label_settings := LabelSettings.new()
	label_settings.font_size = base_settings.font_size - 1
	label_settings.font_color = Color(0.92, 0.93, 0.94)
	label_settings.outline_size = base_settings.outline_size
	label_settings.outline_color = base_settings.outline_color

	for entry in _ingredients_snapshot().get("entries", []):
		var item_id := String(entry.get("id", ""))
		var chip := HBoxContainer.new()
		chip.mouse_filter = Control.MOUSE_FILTER_IGNORE
		chip.add_theme_constant_override("separation", 5)
		_larder_row.add_child(chip)

		var icon := TextureRect.new()
		icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
		icon.custom_minimum_size = Vector2(20, 20)
		icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		icon.texture = _icon_for_asset(_market_asset_for(item_id))
		chip.add_child(icon)

		var count := Label.new()
		count.name = "Larder_%s" % item_id
		count.mouse_filter = Control.MOUSE_FILTER_IGNORE
		count.label_settings = label_settings
		chip.add_child(count)
		_larder_entries[item_id] = count

	var hint_settings := LabelSettings.new()
	hint_settings.font_size = base_settings.font_size - 2
	hint_settings.font_color = Color(0.66, 0.68, 0.72)
	hint_settings.outline_size = base_settings.outline_size
	hint_settings.outline_color = base_settings.outline_color

	_larder_hint = Label.new()
	_larder_hint.name = "LarderHint"
	_larder_hint.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_larder_hint.label_settings = hint_settings
	_larder_hint.text = "M: market"
	_larder_row.add_child(_larder_hint)


## Repolled every frame, like the hotbar beside it: a stock count that moved
## because a hopper was loaded has to move here in the same frame, or the one
## number that explains why SPACE did nothing is stale exactly when it
## matters.
func _update_larder() -> void:
	if _larder_entries.is_empty():
		return
	for entry in _ingredients_snapshot().get("entries", []):
		var item_id := String(entry.get("id", ""))
		if not _larder_entries.has(item_id):
			continue
		var owned := int(entry.get("owned", 0))
		var label: Label = _larder_entries[item_id]
		label.text = "%d" % owned
		# Out of stock is a real state with a consequence (SPACE and V will
		# do nothing), so it is called out in words rather than left as a
		# grey zero — colour alone would not carry it (UI_UX.md §7).
		if owned == 0:
			label.text = "none"
		label.label_settings.font_color = (
			Color(0.92, 0.93, 0.94) if owned > 0 else Color(0.90, 0.52, 0.42)
		)


# --------------------------------------------------------------------------
# The hotbar (UI_UX.md §5, the inventory-hotbar ticket)
# --------------------------------------------------------------------------

## Builds the always-visible quick-select strip. See `_hotbar_panel`'s doc
## for the three layout decisions; this is where they are made concrete.
##
## VISUAL LANGUAGE. The scene's DARK PLATE with a hazard-yellow rule — the
## same one the HUD strip, the hover tooltip and the build menu already use,
## and deliberately not the contract clipboard's paper. UI_UX.md §5 draws
## that line explicitly (paper is for orders and checklists); a hotbar is
## machine-side factory UI, and this is the third widget in that family
## rather than a third visual language.
##
## WHAT WAS TAKEN FROM WHERE, since the point was to bring in the patterns
## players actually praise rather than to draw a grid:
##
##   * **Minecraft** — fixed slots with a selector that is *bigger than the
##     slot*, so "what is in my hand" is answerable from peripheral vision;
##     a stack count in the corner; and the item name flying out above the
##     bar on every switch, then fading. All three are here.
##   * **Terraria** — hover gives an item a framed spec sheet, not a bare
##     name. `_hotbar_tooltip` is that, in this game's plate styling, and it
##     is where the price and the two verbs live.
##   * **Factorio's quickbar** — a slot you have none of stays exactly where
##     it was, visible and dimmed, rather than vanishing or renumbering the
##     bar. That is what makes the keys muscle memory.
func _build_hotbar(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	_hotbar_styles = {
		"empty": _hotbar_slot_style("empty"),
		"stocked": _hotbar_slot_style("stocked"),
		"selected": _hotbar_slot_style("selected"),
	}

	_hotbar_root = VBoxContainer.new()
	_hotbar_root.name = "HotbarRoot"
	# IGNORE, not STOP: the strip is a wide band across the bottom of the
	# screen, and a plate that swallowed clicks would make the floor tiles
	# behind it unbuildable. Only the slot buttons themselves take the mouse.
	_hotbar_root.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_root.alignment = BoxContainer.ALIGNMENT_CENTER
	_hotbar_root.add_theme_constant_override("separation", 6)
	hud.add_child(_hotbar_root)

	# The larder sits at the TOP of the strip's column, above the name
	# flyout: the flyout has to stay directly over the slots it names, and
	# the larder is a standing readout rather than something that appears.
	_build_larder(_hotbar_root, base_settings)

	var flyout_settings := LabelSettings.new()
	flyout_settings.font_size = base_settings.font_size + 3
	flyout_settings.font_color = Color(0.98, 0.85, 0.42) # the plate's hazard accent
	flyout_settings.outline_size = base_settings.outline_size + 2
	flyout_settings.outline_color = Color(0, 0, 0, 0.9)

	_hotbar_flyout = Label.new()
	_hotbar_flyout.name = "HotbarFlyout"
	_hotbar_flyout.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_flyout.label_settings = flyout_settings
	_hotbar_flyout.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	_hotbar_flyout.modulate = Color(1, 1, 1, 0)
	_hotbar_root.add_child(_hotbar_flyout)

	# Nearly opaque, like the build menu's own plate rather than the help
	# strip's lighter one: at 0.80 the floor's diamond tiling showed through
	# the gaps between sockets and turned the strip into visual noise, which
	# a rendered frame made obvious and the code never would.
	var plate := StyleBoxFlat.new()
	plate.bg_color = Color(0.06, 0.06, 0.07, 0.93)
	plate.border_color = Color(0.85, 0.63, 0.11, 0.95)
	plate.border_width_top = 3
	plate.set_content_margin_all(10.0)

	_hotbar_panel = PanelContainer.new()
	_hotbar_panel.name = "Hotbar"
	_hotbar_panel.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_panel.add_theme_stylebox_override("panel", plate)
	_hotbar_root.add_child(_hotbar_panel)

	var strip := HBoxContainer.new()
	strip.name = "HotbarSlots"
	strip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	# Wide enough that a selected slot at HOTBAR_SELECTED_SCALE never laps
	# its neighbours: 64 * 0.13 is ~8px of growth, ~4 to each side.
	strip.add_theme_constant_override("separation", 9)
	_hotbar_panel.add_child(strip)

	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", []) if snapshot is Dictionary else []
	for index in range(entries.size()):
		_build_hotbar_slot(strip, base_settings, index, String(entries[index]["kind"]))

	_build_hotbar_tooltip(hud, base_settings)
	_position_hotbar()
	_update_hotbar()


## One socket. A Button, like a build-menu slot, so pressing it is the whole
## interaction; its label children ignore the mouse so the whole square stays
## one target.
func _build_hotbar_slot(strip: HBoxContainer, base_settings: LabelSettings, index: int, kind: String) -> void:
	var button := Button.new()
	button.name = "HotbarSlot_%s" % kind
	button.custom_minimum_size = HOTBAR_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	# The pop scales about the slot's own centre; without this it would grow
	# from the top-left corner and shove itself off the strip.
	button.pivot_offset = HOTBAR_SLOT_SIZE / 2.0
	button.pressed.connect(_on_hotbar_slot_pressed.bind(index))
	button.mouse_entered.connect(_on_hotbar_slot_hovered.bind(index))
	button.mouse_exited.connect(_on_hotbar_slot_unhovered.bind(index))
	strip.add_child(button)

	# Anchored over the button rather than parented through a container, for
	# the reason `_build_shop_slot` gives: a Button is not a container.
	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.set_anchors_preset(Control.PRESET_FULL_RECT)
	icon.offset_left = HOTBAR_ICON_INSET
	icon.offset_right = -HOTBAR_ICON_INSET
	icon.offset_top = HOTBAR_ICON_INSET
	icon.offset_bottom = -HOTBAR_ICON_INSET
	icon.texture = _icon_for_asset(_shop_asset_for(kind))
	button.add_child(icon)

	# The key digit, top-left. Printed on the slot rather than left to the
	# legend: the whole claim of a hotbar is that the key is obvious.
	var key_settings := LabelSettings.new()
	key_settings.font_size = base_settings.font_size - 4
	key_settings.font_color = Color(0.62, 0.64, 0.68)
	key_settings.outline_size = base_settings.outline_size
	key_settings.outline_color = base_settings.outline_color

	var key_label := Label.new()
	key_label.name = "Key"
	key_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	key_label.label_settings = key_settings
	key_label.text = _hotbar_key_label(index)
	key_label.position = Vector2(5, 1)
	button.add_child(key_label)

	# The stack count, bottom-right, in Minecraft's own corner. Hazard-yellow
	# with a heavy outline so it reads over any icon behind it.
	var count_settings := LabelSettings.new()
	count_settings.font_size = base_settings.font_size - 1
	count_settings.font_color = Color(0.98, 0.85, 0.42)
	count_settings.outline_size = base_settings.outline_size + 1
	count_settings.outline_color = Color(0, 0, 0, 0.92)

	var count_label := Label.new()
	count_label.name = "Count"
	count_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	count_label.label_settings = count_settings
	count_label.set_anchors_preset(Control.PRESET_FULL_RECT)
	count_label.offset_right = -5
	count_label.offset_bottom = -2
	count_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	count_label.vertical_alignment = VERTICAL_ALIGNMENT_BOTTOM
	button.add_child(count_label)

	# The selection caret, top-centre. UI_UX.md §7: the selected state is
	# never colour alone — it is a bigger slot, a hazard-yellow frame, a
	# brightened key digit AND this glyph.
	var mark_settings := LabelSettings.new()
	mark_settings.font_size = base_settings.font_size - 3
	mark_settings.font_color = Color(1.0, 0.90, 0.50)
	mark_settings.outline_size = base_settings.outline_size
	mark_settings.outline_color = base_settings.outline_color

	var mark := Label.new()
	mark.name = "SelectMark"
	mark.mouse_filter = Control.MOUSE_FILTER_IGNORE
	mark.label_settings = mark_settings
	mark.text = "\u25bc"
	mark.visible = false
	mark.set_anchors_preset(Control.PRESET_FULL_RECT)
	mark.offset_top = -1
	mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	mark.vertical_alignment = VERTICAL_ALIGNMENT_TOP
	button.add_child(mark)

	_hotbar_slots.append({
		"kind": kind,
		"button": button,
		"icon": icon,
		"key_label": key_label,
		"count_label": count_label,
		"mark": mark,
		"state": "",
	})


## Chunky flat sockets (UI_UX.md §5's Minecraft adjacency) in the same
## near-black/hazard-yellow pair the rest of the HUD uses.
##
##   * `empty`    — recessed and dim: the player is carrying none of this.
##   * `stocked`  — a normal socket with something in it.
##   * `selected` — the hazard-yellow frame, thicker and brighter than any
##                  other border in the HUD, because this is the one piece of
##                  state the player checks most often.
func _hotbar_slot_style(state: String) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.set_border_width_all(3)
	style.set_corner_radius_all(2)
	match state:
		"selected":
			style.bg_color = Color(0.30, 0.24, 0.08, 0.98)
			style.border_color = Color(1.0, 0.83, 0.24, 1.0)
			style.set_border_width_all(4)
		"stocked":
			style.bg_color = Color(0.13, 0.14, 0.16, 0.96)
			style.border_color = Color(0.42, 0.44, 0.48, 0.95)
		_:
			style.bg_color = Color(0.08, 0.08, 0.09, 0.88)
			style.border_color = Color(0.21, 0.22, 0.24, 0.92)
	return style


## "1".."9", "0" for the first ten slots; "" past them (see
## SHOP_HOTKEY_SLOTS). The build menu prints the same string in its own
## slot corners, so the two views cannot disagree about which key is which.
func _hotbar_key_label(index: int) -> String:
	if index < 0 or index >= SHOP_HOTKEY_SLOTS:
		return ""
	return str((index + 1) % 10)


## Which slot a keycode selects, or -1 for a key that is not a hotbar key.
func _hotbar_index_for_keycode(keycode: int) -> int:
	var at := HOTBAR_KEYCODES.find(keycode)
	return at if at < _hotbar_slots.size() else -1


## THE ticket's behaviour change: a key (or a click) SELECTS a slot, and
## selecting is entering placement mode for that kind. Pressing the selected
## slot again puts it down, exactly as ESC already does — a hotbar key is a
## toggle in every game this borrows from.
##
## Buying is deliberately NOT here. Selecting what is in your hand and
## acquiring more of it are different verbs and stay on different actions:
## buying lives in the build menu (**E**), on a slot's left click, with
## SHIFT+number as its keyboard mirror. Collapsing them would mean a key that
## sometimes spends money, which is the one thing a player must never do by
## accident.
func _select_hotbar_slot(index: int) -> void:
	if index < 0 or index >= _hotbar_slots.size():
		return
	var kind: String = String(_hotbar_slots[index]["kind"])
	_pulse_hotbar_slot(index)
	_refresh_owned_counts()
	if _build_kind == kind:
		_exit_build_mode()
		_update_hotbar()
		return
	# `_enter_build_mode` refuses a kind the player owns none of — an empty
	# socket therefore does nothing, which is what the socket already looks
	# like. Say so in the flyout rather than leaving the keypress silent.
	_enter_build_mode(kind)
	if _build_kind != kind:
		_show_hotbar_flyout("%s — none carried" % _kind_display_name(kind))
	_update_hotbar()


func _on_hotbar_slot_pressed(index: int) -> void:
	_select_hotbar_slot(index)


## The click pulse: the slot dips and springs back. Purely visual, ~100ms,
## and it is what makes a click feel like it landed on something physical
## rather than toggling a boolean.
func _pulse_hotbar_slot(index: int) -> void:
	if index < 0 or index >= _hotbar_slots.size():
		return
	var button: Button = _hotbar_slots[index]["button"]
	if not button.is_inside_tree():
		return
	var target := Vector2.ONE * (HOTBAR_SELECTED_SCALE if _hotbar_selected_index() == index else 1.0)
	button.scale = Vector2.ONE * HOTBAR_PRESS_SCALE
	var tween := button.create_tween()
	tween.tween_property(button, "scale", target, HOTBAR_POP_SECONDS)\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


## Which slot is currently in the player's hand, or -1. Derived from
## `_build_kind` rather than stored, so the strip can never disagree with the
## ghost — ESC, E and running out of a kind all leave build mode without
## going through this file.
func _hotbar_selected_index() -> int:
	if _build_kind == "":
		return -1
	for index in range(_hotbar_slots.size()):
		if String(_hotbar_slots[index]["kind"]) == _build_kind:
			return index
	return -1


## Repolls `shop_snapshot_json` and redraws the strip. Called every frame:
## the strip is always on screen, so a count that moved because a belt was
## placed, removed or bought has to move here in the same frame. One parse of
## an eleven-entry object per frame is the same cost the contract clipboard
## already pays, and it is what keeps the hotbar honest with no push channel.
func _update_hotbar() -> void:
	if _hotbar_slots.is_empty():
		return
	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", []) if snapshot is Dictionary else []
	var selected := _hotbar_selected_index()

	for index in range(_hotbar_slots.size()):
		if index < entries.size():
			# The strip already parses the one snapshot `_refresh_owned_counts`
			# would, every frame — so it keeps that cache current rather than
			# making the next caller parse the same object again.
			_owned_counts[String(entries[index].get("kind", ""))] = int(entries[index].get("owned", 0))
	for index in range(_hotbar_slots.size()):
		var slot: Dictionary = _hotbar_slots[index]
		var owned := 0
		var price := 0.0
		if index < entries.size():
			owned = int(entries[index].get("owned", 0))
			price = float(entries[index].get("price", 0.0))
		var state := "selected" if index == selected else ("stocked" if owned > 0 else "empty")
		if String(slot["state"]) != state:
			slot["state"] = state
			_apply_hotbar_slot_state(slot, state, index == selected)

		# An empty socket shows no number at all — Minecraft shows an empty
		# slot as empty, not as a slot reading zero.
		slot["count_label"].text = str(owned) if owned > 0 else ""
		slot["icon"].modulate = Color.WHITE if owned > 0 else Color(1, 1, 1, 0.22)
		if _hotbar_tooltip_index == index:
			_fill_hotbar_tooltip(index, owned, price)

	_update_hotbar_flyout()
	_position_hotbar()


## Everything about a slot's appearance that is not per-frame data: the
## socket style, the caret, the key digit's brightness, and the pop.
func _apply_hotbar_slot_state(slot: Dictionary, state: String, selected: bool) -> void:
	var button: Button = slot["button"]
	var style: StyleBoxFlat = _hotbar_styles[state]
	for name in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(name, style)
	slot["mark"].visible = selected
	slot["key_label"].label_settings.font_color = (
		Color(1.0, 0.90, 0.50) if selected else Color(0.62, 0.64, 0.68)
	)
	# Selected slots draw over their neighbours, since they are bigger.
	button.z_index = 1 if selected else 0
	var target := Vector2.ONE * (HOTBAR_SELECTED_SCALE if selected else 1.0)
	if not button.is_inside_tree():
		button.scale = target
		return
	var tween := button.create_tween()
	tween.tween_property(button, "scale", target, HOTBAR_POP_SECONDS)\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)


## The name flyout — shown for HOTBAR_FLYOUT_HOLD_MSEC then faded out over
## HOTBAR_FLYOUT_FADE_MSEC. Hand-timed off `Time.get_ticks_msec` rather than
## tweened, because a tween would have to be cancelled and rebuilt on every
## rapid slot switch, and because this way the fade is a pure function of the
## clock — which is also what makes it checkable headlessly.
func _show_hotbar_flyout(text: String) -> void:
	if _hotbar_flyout == null:
		return
	_hotbar_flyout.text = text
	_hotbar_flyout_until_msec = Time.get_ticks_msec() + HOTBAR_FLYOUT_HOLD_MSEC
	_hotbar_flyout.modulate = Color(1, 1, 1, 1)


func _update_hotbar_flyout() -> void:
	if _hotbar_flyout == null:
		return
	var remaining := _hotbar_flyout_until_msec - Time.get_ticks_msec()
	if remaining >= 0:
		_hotbar_flyout.modulate = Color(1, 1, 1, 1)
	elif remaining > -HOTBAR_FLYOUT_FADE_MSEC:
		_hotbar_flyout.modulate = Color(1, 1, 1, 1.0 + float(remaining) / float(HOTBAR_FLYOUT_FADE_MSEC))
	else:
		_hotbar_flyout.modulate = Color(1, 1, 1, 0)


## Re-anchors the strip to the bottom centre. Re-applied on every update for
## the same reason `_update_contract_panel` re-applies its own preset: a
## MINSIZE preset is computed from the content, and the content's size only
## settles once its labels have text in them.
func _position_hotbar() -> void:
	if _hotbar_root == null:
		return
	_hotbar_root.set_anchors_and_offsets_preset(
		Control.PRESET_CENTER_BOTTOM, Control.PRESET_MODE_MINSIZE, HOTBAR_BOTTOM_MARGIN
	)


## Terraria's framed hover panel, in this scene's plate styling: the kind's
## name, what the player is carrying, the unit price, and — the part this
## ticket actually needs — the two verbs, so "number selects, the build menu
## buys" is discoverable without reading source.
func _build_hotbar_tooltip(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.10, 0.09, 0.06, 0.96)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.set_border_width_all(2)
	style.set_content_margin_all(9.0)

	_hotbar_tooltip = PanelContainer.new()
	_hotbar_tooltip.name = "HotbarTooltip"
	_hotbar_tooltip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_tooltip.add_theme_stylebox_override("panel", style)
	_hotbar_tooltip.visible = false
	hud.add_child(_hotbar_tooltip)

	var rows := VBoxContainer.new()
	rows.mouse_filter = Control.MOUSE_FILTER_IGNORE
	rows.add_theme_constant_override("separation", 3)
	_hotbar_tooltip.add_child(rows)

	var name_settings := LabelSettings.new()
	name_settings.font_size = base_settings.font_size + 2
	name_settings.font_color = Color(0.98, 0.85, 0.42)
	name_settings.outline_size = base_settings.outline_size
	name_settings.outline_color = base_settings.outline_color

	_hotbar_tooltip_name = Label.new()
	_hotbar_tooltip_name.name = "TooltipName"
	_hotbar_tooltip_name.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_tooltip_name.label_settings = name_settings
	rows.add_child(_hotbar_tooltip_name)

	_hotbar_tooltip_body = Label.new()
	_hotbar_tooltip_body.name = "TooltipBody"
	_hotbar_tooltip_body.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hotbar_tooltip_body.label_settings = base_settings
	rows.add_child(_hotbar_tooltip_body)


func _on_hotbar_slot_hovered(index: int) -> void:
	_hotbar_tooltip_index = index
	var owned := _owned_of(String(_hotbar_slots[index]["kind"]))
	_fill_hotbar_tooltip(index, owned, _hotbar_price_of(index))
	if _hotbar_tooltip != null:
		_hotbar_tooltip.visible = true
		_position_hotbar_tooltip(index)


func _on_hotbar_slot_unhovered(index: int) -> void:
	if _hotbar_tooltip_index != index:
		return
	_hotbar_tooltip_index = -1
	if _hotbar_tooltip != null:
		_hotbar_tooltip.visible = false


func _hotbar_price_of(index: int) -> float:
	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	if not (snapshot is Dictionary):
		return 0.0
	var entries: Array = snapshot.get("entries", [])
	if index < 0 or index >= entries.size():
		return 0.0
	return float(entries[index].get("price", 0.0))


func _fill_hotbar_tooltip(index: int, owned: int, price: float) -> void:
	if _hotbar_tooltip_name == null or index < 0 or index >= _hotbar_slots.size():
		return
	var kind: String = String(_hotbar_slots[index]["kind"])
	_hotbar_tooltip_name.text = _kind_display_name(kind)
	var key := _hotbar_key_label(index)
	var select_line := ("press %s to select" % key) if key != "" else "click to select"
	_hotbar_tooltip_body.text = "%s    ·    %.0f each\n%s    ·    buy in the build menu (E)" % [
		("carrying %d" % owned) if owned > 0 else "carrying none",
		price,
		select_line,
	]


## Above the slot it belongs to, clamped on screen — the strip is at the
## bottom edge, so a tooltip has to grow upward or it would be off-screen.
func _position_hotbar_tooltip(index: int) -> void:
	if _hotbar_tooltip == null or index < 0 or index >= _hotbar_slots.size():
		return
	var button: Button = _hotbar_slots[index]["button"]
	var size := _hotbar_tooltip.get_combined_minimum_size()
	var anchor := button.global_position + Vector2(button.size.x / 2.0, 0.0)
	var pos := anchor - Vector2(size.x / 2.0, size.y + 14.0)
	var vp := get_viewport()
	if vp != null:
		var bounds := vp.get_visible_rect().size
		pos.x = clamp(pos.x, 8.0, max(8.0, bounds.x - size.x - 8.0))
		pos.y = clamp(pos.y, 8.0, max(8.0, bounds.y - size.y - 8.0))
	_hotbar_tooltip.position = pos
	_hotbar_tooltip.size = size



# --------------------------------------------------------------------------
# Build mode: the ghost, and what the next click will do
# (the "Real Placement" epic's ticket 2)
# --------------------------------------------------------------------------

## How the ghost reads. Two independent signals per state, never colour
## alone (UI_UX.md §7): the translucent model is tinted, AND the prompt beside
## the cursor spells the state out with a glyph and a word. A player who
## cannot tell the green from the red still reads "✔ PLACE" or "✗ BLOCKED".
const GHOST_TINT_VALID := Color(0.55, 2.20, 0.75, 0.62)
const GHOST_TINT_INVALID := Color(2.40, 0.45, 0.35, 0.62)
## Remove mode tints the thing that would be picked up, in the same red as an
## invalid placement — red is "this click destroys or refuses", and the prompt
## says which. There is no green case: removing is either possible or there is
## nothing there, and "nothing there" shows no ghost at all.
const GHOST_TINT_REMOVE := Color(2.40, 0.45, 0.35, 0.68)


## The 3D node the ghost lives under, and the material it is drawn with.
## Separate from "World" so a rebuild of the world never disturbs the ghost
## the player is currently aiming.
func _build_ghost_layer() -> void:
	var existing := get_node_or_null("Ghost")
	if existing != null:
		remove_child(existing)
		existing.free()
	_ghost_root = Node3D.new()
	_ghost_root.name = "Ghost"
	_ghost_root.visible = false
	add_child(_ghost_root)
	_ghost_asset = ""


## A translucent, unshaded, TINTED copy of the asset. Three deliberate parts.
##
## Unshaded, because a ghost lit like the real building reads as a real
## building that has already been placed, and the whole job of this node is to
## say "not yet". Translucent for the same reason.
##
## And the tint MULTIPLIES over the model's own vertex colours rather than
## replacing them (`vertex_color_use_as_albedo`), which is what keeps the
## ghost a recognisable silhouette instead of a flat slab — the first cut
## replaced them and a rendered frame showed a belt ghost as a featureless
## green rectangle, telling the player a tile was involved but not which
## thing. The tint is deliberately pale so the model's dark voxels still come
## through as clearly tinted rather than as black.
func _ghost_material(tint: Color) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	mat.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.albedo_color = tint
	mat.cull_mode = BaseMaterial3D.CULL_DISABLED
	return mat


## Enters placement mode for `kind`. Refuses a kind the player owns none of
## rather than showing a ghost that could never be built — the build menu
## only offers this on an owned slot, and this is the second half of that
## rule so a hotkey cannot get round it.
func _enter_build_mode(kind: String) -> void:
	if _owned_of(kind) <= 0:
		return
	_remove_mode = false
	_build_kind = kind
	_build_direction = "east"
	_set_shop_menu_open(false)
	_set_market_open(false)
	# A hopper carries a choice as well as a facing, so the legal choices are
	# repolled on entry (the list is the simulation's, and content can change
	# it) and the previous pick is kept where it is still legal — a player
	# laying two sugar hoppers should not have to press Q twice.
	_refresh_hopper_items()
	# The name flyout fires here rather than in `_select_hotbar_slot`, so
	# every route into placement mode announces what is now in hand — the
	# hotbar key, a hotbar click, and the build menu's right-click alike.
	var held := "%s  ×%d" % [_kind_display_name(kind), _owned_of(kind)]
	if kind == HOPPER_KIND and _selected_hopper_item() != "":
		held = "Hopper — %s  ×%d" % [_item_display_name(_selected_hopper_item()), _owned_of(kind)]
	_show_hotbar_flyout(held)
	_rebuild_ghost_body()
	_update_ghost()
	_update_hotbar()


## Remove mode is a MODE, not a modifier-click, and that is deliberate: it is
## the one destructive action in the game (what a removed thing was holding is
## destroyed — see `PlayerCommand::Remove`), and a mode announces itself in
## the legend and in the on-screen prompt, where a held modifier cannot.
func _toggle_remove_mode() -> void:
	if _remove_mode:
		_exit_build_mode()
		return
	_build_kind = ""
	_remove_mode = true
	_set_shop_menu_open(false)
	_rebuild_ghost_body()
	_update_ghost()
	# Remove mode replaces placement mode, so the strip has nothing selected
	# any more — and the highlight has to go with it, or the hotbar would
	# claim the player is holding something while the ghost says they are
	# about to destroy something.
	_update_hotbar()


## Leaves whichever of the two modes is active, with no dangling state: the
## ghost's own body is freed, not just hidden, so the next entry starts clean.
func _exit_build_mode() -> void:
	_build_kind = ""
	_remove_mode = false
	_ghost_reason = ""
	_ghost_valid = false
	_clear_ghost_body()
	if _ghost_root != null:
		_ghost_root.visible = false
	if _placement_prompt != null:
		_placement_prompt.visible = false
	# The strip's selection is derived from `_build_kind`, so leaving build
	# mode by ANY route (ESC, E, X, running out of a kind) clears the
	# highlight without that route having to know the hotbar exists.
	_update_hotbar()


## ESC's universal "close whatever is open". The scene has exactly three
## pieces of stateful UI a player can leave standing — the build menu
## (`_shop_open`), placement mode (`_build_kind`) and remove mode
## (`_remove_mode`) — and one press clears all three from any combination of
## them, which is what every builder this game borrows from does.
##
## It is a separate function rather than a line added to `_exit_build_mode`
## on purpose: that function's other callers must NOT close the menu.
## `_select_hotbar_slot` calls it to put down the kind in hand, and the
## number keys are documented to work with the menu open or closed — a
## deselect that also swept the menu away would break that. Same for
## `_confirm_build`'s "you placed your last one" exit. So ESC gets the wider
## verb and everything else keeps the narrow one.
##
## Nothing else here is a mode: the hover tooltip and the hotbar tooltip are
## driven by where the cursor is, and the name flyout fades on its own timer.
func _close_all_overlays() -> void:
	_set_shop_menu_open(false)
	_set_market_open(false)
	_exit_build_mode()


func _in_build_mode() -> bool:
	return _build_kind != "" or _remove_mode


## Cycles the ghost's facing one quarter turn CLOCKWISE — the same single
## rotation the simulation offers (`Direction::rotate_cw`), so the ghost and
## `PlayerCommand::Rotate` can never disagree about which way "rotate" goes.
func _rotate_ghost() -> void:
	_build_direction = DIRECTIONS[(_direction_index(_build_direction) + 1) % DIRECTIONS.size()]
	_rebuild_ghost_body()
	_update_ghost()


## **R** outside placement mode: turns whatever is under the cursor where it
## stands. No pick-up-and-re-place round trip, which is what a player coming
## from any other builder expects, and it is free — `PlayerCommand::Rotate`
## resolves from any tile of a footprint and keeps the thing's contents.
func _rotate_under_cursor() -> void:
	var tile := _ghost_target_tile()
	if tile == HOVER_NO_TILE:
		return
	if _placement_at_tile(tile).is_empty():
		return
	_issue_world_command({"type": "rotate", "tile": [tile.x, tile.y]})


## The left click. Places in placement mode, removes in remove mode, and does
## nothing at all when the ghost says the click could not succeed — the
## simulation would refuse it silently anyway (every impossible command is a
## total no-op), so refusing here as well keeps the prompt honest rather than
## letting a click look like it did something.
func _confirm_build() -> void:
	# Acts on the tile the GHOST IS DRAWN ON (`_ghost_tile`, recomputed once
	# per frame by `_update_ghost`), not on a freshly re-picked one. What the
	# player is aiming at is what they can see; re-picking here would let a
	# cursor that moved between the frame and the button-down land the build
	# somewhere the ghost never was.
	var tile := _ghost_tile
	if tile == HOVER_NO_TILE:
		return
	if _remove_mode:
		if _placement_at_tile(tile).is_empty():
			return
		_issue_world_command({"type": "remove", "tile": [tile.x, tile.y]})
		return
	if _build_kind == "" or not _ghost_valid:
		return
	var command := {
		"type": "place",
		"kind": _build_kind,
		"tile": [tile.x, tile.y],
		"direction": _build_direction,
	}
	# **A hopper says what it will hold.** `PlayerCommand::Place`'s `item` is
	# optional only while the world has exactly one raw solid to infer from,
	# and the shipped chain has had two since the chain rework — so omitting
	# it (which this function did until then) is a silent refusal, and
	# placing a hopper did nothing at all. Sent for the hopper and no other
	# kind, because the field is ignored elsewhere and a command carrying a
	# field that means nothing invites the next reader to think it does.
	if _build_kind == HOPPER_KIND:
		var item := _selected_hopper_item()
		if item == "":
			return
		command["item"] = item
	_issue_world_command(command)
	# Placing spends one owned unit. Running out ends the mode rather than
	# leaving a ghost that can no longer be built — the prompt would read
	# "✗ NONE OWNED" forever, which is a dead end rather than feedback.
	_refresh_owned_counts()
	if _owned_of(_build_kind) <= 0:
		_exit_build_mode()


## Issues one of the three topology commands and redraws. A place, remove or
## rotate is exactly the event `World::recompute_topology` rebuilds its
## adjacency graph for, so it is exactly the event this scene rebuilds its
## own view for — see `_placements`'s doc.
func _issue_world_command(command: Dictionary) -> void:
	sim.issue_command_json(JSON.stringify(command))
	_rebuild_world()
	_refresh_owned_counts()
	_apply_dirty_chunks()
	if _shop_open:
		_update_shop_menu()


## How many of each kind the player owns and has not yet placed — repolled
## after every purchase and placement. `shop_snapshot_json` is the one call
## that reports it, and it is cheap (one parse of a ten-entry object).
func _refresh_owned_counts() -> void:
	_owned_counts.clear()
	var snapshot = JSON.parse_string(sim.shop_snapshot_json())
	if not (snapshot is Dictionary):
		return
	for entry in snapshot.get("entries", []):
		_owned_counts[String(entry.get("kind", ""))] = int(entry.get("owned", 0))


func _owned_of(kind: String) -> int:
	return int(_owned_counts.get(kind, 0))


## The tile the ghost sits on — the same ray/plane pick the hover tooltip
## uses, from the same screen point (the live cursor in ISOMETRIC, the screen
## centre where the crosshair is drawn in FIRST_PERSON). Deliberately the
## SAME function, not a second implementation: build mode and hover are two
## questions about one cursor.
func _ghost_target_tile() -> Vector2i:
	var vp := get_viewport()
	if vp == null:
		return HOVER_NO_TILE
	var query_pos: Vector2
	if _view_mode == ViewMode.FIRST_PERSON:
		query_pos = vp.get_visible_rect().size / 2.0
	else:
		query_pos = vp.get_mouse_position()
	return _tile_under_screen_pos(query_pos)


## Whether the rotated footprint of `kind` at `tile` would overlap anything
## already placed. A pure Godot-side check against `_occupancy` — the same map
## hover resolves through, which came from `world_layout_json`'s own
## `occupies` lists — so aiming the ghost costs no simulation round trip at
## all. The simulation still has the final say (`Place` refuses a collision
## silently); this is what stops the player finding that out by clicking.
func _ghost_blocked_tiles(kind: String, tile: Vector2i, direction: String) -> Array:
	var blocked: Array = []
	for covered in _placement_tiles(tile, _kind_footprint(kind), direction):
		if _occupancy.has(_tile_key(covered)):
			blocked.append(covered)
	return blocked


## Rebuilds the ghost's own body — one translucent copy of the kind's real
## voxel model, turned to the ghost's facing. Rebuilt (rather than retinted)
## when the ASSET changes, which a rotation can do: a belt facing east next
## to a machine draws the inlet variant, and the same belt facing north
## draws the plain tile (see `_belt_asset_for`), so the ghost shows the model
## that will actually be built.
func _rebuild_ghost_body(asset_override := "") -> void:
	if _ghost_root == null:
		return
	var asset := asset_override
	if asset == "" and _build_kind != "":
		asset = _shop_asset_for(_build_kind)
	if asset == _ghost_asset:
		return
	_clear_ghost_body()
	_ghost_asset = asset
	if asset == "":
		return
	var body := _asset_node(asset)
	body.name = "ghost_body"
	# A ghost casts no shadow: a shadow on the floor is the strongest cue
	# there IS something there, which is the opposite of what this node says.
	for child in body.get_children():
		if child is MeshInstance3D:
			child.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_ghost_root.add_child(body)
	# A hopper ghost also previews its CONTENTS — see `_update_ghost_fill`.
	_update_ghost_fill()


func _clear_ghost_body() -> void:
	if _ghost_root == null:
		return
	for child_name in ["ghost_body", "ghost_fill"]:
		var body := _ghost_root.get_node_or_null(child_name)
		if body != null:
			_ghost_root.remove_child(body)
			body.free()
	_ghost_asset = ""
	_ghost_fill = null


## The hopper ghost's product body: a `hopper_fill` slab, tinted with the
## chosen ingredient, sitting in the ghost the way a real hopper's does.
##
## This is what makes the Q choice VISIBLE rather than merely announced. The
## prompt names the item in words (which is the half UI_UX.md §7 requires on
## its own), and this is the half that answers "what am I about to build" at
## a glance — a hopper of tomatoes and a hopper of sugar are two different
## buildings, and looking identical until placed is how a player ends up with
## two of the wrong one.
##
## It is the same one-voxel-slab mechanism the live hopper, the tank, the
## pipe and the splitter arrow already share, at a fixed nearly-full level: a
## ghost has no fill fraction, and an empty one would draw nothing at all.
func _update_ghost_fill() -> void:
	if _ghost_root == null:
		return
	if _ghost_fill != null:
		_ghost_root.remove_child(_ghost_fill)
		_ghost_fill.free()
		_ghost_fill = null
	var item := _selected_hopper_item()
	if item == "":
		return
	var node := _asset_node(HOPPER_FILL_ASSET)
	node.name = "ghost_fill"
	node.position = Vector3(0.0, HOPPER_FILL_FLOOR_Y, 0.0)
	node.scale.y = 0.8 * float(HOPPER_FILL_HEIGHT_VOXELS)
	var tint: Color = HOPPER_FILL_TINTS.get(item, HOPPER_FILL_TINT_FALLBACK)
	for child in node.get_children():
		if child is MeshInstance3D:
			child.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			child.set_surface_override_material(0, _ghost_material(tint))
	_ghost_root.add_child(node)
	_ghost_fill = node


## Per-frame: where the ghost stands, whether the click would succeed, and
## what the prompt says. Cheap — one ray/plane intersection and one
## dictionary lookup per covered tile — and it does nothing at all when
## neither mode is active.
func _update_ghost() -> void:
	if _ghost_root == null:
		return
	if not _in_build_mode():
		if _ghost_root != null:
			_ghost_root.visible = false
		if _placement_prompt != null:
			_placement_prompt.visible = false
		return

	_refresh_owned_counts()
	var tile := _ghost_target_tile()
	_ghost_tile = tile
	var showing := false

	if _remove_mode:
		var placement := _placement_at_tile(tile) if tile != HOVER_NO_TILE else {}
		if placement.is_empty():
			_ghost_valid = false
			_ghost_reason = "nothing_here"
		else:
			_ghost_valid = true
			_ghost_reason = ""
			var origin := _placement_origin(placement)
			var direction := _placement_direction(placement)
			var size := _rotated_footprint(_footprint_size(placement.get("footprint")), direction)
			_rebuild_ghost_body(_asset_for_placement(placement))
			_ghost_root.position = _footprint_centre(origin, size, FLOOR_Y)
			_ghost_root.rotation.y = _direction_yaw(direction)
			_tint_ghost(GHOST_TINT_REMOVE)
			showing = true
	elif tile != HOVER_NO_TILE:
		var blocked := _ghost_blocked_tiles(_build_kind, tile, _build_direction)
		if _owned_of(_build_kind) <= 0:
			_ghost_valid = false
			_ghost_reason = "none_owned"
		elif not blocked.is_empty():
			_ghost_valid = false
			_ghost_reason = "blocked"
		else:
			_ghost_valid = true
			_ghost_reason = ""
		# A belt's model depends on what it would sit next to, so the ghost
		# asks the same question the built tile will.
		var ghost_asset := _shop_asset_for(_build_kind)
		if _build_kind == BELT_KIND:
			ghost_asset = _belt_asset_for(tile, _build_direction)
		elif _build_kind == PIPE_KIND:
			ghost_asset = PIPE_ASSET
		_rebuild_ghost_body(ghost_asset)
		var ghost_size := _rotated_footprint(_kind_footprint(_build_kind), _build_direction)
		_ghost_root.position = _footprint_centre(tile, ghost_size, FLOOR_Y)
		_ghost_root.rotation.y = _direction_yaw(_build_direction)
		_tint_ghost(GHOST_TINT_VALID if _ghost_valid else GHOST_TINT_INVALID)
		showing = true
	else:
		_ghost_valid = false
		_ghost_reason = "blocked"

	_ghost_root.visible = showing
	if _placement_prompt != null:
		_placement_label.text = _placement_prompt_text()
		_placement_prompt.add_theme_stylebox_override(
			"panel", _placement_prompt_style(_ghost_valid, _remove_mode)
		)
		var vp := get_viewport()
		if vp != null:
			var anchor: Vector2
			if _view_mode == ViewMode.FIRST_PERSON:
				anchor = vp.get_visible_rect().size / 2.0
			else:
				anchor = vp.get_mouse_position()
			_placement_prompt.position = _panel_position_near(_placement_prompt, anchor)
		_placement_prompt.visible = true


func _tint_ghost(tint: Color) -> void:
	var body := _ghost_root.get_node_or_null("ghost_body")
	if body == null:
		return
	var mat := _ghost_material(tint)
	for child in body.get_children():
		if child is MeshInstance3D:
			child.set_surface_override_material(0, mat)


## What the prompt beside the cursor says. The glyph and the word are the
## non-colour half of UI_UX.md §7's rule — this text alone is enough to know
## whether the click will do anything, with the tint as reinforcement rather
## than as the signal. Pure, so a test can drive every state directly.
func _placement_prompt_text() -> String:
	if _remove_mode:
		if _ghost_reason == "nothing_here":
			return "✗ REMOVE\nnothing here\nX or ESC: stop removing"
		var placement := _placement_at_tile(_ghost_tile)
		return "✔ REMOVE  %s\nclick to pick it up (what it holds is lost)\nX or ESC: stop removing" % \
			_kind_display_name(String(placement.get("kind", "")))
	if _build_kind == "":
		return ""
	var kind_name := _kind_display_name(_build_kind)
	var owned := _owned_of(_build_kind)
	# A hopper's contents are part of what is about to be built, so they are
	# in the NAME rather than tucked into the hint line: "✔ PLACE Hopper" and
	# "✔ PLACE Hopper — Sugar" are two different claims about the click.
	var contents := _selected_hopper_item()
	if contents != "":
		kind_name = "%s — %s" % [kind_name, _item_display_name(contents)]
	# The key that changes it is only advertised when there is more than one
	# thing to change it to. In a world with a single raw ingredient the
	# choice does not exist and a hint about it would be noise.
	var contents_hint := "    Q: contents" if _hopper_items.size() > 1 and _build_kind == HOPPER_KIND else ""
	match _ghost_reason:
		"none_owned":
			return "✗ NONE OWNED  %s\nbuy one in the build menu (E)\nESC: cancel" % kind_name
		"blocked":
			return "✗ BLOCKED  %s  ·  facing %s\nsomething is already there\nR: rotate%s    ESC: cancel" % [
				kind_name, _build_direction, contents_hint
			]
	return "✔ PLACE  %s  ·  facing %s\nclick to build    %d left to place\nR: rotate%s    ESC: cancel" % [
		kind_name, _build_direction, owned, contents_hint
	]


## The prompt's plate: the scene's near-black HUD panel with its rule
## recoloured to the ghost's state, so the panel edge carries the same signal
## the glyph does.
##
## `destructive` (remove mode) overrides `valid`, and that came off a rendered
## frame: a valid REMOVE is still a red-ghosted building about to be destroyed,
## and framing it in the same green a valid PLACE gets read as two different
## claims about one action. Green means "this click builds"; red means "this
## click destroys, or refuses".
func _placement_prompt_style(valid: bool, destructive := false) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.92)
	var ok := valid and not destructive
	style.border_color = Color(0.35, 0.85, 0.45, 0.95) if ok else Color(0.92, 0.35, 0.30, 0.95)
	style.set_border_width_all(3)
	style.set_content_margin_all(10.0)
	return style


## The on-screen prompt, built beside the hover tooltip and deliberately the
## same shape as it: a small dark plate that follows the cursor. Build mode
## and hover never show at once (see `_update_hover_tooltip`), so what the
## player sees is one panel by the cursor that changes what it is about.
func _build_placement_prompt(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	_placement_prompt = PanelContainer.new()
	_placement_prompt.name = "PlacementPrompt"
	_placement_prompt.add_theme_stylebox_override("panel", _placement_prompt_style(true))
	_placement_prompt.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_placement_prompt.visible = false
	hud.add_child(_placement_prompt)

	_placement_label = Label.new()
	_placement_label.label_settings = base_settings
	_placement_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_placement_prompt.add_child(_placement_label)


func _build_hover_tooltip(hud: CanvasLayer) -> void:
	# The hover tooltip (docs/UI_UX.md §5): a small, separately-positioned
	# panel that follows the cursor and shows one stage's recipe/progress/
	# input/output — the info the always-on panel used to show for every
	# stage at once, now on-demand only. A simple readable panel, not this
	# section's clipboard/checklist diegetic styling — that visual pass is
	# separate work; this just needs to be legible near the cursor.
	var hover_style := StyleBoxFlat.new()
	hover_style.bg_color = Color(0.10, 0.09, 0.06, 0.92)
	hover_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	hover_style.set_border_width_all(2)
	hover_style.set_content_margin_all(8.0)

	_hover_tooltip = PanelContainer.new()
	_hover_tooltip.add_theme_stylebox_override("panel", hover_style)
	_hover_tooltip.visible = false
	# Ignore mouse events itself, or the panel following the cursor would
	# constantly steal hover from whatever's under it (including, absurdly,
	# itself — every frame's "am I hovering a machine" check reads the raw
	# viewport mouse position, not anything mouse-event-driven, so this only
	# matters for a hypothetical future clickable HUD element underneath).
	_hover_tooltip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hud.add_child(_hover_tooltip)

	var hover_settings := LabelSettings.new()
	hover_settings.font_size = 14
	hover_settings.font_color = Color(0.95, 0.95, 0.90)
	hover_settings.outline_size = 3
	hover_settings.outline_color = Color(0, 0, 0, 0.85)

	_hover_label = Label.new()
	_hover_label.label_settings = hover_settings
	_hover_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hover_tooltip.add_child(_hover_label)


## A small screen-centre crosshair, shown only in FIRST_PERSON (toggled in
## _set_view_mode) — the mouse is captured/hidden there, so it's the only
## way to see what "looking at" a machine even means, and it's what
## _update_hover_tooltip queries against instead of a live cursor position.
## Two thin bars rather than a Label glyph, so it stays crisp at any size
## without depending on a font having a suitable character.
func _build_crosshair(hud: CanvasLayer) -> void:
	_crosshair = Control.new()
	_crosshair.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crosshair.visible = false
	_crosshair.set_anchors_preset(Control.PRESET_FULL_RECT)
	hud.add_child(_crosshair)

	var bar_color := Color(0.95, 0.95, 0.90, 0.85)
	var h_bar := ColorRect.new()
	h_bar.color = bar_color
	h_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	h_bar.size = Vector2(CROSSHAIR_SIZE, CROSSHAIR_THICKNESS)
	h_bar.set_anchors_preset(Control.PRESET_CENTER)
	h_bar.position = -h_bar.size / 2.0
	_crosshair.add_child(h_bar)

	var v_bar := ColorRect.new()
	v_bar.color = bar_color
	v_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v_bar.size = Vector2(CROSSHAIR_THICKNESS, CROSSHAIR_SIZE)
	v_bar.set_anchors_preset(Control.PRESET_CENTER)
	v_bar.position = -v_bar.size / 2.0
	_crosshair.add_child(v_bar)


# --------------------------------------------------------------------------
# Simulation driving / rendering
# --------------------------------------------------------------------------

func _process(delta: float) -> void:
	_tick_accum += delta
	var tick_interval := 1.0 / TICK_HZ
	var budget := MAX_TICKS_PER_FRAME
	while _tick_accum >= tick_interval and budget > 0:
		_tick_accum -= tick_interval
		budget -= 1
		sim.tick()
		_apply_dirty_chunks()
	if _tick_accum >= tick_interval:
		# Backlog beyond the budget is discarded, not carried (see
		# MAX_TICKS_PER_FRAME): carrying it would only move the burst to the
		# next frame.
		_tick_accum = 0.0

	_update_contract_panel()
	if _shop_open:
		# Only while it's up: money the running factory earns should make a
		# slot go from unaffordable to affordable while the player watches.
		_update_shop_menu()
	_update_fluid_network()
	_refresh_buffers()
	_update_machine_gauges()
	_update_hotbar()
	_update_larder()
	if _market_open:
		_update_ingredient_market()
	_update_ghost()
	_update_hover_tooltip()
	if _view_mode == ViewMode.ISOMETRIC:
		_pan_camera(delta)
	else:
		_fp_camera_move(delta)


func _unhandled_input(event: InputEvent) -> void:
	# TAB always toggles view mode, in either mode.
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_TAB:
		_set_view_mode(ViewMode.FIRST_PERSON if _view_mode == ViewMode.ISOMETRIC else ViewMode.ISOMETRIC)
		return

	if event is InputEventMouseButton:
		# The left button is the build click (the "Real Placement" epic's
		# ticket 2) — the button this handler had deliberately left unbound
		# "so a future click-to-build has nothing to fight with". It does
		# nothing outside build mode, so nothing that used to work changed.
		if event.button_index == MOUSE_BUTTON_LEFT and event.pressed \
				and _in_build_mode() and not _shop_open and not _market_open:
			_confirm_build()
			return
		# Right-drag panning (isometric only) — right button, not left, which
		# is what left that button free for the click above.
		if event.button_index == MOUSE_BUTTON_RIGHT and _view_mode == ViewMode.ISOMETRIC:
			_iso_dragging = event.pressed
			return
		if event.pressed and _view_mode == ViewMode.ISOMETRIC:
			if event.button_index == MOUSE_BUTTON_WHEEL_UP:
				_zoom_camera(1.0 - ZOOM_STEP)
			elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				_zoom_camera(1.0 + ZOOM_STEP)
		return

	# A real mouse's wheel arrives as InputEventMouseButton (above). A macOS
	# trackpad's two-finger scroll does NOT — it arrives as a continuous
	# InputEventPanGesture instead, which is why scroll-to-zoom didn't work
	# on trackpads until this was added. Scale by the gesture's own delta
	# magnitude (it's continuous, not discrete notches like a wheel click),
	# not a fixed step, so a fast swipe zooms faster than a slow one.
	if event is InputEventPanGesture:
		if _view_mode == ViewMode.ISOMETRIC and event.delta.y != 0.0:
			_zoom_camera(1.0 + event.delta.y * TRACKPAD_ZOOM_SENSITIVITY)
		return

	if event is InputEventMouseMotion:
		if _view_mode == ViewMode.ISOMETRIC:
			if _iso_dragging:
				_apply_drag_pan(event.relative)
		elif not _shop_open and not _market_open:
			# With either shop panel up in first-person the mouse is visible
			# and is being used to click slots — swinging the camera with it
			# too would make the panel unusable.
			_apply_look(event.relative)
		return

	if not (event is InputEventKey and event.pressed and not event.echo):
		return

	# E opens and closes the build menu — Factorio's own inventory key, which
	# is what a player arriving from that genre will reach for first. It used
	# to be **B**, and B is deliberately NOT kept as an alias: two keys for
	# one panel means the legend can only print one of them, and the one it
	# does not print becomes an undiscoverable duplicate that the next rebind
	# has to remember about. One key, printed in ISO_HELP_TEXT/FP_HELP_TEXT.
	#
	# Handled in BOTH view modes, like V and unlike SPACE: it collides with
	# nothing in either, and buying equipment is not something the player
	# should have to leave first-person to do.
	if event.keycode == KEY_E:
		# Opening the menu leaves build mode: the menu is where you pick what
		# to place, so arriving there with a ghost still following the cursor
		# would leave two answers to "what does a click do".
		if not _shop_open:
			_exit_build_mode()
			# And the two shop panels are mutually exclusive, for the same
			# reason: one modal screen at a time, so ESC and a second press
			# of either key always leave the player somewhere definite.
			_set_market_open(false)
		_toggle_shop_menu()
		return

	# M opens the INGREDIENT MARKET — the stock half of the shop, where raw
	# tomatoes, sugar and vinegar are bought. Its own key rather than a
	# section of the build menu because that menu is already as tall as the
	# space above the hotbar allows; see `_market_panel`'s doc. Handled in
	# both view modes, like E, and for E's reason.
	if event.keycode == KEY_M:
		if not _market_open:
			_exit_build_mode()
			_set_shop_menu_open(false)
		_toggle_market()
		return

	# Q cycles a hopper's contents: the ghost's while placing, and — outside
	# placement mode, mirroring R's own dual-mode shape exactly — whatever
	# hopper is under the cursor, in place. It does nothing with anything
	# else in hand or under the cursor, which is deliberate: this is not a
	# general "cycle variant" key looking for a second use, it is the
	# hopper's one extra decision (`_hopper_items`) and it is advertised in
	# the placement prompt exactly while that decision exists.
	if event.keycode == KEY_Q:
		if _build_kind == HOPPER_KIND:
			_cycle_hopper_item()
		else:
			_cycle_hopper_under_cursor()
		return

	# ESC closes whatever is open — see `_close_all_overlays`.
	if event.keycode == KEY_ESCAPE:
		_close_all_overlays()
		return

	# R turns things: the ghost's facing while placing, and — outside
	# placement mode — whatever is under the cursor, in place. Both are the
	# same quarter turn clockwise the simulation offers.
	if event.keycode == KEY_R:
		if _build_kind != "":
			_rotate_ghost()
		else:
			_rotate_under_cursor()
		return

	# X toggles remove mode — see `_toggle_remove_mode` for why a mode rather
	# than a modifier-click.
	if event.keycode == KEY_X:
		_toggle_remove_mode()
		return

	# THE NUMBER KEYS ARE THE HOTBAR (the inventory-hotbar ticket). 1..9 then
	# 0 select the slot they label — always, with the build menu open or
	# closed, in either view mode. That is the behaviour change this ticket
	# makes: until now they only acted while the menu was up, and this
	# handler's own comment reserved them "for whatever a later epic wants a
	# hotbar to do".
	#
	# Selecting enters placement mode for that kind, and pressing the
	# selected slot's key again leaves it, mirroring ESC. SHIFT+number is
	# BUYING, and — deliberately — only while the build menu is open, because
	# that is the only screen where the price and the balance the purchase
	# spends are both in front of the player. A key that spends money with no
	# prices on screen is exactly the accident this split exists to prevent.
	var hotbar_index := _hotbar_index_for_keycode(event.keycode)
	if hotbar_index >= 0:
		if event.shift_pressed:
			if _shop_open:
				_buy_slot(hotbar_index)
			return
		_select_hotbar_slot(hotbar_index)
		return

	if _view_mode == ViewMode.ISOMETRIC:
		if event.keycode == KEY_EQUAL or event.keycode == KEY_KP_ADD:
			_zoom_camera(1.0 - ZOOM_STEP)
			return
		if event.keycode == KEY_MINUS or event.keycode == KEY_KP_SUBTRACT:
			_zoom_camera(1.0 + ZOOM_STEP)
			return

	var command := ""
	# SPACE only loads a hopper in ISOMETRIC mode — in FIRST_PERSON it's "fly
	# up" (_fp_input_direction), and a single keypress can't mean both. Since
	# the chain-rework epic this draws from stock a `BuyIngredient` purchase
	# (the ingredient market, M) paid for, clamped at the hopper's capacity;
	# the hopper itself meters it onto its belt one per tick — so this key
	# sets the SUPPLY and the machinery sets the rate. The level it changes
	# is visible in the hopper itself (see _update_hopper) and in its hover
	# tooltip. `_hopper_fill_blocker` is checked first so a doomed press (no
	# hopper down, or nothing in stock to load) says why instead of doing
	# nothing visibly at all.
	if event.keycode == KEY_SPACE and _view_mode == ViewMode.ISOMETRIC:
		var blocker := _hopper_fill_blocker()
		if blocker != "":
			_show_hotbar_flyout(blocker)
			return
		command = JSON.stringify({"type": "fill_hopper"})
	# V is the fluid twin of SPACE. It draws from vinegar stock the market
	# sold, into whichever tank(s) are placed, same clamp-and-meter shape as
	# SPACE. Unlike SPACE this works in BOTH view modes, because unlike SPACE
	# it collides with nothing (SPACE is "fly up" in first person).
	# `_tank_fill_blocker` guards it the same way.
	elif event.keycode == KEY_V:
		var tank_blocker := _tank_fill_blocker()
		if tank_blocker != "":
			_show_hotbar_flyout(tank_blocker)
			return
		command = JSON.stringify({"type": "fill_fluid_tank"})
	else:
		return

	sim.issue_command_json(command)
	# Render immediately rather than waiting for the next scheduled tick —
	# issue_command's dirty marking isn't cleared until tick() runs next,
	# so this is safe to read right away.
	_apply_dirty_chunks()


func _apply_dirty_chunks() -> void:
	var dirty: PackedInt64Array = sim.dirty_chunk_ids()
	for chunk_id in dirty:
		var parsed = JSON.parse_string(sim.chunk_snapshot_json(chunk_id))
		if parsed != null:
			_render_snapshot(parsed)


func _render_snapshot(snapshot: Dictionary) -> void:
	var belts: Array = snapshot.get("belts", [])
	for belt in belts:
		_render_carried_items(belt, "belt")

	# A splitter carries its contents in an ordinary one-tile belt segment
	# (`sim_core/src/sim/splitter.rs`), and `SplitterSnapshot` is
	# `BeltSnapshot` plus the two facts only a splitter has — so the items on
	# one are drawn by the same function, from the same `items` field, at the
	# same running height. That is not a shortcut: an item takes exactly as
	# long to cross a splitter as to cross the belt tile it replaced, and it
	# should look like it.
	var splitters: Array = snapshot.get("splitters", [])
	for splitter in splitters:
		var tile := _pair_to_tile(splitter.get("tile"))
		_render_carried_items(splitter, "splitter")
		_apply_splitter_state(_tile_key(tile), splitter)

	var machines: Array = snapshot.get("machines", [])
	for machine in machines:
		# Keyed by ORIGIN TILE, not by recipe: the player may place several
		# machines running the same recipe, and a recipe-keyed entry would
		# collapse them into one that flickered between them.
		var key := _tile_key(_pair_to_tile(machine.get("tile")))
		_machine_states[key] = machine
		_set_machine_running(key, machine.get("process") != null)


## Stands one item node on every slot of a conveyor tile — a belt or a
## splitter, whose `tile`/`direction`/`items` fields are identical on the
## wire. `prefix` keeps the two kinds' pooled node keys apart so a splitter
## replacing a belt on the same tile cannot inherit its items.
##
## A tile is ONE TILE and carries toward its own `direction` rather than
## always along +X, so an item's distance runs along that facing — which is
## what lets a line turn a corner (or fork) and still look like one line.
##
## **Emptied slots are hidden per TILE, not per pass, and that is a fix
## rather than a style.** This used to collect every key it had drawn into
## one `seen` set and then hide every pooled node missing from it — but
## `_render_snapshot` runs once per DIRTY CHUNK, so with two chunks dirty the
## second pass hid everything the first had just drawn. It went unnoticed
## while every factory fitted in one chunk and was caught the moment a
## splitter branched a line across a chunk boundary: the branch belt held
## eight tomatoes in the simulation and rendered empty. A tile knows exactly
## how many items it has, so the slots past that are the ones to hide, and no
## other tile's nodes are any of this tile's business.
func _render_carried_items(carrier: Dictionary, prefix: String) -> void:
	var tile := _pair_to_tile(carrier.get("tile"))
	var offset := _direction_offset(String(carrier.get("direction", "east")))
	var items: Array = carrier.get("items", [])
	for i in range(items.size()):
		var pair: Array = items[i]
		var key := "%s_%d_%d_%d" % [prefix, tile.x, tile.y, i]
		var node := _item_node_for(key, String(pair[0]))
		node.visible = true
		var distance := float(pair[1])
		node.position = Vector3(
			(float(tile.x) + float(offset.x) * distance) * TILE,
			BELT_SURFACE_Y,
			(float(tile.y) + float(offset.y) * distance) * TILE
		)
	# Slots this tile used to fill and no longer does. Pooled keys are handed
	# out from 0 upward, so the first gap is the end.
	var spare := items.size()
	while true:
		var key := "%s_%d_%d_%d" % [prefix, tile.x, tile.y, spare]
		if not _item_nodes.has(key):
			break
		_item_nodes[key]["node"].visible = false
		spare += 1


## Pooled per belt slot. If the slot's item type changes (it doesn't in the
## current straight chain, but nothing guarantees that) the old node is
## replaced rather than silently rendering the wrong product.
func _item_node_for(key: String, item_name: String) -> Node3D:
	var asset: String = ITEM_MODELS.get(item_name, ITEM_MODEL_FALLBACK)
	if _item_nodes.has(key):
		var existing: Dictionary = _item_nodes[key]
		if existing["asset"] == asset:
			return existing["node"]
		existing["node"].queue_free()
		_item_nodes.erase(key)

	var node := _asset_node(asset)
	node.name = "item_" + key
	add_child(node)
	_item_nodes[key] = {"node": node, "asset": asset}
	return node


## Sentinel returned by `_tile_under_screen_pos` when the camera ray never
## crosses the belt-surface plane in front of the camera — either it's
## (degenerately) parallel to it (not reachable in practice for the fixed
## isometric CAMERA_DIRECTION, but a real case once FIRST_PERSON's free-look
## camera can point the ray dead level), or it points away from the plane
## entirely (FIRST_PERSON looking up at the sky — the plane is still
## "behind" the ray in that case, so the naive intersection point would be
## a phantom tile no player could see). Callers get an explicit "no tile"
## value rather than a Vector2i(0, 0) that could also be a real tile.
const HOVER_NO_TILE := Vector2i(-999999, -999999)
## Screen-space offset from the raw cursor position to the tooltip panel's
## top-left corner, so the panel doesn't sit directly under (and get
## re-hidden by chasing) the cursor itself.
const HOVER_TOOLTIP_OFFSET := Vector2(18.0, 18.0)


## Resolves a screen-space position to the world tile beneath it: casts the
## camera's ray for that screen position (per its CURRENT transform/
## projection — `project_ray_origin`/`project_ray_normal` are pure and
## deterministic given that, not physics-engine-dependent) and intersects it
## with the horizontal plane at belt-surface height (BELT_SURFACE_Y).
## Machines sit directly on that plane at a known tile position (see
## _machine_tiles), so plane intersection alone is enough to pick one out —
## no physics engine involved, matching this project's zero physics
## dependency elsewhere (ARCHITECTURE.md's headless-testability philosophy).
##
## Pure and deterministic given the camera's current state — no Input/mouse
## reads happen here, so test_hover.gd can call it directly with an explicit
## screen position. This mirrors _apply_pan/_apply_look's split (see their
## doc comments): _update_hover_tooltip below is the thin, untested part that
## actually reads the live mouse position (ISOMETRIC) or the screen centre
## (FIRST_PERSON, where the crosshair sits — see _build_crosshair).
##
## Works for either camera projection — orthogonal (ISOMETRIC) or
## perspective (FIRST_PERSON) — since project_ray_origin/project_ray_normal
## already account for that. FIRST_PERSON's free-look does introduce a case
## ISOMETRIC's fixed downward angle never hits: the ray pointing away from
## the plane entirely (looking up at the sky), where a naive intersection
## would land "behind" the camera. `t < 0` catches that.
func _tile_under_screen_pos(screen_pos: Vector2) -> Vector2i:
	if _camera == null:
		return HOVER_NO_TILE
	var origin := _camera.project_ray_origin(screen_pos)
	var dir := _camera.project_ray_normal(screen_pos)
	if is_zero_approx(dir.y):
		return HOVER_NO_TILE
	var t := (BELT_SURFACE_Y - origin.y) / dir.y
	if t < 0.0:
		return HOVER_NO_TILE
	var point := origin + dir * t
	return Vector2i(roundi(point.x / TILE), roundi(point.z / TILE))


## What the tooltip should say about whatever occupies `tile` — a machine, a
## belt, a pipe, a hopper, a tank, a dock, or nothing ("", the sentinel
## `_update_hover_tooltip` checks to decide whether to show the tooltip at
## all).
##
## This used to be a chain of "is it the machine? is it THE hopper? is it THE
## tank?" tests against one remembered building each. It is now one lookup in
## `_occupancy` followed by a branch on the placement's own `kind`, which is
## what makes hover work unchanged when the player builds a second hopper, a
## third dock, or a machine facing south: which placement the cursor is over
## is answered by the same footprint-aware map the ghost's validity check
## uses, and disambiguating two hoppers falls straight out of it.
##
## Pure given the polled snapshots, so a test can drive it with a tile.
func _hover_text_at_tile(tile: Vector2i) -> String:
	var placement := _placement_at_tile(tile)
	if placement.is_empty():
		return ""
	var kind := String(placement.get("kind", ""))
	var key := _tile_key(_placement_origin(placement))
	var direction := _placement_direction(placement)
	match kind:
		BELT_KIND:
			return "belt\ncarries %s" % direction
		SPLITTER_KIND:
			return _splitter_hover_text(key, direction)
		PIPE_KIND:
			return _pipe_hover_text(tile, direction)
		HOPPER_KIND:
			return _hopper_hover_text(key, direction)
		FLUID_TANK_KIND:
			return _fluid_tank_hover_text(key, direction)
		DOCK_KIND:
			return _dock_hover_text(key, direction)
	return _machine_hover_text(key, kind, direction)


## What one splitter's tooltip says. Three lines, because a splitter has
## exactly three facts and one of them is the reason it exists: where each
## output goes, and which one takes the next item.
##
## Both outputs are named even when one is `null`, and an unbuilt one is
## called out in words rather than left off — "branch: not connected" is the
## answer to "why is everything going straight", which is the single most
## likely question a player has about a splitter they just placed. The NEXT
## line reports the side the item will actually reach (see
## `_apply_splitter_state` for why that is not always `next_output`) and says
## so when the due side is being passed over.
func _splitter_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _splitter_states.get(origin_key, {})
	if snapshot.is_empty():
		return "splitter\nfacing %s" % direction
	var outputs: Array = snapshot.get("outputs", [null, null])
	var side := _splitter_effective_side(snapshot)
	var due := SPLITTER_BRANCH if String(snapshot.get("next_output", "straight")) == "branch" else SPLITTER_STRAIGHT
	var next_line := "next: nowhere — neither output is connected"
	if side >= 0:
		next_line = "next: %s" % ("branch" if side == SPLITTER_BRANCH else "straight")
		if side != due:
			next_line += " (%s not connected)" % ("branch" if due == SPLITTER_BRANCH else "straight")
	return "splitter  ·  facing %s\n%s\nstraight: %s\nbranch: %s" % [
		direction,
		next_line,
		_splitter_output_text(outputs, SPLITTER_STRAIGHT),
		_splitter_output_text(outputs, SPLITTER_BRANCH),
	]


## One output's tile, or "not connected" — the state `outputs[i] == null`
## means, which is "nothing that can accept an item stands there".
func _splitter_output_text(outputs: Array, side: int) -> String:
	if side >= outputs.size() or outputs[side] == null:
		return "not connected"
	var tile := _pair_to_tile(outputs[side])
	return "%d, %d" % [tile.x, tile.y]


## The recipe/progress/input/output text for one machine, keyed by its origin
## tile. Now also prints which way it faces, because that is a decision the
## player made and can change (**R**) and it decides which side takes product
## and which side gives it back — the one fact about a machine that used to be
## the same for every machine in the world and now is not.
## Pure given `_machine_states`/`sim.current_tick()` — no Input reads.
func _machine_hover_text(origin_key: String, kind: String, direction: String) -> String:
	if not _machine_states.has(origin_key):
		return "%s\nfacing %s" % [_kind_display_name(kind), direction]
	var machine: Dictionary = _machine_states[origin_key]
	var process = machine.get("process")
	var progress_text := "idle"
	if process != null:
		var required: int = int(process[1])
		var elapsed: int = clampi(sim.current_tick() - int(process[0]), 0, required)
		var pct: float = (float(elapsed) / float(required)) * 100.0 if required > 0 else 100.0
		# The percentage ALONE is not enough once a process runs longer than
		# a glance. A 60-tick crush is over before a player finishes reading
		# it, so "40%" is all it can usefully say; the vat's 240-tick cook is
		# four real seconds, and "40%" of a number the player has never been
		# told is not an answer to the question they are actually asking,
		# which is "how long until this is done". So the remaining time is
		# spelled out beside it, in seconds — the unit the player
		# experiences — rather than in ticks, which are an implementation
		# detail of ARCHITECTURE.md §3.9's fixed timestep.
		progress_text = "%.0f%%  ·  %s left" % [pct, _format_remaining(required - elapsed)]
	return "%s  ·  facing %s\n%s\nin: %s\nout: %s" % [
		String(machine.get("recipe", kind)),
		direction,
		progress_text,
		_format_counts(machine.get("input", [])),
		_format_counts(machine.get("output", [])),
	]


## A tick count as the wall-clock time it will take, at the rate this scene
## actually advances the simulation (`TICK_HZ`) — deliberately not at
## ARCHITECTURE.md §3.9's nominal 60/sec, because what the player is asking
## is "how long do I wait", and they wait at the rate the game runs. If
## TICK_HZ ever changes, every number this prints follows it, which is the
## point of reading the constant rather than typing a rate in twice.
## Minutes appear only once there is a minute to show, so the chain's short
## stages still read as plain seconds. Pure, so a test can drive it directly.
func _format_remaining(ticks: int) -> String:
	var seconds: int = int(ceil(float(maxi(ticks, 0)) / TICK_HZ))
	if seconds < 60:
		return "%ds" % seconds
	return "%dm %02ds" % [seconds / 60, seconds % 60]


## Which (network, segment) pair sits on `tile`, or `Vector2i(-1, -1)`.
## Populated in `_rebuild_world` from the fluid snapshots, since which network
## a pipe tile belongs to is a property of the whole connected run.
func _pipe_indices_at_tile(tile: Vector2i) -> Vector2i:
	return _pipe_tiles.get(_tile_key(tile), Vector2i(-1, -1))


## Fluid type, level and pressure for the pipe tile under the cursor. Reads
## the live snapshot array rather than one remembered network: a world has one
## network per connected run of pipe now, and the player can split or join
## them by placing and removing a single tile.
func _pipe_hover_text(tile: Vector2i, direction: String) -> String:
	var indices := _pipe_indices_at_tile(tile)
	if indices.x < 0 or indices.x >= _last_fluid.size():
		return "pipe\nfacing %s\nnot connected to anything" % direction
	var network: Dictionary = _last_fluid[indices.x]
	var segments: Array = network.get("segments", [])
	if indices.y < 0 or indices.y >= segments.size():
		return "pipe\nfacing %s" % direction
	var segment: Dictionary = segments[indices.y]
	var role := "pipe"
	if bool(segment.get("is_source", false)):
		role = "pipe (tank supply)"
	elif _pipe_asset_for(tile) == PIPE_INLET_ASSET:
		role = "pipe (machine inlet)"
	return "%s\n%s  ·  facing %s\n%.1f / %.1f units\npressure %.0f%%" % [
		_fluid_id_of(network) if _fluid_id_of(network) != "" else "empty run",
		role,
		direction,
		float(segment.get("volume", 0.0)),
		float(segment.get("capacity", 0.0)),
		clampf(float(segment.get("pressure", 0.0)), 0.0, 1.0) * 100.0,
	]


## What one hopper's tooltip says: what it holds, how full it is, and — new
## since placement — whether it is actually discharging onto anything. A
## hopper facing bare ground reports `belt_tile: null`, which is an ordinary
## state now and exactly the mistake a player wants told about.
##
## The "Q: change contents" line only appears when there is more than one
## raw item to change it TO — same restraint the placement prompt's own
## `contents_hint` already applies, for the same reason: a hint about a
## choice that does not exist is noise, not help. `_hopper_items` is only
## ever populated on entering placement mode (`_enter_build_mode`), so a
## player who hovers an existing hopper without having placed one this
## session would see a stale empty list — refreshed here instead, scoped to
## exactly when it is needed rather than every frame regardless of what is
## under the cursor.
func _hopper_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _hopper_states.get(origin_key, {})
	if snapshot.is_empty():
		return "hopper\nfacing %s" % direction
	_refresh_hopper_items()
	var contents_hint := "\nQ: change contents" if _hopper_items.size() > 1 else ""
	return "hopper  ·  facing %s\n%s\n%d / %d units\n%s%s" % [
		direction,
		String(snapshot.get("item", "raw ingredient")),
		int(snapshot.get("quantity", 0)),
		int(snapshot.get("capacity", 0)),
		"unloading onto a belt" if snapshot.get("belt_tile") != null else "no belt in front of it",
		contents_hint,
	]


## The tank's tooltip — the hopper's shape, with the one difference the wire
## format already has (a fluid volume is fractional, an item count is not).
func _fluid_tank_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _fluid_tank_states.get(origin_key, {})
	if snapshot.is_empty():
		return "fluid tank\nfacing %s" % direction
	return "fluid tank  ·  facing %s\n%s\n%.1f / %.0f units\n%s" % [
		direction,
		_fluid_id_of(snapshot) if _fluid_id_of(snapshot) != "" else "empty",
		float(snapshot.get("quantity", 0.0)),
		float(snapshot.get("capacity", 0.0)),
		"feeding a pipe run" if snapshot.get("pipe_tile") != null else "no pipe in front of it",
	]


## The dock's tooltip. The one building on the line with no recipe and no
## process, so the machine tooltip's shape has nothing to put in three of its
## four lines — and the obvious substitute, its own buffer level, is always
## zero by design (see DOCK_ASSET's doc). So it answers the two questions a
## dock can actually answer: what THIS dock has shipped over its life, and
## what is standing on the shared pool waiting for a contract to claim it —
## the same figure the clipboard prints as ON THE DOCK, deliberately, rather
## than a second number the player would have to reconcile with it.
func _dock_hover_text(origin_key: String, direction: String) -> String:
	var snapshot: Dictionary = _dock_states.get(origin_key, {})
	if snapshot.is_empty():
		return "delivery dock\nfacing %s" % direction
	return "delivery dock  ·  facing %s\nships to contracts every tick\n%d shipped by this dock\nwaiting: %s" % [
		direction,
		int(snapshot.get("shipped_total", 0)),
		_format_counts(_last_dock_stock),
	]


## The thin, live-state-reading half (deliberately not unit tested, same
## reasoning as _pan_input_direction/_fp_input_direction's doc comments —
## headless SceneTree tests can't reliably simulate live viewport mouse
## state): picks which screen point to query — the live cursor in ISOMETRIC,
## the screen centre (where _crosshair is drawn) in FIRST_PERSON, since the
## mouse is captured there and has no meaningful on-screen position — and
## drives the pure functions above to decide what the tooltip should show.
func _update_hover_tooltip() -> void:
	if _hover_tooltip == null:
		return
	if _shop_open or _in_build_mode():
		# The build menu sits over the middle of the screen; a world tooltip
		# chasing the cursor across it would just be two panels fighting. And
		# in build mode the placement prompt is already the panel by the
		# cursor, saying the more useful of the two things.
		_hover_tooltip.visible = false
		return
	var vp := get_viewport()
	if vp == null:
		_hover_tooltip.visible = false
		return
	var query_pos: Vector2
	if _view_mode == ViewMode.FIRST_PERSON:
		query_pos = vp.get_visible_rect().size / 2.0
	else:
		query_pos = vp.get_mouse_position()
	var tile := _tile_under_screen_pos(query_pos)
	var text := _hover_text_at_tile(tile)
	if text == "":
		_hover_tooltip.visible = false
		return
	_hover_label.text = text
	_hover_tooltip.position = _panel_position_near(_hover_tooltip, query_pos)
	_hover_tooltip.visible = true


## Where a cursor-following panel goes: offset from the cursor, then kept
## inside the viewport.
##
## The clamp is new with build mode and is not cosmetic — the placement prompt
## is three lines wide and the cursor spends most of its time near the right
## of the screen while a factory is being extended eastward, so without it the
## panel telling the player whether the click will work runs off the edge.
## (Found the only way it could be: in a rendered frame — UI_UX.md §2b
## point 12.) It flips to the other side of the cursor rather than sliding, so
## the panel never sits on top of the tile it is describing.
func _panel_position_near(panel: Control, anchor: Vector2) -> Vector2:
	var size := panel.get_combined_minimum_size()
	var vp := get_viewport()
	var bounds := vp.get_visible_rect().size if vp != null else Vector2(1600, 900)
	var pos := anchor + HOVER_TOOLTIP_OFFSET
	if pos.x + size.x > bounds.x:
		pos.x = anchor.x - HOVER_TOOLTIP_OFFSET.x - size.x
	if pos.y + size.y > bounds.y:
		pos.y = anchor.y - HOVER_TOOLTIP_OFFSET.y - size.y
	return Vector2(maxf(pos.x, 0.0), maxf(pos.y, 0.0))


## Drives the contract clipboard (UI_UX.md §5) from `economy_snapshot_json`:
## the one shared money figure, the one shared dock pool, and then EVERY
## active contract's own docket — its checklist boxes, its numeric progress
## and its own countdown to its own next delivery check.
func _update_contract_panel() -> void:
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_contract_money_label.text = "Money: %.0f" % float(econ["money"])
	_update_contract_dock(econ.get("delivery_stock", []))

	var contracts: Array = econ.get("contracts", [])
	if not _contract_cards_match(contracts):
		_rebuild_contract_cards(contracts)

	var current_tick: int = sim.current_tick()
	for i in range(min(contracts.size(), _contract_cards.size())):
		_update_contract_card(_contract_cards[i], contracts[i], current_tick)

	# Cap the docket stack's height rather than letting it grow off the
	# bottom of the screen: past the cap it scrolls. `data/contracts.ron`
	# ships three and this never engages, which is the intent — a handful of
	# concurrent orders is the realistic board (GAMEPLAY.md §6 names no
	# count), so this is a safety valve for a content change rather than a
	# compact/summary mode nobody needs yet.
	var natural_height: float = _contract_cards_box.get_combined_minimum_size().y
	# A headless SceneTree run has no viewport at all, and a window that has
	# not laid out yet reports a zero rect — neither must collapse the stack
	# to nothing, so "no viewport" means "no cap", not "a cap of zero".
	var viewport := get_viewport()
	var cap: float = viewport.get_visible_rect().size.y * CONTRACT_LIST_MAX_HEIGHT_RATIO if viewport != null else 0.0
	_contract_cards_scroll.custom_minimum_size.y = min(natural_height, cap) if cap > 0.0 else natural_height

	# Re-anchor every update, not just once at build time: the panel's
	# minimum size grows once real text ("Money: 1234", "Next check in 1000
	# ticks") replaces the empty labels it was built with, and PRESET_MINSIZE
	# only computes offsets once, at the moment it's called — without this,
	# the panel stays sized/positioned for its build-time (near-empty) text
	# and later, wider text spills past its right edge.
	_contract_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE, 16)


## True when the built dockets already correspond, in order, to the reported
## contracts — the cheap guard that keeps _update_contract_panel from
## rebuilding nodes every frame for a list that never changes.
func _contract_cards_match(contracts: Array) -> bool:
	if contracts.size() != _contract_card_ids.size():
		return false
	for i in range(contracts.size()):
		if String(contracts[i].get("id", "")) != String(_contract_card_ids[i]):
			return false
	return true


## The shared delivery pool, shown once above the dockets.
##
## This line is the player-visible face of sim_core's allocation rule: there
## is ONE pile of collected stock and a settling contract CONSUMES its mix
## from it, so a box is never credited to two orders. Without it, three
## dockets whose checklists all read "2/2" look like three imminent payouts
## when the dock may hold only two boxes total — the checklists are each
## clamped to their own ask (that clamping is sim_core's, deliberately), and
## this unclamped number is what reconciles them. It is one line of text
## rather than a new widget: surfacing the rule is worth it, inventing a
## second progress language for it is not.
func _update_contract_dock(stock: Array) -> void:
	var seen: Dictionary = {}
	for pair in stock:
		var item_id: String = String(pair[0])
		var qty: int = int(pair[1])
		seen[item_id] = true
		var entry: Dictionary = _contract_dock_entries.get(item_id, {})
		if entry.is_empty():
			entry = _build_contract_dock_entry(item_id)
			_contract_dock_entries[item_id] = entry
		entry["label"].text = "%d" % qty
		entry["row"].visible = true
	for item_id in _contract_dock_entries:
		if not seen.has(item_id):
			_contract_dock_entries[item_id]["row"].visible = false
	# `delivery_stock` reports non-zero entries only, so an empty array is
	# genuinely "nothing on the dock" — say so rather than showing a bare label.
	_contract_dock_empty_label.visible = stock.is_empty()


func _build_contract_dock_entry(item_id: String) -> Dictionary:
	var row := HBoxContainer.new()
	row.name = "dock_%s" % item_id
	row.add_theme_constant_override("separation", 3)
	_contract_dock_row.add_child(row)

	var icon := TextureRect.new()
	icon.custom_minimum_size = Vector2(14, 14)
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	row.add_child(icon)

	var label := Label.new()
	label.label_settings = _contract_meta_settings
	row.add_child(label)
	return {"row": row, "label": label, "icon": icon}


## One docket's live state. `progress` is sim_core's per-contract, clamped
## coverage of this contract's own mix (a checklist reads 2/2, never 7/2);
## the unclamped pool it is drawn from is the dock line above.
func _update_contract_card(card: Dictionary, contract: Dictionary, current_tick: int) -> void:
	var mix: Array = contract.get("mix", [])
	var progress: Array = contract.get("progress", [])
	var rows: Dictionary = card["rows"]
	for i in range(mix.size()):
		var item_id: String = String(mix[i][0])
		var required: int = int(mix[i][1])
		var have: int = int(progress[i][1]) if i < progress.size() else 0

		var row: Dictionary = rows.get(item_id, {})
		if row.is_empty():
			continue
		row["label"].text = "%s  %d/%d" % [item_id, have, required]

		var boxes: Array = row["boxes"]
		if boxes.size() == 1 and required > CONTRACT_CHECKLIST_MAX_BOXES:
			# The single-box fallback (see _build_contract_checklist_row):
			# checked only once the whole quantity is in.
			_set_checkbox_checked(boxes[0], have >= required)
		else:
			for u in range(boxes.size()):
				_set_checkbox_checked(boxes[u], u < have)

	# Each contract clocks independently in sim_core, so this countdown is
	# this docket's, never a shared one. The tally beside it is the only
	# feedback a player gets that an order is being under-served: a missed
	# window costs that window's payout and nothing else today (GAMEPLAY.md
	# §11 has not decided what else it should cost), so the count is the
	# whole consequence and it should be visible.
	var ticks_left: int = max(0, int(contract.get("next_delivery_tick", 0)) - current_tick)
	card["meta_label"].text = "next check in %d ticks  ·  every %d  ·  %d done, %d missed" % [
		ticks_left,
		int(contract.get("cadence_ticks", 0)),
		int(contract.get("deliveries_made", 0)),
		int(contract.get("deliveries_missed", 0)),
	]


## Swaps a checklist box's style (and its tick-mark visibility) between the
## checked/unchecked StyleBoxFlat pair — same pattern as the machine status
## lamps' idle/running material swap above, applied to a UI checkbox instead
## of a 3D emissive mesh.
func _set_checkbox_checked(box: Panel, checked: bool) -> void:
	if bool(box.get_meta("checked", false)) == checked:
		return
	box.set_meta("checked", checked)
	box.add_theme_stylebox_override("panel", _checkbox_style_checked if checked else _checkbox_style_unchecked)
	var mark: Label = box.get_node_or_null("Mark")
	if mark != null:
		mark.visible = checked


## Returns a small isometric icon texture for an item id, generated offline
## from the same real voxel model the item renders as in the world
## (UI_UX.md §5 — "icons ... rendered from the real assets ... not
## separately-drawn 2D icon art"; see assets/voxels/generators/icons.rs and
## assets/voxels/README.md for how the PNG itself is produced). Resolves the
## item id to an asset name via ITEM_MODELS, same mapping `_item_node_for`
## already uses for the item's in-world mesh, so an icon and its in-world
## model can never silently drift apart.
##
## Cached per asset name — never re-loads or re-renders on repeat calls
## (icons are static build output, not something that changes at runtime).
## An id with no icon, or one whose PNG isn't present on disk (e.g. `cargo
## xtask` was never run, or vengi wasn't installed when icons/ was last
## regenerated), still returns a real, non-null Texture2D: a plain
## placeholder swatch, never null and never a silently-broken texture.
func _icon_for(item_id: String) -> Texture2D:
	return _icon_for_asset(ITEM_MODELS.get(item_id, ITEM_MODEL_FALLBACK))


## The loading/caching/fallback half of `_icon_for`, keyed by ASSET name
## rather than item id — extracted (behaviour unchanged) when the build menu
## needed icons for *buildable kinds*, which resolve through SHOP_MODELS/
## MACHINE_MODELS instead of ITEM_MODELS. Both callers share this one cache
## and this one documented fallback; there is deliberately not a second icon
## system.
func _icon_for_asset(asset: String) -> Texture2D:
	if _icon_cache.has(asset):
		return _icon_cache[asset]

	var texture: Texture2D = null
	var path := ICON_DIR + asset + ".png"
	if ResourceLoader.exists(path):
		var loaded = load(path)
		if loaded is Texture2D:
			texture = loaded

	if texture == null:
		texture = _fallback_icon_texture()

	_icon_cache[asset] = texture
	return texture


## The documented fallback `_icon_for` returns when no real icon PNG could
## be loaded. Built once and reused — a flat, muted swatch, deliberately
## plain enough that it reads as "no icon" rather than as a broken asset.
func _fallback_icon_texture() -> Texture2D:
	if _icon_fallback_texture == null:
		var img := Image.create(8, 8, false, Image.FORMAT_RGBA8)
		img.fill(Color(0.5, 0.5, 0.5, 0.6))
		_icon_fallback_texture = ImageTexture.create_from_image(img)
	return _icon_fallback_texture


func _format_counts(pairs: Array) -> String:
	if pairs.is_empty():
		return "-"
	var parts: Array[String] = []
	for pair in pairs:
		parts.append("%s x%d" % [pair[0], int(pair[1])])
	return ", ".join(parts)
