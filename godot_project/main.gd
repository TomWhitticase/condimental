func _ready() -> void:
	sim = SimBridge.new()
	# What world this is — a fresh one, or the save the main menu picked.
	# Everything after this point is identical either way, which is the whole
	# reason `SimBridge` has both `new_game()` and `load_ron()` behind one
	# long-lived bridge.
	_apply_pending_session()
	_load_voxel_materials()
	_build_environment()
	# The world the player has built — NOTHING, in a new game. This is a real
	# starting state now, not a degenerate one: `World::new` places nothing at
	# all, so the first thing the scene draws is bare floor with a build menu
	# over it, and everything else appears as the player puts it there.
	_rebuild_world()
	_build_camera()
	# The game's first sound (`audio.gd`), built before the UI because the
	# pause menu's SOUND switch reads its state to caption itself. Synthesised
	# here rather than loaded: the waveforms are code, not committed `.wav`
	# blobs — see that file's header for why.
	_audio = FactoryAudio.new()
	_audio.setup(self)
	_build_ui()
	_build_ghost_layer()
	_refresh_owned_counts()
	_update_contract_panel() # fill in real text/sizing before the first frame draws
	_update_fluid_network() # show tick 0's fluid levels, not an empty pipe run
	_apply_dirty_chunks() # render tick 0's (empty) state immediately
	# A loaded world arrives with product mid-belt, hoppers part full and
	# contracts part way through their windows, so every per-frame updater is
	# run once here rather than left to the first `_process`. Two of them —
	# the larder and the hotbar — would otherwise draw a NEW GAME's counts
	# over a loaded game's inventory for one frame.
	_refresh_buffers()
	_update_hotbar()
	_update_larder()
	# The window's close button is the other way a session ends, and it has
	# to autosave before the process goes away — which means intercepting it
	# rather than letting the default close handling quit underneath us. See
	# `_notification`.
	if is_inside_tree():
		get_tree().auto_accept_quit = false


## Applies whatever `menu.tscn` armed on the `GameSession` autoload: a fresh
## world, or the save file it already proved loads.
##
## Reading the pending action does NOT clear it — see `game_session.gd` for
## why sticky rather than consumed. The `session == null` branch is what
## keeps every headless test that instantiates `main.tscn` directly working
## exactly as it did before this ticket: no singleton, no pending action, new
## game.
##
## The load is defensive even though the menu validated the file first: the
## file could have been deleted or truncated in the seconds between, and the
## honest response to that is a fresh world plus a printed reason, not a
## crash. It cannot be a silent fresh world — that is the failure this whole
## ticket exists to avoid — so it prints, and the menu (which is where a
## player can actually act on it) is the screen that shows the message in the
## normal case.
func _apply_pending_session() -> void:
	# Print once per launch, so a developer hunting for save files does not
	# have to know Godot's per-platform `user://` layout. Static, because
	# every headless test calls `_ready()` a second time by hand and one line
	# is a note where two are noise.
	if not _printed_saves_dir:
		_printed_saves_dir = true
		print("Sauce Factory saves: %s" % GameSaves.resolved_saves_dir())
	var session := _session()
	if session == null or String(session.pending_action) != "load":
		sim.new_game()
		_save_slot = DEFAULT_SLOT
		return
	var path := String(session.pending_path)
	var text: String = GameSaves.read_save(path)
	var refusal: String = sim.load_ron(text) if text != "" else "could not read %s" % path
	if refusal != "":
		printerr("Sauce Factory: could not load %s — %s" % [path, refusal])
		sim.new_game()
		_save_slot = DEFAULT_SLOT
		return
	_save_slot = String(session.current_slot)
	if _save_slot == "" or GameSaves.is_reserved_slot(_save_slot):
		# A game resumed from the autosave saves to a real slot by default,
		# not back over the autosave — the reserved-name rule applies to the
		# prefilled suggestion too, or the very first press of Save would be
		# refused for a name the player never typed.
		_save_slot = DEFAULT_SLOT


## The `GameSession` autoload, or null.
##
## Reached through the main loop's own root rather than through
## `get_node("/root/GameSession")`, because this scene is instantiated
## OUTSIDE the active scene tree by every headless test script (they
## `add_child` it to the root window and call `_ready()` themselves), and an
## absolute node path resolved from there is an engine error rather than a
## null. Null is the answer this wants: no singleton, no pending action, new
## game.
func _session() -> Node:
	var loop := Engine.get_main_loop()
	if not (loop is SceneTree):
		return null
	var tree_root: Node = (loop as SceneTree).root
	return tree_root.get_node_or_null("GameSession") if tree_root != null else null


# --------------------------------------------------------------------------
# Assets
# --------------------------------------------------------------------------

## Rebuilds one `StandardMaterial3D` per material class from
## `voxels/materials.json`, which `voxgen` exports straight out of
## `assets/voxels/palette.ron`. The numbers deliberately are NOT written down
## here: palette.ron stays the single source of truth for colour and material
## (UI_UX.md §2a point 5), and GDScript just consumes it.
func _load_voxel_materials() -> void:
	var defaults := {
		"matte": {"metallic": 0.0, "roughness": 0.95, "emission_energy": 0.0},
		"metal": {"metallic": 0.9, "roughness": 0.18, "emission_energy": 0.0},
		"emissive": {"metallic": 0.0, "roughness": 0.55, "emission_energy": 2.6},
		"liquid": {"metallic": 0.0, "roughness": 0.14, "emission_energy": 0.0},
	}
	var table: Dictionary = defaults
	var parsed = _read_json(VOX_DIR + "materials.json")
	if parsed is Dictionary:
		table = parsed
	else:
		push_warning("voxels/materials.json missing — falling back to built-in material values")

	for class_name_ in table.keys():
		var def: Dictionary = table[class_name_]
		_class_materials[class_name_] = _make_material(
			float(def.get("metallic", 0.0)),
			float(def.get("roughness", 1.0)),
			float(def.get("emission_energy", 0.0))
		)

	# Two variants of the emissive material so a machine's status lamps can
	# actually report state (UI_UX.md §4/§7: saturated colour reserved for
	# meaning, never decoration). Same mesh, swapped override material.
	var lamp_energy: float = float(table.get("emissive", defaults["emissive"]).get("emission_energy", 2.6))
	_lamp_idle = _make_material(0.0, 0.6, lamp_energy * 0.25)
	_lamp_running = _make_material(0.0, 0.45, lamp_energy)

	var index = _read_json(VOX_DIR + "index.json")
	if index is Dictionary:
		_asset_classes = index


func _make_material(metallic: float, roughness: float, emission_energy: float) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	# Voxel meshes carry their colour per vertex, straight from the .vox
	# palette — there are no textures anywhere in this pipeline.
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.metallic = metallic
	mat.roughness = roughness
	if emission_energy > 0.0:
		mat.emission_enabled = true
		mat.emission = Color(1, 1, 1)
		# MULTIPLY, not ADD: the emissive mesh holds several differently
		# coloured lamps, and a flat additive emission would wash them all to
		# the same white. Multiplying by albedo keeps green reading as green.
		mat.emission_operator = BaseMaterial3D.EMISSION_OP_MULTIPLY
		mat.emission_energy_multiplier = emission_energy
	return mat


func _read_json(path: String):
	if not FileAccess.file_exists(path):
		return null
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		return null
	return JSON.parse_string(text)


## Builds one asset as a `Node3D` holding a `MeshInstance3D` per material
## class it uses. Returns an empty node (with a warning) rather than failing
## if the models haven't been staged — `cargo xtask` is what puts them in
## res://voxels/, and a missing asset should not take down the whole scene.
func _asset_node(asset: String) -> Node3D:
	var root := Node3D.new()
	root.name = asset

	var built := 0
	for class_name_ in _asset_class_names(asset):
		var mesh := _class_mesh_for(asset, class_name_)
		if mesh == null:
			continue
		var mi := MeshInstance3D.new()
		mi.name = String(class_name_)
		mi.mesh = mesh
		# Only when there IS one: assigning a null override makes the headless
		# dummy renderer log "Parameter 'material' is null" when the node is
		# later freed, which is noise in every test log.
		var class_material = _class_materials.get(class_name_, null)
		if class_material != null:
			mi.set_surface_override_material(0, class_material)
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		root.add_child(mi)
		built += 1

	if built == 0:
		push_warning("no voxel meshes for '%s' under %s — run `cargo xtask`" % [asset, VOX_DIR])
	return root


func _mesh_for(asset: String) -> Mesh:
	var path := VOX_DIR + asset + ".vox"
	if not ResourceLoader.exists(path):
		return null
	return load(path) as Mesh


## The material classes an asset was split into by `voxgen` (from
## `index.json`), or every class when the index is missing — a class with no
## file simply contributes no mesh.
func _asset_class_names(asset: String) -> Array:
	return _asset_classes.get(asset, ["matte", "metal", "emissive", "liquid"])


## One asset's per-class mesh (`name.<class>.vox`, UI_UX.md §2b point 2), or
## null when that class was not written for it or failed to import.
func _class_mesh_for(asset: String, class_name_: String) -> Mesh:
	var path := "%s%s.%s.vox" % [VOX_DIR, asset, class_name_]
	if not ResourceLoader.exists(path):
		return null
	return load(path) as Mesh


# --------------------------------------------------------------------------
# World
# --------------------------------------------------------------------------

## Tile (x, y) in simulation space -> the centre of that tile in world space.
## The sim's chain runs along +X at y = 0; the importer centres each model on
## its own footprint, so a tile centre is exactly where an asset node goes.
func _tile_origin(tx: int, ty: int, height: float) -> Vector3:
	return Vector3(float(tx) * TILE, height, float(ty) * TILE)


## Where a node goes for a building that occupies a whole FOOTPRINT rather
## than a single tile (the "Machines improvement" milestone's ticket 1).
##
## `origin` is the footprint's minimum-X/minimum-Y corner — the tile the
## belt feeds into — and the building covers `size.x` x `size.y` tiles
## growing east/north from it (`sim::machines`'s module doc states that
## convention once; nothing here re-derives it). The voxel encoder puts a
## model's origin at its own footprint CENTRE at ground level, so the node
## belongs at the centre of that rectangle, which for a 1x1 building is
## exactly `_tile_origin` — i.e. this generalizes the old placement rather
## than replacing it, and every existing 1x1 kind stays on the tile it was
## on before.
func _footprint_centre(origin: Vector2i, size: Vector2i, height: float) -> Vector3:
	return Vector3(
		(float(origin.x) + float(size.x - 1) * 0.5) * TILE,
		height,
		(float(origin.y) + float(size.y - 1) * 0.5) * TILE
	)


## `{"width_tiles": w, "height_tiles": h}` (as every snapshot spells a
## footprint) -> Vector2i, defaulting to 1x1 so a snapshot from an older
## SimBridge without the field still renders.
func _footprint_size(footprint) -> Vector2i:
	if not (footprint is Dictionary):
		return Vector2i.ONE
	return Vector2i(
		maxi(1, int(footprint.get("width_tiles", 1))),
		maxi(1, int(footprint.get("height_tiles", 1)))
	)


## A tile as the string key `_occupancy`/`_by_origin`/every per-placement
## dictionary in this file are keyed by. One helper rather than the "%d,%d"
## literal repeated a dozen times, because a mismatched key is silent.
func _tile_key(tile: Vector2i) -> String:
	return "%d,%d" % [tile.x, tile.y]


## --- Facing (the "Real Placement" epic's ticket 2) -------------------------
##
## `sim::types::Direction` is four-way and every belt, pipe, machine and
## building on the wire now carries one. This array is in the simulation's
## own CLOCKWISE order (`Direction::rotate_cw`: east -> south -> west ->
## north), so rotating the ghost is one step along it and the yaw below is
## simply `index * 90 degrees` — which is why the two are one table rather
## than two that have to agree.
const DIRECTIONS := ["east", "south", "west", "north"]

## Tile-space unit offset per direction, matching `Direction::offset`:
## **east is +X and north is +Y** (see that type's own doc — the axis
## convention is the simulation's, not this file's, and is never re-derived
## here).
const DIRECTION_OFFSETS := {
	"east": Vector2i(1, 0),
	"south": Vector2i(0, -1),
	"west": Vector2i(-1, 0),
	"north": Vector2i(0, 1),
}


func _direction_index(direction: String) -> int:
	var i: int = DIRECTIONS.find(direction)
	return i if i >= 0 else 0


func _direction_offset(direction: String) -> Vector2i:
	return DIRECTION_OFFSETS.get(direction, Vector2i(1, 0))


## The Y-axis rotation that turns a model authored facing EAST into one
## facing `direction`.
##
## Every voxel asset in this project is modelled with its product path
## running along +X, because until this epic that was the only direction
## anything could face. Tile (x, y) maps to world (x, ., y) — sim +Y is world
## +Z — and a Godot rotation of `t` about +Y sends local +X to world
## `(cos t, 0, -sin t)`. So east is 0, south (sim -Y, world -Z) is +90,
## west is 180 and north is -90 — i.e. exactly `index * 90` along DIRECTIONS,
## which is the whole reason that array is in clockwise order.
##
## **This is all the rotation any asset needs.** The encoder puts a model's
## origin at its own footprint centre at ground level (UI_UX.md §2b), so a
## rotated placement is the same mesh spun about that origin and re-centred
## on the rotated rectangle — no new geometry. That includes a belt corner
## (`_belt_shape_for`): the corner models are authored with their output on
## +X like every straight, so the same yaw turns them. The one asset family
## that still keeps an east-only member is the pipe's `pipe_inlet`, ticket
## 6's to retire.
func _direction_yaw(direction: String) -> float:
	return deg_to_rad(float(_direction_index(direction)) * 90.0)


## The rectangle a kind actually claims once turned: a quarter turn SWAPS the
## extents, anchored at the same origin corner (`sim::machines`'s module doc
## owns that rule; this is its one presentation-side restatement).
func _rotated_footprint(size: Vector2i, direction: String) -> Vector2i:
	if direction == "north" or direction == "south":
		return Vector2i(size.y, size.x)
	return size


## Every tile a placement of `size` at `origin` facing `direction` covers.
func _placement_tiles(origin: Vector2i, size: Vector2i, direction: String) -> Array:
	var rotated := _rotated_footprint(size, direction)
	var tiles: Array = []
	for dy in range(rotated.y):
		for dx in range(rotated.x):
			tiles.append(Vector2i(origin.x + dx, origin.y + dy))
	return tiles


## Re-reads `world_layout_json` into the three indexes the rest of this file
## asks questions of: the placements themselves, a lookup by origin tile, and
## an occupancy map from *every* covered tile back to the placement's origin.
##
## The occupancy map is what makes "point at a machine, not at its corner"
## work here the way it already does in the simulation (`World::query_tile`,
## `Remove`, `Rotate` all resolve from any tile of a footprint), and it is
## also the whole of the ghost's validity check — see `_ghost_blocked`.
##
## `occupies` comes straight off the wire rather than being re-derived from
## `footprint` + `direction`: the simulation reports both precisely so a
## consumer can take whichever it needs (see `sim::PlacementSnapshot`).
func _read_world_layout() -> void:
	_placements.clear()
	_by_origin.clear()
	_occupancy.clear()
	var parsed = JSON.parse_string(sim.world_layout_json())
	if not (parsed is Array):
		return
	for placement in parsed:
		if not (placement is Dictionary):
			continue
		_placements.append(placement)
		var origin := _placement_origin(placement)
		var key := _tile_key(origin)
		_by_origin[key] = placement
		# A kind's declared footprint is content (data/machines.ron) and the
		# only place it reaches this scene is on a placement — so every
		# placement teaches it, for the ghost of a kind nothing has placed
		# yet to fall back on. See `_kind_footprint`.
		_kind_footprints[String(placement.get("kind", ""))] = _footprint_size(placement.get("footprint"))
		for pair in placement.get("occupies", []):
			if pair is Array and pair.size() >= 2:
				_occupancy[_tile_key(Vector2i(int(pair[0]), int(pair[1])))] = key


func _placement_origin(placement: Dictionary) -> Vector2i:
	var pair: Array = placement.get("tile", [0, 0])
	return Vector2i(int(pair[0]), int(pair[1]))


func _placement_direction(placement: Dictionary) -> String:
	return String(placement.get("direction", "east"))


## Whichever placement covers `tile`, or `{}`. Any tile of a multi-tile
## footprint answers, via `_occupancy`.
func _placement_at_tile(tile: Vector2i) -> Dictionary:
	var origin_key: String = _occupancy.get(_tile_key(tile), "")
	if origin_key == "":
		return {}
	return _by_origin.get(origin_key, {})


## The declared (unrotated) footprint of a buildable kind, for a GHOST of
## something not yet placed.
##
## Nothing on the wire reports a kind's footprint before one exists — every
## snapshot describes a *placement* — so this learns it two ways, in order.
## (1) From any placement of that kind in the world, which is the
## simulation's own number and therefore authoritative. (2) Failing that,
## from the kind's own voxel model: UI_UX.md's asset scale fixes one tile at
## 32 voxels and the "Machines improvement" epic's ticket 4 made a kind's
## model size and its `machines.ron` footprint *deliberately coupled* — the
## 2x2 cooking vat is modelled at 64x64 — so the mesh's own extent in tiles
## IS the footprint, rounded. It is derived rather than typed into a table
## here on purpose: a hand-written kind -> size table is exactly the kind of
## presentation-side lookup keyed by a content id that UI_UX.md §2b point 12
## records going silently stale.
func _kind_footprint(kind: String) -> Vector2i:
	if _kind_footprints.has(kind):
		return _kind_footprints[kind]
	var size := Vector2i.ONE
	var mesh := _mesh_for(_shop_asset_for(kind))
	if mesh != null:
		var aabb := mesh.get_aabb()
		size = Vector2i(
			maxi(1, roundi(aabb.size.x / TILE)),
			maxi(1, roundi(aabb.size.z / TILE))
		)
	_kind_footprints[kind] = size
	return size


## The tile bounding box of everything currently placed — `position` is the
## minimum tile and `size` the inclusive span, so the covered range is
## `position .. position + size`. An EMPTY world (the new starting state)
## reports a degenerate box at the origin, which is what the floor and the
## camera then pad out.
func _world_tile_bounds() -> Rect2i:
	var seen := false
	var min_tile := Vector2i.ZERO
	var max_tile := Vector2i.ZERO
	for key in _occupancy.keys():
		var parts: PackedStringArray = String(key).split(",")
		var tile := Vector2i(int(parts[0]), int(parts[1]))
		if not seen:
			min_tile = tile
			max_tile = tile
			seen = true
			continue
		min_tile = Vector2i(mini(min_tile.x, tile.x), mini(min_tile.y, tile.y))
		max_tile = Vector2i(maxi(max_tile.x, tile.x), maxi(max_tile.y, tile.y))
	return Rect2i(min_tile, max_tile - min_tile)


## The poured-concrete factory floor. Drawn as one `MultiMeshInstance3D`
## rather than one node per tile: the floor is the only asset whose instance
## count scales with the size of the world, so it is the one worth batching.
## The tile's darker perimeter is what keeps the grid legible (UI_UX.md §1).
##
## Its extent follows the placed world rather than a fixed chain length, and
## it is rebuilt only when those bounds actually change — which for an empty
## world (nothing placed, the state the game now starts in) is a square of
## bare floor centred on the origin, i.e. somewhere to build.
func _build_floor() -> void:
	var bounds := _world_tile_bounds()
	if _floor_node != null and bounds == _floor_bounds:
		return
	_floor_bounds = bounds

	var mesh := _mesh_for("floor_tile")
	if mesh == null:
		push_warning("floor_tile mesh missing — skipping floor")
		return

	var x_from := bounds.position.x - FLOOR_GROUND_MARGIN_X
	var x_to := bounds.position.x + bounds.size.x + FLOOR_GROUND_MARGIN_X
	var z_from := bounds.position.y - FLOOR_GROUND_MARGIN_Z
	var z_to := bounds.position.y + bounds.size.y + FLOOR_GROUND_MARGIN_Z

	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.mesh = mesh
	multimesh.instance_count = (x_to - x_from + 1) * (z_to - z_from + 1)

	var i := 0
	for tz in range(z_from, z_to + 1):
		for tx in range(x_from, x_to + 1):
			multimesh.set_instance_transform(i, Transform3D(Basis(), _tile_origin(tx, tz, 0.0)))
			i += 1

	if _floor_node != null:
		remove_child(_floor_node)
		_floor_node.free()
	_floor_node = MultiMeshInstance3D.new()
	_floor_node.name = "Floor"
	_floor_node.multimesh = multimesh
	# The floor takes shadows from the machinery but casts none of its own.
	_floor_node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(_floor_node)
	var floor_material = _class_materials.get("matte", null)
	if floor_material != null:
		_floor_node.material_override = floor_material


## The opposite side to `direction` — where a straight belt's feed comes
## from.
func _direction_opposite(direction: String) -> String:
	return DIRECTIONS[(_direction_index(direction) + 2) % 4]


## One quarter turn clockwise from `direction` (`Direction::rotate_cw`).
func _direction_cw(direction: String) -> String:
	return DIRECTIONS[(_direction_index(direction) + 1) % 4]


## One quarter turn anticlockwise from `direction`.
func _direction_ccw(direction: String) -> String:
	return DIRECTIONS[(_direction_index(direction) + 3) % 4]


## Which BELT_SHAPE_* a belt tile carrying toward `direction` takes, given
## the `links` the simulation reports for it (the plan's "Shape rules").
##
## The rule, in order:
##   * an input from BEHIND (the side opposite `direction`) makes the tile
##     straight whatever else feeds it — a flank feed on top of it is a
##     MERGE, which is a straight tile with two feeds, not a corner;
##   * otherwise exactly one input from a FLANK is a corner: fed from the
##     side one quarter turn anticlockwise from its facing it turns LEFT (a
##     belt running east fed from the north), fed from the clockwise side it
##     turns RIGHT. That is how ticket 2 authored the models, and it is also
##     what "turn left" means to the product: heading south with east on
##     your left, you turn left to go east;
##   * two flank inputs with nothing behind is a merge (straight);
##   * anything else with no inputs is a line START (a lone tile counts as
##     one — it is the start of the line being laid), with inputs but no
##     output a line END, and the rest is plain straight.
##
## An input from the tile the belt points AT (a hopper facing a belt that
## faces it back) is neither behind nor a flank: it is reported in hover and
## drawn straight, since no model describes it. Pure — `links` in, a word
## out — so a test can hand it any shape it likes.
func _belt_shape_for(links: Dictionary, direction: String) -> String:
	var inputs: Array = links.get("inputs", [])
	var behind := _direction_opposite(direction)
	var left := _direction_ccw(direction)
	var right := _direction_cw(direction)
	var from_behind := false
	var flanks: Array = []
	for input in inputs:
		var from := String(input.get("from", ""))
		if from == behind:
			from_behind = true
		elif from == left or from == right:
			flanks.append(from)
	if not from_behind and flanks.size() == 1:
		return BELT_SHAPE_CORNER_LEFT if flanks[0] == left else BELT_SHAPE_CORNER_RIGHT
	if inputs.size() >= 2:
		return BELT_SHAPE_MERGE
	if inputs.is_empty():
		return BELT_SHAPE_START
	if links.get("output") == null:
		return BELT_SHAPE_END
	return BELT_SHAPE_STRAIGHT


## The frame set a belt of `shape` draws with: `BELT_FRAMES` asset names in
## frame order, all in the same family.
func _belt_frames_for_shape(shape: String) -> Array:
	var family := String(BELT_SHAPE_FAMILIES.get(shape, "belt"))
	var frames: Array = []
	for k in range(BELT_FRAMES):
		frames.append("%s_f%d" % [family, k])
	return frames


## Which animation frame every belt shows at simulation tick `tick`: the
## plan's `floor(tick * BELT_FRAMES / BELT_TICKS_PER_TILE) mod BELT_FRAMES`.
## The pattern therefore crosses a tile in exactly the ticks an item does,
## and because it is a function of the TICK and nothing else it stands
## still whenever the simulation does — the pause menu, or a headless test
## that never ticks.
func _belt_frame_for_tick(tick: int) -> int:
	return posmod((tick * BELT_FRAMES) / BELT_TICKS_PER_TILE, BELT_FRAMES)


## Shows the frame the current tick calls for, if it changed. Called once
## per simulation step from `_advance_simulation`; a change is a handful of
## visibility flips (`_set_tile_frame`), so this is cheap to call every
## frame and free when nothing moved.
func _update_belt_frame() -> void:
	var frame := _belt_frame_for_tick(sim.current_tick())
	if frame != _tile_frame:
		_set_tile_frame(frame)


## Whether `tile` is covered by something a belt hands product to or takes it
## from — a machine, a hopper, a fluid tank or a dock, i.e. anything that is
## not itself a length of conveyor or pipe.
##
## A SPLITTER counts as conveyor here, not as a building: it is a belt tile
## with a choice at the end (`sim_core/src/sim/splitter.rs`). Since the belt
## family stopped having junction variants this is read only by the pipe
## role pass (`_rebuild_world`), which ticket 6 replaces with `links`.
func _is_building_tile(tile: Vector2i) -> bool:
	var placement := _placement_at_tile(tile)
	if placement.is_empty():
		return false
	var kind := String(placement.get("kind", ""))
	return kind != BELT_KIND and kind != PIPE_KIND and kind != SPLITTER_KIND


## The shape one pipe tile draws, from the sides it is joined on.
##
## `faces` is the list of absolute directions in `links.connections`
## (`"north"|"east"|"south"|"west"`, any order); `direction` is the
## placement's own facing, consulted ONLY when nothing is joined. Returns
## `{"asset", "fluid_asset", "turns", "yaw"}`: the shape model, its liquid
## body, and the number of clockwise quarter turns (and the yaw that is)
## that puts the authored openings on `faces`.
##
## The authored openings, in `DIRECTIONS` index terms (east 0, south 1,
## west 2, north 3), are the pipe section header's: a corner on {0, 3}, a
## tee on {0, 2, 3} (everything but south), an end on {2}, a straight on
## {0, 2}. One clockwise turn adds one to every index — the same turn
## `Direction::rotate_cw` and `VoxModel::rotated_cw` make, so what the
## voxgen tests prove about a turned model is what this draws.
func _pipe_shape_for(faces: Array, direction: String) -> Dictionary:
	var joined: Array = []
	for face in faces:
		var index := DIRECTIONS.find(String(face))
		if index >= 0 and not joined.has(index):
			joined.append(index)
	joined.sort()
	var asset := PIPE_ASSET
	var turns := 0
	match joined.size():
		0:
			# Joined to nothing: a bare length along the axis it was placed
			# on. The only case the placement's `direction` decides.
			turns = 1 if direction == "north" or direction == "south" else 0
		1:
			# An end is authored open on west (2); turn it until west lands
			# on the one joined side.
			asset = PIPE_END_ASSET
			turns = posmod(int(joined[0]) - 2, 4)
		2:
			var a := int(joined[0])
			var b := int(joined[1])
			if (a + 2) % 4 == b:
				# Opposite sides: a straight, and always the SAME turn for
				# an axis (see the constants' doc for the flange rule).
				turns = 0 if a == 0 else 1
			else:
				# Adjacent sides: the corner is authored on (0, 3) — a side
				# and the side one step anticlockwise of it — so the turn
				# count is whichever joined side has the other as its
				# anticlockwise neighbour.
				asset = PIPE_CORNER_ASSET
				turns = a if posmod(a - 1, 4) == b else b
		3:
			# A tee is authored closed on south (1); turn it until south
			# lands on the one side that is NOT joined.
			asset = PIPE_TEE_ASSET
			var missing := 0
			for index in range(4):
				if not joined.has(index):
					missing = index
			turns = posmod(missing - 1, 4)
		_:
			asset = PIPE_CROSS_ASSET
	return {
		"asset": asset,
		"fluid_asset": String(PIPE_FLUID_ASSETS.get(asset, PIPE_FLUID_ASSET)),
		"turns": turns,
		"yaw": deg_to_rad(float(turns) * 90.0),
	}


## The fitting record for one non-pipe connection: which asset stands on
## which side, and the yaw that turns the fitting's authored +X face onto
## that side (`DIRECTIONS` index × 90°, exactly `_direction_yaw`). `{}` for
## a pipe-to-pipe connection, which takes no fitting.
func _pipe_fitting_for(connection: Dictionary) -> Dictionary:
	var kind := String(connection.get("kind", ""))
	var to := String(connection.get("to", ""))
	var asset := ""
	if kind == PIPE_LINK_MACHINE:
		asset = PIPE_FITTING_MACHINE_ASSET
	elif kind == PIPE_LINK_TANK:
		asset = PIPE_FITTING_TANK_ASSET
	if asset == "" or DIRECTIONS.find(to) < 0:
		return {}
	return {"asset": asset, "to": to, "kind": kind, "yaw": _direction_yaw(to)}


## The sides a pipe placement's `links` say it is joined on, as the raw
## connection dictionaries (`{"to", "kind"}`), in the wire's own
## north/east/south/west order. Empty for a lonely tile or a non-pipe.
func _pipe_connections_of(placement: Dictionary) -> Array:
	var links = placement.get("links")
	if not (links is Dictionary):
		return []
	var connections = links.get("connections", [])
	return connections if connections is Array else []


## The shape record (`_pipe_shape_for`) of the pipe on `tile`, or `{}`.
## Filled by `_rebuild_world` from every pipe placement's `links`.
func _pipe_shape_at(tile: Vector2i) -> Dictionary:
	return _pipe_shapes.get(_tile_key(tile), {})


## The fittings (`_pipe_fitting_for`) drawn on the pipe at `tile`, in
## north/east/south/west order; `[]` if none, or if it is not a pipe.
func _pipe_fittings_at(tile: Vector2i) -> Array:
	return _pipe_fittings.get(_tile_key(tile), [])


## Which shape model draws the pipe tile at `tile`. The plain straight for
## a tile `_rebuild_world` has not seen (there is none: every pipe placement
## carries `links`).
func _pipe_asset_for(tile: Vector2i) -> String:
	return String(_pipe_shape_at(tile).get("asset", PIPE_ASSET))


## The instance key of a fitting, distinct from the tile's own key so both
## can live in `_tile_instances` (a tile draws one shape and up to four
## fittings).
func _pipe_fitting_key(tile: Vector2i, to: String) -> String:
	return "fitting:%s:%s" % [_tile_key(tile), to]


## Which voxel asset draws one placement — for a belt, frame 0 of the shape
## its `links` give it (the frame set itself is `_tile_frames_for`); pipes
## have context-dependent variants (above); everything else goes through the
## same `_shop_asset_for` the build menu's icons use, so a kind added to
## `data/shop.ron` draws in the world and in the menu from one mapping.
func _asset_for_placement(placement: Dictionary) -> String:
	var kind := String(placement.get("kind", ""))
	var origin := _placement_origin(placement)
	if kind == BELT_KIND:
		return _tile_frames_for(placement)[0]
	if kind == PIPE_KIND:
		return _pipe_asset_for(origin)
	return _shop_asset_for(kind)


## The buildable-kind ids that are infrastructure rather than buildings —
## spelled here for the same reason `sim::world` spells them in Rust: they
## are the two kinds that are priced and placed but are not in
## `data/machines.ron` at all.
const BELT_KIND := "belt"
const PIPE_KIND := "pipe"

## The three buildable kinds that are buffers rather than processes — no
## recipe, but a footprint and a live level. Spelled here so the `match` in
## `_build_placement` reads as kind ids rather than string literals; they are
## `data/machines.ron` ids, and their Rust twins are `sim::hopper::HOPPER_KIND`
## and friends.
const HOPPER_KIND := "hopper"
const FLUID_TANK_KIND := "fluid_tank"
const DOCK_KIND := "dock"
## Epic B's splitter. A `data/machines.ron` kind like the three above, but
## belt-LIKE rather than a buffer: it carries product at belt speed and hands
## it on, so `_is_building_tile` deliberately groups it with the conveyor.
const SPLITTER_KIND := "splitter"


## Rebuilds the entire rendered world from `world_layout_json` plus the
## buffer/fluid snapshots — the one function every place, remove and rotate
## goes through, and the one `_ready` calls to draw the (empty) starting
## state. See `_placements`'s doc for why this is a full rebuild.
func _rebuild_world() -> void:
	_read_world_layout()

	# Pipe shapes first: which shape a tile draws, at what turn, and which
	# fittings stand on it come straight off each placement's `links`
	# (ticket 1 of the overhaul recorded them in the topology pass), so
	# they are known before the tiles themselves are staged. The fluid
	# snapshots are read alongside for `_pipe_tiles`, which hover uses to
	# find a tile's live level in the network array.
	_pipe_shapes.clear()
	_pipe_fittings.clear()
	for placement in _placements:
		if String(placement.get("kind", "")) != PIPE_KIND:
			continue
		var origin := _placement_origin(placement)
		var key := _tile_key(origin)
		var connections := _pipe_connections_of(placement)
		var faces: Array = []
		var fittings: Array = []
		for connection in connections:
			if not (connection is Dictionary):
				continue
			faces.append(String(connection.get("to", "")))
			var fitting := _pipe_fitting_for(connection)
			if not fitting.is_empty():
				fittings.append(fitting)
		_pipe_shapes[key] = _pipe_shape_for(faces, _placement_direction(placement))
		if not fittings.is_empty():
			_pipe_fittings[key] = fittings
	_last_fluid = _read_fluid_snapshots()
	_pipe_tiles.clear()
	for n in range(_last_fluid.size()):
		var segments: Array = _last_fluid[n].get("segments", [])
		for i in range(segments.size()):
			_pipe_tiles[_tile_key(_pair_to_tile(segments[i].get("tile", [0, 0])))] = Vector2i(n, i)

	# Cleared and rebuilt together, never appended to: `_ready()` genuinely
	# runs twice under the headless `--script` SceneTree harness (see
	# test_hover.gd's header), and a place/remove/rotate re-enters this.
	var existing := get_node_or_null("World")
	if existing != null:
		remove_child(existing)
		existing.free()
	_machine_lamps.clear()
	_machine_gauges.clear()
	_machine_running.clear()
	_splitter_nodes.clear()
	_splitter_states.clear()
	_belt_shapes.clear()
	_hopper_nodes.clear()
	_fluid_tank_nodes.clear()
	_dock_nodes.clear()
	_pipe_fluid_nodes.clear()
	# The instanced tiles and item pools are children of "World" and went
	# with it; their bookkeeping goes too, so a stale slot index can never
	# point into a MultiMesh that no longer exists.
	_tile_sets.clear()
	_tile_pending.clear()
	_tile_instances.clear()
	_item_pools.clear()
	_item_slots.clear()

	_world_root = Node3D.new()
	_world_root.name = "World"
	add_child(_world_root)
	_tiles_root = Node3D.new()
	_tiles_root.name = "Tiles"
	_world_root.add_child(_tiles_root)
	_items_root = Node3D.new()
	_items_root.name = "Items"
	_world_root.add_child(_items_root)

	for placement in _placements:
		_build_placement(placement)
	# Every conveyor and pipe tile has now been STAGED; this is what draws
	# them, one MultiMesh per (asset, material class) rather than one node
	# per tile.
	_build_tile_instances()

	_build_floor()
	_seed_machine_states()
	_seed_splitter_states()
	_refresh_buffers()


## Builds the node (or nodes) for one placement: its body at the centre of
## its ROTATED footprint, turned to face the way the simulation says it
## faces, plus whatever live parts that kind carries — a status lamp, a fill
## body, a progress gauge, a deck for waiting goods.
func _build_placement(placement: Dictionary) -> void:
	var kind := String(placement.get("kind", ""))
	var origin := _placement_origin(placement)
	var direction := _placement_direction(placement)
	var key := _tile_key(origin)
	var size := _rotated_footprint(_footprint_size(placement.get("footprint")), direction)
	var yaw := _direction_yaw(direction)
	var centre := _footprint_centre(origin, size, FLOOR_Y)

	if _is_instanced_kind(kind):
		# A conveyor or pipe tile is one MultiMesh instance, not a node (see
		# the "Instanced tiles and items" section). The yaw is passed
		# separately from the placement's direction on purpose: a pipe's
		# turn is decided by its connections, not its facing (see the pipe
		# constants' doc), a belt corner's (ticket 5) likewise, and this is
		# the one place that decides.
		if kind == PIPE_KIND:
			yaw = float(_pipe_shape_at(origin).get("yaw", yaw))
			# The fittings are instances too — a fitting has no live state —
			# each under its own key, turned to the side it stands on.
			for fitting in _pipe_fittings_at(origin):
				_stage_tile_instance(
					[String(fitting["asset"])], _pipe_fitting_key(origin, String(fitting["to"])),
					centre, float(fitting["yaw"])
				)
		elif kind == BELT_KIND:
			_belt_shapes[key] = _belt_shape_for(placement.get("links", {}), direction)
		_stage_tile_instance(_tile_frames_for(placement), key, centre, yaw)
		if kind == SPLITTER_KIND:
			# The splitter's body is instanced like a belt's, but its lit
			# next-output arrow stays a node: it turns and hides per tile
			# from a live snapshot, which is exactly what an instance in a
			# shared MultiMesh cannot do cheaply.
			var arrow := _asset_node(SPLITTER_ARROW_ASSET)
			arrow.name = "splitter_arrow_%s" % key
			arrow.position = _footprint_centre(origin, size, SPLITTER_ARROW_FLOOR_Y)
			arrow.rotation.y = yaw
			arrow.visible = false
			_world_root.add_child(arrow)
			_splitter_nodes[key] = {"arrow": arrow, "yaw": yaw}
		return

	var body := _asset_node(_asset_for_placement(placement))
	body.name = "%s_%s" % [kind, key]
	body.position = centre
	body.rotation.y = yaw
	_world_root.add_child(body)

	var lamp := body.get_node_or_null("emissive")

	match kind:
		HOPPER_KIND:
			_hopper_nodes[key] = {
				"fill": _build_level_body(HOPPER_FILL_ASSET, origin, size, HOPPER_FILL_FLOOR_Y, yaw, null),
				"lamp": lamp,
				"stocked": true, # forces the first refresh to apply
			}
		FLUID_TANK_KIND:
			_fluid_tank_nodes[key] = {
				"fill": _build_level_body(FLUID_TANK_FILL_ASSET, origin, size, FLUID_TANK_FILL_FLOOR_Y, yaw, null),
				"lamp": lamp,
				"stocked": true,
			}
		DOCK_KIND:
			_dock_nodes[key] = {
				"slots": _build_dock_slots(origin, size, yaw),
				"lamp": lamp,
				"stocked": true,
				# Where a payout's coins are thrown from — the deck's centre,
				# recorded once here rather than re-derived from the slot
				# positions, which are laid out for four cases and are not
				# obliged to stay symmetric about it.
				"anchor": _footprint_centre(origin, size, DOCK_DECK_Y),
			}
		_:
			# A machine: a recipe-running kind. Its status lamp and (for the
			# kinds that declare one) its progress gauge.
			_machine_lamps[key] = lamp
			_machine_running[key] = true
			_set_machine_running(key, false)
			if MACHINE_PROGRESS_GAUGES.has(kind):
				# A SIBLING of the body rather than a child, so
				# `body.get_node_or_null("emissive")` above keeps finding the
				# machine's own lamps and not the gauge's emissive bar, whose
				# material `_set_machine_running` would otherwise swap.
				var gauge := _asset_node(String(MACHINE_PROGRESS_GAUGES[kind]))
				gauge.name = "gauge_%s" % key
				gauge.position = _footprint_centre(origin, size, MACHINE_GAUGE_FLOOR_Y)
				gauge.rotation.y = yaw
				gauge.visible = false
				_world_root.add_child(gauge)
				_machine_gauges[key] = gauge


## One of the one-voxel-tall bodies this scene scales every frame to show a
## live level — the pipe's liquid, the hopper's product, the tank's column
## (UI_UX.md §2b point 5). Shared because all three are the same mechanism,
## differing only in asset, height and tint.
func _build_level_body(
	asset: String, origin: Vector2i, size: Vector2i, height: float, yaw: float,
	material: StandardMaterial3D
) -> Node3D:
	var node := _asset_node(asset)
	node.name = "%s_%s" % [asset, _tile_key(origin)]
	node.position = _footprint_centre(origin, size, height)
	node.rotation.y = yaw
	if material != null:
		for child in node.get_children():
			if child is MeshInstance3D:
				child.set_surface_override_material(0, material)
	_world_root.add_child(node)
	return node


## The pooled nodes the goods waiting on one dock's deck stand in — created
## hidden, revealed by `_update_dock_stock`. Pooled rather than spawned per
## frame for the same reason the item pools are pooled: this is the same "a case standing
## somewhere" node, just standing on a deck instead of on a belt.
func _build_dock_slots(origin: Vector2i, size: Vector2i, yaw: float) -> Array:
	var deck := _footprint_centre(origin, size, DOCK_DECK_Y)
	var slots: Array = []
	for i in range(DOCK_STOCK_SLOTS):
		var offset: Vector2 = DOCK_STOCK_OFFSETS[i]
		var slot := Node3D.new()
		slot.name = "dock_stock_%s_%d" % [_tile_key(origin), i]
		# The vox importer maps low local Y to high world Z, so a slot's
		# model-space Y offset runs the other way in the world (the same
		# mapping `_footprint_centre`'s doc relies on). Rotated with the
		# building, so a turned dock stages its goods on its own near edge.
		var local := Vector3(offset.x * VOXEL_UNIT, 0.0, -offset.y * VOXEL_UNIT)
		slot.position = deck + local.rotated(Vector3.UP, yaw)
		slot.visible = false
		_world_root.add_child(slot)
		slots.append(slot)
	return slots


func _pair_to_tile(pair) -> Vector2i:
	if pair is Array and pair.size() >= 2:
		return Vector2i(int(pair[0]), int(pair[1]))
	return Vector2i.ZERO


## Fills `_machine_states` (what the hover tooltip and the progress gauges
## read) for every placed machine, before any item has moved.
##
## `dirty_chunk_ids` only reports chunks something *changed* in, so an idle
## factory produces no snapshots at all and hovering a machine would show
## nothing until the player pressed a key. This asks the simulation directly,
## via `query_tile_json`, rather than inventing a default state Godot has no
## business knowing.
func _seed_machine_states() -> void:
	_machine_states.clear()
	for placement in _placements:
		if placement.get("recipe") == null:
			continue
		var origin := _placement_origin(placement)
		var parsed = JSON.parse_string(sim.query_tile_json(origin.x, origin.y))
		if parsed == null or parsed.get("kind") != "machine":
			continue
		_machine_states[_tile_key(origin)] = {
			"recipe": parsed["recipe"],
			"process": parsed.get("process"),
			# query_tile deliberately doesn't report buffer contents; the
			# first chunk snapshot fills these in.
			"input": [],
			"output": [],
		}


## Fills `_splitter_states` (and points every arrow) for every placed
## splitter, before any item has moved — `_seed_machine_states`'s twin, and
## it exists for the same reason: `dirty_chunk_ids` only reports chunks
## something CHANGED in, so a splitter that has not yet passed an item
## produces no snapshot and its arrow would stay dark until it did. Which
## way a freshly placed splitter will deal its first item is knowable (it is
## `Side::default()`, straight), so it is asked for rather than guessed at.
func _seed_splitter_states() -> void:
	for placement in _placements:
		if String(placement.get("kind", "")) != SPLITTER_KIND:
			continue
		var origin := _placement_origin(placement)
		var parsed = JSON.parse_string(sim.query_tile_json(origin.x, origin.y))
		if parsed == null or parsed.get("kind") != SPLITTER_KIND:
			continue
		_apply_splitter_state(_tile_key(origin), parsed)


## Points one splitter's arrow at the output its next item will actually
## reach, and remembers the snapshot for the hover tooltip.
##
## **Why this is not simply `next_output`.** The raw field is which side gets
## FIRST REFUSAL, and `sim_core/src/sim/splitter.rs`'s fallback rule is that
## a side which cannot take the item passes it to the other one in the same
## tick — so a splitter whose branch was never built reports `"branch"`
## forever while every item goes straight through it. An arrow drawn from
## that field alone would point at bare floor while product sailed past it in
## the other direction: a readout lying about its own mechanism, which is the
## thing this codebase already refused to build for the fluid tank's head and
## the dock's fill level. So the ONE case the wire can settle is settled
## here — a due side with no output tile (`outputs[i] == null`) hands to the
## other — and it is settled from the `outputs` pair the simulation reports
## precisely so a renderer need not re-derive where they point.
##
## What this deliberately cannot show is a side that is built but momentarily
## FULL, which also falls back. That is transient and invisible on the wire;
## an unbuilt branch is durable and is the mistake a player wants told about.
##
## With neither output connected nothing can leave at all, and the arrow is
## hidden outright — a shape difference (no lit groove anywhere) for a
## splitter that is a dead end.
func _apply_splitter_state(key: String, snapshot: Dictionary) -> void:
	_splitter_states[key] = snapshot
	var nodes: Dictionary = _splitter_nodes.get(key, {})
	if nodes.is_empty():
		return
	var arrow: Node3D = nodes["arrow"]
	var side := _splitter_effective_side(snapshot)
	arrow.visible = side >= 0
	if side >= 0:
		arrow.rotation.y = float(nodes["yaw"]) + (PI * 0.5 if side == SPLITTER_BRANCH else 0.0)


## Which output the next item off `snapshot` will reach — SPLITTER_STRAIGHT,
## SPLITTER_BRANCH, or -1 when neither side is connected to anything. Pure,
## so a test can drive it with a hand-built snapshot.
func _splitter_effective_side(snapshot: Dictionary) -> int:
	var outputs: Array = snapshot.get("outputs", [])
	var due := SPLITTER_BRANCH if String(snapshot.get("next_output", "straight")) == "branch" else SPLITTER_STRAIGHT
	var other := SPLITTER_STRAIGHT if due == SPLITTER_BRANCH else SPLITTER_BRANCH
	if outputs.size() < 2:
		return -1
	if outputs[due] != null:
		return due
	if outputs[other] != null:
		return other
	return -1


# --------------------------------------------------------------------------
# Instanced tiles and items (the pipes & conveyors overhaul, ticket 4)
# --------------------------------------------------------------------------
##
## **A belt, a splitter or a pipe is not a node.** Every tile drawing the same
## asset is one instance in one `MultiMesh` per material class — the same
## shape `_build_floor` already draws the floor with — and every item riding
## a conveyor is one instance in a pool per item asset. Before this, a
## placement was a `Node3D` with a `MeshInstance3D` per class and each
## carried item a pooled `Node3D` moved every tick; at a thousand tiles the
## rebuild a single place/remove/rotate pays, and the per-tick transform
## traffic, were both dominated by node count. A `MultiMesh` is one draw call
## per (asset, class) and a transform write per instance, and the numbers in
## docs/DEVLOG.md's ticket-4 entry are what that bought.
##
## **What stays a node, and why:** anything with LIVE PER-INSTANCE state —
## a machine's swappable status lamp and progress gauge, a hopper's, tank's
## or pipe segment's scaled and retinted level body, a splitter's turning
## arrow, a dock's stock cases, and the ghost. A `MultiMesh` instance has a
## transform and nothing else; giving one of those a material swap means a
## pool per material, and that is a node with extra steps. Machines and
## buildings are also few (tens, not thousands) and multi-tile, so nothing is
## gained. A pipe's FITTINGS (ticket 6) are instances like the shape they
## stand on — a fitting has no live state — while its fluid body stays a
## node: the per-instance scale would fit in a transform, but the tint is
## per network, and a pool per fluid is a node with extra steps.
##
## **Three seams the later tickets build on** (the plan's ticket 5 and 6):
##
## (a) A tile's asset is a FRAME SET — `_tile_frames_for` returns a list of
##     asset names, one per animation frame, and each frame is its own set
##     of per-class `MultiMeshInstance3D`s carrying the SAME transforms.
##     `_set_tile_frame(k)` flips which frame's nodes are visible, so
##     animating a thousand belts costs a handful of visibility flips per
##     frame change, not a thousand transform writes. Belts are four-frame
##     sets since ticket 5 (`_belt_frames_for_shape`); splitters and pipes
##     are one-frame sets.
## (b) A tile's transform is a position plus a YAW handed in by the caller
##     (`_stage_tile_instance`), not derived here from the placement's
##     direction — so a corner tile can be spun independently of the facing
##     the simulation reports.
## (c) An item's transform comes from one function of (tile, direction,
##     distance), `_carried_item_transform`, which reads the tile's recorded
##     shape to bend a corner's items around the arc.
##
## Tests read the result through `_tile_instance_at`, `_carried_item` and
## `_carried_item_count` rather than by node name, since there is no node.

## The kinds drawn as instances. Everything else is a node (see above).
func _is_instanced_kind(kind: String) -> bool:
	return kind == BELT_KIND or kind == PIPE_KIND or kind == SPLITTER_KIND


## The frame set one tile draws with: a list of asset names, one per
## animation frame, all sharing the tile's transform. A belt gets the four
## frames of the shape its `links` give it (the plan's "Belt animation");
## a splitter or pipe is a one-frame set of whatever `_asset_for_placement`
## picks.
func _tile_frames_for(placement: Dictionary) -> Array:
	if String(placement.get("kind", "")) == BELT_KIND:
		return _belt_frames_for_shape(
			_belt_shape_for(placement.get("links", {}), _placement_direction(placement))
		)
	return [_asset_for_placement(placement)]


## One key per distinct frame set, so every tile drawing the same frames
## shares one group of MultiMeshes.
func _tile_set_key(frames: Array) -> String:
	return "|".join(PackedStringArray(frames))


## A tile's instance transform. Yaw about +Y, exactly the rotation a node
## got from `rotation.y = yaw`, so a rotated instance is the same mesh spun
## about its footprint-centre origin (UI_UX.md §2b point 18).
func _tile_transform(position: Vector3, yaw: float) -> Transform3D:
	return Transform3D(Basis(Vector3.UP, yaw), position)


## Records one tile to draw. A `MultiMesh` needs its instance count up front,
## so tiles are staged during a rebuild and built together by
## `_build_tile_instances` once every placement has been seen.
func _stage_tile_instance(frames: Array, key: String, position: Vector3, yaw: float) -> void:
	var set_key := _tile_set_key(frames)
	if not _tile_pending.has(set_key):
		_tile_pending[set_key] = {"frames": frames, "staged": []}
	_tile_pending[set_key]["staged"].append({"key": key, "position": position, "yaw": yaw})


## Turns everything `_stage_tile_instance` collected into MultiMeshes: per
## frame set, per frame, one `MultiMeshInstance3D` per material class, all
## carrying the same transforms in the same instance order. The staged order
## is placement order, which is the simulation's own tile order, so two
## rebuilds of one world are identical.
func _build_tile_instances() -> void:
	_tile_sets.clear()
	_tile_instances.clear()
	for set_key in _tile_pending.keys():
		var pending: Dictionary = _tile_pending[set_key]
		var frames: Array = pending["frames"]
		var staged: Array = pending["staged"]
		var transforms: Array = []
		for entry in staged:
			transforms.append(_tile_transform(entry["position"], entry["yaw"]))
		var frame_nodes: Array = []
		for f in range(frames.size()):
			frame_nodes.append(_build_multimesh_group(
				String(frames[f]), transforms, transforms.size(),
				"tiles_%s_f%d" % [String(frames[f]), f], _tiles_root
			))
		_tile_sets[set_key] = {"frames": frames, "nodes": frame_nodes, "count": staged.size()}
		for i in range(staged.size()):
			var entry: Dictionary = staged[i]
			_tile_instances[entry["key"]] = {
				"set": set_key, "index": i, "asset": String(frames[0]), "frames": frames,
				"position": entry["position"], "yaw": entry["yaw"],
			}
	_tile_pending.clear()
	_set_tile_frame(_belt_frame_for_tick(sim.current_tick()))


## Shows frame `frame` of every multi-frame tile set and hides the rest —
## the whole cost of a belt animation step under instancing. A one-frame set
## is left alone (always visible). Wraps, so a caller can hand in a running
## counter.
func _set_tile_frame(frame: int) -> void:
	_tile_frame = frame
	for set_key in _tile_sets.keys():
		var frame_nodes: Array = _tile_sets[set_key]["nodes"]
		if frame_nodes.size() <= 1:
			continue
		var shown := posmod(frame, frame_nodes.size())
		for f in range(frame_nodes.size()):
			for mmi in frame_nodes[f].values():
				mmi.visible = f == shown


## What is drawn on `tile`, if it is an instanced tile: the record
## `_build_tile_instances` made (`asset`, `frames`, `position`, `yaw`,
## `index`) plus `nodes`, the frame-0 `MultiMeshInstance3D`s it is an
## instance of (empty if no class of the asset imported). `{}` for anything
## that is not a belt, splitter or pipe origin. This is the test seam that
## replaced looking a belt up by node name.
func _tile_instance_at(tile: Vector2i) -> Dictionary:
	var key := _tile_key(tile)
	if not _tile_instances.has(key):
		return {}
	var record: Dictionary = _tile_instances[key].duplicate()
	var set: Dictionary = _tile_sets.get(record["set"], {})
	var frame_nodes: Array = set.get("nodes", [])
	record["nodes"] = frame_nodes[0].values() if not frame_nodes.is_empty() else []
	return record


## Builds one `MultiMeshInstance3D` per material class of `asset` under
## `parent`, each with `capacity` instances of which the first `count`
## (taken from `transforms`) are visible. Returns them keyed by class. Shares
## `_asset_node`'s mesh lookup and per-class materials, so an instanced
## belt is lit and shaded exactly as a node-built one was.
func _build_multimesh_group(
	asset: String, transforms: Array, count: int, name_prefix: String, parent: Node3D,
	capacity := -1
) -> Dictionary:
	if capacity < count:
		capacity = count
	var out := {}
	for class_name_ in _asset_class_names(asset):
		var mesh := _class_mesh_for(asset, class_name_)
		if mesh == null:
			continue
		var multimesh := MultiMesh.new()
		multimesh.transform_format = MultiMesh.TRANSFORM_3D
		multimesh.mesh = mesh
		multimesh.instance_count = capacity
		multimesh.visible_instance_count = count
		for i in range(count):
			multimesh.set_instance_transform(i, transforms[i])
		var mmi := MultiMeshInstance3D.new()
		mmi.name = "%s_%s" % [name_prefix, String(class_name_)]
		mmi.multimesh = multimesh
		mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		var class_material = _class_materials.get(class_name_, null)
		if class_material != null:
			mmi.material_override = class_material
		parent.add_child(mmi)
		out[class_name_] = mmi
	if out.is_empty():
		push_warning("no voxel meshes for '%s' under %s — run `cargo xtask`" % [asset, VOX_DIR])
	return out


## --- The item pools ---------------------------------------------------------
##
## One pool per item asset: a group of per-class MultiMeshes with `capacity`
## instances, of which the first `count` are visible. A slot key (one per
## conveyor slot, see `_render_carried_items`) owns one instance index. Hiding
## an item swap-removes it — the LAST visible instance moves into its index
## — so the visible instances are always a dense prefix and hiding is one
## transform write plus a count, never a rebuild. Growth doubles the
## capacity and replays the live transforms (setting `instance_count` clears
## a MultiMesh's buffer, so a mirror of the transforms is kept in the pool).

## Instances a pool starts with. Growing is cheap and rare, so this is only
## about not doubling six times on the first busy tick.
const ITEM_POOL_INITIAL := 64


func _item_pool_for(asset: String) -> Dictionary:
	if _item_pools.has(asset):
		return _item_pools[asset]
	var pool := {
		"asset": asset, "capacity": ITEM_POOL_INITIAL, "count": 0,
		"keys": [], "transforms": [], "nodes": {},
	}
	pool["nodes"] = _build_multimesh_group(asset, [], 0, "items_%s" % asset, _items_root, ITEM_POOL_INITIAL)
	_item_pools[asset] = pool
	return pool


func _item_pool_grow(pool: Dictionary) -> void:
	var capacity: int = int(pool["capacity"]) * 2
	pool["capacity"] = capacity
	var count: int = pool["count"]
	for mmi in pool["nodes"].values():
		var multimesh: MultiMesh = mmi.multimesh
		multimesh.instance_count = capacity
		for i in range(count):
			multimesh.set_instance_transform(i, pool["transforms"][i])
		multimesh.visible_instance_count = count


## Draws the item for slot `key` as `asset` at `transform`, taking a fresh
## instance if the slot is new (or if its item type changed — the old
## instance is released rather than silently drawing the wrong product).
func _show_carried_item(key: String, asset: String, transform: Transform3D) -> void:
	if _items_root == null:
		return
	if _item_slots.has(key):
		var slot: Dictionary = _item_slots[key]
		if String(slot["asset"]) == asset:
			var pool: Dictionary = _item_pools[asset]
			var index: int = slot["index"]
			pool["transforms"][index] = transform
			for mmi in pool["nodes"].values():
				mmi.multimesh.set_instance_transform(index, transform)
			return
		_hide_carried_item(key)
	var pool := _item_pool_for(asset)
	if int(pool["count"]) >= int(pool["capacity"]):
		_item_pool_grow(pool)
	var index: int = pool["count"]
	pool["count"] = index + 1
	pool["keys"].append(key)
	pool["transforms"].append(transform)
	for mmi in pool["nodes"].values():
		mmi.multimesh.set_instance_transform(index, transform)
		mmi.multimesh.visible_instance_count = index + 1
	_item_slots[key] = {"asset": asset, "index": index}


## Releases slot `key`'s instance. Returns false if the slot was not drawn,
## which `_render_carried_items` uses to find the end of a tile's slots.
func _hide_carried_item(key: String) -> bool:
	if not _item_slots.has(key):
		return false
	var slot: Dictionary = _item_slots[key]
	_item_slots.erase(key)
	var pool: Dictionary = _item_pools[slot["asset"]]
	var index: int = slot["index"]
	var last: int = int(pool["count"]) - 1
	if index != last:
		var moved_key: String = pool["keys"][last]
		var moved: Transform3D = pool["transforms"][last]
		pool["keys"][index] = moved_key
		pool["transforms"][index] = moved
		_item_slots[moved_key]["index"] = index
		for mmi in pool["nodes"].values():
			mmi.multimesh.set_instance_transform(index, moved)
	pool["keys"].resize(last)
	pool["transforms"].resize(last)
	pool["count"] = last
	for mmi in pool["nodes"].values():
		mmi.multimesh.visible_instance_count = last
	return true


## How many conveyor items are drawn right now, across every pool.
func _carried_item_count() -> int:
	return _item_slots.size()


## The item drawn for slot `key` (`"belt_x_y_i"` / `"splitter_x_y_i"`): its
## `asset` and world `position`, or `{}` if that slot is not drawn. The test
## seam that replaced reading a pooled node's `visible` and `position`.
func _carried_item(key: String) -> Dictionary:
	if not _item_slots.has(key):
		return {}
	var slot: Dictionary = _item_slots[key]
	var pool: Dictionary = _item_pools[slot["asset"]]
	var transform: Transform3D = pool["transforms"][slot["index"]]
	return {"asset": String(slot["asset"]), "position": transform.origin}


# --------------------------------------------------------------------------
# Live levels: hoppers, tanks, docks and the liquid in the pipes
# --------------------------------------------------------------------------

## Re-reads every buffer building's own snapshot array and updates the nodes
## built for it. Called every frame, and once at build time so tick 0's
## levels are drawn rather than an empty factory.
##
## Polling rather than waiting on `dirty_chunk_ids` is not a shortcut: a
## tank is drained by the same equalization pass the pipes are and that pass
## deliberately dirties no chunk, so a chunk-driven renderer would sit
## waiting on an event that never comes (see `SimBridge`'s own docs). The
## hopper and dock could be chunk-driven and are polled with them for one
## code path rather than two.
func _refresh_buffers() -> void:
	_hopper_states.clear()
	for snapshot in _read_snapshot_array(sim.hopper_snapshots_json()):
		var key := _tile_key(_pair_to_tile(snapshot.get("tile")))
		_hopper_states[key] = snapshot
		var nodes: Dictionary = _hopper_nodes.get(key, {})
		if nodes.is_empty():
			continue
		var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
		_apply_level(nodes["fill"], fill, HOPPER_MIN_VISIBLE_FILL, HOPPER_FILL_HEIGHT_VOXELS)
		# Retinted only when the item id actually changes: this runs every
		# frame, and a fresh StandardMaterial3D per frame per building is a
		# real cost for a colour that almost never moves.
		var item := String(snapshot.get("item", ""))
		if String(nodes.get("tint", "")) != item:
			nodes["tint"] = item
			_tint_level_body(nodes["fill"], _hopper_fill_material(item))
		_set_lamp_stocked(nodes, fill > HOPPER_MIN_VISIBLE_FILL)

	_fluid_tank_states.clear()
	for snapshot in _read_snapshot_array(sim.fluid_tank_snapshots_json()):
		var key := _tile_key(_pair_to_tile(snapshot.get("tile")))
		_fluid_tank_states[key] = snapshot
		var nodes: Dictionary = _fluid_tank_nodes.get(key, {})
		if nodes.is_empty():
			continue
		var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
		_apply_level(nodes["fill"], fill, FLUID_TANK_MIN_VISIBLE_FILL, FLUID_TANK_FILL_HEIGHT_VOXELS)
		var fluid := _fluid_id_of(snapshot)
		if String(nodes.get("tint", "")) != fluid:
			nodes["tint"] = fluid
			_tint_level_body(nodes["fill"], _fluid_material_for(fluid))
		_set_lamp_stocked(nodes, fill > FLUID_TANK_MIN_VISIBLE_FILL)

	_dock_states.clear()
	for snapshot in _read_snapshot_array(sim.dock_snapshots_json()):
		_dock_states[_tile_key(_pair_to_tile(snapshot.get("tile")))] = snapshot

	var econ = JSON.parse_string(sim.economy_snapshot_json())
	_last_dock_stock = econ.get("delivery_stock", []) if econ is Dictionary else []
	_update_dock_stock(_last_dock_stock)


## Parses one of the SimBridge calls that returns an ARRAY of snapshots —
## hoppers, tanks, docks, fluid networks. All four became arrays in ticket 1
## (a world may hold none or several of each), so they get one reader.
func _read_snapshot_array(json: String) -> Array:
	if json.is_empty():
		return []
	var parsed = JSON.parse_string(json)
	return parsed if parsed is Array else []


func _read_fluid_snapshots() -> Array:
	return _read_snapshot_array(sim.fluid_snapshots_json())


## Scales one of the one-voxel-tall level bodies to a live fraction, hiding
## it outright below a minimum rather than drawing a sub-voxel sliver that
## would z-fight whatever it stands on.
func _apply_level(node: Node3D, fraction: float, minimum: float, height_voxels: int) -> void:
	if node == null:
		return
	node.visible = fraction > minimum
	if node.visible:
		node.scale.y = fraction * float(height_voxels)


func _tint_level_body(node: Node3D, material: StandardMaterial3D) -> void:
	if node == null or material == null:
		return
	for child in node.get_children():
		if child is MeshInstance3D:
			child.set_surface_override_material(0, material)


## A hopper's product body is near-white so a per-item tint multiplies
## cleanly over it — *which* item a hopper holds is simulation data.
func _hopper_fill_material(item_id: String) -> StandardMaterial3D:
	var base: StandardMaterial3D = _class_materials.get("matte", null)
	var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.95, 0.0)
	mat.albedo_color = HOPPER_FILL_TINTS.get(item_id, HOPPER_FILL_TINT_FALLBACK)
	return mat


## Swaps a building's status lamp between the same idle/running materials a
## machine's lamp uses (UI_UX.md §4/§7: saturated colour reserved for
## meaning). One helper for all three buffer kinds, since "holds stock" is
## the one state a buffer has.
func _set_lamp_stocked(nodes: Dictionary, stocked: bool) -> void:
	if bool(nodes.get("stocked", false)) == stocked:
		return
	nodes["stocked"] = stocked
	var lamp = nodes.get("lamp")
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if stocked else _lamp_idle)


## Stands one case per unit of stock waiting to be sold on EVERY dock's deck,
## up to DOCK_STOCK_SLOTS each, drawn with that item's own model.
##
## Every dock shows the same pool, deliberately: `EconomySnapshot`'s
## `delivery_stock` is one shared number however many docks the player
## builds (a second dock is another door out of the factory, not a second
## ledger), and the dock's own `contents` empties every tick, so a per-dock
## figure would be zero forever — see DOCK_ASSET's doc.
##
## Pure given `stock` and the built nodes, so a test can drive it directly.
func _update_dock_stock(stock: Array) -> void:
	# Flatten the pool's (item, quantity) pairs into one case per unit, in
	# snapshot order, so a multi-item pool shows a mixed stack rather than
	# only its first product.
	var waiting: Array[String] = []
	for pair in stock:
		if not (pair is Array) or pair.size() < 2:
			continue
		for _i in range(int(pair[1])):
			if waiting.size() >= DOCK_STOCK_SLOTS:
				break
			waiting.append(String(pair[0]))

	for key in _dock_nodes.keys():
		var nodes: Dictionary = _dock_nodes[key]
		var slots: Array = nodes.get("slots", [])
		for i in range(slots.size()):
			var slot: Node3D = slots[i]
			if i >= waiting.size():
				slot.visible = false
				continue
			var asset: String = ITEM_MODELS.get(waiting[i], ITEM_MODEL_FALLBACK)
			var current := slot.get_node_or_null("case")
			if current == null or String(current.get_meta("asset", "")) != asset:
				if current != null:
					slot.remove_child(current)
					current.queue_free()
				var node := _asset_node(asset)
				node.name = "case"
				node.set_meta("asset", asset)
				slot.add_child(node)
			slot.visible = true
		_set_lamp_stocked(nodes, not waiting.is_empty())


## A network's or tank's fluid id, or "" — `fluid` is NULLABLE on the wire
## (a run no machine taps has not been told what it carries), and `String(null)`
## is a hard error in GDScript rather than an empty string.
func _fluid_id_of(snapshot: Dictionary) -> String:
	var value = snapshot.get("fluid")
	return String(value) if value != null else ""


## The liquid's material: palette.ron's own `liquid` class numbers (glossy
## dielectric — UI_UX.md §4's "visible liquid surfaces ... with subtle
## shading/reflection"), tinted per fluid id. Only the tint is decided here;
## the shading numbers stay in palette.ron like every other material.
func _fluid_material_for(fluid_id: String) -> StandardMaterial3D:
	var base: StandardMaterial3D = _class_materials.get("liquid", null)
	var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.14, 0.0)
	mat.albedo_color = FLUID_TINTS.get(fluid_id, FLUID_TINT_FALLBACK)
	return mat


## Re-reads every fluid network and resizes each segment's liquid body to its
## live fill fraction. Cheap by design, and polled for the reason
## `sim::FluidSnapshot`'s own doc gives: fluid moves on nearly every tick and
## deliberately does not dirty its chunk.
##
## The liquid bodies are created here rather than in `_build_placement`,
## because which network a pipe tile belongs to is decided by the whole run,
## and a network's fluid — which decides the tint — is decided by whichever
## machine taps it, so both are only known once the snapshots are read.
func _update_fluid_network() -> void:
	_last_fluid = _read_fluid_snapshots()
	for n in range(_last_fluid.size()):
		var network: Dictionary = _last_fluid[n]
		var material := _fluid_material_for(_fluid_id_of(network))
		var segments: Array = network.get("segments", [])
		for s in range(segments.size()):
			var segment: Dictionary = segments[s]
			var node := _fluid_body_for(n, s, segment, material)
			if node == null:
				continue
			var pressure: float = clampf(float(segment.get("pressure", 0.0)), 0.0, 1.0)
			_apply_level(node, pressure, FLUID_MIN_VISIBLE_PRESSURE, PIPE_BORE_HEIGHT_VOXELS)


## The liquid body sitting in one pipe segment's bore, created on first
## sight. Keyed by (network, segment) rather than pooled in an array, because
## a placement can add or remove a whole network between frames.
func _fluid_body_for(network_index: int, segment_index: int, segment: Dictionary,
		material: StandardMaterial3D) -> Node3D:
	if _world_root == null:
		return null
	var key := "%d:%d" % [network_index, segment_index]
	if _pipe_fluid_nodes.has(key):
		# Deliberately NOT retinted here: this runs every frame, and a
		# network's fluid is decided by whichever machine taps it, which only
		# changes when something is placed — and a placement rebuilds these.
		return _pipe_fluid_nodes[key]
	var tile := _pair_to_tile(segment.get("tile", [0, 0]))
	# The body matching the tile's SHAPE, at the shape's own turn, so a
	# corner's liquid turns with its bore, a tee's fills its branch and an
	# end's stops where its cap starts (each body is authored to reach only
	# its shape's open faces — the voxgen tests pin that).
	var shape := _pipe_shape_at(tile)
	var fluid_asset := String(shape.get("fluid_asset", PIPE_FLUID_ASSET))
	var node := _asset_node(fluid_asset)
	node.name = "%s_%s" % [fluid_asset, _tile_key(tile)]
	node.position = _tile_origin(tile.x, tile.y, PIPE_BORE_FLOOR_Y)
	node.rotation.y = float(shape.get("yaw", _direction_yaw(String(segment.get("direction", "east")))))
	_tint_level_body(node, material)
	_world_root.add_child(node)
	_pipe_fluid_nodes[key] = node
	return node


## How far through its current process the machine at `origin_key` is, as
## 0..1, or -1.0 when it is idle. Derived from `_machine_states`'s own
## `process` = `[start_tick, required_ticks]` pair plus the simulation's
## current tick — NOT from a per-tick snapshot, and that distinction matters
## here more than anywhere else in this file: a machine only dirties its
## chunk when its state actually changes, so through the whole of a process
## no snapshot arrives at all. Recomputing from `current_tick()` every frame
## is what makes a long process animate smoothly rather than jump when it
## ends. Pure, so it is directly testable.
func _machine_progress(origin_key: String) -> float:
	if not _machine_states.has(origin_key):
		return -1.0
	var process = _machine_states[origin_key].get("process")
	if process == null:
		return -1.0
	var required: int = int(process[1])
	if required <= 0:
		return -1.0
	var elapsed: int = sim.current_tick() - int(process[0])
	return clampf(float(elapsed) / float(required), 0.0, 1.0)


## Rescales every declared progress gauge to its machine's live process
## fraction — the same one-poll/one-scaled-body pattern the pipe's liquid and
## the hopper's and tank's levels use, deliberately reused rather than
## invented again.
func _update_machine_gauges() -> void:
	for origin_key in _machine_gauges.keys():
		var gauge: Node3D = _machine_gauges[origin_key]
		if gauge == null:
			continue
		var fraction := _machine_progress(origin_key)
		gauge.visible = fraction > MACHINE_GAUGE_MIN_VISIBLE
		if gauge.visible:
			gauge.scale.y = fraction * float(MACHINE_GAUGE_HEIGHT_VOXELS)


func _set_machine_running(origin_key: String, running: bool) -> void:
	if _machine_running.get(origin_key, null) == running:
		return
	_machine_running[origin_key] = running
	var lamp: MeshInstance3D = _machine_lamps.get(origin_key, null)
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if running else _lamp_idle)


# --------------------------------------------------------------------------
# Camera & lighting
# --------------------------------------------------------------------------

## UI_UX.md §1: a FIXED orthographic isometric camera. No orbit, no free
## rotation — the voxel assets are modelled to read from fixed angles, and a
## free camera would expose silhouettes nothing was art-directed for. Pan
## (WASD/arrows) and zoom (scroll wheel) are explicitly allowed by that same
## section and don't touch the angle: pan moves `_camera_focus`, zoom moves
## `_camera_size`, orientation is always recomputed the same way.
##
## The angle used is true isometric (an equal-parts (1, 1, 1) view direction,
## ~35.26 degrees of elevation), not a 2:1 dimetric. UI_UX.md §9 explicitly
## leaves the final choice open pending a side-by-side prototype; this picks
## the one that keeps voxel cubes perfectly regular on screen, and changing
## it later is one constant here, not an asset change.
const CAMERA_DIRECTION := Vector3(1, 1, 1)
## Orthographic, so this only sets the near/far window, not apparent size.
const CAMERA_DISTANCE := 160.0

# --- Navigation (zoom + pan) -----------------------------------------------
# UI_UX.md §1 explicitly allows smooth zoom and only forbids free rotation —
# the fixed isometric angle itself never changes here, only `size` (zoom) and
# `_camera_focus` (pan) do.
const ZOOM_STEP := 0.1 # fraction of current size per scroll notch, mouse wheel or +/-
const ZOOM_MIN_FACTOR := 0.3 # most zoomed in, relative to the auto-framed size
const ZOOM_MAX_FACTOR := 3.0 # most zoomed out
const PAN_SPEED := 0.9 # fraction of the visible size crossed per second at held-key pan
# InputEventPanGesture.delta is in gesture-magnitude units, not wheel notches,
# and arrives many times per swipe — this converts one unit of that delta
# into a fraction of ZOOM_STEP's effect, tuned so a normal swipe feels
# similar in speed to a few wheel notches, not a single giant jump.
const TRACKPAD_ZOOM_SENSITIVITY := 0.01
const ISO_NEAR := 0.5

# --- First-person mode -----------------------------------------------------
# Not a UI_UX.md concept — a free-look "fly" camera for looking around the
# factory up close. No gravity, no collision: this project has no player
# entity or collision shapes on the voxel meshes, so it deliberately doesn't
# pretend to be one.
const FP_MOVE_SPEED := 6.0 # world units/second (~2 tiles/second)
const FP_MOUSE_SENSITIVITY := 0.0025 # radians per pixel of relative mouse motion
const FP_PITCH_LIMIT := deg_to_rad(89.0) # stop just short of looking straight up/down
const FP_FOV := 75.0
const FP_NEAR := 0.05 # much closer than ISO_NEAR — this mode gets right up next to machines
const CROSSHAIR_SIZE := 14.0 * UI_SCALE # px, each bar's length
const CROSSHAIR_THICKNESS := 2.0 * UI_SCALE # px, each bar's width

# The **C: collect product** hint these two used to carry is gone, with the
# key that drove it: the delivery-dock ticket deleted
# `PlayerCommand::CollectOutput` outright, because the chain now ends in a
# real dock that ships into the delivery pool every tick by itself. A key
# that quietly did nothing would be worse than no key — `issue_command_json`
# treats an unknown command as a silent no-op, so the legend would have been
# advertising a control the simulation no longer has.
## Three keys are new in the "Real Placement" epic's ticket 2, and they are
## what a build mode is made of. **R** turns things: it cycles the ghost's
## facing while placing, and — outside placement mode — rotates whatever is
## under the cursor in place, so turning a belt you already laid needs no
## pick-up-and-re-place round trip. **X** toggles remove mode, a mode rather
## than a modifier-click precisely because it is destructive and a mode is
## visible in this legend and in the on-screen prompt, where a held key is
## not. **ESC** leaves either. All three are free in both view modes (R, X
## and ESC collided with nothing), and the left mouse button — which
## `_unhandled_input` had deliberately left unbound "so a future
## click-to-build has nothing to fight with" — is now that click.
## Two LINES, not one. Build mode added three keys and a mouse button to a
## legend that already ran the width of the window, and a single line was
## being clipped behind the contract clipboard in the top-right corner — the
## kind of thing only a rendered frame shows (UI_UX.md §2b point 12). The
## build controls lead, because they are what the player does most.
## FOUR lines, not two, and that is a consequence of the 2026-09-09 UI-scale
## pass rather than of new controls: at half again the font size the old
## two-line legend ran clean off a 1280-wide window and under the contract
## clipboard. It is grouped by what each key is FOR — build-mode verbs, the
## panels, then the camera — which is a better reading order than the flat
## run-on it was anyway. ESC's entry names both of its meanings (close what
## is open, else the pause menu — see `_anything_open`).
##
## **Three keys came OFF it with the click-to-configure ticket** (Q, SPACE
## and V), and one line replaced all three: "click a hopper or tank:
## configure". That is the legend doing what it is for — a keybind has to be
## listed here or it is undiscoverable, whereas a building you can click
## announces itself on hover, so the line is a pointer rather than the only
## way to find out.
const ISO_HELP_TEXT := "1-9/0: pick from hotbar    click: place    R: rotate\nX: remove mode    ESC: close / pause menu\nE: build menu    M: market    click a hopper or tank: configure\nWASD/drag/arrows: pan    scroll/+-: zoom    TAB: first-person"
const FP_HELP_TEXT := "1-9/0: pick from hotbar    click: place    R: rotate\nX: remove mode    ESC: close / pause menu\nE: build menu    M: market    click a hopper or tank: configure\nWASD: move    mouse: look    SPACE/SHIFT: up/down    TAB: isometric"


## The tile box the isometric camera frames at startup: whatever is placed,
## widened to at least EMPTY_WORLD_FRAME_TILES in each axis about its own
## centre. The widening is what makes an EMPTY world (the new starting state)
## open on a usable expanse of floor instead of on one tile — there is no
## chain to frame any more, and "frame nothing" has to mean something.
func _framing_bounds() -> Rect2i:
	var bounds := _world_tile_bounds()
	var span_x: int = maxi(bounds.size.x, EMPTY_WORLD_FRAME_TILES)
	var span_y: int = maxi(bounds.size.y, EMPTY_WORLD_FRAME_TILES)
	var centre_x: float = float(bounds.position.x) + float(bounds.size.x) * 0.5
	var centre_y: float = float(bounds.position.y) + float(bounds.size.y) * 0.5
	return Rect2i(
		Vector2i(int(round(centre_x - float(span_x) * 0.5)), int(round(centre_y - float(span_y) * 0.5))),
		Vector2i(span_x, span_y)
	)


func _build_camera() -> void:
	# Framed on whatever is placed, padded out to at least a workable square
	# of floor — which for a NEW GAME (nothing placed at all) means the view
	# opens on empty ground around the origin rather than zoomed into a
	# single tile. Framing happens once, at build time: re-framing on every
	# placement would yank the view around while the player is building.
	_frame_bounds = _framing_bounds()
	_camera_focus = Vector3(
		(float(_frame_bounds.position.x) + float(_frame_bounds.size.x) * 0.5) * TILE,
		TILE * 0.35,
		(float(_frame_bounds.position.y) + float(_frame_bounds.size.y) * 0.5) * TILE
	)

	var camera := Camera3D.new()
	camera.name = "IsometricCamera"
	camera.projection = Camera3D.PROJECTION_ORTHOGONAL
	# KEEP_WIDTH so `size` means the horizontal extent: the factory is a long
	# horizontal line, and it must stay framed regardless of window aspect.
	camera.keep_aspect = Camera3D.KEEP_WIDTH
	camera.near = ISO_NEAR
	camera.far = 600.0
	add_child(camera)
	_camera = camera

	# Position/orient first (size doesn't affect orientation) so the camera's
	# own basis exists to read the ground-plane screen axes from — right is
	# already horizontal (up hint is world Y and the view direction isn't
	# vertical); "screen forward" is the view direction (-basis.z) projected
	# onto the ground. WASD/arrows pan along these, not raw world X/Z, so
	# panning still feels like up/down/left/right on screen regardless of the
	# fixed isometric angle.
	_camera_size = 1.0
	_update_camera_transform()
	_pan_right = _camera.transform.basis.x
	var forward := -_camera.transform.basis.z
	_pan_forward = Vector3(forward.x, 0.0, forward.z).normalized()

	_camera_base_size = _framing_size(_camera.transform.basis)
	_camera_size = _camera_base_size
	_update_camera_transform()
	camera.call_deferred("make_current")


## Repositions/reorients the camera from `_camera_focus`/`_camera_size` —
## called once at build time and again whenever pan or zoom changes. Cheap
## enough to call every time rather than tracking a dirty flag.
func _update_camera_transform() -> void:
	if _camera == null:
		return
	# `look_at_from_position` rather than position-then-`look_at`: the latter
	# requires the node to already be inside the tree, which isn't guaranteed
	# for a scene instantiated and driven manually (as the headless tests do).
	_camera.look_at_from_position(
		_camera_focus + CAMERA_DIRECTION.normalized() * CAMERA_DISTANCE,
		_camera_focus,
		Vector3.UP
	)
	_camera.size = _camera_size


func _zoom_camera(factor: float) -> void:
	var min_size := _camera_base_size * ZOOM_MIN_FACTOR
	var max_size := _camera_base_size * ZOOM_MAX_FACTOR
	_camera_size = clampf(_camera_size * factor, min_size, max_size)
	_update_camera_transform()


func _pan_camera(delta: float) -> void:
	_apply_pan(_pan_input_direction(), delta)


## Reads held keys only — no movement math, so this is the one part of
## panning that can't be exercised without a live Input singleton.
func _pan_input_direction() -> Vector3:
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += _pan_forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= _pan_forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += _pan_right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= _pan_right
	return move


## The actual movement, deliberately Input-free so it's directly testable
## (test_camera_nav.gd calls this with an explicit direction).
func _apply_pan(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	# Scaled by current `_camera_size`, not a flat world-unit speed, so pan
	# covers the same fraction of the visible view per second whether zoomed
	# in or out — a flat speed would feel sluggish when zoomed out and
	# twitchy when zoomed in.
	_camera_focus += direction.normalized() * PAN_SPEED * _camera_size * delta
	_update_camera_transform()


## World units per screen pixel at the current zoom — the conversion factor
## that makes click-and-drag panning track the cursor 1:1 (the point under
## the cursor when the drag started stays under it), rather than an arbitrary
## fixed speed that would feel wrong at every zoom level except one.
func _iso_drag_sensitivity() -> float:
	var width := 0.0
	var vp := get_viewport()
	if vp != null:
		width = vp.get_visible_rect().size.x
	if width <= 0.0:
		# A script-mode SceneTree (this project's own headless tests included)
		# never sizes a real window, so `get_viewport()` reports a zero-size
		# rect — fall back to the project's configured window width so drag
		# panning still does something reasonable instead of silently no-op'ing.
		width = float(ProjectSettings.get_setting("display/window/size/viewport_width", 1280))
	if width <= 0.0:
		return 0.0
	return _camera_size / width


## Right-mouse-drag panning (UI_UX.md §1 allows pan; this is just a second
## way to do it alongside WASD). Right button, not left, so a future
## click-to-build/select interaction on the left button has nothing to fight
## with.
func _apply_drag_pan(relative: Vector2) -> void:
	var sensitivity := _iso_drag_sensitivity()
	if sensitivity <= 0.0:
		return
	# "Grab the world and drag it": the point under the cursor follows the
	# cursor, which means the focus point moves opposite the drag on the
	# right axis and along the forward axis on the (screen-down-is-positive) Y.
	_camera_focus += (-_pan_right * relative.x + _pan_forward * relative.y) * sensitivity
	_update_camera_transform()


# --------------------------------------------------------------------------
# First-person mode
# --------------------------------------------------------------------------

## Rotation around world Y only, no pitch — used both to build the full
## look basis (below) and, on its own, as the horizontal movement basis so
## WASD moves along the ground regardless of where you're looking up/down,
## the same way Minecraft's own flight controls work.
func _fp_heading_basis() -> Basis:
	return Basis(Vector3.UP, _fp_yaw)


## Heading, then tilted by pitch around the resulting local right axis —
## composed in this order specifically so pitch never affects heading.
func _fp_look_basis() -> Basis:
	return _fp_heading_basis() * Basis(Vector3.RIGHT, _fp_pitch)


func _update_fp_camera_transform() -> void:
	if _camera == null:
		return
	_camera.transform = Transform3D(_fp_look_basis(), _fp_position)


## Mouse-look, deliberately Input-free (see _apply_pan's equivalent note) so
## test_camera_nav.gd can call it directly with a synthetic delta.
func _apply_look(relative: Vector2) -> void:
	_fp_yaw -= relative.x * FP_MOUSE_SENSITIVITY
	_fp_pitch = clampf(_fp_pitch - relative.y * FP_MOUSE_SENSITIVITY, -FP_PITCH_LIMIT, FP_PITCH_LIMIT)
	_update_fp_camera_transform()


## Reads held keys only, same split as _pan_input_direction for the same
## reason (untestable headlessly without a live Input singleton). SPACE/SHIFT
## for up/down, Minecraft-style — SPACE only spawns a tomato in ISOMETRIC mode
## (_unhandled_input gates that), so there's no conflict with flying up here.
func _fp_input_direction() -> Vector3:
	var heading := _fp_heading_basis()
	var forward := -heading.z
	var right := heading.x
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= right
	if Input.is_key_pressed(KEY_SPACE):
		move += Vector3.UP
	if Input.is_key_pressed(KEY_SHIFT):
		move -= Vector3.UP
	return move


## The actual movement, Input-free and directly testable — mirrors _apply_pan.
func _apply_fp_move(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	_fp_position += direction.normalized() * FP_MOVE_SPEED * delta
	_update_fp_camera_transform()


func _fp_camera_move(delta: float) -> void:
	_apply_fp_move(_fp_input_direction(), delta)


## TAB toggles between ISOMETRIC and FIRST_PERSON. Both share the one
## Camera3D node — this reconfigures it (projection, near plane, aspect
## policy) rather than creating a second one.
func _set_view_mode(mode: int) -> void:
	if mode == _view_mode:
		return
	_view_mode = mode
	_update_crosshair_visibility()

	if mode == ViewMode.FIRST_PERSON:
		_iso_dragging = false
		# Start hovering above wherever the isometric view was focused, so
		# the switch feels continuous instead of teleporting to the origin.
		_fp_position = _camera_focus + Vector3(0.0, TILE * 1.5, 0.0)
		# Best-effort continuity, not an exact guarantee: face roughly the
		# same way the isometric camera was looking. Mouse-look overrides it
		# immediately, so an imperfect starting angle here doesn't matter.
		_fp_yaw = atan2(-_pan_forward.x, -_pan_forward.z)
		_fp_pitch = deg_to_rad(-15.0)
		_camera.projection = Camera3D.PROJECTION_PERSPECTIVE
		_camera.fov = FP_FOV
		_camera.near = FP_NEAR
		_camera.keep_aspect = Camera3D.KEEP_HEIGHT
		# ...unless the build menu is up, which needs the cursor (see
		# _set_shop_menu_open); closing it recaptures.
		if not _shop_open:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		_update_fp_camera_transform()
		if _help_label != null:
			_help_label.text = FP_HELP_TEXT
	else:
		# Keep the isometric view's height (its focus point's Y never moved
		# on its own), just recentre X/Z on wherever first-person ended up.
		_camera_focus = Vector3(_fp_position.x, _camera_focus.y, _fp_position.z)
		_camera.projection = Camera3D.PROJECTION_ORTHOGONAL
		_camera.near = ISO_NEAR
		_camera.keep_aspect = Camera3D.KEEP_WIDTH
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		_update_camera_transform()
		if _help_label != null:
			_help_label.text = ISO_HELP_TEXT
	_update_camera_transform()


## Fits the orthographic frustum to the factory floor's bounding box by
## projecting its eight corners onto the camera's own right/up axes.
##
## Worth doing properly rather than eyeballing a constant: the chain's length
## is whatever data/recipes.ron currently defines, so the framing has to be
## derived, and an isometric view rotates the world box 45 degrees relative to
## the screen — a naive "width = chain length" estimate is wrong in both
## directions at once.
func _framing_size(basis: Basis) -> float:
	var x_from := float(_frame_bounds.position.x - FLOOR_MARGIN_X) - 0.5
	var x_to := float(_frame_bounds.position.x + _frame_bounds.size.x + FLOOR_MARGIN_X) + 0.5
	var z_from := float(_frame_bounds.position.y - FLOOR_MARGIN_Z) - 0.5
	var z_to := float(_frame_bounds.position.y + _frame_bounds.size.y + FLOOR_MARGIN_Z) + 0.5

	var min_right := INF
	var max_right := -INF
	var min_up := INF
	var max_up := -INF
	for cx in [x_from, x_to]:
		for cz in [z_from, z_to]:
			# 0 .. one tile tall covers the floor slab through the machines'
			# vessels; the exhaust stacks poking above are not worth zooming
			# the whole factory out for.
			for cy in [0.0, TILE]:
				var corner := Vector3(cx * TILE, cy, cz * TILE)
				min_right = min(min_right, basis.x.dot(corner))
				max_right = max(max_right, basis.x.dot(corner))
				min_up = min(min_up, basis.y.dot(corner))
				max_up = max(max_up, basis.y.dot(corner))

	var aspect := 16.0 / 9.0
	var viewport := get_viewport()
	if viewport != null:
		var rect := viewport.get_visible_rect().size
		if rect.x > 0.0 and rect.y > 0.0:
			aspect = rect.x / rect.y

	var needed_width := max_right - min_right
	var needed_height := max_up - min_up
	return max(needed_width, needed_height * aspect) * 1.06


## UI_UX.md §4: real-time dynamic lighting with soft shadows, light ambient
## occlusion in voxel crevices, and mild bloom on emissives — the
## "modded Minecraft with a shader pack" reference point, not photorealism.
## All of it is stock Forward+ environment configuration; no custom shaders.
##
## The sky IS the visible backdrop (BG_SKY), not just a light source — a
## flat near-black BG_COLOR was tried first specifically to avoid a hard
## horizon line/sun streak behind the tightly-framed isometric view, but it
## reads as an empty void the moment first-person mode lets you look around
## freely, which fights UI_UX.md §3's "a real factory you could walk into,"
## not a factory floating in nothing. A soft, bright, sun-disk-free sky (see
## sun_angle_max below) keeps the "no distracting streak" property that
## motivated the original choice, while actually looking like somewhere.
func _build_environment() -> void:
	var sky_material := ProceduralSkyMaterial.new()
	# A brighter, friendlier daytime sky than the original — still a
	# believable overcast-ish industrial-zone sky (UI_UX.md §3's "grounded,
	# not cartoonish"), just not dim enough to read as night or a void.
	sky_material.sky_top_color = Color(0.42, 0.55, 0.72)
	sky_material.sky_horizon_color = Color(0.78, 0.81, 0.83)
	sky_material.ground_horizon_color = Color(0.42, 0.40, 0.37)
	sky_material.ground_bottom_color = Color(0.24, 0.23, 0.21)
	# Still no sun disk: the default draws a wide soft halo that the glow pass
	# smears into a distracting beam. Brightness now comes from the sky
	# colours and the key light below, not a visible sun.
	sky_material.sun_angle_max = 0.0
	var sky := Sky.new()
	sky.sky_material = sky_material

	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	# Sky-derived ambient is what fills the shadowed sides of a voxel model;
	# without it, unlit faces read as flat black and the medium looks cheap.
	# Raised from the original 0.55 alongside the brighter sky above.
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.8

	env.ssao_enabled = true
	env.ssao_radius = 0.9
	env.ssao_intensity = 2.4
	env.ssao_power = 1.6

	env.glow_enabled = true
	env.glow_intensity = 0.7
	env.glow_bloom = 0.15
	env.glow_hdr_threshold = 0.85
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT

	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_white = 6.0
	# Raised from 0.92 to match the brighter sky/ambient — ACES still rolls
	# off highlights safely, so this doesn't blow out the metal specular.
	env.tonemap_exposure = 1.05
	# Deliberately no depth fog: it was tried, and at this camera distance it
	# flattened the whole factory into one haze-grey value and cost more
	# contrast than the atmosphere was worth.

	var world_env := WorldEnvironment.new()
	world_env.name = "Environment"
	world_env.environment = env
	add_child(world_env)

	# Key light: warm, shadow-casting, angled so machinery casts shadows
	# across the belt line rather than straight down it.
	var sun := DirectionalLight3D.new()
	sun.name = "KeyLight"
	sun.rotation_degrees = Vector3(-52.0, -130.0, 0.0)
	sun.light_color = Color(1.0, 0.95, 0.88)
	sun.light_energy = 1.6
	sun.shadow_enabled = true
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	sun.directional_shadow_max_distance = 160.0
	sun.shadow_blur = 1.4
	# A non-zero angular size is what actually softens the shadow edge with
	# distance, rather than just blurring the whole map uniformly.
	sun.light_angular_distance = 0.6
	add_child(sun)

	# Cool fill from the opposite side, no shadows — keeps the shadowed faces
	# of stainless steel from going dead grey.
	var fill := DirectionalLight3D.new()
	fill.name = "FillLight"
	fill.rotation_degrees = Vector3(-28.0, 55.0, 0.0)
	fill.light_color = Color(0.72, 0.80, 1.0)
	fill.light_energy = 0.4
	fill.shadow_enabled = false
	add_child(fill)


# --------------------------------------------------------------------------
# HUD
# --------------------------------------------------------------------------

## `n` design pixels at the current UI scale, as a float — for content
## margins, offsets and sizes.
func _ui_px(n: float) -> float:
	return round(n * UI_SCALE)


## [`_ui_px`] for the properties Godot types as `int`: border widths, theme
## separation constants, text outline sizes.
func _ui_i(n: float) -> int:
	return int(round(n * UI_SCALE))


## [`_ui_px`] applied to both axes of a `Vector2` — icon squares, fixed slot
## sizes, a label's offset inside its button.
func _ui_v(v: Vector2) -> Vector2:
	return Vector2(_ui_px(v.x), _ui_px(v.y))


## A font size `delta` steps off the body size, at the current UI scale.
## Every `LabelSettings` in this file goes through here, so the type
## hierarchy (money biggest, a docket's footnote smallest) is stated once as
## a set of offsets from [`UI_FONT_BASE`] and re-derived at whatever scale is
## in force. The floor is a guard against a future scale small enough to
## round a footnote out of existence, not something today's numbers reach.
func _ui_font(delta: int = 0) -> int:
	return maxi(8, int(round(float(UI_FONT_BASE + delta) * UI_SCALE)))


func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.name = "HUD"
	add_child(hud)

	# A dark plate with a single hazard-yellow rule along the top. UI_UX.md
	# §5's real UI pass (clipboard/checklist widgets, voxel-rendered icon
	# slots) is its own piece of work; this is the minimum that keeps text
	# legible over a lit 3D scene, rather than pretending to be that pass.
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.74)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.border_width_top = _ui_i(3)
	style.set_content_margin_all(_ui_px(12.0))

	var panel := PanelContainer.new()
	panel.add_theme_stylebox_override("panel", style)
	panel.position = _ui_v(Vector2(16, 16))
	hud.add_child(panel)

	var rows := VBoxContainer.new()
	rows.add_theme_constant_override("separation", _ui_i(4))
	panel.add_child(rows)

	var settings := LabelSettings.new()
	settings.font_size = _ui_font()
	settings.font_color = Color(0.92, 0.93, 0.94)
	settings.outline_size = _ui_i(4)
	settings.outline_color = Color(0, 0, 0, 0.85)

	_help_label = Label.new()
	_help_label.label_settings = settings
	_help_label.text = ISO_HELP_TEXT
	rows.add_child(_help_label)

	# UI_UX.md §5: "a contract IS a clipboard." The money/contract readout
	# used to be a plain Label folded into the panel above (milestone 5); it
	# now gets its own diegetic clipboard panel — paper background, a steel
	# clip bar, checkbox-style tick marks for delivery progress.
	_build_contract_panel(hud, settings)

	# UI_UX.md §5's other named widget: "build/recipe menus as grids of
	# voxel-rendered icon slots." Hidden until E is pressed.
	_build_shop_menu(hud, settings)
	_build_ingredient_market(hud, settings)

	# UI_UX.md §5's LAST unbuilt named widget: "a Minecraft-style hotbar/
	# quick-access strip along one screen edge." Always visible, unlike the
	# menu above — it is how a kind gets picked up now, and the menu is where
	# more of one gets bought.
	_build_hotbar(hud, settings)

	# The panel a placed hopper or fluid tank opens when it is CLICKED — the
	# replacement for the SPACE/V/Q keybinds. See `_config_panel`'s doc.
	_build_config_panel(hud, settings)

	# The hover tooltip (docs/UI_UX.md §5): replaces the always-on per-machine
	# text this panel used to show — see _build_hover_tooltip/
	# _update_hover_tooltip below.
	_build_hover_tooltip(hud)
	# The build-mode prompt (the "Real Placement" epic's ticket 2) — the same
	# dark plate by the cursor, saying what the next click will do.
	_build_placement_prompt(hud, settings)
	_build_crosshair(hud)
	# The way out (the save/main-menu epic's ticket 2). Last, so it draws over
	# every other panel — it is the one modal that means the game has stopped.
	_build_pause_menu(hud, settings)
	# The payout celebration (the "make earning money feel like something"
	# ticket). Last of all, and its "+N" is the last child of the HUD, so the
	# one thing that only appears for a second draws over every panel that is
	# permanently there.
	_build_payout_feedback(hud)
	_update_sound_button()


## The diegetic clipboard/checklist widget (UI_UX.md §5) — the money/contract
## readout as "a paper texture on a metal clipboard clip" rather than a plain
## Label. Deliberately its own PanelContainer, sibling to (not nested inside)
## the generic HUD panel above, so this stays intact regardless of what other
## panels come and go there.
##
## LAYOUT DECISION (contracts-as-data, ticket 2). `economy_snapshot_json`
## reports an ARRAY of contracts, so this is a board of dockets, not a
## clipboard per contract: one sheet of paper under one steel clip, carrying
## the SHARED money figure and the SHARED dock stock once at the top, then one
## printed docket card per contract stacked below. Both alternatives were
## considered and rejected — a separate PanelContainer per contract repeats
## the 12px clip bar and the paper frame three times over for no new
## information, and a single flat list of checklist rows loses which rows
## belong to which order the moment two contracts want the same item (all
## three shipped contracts want `boxed_ketchup`). A docket is a slightly
## darker paper tone with a steel hairline — the same two colours the panel
## and its checkboxes already use, so this adds separation without adding a
## visual language.
func _build_contract_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	# Paper cream background + a thick steel-toned top border standing in for
	# "the clip" — the same technique the panel above already uses for its
	# hazard-yellow accent rule, just recoloured and thickened. UI_UX.md §5
	# only asks for "even just a contrasting-coloured strip along one edge,"
	# so nothing fancier (a drawn clasp, a texture) is warranted yet.
	var paper_style := StyleBoxFlat.new()
	paper_style.bg_color = Color(0.87, 0.81, 0.64, 0.98) # warm off-white paper
	paper_style.border_color = Color(0.27, 0.29, 0.32, 1.0) # steel-grey frame/clip
	paper_style.border_width_left = _ui_i(3)
	paper_style.border_width_right = _ui_i(3)
	paper_style.border_width_bottom = _ui_i(3)
	paper_style.border_width_top = _ui_i(12) # the clip bar
	paper_style.set_content_margin_all(_ui_px(10.0))
	paper_style.content_margin_top = _ui_px(15.0) # clearance under the thicker clip bar

	_contract_panel = PanelContainer.new()
	_contract_panel.name = "ContractPanel"
	_contract_panel.add_theme_stylebox_override("panel", paper_style)
	hud.add_child(_contract_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(6))
	_contract_panel.add_child(body)

	# Dark ink on paper, not the pale-text-with-black-outline style the panel
	# above uses — that styling exists specifically to stay legible over a
	# lit 3D scene, which doesn't apply once text sits on an opaque paper
	# panel. Font family and size are still the ones already established in
	# _build_ui() (UI_UX.md §5's own "sturdy, slightly blocky" typography
	# call), only colour/outline change for the paper background.
	_contract_ink_settings = LabelSettings.new()
	_contract_ink_settings.font_size = _ui_font()
	_contract_ink_settings.font_color = Color(0.16, 0.13, 0.08)
	_contract_ink_settings.outline_size = 0

	# A small type-scale hierarchy on the clipboard, added during the visual-
	# overhaul pass: the title and the money figure used to share the exact
	# body text size, so nothing on the panel told the eye what mattered most
	# — a real UI_UX.md §5 polish gap ("typography/readability issues"), not
	# just an aesthetic nicety. Same ink colour and family throughout, only
	# size steps up, so it still reads as one consistent clipboard rather
	# than mixed styles. With several dockets on the board the hierarchy has
	# one more rung: a contract's NAME is the heading of its own docket, and
	# its cadence/tally line is deliberately the smallest thing on the panel.
	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(2)
	title_settings.font_color = _contract_ink_settings.font_color
	title_settings.outline_size = 0

	var money_settings := LabelSettings.new()
	money_settings.font_size = _ui_font(6)
	money_settings.font_color = _contract_ink_settings.font_color
	money_settings.outline_size = 0

	_contract_name_settings = LabelSettings.new()
	_contract_name_settings.font_size = _ui_font(1)
	_contract_name_settings.font_color = _contract_ink_settings.font_color
	_contract_name_settings.outline_size = 0

	# The tick mark gets its own settings, not the body ink's. At body size a
	# "✓" overflows a 14px checkbox and renders as a clipped diagonal in the
	# corner (visible only in a real screenshot — the headless test happily
	# reports a visible Mark node either way), and dark ink on the checked
	# green is the panel's weakest contrast anywhere. Small and paper-pale
	# fixes both.
	_checkbox_mark_settings = LabelSettings.new()
	_checkbox_mark_settings.font_size = _ui_font(-4)
	_checkbox_mark_settings.font_color = Color(0.91, 0.88, 0.78)
	_checkbox_mark_settings.outline_size = 0

	_contract_meta_settings = LabelSettings.new()
	_contract_meta_settings.font_size = _ui_font(-3)
	# A touch lighter than body ink — still well clear of the paper, but the
	# cadence/tally line should read as a footnote on the docket, not as
	# another checklist item.
	_contract_meta_settings.font_color = Color(0.34, 0.29, 0.20)
	_contract_meta_settings.outline_size = 0

	# Heading and balance share one row (the same tightening the build menu
	# and the market got in the 2026-09-09 UI-scale pass, so all three panels
	# read the same way). At half again the type size, two short strings on
	# two lines was a whole docket's worth of the board's height.
	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(12))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "CONTRACTS"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	heading.add_child(title)

	# Money is shown ONCE, here, and never per docket: GAMEPLAY.md §1 allows
	# exactly one currency, and sim_core keeps exactly one counter for it.
	_contract_money_label = Label.new()
	_contract_money_label.label_settings = money_settings
	_contract_money_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	heading.add_child(_contract_money_label)

	# The shared delivery pool, also once. See _update_contract_dock for why
	# this line exists at all.
	_contract_dock_row = HBoxContainer.new()
	_contract_dock_row.name = "DockRow"
	_contract_dock_row.add_theme_constant_override("separation", _ui_i(6))
	body.add_child(_contract_dock_row)

	var dock_title := Label.new()
	dock_title.label_settings = _contract_meta_settings
	dock_title.text = "ON THE DOCK"
	_contract_dock_row.add_child(dock_title)

	_contract_dock_empty_label = Label.new()
	_contract_dock_empty_label.label_settings = _contract_meta_settings
	_contract_dock_empty_label.text = "empty"
	_contract_dock_row.add_child(_contract_dock_empty_label)

	_checkbox_style_unchecked = StyleBoxFlat.new()
	_checkbox_style_unchecked.bg_color = Color(0.80, 0.74, 0.57, 1.0) # a shade darker than the paper
	_checkbox_style_unchecked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_unchecked.set_border_width_all(_ui_i(2))

	_checkbox_style_checked = StyleBoxFlat.new()
	_checkbox_style_checked.bg_color = Color(0.24, 0.42, 0.24, 1.0) # a muted, saturated "done" green —
	# UI_UX.md §7: saturated colour reserved for meaning, and a completed
	# checklist item is exactly that meaning, not decoration.
	_checkbox_style_checked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_checked.set_border_width_all(_ui_i(2))

	# One docket = the checkbox's own paper tone plus a steel hairline. Reusing
	# those two existing colours is the point (see this function's header):
	# separation without a third palette.
	_contract_card_style = StyleBoxFlat.new()
	_contract_card_style.bg_color = Color(0.83, 0.77, 0.60, 1.0)
	_contract_card_style.border_color = Color(0.47, 0.44, 0.38, 1.0)
	_contract_card_style.set_border_width_all(_ui_i(1))
	_contract_card_style.set_content_margin_all(_ui_px(6.0))

	# The dockets live in a ScrollContainer whose height is capped in
	# _update_contract_panel — a safety valve for a future contracts.ron with
	# more orders than fit, not a UI the player is expected to drive today.
	_contract_cards_scroll = ScrollContainer.new()
	_contract_cards_scroll.name = "ContractList"
	_contract_cards_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_contract_cards_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_contract_cards_scroll)

	_contract_cards_box = VBoxContainer.new()
	_contract_cards_box.name = "ContractCards"
	_contract_cards_box.add_theme_constant_override("separation", _ui_i(5))
	_contract_cards_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_contract_cards_scroll.add_child(_contract_cards_box)

	# One docket per active contract, read live from economy_snapshot_json
	# rather than assumed — nothing here hardcodes how many contracts exist,
	# what they ask for, or what they pay.
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_rebuild_contract_cards(econ.get("contracts", []))

	# Anchored to the top-right corner with a fixed margin, sized to its own
	# content — independent of however tall the machine-line panel ends up
	# being.
	_contract_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE, 16)


## Rebuilds the docket stack from a `contracts` array. Called once at build
## time and again only if the SET of contract ids changes — the shipped world
## loads its contracts once and never adds or drops one, but a future
## "contract accepted / contract lost" mechanic (GAMEPLAY.md §11's open
## question about what a missed window costs) would, and the guard costs a
## string compare per frame.
func _rebuild_contract_cards(contracts: Array) -> void:
	for card in _contract_cards:
		# Detach FIRST, then queue_free: queue_free is deferred to the end of
		# the frame, so freeing alone would leave the old dockets in the
		# container alongside the new ones for a frame. Detach from whatever
		# the panel's parent actually IS rather than from the current card
		# box — a scene re-entering the tree runs _ready (and so
		# _build_contract_panel) a second time, at which point these records
		# still point at the previous build's container.
		var panel: Node = card["panel"]
		if is_instance_valid(panel):
			if panel.get_parent() != null:
				panel.get_parent().remove_child(panel)
			panel.queue_free()
	_contract_cards.clear()
	_contract_card_ids.clear()
	for contract in contracts:
		_contract_cards.append(_build_contract_card(contract))
		_contract_card_ids.append(String(contract.get("id", "")))


## One contract's docket: its name and payout on a header row, a checklist row
## per line of its mix, and its OWN cadence/tally footnote. Every contract
## clocks independently in sim_core, so this countdown is per docket and is
## never shared the way money is.
##
## Returns the record `_update_contract_panel` drives it through:
##   {"id", "panel", "name_label", "payout_label", "meta_label",
##    "rows": {item id -> {"icon", "label", "boxes"}}}
func _build_contract_card(contract: Dictionary) -> Dictionary:
	var panel := PanelContainer.new()
	panel.name = "ContractCard_%s" % String(contract.get("id", "?"))
	panel.add_theme_stylebox_override("panel", _contract_card_style)
	_contract_cards_box.add_child(panel)

	var card_body := VBoxContainer.new()
	card_body.add_theme_constant_override("separation", _ui_i(4))
	panel.add_child(card_body)

	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", _ui_i(10))
	card_body.add_child(header)

	var name_label := Label.new()
	name_label.label_settings = _contract_name_settings
	name_label.text = String(contract.get("name", contract.get("id", "?")))
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(name_label)

	# What this order is worth per delivery. It is the whole reason a player
	# chooses which docket to feed when the line can't serve them all
	# (GAMEPLAY.md §6), so it belongs on the docket, not in a tooltip.
	var payout_label := Label.new()
	payout_label.label_settings = _contract_name_settings
	payout_label.text = "+%d" % int(contract.get("payout", 0))
	# The figure kept beside the text, because the PAID stamp overwrites the
	# text for a beat when this contract settles and has to put it back
	# afterwards without re-reading a snapshot.
	payout_label.set_meta("payout", int(contract.get("payout", 0)))
	payout_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	header.add_child(payout_label)

	var rows: Dictionary = {}
	for pair in contract.get("mix", []):
		var item_id: String = String(pair[0])
		var required: int = int(pair[1])
		rows[item_id] = _build_contract_checklist_row(card_body, item_id, required)

	var meta_label := Label.new()
	meta_label.label_settings = _contract_meta_settings
	card_body.add_child(meta_label)

	return {
		"id": String(contract.get("id", "")),
		"panel": panel,
		"name_label": name_label,
		"payout_label": payout_label,
		"meta_label": meta_label,
		"rows": rows,
	}


## One checklist row: the item's numeric progress text, plus a row of small
## checkbox squares — one per required unit, per UI_UX.md §5's "checkbox-
## style tick marks for completed items." A contract asking for a very large
## quantity would make a per-unit row unreadably wide, so past
## CONTRACT_CHECKLIST_MAX_BOXES this falls back to a single box standing for
## "fully delivered" — the minimum the original ticket calls acceptable.
##
## Returns `{"icon", "label", "boxes"}` for its docket's record: the nodes are
## no longer stashed in a panel-wide dictionary keyed by item id, because
## several contracts legitimately ask for the SAME item (every contract in the
## shipped `data/contracts.ron` wants `boxed_ketchup`) and one such dictionary
## would have them silently overwrite each other's rows.
func _build_contract_checklist_row(body: VBoxContainer, item_id: String, required: int) -> Dictionary:
	# Icon + text share a row: UI_UX.md §5's "icons are rendered from the
	# real assets" (_icon_for) applied to the one place this panel names a
	# specific item.
	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", _ui_i(6))
	body.add_child(header)

	var icon := TextureRect.new()
	icon.custom_minimum_size = _ui_v(Vector2(16, 16))
	# Without this, TextureRect's own minimum size defaults to the source
	# texture's actual size (64x64) and wins over custom_minimum_size above —
	# EXPAND_IGNORE_SIZE is what makes the 16x16 slot actually stick.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	header.add_child(icon)

	var progress_label := Label.new()
	progress_label.label_settings = _contract_ink_settings
	header.add_child(progress_label)

	var checklist := HBoxContainer.new()
	checklist.add_theme_constant_override("separation", _ui_i(4))
	body.add_child(checklist)

	var box_count: int = required if required <= CONTRACT_CHECKLIST_MAX_BOXES else 1
	var boxes: Array = []
	for i in range(box_count):
		var box := Panel.new()
		box.name = "checkbox_%s_%d" % [item_id, i]
		box.custom_minimum_size = _ui_v(Vector2(14, 14))
		box.add_theme_stylebox_override("panel", _checkbox_style_unchecked)
		box.set_meta("checked", false)

		var mark := Label.new()
		mark.name = "Mark"
		mark.text = "✓"
		mark.label_settings = _checkbox_mark_settings
		mark.visible = false
		mark.set_anchors_preset(Control.PRESET_FULL_RECT)
		mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		mark.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		box.add_child(mark)

		checklist.add_child(box)
		boxes.append(box)
	return {"icon": icon, "label": progress_label, "boxes": boxes}


# --------------------------------------------------------------------------
# The build menu (UI_UX.md §5, the "Shop & Inventory" epic's ticket 2)
# --------------------------------------------------------------------------

## The player's first real agency: a grid of voxel-rendered icon slots, one
## per `data/shop.ron` entry, that spends contract money on equipment.
##
## Everything on it comes from `shop_snapshot_json` — kinds, order, unit
## prices, owned counts and affordability — so adding a kind to
## `data/shop.ron` puts a slot here with no Godot edit, exactly the way
## adding a recipe already extends the chain. Ticket 1's snapshot is polled
## rather than pushed, per its own doc: a purchase changes money and a count,
## never a tile, so `dirty_chunk_ids()` will never report one.
##
## Visual language is the scene's DARK PLATE, not the contract clipboard's
## paper — the same near-black panel with a hazard-yellow rule the HUD strip
## and the hover tooltip already use. The clipboard motif is for orders and
## checklists (UI_UX.md §5 says so explicitly); a build menu is machine-side
## factory UI, and it also has to stay legible while floating over a lit 3D
## scene, which is exactly what that dark plate exists for.
func _build_shop_menu(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = _ui_i(4)
	panel_style.border_width_left = _ui_i(2)
	panel_style.border_width_right = _ui_i(2)
	panel_style.border_width_bottom = _ui_i(2)
	panel_style.set_content_margin_all(_ui_px(16.0))

	_shop_menu = PanelContainer.new()
	_shop_menu.name = "ShopMenu"
	_shop_menu.add_theme_stylebox_override("panel", panel_style)
	_shop_menu.visible = false
	hud.add_child(_shop_menu)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(10))
	_shop_menu.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = _ui_font(4)
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	# Heading and balance share ONE row. They were stacked, which at the
	# 2026-09-09 UI scale spent a whole extra line of the panel's height on
	# two short strings — height the catalog grid below needs more.
	var heading := HBoxContainer.new()
	heading.add_theme_constant_override("separation", _ui_i(16))
	body.add_child(heading)

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "BUILD MENU"
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	heading.add_child(title)

	# Money is repeated here rather than left to the contract clipboard in
	# the opposite screen corner. The decision a player makes in this menu is
	# "can I afford that", and making them look across the screen to answer it
	# is exactly the readability problem UI_UX.md §5 is about. It is the same
	# number from the same snapshot — `shop_snapshot_json` carries `money`
	# precisely so a build menu is one call — not a second counter.
	var money_settings := LabelSettings.new()
	money_settings.font_size = _ui_font(6)
	money_settings.font_color = Color(0.98, 0.85, 0.42) # the panel's own hazard accent
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_shop_money_label = Label.new()
	_shop_money_label.label_settings = money_settings
	_shop_money_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	heading.add_child(_shop_money_label)

	# The grid lives in a ScrollContainer whose height `_position_shop_menu`
	# fits to whatever is left above the hotbar. **This is a last resort and
	# is meant never to engage at a normal window size**: at 1600x900 (the
	# resolution `scripts/screenshot-scene.sh` reviews at) the whole
	# twelve-kind catalog fits with room to spare and the scrollbar never
	# appears. It exists because at `project.godot`'s own 1280x720 the
	# 2026-09-09 UI scale genuinely does not leave room for two rows of cards
	# plus a title, a balance and a footer — and of the two ways to lose that
	# fight, a grid that scrolls a little is much better than a menu whose
	# footer disappears under the hotbar, which is the exact failure
	# `_position_shop_menu` was written to prevent in the first place. The
	# same shape (and the same reasoning) as the contract clipboard's docket
	# stack.
	_shop_grid_scroll = ScrollContainer.new()
	_shop_grid_scroll.name = "ShopGridScroll"
	_shop_grid_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_shop_grid_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_shop_grid_scroll)

	var grid := GridContainer.new()
	grid.name = "ShopGrid"
	grid.columns = SHOP_SLOT_COLUMNS
	grid.add_theme_constant_override("h_separation", _ui_i(8))
	grid.add_theme_constant_override("v_separation", _ui_i(8))
	_shop_grid = grid
	_shop_grid_scroll.add_child(grid)

	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	for index in range(entries.size()):
		_build_shop_slot(grid, base_settings, index, String(entries[index]["kind"]))

	var footer := Label.new()
	footer.label_settings = base_settings
	# Two lines since the 2026-09-09 UI scale: a Label does not wrap unless
	# told to, so at this font size one long line would set the panel's
	# minimum width wider than the window it has to sit in.
	footer.text = "left-click (or SHIFT+its number) buys one\nright-click (or just its number) puts one in your hand    E/ESC: close"
	body.add_child(footer)

	_position_shop_menu()


## Centres the menu in the space ABOVE the hotbar rather than in the whole
## viewport. The strip is always on screen now, and a plain centred menu tall
## enough to reach it buries its own FOOTER under the plate — which is exactly
## where the two mouse buttons' meanings are written down, so the one line
## that explains buying was the one line the hotbar hid. Found in a rendered
## frame; nothing in the code could have shown it.
func _position_shop_menu() -> void:
	if _shop_menu == null:
		return
	_shop_menu.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)
	var vp := get_viewport()
	if vp == null:
		return
	var reserved := _hotbar_reserved_height()
	var bounds := vp.get_visible_rect().size
	_fit_grid_scroll(_shop_grid_scroll, _shop_grid, bounds.y - reserved - _ui_px(16.0))
	var menu_size := _shop_menu.get_combined_minimum_size()
	_shop_menu.position.y = max(8.0, (bounds.y - reserved - menu_size.y) * 0.5)


## Gives `grid` as much of `available` as its panel's own chrome leaves it,
## and no more than it actually needs.
##
## The chrome is MEASURED rather than assumed: ask the panel for its full
## height with the grid at full height, subtract the grid, and what is left
## is the title, the balance, the footer and every margin between them. That
## is what makes this survive a reworded footer or a fifth line of heading
## without someone remembering to re-tune a constant — the failure mode this
## menu has hit twice already (see `SHOP_SLOT_COLUMNS`).
## How much of the bottom of the screen the hotbar strip owns. Every panel
## that has to stay clear of it asks here rather than repeating the sum, so
## none of them can drift apart. Falls back to a computed estimate before the
## strip has laid itself out, which is the state a headless run stays in.
func _hotbar_reserved_height() -> float:
	if _hotbar_root != null and _hotbar_root.size.y > 0.0:
		return _hotbar_root.size.y + HOTBAR_BOTTOM_MARGIN * 2.0
	return HOTBAR_SLOT_SIZE.y * HOTBAR_SELECTED_SCALE + HOTBAR_BOTTOM_MARGIN * 3.0


func _fit_grid_scroll(scroll: ScrollContainer, grid: Control, available: float) -> void:
	if scroll == null or grid == null:
		return
	var natural: float = grid.get_combined_minimum_size().y
	scroll.custom_minimum_size.y = natural
	var panel := scroll.get_parent()
	while panel != null and not (panel is PanelContainer):
		panel = panel.get_parent()
	var chrome: float = 0.0
	if panel != null:
		chrome = (panel as Control).get_combined_minimum_size().y - natural
	# A floor, so a viewport too small for even one row leaves a scrollable
	# stub rather than a panel with no grid in it at all.
	var cap: float = maxf(_ui_px(110.0), available - chrome)
	scroll.custom_minimum_size.y = minf(natural, cap)


## One icon slot. A Button rather than a Panel so pressing it is the whole
## interaction — no selection cursor, no confirm step, no second mode to
## explain; this is the project's first interactive menu and the simplest
## thing that works is the right thing. Its label children ignore the mouse
## so the entire square stays one click target.
func _build_shop_slot(grid: GridContainer, base_settings: LabelSettings, index: int, kind: String) -> void:
	var button := Button.new()
	button.name = "ShopSlot_%s" % kind
	button.custom_minimum_size = SHOP_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(state, _shop_slot_style(state))
	button.pressed.connect(_on_shop_slot_pressed.bind(index))
	# Right-click is the PLACE half of a slot (see `_on_shop_slot_gui_input`).
	# A Button only reports the left button through `pressed`, so the second
	# action has to come off the raw event.
	button.gui_input.connect(_on_shop_slot_gui_input.bind(index))
	grid.add_child(button)

	# Anchored over the button rather than parented through a container: a
	# Button lays its own (text) content out and is not a container, so its
	# children have to place themselves.
	var column := VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	column.add_theme_constant_override("separation", _ui_i(2))
	column.set_anchors_preset(Control.PRESET_FULL_RECT)
	column.offset_left = _ui_px(8)
	column.offset_right = -_ui_px(8)
	column.offset_top = _ui_px(8)
	column.offset_bottom = -_ui_px(8)
	button.add_child(column)

	# The hotkey corner. Slots past SHOP_HOTKEY_SLOTS simply show nothing
	# here and stay click-only, rather than inventing a second key scheme.
	var hotkey_settings := LabelSettings.new()
	hotkey_settings.font_size = _ui_font(-3)
	hotkey_settings.font_color = Color(0.62, 0.64, 0.68)
	hotkey_settings.outline_size = base_settings.outline_size
	hotkey_settings.outline_color = base_settings.outline_color

	var hotkey := Label.new()
	hotkey.name = "Hotkey"
	hotkey.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hotkey.label_settings = hotkey_settings
	# The SAME digit the hotbar prints on the same slot — menu slot N and
	# hotbar slot N are one kind, so one label serves both. Since the
	# inventory-hotbar ticket that digit no longer means "buy": it means
	# "select", here as well as down on the strip, and SHIFT+it buys.
	#
	# Parented to the BUTTON and positioned in its corner rather than added
	# to the column, exactly as the hotbar socket's own digit is. In the
	# column it was a whole row of the card's height for one character, and
	# at the 2026-09-09 UI scale that row was the difference between the grid
	# fitting above the hotbar and not.
	hotkey.text = _hotbar_key_label(index)
	hotkey.position = _ui_v(Vector2(7, 3))
	button.add_child(hotkey)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = SHOP_ICON_SIZE
	# Same reason _build_contract_checklist_row gives: without
	# EXPAND_IGNORE_SIZE a TextureRect's minimum size is the source PNG's own
	# 64x64, which would win over custom_minimum_size above.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for_asset(_shop_asset_for(kind))
	column.add_child(icon)

	var name_label := Label.new()
	name_label.name = "KindName"
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = base_settings
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.text = _kind_display_name(kind)
	column.add_child(name_label)

	var price_settings := LabelSettings.new()
	price_settings.font_size = _ui_font()
	price_settings.font_color = base_settings.font_color
	price_settings.outline_size = base_settings.outline_size
	price_settings.outline_color = base_settings.outline_color

	var price_label := Label.new()
	price_label.name = "Price"
	price_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	price_label.label_settings = price_settings
	price_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	column.add_child(price_label)

	var owned_settings := LabelSettings.new()
	owned_settings.font_size = _ui_font(-2)
	owned_settings.font_color = Color(0.66, 0.68, 0.72)
	owned_settings.outline_size = base_settings.outline_size
	owned_settings.outline_color = base_settings.outline_color

	var owned_label := Label.new()
	owned_label.name = "Owned"
	owned_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	owned_label.label_settings = owned_settings
	owned_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	owned_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	column.add_child(owned_label)

	_shop_slots.append({
		"kind": kind,
		"button": button,
		"icon": icon,
		"price_label": price_label,
		"owned_label": owned_label,
	})


## Flat-shaded slot squares with chunky borders — UI_UX.md §5's Minecraft
## adjacency, and deliberately the same near-black/hazard-yellow pair the
## rest of the HUD already uses rather than a third palette.
func _shop_slot_style(state: String) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.set_border_width_all(_ui_i(3))
	style.set_content_margin_all(_ui_px(6.0))
	match state:
		"hover", "focus":
			style.bg_color = Color(0.19, 0.19, 0.21, 0.98)
			style.border_color = Color(0.85, 0.63, 0.11, 0.95)
		"pressed":
			style.bg_color = Color(0.30, 0.24, 0.08, 0.98)
			style.border_color = Color(0.98, 0.80, 0.22, 1.0)
		"disabled":
			# Visibly recessed and dim: an unaffordable slot reads as "off"
			# from its border and background as well as its greyed icon and
			# its price glyph, never from colour alone (UI_UX.md §7).
			style.bg_color = Color(0.08, 0.08, 0.09, 0.92)
			style.border_color = Color(0.20, 0.21, 0.23, 0.95)
		_:
			style.bg_color = Color(0.13, 0.14, 0.16, 0.96)
			style.border_color = Color(0.36, 0.38, 0.42, 0.95)
	return style


## Which asset's icon stands for a buildable kind — see SHOP_MODELS.
func _shop_asset_for(kind: String) -> String:
	if SHOP_MODELS.has(kind):
		return SHOP_MODELS[kind]
	return MACHINE_MODELS.get(kind, MACHINE_MODEL_FALLBACK)


## "cooking_vat" -> "Cooking Vat". Kind ids are content, so the menu titles
## itself from them rather than carrying a hand-written label per kind that
## a new `data/shop.ron` entry would silently miss.
func _kind_display_name(kind: String) -> String:
	var words: PackedStringArray = kind.split("_", false)
	var out: Array[String] = []
	for word in words:
		out.append(word.capitalize())
	return " ".join(out)


## Repolls `shop_snapshot_json` and redraws every slot. Called each frame
## while the menu is open and once on opening — cheap (one JSON parse of a
## nine-entry object) and it means money earned by the running factory makes
## a slot become affordable under the player's eyes.
func _update_shop_menu() -> void:
	if _shop_menu == null:
		return
	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	_shop_money_label.text = "Money: %.0f" % float(snapshot.get("money", 0.0))
	_position_shop_menu()

	for index in range(_shop_slots.size()):
		if index >= entries.size():
			break
		var slot: Dictionary = _shop_slots[index]
		var entry: Dictionary = entries[index]
		var affordable: bool = bool(entry.get("affordable", false))
		var price: float = float(entry.get("price", 0.0))

		# Three independent signals for "you can't afford this", per
		# UI_UX.md §7's never-colour-alone rule: the price gains a "✗" mark,
		# the icon dims, and the whole slot is disabled (which also recolours
		# its border/background via the disabled stylebox).
		slot["price_label"].text = ("Cost %.0f" % price) if affordable else ("Cost %.0f  ✗" % price)
		slot["price_label"].label_settings.font_color = (
			Color(0.92, 0.93, 0.94) if affordable else Color(0.55, 0.50, 0.48)
		)
		slot["icon"].modulate = Color.WHITE if affordable else Color(0.42, 0.42, 0.45, 0.75)
		slot["button"].disabled = not affordable
		# Just the count. The owned line used to carry the PLACE affordance
		# ("right-click to hold") as well, and at the 2026-09-09 UI scale that
		# sentence wraps onto a second row in every card, which costs the
		# whole grid an extra row — more than the menu has to give above the
		# hotbar. It is not lost: the footer one line below says it, the
		# hotbar tooltip says it, and the number itself (which is what
		# actually decides whether placing is possible) is still here and
		# still recoloured.
		var owned: int = int(entry.get("owned", 0))
		slot["owned_label"].text = "Owned %d" % owned
		slot["owned_label"].label_settings.font_color = (
			Color(0.98, 0.85, 0.42) if owned > 0 else Color(0.66, 0.68, 0.72)
		)


func _on_shop_slot_pressed(index: int) -> void:
	_buy_slot(index)


## A slot has two actions, and they are on the two mouse buttons.
##
## **Left-click buys one; right-click places one you already own.** Both were
## weighed against the alternative of one button that changes meaning with
## the owned count — "click buys when you have none, places when you have
## some" — which is shorter to explain and worse to use: it makes buying a
## second of anything impossible without first placing the first, and it
## makes the same gesture do two different things depending on state the
## player has to remember. Two buttons, two meanings, both spelled out on the
## slot itself (the owned line says "right-click to place") and in the menu's
## footer. The keyboard mirrors it: number buys, SHIFT+number places.
func _on_shop_slot_gui_input(event: InputEvent, index: int) -> void:
	if not (event is InputEventMouseButton):
		return
	if event.button_index != MOUSE_BUTTON_RIGHT or not event.pressed:
		return
	# Consumed here so the isometric camera's right-drag pan never starts
	# under the menu.
	get_viewport().set_input_as_handled()
	_place_from_slot(index)


## Enters placement mode for a slot's kind, if the player owns one. A slot
## with nothing owned simply does nothing — the ghost would be unbuildable,
## and the slot already says "Owned 0".
func _place_from_slot(index: int) -> void:
	if index < 0 or index >= _shop_slots.size():
		return
	_refresh_owned_counts()
	_enter_build_mode(String(_shop_slots[index]["kind"]))


## Buys exactly one of the slot's kind. Quantity is deliberately fixed at
## one — `PlayerCommand::Purchase`'s own wire default — so a click means one
## thing and the menu needs no quantity widget. An unaffordable or unknown
## purchase is a silent no-op in the simulation, so the only thing this has
## to do afterwards is re-read the snapshot either way.
func _buy_slot(index: int) -> void:
	if index < 0 or index >= _shop_slots.size():
		return
	var kind: String = _shop_slots[index]["kind"]
	sim.issue_command_json(JSON.stringify({"type": "purchase", "kind": kind}))
	_refresh_owned_counts()
	_update_shop_menu()


func _set_shop_menu_open(open: bool) -> void:
	if _shop_menu == null or open == _shop_open:
		return
	# One panel at a time: a building's configuration panel is anchored to a
	# building, and leaving it up under a modal grid would leave two panels
	# both claiming the next click.
	if open:
		_close_config_panel()
	_shop_open = open
	_shop_menu.visible = open
	if open:
		_update_shop_menu()
	# The menu is clickable in first-person too, which means handing the
	# mouse back while it is up and recapturing it on close — otherwise the
	# only way to buy in that mode would be the number keys.
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


## The crosshair stands in for the cursor in first-person — so it belongs on
## screen in exactly the case where there is no real cursor. With either shop
## panel up the mouse is handed back (above), and leaving the crosshair drawn
## would park a stray mark on top of a slot.
func _update_crosshair_visibility() -> void:
	if _crosshair == null:
		return
	_crosshair.visible = (_view_mode == ViewMode.FIRST_PERSON
			and not _shop_open and not _market_open and not _pause_open
			and not _config_open)


func _toggle_shop_menu() -> void:
	_set_shop_menu_open(not _shop_open)


# --------------------------------------------------------------------------
# The ingredient market and the larder (the chain-rework epic)
# --------------------------------------------------------------------------

## Repolls `ingredients_snapshot_json`. Two things come off it: the stock
## counts the larder prints, and `hopper_items` — the list of ids a hopper
## may legally be placed holding, which is the simulation's own
## `World::raw_items` rather than anything decided here. A third raw
## ingredient therefore needs no Godot edit at all: it appears in the market,
## in the larder and in a placed hopper's contents picker from the data
## file alone.
func _ingredients_snapshot() -> Dictionary:
	var parsed = JSON.parse_string(sim.ingredients_snapshot_json())
	return parsed if parsed is Dictionary else {}


## id -> owned count, from `_ingredients_snapshot`'s `entries` — the one
## lookup the configuration panel's two fill checks need, so it exists once.
func _owned_ingredient_counts() -> Dictionary:
	var owned := {}
	for entry in _ingredients_snapshot().get("entries", []):
		owned[String(entry.get("id", ""))] = int(entry.get("owned", 0))
	return owned


func _refresh_hopper_items() -> void:
	var snapshot := _ingredients_snapshot()
	var items: Array = snapshot.get("hopper_items", [])
	_hopper_items = items.duplicate()


## What the hopper currently being placed will hold — always the FIRST raw
## ingredient, since the contents choice moved onto the placed building (see
## `_hopper_items`). "" when the kind in hand is not a hopper, or when the
## world has no raw solids at all, which is a world with no recipes and
## cannot happen with shipped content.
func _selected_hopper_item() -> String:
	if _build_kind != HOPPER_KIND or _hopper_items.is_empty():
		return ""
	return String(_hopper_items[0])


## "tomato_paste" -> "Tomato Paste". Item ids are content, exactly as kind ids
## are, so this is `_kind_display_name`'s twin rather than a hand-written
## label table a new ingredient would silently miss.
func _item_display_name(item_id: String) -> String:
	return _kind_display_name(item_id)


## Builds the market panel. Same shape as `_build_shop_menu`, one row of
## slots instead of a grid — there are three ingredients and a row of three
## is shorter and no less readable than a grid of three would be.
func _build_ingredient_market(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = _ui_i(4)
	panel_style.border_width_left = _ui_i(2)
	panel_style.border_width_right = _ui_i(2)
	panel_style.border_width_bottom = _ui_i(2)
	panel_style.set_content_margin_all(_ui_px(16.0))

	# Cleared, never appended to: `_ready()` genuinely runs twice under the
	# headless `--script` harness (see `_rebuild_world`'s note and
	# test_hover.gd's header), and a second pass would otherwise leave the
	# array holding two slots per ingredient — half of them pointing at
	# buttons in an orphaned HUD layer.
	_market_slots.clear()

	_market_panel = PanelContainer.new()
	_market_panel.name = "IngredientMarket"
	_market_panel.add_theme_stylebox_override("panel", panel_style)
	_market_panel.visible = false
	hud.add_child(_market_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", _ui_i(10))
