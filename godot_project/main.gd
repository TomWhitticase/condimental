extends Node3D
## The presentation layer (ARCHITECTURE.md §5) for the data-driven production
## chain `sim_core::World` builds internally — rendered per docs/UI_UX.md:
## full 3D voxel models at the §2 32x32x32 tile scale, viewed through a
## FIXED orthographic isometric camera (§1), lit in real time with shadows,
## ambient occlusion and glow (§4), in a grounded industrial-factory palette
## (§3/§7).
##
## Milestone 5 (Economy MVP, ARCHITECTURE.md §9 item 5) added a minimal money
## + contract-status HUD line, read every frame from `economy_snapshot_json`
## — folded into this scene's readout panel below, not UI_UX.md §5's
## clipboard/checklist diegetic styling yet (that's later polish).
##
## What has NOT changed from the previous flat-2D version, deliberately: this
## script still learns the chain's shape entirely from `chain_layout_json`
## (static, read once) plus `chunk_snapshot_json`/`dirty_chunk_ids` (dynamic,
## per tick). Stage count, tile positions and item identities all come from
## the simulation; nothing about the chain is hardcoded here, and nothing
## here reads a belt's gap array or a machine's raw `TimedProcess`. Godot
## still draws what the sim says exists — it just draws it far better.
##
## Assets come from `res://voxels/`, staged there by `cargo xtask` from
## `assets/voxels/models/` (generated by `cargo run -p voxgen`). Each asset is
## one mesh per material class, so steel can be shinier than concrete and
## status lamps can actually emit — UI_UX.md §4's explicit metal exception.
##
## Two view modes, toggled with TAB: ISOMETRIC (this doc's §1 fixed
## orthographic camera, pan/zoom only) and FIRST_PERSON (a free-look
## perspective "walk" camera, not part of UI_UX.md — this project has no
## player entity or collision geometry, so it's a fly-cam: no gravity, no
## walls stop you). Both modes reuse the same single `Camera3D` node,
## switching its projection/position/orientation rather than swapping nodes,
## so "exactly one Camera3D" stays true regardless of mode.

# --- Scale ---------------------------------------------------------------
# UI_UX.md §2 fixes one world tile at 32x32x32 voxels. The .vox importer's
# default Scale option turns one voxel into 0.1 world units, so a tile is
# 3.2 units across and every asset shares that unit automatically.
const VOXELS_PER_TILE := 32
const VOXEL_UNIT := 0.1
const TILE := VOXELS_PER_TILE * VOXEL_UNIT

# Heights below are stated in voxels and converted, so they stay readable
# against the generators in assets/voxels/generators/assets.rs.
const FLOOR_VOXELS := 3 # floor_tile's slab thickness
const BELT_SURFACE_VOXELS := 10 # top of belt's running surface
const FLOOR_Y := FLOOR_VOXELS * VOXEL_UNIT
const BELT_SURFACE_Y := FLOOR_Y + BELT_SURFACE_VOXELS * VOXEL_UNIT

# How far past the chain the ISOMETRIC camera's auto-framing considers —
# kept small and deliberately separate from FLOOR_GROUND_MARGIN below, or a
# bigger floor would also zoom the default isometric view out to fit it.
const FLOOR_MARGIN_X := 2
const FLOOR_MARGIN_Z := 2
# How far the floor MESH actually extends past the chain — much larger than
# the framing margin above, so flying around in first-person doesn't reveal
# a "floating island" edge a few steps past the machines. Purely a ground
# plane; the isometric camera never zooms out to show all of it.
const FLOOR_GROUND_MARGIN_X := 24
const FLOOR_GROUND_MARGIN_Z := 24

const TICK_HZ := 30.0
const VOX_DIR := "res://voxels/"

## Which voxel model represents each item on a belt. Presentation-only
## mapping: the item ids themselves come from data/recipes.ron, and an item
## with no entry here still renders (as a shipping box) rather than vanishing.
const ITEM_MODELS := {
	"tomato": "item_tomato",
	"tomato_sauce": "item_sauce_pail",
	"ketchup": "item_ketchup_pail",
	"bottled_ketchup": "item_bottle",
	"boxed_ketchup": "item_box",
}
const ITEM_MODEL_FALLBACK := "item_box"

var sim: SimBridge

var _tick_accum := 0.0
var _stage_order: Array[String] = [] # recipe ids, in chain order
var _last_machines: Dictionary = {} # recipe id -> last machine snapshot dict
var _machine_lamps: Dictionary = {} # recipe id -> MeshInstance3D (emissive mesh)
var _machine_running: Dictionary = {} # recipe id -> bool, to avoid redundant swaps
var _item_nodes: Dictionary = {} # pooled item nodes, keyed per belt slot
var _chain_tile_width := 5

var _class_materials: Dictionary = {} # "matte"/"metal"/"emissive" -> StandardMaterial3D
var _lamp_idle: StandardMaterial3D
var _lamp_running: StandardMaterial3D
var _asset_classes: Dictionary = {} # asset name -> Array of class names

var _machine_label: Label
var _economy_label: Label
var _help_label: Label

enum ViewMode { ISOMETRIC, FIRST_PERSON }
var _view_mode: int = ViewMode.ISOMETRIC

var _camera: Camera3D

# --- Isometric mode state ---
var _camera_focus := Vector3.ZERO # world point the camera looks at; pan moves this
var _camera_base_size := 1.0 # the auto-framed size at zoom level 1.0
var _camera_size := 1.0 # current orthographic size (smaller = more zoomed in)
var _pan_right := Vector3.RIGHT # ground-plane "screen right", derived from the fixed camera angle
var _pan_forward := Vector3.FORWARD # ground-plane "screen up" (into the view), same derivation
var _iso_dragging := false # true while the right mouse button is held

# --- First-person mode state ---
var _fp_position := Vector3.ZERO
var _fp_yaw := 0.0 # radians; see _fp_heading_basis()
var _fp_pitch := 0.0 # radians, clamped to +/-FP_PITCH_LIMIT


func _ready() -> void:
	sim = SimBridge.new()
	_load_voxel_materials()
	_read_chain_layout()
	_build_environment()
	_build_floor()
	_build_chain()
	_build_camera()
	_build_ui()
	_seed_machine_state()
	_apply_dirty_chunks() # render tick 0's (empty) state immediately


# --------------------------------------------------------------------------
# Assets
# --------------------------------------------------------------------------

## Rebuilds one `StandardMaterial3D` per material class from
## `voxels/materials.json`, which `voxgen` exports straight out of
## `assets/voxels/palette.ron`. The numbers deliberately are NOT written down
## here: palette.ron stays the single source of truth for colour and material
## (UI_UX.md §2a point 5), and GDScript just consumes it.
func _load_voxel_materials() -> void:
	var defaults := {
		"matte": {"metallic": 0.0, "roughness": 0.95, "emission_energy": 0.0},
		"metal": {"metallic": 0.9, "roughness": 0.18, "emission_energy": 0.0},
		"emissive": {"metallic": 0.0, "roughness": 0.55, "emission_energy": 2.6},
	}
	var table: Dictionary = defaults
	var parsed = _read_json(VOX_DIR + "materials.json")
	if parsed is Dictionary:
		table = parsed
	else:
		push_warning("voxels/materials.json missing — falling back to built-in material values")

	for class_name_ in table.keys():
		var def: Dictionary = table[class_name_]
		_class_materials[class_name_] = _make_material(
			float(def.get("metallic", 0.0)),
			float(def.get("roughness", 1.0)),
			float(def.get("emission_energy", 0.0))
		)

	# Two variants of the emissive material so a machine's status lamps can
	# actually report state (UI_UX.md §4/§7: saturated colour reserved for
	# meaning, never decoration). Same mesh, swapped override material.
	var lamp_energy: float = float(table.get("emissive", defaults["emissive"]).get("emission_energy", 2.6))
	_lamp_idle = _make_material(0.0, 0.6, lamp_energy * 0.25)
	_lamp_running = _make_material(0.0, 0.45, lamp_energy)

	var index = _read_json(VOX_DIR + "index.json")
	if index is Dictionary:
		_asset_classes = index


func _make_material(metallic: float, roughness: float, emission_energy: float) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	# Voxel meshes carry their colour per vertex, straight from the .vox
	# palette — there are no textures anywhere in this pipeline.
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.metallic = metallic
	mat.roughness = roughness
	if emission_energy > 0.0:
		mat.emission_enabled = true
		mat.emission = Color(1, 1, 1)
		# MULTIPLY, not ADD: the emissive mesh holds several differently
		# coloured lamps, and a flat additive emission would wash them all to
		# the same white. Multiplying by albedo keeps green reading as green.
		mat.emission_operator = BaseMaterial3D.EMISSION_OP_MULTIPLY
		mat.emission_energy_multiplier = emission_energy
	return mat


func _read_json(path: String):
	if not FileAccess.file_exists(path):
		return null
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		return null
	return JSON.parse_string(text)


## Builds one asset as a `Node3D` holding a `MeshInstance3D` per material
## class it uses. Returns an empty node (with a warning) rather than failing
## if the models haven't been staged — `cargo xtask` is what puts them in
## res://voxels/, and a missing asset should not take down the whole scene.
func _asset_node(asset: String) -> Node3D:
	var root := Node3D.new()
	root.name = asset

	var classes: Array = _asset_classes.get(asset, ["matte", "metal", "emissive"])
	var built := 0
	for class_name_ in classes:
		var path := "%s%s.%s.vox" % [VOX_DIR, asset, class_name_]
		if not ResourceLoader.exists(path):
			continue
		var mesh := load(path) as Mesh
		if mesh == null:
			continue
		var mi := MeshInstance3D.new()
		mi.name = String(class_name_)
		mi.mesh = mesh
		mi.set_surface_override_material(0, _class_materials.get(class_name_, null))
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		root.add_child(mi)
		built += 1

	if built == 0:
		push_warning("no voxel meshes for '%s' under %s — run `cargo xtask`" % [asset, VOX_DIR])
	return root


func _mesh_for(asset: String) -> Mesh:
	var path := VOX_DIR + asset + ".vox"
	if not ResourceLoader.exists(path):
		return null
	return load(path) as Mesh


# --------------------------------------------------------------------------
# World
# --------------------------------------------------------------------------

## Tile (x, y) in simulation space -> the centre of that tile in world space.
## The sim's chain runs along +X at y = 0; the importer centres each model on
## its own footprint, so a tile centre is exactly where an asset node goes.
func _tile_origin(tx: int, ty: int, height: float) -> Vector3:
	return Vector3(float(tx) * TILE, height, float(ty) * TILE)


func _read_chain_layout() -> void:
	var layout: Array = JSON.parse_string(sim.chain_layout_json())
	for stage in layout:
		_stage_order.append(stage["recipe"])
	if layout.size() > 0:
		var last_machine_tile: Array = layout[layout.size() - 1]["machine_tile"]
		_chain_tile_width = int(last_machine_tile[0]) + 1


## The poured-concrete factory floor. Drawn as one `MultiMeshInstance3D`
## rather than one node per tile: the floor is the only asset whose instance
## count scales with the size of the world, so it is the one worth batching.
## The tile's darker perimeter is what keeps the grid legible (UI_UX.md §1).
func _build_floor() -> void:
	var mesh := _mesh_for("floor_tile")
	if mesh == null:
		push_warning("floor_tile mesh missing — skipping floor")
		return

	var x_from := -FLOOR_GROUND_MARGIN_X
	var x_to := _chain_tile_width - 1 + FLOOR_GROUND_MARGIN_X
	var z_from := -FLOOR_GROUND_MARGIN_Z
	var z_to := FLOOR_GROUND_MARGIN_Z

	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.mesh = mesh
	multimesh.instance_count = (x_to - x_from + 1) * (z_to - z_from + 1)

	var i := 0
	for tz in range(z_from, z_to + 1):
		for tx in range(x_from, x_to + 1):
			multimesh.set_instance_transform(i, Transform3D(Basis(), _tile_origin(tx, tz, 0.0)))
			i += 1

	var node := MultiMeshInstance3D.new()
	node.name = "Floor"
	node.multimesh = multimesh
	node.material_override = _class_materials.get("matte", null)
	# The floor takes shadows from the machinery but casts none of its own.
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(node)


## One belt run + one machine per stage, placed exactly where the simulation
## says they are. Re-read from `chain_layout_json` every time rather than
## cached in the scene, so appending a recipe to data/recipes.ron still
## changes the rendered factory with no Godot-side edit.
func _build_chain() -> void:
	var layout: Array = JSON.parse_string(sim.chain_layout_json())
	var stages := Node3D.new()
	stages.name = "Chain"
	add_child(stages)

	for stage in layout:
		var recipe: String = stage["recipe"]
		var start: Array = stage["belt_start_tile"]
		var length: int = int(stage["belt_length_tiles"])
		for i in range(length):
			var belt := _asset_node("belt")
			belt.name = "belt_%s_%d" % [recipe, i]
			belt.position = _tile_origin(int(start[0]) + i, int(start[1]), FLOOR_Y)
			stages.add_child(belt)

		var machine_tile: Array = stage["machine_tile"]
		var machine := _asset_node("machine")
		machine.name = "machine_%s" % recipe
		machine.position = _tile_origin(int(machine_tile[0]), int(machine_tile[1]), FLOOR_Y)
		stages.add_child(machine)

		var lamp := machine.get_node_or_null("emissive")
		if lamp != null:
			_machine_lamps[recipe] = lamp
			_machine_running[recipe] = true # force the first update to apply
			_set_machine_running(recipe, false)


## Fills the readout before the first item ever moves.
##
## `dirty_chunk_ids` only reports chunks something *changed* in, so an idle
## factory produces no snapshots at all and the HUD would sit blank until the
## player pressed a key. This asks the simulation directly, via SimBridge's
## existing `query_tile_json`, rather than inventing a default state Godot
## has no business knowing.
func _seed_machine_state() -> void:
	var layout: Array = JSON.parse_string(sim.chain_layout_json())
	for stage in layout:
		var tile: Array = stage["machine_tile"]
		var parsed = JSON.parse_string(sim.query_tile_json(int(tile[0]), int(tile[1])))
		if parsed == null or parsed.get("kind") != "machine":
			continue
		_last_machines[parsed["recipe"]] = {
			"recipe": parsed["recipe"],
			"process": parsed.get("process"),
			# query_tile deliberately doesn't report buffer contents; the
			# first chunk snapshot fills these in.
			"input": [],
			"output": [],
		}
	_update_machine_label()


func _set_machine_running(recipe: String, running: bool) -> void:
	if _machine_running.get(recipe, null) == running:
		return
	_machine_running[recipe] = running
	var lamp: MeshInstance3D = _machine_lamps.get(recipe, null)
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if running else _lamp_idle)


# --------------------------------------------------------------------------
# Camera & lighting
# --------------------------------------------------------------------------

## UI_UX.md §1: a FIXED orthographic isometric camera. No orbit, no free
## rotation — the voxel assets are modelled to read from fixed angles, and a
## free camera would expose silhouettes nothing was art-directed for. Pan
## (WASD/arrows) and zoom (scroll wheel) are explicitly allowed by that same
## section and don't touch the angle: pan moves `_camera_focus`, zoom moves
## `_camera_size`, orientation is always recomputed the same way.
##
## The angle used is true isometric (an equal-parts (1, 1, 1) view direction,
## ~35.26 degrees of elevation), not a 2:1 dimetric. UI_UX.md §9 explicitly
## leaves the final choice open pending a side-by-side prototype; this picks
## the one that keeps voxel cubes perfectly regular on screen, and changing
## it later is one constant here, not an asset change.
const CAMERA_DIRECTION := Vector3(1, 1, 1)
## Orthographic, so this only sets the near/far window, not apparent size.
const CAMERA_DISTANCE := 160.0

# --- Navigation (zoom + pan) -----------------------------------------------
# UI_UX.md §1 explicitly allows smooth zoom and only forbids free rotation —
# the fixed isometric angle itself never changes here, only `size` (zoom) and
# `_camera_focus` (pan) do.
const ZOOM_STEP := 0.1 # fraction of current size per scroll notch, mouse wheel or +/-
const ZOOM_MIN_FACTOR := 0.3 # most zoomed in, relative to the auto-framed size
const ZOOM_MAX_FACTOR := 3.0 # most zoomed out
const PAN_SPEED := 0.9 # fraction of the visible size crossed per second at held-key pan
# InputEventPanGesture.delta is in gesture-magnitude units, not wheel notches,
# and arrives many times per swipe — this converts one unit of that delta
# into a fraction of ZOOM_STEP's effect, tuned so a normal swipe feels
# similar in speed to a few wheel notches, not a single giant jump.
const TRACKPAD_ZOOM_SENSITIVITY := 0.01
const ISO_NEAR := 0.5

# --- First-person mode -----------------------------------------------------
# Not a UI_UX.md concept — a free-look "fly" camera for looking around the
# factory up close. No gravity, no collision: this project has no player
# entity or collision shapes on the voxel meshes, so it deliberately doesn't
# pretend to be one.
const FP_MOVE_SPEED := 6.0 # world units/second (~2 tiles/second)
const FP_MOUSE_SENSITIVITY := 0.0025 # radians per pixel of relative mouse motion
const FP_PITCH_LIMIT := deg_to_rad(89.0) # stop just short of looking straight up/down
const FP_FOV := 75.0
const FP_NEAR := 0.05 # much closer than ISO_NEAR — this mode gets right up next to machines

const ISO_HELP_TEXT := "SPACE: feed a tomato    C: collect product    WASD/drag/arrows: pan    scroll/+-: zoom    TAB: first-person"
const FP_HELP_TEXT := "C: collect product    WASD: move    mouse: look    SPACE/SHIFT: up/down    TAB: isometric"


func _build_camera() -> void:
	_camera_focus = Vector3(
		float(_chain_tile_width - 1) * TILE * 0.5,
		TILE * 0.35,
		0.0
	)

	var camera := Camera3D.new()
	camera.name = "IsometricCamera"
	camera.projection = Camera3D.PROJECTION_ORTHOGONAL
	# KEEP_WIDTH so `size` means the horizontal extent: the factory is a long
	# horizontal line, and it must stay framed regardless of window aspect.
	camera.keep_aspect = Camera3D.KEEP_WIDTH
	camera.near = ISO_NEAR
	camera.far = 600.0
	add_child(camera)
	_camera = camera

	# Position/orient first (size doesn't affect orientation) so the camera's
	# own basis exists to read the ground-plane screen axes from — right is
	# already horizontal (up hint is world Y and the view direction isn't
	# vertical); "screen forward" is the view direction (-basis.z) projected
	# onto the ground. WASD/arrows pan along these, not raw world X/Z, so
	# panning still feels like up/down/left/right on screen regardless of the
	# fixed isometric angle.
	_camera_size = 1.0
	_update_camera_transform()
	_pan_right = _camera.transform.basis.x
	var forward := -_camera.transform.basis.z
	_pan_forward = Vector3(forward.x, 0.0, forward.z).normalized()

	_camera_base_size = _framing_size(_camera.transform.basis)
	_camera_size = _camera_base_size
	_update_camera_transform()
	camera.call_deferred("make_current")


## Repositions/reorients the camera from `_camera_focus`/`_camera_size` —
## called once at build time and again whenever pan or zoom changes. Cheap
## enough to call every time rather than tracking a dirty flag.
func _update_camera_transform() -> void:
	if _camera == null:
		return
	# `look_at_from_position` rather than position-then-`look_at`: the latter
	# requires the node to already be inside the tree, which isn't guaranteed
	# for a scene instantiated and driven manually (as the headless tests do).
	_camera.look_at_from_position(
		_camera_focus + CAMERA_DIRECTION.normalized() * CAMERA_DISTANCE,
		_camera_focus,
		Vector3.UP
	)
	_camera.size = _camera_size


func _zoom_camera(factor: float) -> void:
	var min_size := _camera_base_size * ZOOM_MIN_FACTOR
	var max_size := _camera_base_size * ZOOM_MAX_FACTOR
	_camera_size = clampf(_camera_size * factor, min_size, max_size)
	_update_camera_transform()


func _pan_camera(delta: float) -> void:
	_apply_pan(_pan_input_direction(), delta)


## Reads held keys only — no movement math, so this is the one part of
## panning that can't be exercised without a live Input singleton.
func _pan_input_direction() -> Vector3:
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += _pan_forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= _pan_forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += _pan_right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= _pan_right
	return move


## The actual movement, deliberately Input-free so it's directly testable
## (test_camera_nav.gd calls this with an explicit direction).
func _apply_pan(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	# Scaled by current `_camera_size`, not a flat world-unit speed, so pan
	# covers the same fraction of the visible view per second whether zoomed
	# in or out — a flat speed would feel sluggish when zoomed out and
	# twitchy when zoomed in.
	_camera_focus += direction.normalized() * PAN_SPEED * _camera_size * delta
	_update_camera_transform()


## World units per screen pixel at the current zoom — the conversion factor
## that makes click-and-drag panning track the cursor 1:1 (the point under
## the cursor when the drag started stays under it), rather than an arbitrary
## fixed speed that would feel wrong at every zoom level except one.
func _iso_drag_sensitivity() -> float:
	var width := 0.0
	var vp := get_viewport()
	if vp != null:
		width = vp.get_visible_rect().size.x
	if width <= 0.0:
		# A script-mode SceneTree (this project's own headless tests included)
		# never sizes a real window, so `get_viewport()` reports a zero-size
		# rect — fall back to the project's configured window width so drag
		# panning still does something reasonable instead of silently no-op'ing.
		width = float(ProjectSettings.get_setting("display/window/size/viewport_width", 1280))
	if width <= 0.0:
		return 0.0
	return _camera_size / width


## Right-mouse-drag panning (UI_UX.md §1 allows pan; this is just a second
## way to do it alongside WASD). Right button, not left, so a future
## click-to-build/select interaction on the left button has nothing to fight
## with.
func _apply_drag_pan(relative: Vector2) -> void:
	var sensitivity := _iso_drag_sensitivity()
	if sensitivity <= 0.0:
		return
	# "Grab the world and drag it": the point under the cursor follows the
	# cursor, which means the focus point moves opposite the drag on the
	# right axis and along the forward axis on the (screen-down-is-positive) Y.
	_camera_focus += (-_pan_right * relative.x + _pan_forward * relative.y) * sensitivity
	_update_camera_transform()


# --------------------------------------------------------------------------
# First-person mode
# --------------------------------------------------------------------------

## Rotation around world Y only, no pitch — used both to build the full
## look basis (below) and, on its own, as the horizontal movement basis so
## WASD moves along the ground regardless of where you're looking up/down,
## the same way Minecraft's own flight controls work.
func _fp_heading_basis() -> Basis:
	return Basis(Vector3.UP, _fp_yaw)


## Heading, then tilted by pitch around the resulting local right axis —
## composed in this order specifically so pitch never affects heading.
func _fp_look_basis() -> Basis:
	return _fp_heading_basis() * Basis(Vector3.RIGHT, _fp_pitch)


func _update_fp_camera_transform() -> void:
	if _camera == null:
		return
	_camera.transform = Transform3D(_fp_look_basis(), _fp_position)


## Mouse-look, deliberately Input-free (see _apply_pan's equivalent note) so
## test_camera_nav.gd can call it directly with a synthetic delta.
func _apply_look(relative: Vector2) -> void:
	_fp_yaw -= relative.x * FP_MOUSE_SENSITIVITY
	_fp_pitch = clampf(_fp_pitch - relative.y * FP_MOUSE_SENSITIVITY, -FP_PITCH_LIMIT, FP_PITCH_LIMIT)
	_update_fp_camera_transform()


## Reads held keys only, same split as _pan_input_direction for the same
## reason (untestable headlessly without a live Input singleton). SPACE/SHIFT
## for up/down, Minecraft-style — SPACE only spawns a tomato in ISOMETRIC mode
## (_unhandled_input gates that), so there's no conflict with flying up here.
func _fp_input_direction() -> Vector3:
	var heading := _fp_heading_basis()
	var forward := -heading.z
	var right := heading.x
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= right
	if Input.is_key_pressed(KEY_SPACE):
		move += Vector3.UP
	if Input.is_key_pressed(KEY_SHIFT):
		move -= Vector3.UP
	return move


## The actual movement, Input-free and directly testable — mirrors _apply_pan.
func _apply_fp_move(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	_fp_position += direction.normalized() * FP_MOVE_SPEED * delta
	_update_fp_camera_transform()


func _fp_camera_move(delta: float) -> void:
	_apply_fp_move(_fp_input_direction(), delta)


## TAB toggles between ISOMETRIC and FIRST_PERSON. Both share the one
## Camera3D node — this reconfigures it (projection, near plane, aspect
## policy) rather than creating a second one.
func _set_view_mode(mode: int) -> void:
	if mode == _view_mode:
		return
	_view_mode = mode

	if mode == ViewMode.FIRST_PERSON:
		_iso_dragging = false
		# Start hovering above wherever the isometric view was focused, so
		# the switch feels continuous instead of teleporting to the origin.
		_fp_position = _camera_focus + Vector3(0.0, TILE * 1.5, 0.0)
		# Best-effort continuity, not an exact guarantee: face roughly the
		# same way the isometric camera was looking. Mouse-look overrides it
		# immediately, so an imperfect starting angle here doesn't matter.
		_fp_yaw = atan2(-_pan_forward.x, -_pan_forward.z)
		_fp_pitch = deg_to_rad(-15.0)
		_camera.projection = Camera3D.PROJECTION_PERSPECTIVE
		_camera.fov = FP_FOV
		_camera.near = FP_NEAR
		_camera.keep_aspect = Camera3D.KEEP_HEIGHT
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		_update_fp_camera_transform()
		if _help_label != null:
			_help_label.text = FP_HELP_TEXT
	else:
		# Keep the isometric view's height (its focus point's Y never moved
		# on its own), just recentre X/Z on wherever first-person ended up.
		_camera_focus = Vector3(_fp_position.x, _camera_focus.y, _fp_position.z)
		_camera.projection = Camera3D.PROJECTION_ORTHOGONAL
		_camera.near = ISO_NEAR
		_camera.keep_aspect = Camera3D.KEEP_WIDTH
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		_update_camera_transform()
		if _help_label != null:
			_help_label.text = ISO_HELP_TEXT
	_update_camera_transform()


## Fits the orthographic frustum to the factory floor's bounding box by
## projecting its eight corners onto the camera's own right/up axes.
##
## Worth doing properly rather than eyeballing a constant: the chain's length
## is whatever data/recipes.ron currently defines, so the framing has to be
## derived, and an isometric view rotates the world box 45 degrees relative to
## the screen — a naive "width = chain length" estimate is wrong in both
## directions at once.
func _framing_size(basis: Basis) -> float:
	var x_from := float(-FLOOR_MARGIN_X) - 0.5
	var x_to := float(_chain_tile_width - 1 + FLOOR_MARGIN_X) + 0.5
	var z_from := float(-FLOOR_MARGIN_Z) - 0.5
	var z_to := float(FLOOR_MARGIN_Z) + 0.5

	var min_right := INF
	var max_right := -INF
	var min_up := INF
	var max_up := -INF
	for cx in [x_from, x_to]:
		for cz in [z_from, z_to]:
			# 0 .. one tile tall covers the floor slab through the machines'
			# vessels; the exhaust stacks poking above are not worth zooming
			# the whole factory out for.
			for cy in [0.0, TILE]:
				var corner := Vector3(cx * TILE, cy, cz * TILE)
				min_right = min(min_right, basis.x.dot(corner))
				max_right = max(max_right, basis.x.dot(corner))
				min_up = min(min_up, basis.y.dot(corner))
				max_up = max(max_up, basis.y.dot(corner))

	var aspect := 16.0 / 9.0
	var viewport := get_viewport()
	if viewport != null:
		var rect := viewport.get_visible_rect().size
		if rect.x > 0.0 and rect.y > 0.0:
			aspect = rect.x / rect.y

	var needed_width := max_right - min_right
	var needed_height := max_up - min_up
	return max(needed_width, needed_height * aspect) * 1.06


## UI_UX.md §4: real-time dynamic lighting with soft shadows, light ambient
## occlusion in voxel crevices, and mild bloom on emissives — the
## "modded Minecraft with a shader pack" reference point, not photorealism.
## All of it is stock Forward+ environment configuration; no custom shaders.
##
## The sky IS the visible backdrop (BG_SKY), not just a light source — a
## flat near-black BG_COLOR was tried first specifically to avoid a hard
## horizon line/sun streak behind the tightly-framed isometric view, but it
## reads as an empty void the moment first-person mode lets you look around
## freely, which fights UI_UX.md §3's "a real factory you could walk into,"
## not a factory floating in nothing. A soft, bright, sun-disk-free sky (see
## sun_angle_max below) keeps the "no distracting streak" property that
## motivated the original choice, while actually looking like somewhere.
func _build_environment() -> void:
	var sky_material := ProceduralSkyMaterial.new()
	# A brighter, friendlier daytime sky than the original — still a
	# believable overcast-ish industrial-zone sky (UI_UX.md §3's "grounded,
	# not cartoonish"), just not dim enough to read as night or a void.
	sky_material.sky_top_color = Color(0.42, 0.55, 0.72)
	sky_material.sky_horizon_color = Color(0.78, 0.81, 0.83)
	sky_material.ground_horizon_color = Color(0.42, 0.40, 0.37)
	sky_material.ground_bottom_color = Color(0.24, 0.23, 0.21)
	# Still no sun disk: the default draws a wide soft halo that the glow pass
	# smears into a distracting beam. Brightness now comes from the sky
	# colours and the key light below, not a visible sun.
	sky_material.sun_angle_max = 0.0
	var sky := Sky.new()
	sky.sky_material = sky_material

	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	# Sky-derived ambient is what fills the shadowed sides of a voxel model;
	# without it, unlit faces read as flat black and the medium looks cheap.
	# Raised from the original 0.55 alongside the brighter sky above.
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.8

	env.ssao_enabled = true
	env.ssao_radius = 0.9
	env.ssao_intensity = 2.4
	env.ssao_power = 1.6

	env.glow_enabled = true
	env.glow_intensity = 0.7
	env.glow_bloom = 0.15
	env.glow_hdr_threshold = 0.85
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT

	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_white = 6.0
	# Raised from 0.92 to match the brighter sky/ambient — ACES still rolls
	# off highlights safely, so this doesn't blow out the metal specular.
	env.tonemap_exposure = 1.05
	# Deliberately no depth fog: it was tried, and at this camera distance it
	# flattened the whole factory into one haze-grey value and cost more
	# contrast than the atmosphere was worth.

	var world_env := WorldEnvironment.new()
	world_env.name = "Environment"
	world_env.environment = env
	add_child(world_env)

	# Key light: warm, shadow-casting, angled so machinery casts shadows
	# across the belt line rather than straight down it.
	var sun := DirectionalLight3D.new()
	sun.name = "KeyLight"
	sun.rotation_degrees = Vector3(-52.0, -130.0, 0.0)
	sun.light_color = Color(1.0, 0.95, 0.88)
	sun.light_energy = 1.6
	sun.shadow_enabled = true
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	sun.directional_shadow_max_distance = 160.0
	sun.shadow_blur = 1.4
	# A non-zero angular size is what actually softens the shadow edge with
	# distance, rather than just blurring the whole map uniformly.
	sun.light_angular_distance = 0.6
	add_child(sun)

	# Cool fill from the opposite side, no shadows — keeps the shadowed faces
	# of stainless steel from going dead grey.
	var fill := DirectionalLight3D.new()
	fill.name = "FillLight"
	fill.rotation_degrees = Vector3(-28.0, 55.0, 0.0)
	fill.light_color = Color(0.72, 0.80, 1.0)
	fill.light_energy = 0.4
	fill.shadow_enabled = false
	add_child(fill)


# --------------------------------------------------------------------------
# HUD
# --------------------------------------------------------------------------

func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.name = "HUD"
	add_child(hud)

	# A dark plate with a single hazard-yellow rule along the top. UI_UX.md
	# §5's real UI pass (clipboard/checklist widgets, voxel-rendered icon
	# slots) is its own piece of work; this is the minimum that keeps text
	# legible over a lit 3D scene, rather than pretending to be that pass.
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.74)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.border_width_top = 3
	style.set_content_margin_all(12.0)

	var panel := PanelContainer.new()
	panel.add_theme_stylebox_override("panel", style)
	panel.position = Vector2(16, 16)
	hud.add_child(panel)

	# A container, not hand-placed labels: the readout has one line per stage
	# in data/recipes.ron, so its height is not something to hardcode.
	var rows := VBoxContainer.new()
	rows.add_theme_constant_override("separation", 4)
	panel.add_child(rows)

	var settings := LabelSettings.new()
	settings.font_size = 15
	settings.font_color = Color(0.92, 0.93, 0.94)
	settings.outline_size = 4
	settings.outline_color = Color(0, 0, 0, 0.85)

	_machine_label = Label.new()
	_machine_label.label_settings = settings
	rows.add_child(_machine_label)

	# Milestone 5 (Economy MVP, ARCHITECTURE.md §9 item 5): a minimal money +
	# contract-status readout, folded into the same readout panel as every
	# other row rather than a separately hand-positioned Label. Deliberately
	# plain text, not UI_UX.md §5's clipboard/checklist diegetic styling —
	# that's later visual polish, this just needs to prove money/contract
	# state is visible end to end.
	_economy_label = Label.new()
	_economy_label.label_settings = settings
	rows.add_child(_economy_label)

	_help_label = Label.new()
	_help_label.label_settings = settings
	_help_label.text = ISO_HELP_TEXT
	rows.add_child(_help_label)


# --------------------------------------------------------------------------
# Simulation driving / rendering
# --------------------------------------------------------------------------

func _process(delta: float) -> void:
	_tick_accum += delta
	var tick_interval := 1.0 / TICK_HZ
	while _tick_accum >= tick_interval:
		_tick_accum -= tick_interval
		sim.tick()
		_apply_dirty_chunks()

	_update_machine_label()
	_update_economy_label()
	if _view_mode == ViewMode.ISOMETRIC:
		_pan_camera(delta)
	else:
		_fp_camera_move(delta)


func _unhandled_input(event: InputEvent) -> void:
	# TAB always toggles view mode, in either mode.
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_TAB:
		_set_view_mode(ViewMode.FIRST_PERSON if _view_mode == ViewMode.ISOMETRIC else ViewMode.ISOMETRIC)
		return

	if event is InputEventMouseButton:
		# Right-drag panning (isometric only) — right button, not left, so a
		# future click-to-build/select on the left button has nothing to
		# fight with.
		if event.button_index == MOUSE_BUTTON_RIGHT and _view_mode == ViewMode.ISOMETRIC:
			_iso_dragging = event.pressed
			return
		if event.pressed and _view_mode == ViewMode.ISOMETRIC:
			if event.button_index == MOUSE_BUTTON_WHEEL_UP:
				_zoom_camera(1.0 - ZOOM_STEP)
			elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				_zoom_camera(1.0 + ZOOM_STEP)
		return

	# A real mouse's wheel arrives as InputEventMouseButton (above). A macOS
	# trackpad's two-finger scroll does NOT — it arrives as a continuous
	# InputEventPanGesture instead, which is why scroll-to-zoom didn't work
	# on trackpads until this was added. Scale by the gesture's own delta
	# magnitude (it's continuous, not discrete notches like a wheel click),
	# not a fixed step, so a fast swipe zooms faster than a slow one.
	if event is InputEventPanGesture:
		if _view_mode == ViewMode.ISOMETRIC and event.delta.y != 0.0:
			_zoom_camera(1.0 + event.delta.y * TRACKPAD_ZOOM_SENSITIVITY)
		return

	if event is InputEventMouseMotion:
		if _view_mode == ViewMode.ISOMETRIC:
			if _iso_dragging:
				_apply_drag_pan(event.relative)
		else:
			_apply_look(event.relative)
		return

	if not (event is InputEventKey and event.pressed and not event.echo):
		return

	if _view_mode == ViewMode.ISOMETRIC:
		if event.keycode == KEY_EQUAL or event.keycode == KEY_KP_ADD:
			_zoom_camera(1.0 - ZOOM_STEP)
			return
		if event.keycode == KEY_MINUS or event.keycode == KEY_KP_SUBTRACT:
			_zoom_camera(1.0 + ZOOM_STEP)
			return

	var command := ""
	# SPACE only spawns in ISOMETRIC mode — in FIRST_PERSON it's "fly up"
	# (_fp_input_direction), and a single keypress can't mean both.
	if event.keycode == KEY_SPACE and _view_mode == ViewMode.ISOMETRIC:
		command = JSON.stringify({"type": "spawn_item", "item": "tomato"})
	elif event.keycode == KEY_C:
		command = JSON.stringify({"type": "collect_output"})
	else:
		return

	sim.issue_command_json(command)
	# Render immediately rather than waiting for the next scheduled tick —
	# issue_command's dirty marking isn't cleared until tick() runs next,
	# so this is safe to read right away.
	_apply_dirty_chunks()


func _apply_dirty_chunks() -> void:
	var dirty: PackedInt64Array = sim.dirty_chunk_ids()
	for chunk_id in dirty:
		var parsed = JSON.parse_string(sim.chunk_snapshot_json(chunk_id))
		if parsed != null:
			_render_snapshot(parsed)


func _render_snapshot(snapshot: Dictionary) -> void:
	var seen := {}

	var belts: Array = snapshot.get("belts", [])
	for belt in belts:
		var start: Array = belt["start_tile"]
		var items: Array = belt["items"]
		for i in range(items.size()):
			var pair: Array = items[i]
			# Keyed by belt start tile so multiple stages' belts never
			# collide with each other's item nodes.
			var key := "belt_%d_%d_%d" % [int(start[0]), int(start[1]), i]
			seen[key] = true
			var node := _item_node_for(key, String(pair[0]))
			node.visible = true
			# `pair[1]` is the item's distance from the belt start in tiles;
			# the belt runs along +X, so it slides straight along that axis.
			node.position = Vector3(
				(float(start[0]) + float(pair[1])) * TILE,
				BELT_SURFACE_Y,
				float(start[1]) * TILE
			)

	for key in _item_nodes.keys():
		if not seen.has(key):
			_item_nodes[key]["node"].visible = false

	var machines: Array = snapshot.get("machines", [])
	for machine in machines:
		_last_machines[machine["recipe"]] = machine
		_set_machine_running(String(machine["recipe"]), machine.get("process") != null)


## Pooled per belt slot. If the slot's item type changes (it doesn't in the
## current straight chain, but nothing guarantees that) the old node is
## replaced rather than silently rendering the wrong product.
func _item_node_for(key: String, item_name: String) -> Node3D:
	var asset: String = ITEM_MODELS.get(item_name, ITEM_MODEL_FALLBACK)
	if _item_nodes.has(key):
		var existing: Dictionary = _item_nodes[key]
		if existing["asset"] == asset:
			return existing["node"]
		existing["node"].queue_free()
		_item_nodes.erase(key)

	var node := _asset_node(asset)
	node.name = "item_" + key
	add_child(node)
	_item_nodes[key] = {"node": node, "asset": asset}
	return node


func _update_machine_label() -> void:
	var lines: Array[String] = []
	for recipe_id in _stage_order:
		if not _last_machines.has(recipe_id):
			continue
		var machine: Dictionary = _last_machines[recipe_id]
		var process = machine.get("process")
		var progress_text := "idle"
		if process != null:
			var elapsed: int = sim.current_tick() - int(process[0])
			var required: int = int(process[1])
			var pct: float = clamp(float(elapsed) / float(required), 0.0, 1.0) * 100.0
			progress_text = "%.0f%%" % pct
		lines.append("%s — %s | in: %s | out: %s" % [
			recipe_id,
			progress_text,
			_format_counts(machine["input"]),
			_format_counts(machine["output"]),
		])

	_machine_label.text = "\n".join(lines)


func _update_economy_label() -> void:
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	var money: float = float(econ["money"])
	var mix: Array = econ["contract_mix"]
	var progress: Array = econ["contract_progress"]
	var mix_parts: Array[String] = []
	for i in range(mix.size()):
		var required_pair: Array = mix[i]
		var have: int = int(progress[i][1])
		mix_parts.append("%s %d/%d" % [required_pair[0], have, int(required_pair[1])])

	var ticks_left: int = max(0, int(econ["next_delivery_tick"]) - sim.current_tick())
	_economy_label.text = "Money: %.0f    Contract: %s (next check in %d ticks)" % [
		money, ", ".join(mix_parts), ticks_left,
	]


func _format_counts(pairs: Array) -> String:
	if pairs.is_empty():
		return "-"
	var parts: Array[String] = []
	for pair in pairs:
		parts.append("%s x%d" % [pair[0], int(pair[1])])
	return ", ".join(parts)
