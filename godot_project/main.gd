# --------------------------------------------------------------------------
# Assets
# --------------------------------------------------------------------------

## Rebuilds one `StandardMaterial3D` per material class from
## `voxels/materials.json`, which `voxgen` exports straight out of
## `assets/voxels/palette.ron`. The numbers deliberately are NOT written down
## here: palette.ron stays the single source of truth for colour and material
## (UI_UX.md §2a point 5), and GDScript just consumes it.
func _load_voxel_materials() -> void:
	var defaults := {
		"matte": {"metallic": 0.0, "roughness": 0.95, "emission_energy": 0.0},
		"metal": {"metallic": 0.9, "roughness": 0.18, "emission_energy": 0.0},
		"emissive": {"metallic": 0.0, "roughness": 0.55, "emission_energy": 2.6},
		"liquid": {"metallic": 0.0, "roughness": 0.14, "emission_energy": 0.0},
	}
	var table: Dictionary = defaults
	var parsed = _read_json(VOX_DIR + "materials.json")
	if parsed is Dictionary:
		table = parsed
	else:
		push_warning("voxels/materials.json missing — falling back to built-in material values")

	for class_name_ in table.keys():
		var def: Dictionary = table[class_name_]
		_class_materials[class_name_] = _make_material(
			float(def.get("metallic", 0.0)),
			float(def.get("roughness", 1.0)),
			float(def.get("emission_energy", 0.0))
		)

	# Two variants of the emissive material so a machine's status lamps can
	# actually report state (UI_UX.md §4/§7: saturated colour reserved for
	# meaning, never decoration). Same mesh, swapped override material.
	var lamp_energy: float = float(table.get("emissive", defaults["emissive"]).get("emission_energy", 2.6))
	_lamp_idle = _make_material(0.0, 0.6, lamp_energy * 0.25)
	_lamp_running = _make_material(0.0, 0.45, lamp_energy)

	var index = _read_json(VOX_DIR + "index.json")
	if index is Dictionary:
		_asset_classes = index


func _make_material(metallic: float, roughness: float, emission_energy: float) -> StandardMaterial3D:
	var mat := StandardMaterial3D.new()
	# Voxel meshes carry their colour per vertex, straight from the .vox
	# palette — there are no textures anywhere in this pipeline.
	mat.vertex_color_use_as_albedo = true
	mat.vertex_color_is_srgb = true
	mat.metallic = metallic
	mat.roughness = roughness
	if emission_energy > 0.0:
		mat.emission_enabled = true
		mat.emission = Color(1, 1, 1)
		# MULTIPLY, not ADD: the emissive mesh holds several differently
		# coloured lamps, and a flat additive emission would wash them all to
		# the same white. Multiplying by albedo keeps green reading as green.
		mat.emission_operator = BaseMaterial3D.EMISSION_OP_MULTIPLY
		mat.emission_energy_multiplier = emission_energy
	return mat


func _read_json(path: String):
	if not FileAccess.file_exists(path):
		return null
	var text := FileAccess.get_file_as_string(path)
	if text.is_empty():
		return null
	return JSON.parse_string(text)


## Builds one asset as a `Node3D` holding a `MeshInstance3D` per material
## class it uses. Returns an empty node (with a warning) rather than failing
## if the models haven't been staged — `cargo xtask` is what puts them in
## res://voxels/, and a missing asset should not take down the whole scene.
func _asset_node(asset: String) -> Node3D:
	var root := Node3D.new()
	root.name = asset

	var classes: Array = _asset_classes.get(asset, ["matte", "metal", "emissive", "liquid"])
	var built := 0
	for class_name_ in classes:
		var path := "%s%s.%s.vox" % [VOX_DIR, asset, class_name_]
		if not ResourceLoader.exists(path):
			continue
		var mesh := load(path) as Mesh
		if mesh == null:
			continue
		var mi := MeshInstance3D.new()
		mi.name = String(class_name_)
		mi.mesh = mesh
		mi.set_surface_override_material(0, _class_materials.get(class_name_, null))
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		root.add_child(mi)
		built += 1

	if built == 0:
		push_warning("no voxel meshes for '%s' under %s — run `cargo xtask`" % [asset, VOX_DIR])
	return root


func _mesh_for(asset: String) -> Mesh:
	var path := VOX_DIR + asset + ".vox"
	if not ResourceLoader.exists(path):
		return null
	return load(path) as Mesh


# --------------------------------------------------------------------------
# World
# --------------------------------------------------------------------------

## Tile (x, y) in simulation space -> the centre of that tile in world space.
## The sim's chain runs along +X at y = 0; the importer centres each model on
## its own footprint, so a tile centre is exactly where an asset node goes.
func _tile_origin(tx: int, ty: int, height: float) -> Vector3:
	return Vector3(float(tx) * TILE, height, float(ty) * TILE)


## Where a node goes for a building that occupies a whole FOOTPRINT rather
## than a single tile (the "Machines improvement" milestone's ticket 1).
##
## `origin` is the footprint's minimum-X/minimum-Y corner — the tile the
## belt feeds into — and the building covers `size.x` x `size.y` tiles
## growing east/north from it (`sim::machines`'s module doc states that
## convention once; nothing here re-derives it). The voxel encoder puts a
## model's origin at its own footprint CENTRE at ground level, so the node
## belongs at the centre of that rectangle, which for a 1x1 building is
## exactly `_tile_origin` — i.e. this generalizes the old placement rather
## than replacing it, and every existing 1x1 kind stays on the tile it was
## on before.
func _footprint_centre(origin: Vector2i, size: Vector2i, height: float) -> Vector3:
	return Vector3(
		(float(origin.x) + float(size.x - 1) * 0.5) * TILE,
		height,
		(float(origin.y) + float(size.y - 1) * 0.5) * TILE
	)


## `{"width_tiles": w, "height_tiles": h}` (as every snapshot spells a
## footprint) -> Vector2i, defaulting to 1x1 so a snapshot from an older
## SimBridge without the field still renders.
func _footprint_size(footprint) -> Vector2i:
	if not (footprint is Dictionary):
		return Vector2i.ONE
	return Vector2i(
		maxi(1, int(footprint.get("width_tiles", 1))),
		maxi(1, int(footprint.get("height_tiles", 1)))
	)


func _read_chain_layout() -> void:
	var layout: Array = JSON.parse_string(sim.chain_layout_json())
	for stage in layout:
		var recipe: String = stage["recipe"]
		_stage_order.append(recipe)
		var machine_tile: Array = stage["machine_tile"]
		_machine_tiles[recipe] = Vector2i(int(machine_tile[0]), int(machine_tile[1]))
		_machine_footprints[recipe] = _footprint_size(stage.get("machine_footprint"))
	if layout.size() > 0:
		var last: Dictionary = layout[layout.size() - 1]
		var last_machine_tile: Array = last["machine_tile"]
		# Past the machine's far edge, not past its origin — a multi-tile
		# last stage would otherwise be half off the framed/floored area.
		_chain_tile_width = int(last_machine_tile[0]) + _footprint_size(last.get("machine_footprint")).x
	# ...and then past the delivery dock, which stands east of the last stage
	# on a belt of its own (the delivery-dock ticket). `chain_layout_json`
	# describes recipe-driven stages only, so the dock is invisible to the
	# loop above — without this the floor would stop short of it and the
	# camera would frame the chain with its own exit hanging off the edge.
	var dock := _read_dock_snapshot()
	if dock.has("tile"):
		var dock_tile: Array = dock["tile"]
		_chain_tile_width = maxi(
			_chain_tile_width,
			int(dock_tile[0]) + _footprint_size(dock.get("footprint")).x
		)


## The poured-concrete factory floor. Drawn as one `MultiMeshInstance3D`
## rather than one node per tile: the floor is the only asset whose instance
## count scales with the size of the world, so it is the one worth batching.
## The tile's darker perimeter is what keeps the grid legible (UI_UX.md §1).
func _build_floor() -> void:
	var mesh := _mesh_for("floor_tile")
	if mesh == null:
		push_warning("floor_tile mesh missing — skipping floor")
		return

	var x_from := -FLOOR_GROUND_MARGIN_X
	var x_to := _chain_tile_width - 1 + FLOOR_GROUND_MARGIN_X
	var z_from := -FLOOR_GROUND_MARGIN_Z
	var z_to := FLOOR_GROUND_MARGIN_Z

	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.mesh = mesh
	multimesh.instance_count = (x_to - x_from + 1) * (z_to - z_from + 1)

	var i := 0
	for tz in range(z_from, z_to + 1):
		for tx in range(x_from, x_to + 1):
			multimesh.set_instance_transform(i, Transform3D(Basis(), _tile_origin(tx, tz, 0.0)))
			i += 1

	var node := MultiMeshInstance3D.new()
	node.name = "Floor"
	node.multimesh = multimesh
	node.material_override = _class_materials.get("matte", null)
	# The floor takes shadows from the machinery but casts none of its own.
	node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(node)


## Every tile any machine footprint covers, plus the hopper's own tile, as a
## set keyed "x,y". This is what a belt tile asks "what is next to me?"
##
## The hopper belongs in here even though it is not a machine: it discharges
## onto the head of stage 0's belt exactly the way a machine discharges onto
## the next stage's, so that belt tile is an outlet tile by the same rule
## rather than by a special case. Its tile comes from `hopper_snapshot_json`,
## not from an assumption about where the chain starts.
func _machine_occupied_tiles(layout: Array) -> Dictionary:
	var occupied := {}
	for stage in layout:
		var pair: Array = stage["machine_tile"]
		var origin := Vector2i(int(pair[0]), int(pair[1]))
		var size := _footprint_size(stage.get("machine_footprint"))
		for dy in range(size.y):
			for dx in range(size.x):
				occupied["%d,%d" % [origin.x + dx, origin.y + dy]] = true
	var hopper := _read_hopper_snapshot()
	if hopper.has("tile"):
		var tile: Array = hopper["tile"]
		occupied["%d,%d" % [int(tile[0]), int(tile[1])]] = true
	# The delivery dock belongs here for the hopper's reason, mirrored: the
	# hopper discharges onto the head of the first belt, the dock swallows the
	# end of the last one, and both are junctions with a belt whether or not
	# the building is a `chain_layout_json` stage. Its tile comes from
	# `dock_snapshot_json`, not from an assumption about where the chain ends.
	var dock := _read_dock_snapshot()
	if dock.has("tile"):
		var dock_tile: Array = dock["tile"]
		var dock_origin := Vector2i(int(dock_tile[0]), int(dock_tile[1]))
		var dock_size := _footprint_size(dock.get("footprint"))
		for dy in range(dock_size.y):
			for dx in range(dock_size.x):
				occupied["%d,%d" % [dock_origin.x + dx, dock_origin.y + dy]] = true
	return occupied


## Which way a stage's belt travels, derived from the two tiles the layout
## already reports: it starts at `belt_start_tile` and ends against
## `machine_tile`, so the sign of the difference IS the direction. Deriving
## it rather than assuming +X is the point — nothing here would need editing
## if the simulation ever laid a stage out along another axis, it would just
## fall through to the plain belt model (see `_belt_asset_for`).
func _belt_direction(start_tile: Vector2i, machine_tile: Vector2i) -> Vector2i:
	return Vector2i(signi(machine_tile.x - start_tile.x), signi(machine_tile.y - start_tile.y))


## Which of the three belt models this tile draws with. See BELT_ASSET's doc
## for the rule and for why a non-+X direction deliberately gets the plain
## model.
func _belt_asset_for(tile: Vector2i, direction: Vector2i, occupied: Dictionary) -> String:
	if direction != Vector2i(1, 0):
		return BELT_ASSET
	var ahead := tile + direction
	if occupied.has("%d,%d" % [ahead.x, ahead.y]):
		return BELT_INLET_ASSET
	var behind := tile - direction
	if occupied.has("%d,%d" % [behind.x, behind.y]):
		return BELT_OUTLET_ASSET
	return BELT_ASSET


## One belt run + one machine per stage, placed exactly where the simulation
## says they are. Re-read from `chain_layout_json` every time rather than
## cached in the scene, so appending a recipe to data/recipes.ron still
## changes the rendered factory with no Godot-side edit.
func _build_chain() -> void:
	var layout: Array = JSON.parse_string(sim.chain_layout_json())
	var stages := Node3D.new()
	stages.name = "Chain"
	add_child(stages)
	# Cleared, not appended to: `_ready()` genuinely runs twice under the
	# headless `--script` SceneTree harness (see test_hover.gd's header).
	_belt_assets.clear()
	_machine_gauges.clear()

	var occupied := _machine_occupied_tiles(layout)
	for stage in layout:
		var recipe: String = stage["recipe"]
		var start: Array = stage["belt_start_tile"]
		var length: int = int(stage["belt_length_tiles"])
		var start_tile := Vector2i(int(start[0]), int(start[1]))
		var machine_pair: Array = stage["machine_tile"]
		var direction := _belt_direction(start_tile, Vector2i(int(machine_pair[0]), int(machine_pair[1])))
		for i in range(length):
			var tile := start_tile + direction * i
			var asset := _belt_asset_for(tile, direction, occupied)
			_belt_assets["%d,%d" % [tile.x, tile.y]] = asset
			var belt := _asset_node(asset)
			belt.name = "belt_%s_%d" % [recipe, i]
			belt.position = _tile_origin(tile.x, tile.y, FLOOR_Y)
			stages.add_child(belt)

		# Which model, and where it sits, both come from the simulation's own
		# `machine_kind`/`machine_footprint` fields — so a kind that grows in
		# data/machines.ron grows here, and a new kind draws (as the generic
		# model) without a Godot edit. See MACHINE_MODELS.
		var machine_tile: Array = stage["machine_tile"]
		var kind := String(stage.get("machine_kind", ""))
		var origin := Vector2i(int(machine_tile[0]), int(machine_tile[1]))
		var size := _footprint_size(stage.get("machine_footprint"))
		var machine := _asset_node(MACHINE_MODELS.get(kind, MACHINE_MODEL_FALLBACK))
		machine.name = "machine_%s" % recipe
		machine.position = _footprint_centre(origin, size, FLOOR_Y)
		stages.add_child(machine)

		var lamp := machine.get_node_or_null("emissive")
		if lamp != null:
			_machine_lamps[recipe] = lamp
			_machine_running[recipe] = true # force the first update to apply
			_set_machine_running(recipe, false)

		# The progress bar, for the kinds that declare one. Built exactly the
		# way the hopper's product body and the tank's liquid column are — a
		# sibling node holding a one-voxel-tall model, rescaled every frame —
		# rather than as a fourth mechanism. It is a SIBLING rather than a
		# child of `machine` so that `machine.get_node_or_null("emissive")`
		# above keeps finding the machine's own status lamps and nothing
		# else: the bar's mesh is emissive too, and `_set_machine_running`
		# swaps the whole emissive mesh's material.
		if MACHINE_PROGRESS_GAUGES.has(kind):
			var gauge := _asset_node(String(MACHINE_PROGRESS_GAUGES[kind]))
			gauge.name = "gauge_%s" % recipe
			gauge.position = _footprint_centre(origin, size, MACHINE_GAUGE_FLOOR_Y)
			gauge.visible = false
			stages.add_child(gauge)
			_machine_gauges[recipe] = gauge


## Fills `_last_machines` (what the hover tooltip reads, see
## _machine_hover_text) before the first item ever moves.
##
## `dirty_chunk_ids` only reports chunks something *changed* in, so an idle
## factory produces no snapshots at all and hovering a machine would show
## nothing until the player pressed a key. This asks the simulation directly,
## via SimBridge's existing `query_tile_json`, rather than inventing a
## default state Godot has no business knowing.
func _seed_machine_state() -> void:
	var layout: Array = JSON.parse_string(sim.chain_layout_json())
	for stage in layout:
		var tile: Array = stage["machine_tile"]
		var parsed = JSON.parse_string(sim.query_tile_json(int(tile[0]), int(tile[1])))
		if parsed == null or parsed.get("kind") != "machine":
			continue
		_last_machines[parsed["recipe"]] = {
			"recipe": parsed["recipe"],
			"process": parsed.get("process"),
			# query_tile deliberately doesn't report buffer contents; the
			# first chunk snapshot fills these in.
			"input": [],
			"output": [],
		}


## Builds the chain's delivery dock (the delivery-dock ticket) — the building
## itself, the one belt that runs into it, and the pooled nodes the goods
## waiting on its deck are drawn with.
##
## Read from `dock_snapshot_json` for `_build_hopper`'s reasons and one more
## of its own. `chain_layout_json` describes recipe-driven belt/machine stages
## only, and the dock is not one — nothing in `data/recipes.ron` names it. And
## the belt that feeds it is the one belt in the world belonging to no stage,
## so it is not in that layout either; `DockSnapshot` carries its
## `belt_start_tile`/`belt_length_tiles` precisely so this doesn't have to be
## hunted for in chunk snapshots, which report it keyed on the chunk holding
## its START tile while the dock itself sits over the x = 32 chunk boundary.
func _build_dock() -> void:
	# Rebuilding replaces the dock rather than adding a second one — the same
	# guard `_build_hopper`/`_build_fluid_tank` carry, for the same
	# headless-test double-`_ready()` reason (see test_hover.gd's header).
	var existing := get_node_or_null("Dock")
	if existing != null:
		remove_child(existing)
		existing.free()
	_dock_stock_nodes.clear()
	_dock_lamp = null

	var snapshot := _read_dock_snapshot()
	if snapshot.is_empty():
		return

	var tile_pair: Array = snapshot["tile"]
	_dock_tile = Vector2i(int(tile_pair[0]), int(tile_pair[1]))
	_dock_footprint = _footprint_size(snapshot.get("footprint"))

	var root := Node3D.new()
	root.name = "Dock"
	add_child(root)

	# The exit belt, drawn through exactly the machinery every stage's belt
	# goes through — same `_belt_asset_for` rule, same `_belt_assets` record —
	# so its first tile picks up the outlet variant behind the packer and its
	# last one the inlet variant against the dock, without either end being
	# special-cased here.
	var belt_pair: Array = snapshot["belt_start_tile"]
	var belt_start := Vector2i(int(belt_pair[0]), int(belt_pair[1]))
	var belt_length: int = int(snapshot.get("belt_length_tiles", 0))
	var direction := _belt_direction(belt_start, _dock_tile)
	var occupied := _machine_occupied_tiles(JSON.parse_string(sim.chain_layout_json()))
	for i in range(belt_length):
		var tile := belt_start + direction * i
		var asset := _belt_asset_for(tile, direction, occupied)
		_belt_assets["%d,%d" % [tile.x, tile.y]] = asset
		var belt := _asset_node(asset)
		belt.name = "belt_dock_%d" % i
		belt.position = _tile_origin(tile.x, tile.y, FLOOR_Y)
		root.add_child(belt)

	var body := _asset_node(MACHINE_MODELS.get(String(snapshot.get("kind", "dock")), MACHINE_MODEL_FALLBACK))
	body.name = "dock_body"
	body.position = _footprint_centre(_dock_tile, _dock_footprint, FLOOR_Y)
	root.add_child(body)

	_dock_lamp = body.get_node_or_null("emissive")
	_dock_has_stock = true # force the first _update_dock call to apply
	_set_dock_lamp_stocked(false)

	# One node per stock slot, created hidden and revealed by
	# `_update_dock_stock`. Pooled rather than spawned per frame for
	# `_item_node_for`'s reason — this is the same "a case standing
	# somewhere" node, just standing on a deck instead of on a belt.
	var deck := _footprint_centre(_dock_tile, _dock_footprint, DOCK_DECK_Y)
	for i in range(DOCK_STOCK_SLOTS):
		var offset: Vector2 = DOCK_STOCK_OFFSETS[i]
		var slot := Node3D.new()
		slot.name = "dock_stock_%d" % i
		# The vox importer maps low local Y to high world Z, so a slot's
		# model-space Y offset runs the other way in the world (the same
		# mapping `_footprint_centre`'s doc relies on).
		slot.position = deck + Vector3(offset.x * VOXEL_UNIT, 0.0, -offset.y * VOXEL_UNIT)
		slot.visible = false
		root.add_child(slot)
		_dock_stock_nodes.append(slot)


## Every world has exactly one dock, so unlike `fluid_snapshot_json` this
## never legitimately returns an empty string — it is still guarded, the same
## way `_read_hopper_snapshot` is, so a future SimBridge that drops the
## building doesn't crash the scene.
func _read_dock_snapshot() -> Dictionary:
	var json: String = sim.dock_snapshot_json()
	if json.is_empty():
		return {}
	var parsed = JSON.parse_string(json)
	return parsed if parsed is Dictionary else {}


## Re-reads the dock every frame: its own snapshot (for the hover tooltip and
## the lifetime shipped count) and the economy's shared delivery pool (for the
## goods actually standing on the deck).
##
## Two calls rather than one because they answer two different questions, and
## conflating them would be the lie DOCK_ASSET's doc describes: the dock's own
## `contents` is a transfer buffer that empties every tick, so it is always
## `[]` here, while `delivery_stock` is the pool that accumulates between
## contract settlements and therefore the only honest source for "what is
## waiting to be sold".
func _update_dock() -> void:
	var snapshot := _read_dock_snapshot()
	if not snapshot.is_empty():
		_last_dock = snapshot
	var econ = JSON.parse_string(sim.economy_snapshot_json())
	var stock: Array = econ.get("delivery_stock", []) if econ is Dictionary else []
	_last_dock_stock = stock
	_update_dock_stock(stock)


## Stands one case on the deck per unit of stock waiting to be sold, up to
## DOCK_STOCK_SLOTS, each drawn with that item's OWN model — so what is
## standing on the dock looks like what came down the belt, through the same
## ITEM_MODELS table, rather than through a second "goods" asset that would
## drift from it the way ITEM_MODELS itself once drifted from
## `data/recipes.ron` (see its doc).
##
## Pure given `stock`, so a test can drive it with a list directly.
func _update_dock_stock(stock: Array) -> void:
	if _dock_stock_nodes.is_empty():
		return
	# Flatten the pool's (item, quantity) pairs into one case per unit, in
	# snapshot order, so a multi-item pool shows a mixed stack rather than
	# only its first product.
	var waiting: Array[String] = []
	for pair in stock:
		if not (pair is Array) or pair.size() < 2:
			continue
		for _i in range(int(pair[1])):
			if waiting.size() >= DOCK_STOCK_SLOTS:
				break
			waiting.append(String(pair[0]))

	for i in range(_dock_stock_nodes.size()):
		var slot := _dock_stock_nodes[i]
		if i >= waiting.size():
			slot.visible = false
			continue
		var asset: String = ITEM_MODELS.get(waiting[i], ITEM_MODEL_FALLBACK)
		var current := slot.get_node_or_null("case")
		if current == null or String(current.get_meta("asset", "")) != asset:
			if current != null:
				slot.remove_child(current)
				current.queue_free()
			var node := _asset_node(asset)
			node.name = "case"
			node.set_meta("asset", asset)
			slot.add_child(node)
		slot.visible = true

	_set_dock_lamp_stocked(not waiting.is_empty())


## The dock's bay light, swapped between the same idle/running materials the
## hopper's and every machine's lamp use. It reports the one state a dock
## actually has: goods are waiting to be sold, or the bay is clear. A lamp
## reporting "the dock is running" would be on every tick of the game, since
## the dock ships automatically and unconditionally.
func _set_dock_lamp_stocked(has_stock: bool) -> void:
	if _dock_has_stock == has_stock:
		return
	_dock_has_stock = has_stock
	if _dock_lamp != null:
		_dock_lamp.set_surface_override_material(0, _lamp_running if has_stock else _lamp_idle)


## Builds the chain's raw-ingredient hopper (ticket 3's building) plus the
## body of product visible inside it, at the tile the SIMULATION says it
## stands on — the same rule `_build_chain` follows for machines.
##
## Read from `hopper_snapshot_json`, not from `chain_layout_json` (which
## describes recipe-driven belt/machine stages only — the hopper is not one
## of them) and not from `chunk_snapshot_json` (which carries the identical
## object, but only for chunks that are currently dirty, and the hopper sits
## at a negative x, i.e. in chunk (-1, 0) rather than the (0, 0) that holds
## the rest of the chain — a renderer asking only for the chain's own chunk
## would never see it). The hopper snapshot is the one call that always
## describes it, exactly as `sim::HopperSnapshot`'s doc says.
func _build_hopper() -> void:
	# Rebuilding replaces the hopper rather than adding a second one — the
	# same guard `_build_fluid_network` carries, for the same headless-test
	# double-`_ready()` reason (see test_hover.gd's header).
	var existing := get_node_or_null("Hopper")
	if existing != null:
		remove_child(existing)
		existing.free()
	_hopper_fill_node = null
	_hopper_lamp = null

	var snapshot := _read_hopper_snapshot()
	if snapshot.is_empty():
		return

	var tile_pair: Array = snapshot["tile"]
	_hopper_tile = Vector2i(int(tile_pair[0]), int(tile_pair[1]))
	_hopper_footprint = _footprint_size(snapshot.get("footprint"))

	var root := Node3D.new()
	root.name = "Hopper"
	add_child(root)

	var body := _asset_node(HOPPER_ASSET)
	body.name = "hopper_body"
	body.position = _footprint_centre(_hopper_tile, _hopper_footprint, FLOOR_Y)
	root.add_child(body)

	_hopper_lamp = body.get_node_or_null("emissive")
	_hopper_has_stock = true # force the first _update_hopper call to apply
	_set_hopper_lamp_stocked(false)

	# The product level: one voxel tall, scaled every frame — see _update_hopper.
	var fill := _asset_node(HOPPER_FILL_ASSET)
	fill.name = "hopper_fill"
	fill.position = _footprint_centre(_hopper_tile, _hopper_footprint, HOPPER_FILL_FLOOR_Y)
	var tint: Color = HOPPER_FILL_TINTS.get(String(snapshot.get("item", "")), HOPPER_FILL_TINT_FALLBACK)
	for child in fill.get_children():
		if child is MeshInstance3D:
			var base: StandardMaterial3D = _class_materials.get("matte", null)
			var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.95, 0.0)
			mat.albedo_color = tint
			child.set_surface_override_material(0, mat)
	root.add_child(fill)
	_hopper_fill_node = fill


## Unlike `fluid_snapshot_json` there is no empty-string case (every world
## has exactly one hopper), but this still guards for one so a future
## SimBridge that grows one doesn't crash the scene.
func _read_hopper_snapshot() -> Dictionary:
	var json: String = sim.hopper_snapshot_json()
	if json.is_empty():
		return {}
	var parsed = JSON.parse_string(json)
	return parsed if parsed is Dictionary else {}


## Re-reads the hopper every frame and rescales the product body to its live
## fill fraction — the exact pattern `_update_fluid_network` established for
## the liquid in a pipe, deliberately reused rather than invented again: one
## poll of a whole-world snapshot, one node scaled on its Y axis, hidden
## outright below a minimum so it never renders as a sub-voxel sliver.
##
## Polling (rather than waiting for `dirty_chunk_ids`) is the right call for
## a different reason than fluid's: a hopper's level DOES dirty its chunk,
## but only chunk (-1, 0), and the tooltip wants the level every frame
## regardless — so one call here is simpler than teaching the chunk path
## about a second chunk.
func _update_hopper() -> void:
	var snapshot := _read_hopper_snapshot()
	if snapshot.is_empty():
		return
	_last_hopper = snapshot
	if _hopper_fill_node == null:
		return
	var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
	_hopper_fill_node.visible = fill > HOPPER_MIN_VISIBLE_FILL
	if _hopper_fill_node.visible:
		_hopper_fill_node.scale.y = fill * float(HOPPER_FILL_HEIGHT_VOXELS)
	_set_hopper_lamp_stocked(fill > HOPPER_MIN_VISIBLE_FILL)


## Swaps the hopper's status lamp between the same idle/running materials a
## machine's lamp uses (`_set_machine_running`'s exact pattern, applied to a
## building that isn't a `stages` entry) — see `_hopper_lamp`'s doc for why.
func _set_hopper_lamp_stocked(has_stock: bool) -> void:
	if _hopper_has_stock == has_stock:
		return
	_hopper_has_stock = has_stock
	if _hopper_lamp != null:
		_hopper_lamp.set_surface_override_material(0, _lamp_running if has_stock else _lamp_idle)


## Builds the pipe run's fluid tank (ticket 1's building) plus the column of
## liquid standing inside it, at the tile the SIMULATION says it occupies.
##
## Read from `fluid_tank_snapshot_json` for the same reasons `_build_hopper`
## reads the hopper's own call: `chain_layout_json` describes recipe-driven
## belt/machine stages only and the tank is not one, and
## `chunk_snapshot_json`'s `fluid_tanks` array only arrives for chunks that
## are currently dirty — and the tank's level changes without dirtying its
## chunk at all (only a `fill_fluid_tank` command does), so a chunk-driven
## renderer would sit waiting on an event that never comes. Unlike the
## hopper's call this one can legitimately return an empty string: a world
## whose `data/recipes.ron` declares no `fluid_inputs` has no pipe run and
## therefore no tank.
func _build_fluid_tank() -> void:
	# Rebuilding replaces the tank rather than adding a second one — the same
	# guard `_build_hopper`/`_build_fluid_network` carry, for the same
	# headless-test double-`_ready()` reason (see test_hover.gd's header).
	var existing := get_node_or_null("FluidTank")
	if existing != null:
		remove_child(existing)
		existing.free()
	_fluid_tank_fill_node = null
	_fluid_tank_lamp = null

	var snapshot := _read_fluid_tank_snapshot()
	if snapshot.is_empty():
		return # no recipe declares fluid_inputs — this world has no tank

	var tile_pair: Array = snapshot["tile"]
	_fluid_tank_tile = Vector2i(int(tile_pair[0]), int(tile_pair[1]))
	_fluid_tank_footprint = _footprint_size(snapshot.get("footprint"))

	var root := Node3D.new()
	root.name = "FluidTank"
	add_child(root)

	var body := _asset_node(FLUID_TANK_ASSET)
	body.name = "fluid_tank_body"
	body.position = _footprint_centre(_fluid_tank_tile, _fluid_tank_footprint, FLOOR_Y)
	root.add_child(body)

	_fluid_tank_lamp = body.get_node_or_null("emissive")
	_fluid_tank_has_stock = true # force the first _update_fluid_tank call to apply
	_set_fluid_tank_lamp_stocked(false)

	# The liquid column: one voxel tall, scaled every frame — see
	# _update_fluid_tank. Tinted per fluid exactly as the pipe run's own
	# liquid is, through the same `_fluid_material_for`, so the vinegar in the
	# tank and the vinegar in the pipes are the same colour by construction
	# rather than by two constants agreeing.
	var fill := _asset_node(FLUID_TANK_FILL_ASSET)
	fill.name = "fluid_tank_fill"
	fill.position = _footprint_centre(_fluid_tank_tile, _fluid_tank_footprint, FLUID_TANK_FILL_FLOOR_Y)
	var mat := _fluid_material_for(String(snapshot.get("fluid", "")))
	for child in fill.get_children():
		if child is MeshInstance3D:
			child.set_surface_override_material(0, mat)
	root.add_child(fill)
	_fluid_tank_fill_node = fill


## `fluid_tank_snapshot_json` returns an EMPTY STRING (not `null`) when the
## world has no pipe run, per SimBridge's own documented convention — check
## that before parsing, exactly as `_read_fluid_snapshot` does.
func _read_fluid_tank_snapshot() -> Dictionary:
	var json: String = sim.fluid_tank_snapshot_json()
	if json.is_empty():
		return {}
	var parsed = JSON.parse_string(json)
	return parsed if parsed is Dictionary else {}


## Re-reads the tank every frame and rescales its liquid column to the live
## fill fraction — the same one-poll/one-scaled-body pattern
## `_update_fluid_network` established for a pipe and `_update_hopper` reused
## for bulk product, deliberately reused a third time rather than invented
## again.
func _update_fluid_tank() -> void:
	var snapshot := _read_fluid_tank_snapshot()
	if snapshot.is_empty():
		return
	_last_fluid_tank = snapshot
	if _fluid_tank_fill_node == null:
		return
	var fill: float = clampf(float(snapshot.get("fill", 0.0)), 0.0, 1.0)
	_fluid_tank_fill_node.visible = fill > FLUID_TANK_MIN_VISIBLE_FILL
	if _fluid_tank_fill_node.visible:
		_fluid_tank_fill_node.scale.y = fill * float(FLUID_TANK_FILL_HEIGHT_VOXELS)
	_set_fluid_tank_lamp_stocked(fill > FLUID_TANK_MIN_VISIBLE_FILL)


## Swaps the tank's status lamp between the same idle/running materials a
## machine's and the hopper's lamps use — an empty tank stalls the mixer, so
## it is exactly the kind of state UI_UX.md §7 wants reported by more than
## the level itself.
func _set_fluid_tank_lamp_stocked(has_stock: bool) -> void:
	if _fluid_tank_has_stock == has_stock:
		return
	_fluid_tank_has_stock = has_stock
	if _fluid_tank_lamp != null:
		_fluid_tank_lamp.set_surface_override_material(0, _lamp_running if has_stock else _lamp_idle)


## Builds the pipe run — one voxel model per pipe tile the SIMULATION says
## exists, plus one liquid body sitting in each one's bore.
##
## Geometry comes from `fluid_snapshot_json`, not from `chain_layout_json`
## (which describes belt/machine stages only) and not from
## `chunk_snapshot_json` (whose `pipes` array carries the same geometry, but
## only for chunks that are currently *dirty* — and ticket 1 deliberately
## made fluid movement NOT dirty its chunk, so a chunk-driven renderer would
## be waiting on an event that never comes). The fluid snapshot is the one
## call that always describes the whole network, which is exactly why
## `sim::FluidSnapshot`'s own doc says to poll it like the economy snapshot.
##
## Nothing about the pipe run is written down here: how many tiles there are,
## where they sit, and which one is the source all come out of that JSON, so
## a `data/recipes.ron` edit that plumbs a different stage moves the pipes
## with no Godot-side change — the same rule `_build_chain` follows.
func _build_fluid_network() -> void:
	# Rebuilding replaces the run rather than adding a second one. This
	# matters in the headless `--script` SceneTree tests, where `_ready()`
	# genuinely runs twice (see test_hover.gd's header for that harness
	# quirk) — without this, `_pipe_fluid_nodes` would end up holding two
	# entries per simulated segment.
	var existing := get_node_or_null("FluidNetwork")
	if existing != null:
		remove_child(existing)
		existing.free()
	_pipe_tiles.clear()
	_pipe_fluid_nodes.clear()

	var snapshot := _read_fluid_snapshot()
	if snapshot.is_empty():
		return # no recipe declares fluid_inputs — this world has no pipes

	_fluid_material = _fluid_material_for(String(snapshot.get("fluid", "")))

	var run := Node3D.new()
	run.name = "FluidNetwork"
	add_child(run)

	var segments: Array = snapshot.get("segments", [])
	var inlet_index := int(snapshot.get("inlet_index", -1))
	for i in range(segments.size()):
		var segment: Dictionary = segments[i]
		var tile_pair: Array = segment["tile"]
		var tile := Vector2i(int(tile_pair[0]), int(tile_pair[1]))
		_pipe_tiles[tile] = i

		var asset: String
		if bool(segment.get("is_source", false)):
			asset = PIPE_SOURCE_ASSET
		elif i == inlet_index:
			# The one segment actually feeding a machine — see PIPE_INLET_ASSET's
			# doc for why it needs its own model rather than the plain one.
			asset = PIPE_INLET_ASSET
		else:
			asset = PIPE_ASSET
		var pipe := _asset_node(asset)
		pipe.name = "pipe_%d" % i
		pipe.position = _tile_origin(tile.x, tile.y, FLOOR_Y)
		run.add_child(pipe)

		var fluid := _asset_node(PIPE_FLUID_ASSET)
		fluid.name = "fluid_%d" % i
		fluid.position = _tile_origin(tile.x, tile.y, PIPE_BORE_FLOOR_Y)
		if i == inlet_index:
			# The run's downstream end is CLOSED (`pipe_inlet` draws a blind
			# flange there — see its generator doc), and the liquid model
			# spans its whole tile because every other segment butts into the
			# next one. Left full length it pushed straight through that
			# flange and the end of the run rendered as an open, liquid-
			# filled cut pipe, which was exactly the "nothing terminates
			# anything" reading this ticket exists to remove. Trim it back by
			# the flange's own thickness, anchored so the trim comes off the
			# downstream end only.
			fluid.scale.x = 1.0 - FLUID_END_CAP_TRIM
			fluid.position.x -= 0.5 * FLUID_END_CAP_TRIM * TILE
		# The liquid is the one thing in the scene whose colour is live data,
		# so it gets its own material rather than the shared class one.
		for child in fluid.get_children():
			if child is MeshInstance3D:
				child.set_surface_override_material(0, _fluid_material)
		run.add_child(fluid)
		_pipe_fluid_nodes.append(fluid)


## `fluid_snapshot_json` returns an EMPTY STRING (not `null`) when the world
## has no pipe run, per SimBridge's own documented convention — check that
## before parsing, or JSON.parse_string returns null and every caller has to
## re-handle it.
func _read_fluid_snapshot() -> Dictionary:
	var json: String = sim.fluid_snapshot_json()
	if json.is_empty():
		return {}
	var parsed = JSON.parse_string(json)
	return parsed if parsed is Dictionary else {}


## The liquid's material: palette.ron's own `liquid` class numbers (glossy
## dielectric — UI_UX.md §4's "visible liquid surfaces ... with subtle
## shading/reflection"), tinted per fluid id. Only the tint is decided here;
## the shading numbers stay in palette.ron like every other material.
func _fluid_material_for(fluid_id: String) -> StandardMaterial3D:
	var base: StandardMaterial3D = _class_materials.get("liquid", null)
	var mat: StandardMaterial3D = base.duplicate() if base != null else _make_material(0.0, 0.14, 0.0)
	mat.albedo_color = FLUID_TINTS.get(fluid_id, FLUID_TINT_FALLBACK)
	return mat


## Re-reads the whole network every frame and resizes each liquid body to its
## segment's live fill fraction. Cheap by design: there is exactly one
## network per world (see `sim::FluidSnapshot`), and fluid moves on nearly
## every tick, so this is the same poll-don't-dirty-track trade the contract
## clipboard already makes with `economy_snapshot_json`.
func _update_fluid_network() -> void:
	if _pipe_fluid_nodes.is_empty():
		return
	var snapshot := _read_fluid_snapshot()
	if snapshot.is_empty():
		return
	_last_fluid = snapshot

	var segments: Array = snapshot.get("segments", [])
	for i in range(min(segments.size(), _pipe_fluid_nodes.size())):
		var pressure: float = clampf(float(segments[i].get("pressure", 0.0)), 0.0, 1.0)
		var node: Node3D = _pipe_fluid_nodes[i]
		node.visible = pressure > FLUID_MIN_VISIBLE_PRESSURE
		if node.visible:
			node.scale.y = pressure * float(PIPE_BORE_HEIGHT_VOXELS)


## How far through its current process one stage's machine is, as 0..1, or
## -1.0 when it is idle. Derived from `_last_machines`'s own
## `process` = `[start_tick, required_ticks]` pair plus the simulation's
## current tick — NOT from a per-tick snapshot, and that distinction matters
## here more than anywhere else in this file: a machine only dirties its
## chunk when its state actually changes (a craft starts, a craft finishes),
## so during the aging rack's 2400-tick wait no snapshot arrives at all.
## Recomputing from `current_tick()` every frame is what makes a long
## process animate smoothly rather than jump when it ends.
## Pure given `_last_machines`/`sim.current_tick()`, so it is directly
## testable — the same property `_machine_hover_text` is written for.
func _machine_progress(recipe_id: String) -> float:
	if not _last_machines.has(recipe_id):
		return -1.0
	var process = _last_machines[recipe_id].get("process")
	if process == null:
		return -1.0
	var required: int = int(process[1])
	if required <= 0:
		return -1.0
	var elapsed: int = sim.current_tick() - int(process[0])
	return clampf(float(elapsed) / float(required), 0.0, 1.0)


## Rescales every declared progress gauge to its machine's live process
## fraction — the same one-poll/one-scaled-body pattern
## `_update_fluid_network` established for a pipe's liquid and
## `_update_hopper`/`_update_fluid_tank` reused for bulk and tank levels,
## deliberately reused a fourth time rather than invented again.
func _update_machine_gauges() -> void:
	for recipe_id in _machine_gauges.keys():
		var gauge: Node3D = _machine_gauges[recipe_id]
		if gauge == null:
			continue
		var fraction := _machine_progress(recipe_id)
		gauge.visible = fraction > MACHINE_GAUGE_MIN_VISIBLE
		if gauge.visible:
			gauge.scale.y = fraction * float(MACHINE_GAUGE_HEIGHT_VOXELS)


func _set_machine_running(recipe: String, running: bool) -> void:
	if _machine_running.get(recipe, null) == running:
		return
	_machine_running[recipe] = running
	var lamp: MeshInstance3D = _machine_lamps.get(recipe, null)
	if lamp != null:
		lamp.set_surface_override_material(0, _lamp_running if running else _lamp_idle)


# --------------------------------------------------------------------------
# Camera & lighting
# --------------------------------------------------------------------------

## UI_UX.md §1: a FIXED orthographic isometric camera. No orbit, no free
## rotation — the voxel assets are modelled to read from fixed angles, and a
## free camera would expose silhouettes nothing was art-directed for. Pan
## (WASD/arrows) and zoom (scroll wheel) are explicitly allowed by that same
## section and don't touch the angle: pan moves `_camera_focus`, zoom moves
## `_camera_size`, orientation is always recomputed the same way.
##
## The angle used is true isometric (an equal-parts (1, 1, 1) view direction,
## ~35.26 degrees of elevation), not a 2:1 dimetric. UI_UX.md §9 explicitly
## leaves the final choice open pending a side-by-side prototype; this picks
## the one that keeps voxel cubes perfectly regular on screen, and changing
## it later is one constant here, not an asset change.
const CAMERA_DIRECTION := Vector3(1, 1, 1)
## Orthographic, so this only sets the near/far window, not apparent size.
const CAMERA_DISTANCE := 160.0

# --- Navigation (zoom + pan) -----------------------------------------------
# UI_UX.md §1 explicitly allows smooth zoom and only forbids free rotation —
# the fixed isometric angle itself never changes here, only `size` (zoom) and
# `_camera_focus` (pan) do.
const ZOOM_STEP := 0.1 # fraction of current size per scroll notch, mouse wheel or +/-
const ZOOM_MIN_FACTOR := 0.3 # most zoomed in, relative to the auto-framed size
const ZOOM_MAX_FACTOR := 3.0 # most zoomed out
const PAN_SPEED := 0.9 # fraction of the visible size crossed per second at held-key pan
# InputEventPanGesture.delta is in gesture-magnitude units, not wheel notches,
# and arrives many times per swipe — this converts one unit of that delta
# into a fraction of ZOOM_STEP's effect, tuned so a normal swipe feels
# similar in speed to a few wheel notches, not a single giant jump.
const TRACKPAD_ZOOM_SENSITIVITY := 0.01
const ISO_NEAR := 0.5

# --- First-person mode -----------------------------------------------------
# Not a UI_UX.md concept — a free-look "fly" camera for looking around the
# factory up close. No gravity, no collision: this project has no player
# entity or collision shapes on the voxel meshes, so it deliberately doesn't
# pretend to be one.
const FP_MOVE_SPEED := 6.0 # world units/second (~2 tiles/second)
const FP_MOUSE_SENSITIVITY := 0.0025 # radians per pixel of relative mouse motion
const FP_PITCH_LIMIT := deg_to_rad(89.0) # stop just short of looking straight up/down
const FP_FOV := 75.0
const FP_NEAR := 0.05 # much closer than ISO_NEAR — this mode gets right up next to machines
const CROSSHAIR_SIZE := 14.0 # px, each bar's length
const CROSSHAIR_THICKNESS := 2.0 # px, each bar's width

# The **C: collect product** hint these two used to carry is gone, with the
# key that drove it: the delivery-dock ticket deleted
# `PlayerCommand::CollectOutput` outright, because the chain now ends in a
# real dock that ships into the delivery pool every tick by itself. A key
# that quietly did nothing would be worse than no key — `issue_command_json`
# treats an unknown command as a silent no-op, so the legend would have been
# advertising a control the simulation no longer has.
const ISO_HELP_TEXT := "SPACE: load the hopper    V: load the fluid tank    B: build menu    WASD/drag/arrows: pan    scroll/+-: zoom    TAB: first-person"
const FP_HELP_TEXT := "V: load the fluid tank    B: build menu    WASD: move    mouse: look    SPACE/SHIFT: up/down    TAB: isometric"


func _build_camera() -> void:
	_camera_focus = Vector3(
		float(_chain_tile_width - 1) * TILE * 0.5,
		TILE * 0.35,
		0.0
	)

	var camera := Camera3D.new()
	camera.name = "IsometricCamera"
	camera.projection = Camera3D.PROJECTION_ORTHOGONAL
	# KEEP_WIDTH so `size` means the horizontal extent: the factory is a long
	# horizontal line, and it must stay framed regardless of window aspect.
	camera.keep_aspect = Camera3D.KEEP_WIDTH
	camera.near = ISO_NEAR
	camera.far = 600.0
	add_child(camera)
	_camera = camera

	# Position/orient first (size doesn't affect orientation) so the camera's
	# own basis exists to read the ground-plane screen axes from — right is
	# already horizontal (up hint is world Y and the view direction isn't
	# vertical); "screen forward" is the view direction (-basis.z) projected
	# onto the ground. WASD/arrows pan along these, not raw world X/Z, so
	# panning still feels like up/down/left/right on screen regardless of the
	# fixed isometric angle.
	_camera_size = 1.0
	_update_camera_transform()
	_pan_right = _camera.transform.basis.x
	var forward := -_camera.transform.basis.z
	_pan_forward = Vector3(forward.x, 0.0, forward.z).normalized()

	_camera_base_size = _framing_size(_camera.transform.basis)
	_camera_size = _camera_base_size
	_update_camera_transform()
	camera.call_deferred("make_current")


## Repositions/reorients the camera from `_camera_focus`/`_camera_size` —
## called once at build time and again whenever pan or zoom changes. Cheap
## enough to call every time rather than tracking a dirty flag.
func _update_camera_transform() -> void:
	if _camera == null:
		return
	# `look_at_from_position` rather than position-then-`look_at`: the latter
	# requires the node to already be inside the tree, which isn't guaranteed
	# for a scene instantiated and driven manually (as the headless tests do).
	_camera.look_at_from_position(
		_camera_focus + CAMERA_DIRECTION.normalized() * CAMERA_DISTANCE,
		_camera_focus,
		Vector3.UP
	)
	_camera.size = _camera_size


func _zoom_camera(factor: float) -> void:
	var min_size := _camera_base_size * ZOOM_MIN_FACTOR
	var max_size := _camera_base_size * ZOOM_MAX_FACTOR
	_camera_size = clampf(_camera_size * factor, min_size, max_size)
	_update_camera_transform()


func _pan_camera(delta: float) -> void:
	_apply_pan(_pan_input_direction(), delta)


## Reads held keys only — no movement math, so this is the one part of
## panning that can't be exercised without a live Input singleton.
func _pan_input_direction() -> Vector3:
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += _pan_forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= _pan_forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += _pan_right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= _pan_right
	return move


## The actual movement, deliberately Input-free so it's directly testable
## (test_camera_nav.gd calls this with an explicit direction).
func _apply_pan(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	# Scaled by current `_camera_size`, not a flat world-unit speed, so pan
	# covers the same fraction of the visible view per second whether zoomed
	# in or out — a flat speed would feel sluggish when zoomed out and
	# twitchy when zoomed in.
	_camera_focus += direction.normalized() * PAN_SPEED * _camera_size * delta
	_update_camera_transform()


## World units per screen pixel at the current zoom — the conversion factor
## that makes click-and-drag panning track the cursor 1:1 (the point under
## the cursor when the drag started stays under it), rather than an arbitrary
## fixed speed that would feel wrong at every zoom level except one.
func _iso_drag_sensitivity() -> float:
	var width := 0.0
	var vp := get_viewport()
	if vp != null:
		width = vp.get_visible_rect().size.x
	if width <= 0.0:
		# A script-mode SceneTree (this project's own headless tests included)
		# never sizes a real window, so `get_viewport()` reports a zero-size
		# rect — fall back to the project's configured window width so drag
		# panning still does something reasonable instead of silently no-op'ing.
		width = float(ProjectSettings.get_setting("display/window/size/viewport_width", 1280))
	if width <= 0.0:
		return 0.0
	return _camera_size / width


## Right-mouse-drag panning (UI_UX.md §1 allows pan; this is just a second
## way to do it alongside WASD). Right button, not left, so a future
## click-to-build/select interaction on the left button has nothing to fight
## with.
func _apply_drag_pan(relative: Vector2) -> void:
	var sensitivity := _iso_drag_sensitivity()
	if sensitivity <= 0.0:
		return
	# "Grab the world and drag it": the point under the cursor follows the
	# cursor, which means the focus point moves opposite the drag on the
	# right axis and along the forward axis on the (screen-down-is-positive) Y.
	_camera_focus += (-_pan_right * relative.x + _pan_forward * relative.y) * sensitivity
	_update_camera_transform()


# --------------------------------------------------------------------------
# First-person mode
# --------------------------------------------------------------------------

## Rotation around world Y only, no pitch — used both to build the full
## look basis (below) and, on its own, as the horizontal movement basis so
## WASD moves along the ground regardless of where you're looking up/down,
## the same way Minecraft's own flight controls work.
func _fp_heading_basis() -> Basis:
	return Basis(Vector3.UP, _fp_yaw)


## Heading, then tilted by pitch around the resulting local right axis —
## composed in this order specifically so pitch never affects heading.
func _fp_look_basis() -> Basis:
	return _fp_heading_basis() * Basis(Vector3.RIGHT, _fp_pitch)


func _update_fp_camera_transform() -> void:
	if _camera == null:
		return
	_camera.transform = Transform3D(_fp_look_basis(), _fp_position)


## Mouse-look, deliberately Input-free (see _apply_pan's equivalent note) so
## test_camera_nav.gd can call it directly with a synthetic delta.
func _apply_look(relative: Vector2) -> void:
	_fp_yaw -= relative.x * FP_MOUSE_SENSITIVITY
	_fp_pitch = clampf(_fp_pitch - relative.y * FP_MOUSE_SENSITIVITY, -FP_PITCH_LIMIT, FP_PITCH_LIMIT)
	_update_fp_camera_transform()


## Reads held keys only, same split as _pan_input_direction for the same
## reason (untestable headlessly without a live Input singleton). SPACE/SHIFT
## for up/down, Minecraft-style — SPACE only spawns a tomato in ISOMETRIC mode
## (_unhandled_input gates that), so there's no conflict with flying up here.
func _fp_input_direction() -> Vector3:
	var heading := _fp_heading_basis()
	var forward := -heading.z
	var right := heading.x
	var move := Vector3.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		move += forward
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		move -= forward
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		move += right
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		move -= right
	if Input.is_key_pressed(KEY_SPACE):
		move += Vector3.UP
	if Input.is_key_pressed(KEY_SHIFT):
		move -= Vector3.UP
	return move


## The actual movement, Input-free and directly testable — mirrors _apply_pan.
func _apply_fp_move(direction: Vector3, delta: float) -> void:
	if direction == Vector3.ZERO:
		return
	_fp_position += direction.normalized() * FP_MOVE_SPEED * delta
	_update_fp_camera_transform()


func _fp_camera_move(delta: float) -> void:
	_apply_fp_move(_fp_input_direction(), delta)


## TAB toggles between ISOMETRIC and FIRST_PERSON. Both share the one
## Camera3D node — this reconfigures it (projection, near plane, aspect
## policy) rather than creating a second one.
func _set_view_mode(mode: int) -> void:
	if mode == _view_mode:
		return
	_view_mode = mode
	_update_crosshair_visibility()

	if mode == ViewMode.FIRST_PERSON:
		_iso_dragging = false
		# Start hovering above wherever the isometric view was focused, so
		# the switch feels continuous instead of teleporting to the origin.
		_fp_position = _camera_focus + Vector3(0.0, TILE * 1.5, 0.0)
		# Best-effort continuity, not an exact guarantee: face roughly the
		# same way the isometric camera was looking. Mouse-look overrides it
		# immediately, so an imperfect starting angle here doesn't matter.
		_fp_yaw = atan2(-_pan_forward.x, -_pan_forward.z)
		_fp_pitch = deg_to_rad(-15.0)
		_camera.projection = Camera3D.PROJECTION_PERSPECTIVE
		_camera.fov = FP_FOV
		_camera.near = FP_NEAR
		_camera.keep_aspect = Camera3D.KEEP_HEIGHT
		# ...unless the build menu is up, which needs the cursor (see
		# _set_shop_menu_open); closing it recaptures.
		if not _shop_open:
			Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
		_update_fp_camera_transform()
		if _help_label != null:
			_help_label.text = FP_HELP_TEXT
	else:
		# Keep the isometric view's height (its focus point's Y never moved
		# on its own), just recentre X/Z on wherever first-person ended up.
		_camera_focus = Vector3(_fp_position.x, _camera_focus.y, _fp_position.z)
		_camera.projection = Camera3D.PROJECTION_ORTHOGONAL
		_camera.near = ISO_NEAR
		_camera.keep_aspect = Camera3D.KEEP_WIDTH
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE
		_update_camera_transform()
		if _help_label != null:
			_help_label.text = ISO_HELP_TEXT
	_update_camera_transform()


## Fits the orthographic frustum to the factory floor's bounding box by
## projecting its eight corners onto the camera's own right/up axes.
##
## Worth doing properly rather than eyeballing a constant: the chain's length
## is whatever data/recipes.ron currently defines, so the framing has to be
## derived, and an isometric view rotates the world box 45 degrees relative to
## the screen — a naive "width = chain length" estimate is wrong in both
## directions at once.
func _framing_size(basis: Basis) -> float:
	var x_from := float(-FLOOR_MARGIN_X) - 0.5
	var x_to := float(_chain_tile_width - 1 + FLOOR_MARGIN_X) + 0.5
	var z_from := float(-FLOOR_MARGIN_Z) - 0.5
	var z_to := float(FLOOR_MARGIN_Z) + 0.5

	var min_right := INF
	var max_right := -INF
	var min_up := INF
	var max_up := -INF
	for cx in [x_from, x_to]:
		for cz in [z_from, z_to]:
			# 0 .. one tile tall covers the floor slab through the machines'
			# vessels; the exhaust stacks poking above are not worth zooming
			# the whole factory out for.
			for cy in [0.0, TILE]:
				var corner := Vector3(cx * TILE, cy, cz * TILE)
				min_right = min(min_right, basis.x.dot(corner))
				max_right = max(max_right, basis.x.dot(corner))
				min_up = min(min_up, basis.y.dot(corner))
				max_up = max(max_up, basis.y.dot(corner))

	var aspect := 16.0 / 9.0
	var viewport := get_viewport()
	if viewport != null:
		var rect := viewport.get_visible_rect().size
		if rect.x > 0.0 and rect.y > 0.0:
			aspect = rect.x / rect.y

	var needed_width := max_right - min_right
	var needed_height := max_up - min_up
	return max(needed_width, needed_height * aspect) * 1.06


## UI_UX.md §4: real-time dynamic lighting with soft shadows, light ambient
## occlusion in voxel crevices, and mild bloom on emissives — the
## "modded Minecraft with a shader pack" reference point, not photorealism.
## All of it is stock Forward+ environment configuration; no custom shaders.
##
## The sky IS the visible backdrop (BG_SKY), not just a light source — a
## flat near-black BG_COLOR was tried first specifically to avoid a hard
## horizon line/sun streak behind the tightly-framed isometric view, but it
## reads as an empty void the moment first-person mode lets you look around
## freely, which fights UI_UX.md §3's "a real factory you could walk into,"
## not a factory floating in nothing. A soft, bright, sun-disk-free sky (see
## sun_angle_max below) keeps the "no distracting streak" property that
## motivated the original choice, while actually looking like somewhere.
func _build_environment() -> void:
	var sky_material := ProceduralSkyMaterial.new()
	# A brighter, friendlier daytime sky than the original — still a
	# believable overcast-ish industrial-zone sky (UI_UX.md §3's "grounded,
	# not cartoonish"), just not dim enough to read as night or a void.
	sky_material.sky_top_color = Color(0.42, 0.55, 0.72)
	sky_material.sky_horizon_color = Color(0.78, 0.81, 0.83)
	sky_material.ground_horizon_color = Color(0.42, 0.40, 0.37)
	sky_material.ground_bottom_color = Color(0.24, 0.23, 0.21)
	# Still no sun disk: the default draws a wide soft halo that the glow pass
	# smears into a distracting beam. Brightness now comes from the sky
	# colours and the key light below, not a visible sun.
	sky_material.sun_angle_max = 0.0
	var sky := Sky.new()
	sky.sky_material = sky_material

	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	# Sky-derived ambient is what fills the shadowed sides of a voxel model;
	# without it, unlit faces read as flat black and the medium looks cheap.
	# Raised from the original 0.55 alongside the brighter sky above.
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.8

	env.ssao_enabled = true
	env.ssao_radius = 0.9
	env.ssao_intensity = 2.4
	env.ssao_power = 1.6

	env.glow_enabled = true
	env.glow_intensity = 0.7
	env.glow_bloom = 0.15
	env.glow_hdr_threshold = 0.85
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SOFTLIGHT

	env.tonemap_mode = Environment.TONE_MAPPER_ACES
	env.tonemap_white = 6.0
	# Raised from 0.92 to match the brighter sky/ambient — ACES still rolls
	# off highlights safely, so this doesn't blow out the metal specular.
	env.tonemap_exposure = 1.05
	# Deliberately no depth fog: it was tried, and at this camera distance it
	# flattened the whole factory into one haze-grey value and cost more
	# contrast than the atmosphere was worth.

	var world_env := WorldEnvironment.new()
	world_env.name = "Environment"
	world_env.environment = env
	add_child(world_env)

	# Key light: warm, shadow-casting, angled so machinery casts shadows
	# across the belt line rather than straight down it.
	var sun := DirectionalLight3D.new()
	sun.name = "KeyLight"
	sun.rotation_degrees = Vector3(-52.0, -130.0, 0.0)
	sun.light_color = Color(1.0, 0.95, 0.88)
	sun.light_energy = 1.6
	sun.shadow_enabled = true
	sun.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_4_SPLITS
	sun.directional_shadow_max_distance = 160.0
	sun.shadow_blur = 1.4
	# A non-zero angular size is what actually softens the shadow edge with
	# distance, rather than just blurring the whole map uniformly.
	sun.light_angular_distance = 0.6
	add_child(sun)

	# Cool fill from the opposite side, no shadows — keeps the shadowed faces
	# of stainless steel from going dead grey.
	var fill := DirectionalLight3D.new()
	fill.name = "FillLight"
	fill.rotation_degrees = Vector3(-28.0, 55.0, 0.0)
	fill.light_color = Color(0.72, 0.80, 1.0)
	fill.light_energy = 0.4
	fill.shadow_enabled = false
	add_child(fill)


# --------------------------------------------------------------------------
# HUD
# --------------------------------------------------------------------------

func _build_ui() -> void:
	var hud := CanvasLayer.new()
	hud.name = "HUD"
	add_child(hud)

	# A dark plate with a single hazard-yellow rule along the top. UI_UX.md
	# §5's real UI pass (clipboard/checklist widgets, voxel-rendered icon
	# slots) is its own piece of work; this is the minimum that keeps text
	# legible over a lit 3D scene, rather than pretending to be that pass.
	var style := StyleBoxFlat.new()
	style.bg_color = Color(0.06, 0.06, 0.07, 0.74)
	style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	style.border_width_top = 3
	style.set_content_margin_all(12.0)

	var panel := PanelContainer.new()
	panel.add_theme_stylebox_override("panel", style)
	panel.position = Vector2(16, 16)
	hud.add_child(panel)

	var rows := VBoxContainer.new()
	rows.add_theme_constant_override("separation", 4)
	panel.add_child(rows)

	var settings := LabelSettings.new()
	settings.font_size = 15
	settings.font_color = Color(0.92, 0.93, 0.94)
	settings.outline_size = 4
	settings.outline_color = Color(0, 0, 0, 0.85)

	_help_label = Label.new()
	_help_label.label_settings = settings
	_help_label.text = ISO_HELP_TEXT
	rows.add_child(_help_label)

	# UI_UX.md §5: "a contract IS a clipboard." The money/contract readout
	# used to be a plain Label folded into the panel above (milestone 5); it
	# now gets its own diegetic clipboard panel — paper background, a steel
	# clip bar, checkbox-style tick marks for delivery progress.
	_build_contract_panel(hud, settings)

	# UI_UX.md §5's other named widget: "build/recipe menus as grids of
	# voxel-rendered icon slots." Hidden until B is pressed.
	_build_shop_menu(hud, settings)

	# The hover tooltip (docs/UI_UX.md §5): replaces the always-on per-machine
	# text this panel used to show — see _build_hover_tooltip/
	# _update_hover_tooltip below.
	_build_hover_tooltip(hud)
	_build_crosshair(hud)


## The diegetic clipboard/checklist widget (UI_UX.md §5) — the money/contract
## readout as "a paper texture on a metal clipboard clip" rather than a plain
## Label. Deliberately its own PanelContainer, sibling to (not nested inside)
## the generic HUD panel above, so this stays intact regardless of what other
## panels come and go there.
##
## LAYOUT DECISION (contracts-as-data, ticket 2). `economy_snapshot_json`
## reports an ARRAY of contracts, so this is a board of dockets, not a
## clipboard per contract: one sheet of paper under one steel clip, carrying
## the SHARED money figure and the SHARED dock stock once at the top, then one
## printed docket card per contract stacked below. Both alternatives were
## considered and rejected — a separate PanelContainer per contract repeats
## the 12px clip bar and the paper frame three times over for no new
## information, and a single flat list of checklist rows loses which rows
## belong to which order the moment two contracts want the same item (all
## three shipped contracts want `boxed_ketchup`). A docket is a slightly
## darker paper tone with a steel hairline — the same two colours the panel
## and its checkboxes already use, so this adds separation without adding a
## visual language.
func _build_contract_panel(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	# Paper cream background + a thick steel-toned top border standing in for
	# "the clip" — the same technique the panel above already uses for its
	# hazard-yellow accent rule, just recoloured and thickened. UI_UX.md §5
	# only asks for "even just a contrasting-coloured strip along one edge,"
	# so nothing fancier (a drawn clasp, a texture) is warranted yet.
	var paper_style := StyleBoxFlat.new()
	paper_style.bg_color = Color(0.87, 0.81, 0.64, 0.98) # warm off-white paper
	paper_style.border_color = Color(0.27, 0.29, 0.32, 1.0) # steel-grey frame/clip
	paper_style.border_width_left = 3
	paper_style.border_width_right = 3
	paper_style.border_width_bottom = 3
	paper_style.border_width_top = 12 # the clip bar
	paper_style.set_content_margin_all(12.0)
	paper_style.content_margin_top = 18.0 # clearance under the thicker clip bar

	_contract_panel = PanelContainer.new()
	_contract_panel.name = "ContractPanel"
	_contract_panel.add_theme_stylebox_override("panel", paper_style)
	hud.add_child(_contract_panel)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", 6)
	_contract_panel.add_child(body)

	# Dark ink on paper, not the pale-text-with-black-outline style the panel
	# above uses — that styling exists specifically to stay legible over a
	# lit 3D scene, which doesn't apply once text sits on an opaque paper
	# panel. Font family and size are still the ones already established in
	# _build_ui() (UI_UX.md §5's own "sturdy, slightly blocky" typography
	# call), only colour/outline change for the paper background.
	_contract_ink_settings = LabelSettings.new()
	_contract_ink_settings.font_size = base_settings.font_size
	_contract_ink_settings.font_color = Color(0.16, 0.13, 0.08)
	_contract_ink_settings.outline_size = 0

	# A small type-scale hierarchy on the clipboard, added during the visual-
	# overhaul pass: the title and the money figure used to share the exact
	# body text size, so nothing on the panel told the eye what mattered most
	# — a real UI_UX.md §5 polish gap ("typography/readability issues"), not
	# just an aesthetic nicety. Same ink colour and family throughout, only
	# size steps up, so it still reads as one consistent clipboard rather
	# than mixed styles. With several dockets on the board the hierarchy has
	# one more rung: a contract's NAME is the heading of its own docket, and
	# its cadence/tally line is deliberately the smallest thing on the panel.
	var title_settings := LabelSettings.new()
	title_settings.font_size = base_settings.font_size + 2
	title_settings.font_color = _contract_ink_settings.font_color
	title_settings.outline_size = 0

	var money_settings := LabelSettings.new()
	money_settings.font_size = base_settings.font_size + 6
	money_settings.font_color = _contract_ink_settings.font_color
	money_settings.outline_size = 0

	_contract_name_settings = LabelSettings.new()
	_contract_name_settings.font_size = base_settings.font_size + 1
	_contract_name_settings.font_color = _contract_ink_settings.font_color
	_contract_name_settings.outline_size = 0

	# The tick mark gets its own settings, not the body ink's. At body size a
	# "✓" overflows a 14px checkbox and renders as a clipped diagonal in the
	# corner (visible only in a real screenshot — the headless test happily
	# reports a visible Mark node either way), and dark ink on the checked
	# green is the panel's weakest contrast anywhere. Small and paper-pale
	# fixes both.
	_checkbox_mark_settings = LabelSettings.new()
	_checkbox_mark_settings.font_size = max(8, base_settings.font_size - 4)
	_checkbox_mark_settings.font_color = Color(0.91, 0.88, 0.78)
	_checkbox_mark_settings.outline_size = 0

	_contract_meta_settings = LabelSettings.new()
	_contract_meta_settings.font_size = max(9, base_settings.font_size - 2)
	# A touch lighter than body ink — still well clear of the paper, but the
	# cadence/tally line should read as a footnote on the docket, not as
	# another checklist item.
	_contract_meta_settings.font_color = Color(0.34, 0.29, 0.20)
	_contract_meta_settings.outline_size = 0

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "CONTRACTS"
	body.add_child(title)

	# Money is shown ONCE, here, and never per docket: GAMEPLAY.md §1 allows
	# exactly one currency, and sim_core keeps exactly one counter for it.
	_contract_money_label = Label.new()
	_contract_money_label.label_settings = money_settings
	body.add_child(_contract_money_label)

	# The shared delivery pool, also once. See _update_contract_dock for why
	# this line exists at all.
	_contract_dock_row = HBoxContainer.new()
	_contract_dock_row.name = "DockRow"
	_contract_dock_row.add_theme_constant_override("separation", 6)
	body.add_child(_contract_dock_row)

	var dock_title := Label.new()
	dock_title.label_settings = _contract_meta_settings
	dock_title.text = "ON THE DOCK"
	_contract_dock_row.add_child(dock_title)

	_contract_dock_empty_label = Label.new()
	_contract_dock_empty_label.label_settings = _contract_meta_settings
	_contract_dock_empty_label.text = "empty"
	_contract_dock_row.add_child(_contract_dock_empty_label)

	_checkbox_style_unchecked = StyleBoxFlat.new()
	_checkbox_style_unchecked.bg_color = Color(0.80, 0.74, 0.57, 1.0) # a shade darker than the paper
	_checkbox_style_unchecked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_unchecked.set_border_width_all(2)

	_checkbox_style_checked = StyleBoxFlat.new()
	_checkbox_style_checked.bg_color = Color(0.24, 0.42, 0.24, 1.0) # a muted, saturated "done" green —
	# UI_UX.md §7: saturated colour reserved for meaning, and a completed
	# checklist item is exactly that meaning, not decoration.
	_checkbox_style_checked.border_color = Color(0.27, 0.29, 0.32, 1.0)
	_checkbox_style_checked.set_border_width_all(2)

	# One docket = the checkbox's own paper tone plus a steel hairline. Reusing
	# those two existing colours is the point (see this function's header):
	# separation without a third palette.
	_contract_card_style = StyleBoxFlat.new()
	_contract_card_style.bg_color = Color(0.83, 0.77, 0.60, 1.0)
	_contract_card_style.border_color = Color(0.47, 0.44, 0.38, 1.0)
	_contract_card_style.set_border_width_all(1)
	_contract_card_style.set_content_margin_all(8.0)

	# The dockets live in a ScrollContainer whose height is capped in
	# _update_contract_panel — a safety valve for a future contracts.ron with
	# more orders than fit, not a UI the player is expected to drive today.
	_contract_cards_scroll = ScrollContainer.new()
	_contract_cards_scroll.name = "ContractList"
	_contract_cards_scroll.horizontal_scroll_mode = ScrollContainer.SCROLL_MODE_DISABLED
	_contract_cards_scroll.vertical_scroll_mode = ScrollContainer.SCROLL_MODE_AUTO
	body.add_child(_contract_cards_scroll)

	_contract_cards_box = VBoxContainer.new()
	_contract_cards_box.name = "ContractCards"
	_contract_cards_box.add_theme_constant_override("separation", 8)
	_contract_cards_box.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	_contract_cards_scroll.add_child(_contract_cards_box)

	# One docket per active contract, read live from economy_snapshot_json
	# rather than assumed — nothing here hardcodes how many contracts exist,
	# what they ask for, or what they pay.
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_rebuild_contract_cards(econ.get("contracts", []))

	# Anchored to the top-right corner with a fixed margin, sized to its own
	# content — independent of however tall the machine-line panel ends up
	# being.
	_contract_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE, 16)


## Rebuilds the docket stack from a `contracts` array. Called once at build
## time and again only if the SET of contract ids changes — the shipped world
## loads its contracts once and never adds or drops one, but a future
## "contract accepted / contract lost" mechanic (GAMEPLAY.md §11's open
## question about what a missed window costs) would, and the guard costs a
## string compare per frame.
func _rebuild_contract_cards(contracts: Array) -> void:
	for card in _contract_cards:
		# Detach FIRST, then queue_free: queue_free is deferred to the end of
		# the frame, so freeing alone would leave the old dockets in the
		# container alongside the new ones for a frame. Detach from whatever
		# the panel's parent actually IS rather than from the current card
		# box — a scene re-entering the tree runs _ready (and so
		# _build_contract_panel) a second time, at which point these records
		# still point at the previous build's container.
		var panel: Node = card["panel"]
		if is_instance_valid(panel):
			if panel.get_parent() != null:
				panel.get_parent().remove_child(panel)
			panel.queue_free()
	_contract_cards.clear()
	_contract_card_ids.clear()
	for contract in contracts:
		_contract_cards.append(_build_contract_card(contract))
		_contract_card_ids.append(String(contract.get("id", "")))


## One contract's docket: its name and payout on a header row, a checklist row
## per line of its mix, and its OWN cadence/tally footnote. Every contract
## clocks independently in sim_core, so this countdown is per docket and is
## never shared the way money is.
##
## Returns the record `_update_contract_panel` drives it through:
##   {"id", "panel", "name_label", "payout_label", "meta_label",
##    "rows": {item id -> {"icon", "label", "boxes"}}}
func _build_contract_card(contract: Dictionary) -> Dictionary:
	var panel := PanelContainer.new()
	panel.name = "ContractCard_%s" % String(contract.get("id", "?"))
	panel.add_theme_stylebox_override("panel", _contract_card_style)
	_contract_cards_box.add_child(panel)

	var card_body := VBoxContainer.new()
	card_body.add_theme_constant_override("separation", 4)
	panel.add_child(card_body)

	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", 10)
	card_body.add_child(header)

	var name_label := Label.new()
	name_label.label_settings = _contract_name_settings
	name_label.text = String(contract.get("name", contract.get("id", "?")))
	name_label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	header.add_child(name_label)

	# What this order is worth per delivery. It is the whole reason a player
	# chooses which docket to feed when the line can't serve them all
	# (GAMEPLAY.md §6), so it belongs on the docket, not in a tooltip.
	var payout_label := Label.new()
	payout_label.label_settings = _contract_name_settings
	payout_label.text = "+%d" % int(contract.get("payout", 0))
	payout_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_RIGHT
	header.add_child(payout_label)

	var rows: Dictionary = {}
	for pair in contract.get("mix", []):
		var item_id: String = String(pair[0])
		var required: int = int(pair[1])
		rows[item_id] = _build_contract_checklist_row(card_body, item_id, required)

	var meta_label := Label.new()
	meta_label.label_settings = _contract_meta_settings
	card_body.add_child(meta_label)

	return {
		"id": String(contract.get("id", "")),
		"panel": panel,
		"name_label": name_label,
		"payout_label": payout_label,
		"meta_label": meta_label,
		"rows": rows,
	}


## One checklist row: the item's numeric progress text, plus a row of small
## checkbox squares — one per required unit, per UI_UX.md §5's "checkbox-
## style tick marks for completed items." A contract asking for a very large
## quantity would make a per-unit row unreadably wide, so past
## CONTRACT_CHECKLIST_MAX_BOXES this falls back to a single box standing for
## "fully delivered" — the minimum the original ticket calls acceptable.
##
## Returns `{"icon", "label", "boxes"}` for its docket's record: the nodes are
## no longer stashed in a panel-wide dictionary keyed by item id, because
## several contracts legitimately ask for the SAME item (every contract in the
## shipped `data/contracts.ron` wants `boxed_ketchup`) and one such dictionary
## would have them silently overwrite each other's rows.
func _build_contract_checklist_row(body: VBoxContainer, item_id: String, required: int) -> Dictionary:
	# Icon + text share a row: UI_UX.md §5's "icons are rendered from the
	# real assets" (_icon_for) applied to the one place this panel names a
	# specific item.
	var header := HBoxContainer.new()
	header.add_theme_constant_override("separation", 6)
	body.add_child(header)

	var icon := TextureRect.new()
	icon.custom_minimum_size = Vector2(16, 16)
	# Without this, TextureRect's own minimum size defaults to the source
	# texture's actual size (64x64) and wins over custom_minimum_size above —
	# EXPAND_IGNORE_SIZE is what makes the 16x16 slot actually stick.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	header.add_child(icon)

	var progress_label := Label.new()
	progress_label.label_settings = _contract_ink_settings
	header.add_child(progress_label)

	var checklist := HBoxContainer.new()
	checklist.add_theme_constant_override("separation", 4)
	body.add_child(checklist)

	var box_count: int = required if required <= CONTRACT_CHECKLIST_MAX_BOXES else 1
	var boxes: Array = []
	for i in range(box_count):
		var box := Panel.new()
		box.name = "checkbox_%s_%d" % [item_id, i]
		box.custom_minimum_size = Vector2(14, 14)
		box.add_theme_stylebox_override("panel", _checkbox_style_unchecked)
		box.set_meta("checked", false)

		var mark := Label.new()
		mark.name = "Mark"
		mark.text = "✓"
		mark.label_settings = _checkbox_mark_settings
		mark.visible = false
		mark.set_anchors_preset(Control.PRESET_FULL_RECT)
		mark.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		mark.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		box.add_child(mark)

		checklist.add_child(box)
		boxes.append(box)
	return {"icon": icon, "label": progress_label, "boxes": boxes}


# --------------------------------------------------------------------------
# The build menu (UI_UX.md §5, the "Shop & Inventory" epic's ticket 2)
# --------------------------------------------------------------------------

## The player's first real agency: a grid of voxel-rendered icon slots, one
## per `data/shop.ron` entry, that spends contract money on equipment.
##
## Everything on it comes from `shop_snapshot_json` — kinds, order, unit
## prices, owned counts and affordability — so adding a kind to
## `data/shop.ron` puts a slot here with no Godot edit, exactly the way
## adding a recipe already extends the chain. Ticket 1's snapshot is polled
## rather than pushed, per its own doc: a purchase changes money and a count,
## never a tile, so `dirty_chunk_ids()` will never report one.
##
## Visual language is the scene's DARK PLATE, not the contract clipboard's
## paper — the same near-black panel with a hazard-yellow rule the HUD strip
## and the hover tooltip already use. The clipboard motif is for orders and
## checklists (UI_UX.md §5 says so explicitly); a build menu is machine-side
## factory UI, and it also has to stay legible while floating over a lit 3D
## scene, which is exactly what that dark plate exists for.
func _build_shop_menu(hud: CanvasLayer, base_settings: LabelSettings) -> void:
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.06, 0.06, 0.07, 0.94)
	panel_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	panel_style.border_width_top = 4
	panel_style.border_width_left = 2
	panel_style.border_width_right = 2
	panel_style.border_width_bottom = 2
	panel_style.set_content_margin_all(16.0)

	_shop_menu = PanelContainer.new()
	_shop_menu.name = "ShopMenu"
	_shop_menu.add_theme_stylebox_override("panel", panel_style)
	_shop_menu.visible = false
	hud.add_child(_shop_menu)

	var body := VBoxContainer.new()
	body.add_theme_constant_override("separation", 10)
	_shop_menu.add_child(body)

	var title_settings := LabelSettings.new()
	title_settings.font_size = base_settings.font_size + 4
	title_settings.font_color = base_settings.font_color
	title_settings.outline_size = base_settings.outline_size
	title_settings.outline_color = base_settings.outline_color

	var title := Label.new()
	title.label_settings = title_settings
	title.text = "BUILD MENU"
	body.add_child(title)

	# Money is repeated here rather than left to the contract clipboard in
	# the opposite screen corner. The decision a player makes in this menu is
	# "can I afford that", and making them look across the screen to answer it
	# is exactly the readability problem UI_UX.md §5 is about. It is the same
	# number from the same snapshot — `shop_snapshot_json` carries `money`
	# precisely so a build menu is one call — not a second counter.
	var money_settings := LabelSettings.new()
	money_settings.font_size = base_settings.font_size + 6
	money_settings.font_color = Color(0.98, 0.85, 0.42) # the panel's own hazard accent
	money_settings.outline_size = base_settings.outline_size
	money_settings.outline_color = base_settings.outline_color

	_shop_money_label = Label.new()
	_shop_money_label.label_settings = money_settings
	body.add_child(_shop_money_label)

	var grid := GridContainer.new()
	grid.name = "ShopGrid"
	grid.columns = SHOP_SLOT_COLUMNS
	grid.add_theme_constant_override("h_separation", 8)
	grid.add_theme_constant_override("v_separation", 8)
	body.add_child(grid)

	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	for index in range(entries.size()):
		_build_shop_slot(grid, base_settings, index, String(entries[index]["kind"]))

	var footer := Label.new()
	footer.label_settings = base_settings
	footer.text = "click a slot (or press its number) to buy one    B: close"
	body.add_child(footer)

	_shop_menu.set_anchors_and_offsets_preset(Control.PRESET_CENTER, Control.PRESET_MODE_MINSIZE)


## One icon slot. A Button rather than a Panel so pressing it is the whole
## interaction — no selection cursor, no confirm step, no second mode to
## explain; this is the project's first interactive menu and the simplest
## thing that works is the right thing. Its label children ignore the mouse
## so the entire square stays one click target.
func _build_shop_slot(grid: GridContainer, base_settings: LabelSettings, index: int, kind: String) -> void:
	var button := Button.new()
	button.name = "ShopSlot_%s" % kind
	button.custom_minimum_size = SHOP_SLOT_SIZE
	button.focus_mode = Control.FOCUS_NONE
	for state in ["normal", "hover", "pressed", "disabled", "focus"]:
		button.add_theme_stylebox_override(state, _shop_slot_style(state))
	button.pressed.connect(_on_shop_slot_pressed.bind(index))
	grid.add_child(button)

	# Anchored over the button rather than parented through a container: a
	# Button lays its own (text) content out and is not a container, so its
	# children have to place themselves.
	var column := VBoxContainer.new()
	column.mouse_filter = Control.MOUSE_FILTER_IGNORE
	column.add_theme_constant_override("separation", 2)
	column.set_anchors_preset(Control.PRESET_FULL_RECT)
	column.offset_left = 8
	column.offset_right = -8
	column.offset_top = 8
	column.offset_bottom = -8
	button.add_child(column)

	# The hotkey corner. Slots past SHOP_HOTKEY_SLOTS simply show nothing
	# here and stay click-only, rather than inventing a second key scheme.
	var hotkey_settings := LabelSettings.new()
	hotkey_settings.font_size = base_settings.font_size - 3
	hotkey_settings.font_color = Color(0.62, 0.64, 0.68)
	hotkey_settings.outline_size = base_settings.outline_size
	hotkey_settings.outline_color = base_settings.outline_color

	var hotkey := Label.new()
	hotkey.name = "Hotkey"
	hotkey.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hotkey.label_settings = hotkey_settings
	hotkey.text = str(index + 1) if index < SHOP_HOTKEY_SLOTS else ""
	column.add_child(hotkey)

	var icon := TextureRect.new()
	icon.name = "Icon"
	icon.mouse_filter = Control.MOUSE_FILTER_IGNORE
	icon.custom_minimum_size = SHOP_ICON_SIZE
	# Same reason _build_contract_checklist_row gives: without
	# EXPAND_IGNORE_SIZE a TextureRect's minimum size is the source PNG's own
	# 64x64, which would win over custom_minimum_size above.
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for_asset(_shop_asset_for(kind))
	column.add_child(icon)

	var name_label := Label.new()
	name_label.name = "KindName"
	name_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	name_label.label_settings = base_settings
	name_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	name_label.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	name_label.text = _kind_display_name(kind)
	column.add_child(name_label)

	var price_settings := LabelSettings.new()
	price_settings.font_size = base_settings.font_size
	price_settings.font_color = base_settings.font_color
	price_settings.outline_size = base_settings.outline_size
	price_settings.outline_color = base_settings.outline_color

	var price_label := Label.new()
	price_label.name = "Price"
	price_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	price_label.label_settings = price_settings
	price_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	column.add_child(price_label)

	var owned_settings := LabelSettings.new()
	owned_settings.font_size = base_settings.font_size - 2
	owned_settings.font_color = Color(0.66, 0.68, 0.72)
	owned_settings.outline_size = base_settings.outline_size
	owned_settings.outline_color = base_settings.outline_color

	var owned_label := Label.new()
	owned_label.name = "Owned"
	owned_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	owned_label.label_settings = owned_settings
	owned_label.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	column.add_child(owned_label)

	_shop_slots.append({
		"kind": kind,
		"button": button,
		"icon": icon,
		"price_label": price_label,
		"owned_label": owned_label,
	})


## Flat-shaded slot squares with chunky borders — UI_UX.md §5's Minecraft
## adjacency, and deliberately the same near-black/hazard-yellow pair the
## rest of the HUD already uses rather than a third palette.
func _shop_slot_style(state: String) -> StyleBoxFlat:
	var style := StyleBoxFlat.new()
	style.set_border_width_all(3)
	style.set_content_margin_all(6.0)
	match state:
		"hover", "focus":
			style.bg_color = Color(0.19, 0.19, 0.21, 0.98)
			style.border_color = Color(0.85, 0.63, 0.11, 0.95)
		"pressed":
			style.bg_color = Color(0.30, 0.24, 0.08, 0.98)
			style.border_color = Color(0.98, 0.80, 0.22, 1.0)
		"disabled":
			# Visibly recessed and dim: an unaffordable slot reads as "off"
			# from its border and background as well as its greyed icon and
			# its price glyph, never from colour alone (UI_UX.md §7).
			style.bg_color = Color(0.08, 0.08, 0.09, 0.92)
			style.border_color = Color(0.20, 0.21, 0.23, 0.95)
		_:
			style.bg_color = Color(0.13, 0.14, 0.16, 0.96)
			style.border_color = Color(0.36, 0.38, 0.42, 0.95)
	return style


## Which asset's icon stands for a buildable kind — see SHOP_MODELS.
func _shop_asset_for(kind: String) -> String:
	if SHOP_MODELS.has(kind):
		return SHOP_MODELS[kind]
	return MACHINE_MODELS.get(kind, MACHINE_MODEL_FALLBACK)


## "cooking_vat" -> "Cooking Vat". Kind ids are content, so the menu titles
## itself from them rather than carrying a hand-written label per kind that
## a new `data/shop.ron` entry would silently miss.
func _kind_display_name(kind: String) -> String:
	var words: PackedStringArray = kind.split("_", false)
	var out: Array[String] = []
	for word in words:
		out.append(word.capitalize())
	return " ".join(out)


## Repolls `shop_snapshot_json` and redraws every slot. Called each frame
## while the menu is open and once on opening — cheap (one JSON parse of a
## nine-entry object) and it means money earned by the running factory makes
## a slot become affordable under the player's eyes.
func _update_shop_menu() -> void:
	if _shop_menu == null:
		return
	var snapshot: Dictionary = JSON.parse_string(sim.shop_snapshot_json())
	var entries: Array = snapshot.get("entries", [])
	_shop_money_label.text = "Money: %.0f" % float(snapshot.get("money", 0.0))

	for index in range(_shop_slots.size()):
		if index >= entries.size():
			break
		var slot: Dictionary = _shop_slots[index]
		var entry: Dictionary = entries[index]
		var affordable: bool = bool(entry.get("affordable", false))
		var price: float = float(entry.get("price", 0.0))

		# Three independent signals for "you can't afford this", per
		# UI_UX.md §7's never-colour-alone rule: the price gains a "✗" mark,
		# the icon dims, and the whole slot is disabled (which also recolours
		# its border/background via the disabled stylebox).
		slot["price_label"].text = ("Cost %.0f" % price) if affordable else ("Cost %.0f  ✗" % price)
		slot["price_label"].label_settings.font_color = (
			Color(0.92, 0.93, 0.94) if affordable else Color(0.55, 0.50, 0.48)
		)
		slot["icon"].modulate = Color.WHITE if affordable else Color(0.42, 0.42, 0.45, 0.75)
		slot["button"].disabled = not affordable
		slot["owned_label"].text = "Owned %d" % int(entry.get("owned", 0))


func _on_shop_slot_pressed(index: int) -> void:
	_buy_slot(index)


## Buys exactly one of the slot's kind. Quantity is deliberately fixed at
## one — `PlayerCommand::Purchase`'s own wire default — so a click means one
## thing and the menu needs no quantity widget. An unaffordable or unknown
## purchase is a silent no-op in the simulation, so the only thing this has
## to do afterwards is re-read the snapshot either way.
func _buy_slot(index: int) -> void:
	if index < 0 or index >= _shop_slots.size():
		return
	var kind: String = _shop_slots[index]["kind"]
	sim.issue_command_json(JSON.stringify({"type": "purchase", "kind": kind}))
	_update_shop_menu()


func _set_shop_menu_open(open: bool) -> void:
	if _shop_menu == null or open == _shop_open:
		return
	_shop_open = open
	_shop_menu.visible = open
	if open:
		_update_shop_menu()
	# The menu is clickable in first-person too, which means handing the
	# mouse back while it is up and recapturing it on close — otherwise the
	# only way to buy in that mode would be the number keys.
	if _view_mode == ViewMode.FIRST_PERSON:
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE if open else Input.MOUSE_MODE_CAPTURED
	_update_crosshair_visibility()


## The crosshair stands in for the cursor in first-person — so it belongs on
## screen in exactly the case where there is no real cursor. With the build
## menu up the mouse is handed back (above), and leaving the crosshair drawn
## would park a stray mark on top of a menu slot.
func _update_crosshair_visibility() -> void:
	if _crosshair == null:
		return
	_crosshair.visible = _view_mode == ViewMode.FIRST_PERSON and not _shop_open


func _toggle_shop_menu() -> void:
	_set_shop_menu_open(not _shop_open)


func _build_hover_tooltip(hud: CanvasLayer) -> void:
	# The hover tooltip (docs/UI_UX.md §5): a small, separately-positioned
	# panel that follows the cursor and shows one stage's recipe/progress/
	# input/output — the info the always-on panel used to show for every
	# stage at once, now on-demand only. A simple readable panel, not this
	# section's clipboard/checklist diegetic styling — that visual pass is
	# separate work; this just needs to be legible near the cursor.
	var hover_style := StyleBoxFlat.new()
	hover_style.bg_color = Color(0.10, 0.09, 0.06, 0.92)
	hover_style.border_color = Color(0.85, 0.63, 0.11, 0.95)
	hover_style.set_border_width_all(2)
	hover_style.set_content_margin_all(8.0)

	_hover_tooltip = PanelContainer.new()
	_hover_tooltip.add_theme_stylebox_override("panel", hover_style)
	_hover_tooltip.visible = false
	# Ignore mouse events itself, or the panel following the cursor would
	# constantly steal hover from whatever's under it (including, absurdly,
	# itself — every frame's "am I hovering a machine" check reads the raw
	# viewport mouse position, not anything mouse-event-driven, so this only
	# matters for a hypothetical future clickable HUD element underneath).
	_hover_tooltip.mouse_filter = Control.MOUSE_FILTER_IGNORE
	hud.add_child(_hover_tooltip)

	var hover_settings := LabelSettings.new()
	hover_settings.font_size = 14
	hover_settings.font_color = Color(0.95, 0.95, 0.90)
	hover_settings.outline_size = 3
	hover_settings.outline_color = Color(0, 0, 0, 0.85)

	_hover_label = Label.new()
	_hover_label.label_settings = hover_settings
	_hover_label.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_hover_tooltip.add_child(_hover_label)


## A small screen-centre crosshair, shown only in FIRST_PERSON (toggled in
## _set_view_mode) — the mouse is captured/hidden there, so it's the only
## way to see what "looking at" a machine even means, and it's what
## _update_hover_tooltip queries against instead of a live cursor position.
## Two thin bars rather than a Label glyph, so it stays crisp at any size
## without depending on a font having a suitable character.
func _build_crosshair(hud: CanvasLayer) -> void:
	_crosshair = Control.new()
	_crosshair.mouse_filter = Control.MOUSE_FILTER_IGNORE
	_crosshair.visible = false
	_crosshair.set_anchors_preset(Control.PRESET_FULL_RECT)
	hud.add_child(_crosshair)

	var bar_color := Color(0.95, 0.95, 0.90, 0.85)
	var h_bar := ColorRect.new()
	h_bar.color = bar_color
	h_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	h_bar.size = Vector2(CROSSHAIR_SIZE, CROSSHAIR_THICKNESS)
	h_bar.set_anchors_preset(Control.PRESET_CENTER)
	h_bar.position = -h_bar.size / 2.0
	_crosshair.add_child(h_bar)

	var v_bar := ColorRect.new()
	v_bar.color = bar_color
	v_bar.mouse_filter = Control.MOUSE_FILTER_IGNORE
	v_bar.size = Vector2(CROSSHAIR_THICKNESS, CROSSHAIR_SIZE)
	v_bar.set_anchors_preset(Control.PRESET_CENTER)
	v_bar.position = -v_bar.size / 2.0
	_crosshair.add_child(v_bar)


# --------------------------------------------------------------------------
# Simulation driving / rendering
# --------------------------------------------------------------------------

func _process(delta: float) -> void:
	_tick_accum += delta
	var tick_interval := 1.0 / TICK_HZ
	var budget := MAX_TICKS_PER_FRAME
	while _tick_accum >= tick_interval and budget > 0:
		_tick_accum -= tick_interval
		budget -= 1
		sim.tick()
		_apply_dirty_chunks()
	if _tick_accum >= tick_interval:
		# Backlog beyond the budget is discarded, not carried (see
		# MAX_TICKS_PER_FRAME): carrying it would only move the burst to the
		# next frame.
		_tick_accum = 0.0

	_update_contract_panel()
	if _shop_open:
		# Only while it's up: money the running factory earns should make a
		# slot go from unaffordable to affordable while the player watches.
		_update_shop_menu()
	_update_fluid_network()
	_update_hopper()
	_update_fluid_tank()
	_update_dock()
	_update_machine_gauges()
	_update_hover_tooltip()
	if _view_mode == ViewMode.ISOMETRIC:
		_pan_camera(delta)
	else:
		_fp_camera_move(delta)


func _unhandled_input(event: InputEvent) -> void:
	# TAB always toggles view mode, in either mode.
	if event is InputEventKey and event.pressed and not event.echo and event.keycode == KEY_TAB:
		_set_view_mode(ViewMode.FIRST_PERSON if _view_mode == ViewMode.ISOMETRIC else ViewMode.ISOMETRIC)
		return

	if event is InputEventMouseButton:
		# Right-drag panning (isometric only) — right button, not left, so a
		# future click-to-build/select on the left button has nothing to
		# fight with.
		if event.button_index == MOUSE_BUTTON_RIGHT and _view_mode == ViewMode.ISOMETRIC:
			_iso_dragging = event.pressed
			return
		if event.pressed and _view_mode == ViewMode.ISOMETRIC:
			if event.button_index == MOUSE_BUTTON_WHEEL_UP:
				_zoom_camera(1.0 - ZOOM_STEP)
			elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN:
				_zoom_camera(1.0 + ZOOM_STEP)
		return

	# A real mouse's wheel arrives as InputEventMouseButton (above). A macOS
	# trackpad's two-finger scroll does NOT — it arrives as a continuous
	# InputEventPanGesture instead, which is why scroll-to-zoom didn't work
	# on trackpads until this was added. Scale by the gesture's own delta
	# magnitude (it's continuous, not discrete notches like a wheel click),
	# not a fixed step, so a fast swipe zooms faster than a slow one.
	if event is InputEventPanGesture:
		if _view_mode == ViewMode.ISOMETRIC and event.delta.y != 0.0:
			_zoom_camera(1.0 + event.delta.y * TRACKPAD_ZOOM_SENSITIVITY)
		return

	if event is InputEventMouseMotion:
		if _view_mode == ViewMode.ISOMETRIC:
			if _iso_dragging:
				_apply_drag_pan(event.relative)
		elif not _shop_open:
			# With the build menu up in first-person the mouse is visible and
			# is being used to click slots — swinging the camera with it too
			# would make the menu unusable.
			_apply_look(event.relative)
		return

	if not (event is InputEventKey and event.pressed and not event.echo):
		return

	# B opens and closes the build menu (the "Shop & Inventory" epic's ticket
	# 2). Handled in BOTH view modes, like V and unlike SPACE: it collides
	# with nothing in either, and buying equipment is not something the
	# player should have to leave first-person to do.
	if event.keycode == KEY_B:
		_toggle_shop_menu()
		return

	# While the menu is up, the number keys buy the slot they label — the
	# keyboard half of the interaction, and the only half available in
	# first-person if the player would rather not free the mouse. They do
	# nothing at all when the menu is closed, so this reserves no key from
	# whatever a later epic wants a hotbar to do.
	if _shop_open and event.keycode >= KEY_1 and event.keycode <= KEY_9:
		_buy_slot(event.keycode - KEY_1)
		return

	if _view_mode == ViewMode.ISOMETRIC:
		if event.keycode == KEY_EQUAL or event.keycode == KEY_KP_ADD:
			_zoom_camera(1.0 - ZOOM_STEP)
			return
		if event.keycode == KEY_MINUS or event.keycode == KEY_KP_SUBTRACT:
			_zoom_camera(1.0 + ZOOM_STEP)
			return

	var command := ""
	# SPACE only loads the hopper in ISOMETRIC mode — in FIRST_PERSON it's
	# "fly up" (_fp_input_direction), and a single keypress can't mean both.
	# Since the "Machines improvement" ticket 3 this loads raw tomatoes into
	# the chain's hopper (clamped at its capacity); the hopper itself meters
	# them onto the first belt, one per tick — so this key sets the SUPPLY
	# and the machinery sets the rate. The level it changes is visible in
	# the hopper itself (see _update_hopper) and in its hover tooltip.
	if event.keycode == KEY_SPACE and _view_mode == ViewMode.ISOMETRIC:
		command = JSON.stringify({"type": "fill_hopper"})
	# V is the fluid twin of SPACE (the "Visual overhaul round 2" epic).
	# Ticket 1 replaced the pipe run's always-full off-map tap with a tank the
	# player loads — but it added no way to load it, so the shipped scene had
	# no vinegar at all and the chain silently stalled at the mixer with the
	# belts past it running empty. Unlike SPACE this works in BOTH view modes,
	# because unlike SPACE it collides with nothing (SPACE is "fly up" in
	# first person).
	elif event.keycode == KEY_V:
		command = JSON.stringify({"type": "fill_fluid_tank"})
	else:
		return

	sim.issue_command_json(command)
	# Render immediately rather than waiting for the next scheduled tick —
	# issue_command's dirty marking isn't cleared until tick() runs next,
	# so this is safe to read right away.
	_apply_dirty_chunks()


func _apply_dirty_chunks() -> void:
	var dirty: PackedInt64Array = sim.dirty_chunk_ids()
	for chunk_id in dirty:
		var parsed = JSON.parse_string(sim.chunk_snapshot_json(chunk_id))
		if parsed != null:
			_render_snapshot(parsed)


func _render_snapshot(snapshot: Dictionary) -> void:
	var seen := {}

	var belts: Array = snapshot.get("belts", [])
	for belt in belts:
		var start: Array = belt["start_tile"]
		var items: Array = belt["items"]
		for i in range(items.size()):
			var pair: Array = items[i]
			# Keyed by belt start tile so multiple stages' belts never
			# collide with each other's item nodes.
			var key := "belt_%d_%d_%d" % [int(start[0]), int(start[1]), i]
			seen[key] = true
			var node := _item_node_for(key, String(pair[0]))
			node.visible = true
			# `pair[1]` is the item's distance from the belt start in tiles;
			# the belt runs along +X, so it slides straight along that axis.
			node.position = Vector3(
				(float(start[0]) + float(pair[1])) * TILE,
				BELT_SURFACE_Y,
				float(start[1]) * TILE
			)

	for key in _item_nodes.keys():
		if not seen.has(key):
			_item_nodes[key]["node"].visible = false

	var machines: Array = snapshot.get("machines", [])
	for machine in machines:
		_last_machines[machine["recipe"]] = machine
		_set_machine_running(String(machine["recipe"]), machine.get("process") != null)


## Pooled per belt slot. If the slot's item type changes (it doesn't in the
## current straight chain, but nothing guarantees that) the old node is
## replaced rather than silently rendering the wrong product.
func _item_node_for(key: String, item_name: String) -> Node3D:
	var asset: String = ITEM_MODELS.get(item_name, ITEM_MODEL_FALLBACK)
	if _item_nodes.has(key):
		var existing: Dictionary = _item_nodes[key]
		if existing["asset"] == asset:
			return existing["node"]
		existing["node"].queue_free()
		_item_nodes.erase(key)

	var node := _asset_node(asset)
	node.name = "item_" + key
	add_child(node)
	_item_nodes[key] = {"node": node, "asset": asset}
	return node


## Sentinel returned by `_tile_under_screen_pos` when the camera ray never
## crosses the belt-surface plane in front of the camera — either it's
## (degenerately) parallel to it (not reachable in practice for the fixed
## isometric CAMERA_DIRECTION, but a real case once FIRST_PERSON's free-look
## camera can point the ray dead level), or it points away from the plane
## entirely (FIRST_PERSON looking up at the sky — the plane is still
## "behind" the ray in that case, so the naive intersection point would be
## a phantom tile no player could see). Callers get an explicit "no tile"
## value rather than a Vector2i(0, 0) that could also be a real tile.
const HOVER_NO_TILE := Vector2i(-999999, -999999)
## Screen-space offset from the raw cursor position to the tooltip panel's
## top-left corner, so the panel doesn't sit directly under (and get
## re-hidden by chasing) the cursor itself.
const HOVER_TOOLTIP_OFFSET := Vector2(18.0, 18.0)


## Resolves a screen-space position to the world tile beneath it: casts the
## camera's ray for that screen position (per its CURRENT transform/
## projection — `project_ray_origin`/`project_ray_normal` are pure and
## deterministic given that, not physics-engine-dependent) and intersects it
## with the horizontal plane at belt-surface height (BELT_SURFACE_Y).
## Machines sit directly on that plane at a known tile position (see
## _machine_tiles), so plane intersection alone is enough to pick one out —
## no physics engine involved, matching this project's zero physics
## dependency elsewhere (ARCHITECTURE.md's headless-testability philosophy).
##
## Pure and deterministic given the camera's current state — no Input/mouse
## reads happen here, so test_hover.gd can call it directly with an explicit
## screen position. This mirrors _apply_pan/_apply_look's split (see their
## doc comments): _update_hover_tooltip below is the thin, untested part that
## actually reads the live mouse position (ISOMETRIC) or the screen centre
## (FIRST_PERSON, where the crosshair sits — see _build_crosshair).
##
## Works for either camera projection — orthogonal (ISOMETRIC) or
## perspective (FIRST_PERSON) — since project_ray_origin/project_ray_normal
## already account for that. FIRST_PERSON's free-look does introduce a case
## ISOMETRIC's fixed downward angle never hits: the ray pointing away from
## the plane entirely (looking up at the sky), where a naive intersection
## would land "behind" the camera. `t < 0` catches that.
func _tile_under_screen_pos(screen_pos: Vector2) -> Vector2i:
	if _camera == null:
		return HOVER_NO_TILE
	var origin := _camera.project_ray_origin(screen_pos)
	var dir := _camera.project_ray_normal(screen_pos)
	if is_zero_approx(dir.y):
		return HOVER_NO_TILE
	var t := (BELT_SURFACE_Y - origin.y) / dir.y
	if t < 0.0:
		return HOVER_NO_TILE
	var point := origin + dir * t
	return Vector2i(roundi(point.x / TILE), roundi(point.z / TILE))


## Whichever stage's machine covers `tile`, or "" if none does.
##
## **Any** tile inside a machine's footprint answers, not just its origin —
## which is the whole point since the "Machines improvement" milestone made
## the cooking vat 2x2: hovering its far corner has to identify it, not fall
## through to bare floor. Both halves of the containment test come from the
## simulation (`_machine_tiles`/`_machine_footprints`, populated once in
## `_read_chain_layout` from `chain_layout_json`), so a kind that grows in
## data/machines.ron grows its hover target with no change here. Pure
## dictionary lookup — no Input/mouse reads, directly testable.
func _machine_recipe_at_tile(tile: Vector2i) -> String:
	for recipe_id in _machine_tiles.keys():
		var origin: Vector2i = _machine_tiles[recipe_id]
		var size: Vector2i = _machine_footprints.get(recipe_id, Vector2i.ONE)
		if tile.x >= origin.x and tile.x < origin.x + size.x \
				and tile.y >= origin.y and tile.y < origin.y + size.y:
			return String(recipe_id)
	return ""


## The recipe/progress/input/output text for one stage's machine — the same
## per-stage data the always-on panel used to show for every stage at once
## (removed; see docs/UI_UX.md §5's "hover tooltips ... rather than dense
## always-on text") formatted for a single stage, shown only on hover.
## Pure given `_last_machines`/`sim.current_tick()` — no Input reads.
func _machine_hover_text(recipe_id: String) -> String:
	if not _last_machines.has(recipe_id):
		return ""
	var machine: Dictionary = _last_machines[recipe_id]
	var process = machine.get("process")
	var progress_text := "idle"
	if process != null:
		var required: int = int(process[1])
		var elapsed: int = clampi(sim.current_tick() - int(process[0]), 0, required)
		var pct: float = (float(elapsed) / float(required)) * 100.0 if required > 0 else 100.0
		# The percentage ALONE stopped being enough at milestone 7's
		# timescale. A 60-tick crush is over before a player finishes reading
		# it, so "40%" is all it can usefully say; the aging rack's 2400-tick
		# wait is forty real seconds, and "40%" of a number the player has
		# never been told is not an answer to the question they are actually
		# asking, which is "how long until this is done". So the remaining
		# time is spelled out beside it, in seconds — the unit the player
		# experiences — rather than in ticks, which are an implementation
		# detail of ARCHITECTURE.md §3.9's fixed timestep. (At this scene's
		# TICK_HZ the rack's 2400 ticks are 80 real seconds, not the 40 that
		# data/recipes.ron's comment quotes at the nominal 60/sec rate —
		# another reason to print a time rather than leave the player to
		# convert one.)
		progress_text = "%.0f%%  ·  %s left" % [pct, _format_remaining(required - elapsed)]
	return "%s\n%s\nin: %s\nout: %s" % [
		recipe_id,
		progress_text,
		_format_counts(machine["input"]),
		_format_counts(machine["output"]),
	]


## A tick count as the wall-clock time it will take, at the rate this scene
## actually advances the simulation (`TICK_HZ`) — deliberately not at
## ARCHITECTURE.md §3.9's nominal 60/sec, because what the player is asking
## is "how long do I wait", and they wait at the rate the game runs. If
## TICK_HZ ever changes, every number this prints follows it, which is the
## point of reading the constant rather than typing a rate in twice.
## Minutes appear only once there is a minute to show, so the chain's short
## stages still read as plain seconds. Pure, so a test can drive it directly.
func _format_remaining(ticks: int) -> String:
	var seconds: int = int(ceil(float(maxi(ticks, 0)) / TICK_HZ))
	if seconds < 60:
		return "%ds" % seconds
	return "%dm %02ds" % [seconds / 60, seconds % 60]


## Which pipe segment sits on `tile` (see `_pipe_tiles`, populated once in
## _build_fluid_network from fluid_snapshot_json), or -1 if none does. The
## exact parallel of `_machine_recipe_at_tile` above, deliberately — a pipe
## is another thing occupying a tile, not a second kind of hover.
func _pipe_segment_at_tile(tile: Vector2i) -> int:
	return int(_pipe_tiles.get(tile, -1))


## Fluid type, level and pressure for one pipe segment — what the hover
## tooltip shows over a pipe, the same way `_machine_hover_text` describes a
## machine. Pure given `_last_fluid` (refreshed each frame by
## `_update_fluid_network`), so it is directly testable.
func _pipe_hover_text(segment_index: int) -> String:
	if segment_index < 0 or _last_fluid.is_empty():
		return ""
	var segments: Array = _last_fluid.get("segments", [])
	if segment_index >= segments.size():
		return ""
	var segment: Dictionary = segments[segment_index]
	var role := "pipe"
	if bool(segment.get("is_source", false)):
		role = "pipe (supply)"
	elif segment_index == int(_last_fluid.get("inlet_index", -1)):
		role = "pipe (machine inlet)"
	return "%s\n%s\n%.1f / %.1f units\npressure %.0f%%" % [
		String(_last_fluid.get("fluid", "fluid")),
		role,
		float(segment.get("volume", 0.0)),
		float(segment.get("capacity", 0.0)),
		clampf(float(segment.get("pressure", 0.0)), 0.0, 1.0) * 100.0,
	]


## Whether the chain's hopper covers `tile`. Footprint-aware for exactly the
## reason `_machine_recipe_at_tile` is, even though the shipped hopper is
## 1x1 — its footprint is data (`data/machines.ron`) like any machine's, and
## the hover shouldn't need revisiting the day it isn't.
func _hopper_at_tile(tile: Vector2i) -> bool:
	if _last_hopper.is_empty():
		return false
	return tile.x >= _hopper_tile.x and tile.x < _hopper_tile.x + _hopper_footprint.x \
			and tile.y >= _hopper_tile.y and tile.y < _hopper_tile.y + _hopper_footprint.y


## What the hopper's tooltip says: what it holds and how full it is — the
## same shape `_pipe_hover_text` uses for a pipe's level, since they are the
## same question about two different buffers. Pure given `_last_hopper`
## (refreshed each frame by `_update_hopper`), so it is directly testable.
func _hopper_hover_text() -> String:
	if _last_hopper.is_empty():
		return ""
	return "hopper\n%s\n%d / %d units\n%.0f%% full" % [
		String(_last_hopper.get("item", "raw ingredient")),
		int(_last_hopper.get("quantity", 0)),
		int(_last_hopper.get("capacity", 0)),
		clampf(float(_last_hopper.get("fill", 0.0)), 0.0, 1.0) * 100.0,
	]


## Whether the pipe run's fluid tank covers `tile`. Footprint-aware for the
## same reason `_hopper_at_tile` is, even though the shipped tank is 1x1: its
## footprint is data (`data/machines.ron`) like any machine's.
func _fluid_tank_at_tile(tile: Vector2i) -> bool:
	if _last_fluid_tank.is_empty():
		return false
	return tile.x >= _fluid_tank_tile.x and tile.x < _fluid_tank_tile.x + _fluid_tank_footprint.x \
			and tile.y >= _fluid_tank_tile.y and tile.y < _fluid_tank_tile.y + _fluid_tank_footprint.y


## What the tank's tooltip says: which fluid it holds and how much is left —
## the hopper's own tooltip shape, with the one difference the wire format
## already has (a fluid volume is fractional, an item count is not). Pure
## given `_last_fluid_tank` (refreshed each frame by `_update_fluid_tank`),
## so it is directly testable.
func _fluid_tank_hover_text() -> String:
	if _last_fluid_tank.is_empty():
		return ""
	return "fluid tank\n%s\n%.1f / %.0f units\n%.0f%% full" % [
		String(_last_fluid_tank.get("fluid", "fluid")),
		float(_last_fluid_tank.get("quantity", 0.0)),
		float(_last_fluid_tank.get("capacity", 0.0)),
		clampf(float(_last_fluid_tank.get("fill", 0.0)), 0.0, 1.0) * 100.0,
	]


## Whether the chain's delivery dock covers `tile`. Footprint-aware for the
## same reason `_hopper_at_tile` is, even though the shipped dock is 1x1: its
## footprint is data (`data/machines.ron`) like any machine's.
func _dock_at_tile(tile: Vector2i) -> bool:
	if _last_dock.is_empty():
		return false
	return tile.x >= _dock_tile.x and tile.x < _dock_tile.x + _dock_footprint.x \
			and tile.y >= _dock_tile.y and tile.y < _dock_tile.y + _dock_footprint.y


## What the dock's tooltip says. The one building on the line with no recipe
## and no process, so the machine tooltip's shape (recipe / progress / in /
## out) has nothing to put in three of its four lines — and the obvious
## substitute, its own buffer level, is always zero by design (see
## DOCK_ASSET's doc). So it answers the two questions a dock can actually
## answer: what it has shipped over the factory's whole life
## (`shipped_total`, which `sim::DockSnapshot` calls "the one number about a
## dock that is worth showing"), and what is standing on it right now waiting
## for a contract to claim it — the economy's shared pool, which is the same
## figure the clipboard prints as ON THE DOCK, deliberately, rather than a
## second number the player would have to reconcile with it.
##
## Pure given `_last_dock`/`_last_dock_stock` (both refreshed each frame by
## `_update_dock`), so it is directly testable.
func _dock_hover_text() -> String:
	if _last_dock.is_empty():
		return ""
	return "delivery dock\nships to contracts every tick\n%d shipped in total\nwaiting: %s" % [
		int(_last_dock.get("shipped_total", 0)),
		_format_counts(_last_dock_stock),
	]


## What the tooltip should say about whatever occupies `tile` — a machine, a
## pipe, the hopper, or nothing ("" , the sentinel `_update_hover_tooltip`
## checks to decide whether to show the tooltip at all). Pure, so a test can
## drive it with a tile directly; adding a further hoverable thing means
## adding a branch here, not a second hover mechanism — which is exactly
## what the hopper did, the same way milestone 6's pipes did before it.
func _hover_text_at_tile(tile: Vector2i) -> String:
	var recipe_id := _machine_recipe_at_tile(tile)
	if recipe_id != "":
		return _machine_hover_text(recipe_id)
	if _hopper_at_tile(tile):
		return _hopper_hover_text()
	if _fluid_tank_at_tile(tile):
		return _fluid_tank_hover_text()
	if _dock_at_tile(tile):
		return _dock_hover_text()
	return _pipe_hover_text(_pipe_segment_at_tile(tile))


## The thin, live-state-reading half (deliberately not unit tested, same
## reasoning as _pan_input_direction/_fp_input_direction's doc comments —
## headless SceneTree tests can't reliably simulate live viewport mouse
## state): picks which screen point to query — the live cursor in ISOMETRIC,
## the screen centre (where _crosshair is drawn) in FIRST_PERSON, since the
## mouse is captured there and has no meaningful on-screen position — and
## drives the pure functions above to decide what the tooltip should show.
func _update_hover_tooltip() -> void:
	if _hover_tooltip == null:
		return
	if _shop_open:
		# The build menu sits over the middle of the screen; a world tooltip
		# chasing the cursor across it would just be two panels fighting.
		_hover_tooltip.visible = false
		return
	var vp := get_viewport()
	if vp == null:
		_hover_tooltip.visible = false
		return
	var query_pos: Vector2
	if _view_mode == ViewMode.FIRST_PERSON:
		query_pos = vp.get_visible_rect().size / 2.0
	else:
		query_pos = vp.get_mouse_position()
	var tile := _tile_under_screen_pos(query_pos)
	var text := _hover_text_at_tile(tile)
	if text == "":
		_hover_tooltip.visible = false
		return
	_hover_label.text = text
	_hover_tooltip.position = query_pos + HOVER_TOOLTIP_OFFSET
	_hover_tooltip.visible = true


## Drives the contract clipboard (UI_UX.md §5) from `economy_snapshot_json`:
## the one shared money figure, the one shared dock pool, and then EVERY
## active contract's own docket — its checklist boxes, its numeric progress
## and its own countdown to its own next delivery check.
func _update_contract_panel() -> void:
	var econ: Dictionary = JSON.parse_string(sim.economy_snapshot_json())
	_contract_money_label.text = "Money: %.0f" % float(econ["money"])
	_update_contract_dock(econ.get("delivery_stock", []))

	var contracts: Array = econ.get("contracts", [])
	if not _contract_cards_match(contracts):
		_rebuild_contract_cards(contracts)

	var current_tick: int = sim.current_tick()
	for i in range(min(contracts.size(), _contract_cards.size())):
		_update_contract_card(_contract_cards[i], contracts[i], current_tick)

	# Cap the docket stack's height rather than letting it grow off the
	# bottom of the screen: past the cap it scrolls. `data/contracts.ron`
	# ships three and this never engages, which is the intent — a handful of
	# concurrent orders is the realistic board (GAMEPLAY.md §6 names no
	# count), so this is a safety valve for a content change rather than a
	# compact/summary mode nobody needs yet.
	var natural_height: float = _contract_cards_box.get_combined_minimum_size().y
	# A headless SceneTree run has no viewport at all, and a window that has
	# not laid out yet reports a zero rect — neither must collapse the stack
	# to nothing, so "no viewport" means "no cap", not "a cap of zero".
	var viewport := get_viewport()
	var cap: float = viewport.get_visible_rect().size.y * CONTRACT_LIST_MAX_HEIGHT_RATIO if viewport != null else 0.0
	_contract_cards_scroll.custom_minimum_size.y = min(natural_height, cap) if cap > 0.0 else natural_height

	# Re-anchor every update, not just once at build time: the panel's
	# minimum size grows once real text ("Money: 1234", "Next check in 1000
	# ticks") replaces the empty labels it was built with, and PRESET_MINSIZE
	# only computes offsets once, at the moment it's called — without this,
	# the panel stays sized/positioned for its build-time (near-empty) text
	# and later, wider text spills past its right edge.
	_contract_panel.set_anchors_and_offsets_preset(Control.PRESET_TOP_RIGHT, Control.PRESET_MODE_MINSIZE, 16)


## True when the built dockets already correspond, in order, to the reported
## contracts — the cheap guard that keeps _update_contract_panel from
## rebuilding nodes every frame for a list that never changes.
func _contract_cards_match(contracts: Array) -> bool:
	if contracts.size() != _contract_card_ids.size():
		return false
	for i in range(contracts.size()):
		if String(contracts[i].get("id", "")) != String(_contract_card_ids[i]):
			return false
	return true


## The shared delivery pool, shown once above the dockets.
##
## This line is the player-visible face of sim_core's allocation rule: there
## is ONE pile of collected stock and a settling contract CONSUMES its mix
## from it, so a box is never credited to two orders. Without it, three
## dockets whose checklists all read "2/2" look like three imminent payouts
## when the dock may hold only two boxes total — the checklists are each
## clamped to their own ask (that clamping is sim_core's, deliberately), and
## this unclamped number is what reconciles them. It is one line of text
## rather than a new widget: surfacing the rule is worth it, inventing a
## second progress language for it is not.
func _update_contract_dock(stock: Array) -> void:
	var seen: Dictionary = {}
	for pair in stock:
		var item_id: String = String(pair[0])
		var qty: int = int(pair[1])
		seen[item_id] = true
		var entry: Dictionary = _contract_dock_entries.get(item_id, {})
		if entry.is_empty():
			entry = _build_contract_dock_entry(item_id)
			_contract_dock_entries[item_id] = entry
		entry["label"].text = "%d" % qty
		entry["row"].visible = true
	for item_id in _contract_dock_entries:
		if not seen.has(item_id):
			_contract_dock_entries[item_id]["row"].visible = false
	# `delivery_stock` reports non-zero entries only, so an empty array is
	# genuinely "nothing on the dock" — say so rather than showing a bare label.
	_contract_dock_empty_label.visible = stock.is_empty()


func _build_contract_dock_entry(item_id: String) -> Dictionary:
	var row := HBoxContainer.new()
	row.name = "dock_%s" % item_id
	row.add_theme_constant_override("separation", 3)
	_contract_dock_row.add_child(row)

	var icon := TextureRect.new()
	icon.custom_minimum_size = Vector2(14, 14)
	icon.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	icon.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	icon.texture = _icon_for(item_id)
	row.add_child(icon)

	var label := Label.new()
	label.label_settings = _contract_meta_settings
	row.add_child(label)
	return {"row": row, "label": label, "icon": icon}


## One docket's live state. `progress` is sim_core's per-contract, clamped
## coverage of this contract's own mix (a checklist reads 2/2, never 7/2);
## the unclamped pool it is drawn from is the dock line above.
func _update_contract_card(card: Dictionary, contract: Dictionary, current_tick: int) -> void:
	var mix: Array = contract.get("mix", [])
	var progress: Array = contract.get("progress", [])
	var rows: Dictionary = card["rows"]
	for i in range(mix.size()):
		var item_id: String = String(mix[i][0])
		var required: int = int(mix[i][1])
		var have: int = int(progress[i][1]) if i < progress.size() else 0

		var row: Dictionary = rows.get(item_id, {})
		if row.is_empty():
			continue
		row["label"].text = "%s  %d/%d" % [item_id, have, required]

		var boxes: Array = row["boxes"]
		if boxes.size() == 1 and required > CONTRACT_CHECKLIST_MAX_BOXES:
			# The single-box fallback (see _build_contract_checklist_row):
			# checked only once the whole quantity is in.
			_set_checkbox_checked(boxes[0], have >= required)
		else:
			for u in range(boxes.size()):
				_set_checkbox_checked(boxes[u], u < have)

	# Each contract clocks independently in sim_core, so this countdown is
	# this docket's, never a shared one. The tally beside it is the only
	# feedback a player gets that an order is being under-served: a missed
	# window costs that window's payout and nothing else today (GAMEPLAY.md
	# §11 has not decided what else it should cost), so the count is the
	# whole consequence and it should be visible.
	var ticks_left: int = max(0, int(contract.get("next_delivery_tick", 0)) - current_tick)
	card["meta_label"].text = "next check in %d ticks  ·  every %d  ·  %d done, %d missed" % [
		ticks_left,
		int(contract.get("cadence_ticks", 0)),
		int(contract.get("deliveries_made", 0)),
		int(contract.get("deliveries_missed", 0)),
	]


## Swaps a checklist box's style (and its tick-mark visibility) between the
## checked/unchecked StyleBoxFlat pair — same pattern as the machine status
## lamps' idle/running material swap above, applied to a UI checkbox instead
## of a 3D emissive mesh.
func _set_checkbox_checked(box: Panel, checked: bool) -> void:
	if bool(box.get_meta("checked", false)) == checked:
		return
	box.set_meta("checked", checked)
	box.add_theme_stylebox_override("panel", _checkbox_style_checked if checked else _checkbox_style_unchecked)
	var mark: Label = box.get_node_or_null("Mark")
	if mark != null:
		mark.visible = checked


## Returns a small isometric icon texture for an item id, generated offline
## from the same real voxel model the item renders as in the world
## (UI_UX.md §5 — "icons ... rendered from the real assets ... not
## separately-drawn 2D icon art"; see assets/voxels/generators/icons.rs and
## assets/voxels/README.md for how the PNG itself is produced). Resolves the
## item id to an asset name via ITEM_MODELS, same mapping `_item_node_for`
## already uses for the item's in-world mesh, so an icon and its in-world
## model can never silently drift apart.
##
## Cached per asset name — never re-loads or re-renders on repeat calls
## (icons are static build output, not something that changes at runtime).
## An id with no icon, or one whose PNG isn't present on disk (e.g. `cargo
## xtask` was never run, or vengi wasn't installed when icons/ was last
## regenerated), still returns a real, non-null Texture2D: a plain
## placeholder swatch, never null and never a silently-broken texture.
func _icon_for(item_id: String) -> Texture2D:
	return _icon_for_asset(ITEM_MODELS.get(item_id, ITEM_MODEL_FALLBACK))


## The loading/caching/fallback half of `_icon_for`, keyed by ASSET name
## rather than item id — extracted (behaviour unchanged) when the build menu
## needed icons for *buildable kinds*, which resolve through SHOP_MODELS/
## MACHINE_MODELS instead of ITEM_MODELS. Both callers share this one cache
## and this one documented fallback; there is deliberately not a second icon
## system.
func _icon_for_asset(asset: String) -> Texture2D:
	if _icon_cache.has(asset):
		return _icon_cache[asset]

	var texture: Texture2D = null
	var path := ICON_DIR + asset + ".png"
	if ResourceLoader.exists(path):
		var loaded = load(path)
		if loaded is Texture2D:
			texture = loaded

	if texture == null:
		texture = _fallback_icon_texture()

	_icon_cache[asset] = texture
	return texture


## The documented fallback `_icon_for` returns when no real icon PNG could
## be loaded. Built once and reused — a flat, muted swatch, deliberately
## plain enough that it reads as "no icon" rather than as a broken asset.
func _fallback_icon_texture() -> Texture2D:
	if _icon_fallback_texture == null:
		var img := Image.create(8, 8, false, Image.FORMAT_RGBA8)
		img.fill(Color(0.5, 0.5, 0.5, 0.6))
		_icon_fallback_texture = ImageTexture.create_from_image(img)
	return _icon_fallback_texture


func _format_counts(pairs: Array) -> String:
	if pairs.is_empty():
		return "-"
	var parts: Array[String] = []
	for pair in pairs:
		parts.append("%s x%d" % [pair[0], int(pair[1])])
	return ", ".join(parts)
