; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sauce Factory"
config/description="Isometric voxel presentation of the data-driven production chain (UI_UX.md)."
; The game opens on the MAIN MENU, not straight into a factory (the
; "Save/load + a real main menu" epic). menu.tscn changes scene to
; main.tscn once the player has chosen New Game or a save to load; the
; GameSession autoload below is what carries that choice across.
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.6")

[display]

; 1600x900 since the 2026-09-09 UI-scale pass (it was 1280x720): at 1.5x the
; build menu's grid and the contract board both have to scroll at 720 tall,
; and a card cut in half mid-row reads as clipping. 1600x900 is the size
; scripts/screenshot-scene.sh has always reviewed at, everything fits there
; with room to spare, and it still fits a 16" MacBook's 1728x1117-logical
; display with the title bar. Scrolling remains as the fallback for
; a smaller window; it is not the intended default any more.
window/size/viewport_width=1600
window/size/viewport_height=900

[autoload]

; The one node that outlives a scene change: it carries "start a new game"
; vs. "load this file" from menu.tscn to main.tscn, and owns every rule
; about where a save file lives and what it may be called (sim_core does no
; file I/O at all — user:// is Godot's). See godot_project/game_session.gd.
GameSession="*res://game_session.gd"
; The music track (2026-09-12). An autoload for the same reason: the score
; starts on the menu and must not restart when the scene changes to the
; factory. See godot_project/music.gd.
Music="*res://music.gd"

[editor_plugins]

; Pinned .vox importer — see addons/MagicaVoxel_Importer_with_Extensions/VENDORED.md
enabled=PackedStringArray("res://addons/MagicaVoxel_Importer_with_Extensions/plugin.cfg")

[rendering]

; Forward+ is what UI_UX.md §4's lighting asks for: real-time shadows, SSAO
; and glow are all Forward+-only features. Stated explicitly rather than
; relying on the engine default, since main.gd's WorldEnvironment configures
; all three.
renderer/rendering_method="forward_plus"
textures/vram_compression/import_etc2_astc=true
