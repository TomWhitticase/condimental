[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.6
reloadable = true

[libraries]
macos.debug = "res://bin/libsim_core.dylib"
macos.release = "res://bin/libsim_core.dylib"
linux.debug.x86_64 = "res://bin/libsim_core.so"
linux.release.x86_64 = "res://bin/libsim_core.so"
windows.debug.x86_64 = "res://bin/sim_core.dll"
windows.release.x86_64 = "res://bin/sim_core.dll"
android.debug.arm64 = "res://bin/android/libsim_core.arm64-v8a.so"
android.release.arm64 = "res://bin/android/libsim_core.arm64-v8a.so"
android.debug.x86_64 = "res://bin/android/libsim_core.x86_64.so"
android.release.x86_64 = "res://bin/android/libsim_core.x86_64.so"
