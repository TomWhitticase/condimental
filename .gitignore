.DS_Store
*.log
.env
.env.local

# Rust build output (ARCHITECTURE.md §1)
/target

# Compiled GDExtension binary — regenerated by `cargo xtask` (ARCHITECTURE.md §7), never hand-placed
/godot_project/bin/

# Voxel models copied into the Godot project by `cargo xtask` — same
# treatment as godot_project/bin/ above. The committed source of truth is
# assets/voxels/ (generators + palette), and models/ is regenerated from it
# by `cargo run -p voxgen --bin voxgen` (UI_UX.md §2a).
/godot_project/voxels/

# Godot 4 local editor cache — never the .tscn/.tres sources themselves (ARCHITECTURE.md §5)
.godot/

# Generated voxel-model PNG previews — regenerate on demand, not shipped (UI_UX.md §2a)
assets/voxels/previews/

# Android Gradle build template — regenerated from the export templates'
# android_source.zip (normally via Godot's "Install Android Build Template",
# ARCHITECTURE.md §9 milestone 2), never hand-edited. Same treatment as
# godot_project/bin/ above.
/godot_project/android/

# Exported platform packages (.apk/.aab/.ipa) — build output, not source.
/build/

# A stale copy of CLAUDE.md that the agent environment drops into every
# worktree. Nobody creates it deliberately and it has never been committed;
# ignoring it keeps `git status` honest so a real untracked file stands out.
# CLAUDE.md itself is the source of truth and IS tracked.
/AGENTS.md

# three.js, downloaded on first run of tools/asset-browser (never edited,
# never a source of truth) — the tool re-fetches it if it is missing.
/tools/asset-browser/web/vendor/

# Python bytecode from the dev tools in tools/
__pycache__/

# Per-clone Claude Code permission grants. .claude/settings.json (the shared
# one) stays tracked; this one is whatever a local session happened to approve.
.claude/settings.local.json
