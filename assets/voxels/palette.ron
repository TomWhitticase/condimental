// Shared voxel colour palette (UI_UX.md §2a point 5, §4, §7).
//
// This file is the SINGLE source of truth for colour and material in the
// voxel pipeline: every generator in `generators/` references a colour by
// name here, none invent their own. That is what keeps the "shiny metal vs.
// matte everything else" rule (UI_UX.md §4) and the neutral-industrial
// palette (§7) consistent across separately-generated assets instead of
// drifting per asset.
//
// `schema_version` follows ARCHITECTURE.md §4's data-file versioning rule.
//
// Palette indices are NOT written here — they are derived from this list's
// order (entry 0 becomes MagicaVoxel palette index 1, and so on), the same
// "file order is the data" convention data/recipes.ron already uses. Append
// new colours at the end; reordering re-indexes every generated .vox.
//
// `class` names a material class, defined in `materials` below. Godot builds
// one `StandardMaterial3D` per class from these numbers (they are exported
// to `materials.json` alongside the models), and each asset is emitted as
// one .vox per class it uses, so a machine's steel really can be shinier
// than the concrete it stands on — UI_UX.md §4's deliberate metal exception.
(
    schema_version: 1,

    materials: {
        // Baseline: painted metal, concrete, plastic, rubber, cardboard.
        // Flat and mostly matte, in keeping with a voxel-art look (§4).
        "matte": (metallic: 0.0, roughness: 0.95, emission_energy: 0.0),
        // The deliberate exception (§4): stainless tanks, housings, pipes and
        // fittings read as noticeably shinier than everything else, which is
        // what makes "important machinery" pop against plainer surroundings.
        "metal": (metallic: 0.9, roughness: 0.18, emission_energy: 0.0),
        // Status lights / indicator strips. Both an aesthetic touch and a
        // functional readability signal (§4, §7) — these are the elements the
        // WorldEnvironment's glow pass picks up.
        "emissive": (metallic: 0.0, roughness: 0.55, emission_energy: 2.6),
        // Fluid bodies inside pipes and tanks (milestone 6). A dielectric,
        // so metallic stays 0, but glossier than anything else in the
        // palette — that gloss IS UI_UX.md §4's "visible liquid surfaces in
        // tanks/pipes with subtle shading/reflection", and it is what makes
        // a liquid read as wet rather than as a painted block. The fluid's
        // own hue is not here on purpose: which fluid is in a pipe is live
        // simulation data (see main.gd's FLUID_TINTS), so the voxels are
        // near-white and Godot tints them per fluid id.
        "liquid": (metallic: 0.0, roughness: 0.14, emission_energy: 0.0),
    },

    colors: [
        // --- floor / structure (neutral industrial base, §7) ---
        (name: "concrete_dark",  rgb: "#43433F", class: "matte"),
        (name: "concrete",       rgb: "#6A6A63", class: "matte"),
        (name: "concrete_light", rgb: "#838379", class: "matte"),
        // The saw-cut control joint between one floor slab and the next.
        // **Lightened from #33332F** by the floor redesign. Every tile draws
        // a joint on all four of its edges, so an interior joint is two
        // voxels of this colour; at the old value that was the loudest thing
        // in the frame and the factory read as a tiled bathroom rather than
        // as a poured floor. It is a hairline in the pour now, not grout.
        // See `assets.rs`'s `floor_joint` for why the four edges stay.
        (name: "floor_seam",     rgb: "#50504A", class: "matte"),
        (name: "drain_grate",    rgb: "#2C2C2A", class: "matte"),

        // --- belts ---
        (name: "rubber_dark",    rgb: "#1E1E21", class: "matte"),
        (name: "rubber",         rgb: "#2C2C31", class: "matte"),

        // --- safety signage (§3: real industrial visual language) ---
        (name: "hazard_yellow",  rgb: "#D9A21B", class: "matte"),
        (name: "hazard_black",   rgb: "#191919", class: "matte"),

        // --- metals (§4's shiny exception) ---
        (name: "steel_dark",     rgb: "#6F7680", class: "metal"),
        (name: "steel",          rgb: "#9BA3AC", class: "metal"),
        (name: "steel_light",    rgb: "#C6CCD2", class: "metal"),
        (name: "brass",          rgb: "#B98A3C", class: "metal"),
        (name: "pipe_grey",      rgb: "#868E96", class: "metal"),

        // --- painted machine housings ---
        (name: "paint_blue",     rgb: "#2E5772", class: "matte"),
        (name: "paint_red",      rgb: "#82372F", class: "matte"),

        // --- status / alert (saturated colour reserved for meaning, §7) ---
        (name: "status_green",   rgb: "#4AE06B", class: "emissive"),
        (name: "status_amber",   rgb: "#FFB020", class: "emissive"),
        (name: "status_red",     rgb: "#FF3B30", class: "emissive"),

        // --- product: raw ingredient through finished, boxed goods ---
        (name: "tomato_red",     rgb: "#C22C21", class: "matte"),
        (name: "tomato_shadow",  rgb: "#8B1E17", class: "matte"),
        (name: "tomato_leaf",    rgb: "#3E8C39", class: "matte"),
        (name: "sauce_red",      rgb: "#9E2117", class: "matte"),
        (name: "ketchup_red",    rgb: "#BE160E", class: "matte"),
        (name: "pail_grey",      rgb: "#989EA2", class: "matte"),
        (name: "glass_pale",     rgb: "#B4CBC5", class: "matte"),
        (name: "cap_white",      rgb: "#E4E0D8", class: "matte"),
        (name: "label_cream",    rgb: "#E5DCC5", class: "matte"),
        (name: "cardboard",      rgb: "#AD8450", class: "matte"),
        (name: "cardboard_dark", rgb: "#875F35", class: "matte"),

        // --- fluids (milestone 6) ---
        // Deliberately near-white: main.gd multiplies this by a per-fluid
        // albedo tint, so one fluid model serves every fluid data/recipes.ron
        // ever names without a palette entry per liquid.
        (name: "fluid_pale",     rgb: "#E8F1EC", class: "liquid"),

        // --- bulk solids in a hopper (the "Machines improvement" milestone) ---
        // Same trick `fluid_pale` above plays, for the same reason and with
        // one deliberate difference: near-white so `main.gd` can multiply a
        // per-item tint over it (which raw ingredient a hopper holds is live
        // data from data/recipes.ron, not a palette decision), but class
        // `matte`, not `liquid` — a heap of tomatoes is not a wet surface,
        // and giving it the liquid class's gloss would read as sauce in a
        // tank rather than product in a bin. Appended at the END of the list,
        // per this file's own rule: an insert re-indexes every colour after
        // it, and `fluid_pale` was after it on the first attempt.
        (name: "bulk_pale",      rgb: "#EDE7DE", class: "matte"),

        // --- liquid product on the belt ("Visual overhaul round 2",
        // ticket 2) ---
        // Unlike `fluid_pale` above these DO carry their own hue, and that
        // difference is the point: which fluid is in a pipe is live
        // simulation data, but which product is in a pail is fixed by
        // `data/recipes.ron`'s chain — there is exactly one colour each of
        // these can ever be, so a near-white voxel plus a GDScript tint
        // would just move a constant out of the one file that is supposed
        // to own colour. Class `liquid`, not `matte`, because the project
        // owner's review of the rendered scene said these three read as
        // solid painted blocks: the pails' contents ARE a wet surface, and
        // the gloss is what says so (UI_UX.md §4). They darken and redden
        // along the chain — thick paste, then paste cut with vinegar, then
        // the cooked-down classic ketchup red — so the three stages stay
        // tellable apart on the belt.
        (name: "liquid_paste",   rgb: "#8E2418", class: "liquid"),
        (name: "liquid_mix",     rgb: "#AF3B27", class: "liquid"),
        (name: "liquid_ketchup", rgb: "#C4190E", class: "liquid"),

        // --- sugar, the chain's second raw ingredient (the chain-rework
        // epic) ---
        // A paper sack of refined sugar: the kraft-paper body and the
        // white crystal spilling from its top. `sack_kraft` is a pale,
        // desaturated paper rather than another brown — it sits on the same
        // belt as `cardboard` two stages downstream, and the packer's cases
        // are the factory's one large warm surface, so a second brown
        // shipping-coloured object on the line would be the exact
        // tellable-apart problem UI_UX.md §2b point 14 records about the
        // barrels. `sugar_white` is the crystal itself, and is what
        // `main.gd` tints a sugar hopper's product heap with.
        (name: "sack_kraft",     rgb: "#C9B48E", class: "matte"),
        (name: "sugar_white",    rgb: "#F2F0E8", class: "matte"),

        // --- vinegar, the chain's one RAW fluid ---
        // The chain's third raw ingredient had no colour of its own at all:
        // its hue lived only in `main.gd`'s FLUID_TINTS, as a pale gold that
        // read as cooking oil or lager in the pipe run, and as *nothing* in
        // the market, where a fluid borrowed the pipe's own icon. Both are
        // fixed by giving it the same treatment `liquid_mix`/`liquid_ketchup`
        // already get: one colour here, named once, used by every place
        // vinegar appears (the jug in `item_vinegar`, and the tint main.gd
        // multiplies over `fluid_pale` in a pipe or a tank — those two
        // numbers are kept equal on purpose, so the stock you buy and the
        // liquid in the run are recognizably the same substance).
        // A cider/malt AMBER rather than clear: distilled vinegar is nearly
        // colourless, and a colourless fluid in a stainless pipe is an empty
        // pipe. Amber is what a player reads as vinegar, and it is far
        // enough round the wheel from `liquid_mix`'s red-orange to stay
        // tellable apart on the same row of the factory.
        (name: "vinegar_amber",  rgb: "#AD6B23", class: "liquid"),
        // The headspace above the fill line and the vessel's own glass. A
        // touch greener and darker than `glass_pale` (which is the ketchup
        // bottle's), so the two glass items on this line are not the same
        // object in two colours.
        (name: "vinegar_glass",  rgb: "#B3C6BC", class: "matte"),
        // --- the factory floor's own concrete (the floor redesign) ---
        // The floor is the one surface that fills the whole screen, so it is
        // the one surface whose job is to be a BACKGROUND. `concrete_slab`
        // is a shade darker than the shared `concrete` above — which the
        // dock deck and the machine plinths keep — so that stainless and
        // painted housings have something to pop against (UI_UX.md §4). Its
        // own entry rather than a change to `concrete` for exactly that
        // reason: a plinth wants to read as part of its machine, a slab
        // wants to read as the ground the machine stands on.
        //
        // `concrete_mottle`/`concrete_shade` are the pour's own variation,
        // and they are deliberately only a few points either side of
        // `concrete_slab`. The floor used to be speckled with
        // `concrete_light`, far brighter, one voxel at a time; at scene
        // scale that reads as television static, not as aggregate. Broad
        // blotches at low contrast read as a trowelled pour — and mesh into
        // far fewer triangles besides, which matters here and almost
        // nowhere else, because the floor is the one asset whose triangle
        // count is multiplied by the size of the world.
        // How close together these three sit is the whole point, and it was
        // set by rendering them: at a dozen points apart the blotches read
        // as confetti scattered on the floor rather than as the floor.
        (name: "concrete_slab",   rgb: "#5E5E57", class: "matte"),
        (name: "concrete_mottle", rgb: "#66665F", class: "matte"),
        (name: "concrete_shade",  rgb: "#565650", class: "matte"),

    ],
)
