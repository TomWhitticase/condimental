// Shared voxel colour palette (UI_UX.md §2a point 5, §4, §7).
//
// This file is the SINGLE source of truth for colour and material in the
// voxel pipeline: every generator in `generators/` references a colour by
// name here, none invent their own. That is what keeps the "shiny metal vs.
// matte everything else" rule (UI_UX.md §4) and the neutral-industrial
// palette (§7) consistent across separately-generated assets instead of
// drifting per asset.
//
// `schema_version` follows ARCHITECTURE.md §4's data-file versioning rule.
//
// Palette indices are NOT written here — they are derived from this list's
// order (entry 0 becomes MagicaVoxel palette index 1, and so on), the same
// "file order is the data" convention data/recipes.ron already uses. Append
// new colours at the end; reordering re-indexes every generated .vox.
//
// `class` names a material class, defined in `materials` below. Godot builds
// one `StandardMaterial3D` per class from these numbers (they are exported
// to `materials.json` alongside the models), and each asset is emitted as
// one .vox per class it uses, so a machine's steel really can be shinier
// than the concrete it stands on — UI_UX.md §4's deliberate metal exception.
//
// `lamp_states` is the same idea for the one class that has more than one
// state: a status lamp is drawn lit or dark, and both presentations are
// written here rather than in whichever renderer happens to be drawing it.
(
    schema_version: 2,

    materials: {
        // Baseline: painted metal, concrete, plastic, rubber, cardboard.
        // Flat and mostly matte, in keeping with a voxel-art look (§4).
        "matte": (metallic: 0.0, roughness: 0.95, emission_energy: 0.0),
        // The deliberate exception (§4): stainless tanks, housings, pipes and
        // fittings read as noticeably shinier than everything else, which is
        // what makes "important machinery" pop against plainer surroundings.
        "metal": (metallic: 0.9, roughness: 0.18, emission_energy: 0.0),
        // Status lights / indicator strips. Both an aesthetic touch and a
        // functional readability signal (§4, §7) — these are the elements the
        // WorldEnvironment's glow pass picks up.
        //
        // This is the one class Godot builds as a ShaderMaterial rather than a
        // StandardMaterial3D (`voxel_emissive.gdshader`): a lamp has to emit
        // its OWN vertex colour, because the crusher carries a green lens and
        // an amber one in a single `emissive` submesh and a flat emission
        // colour washes both to the same white.
        //
        // 2.6 until 2026-09-16 (issue #25), and that number never rendered:
        // the material asked for emission it could not produce, so ANY value
        // gave a byte-identical frame and this was never judged by eye.
        // Retuned to 1.2 the first time it actually lit anything, against the
        // mixer's amber lamp and the cooking vat's ring under the glow pass
        // (`factory_environment.gd`: hdr threshold 0.85, intensity 0.7). At
        // 2.6 a lit lens burns through to cream — #FFB020 renders (255, 245,
        // 178) — which is the very hue-washing the shader exists to prevent.
        // 1.2 is the most a lens can take and still read as its own colour.
        "emissive": (metallic: 0.0, roughness: 0.55, emission_energy: 1.2),
        // Fluid bodies inside pipes and tanks (milestone 6). A dielectric,
        // so metallic stays 0, but glossier than anything else in the
        // palette — that gloss IS UI_UX.md §4's "visible liquid surfaces in
        // tanks/pipes with subtle shading/reflection", and it is what makes
        // a liquid read as wet rather than as a painted block. The fluid's
        // own hue is not here on purpose: which fluid is in a pipe is live
        // simulation data (see main.gd's FLUID_TINTS), so the voxels are
        // near-white and Godot tints them per fluid id.
        "liquid": (metallic: 0.0, roughness: 0.14, emission_energy: 0.0),
    },

    // The two states a status LAMP is drawn in. Not a fifth material class:
    // these are the `emissive` class above, modified, and the game swaps one
    // for the other on a single mesh (`main.gd`'s `_set_machine_running`).
    // A machine's lamps are lit only while it is actually processing, which
    // is the minority of its life, so BOTH presentations have to be readable
    // and reviewable — the asset browser drew every lamp at full emission
    // until issue #81, and was flattering the state a machine is least often
    // in.
    //
    // Written as MODIFIERS of `emissive` so `emission_energy` stays written
    // down exactly once. `emission_scale` multiplies that 1.2, so retuning it
    // moves the lit lamp with it and the two can never fall out of step;
    // `metallic` is the class's.
    //
    // `albedo_scale` multiplies the lens's own colour in the ALBEDO channel
    // alone, which is how the idle lamp reads as OFF while staying the same
    // hue of lens: one number has to take amber, green and red down together
    // and leave each recognisable. Albedo rather than emission alone because
    // it is the channel that still renders when the glow pass is what the eye
    // is reading (2026-09-16, issue #25). 0.38 is the judgement this palette
    // already makes where the colour CAN be chosen outright — `status_amber`
    // #FFB020 against `status_amber_off` #5C4212 is a little over a third,
    // and so are red's and green's.
    //
    // Exported RESOLVED to `lamp_states.json` beside the models, which is the
    // one place Godot (`voxel_assets.gd`) and the asset browser
    // (`tools/asset-browser`) both read them from.
    lamp_states: {
        "idle":    (roughness: 0.6,  emission_scale: 0.0, albedo_scale: 0.38),
        "running": (roughness: 0.45, emission_scale: 1.0, albedo_scale: 1.0),
    },

    colors: [
        // --- floor / structure (neutral industrial base, §7) ---
        (name: "concrete_dark",  rgb: "#43433F", class: "matte"),
        (name: "concrete",       rgb: "#6A6A63", class: "matte"),
        (name: "concrete_light", rgb: "#838379", class: "matte"),
        // The saw-cut control joint between one floor slab and the next.
        // **Lightened from #33332F** by the floor redesign. Every tile draws
        // a joint on all four of its edges, so an interior joint is two
        // voxels of this colour; at the old value that was the loudest thing
        // in the frame and the factory read as a tiled bathroom rather than
        // as a poured floor. It is a hairline in the pour now, not grout.
        // See `assets.rs`'s `floor_joint` for why the four edges stay.
        (name: "floor_seam",     rgb: "#50504A", class: "matte"),
        (name: "drain_grate",    rgb: "#2C2C2A", class: "matte"),

        // --- belts ---
        (name: "rubber_dark",    rgb: "#1E1E21", class: "matte"),
        (name: "rubber",         rgb: "#2C2C31", class: "matte"),

        // --- safety signage (§3: real industrial visual language) ---
        (name: "hazard_yellow",  rgb: "#D9A21B", class: "matte"),
        (name: "hazard_black",   rgb: "#191919", class: "matte"),

        // --- metals (§4's shiny exception) ---
        (name: "steel_dark",     rgb: "#6F7680", class: "metal"),
        (name: "steel",          rgb: "#9BA3AC", class: "metal"),
        (name: "steel_light",    rgb: "#C6CCD2", class: "metal"),
        (name: "brass",          rgb: "#B98A3C", class: "metal"),
        (name: "pipe_grey",      rgb: "#868E96", class: "metal"),

        // --- painted machine housings ---
        (name: "paint_blue",     rgb: "#2E5772", class: "matte"),
        (name: "paint_red",      rgb: "#82372F", class: "matte"),

        // --- status / alert (saturated colour reserved for meaning, §7) ---
        (name: "status_green",   rgb: "#4AE06B", class: "emissive"),
        (name: "status_amber",   rgb: "#FFB020", class: "emissive"),
        (name: "status_red",     rgb: "#FF3B30", class: "emissive"),

        // --- product: raw ingredient through finished, boxed goods ---
        (name: "tomato_red",     rgb: "#C22C21", class: "matte"),
        (name: "tomato_shadow",  rgb: "#8B1E17", class: "matte"),
        (name: "tomato_leaf",    rgb: "#3E8C39", class: "matte"),
        // NOTHING PAINTS THIS ANY MORE, and it stays where it is. It was
        // the cooking vat's sight glass; since 2026-09-21 the vat shows the
        // sauce it is actually cooking (`machine_product`, tinted per
        // recipe), so a fixed red would have been one sauce of several.
        // Indices here are the file's own order, so a removal renumbers
        // every colour below it and silently repaints half the factory —
        // this list is appended to, never edited in the middle. It is also
        // still the anchor two later entries were picked against
        // (`bbq_brown`'s note below measures itself off it).
        (name: "sauce_red",      rgb: "#9E2117", class: "matte"),
        (name: "ketchup_red",    rgb: "#BE160E", class: "matte"),
        (name: "pail_grey",      rgb: "#989EA2", class: "matte"),
        (name: "glass_pale",     rgb: "#B4CBC5", class: "matte"),
        (name: "cap_white",      rgb: "#E4E0D8", class: "matte"),
        (name: "label_cream",    rgb: "#E5DCC5", class: "matte"),
        (name: "cardboard",      rgb: "#AD8450", class: "matte"),
        (name: "cardboard_dark", rgb: "#875F35", class: "matte"),

        // --- fluids (milestone 6) ---
        // Deliberately near-white: main.gd multiplies this by a per-fluid
        // albedo tint, so one fluid model serves every fluid data/recipes.ron
        // ever names without a palette entry per liquid.
        (name: "fluid_pale",     rgb: "#E8F1EC", class: "liquid"),

        // --- bulk solids in a hopper (the "Machines improvement" milestone) ---
        // Same trick `fluid_pale` above plays, for the same reason and with
        // one deliberate difference: near-white so `main.gd` can multiply a
        // per-item tint over it (which raw ingredient a hopper holds is live
        // data from data/recipes.ron, not a palette decision), but class
        // `matte`, not `liquid` — a heap of tomatoes is not a wet surface,
        // and giving it the liquid class's gloss would read as sauce in a
        // tank rather than product in a bin. Appended at the END of the list,
        // per this file's own rule: an insert re-indexes every colour after
        // it, and `fluid_pale` was after it on the first attempt.
        (name: "bulk_pale",      rgb: "#EDE7DE", class: "matte"),

        // --- liquid product on the belt ("Visual overhaul round 2",
        // ticket 2) ---
        // Unlike `fluid_pale` above these DO carry their own hue, and that
        // difference is the point: which fluid is in a pipe is live
        // simulation data, but which product is in a pail is fixed by
        // `data/recipes.ron`'s chain — there is exactly one colour each of
        // these can ever be, so a near-white voxel plus a GDScript tint
        // would just move a constant out of the one file that is supposed
        // to own colour. Class `liquid`, not `matte`, because the project
        // owner's review of the rendered scene said these three read as
        // solid painted blocks: the pails' contents ARE a wet surface, and
        // the gloss is what says so (UI_UX.md §4). They move along the
        // chain by VALUE — thick dark paste, then paste cut with vinegar and
        // sugar into a pale coral, then the cooked-down classic ketchup red —
        // so the three stages stay tellable apart on the belt and in a pipe.
        // `liquid_mix` is the pale one, and was lifted from #AF3B27 for
        // issue #131: as `FLUID_TINTS["ketchup_mix"]` it sat 7.7/255 of luma
        // from `bbq_mix`, two mid-chain liquids told apart by hue alone. It
        // now stands in the empty band between `vinegar_amber` and
        // `mustard_gold`'s tint, 31.4 over the first — see `main.gd`.
        (name: "liquid_paste",   rgb: "#8E2418", class: "liquid"),
        (name: "liquid_mix",     rgb: "#F47C5E", class: "liquid"),
        (name: "liquid_ketchup", rgb: "#C4190E", class: "liquid"),

        // --- sugar, the chain's second raw ingredient (the chain-rework
        // epic) ---
        // A paper sack of refined sugar: the kraft-paper body and the
        // white crystal spilling from its top. `sack_kraft` is a pale,
        // desaturated paper rather than another brown — it sits on the same
        // belt as `cardboard` two stages downstream, and the packer's cases
        // are the factory's one large warm surface, so a second brown
        // shipping-coloured object on the line would be the exact
        // tellable-apart problem UI_UX.md §2b point 14 records about the
        // barrels. `sugar_white` is the crystal itself, and is what
        // `main.gd` tints a sugar hopper's product heap with.
        (name: "sack_kraft",     rgb: "#C9B48E", class: "matte"),
        (name: "sugar_white",    rgb: "#F2F0E8", class: "matte"),

        // --- vinegar, the chain's one RAW fluid ---
        // The chain's third raw ingredient had no colour of its own at all:
        // its hue lived only in `main.gd`'s FLUID_TINTS, as a pale gold that
        // read as cooking oil or lager in the pipe run, and as *nothing* in
        // the market, where a fluid borrowed the pipe's own icon. Both are
        // fixed by giving it the same treatment `liquid_mix`/`liquid_ketchup`
        // already get: one colour here, named once, used by every place
        // vinegar appears (the jug in `item_vinegar`, and the tint main.gd
        // multiplies over `fluid_pale` in a pipe or a tank — those two
        // numbers are kept equal on purpose, so the stock you buy and the
        // liquid in the run are recognizably the same substance).
        // A cider/malt AMBER rather than clear: distilled vinegar is nearly
        // colourless, and a colourless fluid in a stainless pipe is an empty
        // pipe. Amber is what a player reads as vinegar, and it is far
        // enough round the wheel from `liquid_mix`'s red-orange to stay
        // tellable apart on the same row of the factory.
        (name: "vinegar_amber",  rgb: "#AD6B23", class: "liquid"),
        // The headspace above the fill line and the vessel's own glass. A
        // touch greener and darker than `glass_pale` (which is the ketchup
        // bottle's), so the two glass items on this line are not the same
        // object in two colours.
        (name: "vinegar_glass",  rgb: "#B3C6BC", class: "matte"),
        // --- the factory floor's own concrete (the floor redesign) ---
        // The floor is the one surface that fills the whole screen, so it is
        // the one surface whose job is to be a BACKGROUND. `concrete_slab`
        // is a shade darker than the shared `concrete` above — which the
        // dock deck and the machine plinths keep — so that stainless and
        // painted housings have something to pop against (UI_UX.md §4). Its
        // own entry rather than a change to `concrete` for exactly that
        // reason: a plinth wants to read as part of its machine, a slab
        // wants to read as the ground the machine stands on.
        //
        // `concrete_mottle`/`concrete_shade` are the pour's own variation,
        // and they are deliberately only a few points either side of
        // `concrete_slab`. The floor used to be speckled with
        // `concrete_light`, far brighter, one voxel at a time; at scene
        // scale that reads as television static, not as aggregate. Broad
        // blotches at low contrast read as a trowelled pour — and mesh into
        // far fewer triangles besides, which matters here and almost
        // nowhere else, because the floor is the one asset whose triangle
        // count is multiplied by the size of the world.
        // How close together these three sit is the whole point, and it was
        // set by rendering them: at a dozen points apart the blotches read
        // as confetti scattered on the floor rather than as the floor.
        (name: "concrete_slab",   rgb: "#5E5E57", class: "matte"),
        (name: "concrete_mottle", rgb: "#66665F", class: "matte"),
        (name: "concrete_shade",  rgb: "#565650", class: "matte"),

        // --- the andon stack light (the machine-load epic, ticket 2) ---
        // A stack light is three lenses and ONE of them lit, so the two
        // that are not lit need a colour of their own: the same hue as the
        // `status_*` emissive above it, taken down to a dark matte, so the
        // tower still reads as green-amber-red from top to bottom and the
        // lit lens is told apart by POSITION in that stack as well as by
        // its glow (UI_UX.md §7: never colour alone). Dark enough that a
        // dead lens does not compete with a live one under the glow pass,
        // light enough not to vanish into the `hazard_black` housing bands
        // between them — a dead lens must still read as a lens, or the
        // tower is a pole with one blob on it. Class `matte`, deliberately:
        // an unlit lens that still emitted would be a lamp half on.
        (name: "status_green_off", rgb: "#1E4A2A", class: "matte"),
        (name: "status_amber_off", rgb: "#5C4212", class: "matte"),
        (name: "status_red_off",   rgb: "#5A1B16", class: "matte"),
        // The pole the lenses stand on. Painted, not stainless: UI_UX.md
        // §2b point 8's rule (food contact is steel, structure is paint)
        // and a signal post is structure. A mid grey rather than the
        // housings' `paint_blue`, so a post bolted to a blue skirt is
        // still a separate object, and rather than a black — a dark column
        // against a body's shadow-side face reads as a gap in that face
        // (point 21).
        (name: "paint_grey",      rgb: "#7A8088", class: "matte"),

        // --- BBQ sauce, the game's second sauce (docs/BBQ_SAUCE_PLAN.md) ---
        // `bbq_brown` is what is IN a `bottled_bbq` bottle, and it is the
        // one colour that has to carry "this belt is not carrying ketchup"
        // at the size an item actually renders — half a tile, and this
        // camera sees a bottle's shadow side. Against `ketchup_red`
        // #BE160E it is a deep desaturated molasses: the same warm family,
        // far less chroma and far less light, which is the pair a player
        // can tell apart at a glance where two saturated reds a shade
        // apart are not. It is deliberately NOT another entry in the
        // `liquid_*` set above: nothing carries BBQ in an open pail, so
        // this colour is only ever seen through a bottle's glass and
        // printed on a case, and matte is what both of those are. The
        // fluid in the pipe run stays `fluid_pale` tinted by main.gd's
        // FLUID_TINTS, exactly like every other fluid.
        (name: "bbq_brown",       rgb: "#4E2419", class: "matte"),
        // The BBQ bottle's label band, where ketchup's is `label_cream`
        // #E5DCC5. Kraft paper rather than a second near-white: a band only
        // a few points off the cap reads as the same label in different
        // light, and the two bottles have to be one glance apart. Its own
        // entry rather than borrowing `sack_kraft` (the sugar sack) because
        // that colour is chosen to stay tellable apart from `cardboard` on
        // a belt, which is a different job from sitting on a dark bottle.
        (name: "label_kraft",     rgb: "#C7A97A", class: "matte"),
        // The BBQ case's two shipping labels, where ketchup's are
        // `label_cream`. **The carton itself does not change** — a case is
        // a cardboard box whichever sauce is in it, and only the print on
        // it says which (the project owner's call). That leaves the label
        // doing all the work on the smallest object on the belt, so it
        // reverses the CONTRAST DIRECTION rather than shifting hue: bright
        // patches on a mid carton for ketchup, dark ones for BBQ. Darker
        // than `cardboard_dark` #875F35, the tape seam crossing the same
        // face, so a label is not mistaken for more tape; a touch warmer
        // and lighter than `bbq_brown` itself, so it reads as ink on a box
        // rather than as a window into the sauce.
        (name: "label_bbq",       rgb: "#4A2C1E", class: "matte"),

        // --- the BBQ branch's three RAW ingredients (issue #67) ---
        // The three things a BBQ line buys, as the player handles them in
        // the market and (for the two solids) on a belt. They had no
        // colours here because they had no models: all three fell through
        // `main.gd`'s `_market_asset_for` to the pipe, so the market drew
        // three identical nozzles for three different shipments.
        //
        // `spice_paprika` is the ground blend heaped in its tin, and it is
        // pushed deliberately toward ORANGE rather than toward the reds
        // this palette is already full of: against `sauce_red` #9E2117 and
        // `paint_red` #82372F it is the one warm tone with more yellow than
        // blue in it, which is what keeps a tin of spice from reading as a
        // pail of sauce at the size a market crate renders. It is also
        // darker and redder than `vinegar_amber` #AD6B23, the other raw
        // that is nearly this hue, because those two stand side by side in
        // the market row and nowhere else — that adjacency, not the spice
        // itself, is what set this number.
        (name: "spice_paprika",   rgb: "#A8481C", class: "matte"),
        // Molasses in its jar. Nearly black, and class `liquid` rather
        // than `matte` for the reason `liquid_paste` records: syrup IS a
        // wet surface, and at this value the gloss highlight is the only
        // thing that separates "a jar of something thick" from "a jar
        // painted a dark colour". Warmer and darker than `bbq_brown`
        // #4E2419 (the sauce it ends up in), so an unopened jar of the raw
        // and a bottle of the finished sauce are not the same brown.
        (name: "molasses_black",  rgb: "#2A160E", class: "liquid"),
        // The liquid-smoke drum's painted body, and **equal to
        // `main.gd`'s FLUID_TINTS["liquid_smoke"]** (0.302, 0.271, 0.129)
        // on purpose — the same rule `vinegar_amber` states: the drum you
        // buy and the fluid standing in the run are the same substance, so
        // they are one number in the one file that owns colour. A dark
        // olive-brown, which is what keeps it reading as a flavouring
        // rather than as food beside five saturated ingredients, and far
        // enough from `steel_dark` #6F7680 (its own hoops) to stay a
        // painted drum rather than a bare one. It was #5C5242, a near-grey,
        // until issue #100: that colour vanished into the steel bore when
        // the same number was standing in a pipe, and the drum and the
        // fluid move together by the rule above.
        (name: "smoke_slate",     rgb: "#706430", class: "matte"),

        // --- the warehouse rack's returnable tote (the warehouse-racks
        // sprint, ticket W2) ---
        // The body of a stacking crate standing in a rack bay. Its own
        // entry rather than the ketchup pail's `pail_grey` #989EA2 because
        // the two greys have opposite jobs: a pail is an object on a belt
        // and wants to be seen, a tote is a FRAME around the one thing in
        // a rack bay that carries meaning — the tinted product inside it
        // (UI_UX.md §7, saturated colour reserved for meaning). At
        // `pail_grey` the lit walls render brighter than a heap of sugar
        // and the bay reads as an empty white box with a smudge in it;
        // taken down to this value the walls fall away and the fill is the
        // brightest thing in the opening, which is the whole readout.
        // `pail_grey` itself stays on this model as the moulded rim and
        // corner ribs, so the tote is still recognisably the same plastic
        // family as the pail two stages downstream.
        (name: "tote_grey",       rgb: "#707780", class: "matte"),
        // --- the spice bag's paper (the project owner's 2026-09-21 call to
        // make `item_spice_mix` a sack) ---
        // A spice-dyed paper sack, where sugar's is undyed kraft. Its own
        // entry rather than a reuse of `sack_kraft` #C9B48E for the reason
        // the two bags exist to be told apart: they now share a shape, so
        // the paper is the difference, and at 123/255 of luma between them
        // that difference survives any size the market row renders at.
        // It is also a good deal DARKER than `spice_paprika` #A8481C, the
        // blend spilling from its mouth (30.8/255 between them, past the
        // ~26 anchor for "reads reliably"), because both cameras look down
        // on that spill and a dark mark on a face this camera lights reads
        // as a hole (UI_UX.md §2b point 21) — the sack is the dark thing
        // and the powder the bright one, the same way round as sugar's
        // white crystal on pale kraft.
        (name: "sack_spice",      rgb: "#6E2F13", class: "matte"),

        // --- MUSTARD, the game's third sauce, and the yellow trap it walks
        // into (the mustard epic's art ticket) ---
        // `mustard_gold` is what is IN a `bottled_mustard` bottle and what
        // is printed on a case of them, and choosing it is most of that
        // ticket — because the obvious answer is already spoken for. This
        // game paints signage, meters and machine trim `hazard_yellow`
        // #D9A21B, and a sauce wearing the signage colour is a bug, not a
        // livery. So this is the same family moved two ways at once: **28.8
        // of 255 of luma ABOVE it** (192.7 against 163.9, Rec.709 over
        // 0..255 — past the ~26 "reads reliably" anchor DECISIONS.md's
        // 2026-09-20 record sets) and 13.7 degrees round toward green
        // (CIELAB h 95.8 against 82.1), which leaves hazard yellow the
        // darker, oranger, flatter of the two wherever they share a frame.
        // It clears `vinegar_amber` #AD6B23, the other near neighbour, by
        // 76.9, and the two sauces it shares a belt with by 135.6
        // (`ketchup_red`) and 148.6 (`bbq_brown`): three bottles that part
        // company by VALUE, which is the channel that survives half a tile
        // — `bbq_brown`'s note above read the other way up, since mustard is
        // the BRIGHT one.
        // 192.7 rather than brighter is a deliberate compromise with
        // `label_cream` #E5DCC5, 27.5 above it, because this same colour is
        // the print on a mustard CASE and ketchup's print is that cream. A
        // brighter mustard clears signage by more and the ketchup case by
        // less; a value near the midpoint is the only one that clears 26
        // from BOTH, and a case is the smallest thing on the belt.
        // Matte, for exactly `bbq_brown`'s reason: mustard is only ever seen
        // through a bottle's glass or printed on a carton. Nothing carries
        // it in an open pail — the crusher mills the seed WET, so every
        // bulk stage of this branch stands in a pipe rather than on a belt
        // — and the fluid standing in a pipe stays `fluid_pale` tinted by
        // `main.gd`'s FLUID_TINTS, whose mustard entry should be derived
        // from this number (0.863, 0.776, 0.235), the rule `vinegar_amber`
        // states. That wet mill is also why this branch adds no `liquid_*`
        // entry of its own: those exist for product a PAIL carries down a
        // belt, and mustard never puts any on one.
        (name: "mustard_gold",    rgb: "#DCC63C", class: "matte"),
        // The mustard bottle's label band AND its cap, where ketchup's are
        // `label_cream`/`cap_white` and BBQ's are `label_kraft`/`cap_white`.
        // **White, because the project owner ruled on 2026-10-02 that
        // mustard is yellow and white, not yellow and black** — this entry
        // was #3B3A14, a near-black olive ink, until then (DECISIONS.md,
        // 2026-10-02). The dark ink was there for a measured reason that
        // still holds, and this colour is chosen to keep meeting it from the
        // bright side: `glass_pale`, the neck every bottle shares, is 5.0
        // from `mustard_gold`, so body and neck are one mass, and `cap_white`
        // #E4E0D8 on top of them leaves the bottle's whole top (three-voxel
        // neck plus two-voxel cap, one mark at ~16px) at 213.9 against a
        // 192.7 body — 21.2 apart, under the 26 that reads. So this is a
        // BRIGHTER white than `cap_white`, luma 241.0: 48.3 over the body,
        // 43.3 over the neck, and the neck-and-cap mark at about 224 — 31.3
        // over the body — which is what
        // `a_bottle_s_cap_contrasts_with_the_neck_and_the_body` measures.
        // One entry for band and cap because ketchup's two are 4.0 apart
        // already — a bottle's accent is one colour — and `mustard_gold`
        // itself is untouched, since it is also the case's print and the
        // vat's tint and was balanced against `hazard_yellow` for that.
        (name: "label_mustard",   rgb: "#F4F1E8", class: "matte"),

        // --- the mustard branch's two RAW ingredients ---
        // `seed_tan` is bulk mustard seed heaped in its tote: a dull
        // olive-gold, deliberately the DARKEST member of the mustard family
        // and 61.8 under the sauce it becomes, so the line reads dull seed
        // -> bright sauce from end to end, with nothing between them in
        // this palette because the crusher mills the seed wet and the
        // middle of the chain is a tinted fluid in a pipe — the way
        // `liquid_paste`/`liquid_mix`/`liquid_ketchup` read darkening the
        // other. The number was set against the STEEL it sits in (31.0
        // under `steel`, 72.2 under the `steel_light` rim), not against the
        // market row: a heap inside a bright tote is the adjacency that can
        // swallow it.
        (name: "seed_tan",        rgb: "#A18234", class: "matte"),
        // Turmeric's cut flesh — the one raw whose own colour IS the reason
        // it is in the recipe, and the one number here that **cannot** clear
        // 26 of luma from both of its neighbours, because no number can:
        // `vinegar_amber` sits at 115.8 and `hazard_yellow` at 163.9, an
        // interval 48.1 wide, and the market row stands all the raws side by
        // side. So this one is separated by HUE and by AREA instead, and the
        // numbers are stated rather than implied: 20.8 of luma under hazard
        // yellow with 17.5 degrees of CIELAB hue between them (h 64.6
        // against 82.1) for dE76 22.6, and 27.3 over vinegar amber for dE76
        // 23.0 — both about twice the 11.6 dE76 the dock's clipboard icons
        // are read by. Chroma magnitude is NOT the channel here (dC 2.1 from
        // hazard yellow; `item_liquid_smoke`'s note records where it was).
        // The other half is SHAPE, and it is worth being exact about what it
        // is NOT. The rhizome's mass is `cardboard_dark` skin, 42.6 under
        // this, which buys the cut face local contrast no yellow-on-yellow
        // arrangement could. By VOLUME the cut is about a sixth of the root
        // (28 voxels against 153 of skin) — but `item_turmeric` repaints the
        // cut onto exactly the faces the game's camera sees, so a play-zoom
        // frame shows far more of it than that ratio suggests. No figure is
        // quoted for how much more: the share moves with how the mask treats
        // the contact shadow, and this file does not rest an argument on a
        // number that depends on the mask rule. So the argument is not about
        // how much of it there is: what keeps this off the hazard reading
        // is that it is a knobbly organic lump 18px across, where signage
        // in this game is a large flat straight-edged panel on a machine. A
        // flat plate of this colour is the one that would read as a
        // marking, whatever fraction of the frame it took.
        (name: "turmeric_orange", rgb: "#E3821A", class: "matte"),
        // The title screen's marquee sign (`title_sign` in assets.rs). The
        // letter faces are lit, not painted: the sign hangs in the hall over
        // a menu, and a wordmark that does not glow is a plank with writing
        // on it. Deeper than it renders: the emissive class burns a pale
        // yellow out to cream (#FFD54A read as butter), and this lands on
        // the mustard gold of the old outlined wordmark.
        (name: "sign_neon", rgb: "#EC930B", class: "emissive"),
        // The bulbs chasing round its frame, lit and dark. The lit one is a
        // warm white so it blooms as light rather than as a coloured signal;
        // the dark one is the same glass with the filament off.
        (name: "marquee_bulb", rgb: "#FFF3D6", class: "emissive"),
        (name: "marquee_bulb_off", rgb: "#5E5546", class: "matte"),
    ],
)
